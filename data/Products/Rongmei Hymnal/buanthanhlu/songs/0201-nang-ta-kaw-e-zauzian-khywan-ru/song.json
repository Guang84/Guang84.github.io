        "content": {
          "format": "source-lines",
          "lines": [
            "          201 Nang ta Kaw e Zauzian Khwan rui",
            "                              8.8.8.7.Ref. 6. 6. 5. 6. 6.",
            "",
            "          1. Nang ta kawe zauzian khwan rui,",
            "             Paapc phunghmei nac akhwan chu tho:",
            "             Guangmei guay khang bamv chamdaanvlou;",
            "             Tingkauh tei laancpat pwni the.",
            "",
            "                     Ringhmei zanc hylou the,",
            "                     Ringhmei Latrik khou.",
            "                     Tingkauh raengckat khou,",
            "                     Nang guangbampui tuang e.",
            "                     Lwm tho nang ringc pwni.",
            "",
            "          2. Heic kandic hei akai hamh e,",
            "             Paapc rui guanghtupui kandic hei,",
            "             'Baanvthaymei mak zinghpui dic khou,",
            "             Tingkauh klai ta nkhwan lian lak.",
            "",
            "          3. Ai kaamcthau the tingkauh chaeng khou,",
            "             Kabamv kapwmna kangvran e;",
            "             Bumaengh lungc nipui kaidai e.",
            "             Cross khou paapc guay khiu 'thanlou the."
          ]
        }
      }
    },
