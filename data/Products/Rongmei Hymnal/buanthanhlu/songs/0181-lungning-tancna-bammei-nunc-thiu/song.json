        "content": {
          "format": "source-lines",
          "lines": [
            "          181 Lungning Tancna Bammei Nunc Thiu",
            "                             8.7.8.7.Ref. 7. 7. 8. 6",
            "          Doh hej Gb",
            "",
            "          1. Lungning tancna bammei nunc thiu,",
            "             Kaganv hei 'naa guang pwthe;",
            "             Nang adih kamv nyan bam tu cho?",
            "             Kaganv hei 'naa guang pwthe.",
            "",
            "                  Ravguangc rui 'seic tingmik khou,",
            "                  Nang panty laa kan ethei,",
            "                  Nang ta maikwam khou raw pwni;",
            "                  Lungh laic guang mak gethei.",
            "",
            "          2. Daihmei nic nthyammei guay nic,",
            "             Latzan sw ni Ravguangc rui;",
            "             Nang ta latzan swpui nungc kiu,",
            "             Tabui lat nang daw ni cho?",
            "",
            "          3. Jahuan kathumh, panguh khoutei,",
            "             Jisu rui kumcna saa e:",
            "             Bumaengh khou puancthanh mak gethei,",
            "             Tingkaut. kandic how lak ge.",
            "",
            "          4. Nang Bumaengh laatow mak gethei,",
            "             Nang ringcting hei luai pwkhou,",
            "             Tingsaeng zaeng nang huc ndyangna,",
            "             Maikwam khou ryanraa khaengv ni."
          ]
        }
      }
    },
