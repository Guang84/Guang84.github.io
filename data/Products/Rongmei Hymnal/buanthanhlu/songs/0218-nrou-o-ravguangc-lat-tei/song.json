        "content": {
          "format": "source-lines",
          "lines": [
            "          218 Nrou o Ravguangc Lat tei",
            "                                 7.8.7.7",
            "          Doh hei G",
            "",
            "          1. Nrou o Ravguangc Lat tei,",
            "             Kandih sii-gay kadah makna.",
            "             Tigaanc o zinghmei bamv khou,",
            "             Dinc tat ro kabamv thuih khou.",
            "",
            "          2. Dincloumei tei chu lana,",
            "             Laalouna lwmlou kan diuc khang,",
            "             Lwmlouna ringhbamv laa diuc;",
            "             Zinghmei khou theic bammei guay.",
            "",
            "          3. Tiipat ro nang ningtyng guay,",
            "             Tiipat ro nang syan nang lanv guay,",
            "             Tiipat ro nang chwn nang lung,",
            "             Tiipat ro nang pumc kaguay.",
            "",
            "          4. Tii niina tiloumei khang,",
            "             Mbuna tilou dat pwni.",
            "             Nang lakhphy heizumei tei,",
            "             Ravguangc rui chaklou bam e."
          ]
        }
      }
    },
