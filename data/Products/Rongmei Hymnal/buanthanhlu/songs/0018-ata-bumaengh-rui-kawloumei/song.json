        "content": {
          "format": "source-lines",
          "lines": [
            "          18      Ata Bumaengh rui Kawloumei",
            "                          8.8.8.8 ref. 8.8.8.8",
            "          Doh hei Eb",
            "",
            "          1 Ata Bumaengh rui kawloumei,",
            "            Charyn tuang e Kazauzian hei!",
            "            Saa ngam thuy lakmei ramneilaa",
            "            Laatow the alung syng khouhei!",
            "",
            "               Akhang Khrista rui theicloumei!",
            "               Kakumc ai nic cross phungc ni the.",
            "               Kazauzian hei alu swna,",
            "               Apanty nai saanv thuanc bam ni.",
            "",
            "          2 Apumc guay Nang tuang swlou o,",
            "            Alung khou Nang guang bamlou o,",
            "            Simei apaap guay khiulou o,",
            "            Sw 'thanlou o, alung pwm hei.",
            "",
            "          3 Alung khou Nang gutbamlou o,",
            "            Nang bam pwkhou zinghmei maek ge.",
            "            Araana achwn swthuy mak,",
            "            Kaganv 'thuih Nang nduanghlou.",
            "",
            "          4 Akhou Bumaengh rui dinclou o,",
            "            Paapc sw mak khang nic dinclou o,",
            "            Sipui taanv khou tiduaklou o,",
            "            Tingkauh lwnlung khang dinclou o."
          ]
        }
      }
    },
