        "content": {
          "format": "source-lines",
          "lines": [
            "          3     Ai Katumcna Guang Pwni the",
            "                                  8.7.8.9 Ref. 10.11.8.12",
            "          Doh hei D",
            "          1. Ai katumcna guang pwni the!",
            "             Meic gaanvkhatna rui sihnic,",
            "             Nang pyrun tei laa mak khangrui,",
            "             Nang khou naimei tei ’tipna sin o.",
            "",
            "                      A-Ravguangc zanc, atuang Ravguangc kaidai,",
            "                      Apu khourui tingkauh thangcrui key kanmei,",
            "                      Kathancmei Jerusalem zanc,",
            "                      Azanc thanh tei karuc khou ai rui hylou ni.",
            "",
            "          2. Ngammei guay ta tei ai ruina,",
            "             A-Ravguangc tuang kathancmei,",
            "             Kaitiangc akhat tiswlou ni;",
            "             Heic khoutei rui tatpat dat lak khe.",
            "",
            "          3. Poubauhmei rui kumna saa e:",
            "             Nang nchu nic ’chu mak ge,",
            "             Nang hei chaengc nic chaengc ranv mak ge;",
            "             Nang rui chaenghmei ta Ai kahaw e.",
            "",
            "          4. Nang rui lumc gunhgunna bammei;",
            "             Chaengc nic chaengc ranv kham makmei,",
            "             Nchu nic ’chu makpui zaengrui,",
            "             Ai rui teih ’suk kumc ’sukganc pwni.",
            "",
            "                                                            Ph. Guangsuanrei"
          ]
        }
      }
    },
