        "content": {
          "format": "source-lines",
          "lines": [
            "          260 Ravguangc Zanc Khou Nzianmel",
            "                         8.8.8.8.Ref. 8. 8. 8.8",
            "          Doh hei Gb",
            "",
            "          1. Ravguangc zanc khou nzianmei guay,",
            "             Nang phaydyng tei ding 'tip la tho;",
            "             Guang pwni the, pat pwni the.",
            "             Kanuk pwni the kandih hei.",
            "",
            "                       Nang laupuk khou, nang pikwan khou;",
            "                       Nang ki, nang ruai, nang kaikhunc khou;",
            "                       Ravguangc lungpuam guang mak khangrui;",
            "                       Huayney ranv tho nzianmei guay.",
            "",
            "          2. Zauc ngammakmei how pingmei lwn,",
            "             Kapmei ryanraa kalanghmei khwan,",
            "             Chu pwni the, how pwni the:",
            "             Kaikhunh kathuih, phwamling kathuih.",
            "",
            "          3. Khouringh guay khou, phwnling guay khou;",
            "             'Pyan 'raamei hei guang pwni the.",
            "             Kalatryan hei guangtangh khangrui,",
            "             Guang pwni the, pat pwni the.",
            "",
            "          4. Nouha kin khou pat kanmei tei,",
            "             'Dih nam ruc khou kalung p'rik guay,",
            "             Duidai ruina khiu kanmei kumc.",
            "             Guang pwni the, pat pwni the."
          ]
        }
      }
