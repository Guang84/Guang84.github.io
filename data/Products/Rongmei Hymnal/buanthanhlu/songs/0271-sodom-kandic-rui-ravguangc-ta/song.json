        "content": {
          "format": "source-lines",
          "lines": [
            "          271 Sodom Kandic rui Ravguangc ta",
            "                           8.5.9.Ref. 4. 6. 5. 5",
            "          Doh hei G",
            "",
            "          1. Sodom kandic rui Ravguangc ta,",
            "             Thay makpui zaengrui,",
            "             Ravguangc lungpuam kaniw khou guang the.",
            "",
            "                      Lwmlou la tho,",
            "                      Ravguangc lungpuam how khang",
            "                      Pingmei guay ruina. (2 )",
            "",
            "          2. 'Taw nganv lwm makmei nunc ruc khou,",
            "             Sodom tei kumcna,",
            "             Ravguangc lungpuam tei guanglou pwni.",
            "",
            "          3. Kazauzian apaap 'suangc daic e;",
            "             'Taw ni kaw bam e.",
            "             Nang paap guaytei khiu 'thanlou pwni.",
            "",
            "          4. Kakhou ngamv kaguayna nai e,",
            "             Kakhou lwmlou tho;",
            "             Maikwam khourui guduak lou pwni."
          ]
        }
      }
    },
