          "lines": [
            "          91      Jerusalem Kathanc Khoutei",
            "                           8. 10.6.7. Ref. 8. 8.6",
            "",
            "          1. Jerusalem kathanc khoutei,",
            "             Jisu zei rui liuloumei kaguay rui",
            "             Guang lungc pwni neihkhat,",
            "             Damc thanhmei tingkauh khoutei",
            "",
            "                  Tingkauh ramc khou guangtangc pwkhou,",
            "                  Hallelujah lu thanh suan ni,",
            "                  Ringhpouc ta thuanc bam ni,",
            "",
            "          2. Ringhpouc rui damcloumei ruang khou",
            "             Maansei ta kungc liangna damclou khwan e;",
            "             Kahym lungc lyan khangrui,",
            "             Ringhpouc rui damclou khwan",
            "",
            "          3. Ringhpouc rui taanvdaih taanclou, the",
            "             Aniw khang suaihiem tei tiikeylou the.",
            "             Thuanckuna bam di kho,",
            "             Panty nai bammei lungc khou."
          ]
        }
      }
    },
