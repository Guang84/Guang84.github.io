        "content": {
          "format": "source-lines",
          "lines": [
            "          268 Ringhpouc Baansyam Kaguay tei Zauc lo",
            "                          9.9.8.10. Ref. 7. 7. 8.9",
            "",
            "          1. Ringhpouc baansyam kaguay tei zauc lo.",
            "             Tingpuk kandih chingh-zaeng kaguay tei,",
            "             Khouringh, nruay, puatc kaguay tei,",
            "             Ringhpouc rui aniw khang damc chuylou the.",
            "",
            "                     Ch'rynmei taanvdaih taanclou the;",
            "                     Ramh kaguay hei tilou the.",
            "                     Karamzian hei saa ngammak ge.",
            "                     Ringhpouc ta thuanckuna lungc di kho.",
            "",
            "          2. Ringhpouc rui damcloumei puatc guay tei,",
            "             Nap-bi, tingthai kaguay damclou e,",
            "             Khav-gaa kaguay hei damclou e.",
            "             Maansei aniw rui piu khang damclou the.",
            "",
            "          3. Ringhpouc rui tiiloumei kaganv khou,",
            "             Thuanckuna lungc dikho zianmei guay.",
            "             Huayneymei lev thuanckumei hei,",
            "             Aniw rui mi guay hei taancthau dikho."
          ]
        }
      }
    },
