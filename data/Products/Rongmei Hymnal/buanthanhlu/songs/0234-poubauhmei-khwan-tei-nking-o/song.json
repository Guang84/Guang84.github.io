        "content": {
          "format": "source-lines",
          "lines": [
            "          234 Poubauhmei Khwan tei Nking o",
            "                                8.5.8.5.Ref. 7. 7. 6.9",
            "          Doh hei E",
            "",
            "          1. Poubauhmei khwan tei nking o,",
            "             Kandihmei guay le!",
            "             Kamei guang nimei ganv tangc the,",
            "             Aniw ta laa khang.",
            "",
            "                  Guang pwthe, (Kaipouc Jisu)",
            "                  Guang pwthe, ( Halleluijah)",
            "                  Muangh ruc khou dungc lana,",
            "                  Kahym daicna keymei ta how ni.",
            "",
            "          2. Kakhou lwmloumei guayna ta,",
            "             Phungcthau kanmei tangv,",
            "             Lou duhmei maansei guayna tei,",
            "             'Maanmei laa pwni.",
            "",
            "          3. Ryanraamei maikwam lungc khoutei,",
            "             Tingkwm ching akhaa,",
            "             Tingsaeng zaeng ryanraa bam pwni,",
            "             Lwmlou makmei guay.",
            "",
            "          4. Kakhou lwmloumei guay tei mu,",
            "             Neih kumc gaanc pwni.",
            "             Neihlaamei kim dat zat lak khe.",
            "             Poubauhmei hu khou."
          ]
        }
      }
    },
