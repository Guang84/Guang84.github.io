        "content": {
          "format": "source-lines",
          "lines": [
            "          58 Guloumeipu ta Tingsaengcna",
            "                        8.8.12.6. 6. Ref. 9. 8. 6. 6.7.5",
            "          Doh hei G",
            "",
            "          1. Guloumeipu ta tingsaengcna,",
            "             Amucna ai lungc bam khwan e.",
            "             Mi kandic ramgai hei tingsaeng zaeng",
            "             khang hamh e.",
            "             Zauzian rui 'duanghlou ni,",
            "             Kaguangcdic tangh mak saanv.",
            "",
            "                        He charyn e Katuang zauzian hei;",
            "                        Akhangrui e khaengvloumei tei;",
            "                        Guangna thuancku di kho;",
            "                        'Niw Guloumeipu ta.",
            "                        Kata thuancku mak gethei,",
            "                        Neihlaamei maek ge.",
            "",
            "          2. Kandih puat ta ai phu khwan e;",
            "             Kandih lungc suangpui bamv hamh e:",
            "             Heic kandic rui ata tineihlaa ngammak ge.",
            "             Zauzian rui ata kaw,",
            "             Hanguang dat khang kaw e.",
            "",
            "          3. Ai guang dat the Guloumeipu;",
            "             Hanguang dat the ai nang pamv khou.",
            "             Ai rui huayneymei guay Nang rui dawlou bam e:",
            "             Alung khou tiilou e,",
            "             Tingsaeng ringhmei latryan."
          ]
        }
      }
    },
