        "content": {
          "format": "source-lines",
          "lines": [
            "          92      Jerusalem Namvdai Gaymei",
            "                             8.6.8.6.Ref. 4.4.4.6.6",
            "",
            "          1. Jerusalem namvdaih gaymei",
            "             Tangh khang khwan ngammak ge;",
            "             'Thanmei nunc lev bam 'chamc khangrui",
            "             Guloumeipu hu khou.",
            "",
            "                    Jerusalem (2),",
            "                    Ai rui ning e",
            "                    'Thanmei nunc lunghpui ramc",
            "                    Guang khang khwan ngammak ge.",
            "",
            "          2. Jerusalem namvdaih gavmei.",
            "             Karamgai saa ngammak.",
            "             Kandih ramgai ganclou ducna,",
            "             Guloumeipu hu khou.",
            "",
            "          3. Jerusalem namvdaih gaymei,",
            "             Chwnsw kapmei maek ge.",
            "             Khoutei guang khang ai machunh bam,",
            "             Guloumeipu hu khou."
          ]
        }
      }
    },
