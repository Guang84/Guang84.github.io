          "lines": [
            "          13     Aniw Neihlaamei Panty Hei",
            "                         8.8.8.6 Ref.8.8.8.8.8",
            "",
            "          Doh hei Eb",
            "",
            "          1.   Aniw neihlaamei panty hei,",
            "               Tingmik kathuih tatna bam e.",
            "               Aniw panty hei luai pwkhou,",
            "               Tingkauh kai khou tat ni.",
            "                 Chamdaanv la tho, chamdaanv makmei,",
            "                 Tingsaengc lak khe Jisu guang khang.",
            "                 Laalou la tho kaganv gay khou,",
            "                 Ntaw Khrista ta laalou tho. (2)",
            "",
            "          2.   Zianloumei ganv hei luai pwkhou,",
            "               Khaengv thaymei ganv hei luai pwkhou,",
            "               Nang ningngam makna bam pwni,",
            "               Kaikhamv mbangh pwkhou.",
            "          3.   Tingkauh kaikhamv laanc bam khouhei,",
            "               Guang la tho nang bumaengc ringh khang.",
            "               Nyan lamc e tingsaengc la ri tho;",
            "               Kaganv maek pwni the."
          ]
        }
      }
    },
