          "lines": [
            "          59 He ARavguangc Zaylou o",
            "                           7.7.11.7. Pef. 8. 8",
            "          Doh hei D",
            "",
            "          1. He aRavguangc zaylou o;",
            "             Nang ningmei khou zaylou o.",
            "             Nang hamhna ai ingc ngammak ge, aRavguangc;",
            "             He Kaipouc Nang rui hamhna.",
            "",
            "                  Zaylou o, Kaipouc zaylou o;",
            "                  Ringc nipui chaeng khou zaylou o.",
            "",
            "          2. He aRavguangc 'zianlou o;",
            "             Ai 'suan e Nang thu tanc e.",
            "             Nang pamv khou ai ngangvlou ni the, aRavguangc;",
            "             He Kaipouc pumtan tii o.",
            "",
            "          3. Tingkauh ramc gaymei khoutei,",
            "             Alung rui ningna bam e.",
            "             Heic ramc gay' tei guang tangh khang kaganv 'naa the;",
            "             Lungning 'thanna khwan bam o."
          ]
        }
      }
    },
