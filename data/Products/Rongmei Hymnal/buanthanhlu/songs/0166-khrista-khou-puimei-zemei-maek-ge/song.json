        "content": {
          "format": "source-lines",
          "lines": [
            "          166 Khrista khou Puimei, Zemei Maek ge",
            "                                    9.6.9.6",
            "          Doh hei D",
            "",
            "          1. Khrista khou Puimei, Zeme maek ge;",
            "             Liangmai, Ruangmei maek ge;",
            "             Mi hei 'zianmei tuang phwam daih khat de;",
            "             'Dih pwm ta banglou e.",
            "",
            "          2. Khrista khou kabamv 'thuih lwmmei guay,",
            "             Lungh khat chwn khat swna,",
            "             Katuang taanv-ruai hei kachaekc riang e.",
            "             Meic guay ta banglou e.",
            "",
            "          3. Lwmmei khou chanaa swmei thiu le !",
            "             Nang zaat baice ning rio;",
            "             Pu ta nah swna siamruai swmei,",
            "             Khrista khwangmei nunc e.",
            "",
            "          4. Khrista khou Puimei, Zeme kariu;",
            "             Liang, Ruang 'taw thu 'riu the;",
            "             Khrista luihmei guay khatna di the;",
            "             Kandih pwm khatna de."
          ]
        }
      }
