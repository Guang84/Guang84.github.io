            "          125 Kandih Guangcdic Daicthau",
            "                             6.6.6.8.Ref. 7. 8. 8.8",
            "",
            "          1. Kandih guangc dic daicthau,",
            "             Kaganv hei rauguang the.",
            "             'Taw hei zauzian ganv the,",
            "             Kawloumei geic, guangmei rau e.",
            "",
            "                     Kandih chwn laamei guay ruina,",
            "                     Bamduc pwni kandihramc khou,",
            "                     Nang zei rui nang bumaengh liu ni,",
            "                     Mitei nang khaeng ngam pwni cho?",
            "",
            "          2. Siimei ganv naaguang the,",
            "             'Taw na thu zauzian nai,",
            "             'Taw guloumei ganv the,",
            "             'Taw ringcsuangmei laapui ganv the.",
            "",
            "          3. Siimei taancbammei guay,",
            "             Lat saraamc bammei guay,",
            "             Saamei piu makmei guay,",
            "             Ganclouduc ni kandihramc khou.",
            "",
            "          4. Lwmmei nunc takaw khou,",
            "             Lwmmakmei bamducna,",
            "             Chuna laaloumei guay,",
            "             Kaipouc guanghdic guang how pwni."
          ]
        }
      }
