          "lines": [
            "          24      Bumaengh Lungc Nipui Ramc Nai",
            "                                8.7.7.6.Ref.8.7.6",
            "          Doh hei E",
            "              1. Bumaengh kandic lungc nipui ramc,",
            "                 Tingkauh khoutei lungc pwni.",
            "                 Phaengc zauc lo, nzianmei nunc,",
            "                 Charynpui kandih khou.",
            "",
            "                        He nzianmei nang nic zauc lo,",
            "                        Kaikhunhmei guay lungc pwni;",
            "                        Nang khang bamv chamdaanvlou.",
            "",
            "              2. Tingkauhramc guang nimei nac nunc,",
            "                 Pwan thanh tei piu pwni the.",
            "                 Pwan thanh tei piuna thuanc ni,",
            "                 Gay liangpui neic khoutei.",
            "",
            "              3. Tingsaeng zaeng pwan thanh piu lana,",
            "                 Ravguangc ta thuancna bam ni.",
            "                 Nrangvting patmei kumcna,",
            "                 Kanganv maekna thuanc ni.",
            "",
            "              4. Tingsaeng lu suanmei kaikhunh guay,",
            "                 Khrista tampy laamei nunc,",
            "                 Thuanc taek makna thuanc nimei;",
            "                 Hallelujah! Thuanc ni."
          ]
        }
      }
    },
