            "          77 He Tingkauh Ramc Guang Niimei Nunc Mu",
            "                                9.7.8.7. Ref. 7. 7. 9. 7",
            "          Doh hei D",
            "",
            "          1. He tingkauh ramc guang niimei nunc mu,",
            "             Kaipouc Jisu ta zauc lo.",
            "             Nang ta kabamv 'thuih duanghlou khang,",
            "             Kaipouc Jisu ta zauc lo.",
            "",
            "                      Kaipouc Jisu ta zauc lo, (2)",
            "                      Zingbangc kalaanv nang ta 'duanghlou khang,",
            "                      Kaipouc Jisu ta zauc lo.",
            "",
            "          2. Siimei paap khou 'maan kan nimei thiu,",
            "             Kaipouc Jisu ta zauc lo.",
            "             Ntwnmei lwnlung khou lungh khang,",
            "             Kaipouc Jisu ta zauc lo.",
            "",
            "          3. Nang panty chaenglwan ryanraa sihnic,",
            "             Kaipouc Jisu ta zauc lo.",
            "             Nang daeng khou bamlou ni tw e:",
            "             Kaipouc Jisu ta zauc lo.",
            "",
            "          4. Theic suc-nucmei guangtangc pwsihnic,",
            "             Kaipouc Jisu ta zauc lo.",
            "             Tingkauh ramc guangtangh makpui saan,",
            "             Kaipouc Jisu ta zauc lo."
          ]
        }
      }
