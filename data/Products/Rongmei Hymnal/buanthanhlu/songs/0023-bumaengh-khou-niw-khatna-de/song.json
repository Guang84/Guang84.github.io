        "content": {
          "format": "source-lines",
          "lines": [
            "           23     Bumaengh Khou 'Niw Khatna de",
            "                               7.6.7.7.Ref.8.6.10",
            "           Doh hei C",
            "       1. Bumaengh khou 'niw khatna de,",
            "          Khrista khou 'niw khat de,",
            "          'Niw lungh khat chwn khat sw khang",
            "          Ravguangc khou 'niw kalum e.",
            "",
            "                  Khat khat ta kuaklou karyna,",
            "                  Zianthayna lungc pwkhou,",
            "                  Khristian e twmei meic nunc how kan diu.",
            "",
            "       2. Aniw guay tat 'chamc bam ni,",
            "          Khat khat baanc ngguakna.",
            "          Hu biak thangc tatgut bam ni,",
            "          Tingkauh kai tanghmakpui saanv.",
            "",
            "       3. Aniw taanc nchamc bam e',",
            "          Ravguangc latdanv piuna.",
            "          'Maanmei nunc khou dinclou ni,",
            "          Khrista tuang Gaychamv ti hei.",
            "",
            "       4. Khat khat khang huayneylou ni,",
            "          Aniw Pu Ravguangc khou.",
            "          Khat khat ta kadan thayna",
            "          Nzianna lungc bam ni the."
          ]
        }
      }
    },
