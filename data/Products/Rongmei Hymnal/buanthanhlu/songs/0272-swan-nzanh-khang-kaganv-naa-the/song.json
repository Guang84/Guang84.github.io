        "content": {
          "format": "source-lines",
          "lines": [
            "          272 Swan Nzanh khang Kaganv 'Naa the",
            "                          8.6.5.5.6. Ref. 9.9. 12.8",
            "          Doh hei G",
            "",
            "          1. Swan nzanh khang kaganv 'naa the;",
            "             Ataanv guay how dat 'ni.",
            "             Gaanvsaekc zaenggay 'ni,",
            "             Gaanvsaekc zaengsi 'ni,",
            "             Gaanvsaekc ntamv pwni.",
            "",
            "                  Neih khat ai thay makpui 'dic tangcna,",
            "                  Heictei tingsaeng mbaanvthaypui ramc;",
            "                  AKaipouc lev tat 'chamcna alaamh tat pwni.",
            "                  Kim dat lak khe, Hallelujah!",
            "",
            "          2. Heic kandic hei tingsaengc lak khe;",
            "             Akhang nrianhloumei,",
            "             Mang kumhmei apanty hei 'patlouna,",
            "             Tingkauh ai tat pwni.",
            "",
            "          3. Tingkauh kandic guangtangc pwkhou,",
            "             Zaengsi' nai dat lak khe;",
            "             Ravguangc lunghmei tingkauh kaidai khoutei.",
            "             Baanch'raa kumcna lungc ni."
          ]
        }
      }
    },
