        "content": {
          "format": "source-lines",
          "lines": [
            "          269 Ringhpouc Lat Piuna Aniw Lungc dikho",
            "                              10.7.9.9.Ref. 7. 8. 9. 10",
            "",
            "          1. Ringhpouc lat piuna aniw lungc di kho.",
            "             Aniw panty ringcbam khou,",
            "             Kalat piuna lungc bammei guay khang",
            "             Ringhpouc rui suaihiam tilou pwni.",
            "",
            "                     Suaihiam tikeylou na ro",
            "                     He Ravguangc nang khou huayney e.",
            "                     Nang suaihiam gaymei tei tiilou o",
            "                     Aniw rui nang ta thuancna lungc bam khang.",
            "",
            "          2. Ryanraa bammei aniw panty hei",
            "             Ravchap tatna lungc di kho.",
            "             Nang rui taancloumei kaguayna khou,",
            "             Ringhpouc rui suaihiam tiilou pwni.",
            "",
            "          3. He Ringhpouc suaihiam tiikeylou na ro.",
            "             Lungcgay chingkhiuhmei suaihiam,",
            "             Mi suaihiam guay tei tiilou ethei -",
            "             Ringhpouc khang tiipatna lungc bam ni."
          ]
        }
      }
    },
