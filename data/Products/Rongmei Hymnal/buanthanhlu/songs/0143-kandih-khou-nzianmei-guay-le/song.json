          "lines": [
            "          143 Kandih Khou Nzianmei Guayle!",
            "                                8.9.8.8.Ref. 6. 7.7.9",
            "          Doh hei Eb",
            "",
            "          1. Kandih khou nzianmei guay le !",
            "             Jisu rui nzianna kawbam the.",
            "             Akhou guang o, paapc kuaklou ni;",
            "             Tingsaeng ringcsuangmei tilou ni.",
            "",
            "                        Guang o, kawmei chu lo;",
            "                        Panty tingmik luai mak khou.",
            "                        Lwm tho ringhmei Jisu khou;",
            "                        Ningngam thuy pwlak khe 'thei thangc mu.",
            "",
            "          2. Malaa rio nzianmei guay le !",
            "             Kadan o, nang bumaengc 'maan mak khang.",
            "             Paapc rui bumaengh swmaan tuang e;",
            "             Paapc kuak ge thei bumaengh ringc ni.",
            "",
            "          3. Jisu ramgai guang 'bapzauc lo;",
            "             Kandih puat guay nang tuang sw sihnic,",
            "             Bumaengh 'maan ethei gaengna cho ?",
            "             Bumaengh lev tabui 'khiak ni cho?"
          ]
        }
      }
