          "lines": [
            "          98      Jisu Jisu Nang Raana De",
            "                           8.7.8.7. Ref. 8. 7",
            "          Doh hei E",
            "",
            "          1. Jisu Jisu Nang raana de",
            "             Paapc phunghmei ta 'zianloumei",
            "             Nang mei nunc ta 'zianpui zaengrui",
            "             Nang zei rui thuak patlou the.",
            "",
            "                      Ata thaylou o thaylou o",
            "                      He Jisu aniu Ravguangc      }2",
            "",
            "          2. Nwan phunghmei kandic ruc khouvhei",
            "             Maansei huayney bam geic e",
            "             Aniu chwn sii e nang raana",
            "             Aniu khang ryanraa khaengvlou.",
            "",
            "          3. He Jisu Nang Lat piu diuc khang",
            "             Nang lung gaymei tiilou o",
            "             Aniu pumtan maekpui zaengrui",
            "             Nang rui 'niu ta gulou o.",
            "",
            "          4. Aniu dui khou Baptais swe",
            "             Heic tei rui biumei hamh e",
            "             Bumaengh 'Thanmei Baptais sw khang",
            "             He Jisu rui tiilou o."
          ]
        }
      }
