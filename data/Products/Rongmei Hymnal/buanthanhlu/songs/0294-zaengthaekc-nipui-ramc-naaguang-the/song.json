        "content": {
          "format": "source-lines",
          "lines": [
            "          294 Zaengthaekc nipui Ramc 'Naaguang the",
            "                                8.8.8.8. 8. Ref. 8.8. 8. 8",
            "",
            "          1. Zaeng thaekc nipui ramc 'naaguang the,",
            "             Kanloumeipu bampui ramc khou;",
            "             Kahym daihmei Tingkauh Ravguangc,",
            "             'Akhou guang khap tho' kawbam the,",
            "             'Niw nic kata how pwni the.",
            "",
            "                        Poubauhmei rui guang dat pwkhou",
            "                        Kamei guay ta laathau pwni;",
            "                        Jerusalem kathanc khoutei",
            "                        Tingkwm kaganv nai dat lak khe.",
            "",
            "          2. Paapc kandic hei kaanpat pwkhou,",
            "             Abumaengc neihlaana lungc ni.",
            "             Ryanraamei guay zaeng 'thaekcpui ramc,",
            "             Ringhmei dui tei zangv pwni the,",
            "             Kanloumeipu ramgai khoutei.",
            "",
            "          3. Kandih khou ntamv kanmei guay,",
            "             Duipaengc ramc gay khou 'khwan bam e.",
            "             Poubauhmei khou lwmloumei guay",
            "             Bumaengh panty khou lungc pwni.",
            "             Hallelujah thuancna bam ni.",
            "",
            "          4. Kangvranmei andic khat nai e,",
            "             Heicramc gay tei saa ngam mak ge;",
            "             Khoutei neihlaa tuai dat lak khe.",
            "             Lwmlou makmei guay ramsii mu,",
            "             Phaengzaucna kapbam pwni the."
          ]
        }
      }
