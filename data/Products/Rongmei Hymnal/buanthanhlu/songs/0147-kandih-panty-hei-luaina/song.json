        "content": {
          "format": "source-lines",
          "lines": [
            "          147 Kandih Panty Hei Luaina",
            "                           7.8.7.6.Ref. 7. 6. 7.7",
            "          Doh hei E",
            "",
            "          1. Kandih panty hei luaina,",
            "             Tat nipui bamv akhat nai e.",
            "             Kapna mikdui luanlaimei,",
            "             Zaengsimei nai dat lak khe.",
            "",
            "                        Khrista rui kaw e ryanraa",
            "                        Kalangh bammei guay ta.",
            "                        Kapamv khoutei guang lana,",
            "                        Zaeng 'thaekc tho twna kaw e.",
            "",
            "          2. Thang tei bw, neih, gaanchuangcna",
            "             guay hei kage nai dat lak khe.",
            "             Nap-bi, syan-lanv, pheybaan guay",
            "             hei kage nai dat lak khe.",
            "",
            "          3. Kandih nam ruc khou naimei,",
            "             Ravguangc baansyam heiczumei hei,",
            "             Ganclou ducna tat pwni,",
            "             Neih khatpui nungc kiu aniw.",
            "",
            "          4. Mang thangc howmei tingkauh ramc,",
            "             Tabui nungc rui guangtangc ni cho?",
            "             Kandih ryanraamei panty",
            "             Tuai pwni the zianmei guay."
          ]
        }
      }
    },
