        "content": {
          "format": "source-lines",
          "lines": [
            "          44      Gaychamv Dinh khang Nang ta Kaw e",
            "                              8.8.8.8.Ref. 6. 6. 6.6.6.6.6",
            "          Doh hei Ab",
            "",
            "          1. Gaychamv dinh khang nang ta kaw e;",
            "             Kabamv kathuih khou dinc tat khang.",
            "             Ringhchamv chu makmei ching ching khou,",
            "             Dinc tat khang nang ta kaw bamn e.",
            "",
            "                       Lautay khang thu daic e;",
            "                       Tay nimei thu rau e.",
            "                       Kaipouc khou huayney o,",
            "                       Tay nimei thouclou khang,",
            "                       'Maan nimei bumaengc ta,",
            "                       Khrista khou phungcguang khang.",
            "                       'Zianmei nang ta kaw e,",
            "                       Khap tho kaganv maek khe.",
            "",
            "          2. Taanc nimei chaeng peyna nai e:",
            "             Nang syan nang lanv tiipat nuh e;",
            "             Huayneymei rui khavlou nuh e,",
            "             Nang pumc kahak tiipat nuh e.",
            "",
            "          3. Nang ta gulou Kazauzian rui;",
            "             Kapumc kahak cross khou theiclou;",
            "             Nang khang tilou kazauzian rui.",
            "             Guloumei chamv dincruan tat ro."
          ]
        }
      }
    },
