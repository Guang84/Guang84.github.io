          "lines": [
            "          293 Tingsaeng Tigay Ngammei Emmanuel",
            "                                       9.11.7",
            "          Doh hei Db",
            "",
            "          1. Tingsaeng tigay ngammei Emmanuel,",
            "             Kazanc khourui karik guay tei theic kan diu:",
            "             Tingsaeng gay kan diu!",
            "",
            "          2. Ngammei baanc zaythau khou siimei ravsic",
            "             Karei pwni ringhmei baanc kahi pwkhou.",
            "             Tingsaeng gay kan diu!",
            "",
            "          3. Tingsaeng ngammeipu Jisu zanc khourui,",
            "             Gay makmei ravsic guay ta nthauganc e;",
            "             Jisu zanc khourui gay tho.",
            "",
            "          4. Tingsaeng ngammeipu Ravguangc rui,",
            "             Suc-nucmei kazaat geihmei ta tigaylou.",
            "             Jisu zanc khourui gay tho."
          ]
        }
      }
