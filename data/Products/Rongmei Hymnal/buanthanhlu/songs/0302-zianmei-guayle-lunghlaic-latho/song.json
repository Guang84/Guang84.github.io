        "content": {
          "format": "source-lines",
          "lines": [
            "          302 Zianmei guayle, Lunghlaic latho",
            "                          8.8.8.8.Ref. 8. 8. 8.8",
            "",
            "          1. 'Zianmei guayle, lunghlaic la tho.",
            "             Kaganv maek khe lwmlou latho.",
            "             Khamhpui tingmik guang pwkhou kiu,",
            "             Ningngam lakpui ganv guang pwni.",
            "",
            "                    Noah kaanc khou pat kanmei kumc,",
            "                    Ryanraa daihmei guang pwni the.",
            "                    Nang nic khoutei kazauh ni cho?",
            "                    Lunghlaic la tho kaganv maek khe.",
            "",
            "          2. Kauh Kanaan ramc gaymei khoutei,",
            "             Lungh ryanraana kapmei nai lak khe.",
            "             Lauziu Nac rui gaancna bam ni,",
            "             Kwm tingsaeng zaeng gaancna bam ni.",
            "",
            "          3. Kandih khou gaymei suang gay e,",
            "             Mwang rui saa tangc ngam thuy mak ge.",
            "             Hei khoutei gut nimei kiu thu",
            "             Kalatdanv piumei na khang de."
          ]
        }
      }
    },
