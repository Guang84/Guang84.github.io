          "lines": [
            "          63 He Kandihmei Nzianmei Guayle !",
            "                             9. 10.9.9.8.9.7",
            "          Doh hei D",
            "          1. He kandihmei nzianmei guayle !",
            "             Kaganv hei katumcna kalaicguang the.",
            "             Kabamv 'thuih nthw aluanh rah kumc,",
            "             Ringhmei Lat dinhmei rui kachyn the.",
            "             Lwmlouna chamdaanv bam la tho;",
            "             Lwmlou makna chamdaanv makmei mu,",
            "             Latzan hu khou kap' pwni.",
            "          2. Ravsic rui taanv taanc nipui ganv tei,",
            "             Nangniw thei khou nzwanna tatbam the:",
            "             Mitei rui nang ta nym kan pwni.",
            "             Ramh thayna chariakh thayna bam lo.",
            "             He kandihmei chabwan guay khou,",
            "             Kandih thaalaa rui nthiam pwni;",
            "             Syan lanv rui nic 'thiam pwni.",
            "          3. Kaganv tei chak lo kandihmei guay;",
            "             Simei rui ngam khang swguang pwni the:",
            "             Ringhmei latchamv dincruan bammei hei.,",
            "             Laalou nii mak khang taancguang pwni.",
            "             KaipouC rui nang ta nzianna",
            "             Kaw bammei khwan tei nang chu mak khang.",
            "             Ravsic rui taanv taancbam the.",
            "          4. Ravguangc Lat chulouna lwmmei guay",
            "             Khang chamdaanvlouna bammei pyrun tei,",
            "             Guang laa zihna cho nang pyrun tei.",
            "             Guang laa tho twna nang ta kaw e.",
            "             Kaganv tei tat ri kanpui tangv,",
            "             Ning ngam makna kaw bam dat sihnic.",
            "             Guang dat ngam ni tuang hamh the."
          ]
        }
      }
    },
