        "content": {
          "format": "source-lines",
          "lines": [
            "          275 Thow Pwnic Dui lev Bumaengh khou",
            "                               9.4.4.9.7. Ref. 6. 6. 6. 10",
            "          Doh hei Gb",
            "",
            "          1. \"Thow pw nic dui lev bumaengh khourui,",
            "             Puancthanh makmei (2)",
            "             Ravguangc Guangcdic khou gut ngam mak ge\",",
            "             Twna Poubauhmei saa e.",
            "",
            "                       Thow pw nic lwm ethei,",
            "                       Tingsaeng ringhmei laa ni,",
            "                       Thow pw nic lwm ethei,",
            "                       Tingsaeng zaengna (2) ringc ni.",
            "",
            "          2. Thow pw nic katuang guaihhphu sinna,",
            "             'Thei ziangrihmei (2)",
            "             Ravguangc Guangcdic mei sw ngammak ge.\".",
            "             Twna Poubauhmei saa e.",
            "",
            "          3. \"Thow pw nic kapui-pu ta zianna,",
            "             Thei ziangrihmei (2)",
            "             Ravguangc Guangcdic mei sw ngammak ge.\"",
            "             Twna Poubauhmei saa e.",
            "",
            "          4. \"Thow pw nic Athei lay nii ethei,",
            "             Kapumc karaana nuhmakna,",
            "             Katuang cross laathau lana gong o.\"",
            "             Twna Poubauhmei saa e."
          ]
        }
      }
