        "content": {
          "format": "source-lines",
          "lines": [
            "          130 Kandih Hei Ryanraapui Ramc",
            "                             7.7.7.7.7. Ref. 8. 7.7.7.7",
            "          Doh hei A",
            "",
            "          1. Kandih hei ryanraapui ramc;",
            "             Chwnsi mikdui luanghpui ramc.",
            "             Tabui nungc tat rini cho?",
            "             Akhang zaeng 'thaekcpui bamv maek;",
            "             Zaylou o, Nang baan zat rui.",
            "",
            "                  Jisu rui aniw khou saa e:",
            "                  Taanv ryanraana taanhmei lev,",
            "                  Puatcrith phunghmei kapwmna,",
            "                  Akhou guang o, nangniw guay,",
            "                  Ai rui zaeng tithaekclou ni.",
            "",
            "          2. Lungh ryanraamei kapwmna,",
            "             Jisu rui tineihlaalou;",
            "             Suanmei guay ta titanclou;",
            "             Miktiatmei ta tihowlou;",
            "             Ringhpui chaeng khou tei zaylou.",
            "",
            "          3. Taanv ryanraana taanhmei lev",
            "             Puatcrith phunghmei kapwmna",
            "             Akhou lou o, Kapwmna.",
            "             Apuatrith hei thu 'thaan e,",
            "             \"Khamhpui nungc zaeng tithaekc ni."
          ]
        }
      }
    },
