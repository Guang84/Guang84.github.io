        "content": {
          "format": "source-lines",
          "lines": [
            "          117 Kaipouc Ricpwan Kapwm Piu o",
            "                          9.9.9.9.Ref. 6. 6. 7.6.9.7. 6. 9",
            "          Doh hei E",
            "",
            "          1. Kaipouc ricpwan kapwmna piu o;",
            "             Seitaan tuang ngamv guay ta adow o;",
            "             Kahym daihmei khou ngammei sw o;",
            "             Kaipouc rui pumtan tiilou pwni.",
            "",
            "                      Huayney o, kaganv 'thuih;",
            "                      Bumaengh Thanmei paan rui,",
            "                      Zauczihmei ric ta ngam khang,",
            "                      Huayney o, huayney o.",
            "                      Rihngam khang huayney o ngam mak saanv.",
            "                      Zauczihmei ric ta ngam khang,",
            "                      Huayney o, huayney o.",
            "                      Rihngam khang huayney o, huayney o.",
            "",
            "          2. Nchumhmei rui siangiat sw lana,",
            "             Ntwnpui tuang rui ngaengvthuapc louna,",
            "             Gaychamv lat rui nang phay khou louna,",
            "             Lwmmei n-gic phungcna ding 'tip bo.",
            "",
            "          3. Ringhbamv tuang rih pyrun run lana,",
            "             Ravguangc Lat rui thandibaeng swna,",
            "             Kaipouc Khrista Lat khou lwmlouna,",
            "             Adow o, he kros tuang ricmei guay."
          ]
        }
      }
    },
