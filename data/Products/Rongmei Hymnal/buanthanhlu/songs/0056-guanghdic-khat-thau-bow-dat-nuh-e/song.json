        "content": {
          "format": "source-lines",
          "lines": [
            "          56 Guanghdic Khat Thau, Bow Dat Nuhe",
            "                                      8.8.9.4.Ref.",
            "          Doh hei A",
            "",
            "          1. Guanghdic khat thau, bow dat nuh e;",
            "             Zaatc guayna rui 'muc bam nuh e:",
            "             'Kic Ravguangc Lat mu kalaic dat lak;",
            "             Tingsaeng zaengna.",
            "",
            "          2. Ravguangc latryan lwm tho;",
            "             Khrista khou lwm tho;",
            "             Ringhbamv laa khang tingsaeng zaeng khang",
            "             Kakhou lwm tho.",
            "",
            "          3. Kandih puat hei tingsaengh mak ge;",
            "             Asaanh mak khou 'maan ngam pwni;",
            "             'Kic Ravguangc Lat mu kalaic dat mak;",
            "             Tingsaeng zaengna."
          ]
        }
      }
    },
