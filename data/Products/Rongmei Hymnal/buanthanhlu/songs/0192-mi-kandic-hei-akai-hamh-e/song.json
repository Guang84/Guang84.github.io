        "content": {
          "format": "source-lines",
          "lines": [
            "          192 Mi Kandic hei Akai Hamh e",
            "                             8.8.8.8.Ref. 10. 10.8",
            "          Doh hei E",
            "",
            "          1. Mi kandic hei akai hamh e,",
            "             Ai n-gin khanvloupui bamv de.",
            "             Mi kandic hei 'maanpui nungc kiu,",
            "             Tingkauh akai ai nzwan ni.",
            "",
            "                  Kandih ramgai hei mu atuang hamh e,",
            "                  Alanv guay lou ducna ai tat pwni.",
            "                  Tingsaengc lak khe akai 'zwan khang.",
            "",
            "          2. Akhang chamdaanvloumei ramc kiu,",
            "             Ai machunh e, he Poubauhmei.",
            "             Kandih ramgai asaanh lungc ni ?",
            "             'Patlou duc ni mi ramc hei mu.",
            "",
            "          3. Tingkauh akai tangh pui nungc kiu,",
            "             Aryanraa guay 'maan pwni the.",
            "             Tat rey kanmei 'zianmei guay ta,",
            "             Ariu pwni kaidai khoutei."
          ]
        }
      }
    },
