        "content": {
          "format": "source-lines",
          "lines": [
            "          295 Zauclo, Ravguangc Nac Thiu",
            "                          6.6.6.7.Ref. 9. 8. 10.7",
            "          Doh hei D",
            "",
            "          1. Zauc lo, Ravguangc nac thiu,",
            "             'Maan nimei bumaengc ta;",
            "             Seitaan bangc sw ngam the,",
            "             Ringhmei chaeng khou zaylou o.",
            "",
            "                  Paapc zaeng cross khou theicloumeipu ta,",
            "                  Kandihmei guay rui thuanc kan diuc!",
            "                  Kamei nunc guay ta laa dat diuc khangrui,",
            "                  Kamei guang dat pwni the.",
            "",
            "          2. Zauclo, laupuk guay ta;",
            "             Thow cho lau tay nimei?",
            "             Tay guang ngammak khourui,",
            "             Neih khyamkey kan pwni the.",
            "",
            "          3. Zauclo, kaganv 'naa the:",
            "             Latzan tingmik 'naa the.",
            "             Tingpuk kandih guay nic,",
            "             Mai rui raw ngam kan pwni."
          ]
        }
      }
    },
