        "content": {
          "format": "source-lines",
          "lines": [
            "          184 'Maan Nimei Nunc ta Thuakpatlou Khang",
            "                             9.9.9.10.Ref.8. 8.8.8.8.10.9",
            "          Doh hei G",
            "",
            "          1. 'Maan nimei nunc ta thuakpatlou khang,",
            "             Ravguangc Nac Mpouh ta 'diukeylou.",
            "             'Maan nimei chaeng tatna bam pwkhou,",
            "             Ariu ni Thuakloumeipu Jisu ta.",
            "",
            "                  Nang lingcloumei 'tay dat pwni; (2)",
            "                  Maansei pumc khou nroumei guay,",
            "                  Meic pumc khang theihmei 'tay dat ni;",
            "                  Bumaengh khang nroumei tei mu,",
            "                  Bumaengh tingsaeng ringhmei tei laa pwni.",
            "                  Nang rui lingcloumei 'tay dat pwni.",
            "",
            "          2. Ravguangc ruina thauh 'teyloumei tei",
            "             David paapc rui kahawmei taanh' rui,",
            "             Kanac mpouh khou theihmei pat the.",
            "             Kakandic ruc khou zauczihmei padik.",
            "",
            "          3. Kanac Mpouh ta lwm makmei mu,",
            "             Tingsaeng ryanraamei tei laa pwni;",
            "             Kanac Mpouh ta lwmmei tei mu,",
            "             Bumaengh tingsaeng ringhmei tei laa pwni."
          ]
        }
      }
    },
