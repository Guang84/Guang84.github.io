        "content": {
          "format": "source-lines",
          "lines": [
            "          140 Kandih khouhei Pian Makmei lev",
            "                             8.8.12.8.8. 12.Ref. 8. 8. 8.8.8.4",
            "          Doh hei E",
            "          1. Kandih khouhei pian makmei ley",
            "             Karaeng zauczihmei padik ge;",
            "             Nzianmei rui heic guay tihei swmaan ngam e.",
            "             Agay agimei 'khucmei lung,",
            "             Lwmsiimei lung rui padik ge.",
            "             Nzianmei rui heic guay ti hei swmaan ngam e.",
            "",
            "                  Zinghmei 'dic khou bammei guay rui,",
            "                  Gaanhmei riw ta hownii bam e.",
            "                  Zinghmei 'dic khou bammei guay rui,",
            "                  Khrista ramgai lungc lyan ngam khang,",
            "                  Khrista ramzian aniw lungc khou",
            "                  Nai khang ney kho.",
            "",
            "          2. 'Niw 'zian pwkhou kunghmei maek ge;",
            "             Pingmei lung guay 'maan ngam pwni;",
            "             Chalumc siimei mamavmei lung 'maan ngam pwni.",
            "             'Niw chwn 'chamc lungh 'chamhna lungh khang,",
            "             Khat khat ta nzian nina de.",
            "             Nzianmei rui simei guay ta timaan ngam e.",
            "",
            "          3. Ravguangc hei thu zianthaymei e;",
            "             Karamzian 'niw khou lyanlou the.",
            "             Aniw tihei kanac nunc twna kawlou the.",
            "             'Niw nic kakumcna 'zian tithei,",
            "             Karaeng zauczihmei 'maan pwni.",
            "             Nzianmei rui hei guay tihei swmaan ngam e."
          ]
        }
      }
