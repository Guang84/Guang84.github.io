        "content": {
          "format": "source-lines",
          "lines": [
            "          236 Poubauhmei Tingkauh Ramc khou",
            "                          10.7.9.7. Ref. 6. 6. 7.6",
            "          Doh hei Db",
            "",
            "          1. Poubauhmei, tingkauh ramc khou zaylou o;",
            "             Lili pwang lev kaphut rui",
            "             Kasiamhloumei tingkauh ramc khoutei.",
            "             Amachun rui loukey ni.",
            "",
            "                  Poubauhmei ramc tingkauh,",
            "                  Tingsaengzaeng 'baanvthay ni,",
            "                  Meic ching ching rui nzwan tat,",
            "                  Khoutei ai nic tat ni.",
            "",
            "          2. Apu rui guang tho twna kawpui nungc,",
            "             Baanch'raa ta ndiu keyna,",
            "             Abumaengc tingkauh thangc phungcku ni;",
            "             Apu zaw khoutei how ni.",
            "",
            "          3. Nrianhloumei tingkauh ramc gaymei khou,",
            "             Guang khang apu rui kaw bam;",
            "             Ryanraamei kaguay ganclou duc lana,",
            "             Tingsaeng zaeng 'baanvthay bam ni."
          ]
        }
      }
    },
