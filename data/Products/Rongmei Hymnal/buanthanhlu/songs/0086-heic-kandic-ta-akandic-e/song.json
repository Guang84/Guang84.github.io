          "lines": [
            "          86      Heic Kandic ta Akandic e",
            "                          8.5.9.4. Ref. 8. 7. 8.6",
            "          Doh hei D",
            "",
            "          1. Heic kandic ta akandic e",
            "             Twna ning khourui,",
            "             Nzianmei guay lungh khang tat kan the",
            "             Jordan paengc thangc.",
            "",
            "                  Neihmik nic gaanhmei nsaa de;",
            "                  Bw lev gaanchuangcna guay nic;",
            "                  Baanh sin kadymei nai lak khe;",
            "                  Gaanhmei Jisu hu khou.",
            "",
            "          2. Heic kandic khou suhmei naumei guay",
            "             Nai dat lak khe.",
            "             Nzianmei guay ta ariu pwni",
            "             Jordan paengc thangc.",
            "",
            "          3. Lwmmei guay mu tingkauhramc thangc",
            "             Lungh khang tat kan the.",
            "             Tat rey kanmei nzianmei nunc ta",
            "             Ariu pwni."
          ]
        }
      }
