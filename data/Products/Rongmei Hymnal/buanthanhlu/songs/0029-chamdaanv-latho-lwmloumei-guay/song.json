        "content": {
          "format": "source-lines",
          "lines": [
            "          29       Chamdaanv Latho Lwmloumei Guay",
            "                                    8.8.8.8.Ref.8.8.8.8",
            "",
            "          Doh hei G",
            "",
            "               1. Chamdaanv latho lwmloumei guay,",
            "                  Lautay nimei ganv guang pwthe.",
            "                  Kamei rui baengkhuai sinthau the;",
            "                  Chamdaanv latho lwmloumei guay.",
            "",
            "                         Lautay nimei ganv guang pwthe.",
            "                         Napguy tei minc nzinh ngam the,",
            "                         Nkhuk keyna mincraam ngam the.",
            "                         Khuam kaduai nipui ganv di the.",
            "",
            "               2. Baengkhuai tei sinna 'tay pwni.",
            "                  Poubauhmei rui kumna saa e:",
            "                  Lau guay tei minc nzinh ngam the;",
            "                  Napchu guay khuam kaduai pwni.",
            "",
            "               3. Tingkauh baanch'raa 'thanmei guay nic,",
            "                  Kaniw tuang baengkhuai sinthau the.",
            "                  Napguy tei mincraam pwni the;",
            "                  Daihmei 'thyammei laupuk guay tei.",
            "",
            "               4. Minc bammei napthai guayna tei,",
            "                  Kagung katak kadaa pwni.",
            "                  'Tay nsaekclou tuang nai lak khe.",
            "                  Nap guay saamh khou phungcguang pwni."
          ]
        }
      }
    },
