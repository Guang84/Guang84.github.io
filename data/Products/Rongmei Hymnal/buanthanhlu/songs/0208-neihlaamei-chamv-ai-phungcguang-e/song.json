        "content": {
          "format": "source-lines",
          "lines": [
            "          208 Neihlaamei Chamv Ai Phungcguang e.",
            "                                8.9.8.9.Ref. 9.9.9.9",
            "",
            "          1. Neihlaamei chamv ai phungcguang e;",
            "             Tingkauh namvdai neihlaamei chamv e.",
            "             Paapc ric ngamna guangmei guay khang",
            "             Ravguangc rui chamdaanvloumei chamv e.",
            "",
            "                     Meic guayna mphwanmei pwan piuna",
            "                     Neihlaa lu rui Ravguangc ta thuancna",
            "                     Tingkauh mei guay suan bammei lu tei -",
            "                     Kidaa khang maekmei ramnugai e.",
            "",
            "          2. Daihmei thyammei nai dat lak khe,",
            "             Nyngtyngmei mpangmei nic maek khe,",
            "             Lungcgai lungsi nai dat lak khe,",
            "             Zauczih karaengmei nai dat lak khe.",
            "",
            "          3. Chwnsi mikdui keymei maek khe,",
            "             Ntamvmei lwn nic how dat lak khe.",
            "             Thuakloumei guay lungc nipui ramc",
            "             Ravguangc rui chamdaanvloumei namdai.",
            "",
            "          4. Kandih tuang chingkhiuhmei guay ta",
            "             Ningtow dat lak khe, how dat lak khe.",
            "             Gaanc kangvranmei riw rui gaanc e,",
            "             Tingsaeng zaeng lungc nipui namvdai tei."
          ]
        }
      }
