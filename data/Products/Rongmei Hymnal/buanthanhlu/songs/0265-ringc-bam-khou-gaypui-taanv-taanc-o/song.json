        "content": {
          "format": "source-lines",
          "lines": [
            "          265 Ringc bam khou Gaypui Taan Taanc o",
            "                                 8.6.8.8. Ref. 7. 6. 8.9",
            "",
            "          1. Ringc bam khou gaypui taanv taanc o.",
            "             Paapc tuang neihlaa guayrui,",
            "             Aseic Jisu zanc khouruina",
            "             Hymdaihmei pyrun run pwni.",
            "",
            "                     He, Kandih guangcna pyrun,",
            "                     Tingsaeng khang sw ngammak,",
            "                     Tingkauh thu Ringhmei Guangh pyrun,",
            "                     Lungh laicguangmei guay rui run pwni.",
            "",
            "          2. Reynungc Eden Pikwan khoutei,",
            "             Eve lev Adam ruina,",
            "             Kaney bamv mpatlou ducna,",
            "             Siimei paap rui nduangh tat the.",
            "",
            "          3. Kaniw khwan lev Immanuel,",
            "             Lungh ryanraamei 'dih khou,",
            "             Neihkhat kiu Cananramc gay khou.",
            "             Lwmmei guoy lev ruantat bam ni.",
            "",
            "          4. Nritmei paap puat luak gancna,",
            "             Gaanhmei khou guang pwkhou,",
            "             Zinghmei bamv mpatlou ducna,",
            "             'Niw lung zinghmei guay 'maan pwni."
          ]
        }
      }
