        "content": {
          "format": "source-lines",
          "lines": [
            "          215 'Niw Panty Hei Dui Luangh Kumcna",
            "                                8.8.12.8.8. 10,4",
            "          Doh hei F",
            "",
            "          1. 'Niw panty hei dui luangh kumcna.",
            "             Tingmik kathuih tatna bam e.",
            "             Ngin tatmei kumcna tat bammei panty hei.",
            "             'Maan kan nimei mbaanv puat ta,",
            "             Machunhna ning bam khwan ethei.",
            "             'Maan pwni the 'zianmei rup-ryan guay le:",
            "             Ganc ngam di kho.",
            "",
            "          2. 'Dih neihlaamei tei phu khourui,",
            "             Meic ching ching panty 'maan kan the.",
            "             'Dih ramgai mu lauthwan mwnpwang kumh",
            "             tuang na de.",
            "             Phu tow mak ge heic kandic khou,",
            "             Neihlaa suangmei panty laa khang.",
            "             Chariakh thayna lungc bam di kho,",
            "             Jisu guang pwni the.",
            "",
            "          3. Heic kandic khou chabwan guay hei,",
            "             'Maanmei chaeng khou tatna bam e.",
            "             Khuamguang ngam khang dinc tat di kho",
            "             ringhmei lat tei.",
            "             Baibal lat rui sakhi swna,",
            "             Rih tei adow khang tat di kho.",
            "             Tatpat di kho 'zianmei rup-ryan guay le,",
            "             'Maan ngam ni the."
          ]
        }
      }
    },
