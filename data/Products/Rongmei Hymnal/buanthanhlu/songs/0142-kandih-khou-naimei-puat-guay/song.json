          "lines": [
            "          142      Kandih khou Naimei Puat Guay",
            "                                       7.7.7.9. Ref.",
            "          Doh hei F",
            "",
            "          1. Kandih khou naimei puat guay,",
            "             Nang kahawbam nina cho?",
            "             Kandih hei luaipui nungc kiu,",
            "             Amaan ngam kan nimei raana de.",
            "",
            "          2. Kandih khou naimei puat guay,",
            "             Kalwn nic kalaic ngam the.",
            "             Aniw lung nic kalaicna,",
            "             Poubauhmei key datmei nkhwan kho.",
            "",
            "          3. Puatcrith phunghmei kaguay ta,",
            "             Jisu 'zianna kawbam the.",
            "             Akhou guang o nangniw guay;",
            "             Ai rui zaeng ti-nthaekclou pwni.",
            "",
            "          4. Poubauhmei keypui nungc kiu,",
            "             Kakhou lwmlou makmei guay,",
            "             Kataanv nic taanclou makna,",
            "             Maikwam khou ryanraa akhaengv pwni."
          ]
        }
      }
