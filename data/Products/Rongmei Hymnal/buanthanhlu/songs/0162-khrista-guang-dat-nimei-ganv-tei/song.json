          "lines": [
            "          162 Khrista Guang dat nimei Ganv tei",
            "                           8.10.8.9. Ref.8.9. 10.9",
            "",
            "          1. Khrista guang dat nimei ganv tei,",
            "             Tingkauhbaancharaa guay nic thaymak ge.",
            "             Katingmik kakhuangc ganv thaymak,",
            "             Kaihouhmei kumcna guang pwni the.",
            "",
            "                  Kaganv kathuih chamdaanv bam o.",
            "                  Ramhthayna huayney ranvna bam o.",
            "                  Nthanmei panty khou lungcna bam o.",
            "                  Khrista katumcna guang pwni the.",
            "",
            "          2. Zaatc khat rui zaatc akhat ruc khou,",
            "             Rih swmei chamv rana chu bam the;",
            "             Pat bammei khudam guay zauc lo,",
            "             Khrista katumcna guang pwni the.",
            "",
            "          3. Laupuk khou gaanvnei bam. pwni,",
            "             Lwmloumei gaanvkhat ta laathau 'ni,",
            "             Lwmmakmei ta ganclou duc 'ni",
            "             Lwmlouna chamdaanv bam kan di kho."
          ]
        }
      }
    },
