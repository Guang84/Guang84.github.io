            "          12.    Akhou Guang o Zionramc",
            "                                 7. 7. 7. 3. D",
            "",
            "          Doh hei Ab",
            "",
            "          1. Akhou guang o Zion ramc (3)",
            "             Tingkauh ramc",
            "             Akhou guang o Zion ramc (3)",
            "             Tingkauh ramc",
            "          2. Khoutei kapmei nai lak khe (3)",
            "             Tingkauh khou.",
            "          3. Khoutei ryanraa' nailak khe (3)",
            "             Tingkauh khou.",
            "          4. Khoutei ndaapc t'ri lak khe (3)",
            "             Tingkauh khou.",
            "          5. Khoutei theihmei nai lak khe (3)",
            "             Tingkauh khou.",
            "          6. Lauziunac rui gaanc bam e (3)",
            "             Tingkauh khou.",
            "          7. Jisu guang dat zaic pwni. (3)",
            "             'Kauh thangcrui.",
            "          8. Chanaa, pui-pu tat reymei (3)",
            "             Ariu ni.",
            "          9. Halleluijah, Hossanna (3)",
            "             Thuanc bam ni."
          ]
        }
      }
