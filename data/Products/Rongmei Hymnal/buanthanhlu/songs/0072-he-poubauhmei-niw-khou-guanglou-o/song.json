            "          72 He Poubauhmei 'Niu khou Guanglou o",
            "                                 9.9. Ref 6.3.5.6",
            "          Doh hei G",
            "",
            "          1. He Poubauhmei 'niu khou guanglou o.",
            "             He Poubauhmei 'niu khou guanglou 0.",
            "",
            "                  Ntaw khourui thauna,",
            "                  Aniu dic hei Missionary",
            "                  Kandic 'swlou o;",
            "                  Pou' 'niu ta 'zianlou o.",
            "",
            "          2. He Poubauhmei suaihiam tiilou o.",
            "             He Poubauhmei suaihiam tiilou o.",
            "",
            "          3. He Poubauhmei 'niu ta 'khavlou o.",
            "             He Poubauhmei 'niu ta 'khavlouo.",
            "",
            "          4. He Poubauhmei 'niu ta ganclou rio.",
            "             He Poubauhmei'niu ta ganclou rio.",
            "",
            "          5. He Poubauhmei 'niu ta gulou o.",
            "             He Poubauhmei 'niu ta gulou o.",
            "",
            "          6. He Poubauhmei 'niu ta laalou o.",
            "             He Poubauhmei'niu ta laalou o.",
            "",
            "          7. He Poubauhmei 'niu ta 'duanghlou o.",
            "             He Poubauhmei 'niu ta 'duanghlou o."
          ]
        }
