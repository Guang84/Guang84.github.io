            "          52 Guang Nimei Neihlaa Zaenggaymei",
            "                           8.8.8.8.8. Ref. 8. 8. 8.8",
            "          Doh hei G",
            "",
            "          1. Guang nimei neihlaa zaenggaymei, (2)",
            "             He t'ui nungcrui ai how ni cho?",
            "             Guang nimei neihlaa zaenggaymei,",
            "             He t'ui nungcrui ai how ni cho?",
            "",
            "                      Duipaengcramc gay' guangtangc pwkhou,",
            "                      Ntamvmei hei nai dat lak khe.",
            "                      Duipaengramc gay' guangtangc pwkhou,",
            "                      Ntamvmei hei nai dat lak khe.",
            "",
            "          2. Akhang gay liangmei tingmik kiu, (2)",
            "             He t'ui nungcrui ai how ni cho?",
            "             Akhang gay liangmei tingmik kiu,",
            "             He t'ui nungcrui ai how ni cho?",
            "",
            "          3. Aruprian nzianmei guay ta, (2)",
            "             He t'ui nungcrui ai how ni cho?",
            "             Aruprian nzianmei guay ta,",
            "             He t'ui nungcrui ai how ni cho?",
            "",
            "          4. Neihmik key dat makpui ramc kiu, (2)",
            "             He t'ui nungcrui ai how ni cho?",
            "             Neihmik key dat makpui ramc kiu,",
            "             He t'ui nungcrui ai how ni cho?"
          ]
        }
