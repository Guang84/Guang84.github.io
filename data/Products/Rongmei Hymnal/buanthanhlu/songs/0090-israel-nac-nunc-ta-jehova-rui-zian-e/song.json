        "content": {
          "format": "source-lines",
          "lines": [
            "          90 Israel Nac Nunc Ta Jehovah rui 'Zian e",
            "                               11.9.8.8.5. Ref. 8.7.8.5",
            "          Doh hei D",
            "",
            "          1. Israel nac nunc ta Jehovah rui 'zian e.",
            "             Mousi ta 'diuna nduanghpat re.",
            "             'Rianhloumei ramc guangtangh mak khang,",
            "             'Thiammei ric daic e.",
            "",
            "                          Charyn tuang e! Charyn tuang e!",
            "                          Izip ramc lungning phunghmei!",
            "                          Nrianhloumei Kanaan kandic",
            "                          Guangtangc ngammak ge.",
            "",
            "          2. Kachaekc namvdai gay khou",
            "             lwmmei guay lungc 'chamc ni.",
            "             Ryanraamei lung rui zauc kim ngam mak.",
            "             Ringhmei thingbang lim khou",
            "             Salem lu suanna thuanc ni.",
            "",
            "          3. Apanty phaydyng hei zaenggaypui phaydyng e.",
            "             Nduanghlou o he Bumaengh 'Thanmei.",
            "             Tingsaeng ramc gay' guangtangc pwkhou,",
            "             Neihlaa lu suan ni."
          ]
        }
      }
