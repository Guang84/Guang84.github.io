        "content": {
          "format": "source-lines",
          "lines": [
            "          171 Korinthia khou Paul Rui Saa e",
            "                           8.8.7.8.8. Ref. 8. &.7. 8. 8",
            "          Doh hei Gb",
            "",
            "          1. Korinthia khou Paul rui saa e:",
            "             Tiipat khang nzavna tiimei,",
            "             Tanthihna tiimei guay tei,",
            "             Laa rau pwni katuang phwnling;",
            "             Tii nina tii o Ravguangc khang.",
            "                  Paul rui saaloumei tei kumcna,",
            "                  Nzavna tiimei guay khang mu,",
            "                  Kakhang tei biuh mak pwni;",
            "                  Tanthihna tiimei tei rw mak:",
            "                  Neihlaana tii o Ravguangc khang.",
            "          2. Kazauzian daic e Ravguangc hei;",
            "             Aniw neihlaana tiipat kho;",
            "             Tii nii makna tiimei tei,",
            "             Laathaulou mak ge Ravguangc rui;",
            "             Neihlaana tii o laa geih khang.",
            "",
            "          3. Nang rui tiiloumei guaytei rui,",
            "             Poubauhmei hym tidaih khang e;",
            "             Ryanraa lak sihnic taanc kho;",
            "             Phwnling guay tei tiipat lana,",
            "             Poubauhmei zanc tidaicpat ro.",
            "",
            "          4. APoubauhmei ramzian daic e:",
            "             Lungcsi lungcroucmei nac guay khang,",
            "             Lungcgay khang tiilou ngam e;",
            "             Lungc ryanraana lungc bammei guav.",
            "             Neihlaana tii o Ravguangc khang."
          ]
        }
      }
    },
