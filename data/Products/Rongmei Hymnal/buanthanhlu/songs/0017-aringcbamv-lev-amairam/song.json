          "lines": [
            "          17     Aringcbamv lev Amairam",
            "                         11.9.9.8.Ref.7.9.9.8",
            "          Doh hei D",
            "",
            "          1. Aringcbamv lev amairam kiu Ravguangc e.",
            "             Thow ta ai rui pingbam nina cho?",
            "             Ringhmei lev pumtan tei Ravguangc e,",
            "             Thow ta ai pingbam nina cho?",
            "",
            "                 Nzianmei apui 'pu rui",
            "                 Ata ganc nrulou pwsihnic,",
            "                 'Ziangthaymei damcloumei Ravguangc rui",
            "                 Zaythauna pamc-puanclou pwni e.",
            "",
            "          2. Ravguangc khourui ai ramh khatna kahaw e,",
            "             Karamgai tei ai how khang ning e,",
            "             Apanty tingmik kaguayna hei,",
            "             Ravguangc kai khou lungc bam ni the.",
            "",
            "          3. 'Zianthaymei Ravguangc rui `aniw ta kaw e,",
            "             Theihmei zinghmei kandic khouruina,",
            "             Mpatlouna Adaeng khou guang o,",
            "             Zanhpumc panty hei luai mak khou."
          ]
        }
      }
    },
