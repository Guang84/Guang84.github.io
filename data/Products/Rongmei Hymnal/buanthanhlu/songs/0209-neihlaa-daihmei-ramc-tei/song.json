        "content": {
          "format": "source-lines",
          "lines": [
            "          209 Neihlaa Daihmei Ramc tei",
            "                       11.11.10. 11.Ref. 7.5.7.4. 11",
            "          Doh hei Ab",
            "",
            "          1. Neihlaa daihmei ramc tei guang khang duh mak khe:",
            "             'Zianmei, 'khamhpui ganv khou lwmlou khang",
            "             'khwan riu.",
            "             Nang bumaengc phaysuy 'théi nang 'maan pwni.",
            "             'Zianmei 'khamhpui ganv khou lwmlou khang",
            "             'khwan riu.",
            "",
            "                       'Khwan riu, lwmlou khang 'khwan riu.",
            "                       'Khamh liangmei ganv khou,",
            "                       Nang bumaengc phaysuy ethei,",
            "                       Nang 'maan pwni;",
            "                       'Zianmei, 'khamhpui ganv khou lwmlou khang",
            "                       \"khwan riu.",
            "",
            "          2. Paapc chaeng khou tatmei khang ryanraa zaic ni the;",
            "             Chulou o champanv guay kaganv 'naaguang the.",
            "             Poubauhmei rui chaeng laanclouna bam e;",
            "             'Zianmei 'khamhpui ganv khou lwmlou khang",
            "             'khwan riu."
          ]
        }
      }
    },
