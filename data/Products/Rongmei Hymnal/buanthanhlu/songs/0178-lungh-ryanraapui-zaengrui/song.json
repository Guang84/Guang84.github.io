        "content": {
          "format": "source-lines",
          "lines": [
            "          178 Lungh Ryanraapui Zaeng rui",
            "                             7.7.7.7.Ref. 9.9.7.7",
            "",
            "          1. Lungh ryanraapui zaeng khourui,",
            "             Tingkauh ramc ta ai zauc bam;",
            "             Kandih tuang ramgai ruina,",
            "             Nthiamna bam e ata.",
            "",
            "                     He ata Kanloumeipu daeng thangc,",
            "                     Kamei nunc khang kadahpui nungc kiu,",
            "                     Chuy mak liangmei ai sihnic,",
            "                     Guang ding ni Ravguangc hu khou.",
            "",
            "          2. Kandih tuang siimei ruina,",
            "             Tingmik thuih athei lay bam.",
            "             Ai ryanraa the he Ravguangc;",
            "             Nang Bumaengc rui zaylou o.",
            "",
            "          3. Nang mei khang kadah nungc kiu,",
            "             Ata nic laalou ni cho?",
            "             Nang pumtan rui 'khavlou o,",
            "             Nang zauzian daihmei paan rui.",
            "",
            "          4. Nang hymdaihmei tingmik khou,",
            "             Nang mei nunc ta laa pwkhou,",
            "             Kandih tuang puat guayna ta,",
            "             'Muc ngam pwni tingkauh thangc."
          ]
        }
      }
