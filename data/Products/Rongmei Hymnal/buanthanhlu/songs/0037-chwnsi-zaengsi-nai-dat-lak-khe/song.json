        "content": {
          "format": "source-lines",
          "lines": [
            "          37 Chwnsi Zaengsi Nai Dat Lak khe",
            "                             8.8.11.Ref. 7. 8.9",
            "          Doh hei E",
            "",
            "          1. Chwnsi zaengsi nai dat lak khe,",
            "             Tingkauh Jirusalem Thanh khou.",
            "             Aniw guang tangc pwkhou, 'niw neihlaa 'chamc ni.",
            "",
            "                  He tingkauh Jirusalem !",
            "                  Chwnsi zaengsi nai dat lak khe,",
            "                  Tingkauh Jirusulem Thanh gay khou.",
            "",
            "          2. Kandih ryanraa nai dat lak khe,",
            "             Tingkauh Jirusalem Thanh khou.",
            "             Tingkwm ching ching thuanc bam ni,",
            "             Hallelujah !",
            "",
            "          3. Heic kandih ryanraa ramc khouhei,",
            "             Lwmmei guay tingsaengc pwlak khe;",
            "             Tingkauh Jirusalem Thanh khou lungc pwni."
          ]
        }
      }
    },
