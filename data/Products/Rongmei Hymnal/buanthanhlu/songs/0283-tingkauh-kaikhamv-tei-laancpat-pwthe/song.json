        "content": {
          "format": "source-lines",
          "lines": [
            "          283 Tingkauh Kaikhamv tei Laancpat",
            "                              9.6.9.Ref. 10.8.4",
            "          Doh hei D",
            "",
            "          1. Tingkauh kaikhamv tei laancpat pwthe;",
            "             Baanch'raa guay tei dingna.",
            "             Lwmmei guay ta laa khang key pwni.",
            "",
            "                      Baanh hiwna neihlaamei kim dat lak he,",
            "                      Swkaeng naina samc pwni e,",
            "                      Kaanpatmei guay.",
            "",
            "          2. Ringhmei thingbang lim gaymei khoutei,",
            "             'Thanmei alauc guay rui,",
            "             Mpwan kumcna khoutei samc bam e.",
            "",
            "          3. Heic ramc gay khoutei lungc nimei guay,",
            "             Lwm tho Kaipouc Khrista,",
            "             Muangh khou dungcna Kamei key pwni.",
            "",
            "          4. Kumna dinc e chamdaanvmei ganv e;",
            "             Thow pwnic chamdaanvmei,",
            "             Kaipouc Khrista guang khou tat 'chamc ni."
          ]
        }
      }
    },
