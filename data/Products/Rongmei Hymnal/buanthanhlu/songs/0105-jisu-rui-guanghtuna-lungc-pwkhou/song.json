          "lines": [
            "          105     Jisu rui Guanghtuna Lungc Pwkhou",
            "                                9.9.9.Ref. 9.9.9. 9",
            "          Doh hei E",
            "",
            "          1. Jisu rui guanghtuna lungc pwkhou,",
            "             Amuh swna kata lungc 'chamc ni;",
            "             Tingkwm ching kata guanghtu 'chamc ni.",
            "                   Chulouna neihlaamei padik the.",
            "                   Chu zaenghna zaeng thaekc nipui ramc kiu,",
            "                   Jerusalem Thanh khou lungc pwkhou. (2)",
            "          2. Ringcthau datmei guay guang kariuna,",
            "             Jerusalem Thanh khou kariuna,",
            "             Ravguangc tikgunc daihmei ta thuanc ni.",
            "          3. Jisu khou lwmlou makmei guay mu,",
            "             Kandih khou lungc nchamc bam sihnic,",
            "             Tingkauh ramc khou kiu ntamv pwni.",
            "          4. Jisu rui guanghtuna lungc pwkhou,",
            "             Kandih khgou suc-rih nai dat lak khe.",
            "             Chu-zaengmei guangcdic swna lungc ni."
          ]
        }
      }
