          "lines": [
            "          253 Ravguangc rui 'Niw ta Damc Chuylouna",
            "                               9.9.11.8. Ref. 6. 3.9.8",
            "",
            "          1. Ravguangc rui 'niw ta damc chuylouna.,",
            "             Gay liangmei mwnpwang kumc damclouna,",
            "             Kakwan khatna kumhmei mwnpwang guayna ta,",
            "             Kaganv rui phungc 'tamvlou duc the",
            "",
            "                    Ravguangc suaihiam phungcna",
            "                    Tat khwan tho.",
            "                    Kaipouc tuang hymdaihmei lungc lyanna,",
            "                    Dwan gaymei tampy swkhwan tho.",
            "",
            "          2. Mbaanv khou aniw guay panty hei,",
            "             Kabou khourui samctatmei ruay kumc,",
            "             Kabamv baih baih thangc samctatna bam sihnic",
            "             \"Kauh kandic thang 'niw lungc 'chamc ni."
          ]
        }
      }
    },
