        "content": {
          "format": "source-lines",
          "lines": [
            "          284 Tingkauh Kandic khou Ai Lunghpui Bamv",
            "                            9.9.7.7. 11.Ref. 6. 6. 6.9",
            "",
            "          1. Tingkauh kandic khou ai lunghpui bamv",
            "             Chamdaanv khang Poubauhmei tat kan the.",
            "             Zaylou nimei ramc khoutei,",
            "             Lwmmei lev nzianmei guay,",
            "             Bumaengh Nthanmei lev lu suanna bam ni.",
            "",
            "                         Kauh kandic gay liangmei,",
            "                         Neihlaamei ramc khoutei,",
            "                         Ryanraa ryanriumei maek,",
            "                         Mi ramc thangc tei neihkhat tat pwni.",
            "",
            "          2. Akhang ruina Poubauhmei theiclou,",
            "             Apanty hei luaipui nungc kiu mu,",
            "             Ryanraa ryanriumei mbaanv,",
            "             Khouhei rui ai twan lana,",
            "             Tingkauh kandic akai thangc ai tat ni the.",
            "",
            "          3. Kaganv thuihna aPoubauhmei rui,",
            "             Ata nduanghlouna tat bam e,",
            "             Tingsaeng zaeng Poubauhmei lev",
            "             Bam 'chamc ni Kaidai khoutei,",
            "             Zauczihmei rui ngammei nai dat lak khe.",
            "",
            "          4. Tingkauh Kaidai ai tanghpui nungc kiu,",
            "             Bw lev neih rui gaanhmei nai lak khe,",
            "             Chwnsiimei mikdui keymei",
            "             Ryanra ryanriumei guayna,",
            "             Khatsihnic maek khe tingkauh ramc khoutei."
          ]
        }
      }
    },
