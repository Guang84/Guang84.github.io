        "content": {
          "format": "source-lines",
          "lines": [
            "          250 Ravguangc rui Kamei' Khang",
            "                        10.8.10.8. Ref. 1 1.11.10.10.9.8",
            "          Doh hei B",
            "",
            "          1. Ravguangc rui Kamei khang chamdaanvloumei,",
            "             Pyrun kazaat panguh nai e;",
            "             Kalat piuna Kata lwmmei guay rui,",
            "             Heipui pyrun tei run pwni:",
            "",
            "                  Theihmei nganv lwmloumei rui ringhmei pyrun,",
            "                  Kataanv taanhmei khang Kahym daihmei pyrun,",
            "                  Nthanmei khang ravchaptatmei pyrun,",
            "                  Rigwn bammei khang neihlaamei pyrun,",
            "                  Akhaengv saenghmei khang rihngammei khang,",
            "                  Kamv dat lakmei pyrun tii ni.",
            "",
            "          2. Jisu rui latzan sw tang pwkhou kiu,",
            "             Swan guay tei nzanhlou pwni.",
            "             Pyrun laatow makmei kaguay tei mu,",
            "             Ravguangc hu khou meiczak pwni.",
            "",
            "          3. Ravguangc rui tiimei pyrun run lana,",
            "             Zawkauhna thuanckuna bam ni.",
            "             \"Halleluijah! Amen!\" lu tei suanna,",
            "             Ravguangc Lauziu Nac hu khoutei."
          ]
        }
      }
