        "content": {
          "format": "source-lines",
          "lines": [
            "          180 Lungning ta Phaengc Howmei Ravguangc",
            "                            8.8.8.8.Ref. 8. 10.8.7",
            "",
            "          1. Lungning ta phaengc howmei Ravguangc,",
            "             Muangh kumcha zingc e alung khou;",
            "             Gaeklou o kaganv 'thuih ata,",
            "             Nang tuang ntwnmei builwang rui.",
            "",
            "                       Mik rui howgaymei na ta phu;",
            "                       Mpaeng khou gay, kalungc khou siimei nai.",
            "                       Hei rui Nang ta tikim ngammak;",
            "                       Lungning ta phaengc howmei Ravguangc.",
            "",
            "          2. Rup guay ata malaa sihnic,",
            "             Nang thu ata 'zianna gaeklou;",
            "             Ai ping lak khe Seitaan ric ta;",
            "             Nang khou guangna thuancku bam ni.",
            "",
            "          3. Kaipouc ata swthanlou o;",
            "             Apumtan guay Pou' Nang khang e.",
            "             Ngamv guay hei Nang zauzian paan e;",
            "             Nang na ta ai zaucna bam ni.",
            "",
            "          4. Swthanlou o Nang ta thuanh khang;",
            "             Siimei rui ding khamv pwsihnic,",
            "             Chu-zaenghmei lev kachangcmei kiu,",
            "             Ravguangc Chamv dinhmei hei na de."
          ]
        }
      }
