        "content": {
          "format": "source-lines",
          "lines": [
            "          172 Lauziu Gaenghmeipu khourui",
            "                             7.6.8.8.7. 6. Ref. 9.9",
            "          Doh hei G",
            "",
            "          1. Lauziu Gaenghmeipu khourui,",
            "             Ai ruan 'maan dat lak khe:",
            "             Katuang ringcbamv tei tilou the.",
            "             Cross khou theicloumeipu paanrui,",
            "             Theihmei khou rui ringhmei khou,",
            "             Ata thuakpatlou the.",
            "",
            "               Thuancku e, aPoubauhmei Nang ta;",
            "               Tingsaeng zaeng ringhmei tei tiilou the.",
            "",
            "          2. Ai tat bammei tingkauh chaeng,",
            "             Ai amaan dat lak khe.",
            "             Ai neihlaa e Karamzian khou;",
            "             Calvary tuang nzianmei tei;",
            "             Khoutei Jisu rui theiclou;",
            "             Ata thuakpatlou the.",
            "",
            "          3. Kandih sauh-raengh ding khourui,",
            "             Ata zaykaanlou the;",
            "             Nang hamhna ai guangtangc ngammak;",
            "             Nrianhloumei tingkauh ramc tei.",
            "             Nang akhang rui theiclouna,",
            "             Ata thuakpatlou the."
          ]
        }
      }
    },
