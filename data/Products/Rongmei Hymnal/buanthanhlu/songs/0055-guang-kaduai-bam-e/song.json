        "content": {
          "format": "source-lines",
          "lines": [
            "          55 Guang Kaduai Bam e",
            "                          11.11.12. 10",
            "",
            "          1. Guang kaduai bam e Nang pamv khou aniu guay (2)",
            "             Nang mei nunc swlou diu khang aniu guangbam e.",
            "             Guang kaduai bam e Nang pamv khou aniu.",
            "",
            "          2. Aniu ruak guay Nang khang suan kaduai bam e (2)",
            "             Nang khang suan bammei lu hei Nang mei nunc sw khang,",
            "             Aniu ruak guai Nang khang suan kaduai bam e.",
            "",
            "          3. Aniu guay hei Nang khang guang kariu bam e (2)",
            "             Guang kariu bammei hei Nang mei sw diu khang,",
            "             Aniu kariuna Nang khou huayney e.",
            "",
            "          4. Aniu guay kariuna Nang khou huayney e (2)",
            "             Aniu guay huayney bam e Nang mei sw diu khang,",
            "             Aniu kariuna Nang huayney e.",
            "",
            "          5. Aniu guay tingkauh kai ku nchamc pwni (2)",
            "             Aniu guay tingkauh kumei hei Nang mei sw diu khang,",
            "             Aniu guay kariuna Nang khou huayney e.",
            "",
            "          6. Aniu guay tingkauh khou lungc nchamc pwni (2)",
            "             Aniu lungc nchamcmei hei Nang mei sw diukhang,",
            "             Aniu guay tingkauh khou lungc nchamc pwni."
          ]
        }
      }
