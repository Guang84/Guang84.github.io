        "content": {
          "format": "source-lines",
          "lines": [
            "          168 Khrista rui Nzianmei Guay ta",
            "                        8.8.8.8.Ref.4.4.8.8.8",
            "          Doh hei E",
            "",
            "          1. Khrista rui nzianmei guay ta,",
            "             Hanguang dat tho twna kaw e;",
            "             Nzianmei Khristian chabwan guay;",
            "             Kawmei khwan tei nkinglou o.",
            "",
            "                  Charyn tuang e, (2)",
            "                  Baanh hiwna neihlaa nchamc kho.",
            "                  Nang pumtan lev nang ramneilaa,",
            "                  Pou' Khrista hu khou lungc lyan o.",
            "",
            "          2. Tingkauh kandic guangtangc pwkhou,",
            "             Saa ngammak ge karamgai tei;",
            "             Zingckeymei hei nai dat lak khe;",
            "             Mikdui luanghmei nai dat lak khe.",
            "",
            "          3. 'Maan kan nimei bumaengc guay ta,",
            "             Khrista rui 'zianna kaw bam e.",
            "             'Zianmei guay le, hanguang dat tho;",
            "             Mikdui key dat makpui ramc khou."
          ]
        }
      }
    },
