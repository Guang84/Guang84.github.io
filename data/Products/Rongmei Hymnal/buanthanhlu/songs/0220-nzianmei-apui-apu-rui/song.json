        "content": {
          "format": "source-lines",
          "lines": [
            "          220 Nzianmei Apui Apu rui",
            "                        8.8.8.8.Ref. 8. 8. 8.8",
            "",
            "          1. Nzianmei apui apu rui,",
            "             Dinclou mak ge lat gaymei guay,",
            "             Bumaengh Thanmei rui dinclou e,",
            "             Nchumhmei lev nzianmei lat.",
            "",
            "                  Kaganv thuih Pou ta ai thuanc ni,",
            "                  Ryanraa pwnic neihlaa pwnic,",
            "                  Syan-lanv maekna lungcsii sihnic,",
            "                  Bible heirui asyan-lanv e.",
            "",
            "          2. Apoubauhmei siamruai sw khang,",
            "             Kaamcthau ni the zingc nic gaanc nic,",
            "             Pou, ata zaythaulou na ro,",
            "             Israel nunc ta zayloumei kumc.",
            "",
            "          3. Heic kandic ramh kaguayna hei,",
            "             Lwm khang maek ge nang bangc ai mu,",
            "             Tingkauh lungning nthanmei tei,",
            "             Tithaylou o nang bangc akhou,",
            "",
            "          4. Poubauhmei le, nduanghlou o,",
            "             Ryanraa khou nic neihlaa khou nic,",
            "             Tingkauh Bumaengh Nthanmei rui,",
            "             Zaylou na ro nang bangc ata."
          ]
        }
      }
    },
