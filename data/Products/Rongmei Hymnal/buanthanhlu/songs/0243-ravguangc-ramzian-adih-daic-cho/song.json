          "lines": [
            "          243 Ravguangc Ramzian Adih Daic cho?",
            "                             8.8.8.8. Ref. 10.12. 12.12",
            "",
            "          1. Ravguangc ramzian adih daic cho!",
            "             Kata luicna damclou khwanmei",
            "             Kabaansyam guay khou 'thuk liange",
            "             Ravguangc rui nzianloumei hei",
            "",
            "                  Pou' ta thuanc o kasuaihiam tiilou the",
            "                  Panty gaymei tiiloumei hei kasuaihiam e",
            "                  Ravguangc ramzian kandih khouhei padik khwan e",
            "                  Ravguangc zauzian tiiloumei hei thuancku di kho.",
            "",
            "          2. Ravguangc latdanv piumei guay khang",
            "             Tingsaeng ringgmei tiikhang 'rianhlou",
            "             Nchummei gaimei tan mei guai",
            "             Tingsaeng guangcdic khou lungc pwni.",
            "",
            "          3. Kandih taanvdwan luaiguang pwkhou",
            "             Nkhamhpui ganv guang pwkhou kiu",
            "             Nchumhmei gaymei taanhmei guay",
            "             Ravguangc rui swan tii pwni the."
          ]
        }
      }
    },
