        "content": {
          "format": "source-lines",
          "lines": [
            "          75 He Ravguangc Zaylou o",
            "                      6.7.9.5. Ref. 9. 7.9.5",
            "          Doh hei E",
            "",
            "          1. He Ravguangc zaylou o;",
            "             Kandih panty luai mak saanv.",
            "             Muangh kumcna zinghmei kandih khouhei.",
            "             Ata zaylou o.",
            "",
            "                      Nang rui hamhna neihlaa khang maek ge.",
            "                      Lungh tineihlaalou nimei.",
            "                      Kandih panty hei luaiguang pwthe;",
            "                      'Niw ta 'khwan mak khe.",
            "",
            "          2. 'Zwan di kho gaanhmei thangc;",
            "             Gumeipu phaykaamv suicna.",
            "             'Thiammei rui dui kumc daicguang sihnic,",
            "             Ping makna tat ni.",
            "",
            "          3. Kandih apanty hei,",
            "             Lili mwn kumc tuai nuangc e.",
            "             Pingmei rui padikmei kandic khou,",
            "             Ata zaylou o.",
            "",
            "          4. Tat kanmei apanty,",
            "             Siimei paap taancloumei guay,",
            "             Ravguangc rui zianlouna sw 'thanlou:",
            "             Luihmakmei ata."
          ]
        }
      }
    },
