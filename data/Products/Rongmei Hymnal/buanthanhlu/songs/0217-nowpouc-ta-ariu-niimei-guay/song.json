        "content": {
          "format": "source-lines",
          "lines": [
            "          217 Nowpouc ta Ariu Niimei Guay",
            "                        8.9.8.8.8.8. Ref. 10. 10.6.6. 7.6",
            "          Doh hei E",
            "",
            "          1. Nowpouc ta ariu niimei guay,",
            "             Nang thaucmai khou tei thauh chamdaanv tho",
            "             Nowpoucpu tei guang pwni the.",
            "             Thauh naimei guay daanc thau 'chamc tho.",
            "             Thauh maekmei guay daanc nuh mak khe.",
            "             Thauh naimei guay daanc thau kan the.",
            "",
            "                  Thuanc o, Halleluijah! Halleluijah!",
            "                  Kauh liangmei khou kazanc hym daic kan diuc!",
            "                  Thauh dui maekmei guay mu,",
            "                  Liu khang tat dat kan the.",
            "                  Chamdaanv makmei guayna khang,",
            "                  Kaikhamv mbangh pwni.",
            "",
            "          2. Ravguangc tuang tingmik hei luai guang the,",
            "             Nang pumc lev nang kaikhunc kapwmna,",
            "             Lungh nchamcna neihlaa thau tho.",
            "             Ravguangc ta thuanckuna lungc o.",
            "             Khrista Kamei guang pwni the,",
            "             Kaikhunhmei guay ta laa pwni.",
            "",
            "          3. Gaychamv dinhmei ganv tei luai guang the;",
            "             Sina taanhmei guay taanc bam kan diuc,",
            "             Nthanmei nunc 'than bam kan diuc.",
            "             Ravguangc Lat ta piuna lungc o,",
            "             Rianhloupui Lat guang pwni the;",
            "             Ravguangc Lat tei suai zat mak ge."
          ]
        }
      }
    },
