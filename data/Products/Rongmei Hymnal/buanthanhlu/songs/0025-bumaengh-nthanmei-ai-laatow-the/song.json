          "lines": [
            "          25      Bumaengh Nthanmei Ai Laatow the",
            "                                 9.10.12.12.Ref.12.10.12.12",
            "          Doh hei E.",
            "              1. Bumaengh Nthanmei ai laatow the;",
            "                 Ravguangc paanrui lungh neihlaamei nai e.",
            "                 Kandih lungh ryanraa ramc khouhei bam saengc",
            "                 lak khe;",
            "                 Ravguangc 'khavlou na ro, kandih ryanraa",
            "                 ramc khou.",
            "",
            "                       He Ravguangc zaylou o,",
            "                                kandih ryanraa ramc khou,",
            "                       Nang hamhna apumtan baihmei maek ge,",
            "                       Lwmlouna guang la tho,",
            "                                     ntaw Khrista pamv khou,",
            "                       Ravguangc 'khavlou na ro,",
            "                                      kandih ryanraa ramc khou.",
            "",
            "              2. Lungning khou chuzaenghmei ariu the.",
            "                 Alung ryanraamei nai lak khe Ravguangc.",
            "                 Nang zauzian paanrui ai ntaw ringhmei laa the;",
            "                 Ravguangc laalou na ro, kandih ryanraa ramc khou.",
            "",
            "              3. Alung khou chuzaenghmei laatow the;",
            "                 Ravguangc paanrui neihlaamei ariu the.",
            "                 Ntaw thu zinghmei bamv khourui ai duakpat the.",
            "                 Ravguangc 'khavlou na ro, kandih ryanraa ramc",
            "                 khou."
          ]
        }
      }
