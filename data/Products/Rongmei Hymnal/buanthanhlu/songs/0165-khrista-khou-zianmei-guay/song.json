          "lines": [
            "          165 Khrista khou 'Zianmei guay",
            "                             10.6. 6. 10. 6.4",
            "",
            "          1. Khrista khou 'zianmei guay daicthau 'chamc kho,",
            "             Zauzian khou daicthau kho:",
            "             Siimei chwn ganc ngamna,",
            "             Khat rui khat ta 'zianna pumh khat swna,",
            "             Khrista khou meic guayna,",
            "             Daicthau 'chamc kho.",
            "",
            "          2 'Zianmei nunc le, lwmmei khou daicthau kho,",
            "            Tingmik thuih Khrista lev",
            "            Pumh khat chwn khat swna,",
            "            Nang rui thayloumei guay ngampat pwkhou,",
            "            Lwmloumei ramgai kiu,",
            "            Meic nunc how diu.",
            "",
            "          3. Assam, Manipur, Nagaland 'dic hei,",
            "             Nzaengcdic lev luangh guay,",
            "             Khrista khou khatna de,",
            "             Kathumh akhat swmei RNBA",
            "             Khrista hym lungc ndauh diu,",
            "             RNBA."
          ]
        }
      }
