            "          19       Ata Gupatlou the",
            "                           12.6.6.12.6. Ref. 9.7.8.8",
            "          Doh hei G",
            "",
            "",
            "          1 Ata gupatlou the, ata gupatlou the,",
            "            Paapc khou 'maan bam khourui. (2)",
            "            Ata gupatlou the, ata gupatlou the,",
            "            Paapc khou 'maan bam khourui.",
            "",
            "",
            "                 He Ravguangc Nang ramzian hei ch'ryn e;",
            "                 Saa ngammakmei ramzian e.",
            "                 Kandihmei paap zaeng khangruina",
            "                 Theiclouna paapc sw 'thanlou the.",
            "",
            "",
            "          2 Sauh pyrun runlouna akhang kazei keylou,",
            "            Kalvari chyng ruc khou. (2)",
            "            Sauh pyrun runlouna akhang kazei keylou,",
            "            Kalvari chyng ruc khou.",
            "",
            "",
            "          3 Zinghmei bamv khouruina ata thuakpatlou the,",
            "            Kanac tiswlou the. (2)",
            "            Zinghmei bamv khouruina ata thuakpatlou the,",
            "            Kanac tiswlou the."
          ]
        }
      }
    },
