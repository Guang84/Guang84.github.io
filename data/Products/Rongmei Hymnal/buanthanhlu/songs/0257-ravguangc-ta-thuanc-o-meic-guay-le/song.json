        "content": {
          "format": "source-lines",
          "lines": [
            "          257 Ravguangc ta Thuanc o Meic Guayle!",
            "                                   8.8.8.8",
            "          Doh hei F",
            "",
            "          1. Ravguangc ta thuanc o meic guayle !",
            "             Zauc nzianloumei zaeng khangrui,",
            "             Kazauzian sing tei chaklou kho,",
            "             'Thyammei daihmei kaguayna rui.",
            "",
            "          2. Tingkauh kaidai guang tanghpui nungc,",
            "             Neihlaamei kanganv nai lak khe;",
            "             Ryanraa kapmei mikdui keymei,",
            "             Thut phuilou khang nkhwan bam the.",
            "",
            "          3. Mik rui how makmei tingkauh thangc,",
            "             Thuanhmei lu suan taek dat lak khe.",
            "             Suan ngimhngim bame heic khoutei;",
            "             Aniw nic lay suan tat di kho.",
            "",
            "          4. Tingkauh ramc thangc lwmmei guay rui,",
            "             Lungh khang tat ngam kanpui tangv kiu,",
            "             Kandih hei 'chwng rimhrim pwni,",
            "             Kandih hei zingc gunhgun pwni.",
            "",
            "          5. Ntavw kin khou lungc bammei nunc.",
            "             Aniw ta nzian diangclou the.",
            "             Nkhuaimei lev mphuammei guay,",
            "             Khiu 'thanna guang khang kawlou the."
          ]
        }
      }
