        "content": {
          "format": "source-lines",
          "lines": [
            "          177 Lungh Ryanraamei Kandic Khouhei",
            "                               8.8.8. 8.Ref. 8. 8. 8. 8",
            "          Doh hei.B",
            "",
            "          1. Lungh ryanraamei kandic khouhei,",
            "             Zinghmei 'dic khou ai lungc nii mak:",
            "             Ringhmei thing lim khou zaengsw khang,",
            "             Zaylou o, Khrista Nang baanc rui.",
            "",
            "                  'Patlou duc the heic kandih hei:",
            "                  Ai kaamcthau the tingkauh chaeng khou;",
            "                  Zaylou o Khrista Nang baanc rui;",
            "                  Tingkauh ramc khou zaeng 'thaekc ni the.",
            "",
            "          2. Ringhmei duithuak luangcna bam e;",
            "             Panty luai mak khou zangv la tho;",
            "             Chwnsi mikdui luanghmei 'dic khou,",
            "             Khrista ruina zaylou bamn e.",
            "",
            "          3. Heic kandic hei 'maan pwni the;",
            "             Khrista zanc khou puancthanh makmei,",
            "             Tingsaeng maikwam khou bam pwni;",
            "             Panty nai khou ringhmei laa tho.",
            "",
            "          4. Kandih hei 'maan kan pwni the;",
            "             Khrista key ni lwmmei guay khang,",
            "             Tingsaeng ringhmei namvdai khoutei,",
            "             Ringhmei swan tei chamdaanvlou e."
          ]
        }
      }
