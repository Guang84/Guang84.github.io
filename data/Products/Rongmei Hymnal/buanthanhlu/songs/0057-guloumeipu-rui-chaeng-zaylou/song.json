        "content": {
          "format": "source-lines",
          "lines": [
            "          57 Guloumeipu rui Chaeng Zaylou",
            "                          13.8.8 R Pef.7.7. 8.8",
            "",
            "          1. Guloumeipu rui chaeng zaylou",
            "             Kalvari chyng khou;",
            "             Ryanraa ryanriumei guay khangtei;",
            "             Neihlaana bam kan diuc khangrui,",
            "             Kasiamhlou the Poubauhmei rui.",
            "",
            "                  Ai guang the he Poubauhmei,",
            "                  Nang rui chamdaanvloumei bamv;",
            "                  Paapc ric rui tanc-bauc khwan sihnic,",
            "                  Nang rui ata nduanghlou o.",
            "",
            "          2. Ata Guloumeipu theiclou",
            "             Kalvari chyng khou;",
            "             Kalaan zingbangc maekpui ramc khou,",
            "             Neihlaana bam kan diuc khang rui;",
            "             Kasiamhlou the Poubauhmei rui.",
            "",
            "          3. Karaan guay nic 'maan ngam kan the,",
            "             Kathanc ngam kan the.",
            "             He tabui nungc tangc nina cho ?",
            "             Ai rui ning e tingsaeng kai tei,",
            "             Lwmmei guay guang kariupui bamv."
          ]
        }
      }
    },
