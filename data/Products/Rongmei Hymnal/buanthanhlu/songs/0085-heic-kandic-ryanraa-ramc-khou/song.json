        "content": {
          "format": "source-lines",
          "lines": [
            "          85      Heic Kandic Ryanraa Ramc khou",
            "                                  7.7.8.7",
            "          Doh hei D",
            "",
            "          1. Heic kandic ryanraa ramc khou,",
            "             Ryanraa kalanghmei khwan rui,",
            "             Kandih kwn guay kagaengv lik ge;",
            "             Paapc lev zinghmei kandic khou.",
            "",
            "          2. Alung ryanraa bammei hei,",
            "             Kandihmei rui thay tangh mak.",
            "             Alung khou ryanraamei duidai;",
            "             Tabui nungc rui 'maan ni cho?",
            "",
            "          3. Baanphiu puancna kalum e;",
            "             Laathaulou o Poubauhmei.",
            "             Nang tuang nchu nzaenghmei tei,",
            "             Tii keylou o alung khou.",
            "",
            "          4. Kakwm kaganv guay samctat;",
            "             Duipui guay nic luangctat bam;",
            "             \"Ki aryanraa kaguay hei mu",
            "             Kimkey mak ge, he Ravguangc!"
          ]
        }
      }
    },
