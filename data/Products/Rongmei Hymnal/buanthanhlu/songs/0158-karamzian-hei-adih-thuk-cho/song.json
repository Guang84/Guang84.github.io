        "content": {
          "format": "source-lines",
          "lines": [
            "          158 Karamzian hei Adih 'thuk cho?",
            "                           8.8.9.10.Ref. 7. 8. 9.10",
            "",
            "          1. Karam zian hei adih 'thuk cho?",
            "             Haengcmumhmei paap swthanloumei",
            "             Siangloumei cross paan 'niw khang suaihiam,",
            "             Guang tho theicloumei cross khou ringhmei nai.",
            "",
            "                  Dih lev kauh tuang latzanpouc,",
            "                  Cross ruc khou t'rina kauc bam e.",
            "                  'Kauh Guangc Nac kiruaikuak khou zipmei,",
            "                  Heic guay hei nang aniw zaeng khangrui e.",
            "",
            "          2. Karam zian hei adih daic cho?",
            "             Saa ngammakmei ramzian tiilou.",
            "             Ruak naipui kamv nang zanc ta thuanc ni;",
            "             Zianloumeipu nang ta tingsaeng thuanc ni.",
            "",
            "          3. Karamzian hei adih daic cho?",
            "             Guanghbamv daihmei ganclouducna,",
            "             Dih ryanraamei bamv khou keylouna,",
            "             Adih zianlou tu cho saa ngammak ge.",
            "",
            "          4. Karamzian hei adih ch'ryn cho?",
            "             Rac tangc thuy lak karamzian tei:",
            "             Ramhrik kumhmei guay ta kapahlou,",
            "             Gancpatloumei nunc ta laalou kanmei."
          ]
        }
      }
