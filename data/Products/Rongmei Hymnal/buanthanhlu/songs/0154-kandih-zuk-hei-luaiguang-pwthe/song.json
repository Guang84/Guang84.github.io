        "content": {
          "format": "source-lines",
          "lines": [
            "          154 Kandih Zuk Hei Luaiguang Pwthe",
            "                                8.8.8.8.Ref. 8. 8.8.8",
            "          Doh hei E",
            "",
            "          1. Kandih zuk hei luaiguang pwthe;",
            "             Khat rui khat ta 'zianna lungc o.",
            "             Zauczihmei rui padik pwni;",
            "             Akhaengv thaymei guay ringc pwni.",
            "",
            "                      Gaymei tingmik how niimei guay,",
            "                      Simei taanv guay mpat la tho.",
            "                      Poubauhmei kazaw paanv tei mu,",
            "                      Ntwnmei guay ruc khou nai e.",
            "",
            "          2. Simei taanv taanhpui zaeng khourui,",
            "             Ryanraa akhaengvmei khangsuangc mu,",
            "             Gaymei taanv taanhpui zaeng khourui,",
            "             Ryanraa akhaengvmei rui gay e.",
            "",
            "          3. Kandih puat ta nzianmei guay,",
            "             Kandih chwn guay mpat la tho.",
            "             Simei ruina ngammei sw rio,",
            "             Gaymei taanv rui ngammei sw o.",
            "",
            "          4. Kandih khou aniw lungc 'chamcmei,",
            "             Khat rui khat ta nzian makna,",
            "             Mik rui how makmei Ravguangc ta",
            "             'Zian e twmei nthuih mak ge."
          ]
        }
      }
    },
