        "content": {
          "format": "source-lines",
          "lines": [
            "          289 Tingkauh Thangc Khang Kataanv",
            "                          8.7.7.7. Ref. 7. 8. 7.7",
            "",
            "          1. Tingkauh thangc khang Kataanv Luanc",
            "             Tingsaeng zaengna dwan gay ni.",
            "             Ntaw taanhmei dwan gay e;",
            "             'Maan dat lak khe nang taanvphy.",
            "",
            "                  Tiipat ro Jehovah khang,",
            "                  Nang panty guay, nang syan lanv guay.",
            "                  Tiipat ro Jehovah khang,",
            "                  Twna Jisu rui saa e.",
            "",
            "          2. Gay liangmei puat kaguay ruina,",
            "             Nang Poubauhmei ta thuanc o;",
            "             Nang tuang phwnling guay rui nic,",
            "             Nang nzianmei ndauh o.",
            "",
            "          3. Aniw khou naimei kapwmna,",
            "             Damcloumeipu Katuang e;",
            "             Kamei akhang ai Kakhang;",
            "             Zaenggaymei akhang di the.",
            "",
            "          4. Tingkauh ramc khou 'niw zaenggay ni;",
            "             Taanc chuyloumei guay thiu mu,",
            "             Kaipouc rui ndauh dat 'ni,",
            "             Adihkamv neihlaa ni cho!"
          ]
        }
      }
