        "content": {
          "format": "source-lines",
          "lines": [
            "          137 Kandih Khouhei Ai Lungc Nii mak",
            "                             8.6.8.7.Ref. 10.9. 10.6",
            "",
            "          1. Kandih khouhei ai lungc niimak,",
            "             He Ravguangc Nang hamhna,",
            "             Tingmik thuih ata duanghlou o,",
            "             Ata 'patlou rio Ravguangc.",
            "",
            "                        Jisu na de ata 'zianlou nimei,",
            "                        'Thiammei khourui ata gulou o.",
            "                        Jisu na de ata 'zianlou nimei,",
            "                        Ch'ryn e nang ramzian hei.",
            "",
            "          2. Kandih khou ai lungc niimak ge,",
            "             Ai neihlaa khang maek ge;",
            "             Jisu na de lungh neihlaa khang,",
            "             Akhang sw ni the Ravguangc hei.",
            "",
            "          3. Alung rui Nang ta thuanc bam ni,",
            "             Abumaengc hei nang khang,",
            "             He Ravguangc ai Nang khang sw ni;",
            "             Apanty hei Nang khang dithe."
          ]
        }
      }
    },
