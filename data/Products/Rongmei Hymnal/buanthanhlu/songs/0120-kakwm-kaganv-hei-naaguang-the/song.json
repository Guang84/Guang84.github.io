        "content": {
          "format": "source-lines",
          "lines": [
            "          120 Kakwm Kaganv Hei 'Naa Guang the",
            "                                8.7.8.7.Ref.9.9.9.9",
            "",
            "          1. Kakwm kaganv hei 'naa guang the;",
            "             Ning zauc lo, 'zianmei guay le.",
            "             'Tamv suang khang kaganv rui guang the,",
            "             Guang dat lak khe panty hei.",
            "",
            "                     Heic kandic ntamvpui kandic hei,",
            "                     Neih khat ganclou ducna tat pwni.",
            "                     'Zianmei guay tat rey kanmei guay ta,",
            "                     Lili puanghpui ramc khou khwan bam e.",
            "",
            "          2. Ning zauc lo, tuai nimei mwnpwang,",
            "             Nang rup-ryan zianmei guay ta,",
            "             \"Tamv suang khang kaganv rui guang the;",
            "             Ning zauc lo, 'zianmei guay le.",
            "",
            "          3. 'Tamv khang kaganv rui guang pwni;",
            "             Rup-ryan guay 'tamv kan di kho;",
            "             Pui pu rup-ryan 'tamvpui ganv guang.",
            "             Neihlaana 'tamv kan di kho."
          ]
        }
      }
    },
