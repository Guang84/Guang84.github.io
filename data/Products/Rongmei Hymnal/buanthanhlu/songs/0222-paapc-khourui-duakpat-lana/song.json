          "lines": [
            "          222 Paapc Khourui Duakpat lana",
            "                          7.7.7.7.Ref. 6. 7. 8. 7",
            "",
            "          1. Paapc khourui duakpat lana,",
            "             Aseic ringhmei laa la tho.",
            "             Nthuanh ning ngammak pwni,",
            "             Kaganv dui luangh kumcna tat.",
            "",
            "                     Tingkauhramc gaymei tei,",
            "                     Alungning rui thaymei tei,",
            "                     Lat rui nic saatangc ngammak ge.",
            "                     Kaganv dui luangh kumcna tat.",
            "",
            "          2. Poubauhmei guangpui nungc kiu,",
            "             Paapcmei t'ui thangc tatlou ni?",
            "             Lwmmei guay tingkauh tat ni.",
            "             Kaganv dui luangh kumcna tat.",
            "",
            "          3. Heic kandic aman pwni.",
            "             Lwmmei lev lwmmakmei guay,",
            "             Neihkhat thu ntamv pwni.",
            "             Kaganv dui luangh kumcna tat."
          ]
        }
      }
