            "          159 Kauh Kanaan Ramc ta Ningna",
            "                            7.7.9.7.Ref. 5. 12. 12",
            "          Doh hei F",
            "",
            "          1. Kauh Kanaan ramc ta ningna,",
            "             Neih key dat makpui ramc tei;",
            "             Bumaengh guay guang lungc nipui ramc e;",
            "             Guang tangc pwni neih khat ai.",
            "",
            "                   He kauh ramc gaymei,",
            "                   Zaion ramgai ta machunh e aPoubauhmei;",
            "                   He Poubauhmei Jisu ata zay thaulou o.",
            "",
            "          2. Lwmloumei guay 'baanvthay ni,",
            "             Baanch'raa guay bampui ramc khou.",
            "             Kachaekc kaidai gaymei ramc khou tei,",
            "             Samc tat pwni neih khat ai.",
            "",
            "          3. Guangh ramc gaymei tangc pwkhou,",
            "             Ryanraamei nai dat lak khe.",
            "             Zaeng 'thaekcmei kaidai tangc zaic 'ni the;",
            "             Panty duidai paengc thangc tei."
          ]
        }
      }
