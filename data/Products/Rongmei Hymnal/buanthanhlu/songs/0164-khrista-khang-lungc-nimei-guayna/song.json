        "content": {
          "format": "source-lines",
          "lines": [
            "          164 Khrista khang Lungc Nimei guayna",
            "                               8.8.10.8. Ref. 7. 6. 8",
            "",
            "          1. Khrista khang lungc nimei guayna",
            "             Kapanty hei tiipat la tho;",
            "             Zipri bammei bumaengc ta 'chyangthao khang,",
            "             Bumaengh pumtan tiikeylou o.",
            "",
            "                  Zipna bammei bumaengc guay,",
            "                  Ryanraa khaengv bam ni cho?",
            "                  He Kaipouc, pumtan tilou o.",
            "",
            "          2. Khrista khang meic khatsihnic maek,",
            "             Kakhourui tat duc haihhai tat the.",
            "             Zingh khou bammei bumaengc guay ta zauc lo,",
            "             Bumaengh pumtan rau khithkhit the.",
            "",
            "          3. Theicna bammei bumaengc guay ta,",
            "             'Ai phungcguang ngammak gethei mu,",
            "             Ai neihlaa ngam lak ge, he Poubauhmei,",
            "             Nang guangcdic khou guangpui nungc kiu."
          ]
        }
      }
    },
