        "content": {
          "format": "source-lines",
          "lines": [
            "          94      Jisu Hei Akaipouc e",
            "                        7.7.7.7.Ref. 7. 7. 7.7",
            "          Doh hei E",
            "",
            "          1 Jisu hei akaipouc e,",
            "            Kakhou ai lwmpui paan rui.",
            "            Alu guay Kakhang suan ni",
            "            Thuanckuna ai lungc bam ni.",
            "",
            "                  Kuak kan the apaap guay tei,",
            "                  Kazei rui khiu thanlou the,",
            "                  Apanty Kakhang di the,",
            "                  Akaipouc Jisu, Amen!",
            "",
            "          2. Kandih khou ai lungc bam saanv,",
            "             Paapc khourui pak duc tat ni;",
            "             Apumc guay Kakhang sw ni;",
            "             Kalatryan rihpwan sw ni.",
            "",
            "          3. Tiilou o Nang zauzian hei,",
            "             Meic guay khou dinc lik tat khang.",
            "             Ringc kan diu arup guay nic,",
            "             Ringhmei Latkaeng paan khourui.",
            "",
            "          4. Ding tip ni Daniel kumcna;",
            "             Joshua kumc rihpwan piu ni;",
            "             Lwm tip ni Abraham kumc;",
            "             Tiipat ni Abel kumcna."
          ]
        }
      }
    },
