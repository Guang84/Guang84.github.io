          "lines": [
            "          152 Kandihramc khou Ryanraana",
            "                       12.5.8.8.Ref. 8.9. 11",
            "",
            "          1. Kandihramc khou ryanraana bumaengh khuammei thiu !",
            "             Tingkauh ramc khou dwan-gay pwni.",
            "             Kapyrun neihmik suangc gaanc ni;",
            "             Zingh makpui ramc khou tei lungc ni.",
            "",
            "                  Kachaekc namvdai tangh khang 'naa the.",
            "                  Nzianmei nunc heic ramc khoutei",
            "                                             guangtangc pwkhou",
            "                  Paapc kaguayna nai dat lak khe.",
            "",
            "          2. Tingkauhramc khou ch'rynmei ramgai kaguayna tei,",
            "             Heicram 'gai tei saa ngammak ge.",
            "             Paapc guayna ta ngamlou lana,",
            "             'Niw nic mi ramc khoutei lungc ni.",
            "",
            "          3. Tingkauh ramgai khou lwmloumei kaguayna tei,",
            "             Aniw ariu ni neihkhat mu.",
            "             Salaam swna 'tamv dat lak khe;",
            "             Ringhmei thingbang lim gay khoutei."
          ]
        }
      }
