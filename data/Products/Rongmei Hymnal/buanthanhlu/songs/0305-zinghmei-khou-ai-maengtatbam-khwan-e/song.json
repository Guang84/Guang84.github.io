        "content": {
          "format": "source-lines",
          "lines": [
            "          305 Zinghmei khou Ai Maengtat Bam Khawne",
            "                              9.10.9.9. Ref. 6. 7. 10.6.7.9",
            "",
            "          1. Zinghmei khou ai maengtat bam khawn e,",
            "             Gu'meipu alung kaikhamv 'chow mak saanv.",
            "             Alung khou Kata laalou nungcrui,",
            "             Katuang suaihiam akhou tiilou the.",
            "",
            "                        Ai 'thei han dat lak khe !",
            "                        Khatsihnic han dat lak khe,",
            "                        Kamei akhang zayloumei neicriw e,",
            "                        Ai 'thei han dat lak khe !",
            "                        Khatsihnic han dat lak khe,",
            "                        Chaenglwan 'thuih Kamei zaylou' zaengrui.",
            "",
            "          2. Tingmik 'thuih Kahu khou ai lungc ni,",
            "             Paapcmei nunc ta Jisu khou 'duangh guang ni,",
            "             Kalvari khou luangckeymei zei rui,",
            "             Ai kumc' paapc phunghmei ta gulou khang.",
            "",
            "          3. Poubauhmei khou taekmakna bam ni,",
            "             Tingkauh thu tingsaeng zaengna neihlaa ni.",
            "             Lwmloumei guay mu 'maan dat lak khe.",
            "             Guang tho Poubauhmei rui kaw bam khou."
          ]
        }
      }
    },
