        "content": {
          "format": "source-lines",
          "lines": [
            "              22    Bethlehem Thangc Nzwan Di Kho",
            "                                8.8.8.8.Ref.8.8.8.8",
            "",
            "          Doh hei Ab",
            "",
            "              1. Bethlehem thangc nzwan di kho;",
            "                 'Rianhloumei Guangc puanhpui ramc thangc.",
            "                 Aniw syan-lanv kaguay phungcna,",
            "                 Guangh Thanh puanhmei ta kalum khang.",
            "",
            "                       Neihlaana thuancna lu suan kho,",
            "                       Guloumeipu ta thuanc di kho:",
            "                       \"Hosanna\" twna kauc lana;",
            "                       Kauh liangmei khou hymdaic kan diu.",
            "",
            "              2. 'Takmei nunc lev lauziu gaenghmei,",
            "                 Gaanphiu tei rui chaeng zaylouna,",
            "                 Bethlehem thangc nzwanguang the.",
            "                 Kaniw kunghmei syan-lanv phungcna.",
            "",
            "              3. 'Zianmei pu-chaih akainac thiu,",
            "                 Aniw lunghlaicna thau di kho,",
            "                 Guangh Thanh puanhmei ta kalum khang.",
            "                 Thau tho, aniw kunghmei lanv lev.",
            "",
            "              4. Lwmloumei guay dwan gay pwni,",
            "                 Guangh Thanh puanhmei Khrista khou kiu.",
            "                 'Maan dat lakmei namvdai gaymei,",
            "                 Jirusalem Thanh khou lungc ni."
          ]
        }
      }
    },
