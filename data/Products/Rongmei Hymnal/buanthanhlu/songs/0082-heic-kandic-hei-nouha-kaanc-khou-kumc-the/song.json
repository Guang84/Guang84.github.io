          "lines": [
            "          82 Heic Kandic hei Nouha Kaanc khou Kumc the",
            "                                9.8.11.8. Ref. 8. 8.10.11",
            "          Doh hei E",
            "",
            "          1. Heic kandic hei Nouha kaanc khou kumc the:",
            "             Ravguangc ta mpatlou ngam the;",
            "             Kandih ramgai mbaanv rui kahawmei tei",
            "             Phu khourui theic 'maan ngam kan the.",
            "",
            "               Charyn tuang e heic kandic hei!",
            "               Poubauhmei lungpuam guang pwni.",
            "               Luangh lev duipui kabamv kalaic pwni;",
            "               'Ki lwmmei guay khang tingkauhramc chamdaanvlou.",
            "",
            "          2. Heic kandic hei nkhamhpui ganv guang the.",
            "             Ravguangc ta nzianmei khangsuangc,",
            "             Mbaanv rui kahawmei ta nzian khourui,",
            "             Ravguangc ta mpatlou ngam the.",
            "",
            "          3. Heic kandic hei kadunhna lungc pwni,",
            "             Ryanraamei lev pingmei khwan rui,",
            "             Akumh ni cho kandih khou lunghmei guay hei;",
            "             Kapna huayna lungc bam pwni.",
            "",
            "          4. Kaanpatmei laatowmei bumaengc guay mu,",
            "             Tingkauh tingthan patpui nungc kiu,",
            "             Neihpat neihkey kabangc karucmei guangna,",
            "             Ravguangc ta thuancna bam pwni."
          ]
        }
      }
    },
