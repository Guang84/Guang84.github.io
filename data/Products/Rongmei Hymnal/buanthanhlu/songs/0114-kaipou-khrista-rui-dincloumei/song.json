        "content": {
          "format": "source-lines",
          "lines": [
            "          114     Kaipouc Khrista rui Dincloumei",
            "                             8.6.8.8.Ref. 9.5.9.8.9",
            "",
            "          1. Kaipouc Khrista rui dincloumei,",
            "             Bumaengh khuanguangmei khang,",
            "             Katuang swan gaymei phungc lana,",
            "             Nzanhlou khang guang pwni the.",
            "",
            "                  O, maan ngam ni the bumaengh guay hei,",
            "                  Tat lana zauc lo,",
            "                  Chaeng maanvna bammei ta gulou o,",
            "                  Kaipouc ruina kadylou e,",
            "                  Tingsaeng ringhmei cham tei dincruanlou o.",
            "",
            "          2. Tingsaeng ringc nimei latchamv tei,",
            "             Chu makmei nic nai e;",
            "             Nwmding zinghpui bamv khou tatna",
            "             Pingna bammei ta gulou o.",
            "",
            "          3. Thei han lana nkamh bammei,",
            "             Nang bumaengc kap bam e,",
            "             Bumaengh khuammei swna lungh khang,",
            "             Kawna bam the ngalancguang o."
          ]
        }
      }
