        "content": {
          "format": "source-lines",
          "lines": [
            "          123 Kandih Apanty Luai guang the.",
            "                             8.6.10.5. ref.7. 8. 10. 6.",
            "          Doh hei Ab",
            "",
            "          1. Kandih apanty luaiguang the,",
            "             Kalaan ramc naaguang the;",
            "             Pou' Jisu rui chamdaanvloupui ramc khou.",
            "             Lungh khang naaguang the.",
            "",
            "                  He tabui nungc guang ni cho?",
            "                  Kalaan ramc gay khou guang lungh khang:",
            "                  Kalaan ny, zingbangc ny, laukhwan ni cho?",
            "                  Ai rui nkhwan bam e.",
            "",
            "          2. Aniw lungning hei taanh rikho,",
            "             Kanaanramc naa guang the.",
            "             Kandih apanty neicmik key pwkhou",
            "             Taanv sw nuhmak pwni.",
            "",
            "          3. Panty duidai riang kaan pwkhou,",
            "             Kalaan ramc gut pwni,",
            "             Tingkauh nthanmei nunc lev ariuna,",
            "             Tingsaeng neihlaa bam ni.",
            "",
            "          4. Paapc rui muangh kumcna zinghmei dic -",
            "             khourui twanpat lana,",
            "             Ringhmei thingbang lim khou ai zaengswna,",
            "             Tingsaeng mbaanvthay ni."
          ]
        }
      }
    },
