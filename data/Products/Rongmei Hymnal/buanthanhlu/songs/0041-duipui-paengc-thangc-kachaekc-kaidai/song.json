        "content": {
          "format": "source-lines",
          "lines": [
            "          41 Duipui Paengc Thangc Kachaekc Kaidai",
            "                                 11.8.12.7.Ref.7.7.12.12",
            "          Doh hei A",
            "",
            "          1. Duipui paengc thangc kachaekc kaidai",
            "                                                  gaymei khou,",
            "             Thanmei nunc khoutei lungc bam e.",
            "             Thuanhpui lu rui kachaekc kaidai khoutei",
            "                                                  suan bam.",
            "             Kaipouc Ravguangc daeng khoutei.",
            "",
            "                  O, adihkamv gay tu cho (Heic khoutei).",
            "                  Heic khoutei ryanraamei maek (Heic khoutei).",
            "                  Thuanhpui lu rui kachaekc kaidai khoutei",
            "                                                     suan bam.",
            "                  He Poubauhmei chaeng tei laanclou o,",
            "                                                 ai tat khang.",
            "",
            "          2. Heicpui kandic khou ai n-gin tat bam e:",
            "             Kum sihnic neihlaana lungc ni.",
            "             Paapc ric ta ngamlouna Jisu lev tat 'chamc ni.",
            "             Heic khoutei ai zaeng 'thaekc ni.",
            "",
            "          3. Nthiammei rui ata bam haengv pwsihnic,",
            "             Jisu rui akhou lungclouna,",
            "             Paapc ric ta ngamlouna Jisu ley tat chamc ni,",
            "             Rih ngammei pyrun laa khang."
          ]
        }
      }
