        "content": {
          "format": "source-lines",
          "lines": [
            "          39      'Dih Neihlaamei 'Maan Pwni",
            "                             7.10.8.9. Ref. 7. 5.9.8",
            "          Doh hei D",
            "",
            "          1. 'Dih neihlaamei 'maan pwni.",
            "             Alung kwnmei Nang na de Poubauhmei.",
            "             Ai duploupui bamv Nang na de;",
            "             Nang Bumaengc rui atan nduanghlou o.",
            "",
            "               He ata mpatlou rio,",
            "               Ai neihlaa bam ni.",
            "               He Poubauhmei, heic kandic khouhei,",
            "               Nang hamhna ai neihlaa khang maek.",
            "",
            "          2. Maan pwni apanty hei;",
            "             Mang kumhmei apanty hei maan pwni;",
            "             Neih key kumcna key kan pwni.",
            "             Thau kan the apanty dui luangh kumcna.",
            "",
            "          3. Apanty dui luangh kumc e.",
            "             Araana ta 'patlou rio, Poubauhmei.",
            "             Ai hei ryanraa sansimei e:",
            "             Nkhavlouna zaylou o, Poubauhmei."
          ]
        }
      }
    },
