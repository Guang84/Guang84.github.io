        "content": {
          "format": "source-lines",
          "lines": [
            "          64      He Khristian Ricmei",
            "                      10.8. 10.10.Ref. 10. 6.9.6",
            "          Doh hei G",
            "",
            "          1. He Khristian ricmei swmei guayna rui,",
            "             Hubiak thangc Khrista ta zauc o.",
            "             Tingsaeng zaeng ringc nimei Khrista na de.",
            "             Kataanv taancna Kasiamruai sw khang nai.",
            "",
            "                      Zanh pumc khou bumaengh kazauh mak gethei,",
            "                      Zanh pumc thu theihmei de.",
            "                      Heictei kumc kataanv kazauh makmei",
            "                      Lwmmei tei theihmei de.",
            "",
            "          2. He Khristian ricmei swmei guayna rui,",
            "             Nang pumtan hei naipui saanv khou,",
            "             Khrista khang nang pumc guay tipatlou o.",
            "             Mi hei nang rui taanc nimei taanv kiu e.",
            "",
            "          3. Neihlaamei panty khou lungh khang ruina.",
            "             Kataanv hei nang taanc nina de.",
            "             Nzianthaymei lungning tei phungc lana.",
            "             Khrista zanc khourui nang tatpatlou o."
          ]
        }
      }
    },
