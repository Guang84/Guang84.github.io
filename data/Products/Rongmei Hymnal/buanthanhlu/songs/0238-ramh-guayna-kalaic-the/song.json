          "lines": [
            "          238 Ramh Guayna Kalaic the",
            "                      6.6.7.6.6.10.Ref.7. 6. 8. 7.4.6",
            "          Doh hei F",
            "",
            "          1. Ramh guayna kalaic the, (2)",
            "             Apanty hei kathanc di the.",
            "             Apanty thanh di the, (2)",
            "             Kakhou tiilouna lwmlou nungc tei rui.",
            "",
            "                  Tingpuk paengc thangc kai khoutei,",
            "                  Ai guangtangc pwni the;",
            "                  Abumaengc neihlaana bam ni.",
            "                  Ai suan ni thuanhpui lu tei,",
            "                  Kamei nzianloumei,",
            "                  Tingsaeng,",
            "                  Kata thuancna bam ni.",
            "",
            "          2. Ata nzianloumei, (2)",
            "             Ai thay tangc ngam mak ge Ravguangc.",
            "             Ai thay tangc ngam mak ge, (2)",
            "             Ch'rynmei Kazauzian hej saa ngam mak ge.",
            "",
            "          3. 'Zianmei khwan rui kaw e, (2)",
            "             Kaganv nai bam khou lwm laa tho.",
            "             Kaganv hei nai bam khou, (2)",
            "             Kakhou lwmloumei panty sw la tho."
          ]
        }
      }
    },
