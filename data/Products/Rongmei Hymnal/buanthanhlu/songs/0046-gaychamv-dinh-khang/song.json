        "content": {
          "format": "source-lines",
          "lines": [
            "          46      Gaychamv Dinh Khang",
            "                        8.12.8.9.9 Ref.6. 8.8. 8.",
            "          Doh hei Db",
            "",
            "          1. Gaychamv dinh khang nang ta kaw e,",
            "             Tingkauh Guangcdic naa the twna dincruan tat ro;",
            "             Naumei guay ta tigay tat ro,",
            "             Ravsic guay ta alayganc o,",
            "             Nangniw khou ngamv tei tilou kan the.",
            "",
            "                  Kaipouc laupuk khoutei,",
            "                  Taanv taanc nimei thow nai tu cho?",
            "                  Isaiah kumcna tatpat tho,",
            "                  Poubauhmei guang zaic pwni the.",
            "",
            "          2. 'Zianmei guay le, lunghlaic la tho.",
            "             Nang khou tiloumei kaipat tei taancthau dat tho.",
            "             Nang rui taanh makna bam ethei,",
            "             Ryanraamei tiguang pwni the,",
            "             Kaipouc Khrista rui kumna saa e.",
            "",
            "          3. Tingkauh Jerusalem thanh khou,",
            "             Lwmmei lev taanh kazauhmei guay guang lungc pwni.",
            "             Khoutei kapmei, theihmei maek khe.",
            "             Ravguangc hym rui gaancna bam e.",
            "             Tingsaeng zaeng kata thuancna bam ni."
          ]
        }
      }
    },
