          "lines": [
            "          176 Lungh Khat Chwn Khat Swna",
            "                              6.5.6.5.Ref. 6. 6. 6. 5",
            "          Doh hei E",
            "",
            "          1. Lungh khat chwn khat swna,",
            "             Khat ta 'zian ni;",
            "             Aniw guay kariuna,",
            "             Ravguangc ta 'zian ni.",
            "",
            "                      Aramsuan kaguayna,",
            "                      Ravguangc rui kuaklou kumc,",
            "                      Khat ramsuan guay ta,",
            "                      Ai kuaklou bam ni.",
            "",
            "          2. Chwnsi zaengsi' ganv khou,",
            "             Khat ta 'zian ni;",
            "             Ravguangc rui 'zianmei kumc,",
            "             Khat ta 'zian ni.",
            "",
            "          3. Nang ta zauczihmnei ta,",
            "             Nang 'zian khangclou tio;",
            "             Nzianmei riang ruina,",
            "             Khat ta bang kho."
          ]
        }
      }
