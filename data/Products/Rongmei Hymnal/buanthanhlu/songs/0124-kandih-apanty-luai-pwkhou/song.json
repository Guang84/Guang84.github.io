          "lines": [
            "          124 Kandih Apanty Luai Pwkhou",
            "                          8.8.8.8. ref.9.9. 10.7",
            "",
            "          1. Kandih apanty luai pwkhou,",
            "             Mbaanv pumc hei ganclou ducna;",
            "             Neihlaamei tingkauh akai thangc,",
            "             Samctat kan ni the akai thangc.",
            "",
            "                     Neihlaamei laana lungc nipui ramc,",
            "                     Lauziu nac rui gaancna bampui ramc,",
            "                     Theihmei mikdui keymei nai dat lak khe,",
            "                     Tingkauh salem ramc khoutei.",
            "",
            "          2. Kandih khou lwmloumei guay rui,",
            "             Tingsaeng zaeng kata lungc 'cham ni,",
            "             Heic ramcgai khoutei lungh khangrui,",
            "             Samctat kan ni the heic khoutei.",
            "",
            "          3. Aniw rui 'tamvlou kanmei guay",
            "             Heic khoutei ariu dat pwni.",
            "             Heic nungc kiu adih gay ni cho?",
            "             'Zianmei nunc khoutei khwan bam e.",
            "",
            "          4. Heic ramc thangctei 'niw tangc pwkhou,",
            "             Neihlaamei lu raana suanna,",
            "             Eden ramc gay khou thuanc bam ni,",
            "             Khoutei guang khang khwan ngammak khe."
          ]
        }
      }
