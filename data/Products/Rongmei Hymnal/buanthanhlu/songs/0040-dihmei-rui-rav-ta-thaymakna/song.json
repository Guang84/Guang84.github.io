          "lines": [
            "          40 'Dihmei Rui Rav ta Thay Makna",
            "                             8.4.8.4.Ref. 9.8.4.10",
            "          Doh hei F",
            "",
            "          1. 'Dihmei rui Rav ta thay makna,",
            "             Chaeng maanv ngam the.",
            "             Guloumei nang laatow ethei",
            "             Taanv taancthau tho.",
            "",
            "               Jisu ramgai meic nunc how kan diu!",
            "               Kata thay makmei nunc hu khou,",
            "               Lungc lyan bam o.",
            "               Seitaan tuang phaypanv gaymei sw bam rio.",
            "",
            "          2. Jisu ramgai meic nunc guay nic,",
            "             Laatow kan diu.",
            "             Ringcsuangmei panty laa an khang,",
            "             Dinclou ti tho.",
            "",
            "          3. Nangniw thu Ravguangc nac nunc e;",
            "             Siimei taanh rio.",
            "             Meic nunc rui nang ta zauc bam e;",
            "             Thanna lungc o."
          ]
        }
      }
    },
