          "lines": [
            "          15      Apanty Khouhei ruina Jisu ta",
            "                              14.14.14.Ref.14.15.7",
            "          Doh hei Gb",
            "",
            "                  Apanty khou hei ruina Jisu ta ariu pwni",
            "                  Kamei guang dat pwkhou kiu",
            "                  kata sowriu ni 'zuanh makna",
            "                  Apanty khouhei ruina.",
            "          1. Kalwn kaliak gay liangmei 'zianna",
            "                                  nuic rimhrim lana (2)",
            "             Ata laa khang key pwni paapc",
            "                                 padikmei 'dih khouhei.",
            "          2. Abumaengc hei ruina nic Kalat tei",
            "                                 chulou khourui (2)",
            "             Abumaeng hei neihlaa the, Kamei",
            "                                  abumaengc kaipouc.",
            "          3. Kamei key datpui nungc kiu ai rui",
            "                                  Kata sowriu ni (2)",
            "             Neihlaa zaenggaymei ruina gulou thaymei",
            "                                             kaipouc ta.",
            "",
            "          4. Pou' Jisu ta nzian o, Kalatdanv",
            "                                          guay tei piu o (2)",
            "             Nang ta phungckulou pwni gay liangmei",
            "                                              tingkauh khoutei."
          ]
        }
      }
    },
