        "content": {
          "format": "source-lines",
          "lines": [
            "          182 'Maan Dat Lakmei Poubauhmei Ramc",
            "                              11.7.11.5.Ref. 9. 5.9.5",
            "          Doh hei Eb",
            "",
            "          1. 'Maan dat lakmei Poubauhmei ramc tei ning e;",
            "             Gaanchuangcna howmei paengc thangc,",
            "             Neihriw gaeng dat mak khe nthanmei rar tei;",
            "             Heic ramc gay khoutei.",
            "",
            "                  Tingkauh nzwan o, nzianmei guay,",
            "                  Paapc khourui duakna,",
            "                  Tingkauh nzwan o, nzianmei guay,",
            "                  Paapc khou rui duakna.",
            "",
            "          2. Thau tho 'zianmei nunc thiu,",
            "             Tingsaeng ramc 'zwan khang;",
            "             Paapc khou rui duakpat lana,",
            "             Neihmik nic key dat mak,",
            "             Ringcsuangmei ramc tei,",
            "             Ningna bam di kho.",
            "",
            "          3. Thau tho apu 'chaic thiu,",
            "             Panty luai mak khou;",
            "             Zinghmei tei tigaanc di kho.",
            "             Poubauhmei ramc 'naa the,",
            "             Tingmik thuih lwm o;",
            "             Heic kandic khouhei."
          ]
        }
      }
    },
