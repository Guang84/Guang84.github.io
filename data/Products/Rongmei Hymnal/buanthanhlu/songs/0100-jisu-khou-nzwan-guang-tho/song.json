        "content": {
          "format": "source-lines",
          "lines": [
            "          100     Jisu khou Nzwan Guang tho",
            "                          7.6.8. 6.Ref. 7. 6. 8.6",
            "          Doh hei E",
            "",
            "          1. Jisu khou nzwan guang tho;",
            "             Paapc bangc sw saenghri tho.",
            "             'Maan nimei khou lunghgutlouna,",
            "             Ruantat dat bam ri tho.",
            "",
            "                  Jisu pamv khou hanguang tho;",
            "                  Nang paap guay kuaklou khang.",
            "                  Paapc tuang ramgai ndeihmei rui,",
            "                  Nang bumaengc 'maan pwni.",
            "",
            "          2. Kandih ramring ringhmei rui,",
            "             Ringcsuangmei laa ngam mak.",
            "             Nang paap guay saa ndauhpat tho;",
            "             Ringhmei laatow pwni.",
            "",
            "          3. Tingkauh kaikhamv laanc bam khou,",
            "             Maeng maantat bam ri tho.",
            "             Zinghmei 'zaengc lim kaanpat pwkhou,",
            "             Ariu pwni Kata."
          ]
        }
      }
    },
