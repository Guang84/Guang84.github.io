          "lines": [
            "          203 Neih Keyloumei Chyng Paengc Thangc",
            "                                7.6.7.7.Ref. 7. 6. 7.7",
            "          Doh hei E",
            "",
            "          1. Neih keyloumei chyng paengc thangc,",
            "             Neihkhat ai tat pwni;",
            "             Jisu pamv khou ai tat ni,",
            "             Ata 'zianmeipu pamv khou.",
            "",
            "                      Neih keyloumei chyng paengc thangc,",
            "                      Tingkauh akhang nai the;",
            "                      Neih keyloumei chyng paengc thangc,",
            "                      Jisu ta ai how ni the.",
            "",
            "          2. Taanc-ruaicmei guay 'thaekc pwni;",
            "             Zinghmei tat kan pwni;",
            "             Ryanraa guay 'maan kan pwni;",
            "             He adih ch'ryn pwni cho!",
            "",
            "          3. Baanch'raa guay tiangka 'muan ni;",
            "             Poubauhmei key pwni;",
            "             Kamei nunc ta laa thau ni:",
            "             Ringhmei tingmik pwni the."
          ]
        }
      }
    },
