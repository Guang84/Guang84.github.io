        "content": {
          "format": "source-lines",
          "lines": [
            "          261 Reynungc Eden Khou Paapc Zaeng",
            "                          8.8.8.8.Ref. 12. 12.8.8",
            "          Doh hei D",
            "",
            "          1. Reynungc Eden khou paapc zaengrui,",
            "             Ravguangc lev ata titamvlou.",
            "             Apumc hei nthan makmei e,",
            "             Akhang neihlaamei ariw mak.",
            "",
            "                  Ntaw thu ai rui thay dat the 'zianloumei tei;",
            "                  Ai tingsaeng ringh khang Kazei keyna theicloumei.",
            "                  Simei guay ta kuaklou ngamna,",
            "                  Kros khou zei rui khiu 'thanlou the.",
            "",
            "          2. He Ravguangc ai thu 'phuammei e,",
            "             Alung khou siimei rui padik.",
            "             Nang khourui ducna tatbam khou,",
            "             Ryanraamei rui ata gumliam.",
            "",
            "          3. Lungning mphuammei rui ata,",
            "             Ravguangc khourui titamvlou the.",
            "             ARavguangc lev aney kak khou,",
            "             Apaap rui ata titamvlou."
          ]
        }
      }
    },
