        "content": {
          "format": "source-lines",
          "lines": [
            "          34      Chu lo Tingkauhmei Guay",
            "                       12.7.11.8 Ref.7.7.7.6. 7. 6. 7.5",
            "          Doh hei. E",
            "",
            "          1. Chu lo tingkauhmei guay lev kandihmei guay le,",
            "             Ravguangc rui saaloumei hei",
            "             Ai rui makuatthauloumei nac nunc guày rui,",
            "             Ata howmuna adow e.",
            "",
            "                  Israelmei Amei guay rui, (3)",
            "                  Ata thaylou mak ge.",
            "                  Israelmei Amei guay rui,",
            "                  Ata thaylou mak ge.",
            "                  Israelmei Amei guay rui",
            "                  Ramhthaylou mak ge.",
            "",
            "          2. Kiruai guay sihnic kakaipouc lwn tei thay e;",
            "             Nangniw thu Ata thay mak.",
            "             He Israelmei nunc, Ata thavlou 0,",
            "             Ai kaw bammei hei chulou o.",
            "",
            "          3. Kaipouc rui saa e guango kaphianh kariu kho,",
            "             Nang paap tei haengcringc sihnic,",
            "             Ai rui gunh kumcna khiu mphwanlou pwni,",
            "             Kalvari Lauziu Nac zei rui."
          ]
        }
      }
    },
