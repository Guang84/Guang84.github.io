          "lines": [
            "          175 Lwmna Chamdaanv Bammei Guay Khang",
            "                                 8.9.10.8. Ref. 9. 9. 8.8",
            "          Doh hei D",
            "",
            "          1. Lwmna chamdaanv bammei guay khang,",
            "             Nkhamhpui nungc neihlaa zaenggay ni.",
            "             Nangniw pumc lev nangniw bumaengc guay tei,",
            "             Ravguangc khang tiipatna lungc o.",
            "",
            "                      Ravguangc thuanhpui khwan rui padik ni;",
            "                      Lwmloumei guay rui guang bam pwni;",
            "                      Ntaw kapna bammei mikdui,",
            "                      Ravguangc rui thutphuilou pwni.",
            "",
            "          2. Kandih ramneilaa heiczumei,",
            "             Matat khatna khang de 'zianmei guay.",
            "             Tingkauh ramneilaa zạenggai guay hei mu,",
            "             Tingsaeng zaeng kimkey dat lak khe.",
            "",
            "          3. Pou' rui chamdaanvloumei ramc khou,",
            "             Lungh khangtei tat di kho 'zianmei guay;",
            "             Lwmmei guay rui tat ri kan pwkhou kiu,",
            "             Kandih hei ryanraa pwni the."
          ]
        }
      }
    },
