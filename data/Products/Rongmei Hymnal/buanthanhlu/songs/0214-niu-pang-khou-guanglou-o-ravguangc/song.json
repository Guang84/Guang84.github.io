        "content": {
          "format": "source-lines",
          "lines": [
            "          214 'Niu Pang Khou Guanglou o, Ravguangc!",
            "                             8.5.8.5.Ref. 6. 6. 8.7",
            "",
            "          1. 'Niu pang khou guanglou o, Ravguangc !",
            "             Kahu nungc kumcna,",
            "             'Dih zin likmei Revival dai,",
            "             Tiikey khang huay e.",
            "",
            "                  He Pou, Revival tiikey o !",
            "                  Daihmei Revival tei ! (2)",
            "                  He Pou, Revival tiikey o !",
            "                  A khourui tithaulou o!",
            "",
            "          2. 'Niu khou maikwam ngamv swbakna,",
            "             Hac piang ganclou o,",
            "             'Seic 'niu khou maekmei Nang ngamv tei",
            "             Tiiguanglou dat ro!",
            "",
            "          3. 'Niu machunh' ravmaengc swmaan o,",
            "             Paapc sw 'thanlou o,",
            "             Nang taanv khou lunghlouna bam khang,",
            "             Lungh thanh tiilou o!",
            "",
            "          4. Nthiammei kathuih ta ngam khang,",
            "             Pumtan tiilou o,",
            "             Minc nzinh bammei napthai guay,",
            "             Khuam kaduai ngam khang !"
          ]
        }
      }
    },
