        "content": {
          "format": "source-lines",
          "lines": [
            "          67      He Nangniw Ravguangc Lauziu Nunc",
            "                               8.6.8. 6. Ref. 10. 10. 10.6",
            "          Doh hei G",
            "",
            "          1. He nangniw Ravguangc lauziu nunc,",
            "             Ntaw hanguang dat tho;",
            "             Nang ta nzianna kaw bam the.",
            "             Hanguang dat katumc tho.",
            "",
            "                  Nang ta kaw e nzianmei khwan ruina:",
            "                  Nang khuay guay Ravguangc khou pat tho.",
            "                  Guang tho (2) nang paap guay kuaklou ni;",
            "                  Ai rui gulou pwni.",
            "",
            "          2. Kaipouc rui nkhwanna bam the;",
            "             Baanhzaapna kaw bam the.",
            "             Kaganv tei tatri pwni the;",
            "             Nang ning ngam mak pwni.",
            "",
            "          3. Ntaw di the nzianmei le,",
            "             Nang ning ngam mak pwni.",
            "             Nzianmei khwan rui kaw bam the,",
            "             Kaipouc khwan tei 'king tho.",
            "",
            "          4. Kanyng swna taanc niimei taanv,",
            "             Kandih hou taanhmei guay,",
            "             Nang taanv rui nang ta maikwam khou",
            "             Zaygutlou pwni the."
          ]
        }
      }
    },
