          "lines": [
            "          47      Gay Liangmei Apanty hei",
            "                        8.6.7.6.Ref. 10.8.6.7.6",
            "",
            "          1. Gay liangmei apanty hei mu,",
            "             Maan nuangc kan pwni the;",
            "             Kaganv rui nai bam khouhei,",
            "             Aniw lunghlaic di kho.",
            "",
            "                  Guang o, tata kho, Ravguangc Jisu kai khou,",
            "                  Ramh ningtow mak bampui ganv khou",
            "                  Jisu guang pwni the.",
            "                  Kaganv rui nai bam khouhei,",
            "                  Khrista khou lwm dikho.",
            "",
            "          2. Tingkauh kai tei gay changh gay e,",
            "             Gay chuymei tingkauh khou",
            "             Ravguangc lev heic ramc khoutei.",
            "             Aniw lev lungc chamc ni.",
            "",
            "          3. Ramh ningtow mak bampui ganv khou,",
            "             Jisu guang pwni the.",
            "             Kaganv rui nai bam khouhei,",
            "             Aniw lunghlaic di kho."
          ]
        }
      }
