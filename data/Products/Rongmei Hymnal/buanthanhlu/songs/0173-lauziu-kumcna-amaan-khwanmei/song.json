          "lines": [
            "          173 Lauziu Kumcna Amaan Khwanmei",
            "                             8.6.8.6.Ref. 6. 7. 9.9",
            "          Doh hei E",
            "",
            "          1. Lauziu kumcna amaan khwanmei,",
            "             Kakhou hanguang dat the.",
            "             Akhou bam tanhtan bam ethei,",
            "             Thei thangc 'maan dat lak khe.",
            "",
            "                  Ganclouna, Ganclouna,",
            "                  Tingkauh ramgai ganclouna;",
            "                  Kandih ryanraamei guay akhaengvna;",
            "                  Paapcmei ai kumhmei ta gulou the.",
            "",
            "          2. Kaipouc ata nduanghlou o;",
            "             Nang pamv khou guangtangh khang.",
            "             Kandih ramc khou ryanraa bammei,",
            "             'Thei thangc neihlaa dat ni.",
            "",
            "          3. Tingkauh ramgai tei how kan diuc,",
            "             Twna kaucna bam the.",
            "             Kandih kabamv kathuihna khou,",
            "             Kaucna bam the."
          ]
        }
      }
    },
