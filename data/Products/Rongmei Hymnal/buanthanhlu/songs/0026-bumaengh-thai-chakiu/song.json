          "lines": [
            "          26          Bumaengh Thai Chakiu",
            "                              10.8.10.9.Ref.6.12.12.8",
            "",
            "          Doh hei F",
            "",
            "              1. Bumaengh thai chakiu hei nthai la tho.",
            "                 Nang khou nthailou mak gethei,",
            "                 Latryan geih thangc nang rui piu bam sihnic,",
            "                 Tingkauh kai thangc nang khang bamv maek ge.",
            "",
            "                        Bumaengh tuang thai kiu thu:",
            "                        Nzianmei, neihlaamei, chuzaenghmei,",
            "                        khaenvgsaenghmei,",
            "                        Lunghzaenghmei, gay chuymei, lwm nuhmei,",
            "                        lungh niamhmei,",
            "                        Kapumc sinriap thaymei tei e.",
            "",
            "              2. Nang rui lingcloumei nang tay dat pwni.",
            "                 Zanh pumc swna lingclou ethei,",
            "                 Zanh pumc swna suai makna tay dat ni.",
            "                 Baibal khou nthanna hylou e.",
            "",
            "              3. Thow kumhmei rui bumaengh khou lingc ethei,",
            "                 Ringhmei bumaengc tay dat pwni.",
            "                 Gaypui taanv taanh khang tei ranvlou la tho;",
            "                 Thaymakpui ganv khou tay dat pwni."
          ]
        }
      }
    },
