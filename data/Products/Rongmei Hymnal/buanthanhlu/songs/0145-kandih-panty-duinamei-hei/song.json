          "lines": [
            "          145 Kandih Panty Duinamei Hei",
            "                             8.8.8.8.Ref. 8. 8. 8",
            "          Doh hei, D",
            "",
            "          1. Kandih panty dui namei hei,",
            "             Sinsw the mbaanv ramgai khou.",
            "             \"Taw ai guang the, Nang pamv 'zwanna.",
            "             Kuaklou na ro, akhuay guay tei.",
            "",
            "                  Poubauhmei rui ata 'zianmei,",
            "                  Kauc ruan bam ni kandih khou hei.",
            "                  Ai dinc ruan ni ata 'zianmei.",
            "",
            "          2. Laatowmei chakin gaymei hei,",
            "             Ravkhaengmei lev nyngswmei khou,",
            "             Ai sinsw the mbaanv puat guay;",
            "             Kuaklou na ro akhuay guay hei.",
            "",
            "          3. Pou' rui tiilou, apanty hei;",
            "             Ganckey ni the mbaanv puat guay;",
            "             Nang khang ruina sinsw ni the:",
            "             Kuaklou na ro, akhuay guay hei."
          ]
        }
      }
    },
