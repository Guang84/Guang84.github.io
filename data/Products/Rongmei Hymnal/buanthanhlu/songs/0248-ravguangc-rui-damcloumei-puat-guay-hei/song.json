          "lines": [
            "          248 Ravguangc rui Damcloumei Puat",
            "                          9.8.8.8.Ref.7. 6",
            "          Doh hei Eb",
            "",
            "          1. Ravguangc rui damcloumei puat guay hei!",
            "             Zauc lo, ch'ryn e Kabaansiam guay.",
            "             Makumh o, kandihmei guay le,",
            "             Ravguangc rui damcloumei puat guay.",
            "",
            "                  O ch'ryn e, Ravguangc ramdam!",
            "                  Ch'ryn e, Ravguangc ramzian!",
            "",
            "          2. Chyng lev nzaengc, duipui duithuak guay,",
            "             Kauh thangc bw lev gaanchuangc guay nic,",
            "             How gaymei chingkhiuhmei guay nic,",
            "             Damc chuylou Kaipouc Ravguangc rui.",
            "",
            "          3. Ravguangc rui kandih ta nzianna,",
            "             Kanac khatna ta tiilou the.",
            "             How tangh makmei Zion ramc gay',",
            "             'Niw khang Kamei rui chamdaanvlou."
          ]
        }
      }
    },
