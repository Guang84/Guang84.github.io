        "content": {
          "format": "source-lines",
          "lines": [
            "          36 'Chu Nzaenghna Lungc Diu Khang",
            "                             7.7.8.10.8.Ref. 8. 8.7.6",
            "",
            "          1. 'Chu nzaenghna lungc diu khang,",
            "             Ravguangc khou lwmloumei guay,",
            "             'Thanmei panty tei gay liang e.",
            "             'Thanmei guay rui, 'chumhmei kaguay rui,",
            "             Tingkauh kandic tei how pwni.",
            "",
            "                  Aniw hei Ravguangc nac nunc e.",
            "                  Nthanmei panty khou lungcna,",
            "                  Sw nthanmei rui hamhna,",
            "                  Pou' ta how ngam mak ge.",
            "",
            "          2. Tingkauh tuang kaidai khoutei,",
            "             Thuanhmei ruina padik ge.",
            "             Lauziunac rui gaancna bam e.",
            "             Khoutei 'zianmei lev lungning nthanmei",
            "             Ta 'duanghna lungc bam e Pou' rui.",
            "",
            "          3. Aniw khang chamdaanvloumei,",
            "             Nthanmei pheybaan nai e.",
            "             Kandih khou 'thanna lunghmei guay,",
            "             Khoutei ku pwni 'thanmei kaguay rui.",
            "             He adihkamv neihlaa ni cho!"
          ]
        }
      }
    },
