        "content": {
          "format": "source-lines",
          "lines": [
            "          83 Heic Kandic khou Ai rui Guangmei",
            "                           7.8.7.6. Ref. 9. 8. 8. 10",
            "          Doh hei G",
            "",
            "          1. Heic kandic khou ai rui guangmei;",
            "             Nruay guay rui thingphaanv gay khou,",
            "             Tow khanvmei kumc neihkhat zaeng",
            "             Khang de ai rui guangmei.",
            "",
            "                  Nrianhloumei ramc tei guangtangh khang,",
            "                  Swkaeng naina samcthay ethei,",
            "                  Nthaekc makna samctat nii e;",
            "                  Poubauhmei rui chamdaanvloumei ramc khou.",
            "",
            "          2. Sharon mwn gaymei puanghpui ramc,",
            "             Kachaekc namvdaih neihlaapui ramc;",
            "             Heic ramc khoutei lungh khang",
            "             Pou' Jisu rui khwan bam e.",
            "",
            "          3. Heic kandic hei karaankey the;",
            "             Tingsaengc lak khe heic kandic hei.",
            "             'Baanv ramgai ganclou ngamna,",
            "             Ai samctat kan ni the."
          ]
        }
      }
    },
