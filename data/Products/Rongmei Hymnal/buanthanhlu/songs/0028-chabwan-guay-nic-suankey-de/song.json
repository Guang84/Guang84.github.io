        "content": {
          "format": "source-lines",
          "lines": [
            "          28       Chabwan guay nic 'suankey de",
            "                              7.7.8.8.10.Ref.8.9.8.9",
            "",
            "               1. Chabwan guay ni 'suankey de,",
            "                  Alauc guay nic lakkey de.",
            "                  Ringhpouc khou ngangvloumei guay mu,",
            "                  Eagle mou kumc samcku pwni;",
            "                  Kaniw pakbam sihnic 'suankey lak ge.",
            "",
            "                         Maansei khou ngangvloumei suangc mu,",
            "                         Ringhpouc khou duploumei rui gay e.",
            "                         Guangh nunc khou ngangvloumei suangc mu,",
            "                         Ringhpouc khou duploumei rui gay e.",
            "",
            "               2. Nang pumtan rui ngammak ge,",
            "                  Bumaengc ric sw nimei tei,",
            "                  How makmei ric dou nimei tei,",
            "                  Ringhpouc bumaengc paan rui ngam ni.",
            "                  Huayney ranvmei guay rui rih hei ngam ni.",
            "",
            "               3. Bumaengh khuamguangmei khangtei,",
            "                  Hymdaihmei pyrun tii ni.",
            "                  Tingkauh Guangcdic gaymei khoutei,",
            "                  Ringhpouc ta thuanckuna bam ni,",
            "                  Hallelujah kaucna thuanc bam ni the."
          ]
        }
      }
    },
