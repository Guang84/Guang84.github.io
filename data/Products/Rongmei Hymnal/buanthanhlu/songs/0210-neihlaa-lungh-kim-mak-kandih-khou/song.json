        "content": {
          "format": "source-lines",
          "lines": [
            "          210 Neihlaa Lungh Kim Mak, Kandih khou",
            "                            13.10.9.8.5.Ref. 10. 10. 10. 10",
            "          Doh hei Eb",
            "",
            "          1. Neihlaa lungh kim mak kandih khou lungc bam",
            "             saanv khou hei:",
            "             Kalyari khou 'thanmei zei keylouna,",
            "             Akhang rui ryanraana theiclou the.",
            "             Paapc phunghmei bamv khourui ata",
            "             Kanpatlou dat the.",
            "",
            "                       He aRavguangc, ai guang the Nang pamv khou,",
            "                       Baihmei kahaw mak ge kandih khouhei.",
            "                       Ata kanpatlou the Ravguangc Nang rui,",
            "                       Kalvari khou keyloumei zei paanrui.",
            "",
            "          2. Kaganv tingsaengcna Ravguangc ta mpatlou sihnic,",
            "             Heicdi kamv ai paapc phungc bam khwan sihnic,",
            "             'Zianmei khwan rui ata kaw bam e:",
            "             Alung khou tingsaeng zaengna",
            "             Neihlaamei tiilou the.",
            "",
            "          3. He Ravguangc apanty tat kanmei",
            "             kaganv guay khou hei,",
            "             Ai rui Nang hu khou 'peyna maanvlou the.",
            "             Ai rui taanc maanvlou kanmei guay tei,",
            "             ARavguangc 'zianna kuaklou o,",
            "             Nang zauzian paanrui."
          ]
        }
      }
    },
