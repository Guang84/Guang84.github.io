          "lines": [
            "          233 Poubauhmei Kasiamhloumei Tingkauc",
            "                             9.8.7.10. Ref. 8. 8. 10. 10",
            "          Doh hei D",
            "",
            "          1. Poubauhmei kasiamhloumei tingkauc,",
            "             Alungning khou tiningtow e.",
            "             Seitaan bangc sw bammei guay,",
            "             Tingkauh kandic how ngam mak ge saa e",
            "",
            "                      He Ravguangc ata kuaklou o,",
            "                      Nang rui apaap guay kuaklou o,",
            "                      Nang hamhna akhang chaeng baihmei maek ge.",
            "                      Kuaklou na ro, Ravguangc kuaklou na ro.",
            "",
            "          2. Amaan kanmei zinghpui bamv khourui,",
            "             Poubauhmei rui kawmei khwan chu.",
            "             Han datna tat dat ritho;",
            "             Tat dat rethei nang theic pwni saa e.",
            "",
            "          3. Nang guangcdic 'zwan ni the Poubauhmei;",
            "             Nang rui 'zianmei charyn tuang e.",
            "             Nang guangcdic guang tangh mak saanv,",
            "             Nang baanzat rui ata zaylou na ro."
          ]
        }
      }
    },
