        "content": {
          "format": "source-lines",
          "lines": [
            "          298 Zauzian Ganv hei Luai Kan Pwkhou",
            "                          8.8.8.8.Ref. 8. 8. 8. 8",
            "          Doh hei F",
            "          1. Zauzian ganv hei luai kan pwkhou,",
            "             Rapchar tingmik hei guang pwni.",
            "             Lwmmei nunc tei laathau kan khou,",
            "             Dih khou ryanraa padik pwni.",
            "",
            "                       Kanloumei guay mbaanvthay 'ni;",
            "                       Lauziu Nac nowsuanh khou zau 'ni.",
            "                       Bam duhmei kaucna kap pwni;",
            "                       Lungh ngiuc sihnic kaganv ri the.",
            "",
            "          2. Louduhmei kandihmei guay mu,",
            "             Pingmei ch'rynmei padik pwni.",
            "             Bamduhmei guay kandih khouhei.",
            "             Kangaengv hiwna kap bam pwni.",
            "",
            "          3. 'Zianmei guay le, Bumaengh 'Thanmei,",
            "             Kandih khourui laathau pwni;",
            "             Chu-zaenghmei hei nai dat lak khe.",
            "             'Dih khou ryanraa padik pwni.",
            "",
            "          4. Ryanraamei guay guangtangh mak khou,",
            "             Kaganv gay khou lungh laic la tho.",
            "             Kaganv dui kanmei dak khouhei,",
            "             Poubauhmei khou lwmlou la tho."
          ]
        }
      }
    },
