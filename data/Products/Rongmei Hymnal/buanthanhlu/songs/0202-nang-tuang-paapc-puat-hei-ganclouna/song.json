          "lines": [
            "          202 Nang tuang Paapc Puat hei Ganclouna",
            "                             9.9.Ref. 7.8. 6.7",
            "",
            "          1. Nang tuang paap puat hei ganclouna,",
            "             'Baanvthaymei Khrista thei lay tho.   }2",
            "                     Zaengthaekc pwni Khrista khou,",
            "                     Kandih ramngai guay ganc' ngamna,",
            "                     Neihlaamei tingkauh khou,",
            "                     Khrista lev lungc 'chamc pwni.",
            "",
            "          2. Apaap zaeng rui Jisu Khrista.",
            "             Theihmei nganvna akhaenglou the.    }2",
            "          3. 'Dihkhou ryanraa chwnswmei guay,",
            "             'Baanvthaymei tingkauh tangc pwkhou,",
            "             Ravguangc hym ta thuancna bam ni,",
            "             'Dih ryanraamei ning dat lakkhe."
          ]
        }
      }
