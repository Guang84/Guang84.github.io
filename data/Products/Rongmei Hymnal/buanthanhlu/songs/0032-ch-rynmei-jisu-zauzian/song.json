        "content": {
          "format": "source-lines",
          "lines": [
            "          32      Ch'rynmei Jisu Zauzian",
            "                       6.6.8.6.Ref. 10. 12. 11",
            "          Doh hei E",
            "",
            "          1. Ch'rynmei Jisu zauzian,",
            "             Apaap 'suangc daic ranv e.",
            "             Ai kumhmei paapc phunghmei nac khang,",
            "             Kazei luangckeylou the.",
            "",
            "               Karam zianlou ai makumh ngam thuy mak.",
            "               Apumtan akhwan naipui kamv thuanc bam sihnic,",
            "               Thuanc kim thuy lak ge ch'rynmei Jisu zauzian.",
            "",
            "          2. 'Zianmei baanc rui zaapna,",
            "             Aniw ta kaw bam e.",
            "             'Zianmei guay Akhou guanglou o,",
            "             Ai zaeng tithaekclou ni.",
            "",
            "          3. Nang zaw karih pat ro,",
            "             Gu'meipu biak thangc tei.",
            "             Nang khuay guay tei kuaklou pwni,",
            "             Twna 'zianna saa e.",
            "",
            "          4. Dihmei guay chakzauc lo:",
            "             Kaganv hei rauguang the.",
            "             Nuhloupui ganv khou guangmei guay,",
            "             Gui gay san gaymei e."
          ]
        }
      }
    },
