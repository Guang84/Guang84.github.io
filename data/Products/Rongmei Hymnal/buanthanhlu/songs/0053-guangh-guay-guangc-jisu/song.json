          "lines": [
            "          53      Guangh Guay Guangc Jisu",
            "                           5.6.6.6.6. Ref. 6. 6.9.6",
            "",
            "          1. Guangh guay guangc Jisu,",
            "             Mbaanv khou puanclou the.",
            "             Aniw ta gulou khang,",
            "             Kamei guangpui tuang e.",
            "             Hallelujah ! Amen!",
            "",
            "                          Kata laaloumei nunc,",
            "                          Sangay daic liangmei e.",
            "                          Kakumc ringc pwni the tingsaeng zaeng.",
            "                          Hallelujah ! Amen !",
            "",
            "          2. Nang Kathei lay o;",
            "             Kamei rui tingkauh khou,",
            "             Nduangh guanglou pwni,",
            "             Ryanraamei maekpui bamv.",
            "             Hallelujah ! Amen !",
            "",
            "          3. Nzianmei guay le,",
            "             Ntaw hei nang khang the;",
            "             Nthuanh panty thay mak.",
            "             Ntaw lungh laic la tho.",
            "             Hallelujah! Amen !"
          ]
        }
      }
    },
