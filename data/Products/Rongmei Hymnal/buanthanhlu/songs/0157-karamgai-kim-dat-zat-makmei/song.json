            "          157 Karamgai Kim Dat Zat Makmei",
            "                          8.8.8.9. Ref. 8. 9. 8.9",
            "          Doh hei Gb",
            "",
            "          1. Karamgai kim dat zat makmei,",
            "             Pou' rui chamdaanvloupui ramc tei;",
            "             Kalaanv zingbangc nai dat lak khe,",
            "             Zion namvdai gaymei ramc khoutei.",
            "",
            "                  Tingkauh Jirusalem namvdai,",
            "                  Ndaapc tarimei nai dat lak khe:",
            "                  Bw, neih, gaanchuangc riw nsaa de;",
            "                  Lauziu Nac rui gaanc e hei khoutei.",
            "",
            "          2. Pou' Nang guangcdic 'thanmei khoutei,",
            "             Theihmei suhmei nai dat lak khe.",
            "             Mikdui rouna ntamvmei hei,",
            "             Nai lak khe Nang guangcdic gay khoutei.",
            "",
            "          3. Ryanraamei mbaanv kandic khou,",
            "             Theihmei suc-nucmei padik ge;",
            "             Ntamvmei ryanraa chwnswmei,",
            "             Nai lak he Nang guangcdic gay khoutei."
          ]
        }
      }
