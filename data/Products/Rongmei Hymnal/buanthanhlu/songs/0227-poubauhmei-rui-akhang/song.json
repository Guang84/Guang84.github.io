        "content": {
          "format": "source-lines",
          "lines": [
            "          227 Poubauhmei rui Akhang",
            "                        10.9.10.9.Ref. 10.9. 10.9",
            "          Doh hei G",
            "",
            "          1. Poubauhmei rui akhang zaenggaymei ramc,",
            "             Kathancmei kai khat kasiamhlou the;",
            "             Gay kanmei 'dic tingkauh Jerusalem,",
            "             Ai rui bampui bamv heic khoutei e.",
            "",
            "                      Tatgut pwni Jerusalem nganvna,",
            "                      Kathancmei Jerusalem khoutei,",
            "                      Ai bampui bamv tingkauh Jerusalem,",
            "                      Heicpui bamv khoutei ai tat pwni.",
            "",
            "          2. Kariw rui gaanhgaymei Jerusalem,",
            "             Heicramc khoutei theihmei, nnaumei,",
            "             Bw-neih rui gaanhmei kariw nai lak khe,",
            "             Poubauhmei rui kariw sw pwni.",
            "",
            "          3. Zaenggaypui ramc Jerusalem khoutei,",
            "             Paapc taanhmei guay, paapc phunghmei guay rui,",
            "             Gut ngam lak ge, ryanraamei sw pwni,",
            "             Tingsaeng zaeng ryanraamei sw pwni.",
            "",
            "          4. Poubauhmei lev atuang zaenggaymei ramc,",
            "             Akumhpui ganv khou guangtangc ni cho?",
            "             Ai rui khoutei tangh khang tat pwni e.",
            "             Ai rui bampui bamv heic khoutei e."
          ]
        }
      }
