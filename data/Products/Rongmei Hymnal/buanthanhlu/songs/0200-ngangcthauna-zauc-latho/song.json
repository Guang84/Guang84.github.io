        "content": {
          "format": "source-lines",
          "lines": [
            "          200 Ngangcthauna Zauc La tho",
            "                             6.9.8.6.Ref. 8. 8. 8.8",
            "",
            "          1. Ngangcthauna zauc la tho:",
            "             Theihmei khou bammei kaguayna ta.",
            "             Tingsaeng 'maan nipui mei guay ta,",
            "             Gulou khang kaamcthau tho.",
            "",
            "                    Ravguangc rui 'zian, zaatc guayna ta;",
            "                    Kadaeng khou guangmei laanii e.",
            "                    Aniw ringhmei laatow ethei,",
            "                    Thau lana dinc tat lak na cho?",
            "",
            "          2. Tatna dinc liklou o,",
            "             'Tay nimei maekna minc raamkey the,",
            "             Ndaapcna bammei maikwam rui,",
            "             Ntei ngam kan ni the.",
            "",
            "          3. Pou' rui ndiu bam e,",
            "             Khristian tuang chabwan kaguayna ta.",
            "             Kaipouc khang bumaengh khuam nimei,",
            "             Ai the twna tat tho."
          ]
        }
      }
    },
