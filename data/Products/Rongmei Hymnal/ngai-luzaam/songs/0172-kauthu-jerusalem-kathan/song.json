        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kauh thu Jerusalem kathan",
            "Kauh thanmei nun bampui ramgai,",
            "Khoutei Gwangh Immanuel rui guanghtu bam e",
            "Ninga zuan guang e Zion ramgai thang tei.",
            "",
            "Hei kandi khang suang",
            "Gailiangmei Zion ramtei",
            "Theimei, rianramei, zingmei",
            "Nai dat mak pui ram khoutei",
            "Zion chingru khou Guang lauziuna",
            "Thuanpui lu suanni.",
            "",
            "2. Immanuel nangtuang zeitei,",
            "Atingsang lu gaimei suni",
            "Mbaan thaimei tingkao ram ai guang tang pukhou,",
            "Poubaomei ringmei munta airui houni.",
            "",
            "3. Haleluya kanloumeipu,",
            "Kandi ramguai hei nang tuang e,",
            "Nang zeirui ata liulou ai hei nang tuang e,",
            "Ai khuan bam e rianramei Zordan pang khou.",
            "",
            "4. Guangdat zaini cho Poubaomei,",
            "Kandi rianramei rui gumliam,",
            "Kanaan ram le nangta airui ningtaan makge,",
            "Kandi pat louna thanmei ramkhou lungni."
          ]
        }
      }
