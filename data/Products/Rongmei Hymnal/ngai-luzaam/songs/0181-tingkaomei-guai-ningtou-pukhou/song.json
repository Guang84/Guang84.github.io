        "content": {
          "format": "source-lines",
          "lines": [
            "1. Tingkaomei guai ningtou pukhou",
            "Poubaomei Jisu daeng khou mu",
            "Ndaap tarimei nai lak khe",
            "Tingkao ram tang pukhou.",
            "",
            "2. Apu Raguang ai zipthau kum",
            "Lung rianramei mankhang thaimak;",
            "Ai bammei kandi khou hei mu",
            "Nuipat khang ni makge,",
            "Nuipat khang ni makge.",
            "",
            "3. Apoubaomei ai bammei hei",
            "Lungning rianrapui ram rana;",
            "Thiammei kandi pap ram dei e",
            "Lung baanthai khang makge,",
            "Lung baanthai khang makge.",
            "",
            "4. Jisu akhang kasiampui ram,",
            "Tabui nung rui guangtang nicho?",
            "Ai ningbam khou tang e thei mu",
            "Lung rianra dat lak khe,",
            "Lung rianra dat lak khe."
          ]
        }
      }
