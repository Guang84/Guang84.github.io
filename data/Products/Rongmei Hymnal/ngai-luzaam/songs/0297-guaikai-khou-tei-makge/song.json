        "content": {
          "format": "source-lines",
          "lines": [
            "1. Guaikai khou tei makge nganah jibam khang,",
            "Kiruai kuak khou jilou e pou Jisu ta;",
            "Ganchuanga guai ({0 jaokei e kaji ta,",
            "Nganah Jisu tei napgou rukhou jip be.",
            "",
            "2. Nganah tei jipchiang e guai ({0 muang khoutei,",
            "Ki nganah Jisu thu khou tei kap makge;",
            "Ai huai e pou Jisu jaokei lou naro,",
            "Adang khou bamlou o tinggan pat maksan.",
            "",
            "3. He poubaumei Jisu adang khou bamlou o,",
            "Tak makna bamlou o ata jianlou o;",
            "Alauh guaita nang ({0 kungna sulou o,",
            "Tingkauh khou lungcham khang niuta sulou o."
          ]
        }
      }
