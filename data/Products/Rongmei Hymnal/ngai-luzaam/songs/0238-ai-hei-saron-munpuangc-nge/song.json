        "content": {
          "format": "source-lines",
          "lines": [
            "1. Ai hei saron mun puang e,",
            "Nzaeng dih khou lily puang",
            "Luang le nzaeng dui pui khou",
            "Nang ram gai dinlik kan diw.",
            "",
            "Lily munpuang pui ram khou",
            "Rian ramei nai dat lak khe",
            "Kao sini nga lan lak khe,",
            "Kao ram gai guang tang mak san.",
            "",
            "2. Than mei guai le lung cham ni.",
            "Hei kandi tad tuan pukhou,",
            "Nei lapui lu than suan ni.",
            "Tingsang gan bam pui dih khou .",
            "",
            "3. Thao tho thao tho Christian guai .",
            "Zipri mei ta nchiang o.",
            "Sao ding khou Apple thao kum .",
            "Thiem mei ni nai bam khuan ne.",
            "",
            "4. Nchum mei na su latho.",
            "Kagan ri jai puni the.",
            "Num ding khou Lily thao kum",
            "Thiem mei ni nai bam khuan ne."
          ]
        }
      }
    },
