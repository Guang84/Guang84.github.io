        "content": {
          "format": "source-lines",
          "lines": [
            "1. Nzuan guang e Salem ram gaikhou,",
            "Lunggeihmei makpui ram khou tei;",
            "Tang khang khuanna nzuan guang e,",
            "Hei kandi khou gaimei makge.",
            "",
            "Rinara rianriu mei khaeng ngam mak,",
            "Rianrapui ram kandi khou hei;",
            "Nang rui hamhma guang tang ngam mak,",
            "He! Tingkao nzaenghmei Guang patlou rio.",
            "",
            "2. Ai nzuan guang e ringhpui ram khou,",
            "Theihmei Jordan dui rui dailiam;",
            "Tingkao le kandi kak khou hei,",
            "Nang hamhma ai guang tang ngam mak.",
            "",
            "3. Theihmei Jordan dui rui dailiam ma,",
            "Ringhpui bam gaanhpui di khou tei;",
            "Nang rui hamhma guang tang ngam mak,",
            "He Bumaeng Thanmei sam guang o."
          ]
        }
      }
