        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kamei zailou khou ai tat ni,",
            "Kakhou lumbam khang ncham lou,",
            "Ai ningtou e akhang dyng the",
            "Kalvary khou theilou mei tei.",
            "",
            "Zingbang kalaan jisu zailou,",
            "Chaeng guay khou ata zailou ni,",
            "Kamei zianmei achampan ne,",
            "Kalvary ai ningtou khou rui.",
            "",
            "2. Kalatdan tei ai ngui chang e,",
            "Kabaanh rui zianthay khang zailou;",
            "Kachun tei ai ni kahau e,",
            "Kalvary zeirui khiulou na.",
            "",
            "3. Lumsi pingmei mak na tat ni,",
            "Guloumei puh le neihlaa na,",
            "Ai lum the kata hou puni,",
            "Kalvary jisu champaan ta."
          ]
        }
      }
