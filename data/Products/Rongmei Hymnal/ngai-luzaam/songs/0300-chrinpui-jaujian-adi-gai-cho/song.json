        "content": {
          "format": "source-lines",
          "lines": [
            "1. Chrinpui jaujian adi gai cho?",
            "Ai kummei ta gulou;",
            "Ai man khuanthe tao phutou dat,",
            "Miktiat khuanmei hou dat.",
            "",
            "2. Jaujian ({0 pingthai khang chamlou,",
            "Ai pingmei timan e;",
            "Adi thuk cho jaujian tan hei,",
            "Ai lumlou rap nung tei.",
            "",
            "3. Rianra rianriu pharang khou ({0,",
            "Ai hei duakna guang the;",
            "Jaujian pan e heisan guangmei,",
            "Tingkauh ngan jailou ni.",
            "",
            "4. Kauh khou niu nei kum gan nungkiu,",
            "Kum ching ruh lung nung kiu;",
            "Raguang thuanmei tak mak thuanni,",
            "Tao thuanmei suang thuanni."
          ]
        }
      }
