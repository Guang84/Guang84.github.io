        "content": {
          "format": "source-lines",
          "lines": [
            "1. Nzianmei apui apu rui",
            "Dinlou makge lat gaimei hei",
            "Bumaeng Thanmei rui dinlou e",
            "Nzianmei lev nchumpui lat",
            "",
            "Kaganv thui Pouta ai thuan ni",
            "Rianra puni neihlaa puni",
            "Sianlan makna lungsi sini",
            "Bible heirui asian laan e.",
            "",
            "2. Kandi khou hei ram guai nata",
            "Lumkhang makge ngangbang aimu",
            "Tingkao lungning nthukmei tei",
            "Tithai lou o nangbang akhou",
            "",
            "3. Apoubaomei siamrui sukhang",
            "Kamthau nithe zingni gaan ni",
            "Poubaomei ata zailou o",
            "Israel nunta zailoumei kum",
            "",
            "4. Rianra mei bam kandih khou hei",
            "Bamni makge nangbang aimu",
            "Poule atat zailou naro",
            "Tingkao neihlaa pui bam khoutei",
            "",
            "5. Poubaomei le nangbang guaita",
            "Nduang lou o kagan kathui",
            "Tatlou puibam kathui na khou",
            "Zailou naro nang baanzat rui."
          ]
        }
      }
