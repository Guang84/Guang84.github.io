        "content": {
          "format": "source-lines",
          "lines": [
            "1. Ravguangc zankhou zian mei nun guai,",
            "Kagan khat na nei la cham kho,",
            "Tamlou kan mei zian mei guai ta",
            "Tat khuan tho mang gai kadi e.",
            "",
            "Kagan khat khou ntam sini",
            "Nei khat pui ting mik riu dat ni,",
            "Ravguangc rui zao zian mei panrui",
            "Hou datni zian mei guay zaopan.",
            "",
            "2. Chana thiu tad ntam lou na",
            "Chingbut kaomei tat tuan lou na",
            "Tam lou kanmei zian mei guai ta",
            "Tat khuan tho mang gai kadi e.",
            "",
            "3. Zianmei nun ta ntam lou na",
            "Abaan zat hei rui ham guang e",
            "Kandi khou ntam lou sini",
            "Tingkao kai thang ariu dat ni."
          ]
        }
      }
    },
