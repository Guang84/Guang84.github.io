        "content": {
          "format": "source-lines",
          "lines": [
            "1. Tingkao thang bammei Guangh Jisu,",
            "Lungh rianramei makmei Jisu;",
            "Kandih khou rianra bam khou hei,",
            "Akhang Khrista rui tigaanlou.",
            "",
            "Charin tuang e, [2]",
            "Kazauzian tei charin tuang e,",
            "Kalvary khou akhang theilou,",
            "Ai ning thukge kanloumeipu.",
            "",
            "2. Ningtaan makge he Guangh Jisu,",
            "Ai thai tang ngam makmei Jisu,",
            "Lungh rianramei timaan lou o,",
            "Ringhmei thingbang khou zailou o.",
            "",
            "3. Lungh riaramei duidai bam khou,",
            "Kaan ngam makge zaikaan lou o,",
            "Charin tuang e Nang zauzian hei,",
            "Akhang Khrista rui theiloumei.",
            "",
            "4. Tingkao thang namdaih gaimei nai,",
            "Lungning nzaeghmei tilou o,",
            "Nzianmei riang rui banglou o,",
            "Tingkao kaigai khou zailou o."
          ]
        }
      }
