        "content": {
          "format": "source-lines",
          "lines": [
            "1. Sion chingdai kao tuan thu.",
            "Thei mei makpui bam khou tei ,",
            "Ripi daimei jisu rui kao the Chula tho,",
            "Ru adou khang rimei nun,",
            "Nang niu riipuan piu thao tho,",
            "Kao the khriata rui.",
            "",
            "2. Pou Raguangh chuang tei jaona ,",
            "Bengul khuan thei phai kam na .",
            "Huthu gutro sipai nun ;",
            "Buibang sin tipna",
            "Jisu lat tei ning chui lo,",
            "Pou Raguangh chuang phei zaulo",
            "Raguang rui hu gut puni.",
            "Rih tei adou khang.",
            "",
            "3. Kandimei riek phung mei nun,",
            "Raguang lat khou meijakmei",
            "Seitan rita ping mei nun,",
            "Athei lai ri o,",
            "Kapui kapu lou duna ,",
            "Thei khang ring khang ping mak mei,",
            "Kathei kari dat makmei,",
            "Nun rui laikan diu.",
            "",
            "4. Guang o mei nuan phung mei nun,",
            "Tingkao kandi lakhang tei,",
            "Tingsaeng ritho guang khap tho,",
            "Jisu thei laina ,",
            "Thei mei ta ngam lou duna ,",
            "Tarou khou rui thau datna ,",
            "Katik kagun tei daina ting kao ku kan the."
          ]
        }
      }
