        "content": {
          "format": "source-lines",
          "lines": [
            "1. Luangh ruthang tatna din o,",
            "Chingh guai rukhou le kabamthui!",
            "Luangh ruthang tatna din o",
            "Jisu Khrista puan the!",
            "",
            "Lauziu gaenghmei nun zingbang",
            "Lauziu pang gaekbam khou,",
            "Zau lo tingpuk chung thang rui",
            "Thanmei riu gaan-guang e.",
            "",
            "2. Kaniu ping kadunh bam khou",
            "Zau lo! Tingpuk la khou",
            "Gumeipu puanhmei cham tei",
            "Baanch’ra nun suan guang e.",
            "",
            "3. Niamhmei suna Khrista rui",
            "Guaihkai khou puan khuan e,",
            "Raguang tuang ringbam phung guang",
            "Puanhpui laukhuan khou tei"
          ]
        }
      }
