        "content": {
          "format": "source-lines",
          "lines": [
            "1. Alungh rui ninga tingkao ramta,",
            "Tabui nung ai guang tang nina cho?",
            "Nzianmei guai le ntammei guai,",
            "Mi ram khou tei souriu dat puni.",
            "",
            "He! Raguang nang tingsaeng ram khou tei,",
            "Zailou, gaenglou dat ro;",
            "Tabui nung rui ai khou tei guang tang nicho?",
            "He! Raguang kandih khou rianramei na guai rui.",
            "",
            "2. Tingkao nzuanna tat bam khou hei,",
            "Chaeng dinlou o He! Raguang Jisu,",
            "Nang ramgaimei tei ai houni e,",
            "Tabui nung rui ai guang tang nicho?",
            "",
            "3. Kandih khou tam kanmei zianmei guai,",
            "Tabui nung rui guang tang nina cho?",
            "Nang ramgai tei guang tanghpui nung kiu,",
            "Neihlamei pari tei ra ‘chamh ni."
          ]
        }
      }
