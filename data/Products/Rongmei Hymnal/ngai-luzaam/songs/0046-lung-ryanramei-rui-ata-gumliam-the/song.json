        "content": {
          "format": "source-lines",
          "lines": [
            "1. Lungh rianra mei rui ata gumliam the,",
            "Theimei chang duanggut khang,",
            "Lwmmei rui theimei ta ngam lou the,",
            "Kanloumeipu rui kaoguang.",
            "",
            "Neila the ntao mu ai rui na,",
            "Poubaomei nzian mei,",
            "Zian thaymei Pu;",
            "Abumaeng ta kanpat lou the.",
            "",
            "2. Laoziuna bampui ram guang tang pukhou,",
            "Neila na ariu ni,",
            "Theimei Jordan dui kanpat pukhou,",
            "Tingkao khumkih khou bam ni.",
            "",
            "3. Neilamei lung ning gaimei naimei hei,",
            "Jisu rui ti tuang e,",
            "Kandi neila mei khang suang gai e,",
            "Tingkao neila mei tei mu."
          ]
        }
      }
