        "content": {
          "format": "source-lines",
          "lines": [
            "1. Nking ngo kaniu khuan gaimei,",
            "Gundaipui tyngmik tang the,",
            "Kandi pap nthyam mei bam khou",
            "Nchu nzaeng na suan no.",
            "",
            "Kaoliang mei khou kahim daidiu ] 2",
            "Tuna nra khuan gaimei rui",
            "Njang na suan na bam e.",
            "",
            "2. Hougai e kaniu puan gaimei,",
            "Neimik khang suang gan gai e",
            "Kaniu phei phuan mei banlana",
            "Nchu nzaeng diu tu e.",
            "",
            "3. Rei nung Egypt ram khou kum ma",
            "Jubilee guang tang dat the",
            "Kahim daidiu kao liang mei khou",
            "Salem namdai lan lou the.",
            "",
            "4. Gan guang datro aniu dang khou",
            "Nryan lou mei gaanchuang-nga",
            "Jian mei nai diw kabam thui khou",
            "Tuna lu suanc kariu diw.",
            "",
            "5. Din kaluai datro banchra le",
            "Tingkao Guangh Immanuel",
            "Kaguangc bampaeng patlou duna",
            "Nuan phuang mei nun khang guang the."
          ]
        }
      }
