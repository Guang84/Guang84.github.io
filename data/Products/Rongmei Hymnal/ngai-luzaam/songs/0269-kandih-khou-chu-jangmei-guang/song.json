        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kandih khou chu jangmei guang puan the,",
            "Kamei nunta pap khou @&4 gulou khang;",
            "Manmei bumang guai ta phu dat khang,",
            "Bethlehem guai kai khou puan lou the,",
            "",
            "Chorus:",
            "Nangniu khang David kaidai khou tei,",
            "Guloumeipu poubaomei puan the,",
            "Kamei hei chu jangmei guang kiu e,",
            "Immanuel guang him dai kandiu.",
            "",
            "2. Raguang @&4 kandih mei ta jianlou na,",
            "Kanah npou khat namei ta tilou;",
            "Thoupuni kakhou lumloumei guai @&4,",
            "Tingsang ring suangmei lapuni.",
            "",
            "3. Poupei Eve le Adam kanei @&4,",
            "Nthiammei khou keilou puijang khou @&4;",
            "Theihmei hei meikin kathui nakhou,",
            "Pap @&4 guang tuna lung bam khuan ne.",
            "",
            "4. Pap @&4 guang tuna lung bammei guai,",
            "Jisu jan khou lumlou na lunglai tho;",
            "Asei hei nanglung khou Jisuta,",
            "Neila neihlana guang ti tu o."
          ]
        }
      }
