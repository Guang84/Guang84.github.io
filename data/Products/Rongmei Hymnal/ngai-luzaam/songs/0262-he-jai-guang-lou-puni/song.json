        "title": "He jai guang lou puni",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. He jai guang lou puni kanloumeipu ram khou,",
            "Tatri kanmei guaita ni kau han datro;",
            "Kagan thui jianmei nun ta thuan ku e,",
            "Njianmei nun guai guang kariu o.",
            "",
            "Chorus:",
            "He jianmei nun le guanga thuan no,",
            "Chunsi jangsi pui tuang kan khuansini;",
            "Kauh kanan ram tei juan ni the,",
            "He Jisu le bam cham ni the.",
            "",
            "2. He bumang nthanmei #@8na nduang lou o,",
            "Jangsimei #@8 muang jingmei kumma jing e;",
            "Hei kandih khou jianmei nun tammei hei,",
            "Njianmei nun bansin kariu ni.",
            "",
            "3. He champan thiu ntammei gan hei naguang the,",
            "He jaipat datro tingsang bam cham khang tei;",
            "Ata jai pat lou o jianmei nun le,",
            "He ntammei gan hei du khuan no.",
            "",
            "4. He njianmei nun ata kanglou bam khou #@8,",
            "Tat dukan the ai bampui ram gaimei tei;",
            "Pat lou tho jianmei nun kandih ram khou,",
            "Guang thuan pui ram khou #@8 riu dat ni."
          ]
        }
      }
