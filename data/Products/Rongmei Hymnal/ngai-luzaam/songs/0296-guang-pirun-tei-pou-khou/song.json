          "format": "source-lines",
          "lines": [
            "1. Guang pirun tei pou khou runlou tho,",
            "Guang khrista ta meikin guai thuan diu;",
            "Kajan aniu chakhuang champou ni,",
            "Taoni tingsangjang na.",
            "",
            "Chorus:",
            "Guang pirun tei niu run louni,",
            "Himdai dihthang kakhou run louni,",
            "Thuanni guangta thuanni,",
            "Thanpui khuan kau ranni.",
            "",
            "2. Thuan o pouta kauh banchra guai le,",
            "Kabampang hukhou nra jai o;",
            "He jat guai le neilana kauh o,",
            "Guang guai Guangta thuan o.",
            "",
            "3. Pap rih ngammei kaipou kamei e,",
            "Kabumang ({0 niu lung hei sindiu;",
            "Kajan pan({0 aniu rih ngamni,",
            "Tingsang khang run lou o."
          ]
        }
