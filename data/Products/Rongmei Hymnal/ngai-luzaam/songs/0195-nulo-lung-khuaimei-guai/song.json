        "content": {
          "format": "source-lines",
          "lines": [
            "1. Nulo, lung khuaimei guai",
            "Kandi maan nipui nung",
            "Kaguang dailiang mei tei",
            "Kabam peang khou bam e.",
            "",
            "Kei puni the Jisu Khrista [2]",
            "Kau thanmei aching-ching guaile",
            "",
            "2. Kandi kaphai kadung",
            "Kaothan mei diulou ni,",
            "Luang le dui khou teini",
            "Kaoguang kariu puni.",
            "",
            "Gaimei ringsuang mei ram khou tei [2]",
            "Taek makna neila bam puni.",
            "",
            "3. Pap phung mei guai tamu",
            "Maikuam khou lou puni,",
            "Kandi khou lou puni",
            "Kalat piumak mei mu.",
            "",
            "Rianra taekmak mei maikuam khou [2]",
            "Tingsaeng zaeng rianra bam puni."
          ]
        }
      }
