        "content": {
          "format": "source-lines",
          "lines": [
            "1. Poubaumei Khrista Guloumei,",
            "Thuanku dikho zaat guaina rui,",
            "Neihla gaina bam kariu khang,",
            "Kazauzian rui nduanghlou kandiu.",
            "",
            "Thuanku dikho Raguang ta aniu,",
            "Kamei rui nduanghlou khou rui,",
            "Ntam kanmei zianmei guai le,",
            "Neihlana aniu ariu dat the.",
            "",
            "2. Khrista zan khou zianmei guai le,",
            "Nangniu zau hou khang neihlana;",
            "Ariuna zau houpui bam khou,",
            "Thuanhpui lukhuan rui lungh neihla the.",
            "",
            "3. Hei tei kumna nkhamhpui nung,",
            "Kauh thanmei nun ta ariuna",
            "Kandihmei le tingkaomei guai,",
            "Kazanh thuanhpui lu suan ‘chamh puni.",
            "",
            "4. Tingkao ram khou guangtang pukhou",
            "Rianra zaengsimei nailak khe;",
            "Kapma latlumei nailak khe,",
            "Neihlamei rui aniu duan suni."
          ]
        }
      }
