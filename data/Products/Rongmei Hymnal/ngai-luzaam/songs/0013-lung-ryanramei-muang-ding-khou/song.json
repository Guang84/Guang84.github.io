        "content": {
          "format": "source-lines",
          "lines": [
            "1. Lung rianra mei muangding khou,",
            "Ai rui bam khuan e,",
            "Neihlamei neiriu tuaina,",
            "Timaan ni makge.",
            "",
            "He! Suaihiem lou o nang ta ning e,",
            "Aru khou gan guang o,",
            "Zingmei ri rui ata ding kham ma",
            "Tigan no tingsaeng ganpui riu,",
            "Neihlapui ram khou zaigut lou o.",
            "",
            "2. Adam tarou zing mei khou,",
            "Nang rui gan bam kun,",
            "Kalloumei nang zei paan rui,",
            "Nang ta ningtan mak.",
            "",
            "3. Kalang mei khuan rui padik,’",
            "Zaatguai na lung khou,",
            "He! Eden mei tuai pui tang,",
            "Ningmei rui thuai e.",
            "",
            "4. Theithu bumaeng kandih khou,",
            "Neihlaa pui kan khou,",
            "Rianramei kandi mun ta,",
            "Ningdat pulak khe."
          ]
        }
      }
