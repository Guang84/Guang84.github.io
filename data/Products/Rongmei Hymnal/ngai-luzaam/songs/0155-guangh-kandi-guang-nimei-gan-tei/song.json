        "content": {
          "format": "source-lines",
          "lines": [
            "1. Guangh kandi guang nimei gan tei,",
            "Tao hei guang tangpu the;",
            "Guangh puanhpui ram Bethlehem namdaih tei,",
            "Kandihmei kanlou khang.",
            "",
            "He! Nang Bethlehem ai rui ning liangmei e,",
            "Nang ruh khou gaanlou gaanphiu gaanhmei",
            "Kapma phu guang e ai ruina,",
            "Guangh puan pui namdaih gailiangmei khou.",
            "",
            "2. Nang bam lakna cho hei ram tei?",
            "Guangh thanh puanhpui ram tei;",
            "Caesar guang hak khou rianramei bang khou,",
            "Guangh rianra na kap e.",
            "",
            "3. Rianramei guai zaengsimei guai,",
            "Neihlatho Guangh Jisu,",
            "Puanpat lou the rianramei na guai khang",
            "Kanloumei Pu Jisu."
          ]
        }
      }
