        "content": {
          "format": "source-lines",
          "lines": [
            "1. Anuan guai hei kuaklou lana,",
            "Nbanthai na bam ni e;",
            "Alung khou hei Raguang Jisu,",
            "Nbanthai na bam ni e.",
            "",
            "Chorus:",
            "Nang bam ethei (2),",
            "Nbanthai na bam ni e;",
            "Alung khou he Raguang Jisu,",
            "Kagan thui bam duanglou o.",
            "",
            "2. Nangta ai#@8 champan khan lou,",
            "Nangta ai jai thao lou e;",
            "Kandih khou neilamei suang mu,",
            "Tingkauh neilamei gai e.",
            "",
            "3. Bang pui riang hei ri pat lou o,",
            "Abumang kan pat lou o;",
            "Jingmei khou hei bam sang lak khe,",
            "Neiriu kum tiganlou o."
          ]
        }
      }
