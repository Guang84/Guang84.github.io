        "title": "Ning e tam dat mak pui ram",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Ning e tamdat makpui ram,",
            "Ravguangc bampui ram tei,",
            "Neikeidat puni aniu hei ntam dat khang,",
            "Ai ning e tammak pui zionram tei.",
            "",
            "Ning e tingkao munpuang ram,",
            "Ntam makmei namdai,",
            "Poubaomei le ring mei thingbang ,",
            "Saronmun gai puang e.",
            "",
            "2. Tingkao Jerusalem gai,",
            "Ringhmei dui tei luang e,",
            "Mik rui hou makpui ram le",
            "Ringhmei thing bang khou,",
            "Salem kailuang lung khou zaigut lou o.",
            "",
            "3. Daimei raeng gaimei lung khou,",
            "Kau lauziu nun bame,",
            "Rian ra zing mei guay le kapmei naidat lak khe,",
            "Poubaomei rui zaigut lou ni khou tei.",
            "",
            "4. Daimei nam dai gaimei lat,",
            "Sa ngam ni tuang ram e,",
            "Poubaomei le nthanmei nun bampui ram tei,",
            "Poubaomei bampui zion ching gaimei."
          ]
        }
      }
    },
