        "content": {
          "format": "source-lines",
          "lines": [
            "1. He! Ning e kalvary ching khou,",
            "Kanlou mei Pu zei luang kei;",
            "Kandi paap nthandiu khang.",
            "",
            "Theihpui bam Kalvary ching rukhou,",
            "Poubaomei zaeng sina bam e tu e;",
            "Ninga zau nthiam mei muang zingbang khou.",
            "",
            "2. Nthiampui rih daihmei lung khou,",
            "Kandi rianrah mei rui padik;",
            "Ai guang tang ngam nina cho?",
            "",
            "3. Kazei ruina lou-nthan ni,",
            "Karam gai khou mbaan thaini;",
            "Tuai dat makpui mun suni.",
            "",
            "4. Gunh kumna mphuanpui bam khou,",
            "Abumaeng rui guang tang e thei;",
            "Ringhmei mun tei ai suni."
          ]
        }
      }
    },
