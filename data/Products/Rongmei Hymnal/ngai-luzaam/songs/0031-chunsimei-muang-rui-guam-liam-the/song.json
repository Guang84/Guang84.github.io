        "content": {
          "format": "source-lines",
          "lines": [
            "1. Chunsimei muang rui gumliam the,",
            "Hei kandih khou hei;",
            "Nzian liangmei champan thiu le",
            "Ntam puiganv guang the.",
            "",
            "He tamdat ni mak ge.] 2",
            "Zianmei champan thiu le,",
            "Tingkao bumaengthan diu lou o",
            "Tingmik thui duang lou khang .",
            "",
            "2. Kalan zingbang tei nai mak ge,",
            "Raguang thuan pui nung",
            "Ntam pui ganv tei guang datna",
            "Nzianmei mikdui kei.",
            "",
            "3. Alung hei neihlana nang ta,",
            "Ningbam kan ni the,",
            "Raguang rui zauzian mei lung khou",
            "Tingkao mei su cham ni.",
            "",
            "4. He! Bumaengthan nduang lou o",
            "Ntam puni the",
            "Nzianmei nun zaeng sibam khou,",
            "Saronmun gaanc guang o.",
            "",
            "5. Zaeng si rikho zianmei nun le,",
            "Ntam kan di kho.",
            "Abaanzat hei rui hamguang e,",
            "Zianmei guai le salam."
          ]
        }
      }
