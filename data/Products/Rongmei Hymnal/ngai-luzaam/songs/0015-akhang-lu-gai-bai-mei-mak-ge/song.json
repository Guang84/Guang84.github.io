        "content": {
          "format": "source-lines",
          "lines": [
            "1. Akhang lugai baimei mak ge,",
            "Hei kandi khou hei,",
            "Akhang khrista theilou mei tei,",
            "Lu gailiang mei e.",
            "",
            "He! Alu gailiang mei khrista kiu e,",
            "Nthiam khou le lung rianra khou,",
            "Arang khang le ngang pui tuang khang nang e.",
            "",
            "2. Kandih lu gaimei guai tei mu,",
            "Mun kum ma tuai e,",
            "Poubaomei thuan pui lu gaimei",
            "Tuaidat pulak khe.",
            "",
            "3. Rianra na kapbam khou tei ni",
            "Zian loumei nang.. e,",
            "Baimei ta ai ning khang makge,",
            "Khrista ta ham na.",
            "",
            "4. David khang ni raeng gaimei e,",
            "Poubaomei zianmei,",
            "Akhang ni nang raeng gaimei e,",
            "He! Poubaomei le."
          ]
        }
      }
    },
