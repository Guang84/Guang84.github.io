        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kanloumeipu zeitei luang kei,",
            "Apap guai khiu ‘than khang;",
            "Kapi ‘thanmei bumkei louna,",
            "Abumaeng kanlou the.",
            "",
            "Lauziu Na nzaenghmei,",
            "Kalvary khou khaenglou,",
            "Lauziu Na thei kanmei ring datmei tei,",
            "Ata kanlou mei e.",
            "",
            "2. Apaap geicmei nzianlouna,",
            "Kros ruh khou khaenglouna,",
            "Ngam makmei ata ‘zianlou the,",
            "Tingsaeng ringhmei la khang.",
            "",
            "3. Neihrui kalun zau ngam makna,",
            "Kariu tipat makge;",
            "Kamei rui apaap guai phunglou,",
            "Kros khou theipui kaan khou.",
            "",
            "4. Ai ni api bumkei lana,",
            "Pou’ rui theihmei kumna;",
            "Akhang khaeng loumei tei ning na,",
            "Pou’ ta ningtan lak khe.",
            "",
            "5. Amikdui hei luang keisini,",
            "Khaeng loumei rui nthuk;",
            "Apumh hei tipat ngam sini,",
            "Hei tei rui biu makge."
          ]
        }
      }
