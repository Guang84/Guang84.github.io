        "title": "Alung hei paap rui zingbam khou",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Alungh hei pap rui zing bam khou,",
            "Tingkao tuang lat dinlou o;",
            "Mun kumna puanga kathai-",
            "Nthaidiu khang ti su lou o,",
            "Ringhmei Guangh pirun la diu khang.",
            "",
            "He! Poubaomei Bumaeng diu kei o,",
            "Nang khang rui rim gaimei,",
            "Munpuang kum puang diu khang,",
            "Nang Guangh pirun tei la diu khang,",
            "Ai ningmei guang tanglou o.",
            "",
            "2. Kandih rianra zinghmei bam khou,",
            "Gaipui latcham phung guang o;",
            "Mun kumna puang diu khang le",
            "Nthaidiu khang tisu lou o,",
            "Kam makmei Guangh pirun lakhang.",
            "",
            "3. Poubaomei Bumaeng rui hamhma,",
            "Ningting ntaekmei makge;",
            "Gaichuimei neihlamei mun",
            "Alungh khou puangpat nimei tei,",
            "Seitan ri rui khamlou bam e.",
            "",
            "4. Poubaomei rui kaikham lanlou,",
            "Nzianmei taan hei tanh khang,",
            "Nthiam liangmei taan khou lum -",
            "Lou nuhmei taan taanhmei guai hei,",
            "Tingkauh thang laanv rilou tuang e."
          ]
        }
      }
    },
