        "content": {
          "format": "source-lines",
          "lines": [
            "1. Poubaumei kalum khang,",
            "Guang kariu bam khou hei;",
            "Nangjao kari nthei lou rio,",
            "Aniu nkhuai sini.",
            "",
            "2. Ai nkhuaimei guai,",
            "Nang hukhou phung guang e;",
            "Tiduaklou khang le khiu than khang,",
            "Nang khou njuan guang e.",
            "",
            "3. Aram khuai phu ngam mak,",
            "Ata ti than khang hei;",
            "Kumsini nang jaujian thaimei,",
            "Timan lou o nang ({0.",
            "",
            "4. Hei kumma neimei hei,",
            "Lalu o poubaumei;",
            "Kandih lungning guai timan o,",
            "Ti o lungning gaimei.",
            "",
            "5. Raguang ta kalummei guai,",
            "Suaihiam gaimei latou;",
            "Thei pukhou tingjkauh thang lungni,",
            "Tingkauh thanmei nun le."
          ]
        }
      }
