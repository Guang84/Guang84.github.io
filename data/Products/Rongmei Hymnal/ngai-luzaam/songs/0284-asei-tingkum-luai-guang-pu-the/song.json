        "content": {
          "format": "source-lines",
          "lines": [
            "1. Asei tingkum luai guang puthe,",
            "Kagan tatmei tan hei;",
            "Panti duimei tingkum luai the,",
            "Tammei gan hei dam lou.",
            "",
            "2. Kaipou kross khou nang ban tipat,",
            "Nangmei ta jai guang the;",
            "He niu jian khang kross ta,",
            "Nang banpa khou niu bam.",
            "",
            "3. Himdaimei sudiu kapu khou,",
            "Himdaimei sudiu Kanah khou;",
            "Himdaimei sudiu bumang thanmei khou,",
            "Ngan makmei tingkum khou."
          ]
        }
      }
