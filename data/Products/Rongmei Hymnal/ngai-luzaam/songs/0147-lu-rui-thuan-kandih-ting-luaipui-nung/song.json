        "content": {
          "format": "source-lines",
          "lines": [
            "1. Lu rui thuan kandih ting’ luaipui nung,",
            "Gundaih pui tingmik tanghpui nung;",
            "Chunsi zaengsi na kaap bammei,",
            "Rianra mei hei nailak khe Guangh hu khou.",
            "",
            "Ai houni kagan tanghpui nung,",
            "Kasap kathuih hiloumei muang sakanmei;",
            "Nang ramgai rui alungh ti-neihla lou.",
            "",
            "2. Eden zinghmei khou alauna kumna kap,",
            "Nang ramgai tei ai tang pukhou;",
            "Apap gunh khang suang mphuanni,",
            "AGuangh Immanuel ram gai khou tei.",
            "",
            "3. Nzianmei ram ta ai ram phanna bamni,",
            "Kaganv ‘thuih tyngthanv patpui ram;",
            "Bumaengh suanmei tigailou e,",
            "Alungh rianra mei tigailou datro."
          ]
        }
      }
