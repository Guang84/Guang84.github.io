        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kalungh rianra pui bam zau lo!",
            "Poubaomei nimhpui bam,",
            "Gethsemane pikuan lung khou,",
            "Talan zeihaeng rui luang.",
            "",
            "2. Simon Barzon bao liangmei Pu,",
            "Kathei lai ngam makge",
            "Kanloumeipu ta zai kan the,",
            "Amuh daihmei kaikhou.",
            "",
            "3. Sauh pirun le pheihang banna,",
            "Bui rui katumlouna,",
            "Thou cho baihmei hei sapat ro,",
            "Tuna akhou than e.",
            "",
            "4. He! Poubaomei rianra mei hei,",
            "Akhang khaeng lou tuang e,",
            "Nuan phunghmei nunni run kan mak,",
            "Nang Guangh pirun kummei."
          ]
        }
      }
