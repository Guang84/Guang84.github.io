        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kandih khou rianra mei guay hei,",
            "Thei thu tingsaeng gaipui ram khou;",
            "Kamei nzianmei hu khou tei,",
            "Poubaomei le bam chamhni the.",
            "",
            "Naidat lak khe ntammei hei,",
            "Lungh rianramei mikdui keimei,",
            "Kanloumei Pu Jisu ruina,",
            "Thutphui lou ni tuna sa e.",
            "",
            "2. Poubaomei rui kasiamh lou the,",
            "Neihlamei namdaih gaimei tei;",
            "Khou tei neihlamei namdaih tei,",
            "Tingsaengzaenga bam puni the.",
            "",
            "3. Zaulana Kalvary ching tei,",
            "Ai tat bammei lung nipui ram;",
            "Lauziu Na tei bam e,",
            "Katik kagunh daihmei ram khou.",
            "",
            "4. Neihlana tingkauh mei guay le,",
            "Kanlou mei guay kariu puni,",
            "Tingsaeng ringhmei tei la lana;",
            "Ntammei hei naidat lak khe.",
            "",
            "5. Kanloumei Pu zauzian khourui",
            "Katik gunh daihmei tei lana;",
            "Gaipui ram tei guang tanglana,",
            "Taek makna thuanku bam puni."
          ]
        }
      }
