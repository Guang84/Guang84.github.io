        "content": {
          "format": "source-lines",
          "lines": [
            "1. Himdai kandiu pou Jisu zan",
            "Kandi le tingkao khou",
            "Banchra nun Raguang kalummei",
            "Seitan pinga kadun",
            "",
            "Akhang ntang mak tuang makge",
            "Bai mei ta kahau mak",
            "Khrista akhang theimei biuthe",
            "Akhang rui thei tuange.",
            "",
            "2. Paap phungmei nun khang Khrista thei",
            "Gai makmei nunc phan thei",
            "Nuanh guayna khang lou ngam kan the",
            "Neihlaa mei tilyn the.",
            "",
            "3. Karam zian hei tithai lik o,",
            "Thuak patmei ndau o,",
            "Ai rui ranimei chamdin kiu",
            "Lauziuna pari e.",
            "",
            "4. Neihlaa na kazaan ndau ni",
            "Apanty naibam khou",
            "Mei guaina khou rah ndauni,",
            "Lauziuna pari hei."
          ]
        }
      }
    },
