        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kandi ruprian guai kariuna,",
            "Adi gaicho,",
            "Aniu neila nchammei hei",
            "Tuaidat nuang e.",
            "",
            "Alung makna achun suna,",
            "Zianmei nunta ntam sini,",
            "Kagan khat khou Khrista pan rui",
            "Ariu datni.",
            "",
            "2. Laokhuan tinggaan patmei kumna,",
            "Neila sini",
            "Neikhat sini tingzing makna,",
            "Tamdat nuang e.",
            "",
            "3. Kandi ruprian guai kariuna,",
            "Tu-zaang chammei,",
            "Neilamei hei munpuang kumna,",
            "Tuaidat nuang e.",
            "",
            "4. Kandi ruprian guai ntamna,",
            "Zaengsi rikho,",
            "Ariu dat khang tei machunna,",
            "Tam kan dikho."
          ]
        }
      }
