            "1. Ravguangc zan khou kariu khang tei ,",
            "Guang o mei nai mei guai ;",
            "Zauzian lou mei hei thuan ku kho,",
            "[ Neilapui khuan ruina ] 2",
            "",
            "2. Mei guai rih sukhang ping rikho,",
            "Nthiam pui ri tani,",
            "Aniu theimei ngan adou kho,",
            "Seitan ridai khou tei ] 2",
            "",
            "3. Arup nzianmei nun thiu le,",
            "Khat sini ping lou riu,",
            "Aniu pum hei ni bumaeng ni,",
            "Jisu rui gaklou ni.] 2",
            "",
            "4. Aniu rianra rianriu sini ,",
            "Tingkao ram lapuni",
            "Khou tei Ravguangc rui ti puni",
            "Tingkao guang pirun tei.] 2",
            "",
            "5. Hei zaeng khou rui kamthao dikho,",
            "Seitan ri adou khang",
            "Rih pi zaan saan na lusuan kho,",
            "Hozam teini kaona.] 2"
          ]
        }
