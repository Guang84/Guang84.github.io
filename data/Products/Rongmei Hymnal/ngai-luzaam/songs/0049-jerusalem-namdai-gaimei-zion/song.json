        "content": {
          "format": "source-lines",
          "lines": [
            "1. Jerusalem namdai gaimei zion,",
            "Martyr guai le tingkao than mei guai",
            "Nkhuai mei guai khrista pan khou rui.",
            "Bam puni e neikei dat mak pui ram khou,",
            "",
            "Halleluijah pou tikgun dai kan diu,",
            "Halleluijah amen , halleluijah ;",
            "Mei ti-nthan lou diu khang guang e",
            "He! Kaguang Immanuel Halleluijah.",
            "",
            "2. Thingru khou rui nthukpui jei luang kei,",
            "Jisu jei thukmei kalvary khou,",
            "Aniu ta kanlou khang luang kei lou",
            "He! Nthuk e, jisu jei halleluijah.",
            "",
            "3. Poubaomei ta ariu nimei nun tei,",
            "Gehem kai poubaomei jubilee.",
            "Alao nunrui thuanku poubaomei,",
            "Nang ta thuan ne nthuk liang mei hosanna.",
            "",
            "4. Jerusalem, Mesiah, guang dailiang mei.",
            "Herusalem khou guang dailiang mei ;",
            "Guang jan khou guang mei ta thuan ku e,",
            "Messiah ariuna kao e hosana."
          ]
        }
      }
