        "title": "Kajan tatmei kim dat lakkhe",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kajan tatmei kim dat lak khe,",
            "Pou +:1 kasiam loumei ram tei;",
            "Kalan jingbang nai dat lak khe,",
            "Zi-on namdai gaimei khou tei.",
            "",
            "Chorus:",
            "Tingkauh Jerusalem namdai,",
            "Ndap tarimei nai dat lak khe;",
            "Buh, neih ganchuanga +:1 nsa de,",
            "Laujiu nah +:1 gan e hei khou tei.",
            "",
            "2. Pou nang guangdih thanmei khou tei,",
            "Theimei sumei nai dat lak khe;",
            "Mikdui rouna ntammei hei,",
            "Nailak khe nang guagdih gai khoutei.",
            "",
            "3. Rianramei nban kanndih khou,",
            "Theimei khou +:1 kan khang tat bam;",
            "Ntammei rianra chunsimei,",
            "Nailak khe nang guangdih gai khou tei."
          ]
        }
      }
    },
