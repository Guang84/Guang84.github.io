        "content": {
          "format": "source-lines",
          "lines": [
            "1. Salem ram thang nzuan di kho,",
            "Huthang nzuan tat ro,",
            "He! Poubaomei ta ai phuna.",
            "",
            "He! Poubaomei tingsaeng",
            "Ringmei neihlamei,",
            "He! Tikei o, He! Apoubaomei",
            "Asei hei neihla khang.",
            "",
            "2. Kandi rianra ram tuan pukhou",
            "Lung gei mei nai lak khe;",
            "Kanloumei puta hou pukhou.",
            "",
            "3. Ai thuan bamni poubaomei ta,",
            "Pati ngana thuan ni;",
            "Noupoupu lun tei hou mak saan.",
            "",
            "4. Poubaomei ta ai thuan bam ni",
            "Suaihiam mei poubaomei,",
            "Nang baan rui ata zailou o."
          ]
        }
      }
    },
