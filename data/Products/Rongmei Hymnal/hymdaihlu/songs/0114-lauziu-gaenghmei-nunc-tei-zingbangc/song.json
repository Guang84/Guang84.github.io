        "content": {
          "format": "source-lines",
          "lines": [
            "1 Lauziu gaenghmei nunc 4^& zingbangc",
            "Lauziu ta ’khwan bam khou,",
            "Poubauhmei baanch’ra khat keyna",
            "Kaniw daeng tiigaanclou.",
            "",
            "2 \"Ping riu,\" Seraph 4^& @<4 saa e,",
            "Kaniw pingna bam khou;",
            "Neihlaa daihmei chamv ai phungc guang,",
            "Nangniw lev meic guay khang.",
            "",
            "3 “Nangniw khang David kaidai khou,",
            "David tuang zeiriang khou,",
            "Gumeipu, Kaipouc, Khrista kiu",
            "’Seic hei puanclou bam the!\"",
            "",
            "4 “Tingkauh Ngana ta how puni,",
            "Maansei guanhna puanhmei;",
            "Pheynuaihna @<4 kaduapclouna",
            "Kaikhuang khou ’ziloumei.\"",
            "",
            "5 Seraph 4^& @<4 saa tang pwkhou,",
            "Kauh baanch’ra kangdai @<4",
            "Ravguangc tikgunc daihmei thuancna,",
            "Zaenggaypui lu suan e.",
            "",
            "6 “Tingkauh thangc Ravguangc hym daic diu!",
            "Dih khou ’zaenghmei nai diu!",
            "Kauh lev dih khou gaymei chamv hei",
            "’Taw nic tingsaeng nai diu!"
          ]
        }
      }
