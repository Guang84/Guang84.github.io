        "content": {
          "format": "source-lines",
          "lines": [
            "1 Chuzaenghmei laatow khang, nang ramlum mbu khang,",
            "Lunghgutna, ranvna nang huayney the,",
            "’Ki nang zaengthaek lak ge,suaihiam sing laa tangc lak,",
            "Ramh guay ravchaapaeng khou kat mak saanv.",
            "",
            "Khaengmei ravchaapaeng khou ramh guay katlou the cho?",
            "Bumaengh {:1 nang lung ta sin tha?",
            "Nang chuzaengh zaengthaek- mei suaihiam laatow puni,",
            "Nang pumc, nang bumaengc katgut ti thei.",
            "",
            "2. Kaipouc lev tat ’chamcna Kalat riw khou lungcna,",
            "Chuzaenghmei, pianmei laa tow nii ’thei,",
            "Kachwn khou nang lungc o, siimei khou {:1 duak khang,",
            "Ravchaapaeng khou nang tuang guay kat ro.",
            "",
            "3 Aniu thay tangc zat lak, Pou {:1 taanclou nimei,",
            "’Niu {:1 suaihiam khang huayneymei khou,",
            "’Niu pumc, ’niu bumaengc hei",
            "Kamei {:1 sin mak saanv,",
            "Ravchaapaeng khou ramh guay kat mak saanv.",
            "",
            "4 ’Niu thay puni Kamei ’zianmei bun key nimei,",
            "’Niu lung kasyng neihlaa tangc nimei,",
            "Kahu khou ’niu kadam laa ’chamc nimei ramgai,",
            "’Niu tuang guay Kakhou katlou pwkhou."
          ]
        }
