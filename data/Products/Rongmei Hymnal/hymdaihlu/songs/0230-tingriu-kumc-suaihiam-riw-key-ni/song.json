        "content": {
          "format": "source-lines",
          "lines": [
            "1 “Tingriuc kumc suaihiam riu key ni,”",
            "Mi hei zauzian latryan e;",
            "Ramh guay tiikaluanlou puni,",
            "Gumeipu @{4 tii key ni.",
            "",
            "Suaihiam riu keymei,",
            "Suaihiam ting ta kahaw e;",
            "Zauzian ting thw riu key bam the,",
            "Suaihiam bun key khang huay e.",
            "",
            "2 “Tingriuc kumc suaihiam riu key ni,”",
            "Buan thanh dat khang riu nimei,",
            "Luangh guay lev nzaengc guay ruc khou",
            "Riu chunh chunna riu nimei.",
            "",
            "3 “Tingriuc kumc suaihiam riu key ni,”",
            "He Kaipouc tii keylou o!",
            "’Taw ’niw ta tiikaluanlou o;",
            "Nang latryan tii ’thuihlou o.",
            "",
            "4 “Tingriuc kumc suaihiam riu key ni,”",
            "Aseic tingmik riu key o,",
            "Ravguangc khou ’niw lunglai ’dauh e,",
            "’Taw hei Jisu ta kaw e."
          ]
        }
      },
