        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kariak latdanv khou ^&8 ai duak pat the,",
            "Jisu zei paan ^&8 ’taw thu kuaklou the,",
            "Latzan tuang syang lev paapc dandi guay,",
            "Zauzian ^&8 thuaklou, tingsaeng khang.",
            "",
            "He paapc mei, mi hei laa la tho,",
            "He chana, mi hei lwmlou la tho,",
            "Kros khou ngangvlou tho,",
            "puatrith duak khang,",
            "Khrista ^&8 thuaklou,tingsaeng khang.",
            "",
            "2 ’Taw mu ’niu duak the, tii’khuai dat lak khe,",
            "Jisu tiilou the ’thuihmei ringcbamv 8^&,",
            "Chu lo, kawmei khwan, “Akhou guang o,”",
            "Guang tho, Kamei ^&8 gulou diu.",
            "",
            "3 “Ravguangc nac nunc,”",
            "he hymdaihmei lwnlung!",
            "Kazauzian ^&8 ’niu bow mak khang gaeklou,",
            "Theih khou ^&8 ringhmei khou kaan pat the!",
            "Hymdaihmei ringcbamv, tingsaeng khang."
          ]
        }
      },
