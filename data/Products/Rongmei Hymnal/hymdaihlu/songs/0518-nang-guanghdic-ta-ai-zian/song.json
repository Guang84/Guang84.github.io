            "1 Nang Guangcdic ta ai zian",
            "He Ravguangc, Nang bamv ta;",
            "Kunghmei Thuakloumei pu zei @{4",
            "Guloumei phwamling ta;",
            "He Damhmei pu Ravguangc!",
            "Zian e, Nang phwamling ta,",
            "Nang @{4 kungc-kaziwmei phwam ta,",
            "Nang @{4 suangloumei ta.",
            "",
            "2 Phwamling khang amikdui",
            "Keyna huayneylou ni;",
            "Kakhang @{4 ai taanc-ruailou ni,",
            "Taanc-ruai nthaekc mak saanv;",
            "Karamgai khou bam ni,",
            "’Thukmei latryan ngaek ni;",
            "Katuang zianmei lu ai suan ni,",
            "Karamgai ta thuanc ni.",
            "",
            "3 He Jisu ’niu Kaipouc,",
            "Thuakloumei pu ’niw Guangh!",
            "Phah lev zauczihmei guay khou @{4",
            "Nang @{4 gaeklou puni;",
            "Nang tuang ’twnmei ’maan lak,",
            "Zion khou tiilou ni,",
            "Kandih khou hym daicliangmei lev",
            "Kauh thangc gay liangmei 4@<."
          ]
