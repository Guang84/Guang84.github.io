        "content": {
          "format": "source-lines",
          "lines": [
            "1. He ninge kalvari ching khou,",
            "Kanloumei pu jei luang kei e;",
            "Kandih pap nthan diu khang.",
            "",
            "Chorus:",
            "Theipui bam kalvari ching rukhou,",
            "Poubaumei jangsina bamme tu e;",
            "Ninga jao nthiammmei muang jingbang khou.",
            "",
            "2. Nthiammei rihdaimei lungkhou,",
            "Kandih rianramei rui padik;",
            "Ai guangtang ngam nicho?",
            "",
            "3. Kajei rui na lou nthanmei,",
            "Karam gai khou nban thai ni;",
            "Tuai dat makpui mun suni.",
            "",
            "4. Gun kumma nphuan pui bam khou,",
            "Abumang rui guang tang ethei;",
            "Ringmei mun 0({ ai suni."
          ]
        }
      }
    },
