        "content": {
          "format": "source-lines",
          "lines": [
            "1 He luanghbut khou rigaanvmei thiu,",
            "Jisu tingmik ’dauh o;",
            "Zauc lo kachaekc mairam bwang 5^&",
            "Duh thangc chuangc kauh bam the.",
            "",
            "Key the, Jisu key the,",
            "Tingkauh lauthwan key the,",
            "Key the, Jisu key the,",
            "’Rianhloumei ganv ’naa the,",
            "Key the, Jisu key the,",
            "Thuakloumei guay thuanc diu,",
            "Kariw ^&5 luangh tiikachan the;",
            "Meic guay thuanc o, Guangh ta!",
            "",
            "2 Zipriimei phwamling ta ’chyang tho,",
            "Thauna huayney kan diu;",
            "Tingkauh Nowpouc key nuangc puni,",
            "’Taw chaeng khou tat bam the.",
            "",
            "3 Meic guay thuanc o, Zion Guangc ta,",
            "Muh nunc saa kanmei 5^&;",
            "Baanch’ra thiu, Kata thuancku o,",
            "Kachaekc ’rac guay dow o."
          ]
        }
      },
