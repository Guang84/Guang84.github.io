        "content": {
          "format": "source-lines",
          "lines": [
            "1 Adih gay cho, he Gumeipu,",
            "Nang pamv khou zaengswmei!",
            "Ryanra ganv khou ’khavlou bammei,",
            "Nang pumtan ta thaymei!",
            "",
            "“Tigut ro, .. nang rianra Kakhou,",
            "Tigut ro, .. nang rianra Kakhou,",
            "Tigut ro, .. nang rianra Kakhou,",
            "Kamei nang ta kadanlou bam e.”",
            "",
            "2 Adwanman Nang khou tiiloumei,",
            "Nang ^&5 kahawmei e;",
            "Tamangvmei lev ryanrapui sik",
            "Nang khou tiithaylou e.",
            "",
            "3 Nang ramzian 5^& ai ^&5 lwm ni,",
            "Nang na ta zauc bam ni,",
            "Ryanrapui lung tii ’chulou khang",
            "Nang khou ai huayney e.",
            "",
            "4 Theidwan khang ^&5 kadan lana",
            "Lungh ryanra bam ni cho?",
            "’Bui khang lwm makna pingmei ^&5",
            "Alung padik ni cho?"
          ]
        }
