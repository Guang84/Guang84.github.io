        "language": "rongmei",
        "title": "Ata ringmei thingbang ti sulou o",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Ata ringmei thingbang ti sulou o,",
            "Duithuak pangkhou thaomei thingbang kumma;",
            "Kaman jangnga kabuan gaimei buan khang,",
            "Bumang tan thaimei nbu thao diukhang.",
            "",
            "Chorus:",
            "Suthan lou o aniu guai lungning hei,",
            "Timan lou o reinung lungning guaitei;",
            "Lungning gaimei kumma gaibam diukhang,",
            "Hei ram gaimei khoutei ai guang diukhang.",
            "",
            "2. Ring chang puni de rianra bam sini,",
            "Jisu limbang khou tei ringmei nai e;",
            "Raguang +:1 liu loumei bang thei datmak,",
            "Hei kandih kiu aman dat jat lak khe.",
            "",
            "3. Tingpui ma+:1na rianra bam sini,",
            "Raguang pirun runpui nungguang diukhang;",
            "Khou tei guang khang Jisu +:1 kao bam e,",
            "Nbanthaimei tingkauh khou guang diukhang."
          ]
        }
      },
