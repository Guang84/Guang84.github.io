      "rongmei": {
        "language": "rongmei",
        "title": "Alungsyng thangc ’seic zingbangc",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Alungsyng thangc ’seic zingbangc lu gaymei guang e;",
            "Lu khwan 5^& kida nuhmei lu maek;",
            "Kauh lu khwan kumhmei nuh gay khwan 5^& ^&5 phungc guang,",
            "Taek makna chuzaenghmei alung khou.",
            "",
            "Chuzaengh! Ch’rynmei chuzaengh!",
            "Pu ^&5 kauh thangc ^&5 tiikeymei hei!",
            "Ai huay e, tingsaengh alung khou bamlou o;",
            "Kasyng maekmei zauzian paan ^&5.",
            "",
            "2 Alungsyng khou nai bammei chuzaenghmei khou hei,",
            "Adihkamv ’thukmei lanv daih nai cho?",
            "Mi ti hei ramh baihmei ^&5 sw ’maan dat lak khe,",
            "Nganv makmei kaganv ^&5 tat bam khou.",
            "",
            "3 Ch’rynmei chuzaenghmei khou hei ai zaeng ’thaek bam e,",
            "Jisu ramgaeklou khou kwmlouna;",
            "Zingbangc kalaanv siimei khou ^&5ata gaeklou,",
            "Kahymdai ^&5 alung padiklou.",
            "",
            "4 Chuzaenghmei kaidai khou ai guang tanghpui nungc kiu,",
            "Kaipouc ta howna zaenggay ni the,",
            "Thuakloumei nunc ^&5 suan nimei lu pangc khou kiu,",
            "Heipui lu hei nic suan puni the."
          ]
        }
      },
