      "rongmei": {
        "language": "rongmei",
        "title": "Jisu kau bam the",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu niamh gayna nang ta kaw bam the,",
            "Aseic kaw e! aseic kaw e!",
            "Bui khang zianmei neicriw khou $%6 nang hei",
            "Duc hay hay tat bam tu cho?",
            "",
            "Aseic kaw e! .. aseic kaw e!",
            "Ji .. su kaw bam .. the!",
            "Niamh gayna aseic kaw bam the!",
            "",
            "2 Jisu kaw bam the ryanramei ’thaekc khang,",
            "Aseic kaw e! aseic kaw e!",
            "Kakhou nang puatrith phungc",
            "guangna ’thaekc tho:",
            "Nang ta ganc patlou lak ge.",
            "",
            "3 Jisu ’khwan bam the, ’taw Kakhou guang tho,",
            "Aseic ’khwan bam! aseic ’khwan bam!",
            "Guang tho, nang paap guay",
            "Kapamv khou lou tho,",
            "Guang ’khap tho, nyan la ri tho.",
            "",
            "4 Jisu huay bam the, Kakhwan nang ’king o,",
            "Aseic ’king o! Aseic ’king o!",
            "Kazanc khou lwmloumei neihlaa puni:",
            "Katumcna thauna guang tho!"
          ]
        }
      },
