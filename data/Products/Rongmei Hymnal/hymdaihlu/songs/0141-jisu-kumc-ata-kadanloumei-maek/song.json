          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu lam ai thaymei nang khou dinclou nii e,",
            "Kamei akhang tanhmei, ’chumhmei, Duangda e,",
            "Apanty tiikalaicloumei lam rac nii e,",
            "Baihmei ^&5 taanc ngam makmei Kamei taanclou.",
            "Jisu kumc ata kadanloumei maek,",
            "Kakumcna zianthaymei Duangda maek,",
            "Paapc lev zinghmei akhou ^&5 laa ganc ngammei maek,",
            "Ata adih kadan cho!",
            "",
            "2 Jisu ariw khou 5^& apaap padik khwan e,",
            "Alung khou ryanra zaengsii padik khwan e;",
            "Jisu zauzian baancpwam ^&5 ata pamclouna,",
            "Ai tat nipui chaeng khou ata zaylou e.",
            "",
            "3 Tingmik ’thuic latryan kathanc than akhou tiilou,",
            "Katuang zianmei latkaeng 5^& thay ’bu ku e;",
            "’Ki ata gulou khang guangmei thukh thay tangc lak,",
            "Kauh thangc Kazawpaanv gaymei ai how mak saanv."
          ]
        }
      },
