        "content": {
          "format": "source-lines",
          "lines": [
            "1 Chiwmei chaenglwan hamh e,",
            "Tingkauh ’zwanpui chaenglwan hei;",
            "Chaenglwan khou sauh-raengh ’peyna nai e,",
            "Chiwmei chaenglwan hamh e,",
            "’Ki Gumeipu tat ’duanghna",
            "Tingmik ’thuic ata tiineihlaalou.",
            "",
            "Hamh e, chiwmei chaenglwan hamh e, (2)",
            "’Ki Gumeipu tat ’duanghna",
            "Chaenglwan saanv tiigaanclou,",
            "Puat ’ritmei guay tii ’thaanloue.",
            "",
            "2 Chiwmei chaenglwan hamh e,",
            "Ryanra, tiangchanhmei nai e,",
            "Theic nuhpui bamv ’peyna ariw e;",
            "Jisu gaeklou bam e,",
            "’Niu ta sw kaguakh mak khang,",
            "Chaeng siimei guay kasiamh chuylou e.",
            "",
            "3 Aphay tat suc sihni,",
            "Apumc ryanra lak sihni,",
            "Alung kadanmei padik sihni,",
            "Gaymei tingmik ’naa the,",
            "Hymdaihmei kai tangc pwkhou,",
            "Tingsaeng chuzaenghna ’thaekc bam ni the."
          ]
        }
      },
