          "format": "source-lines",
          "lines": [
            "1 Ai @<4 meic lung tiikabiulou khwan ’thei,",
            "Ai @<4 chaeng zay maanvlou tuang nai khwan ’thei,",
            "Achwn khou na ai tat khwan ’thei, Ravguangc,",
            "Kuaklou na ro!",
            "",
            "2 Saa zi makpui lat ai saa maanv khwan ’thei,",
            "Ryanra akhaengv zihna ley tat khwan ’thei,",
            "Meic ta rairiu tuang nai khwan ’thei, Ravguangc,",
            "Kuaklou na ro!",
            "",
            "3 Ata rilin akhangv khang langlou khou,",
            "Ai lat piu mak, thouh sw mak bam khwan ’thei,",
            "Amanvpui bamv na phu khwan ’thei, Ravguangc,",
            "Kuaklou na ro!",
            "",
            "4 Saa ’dauh kanmei paap guay 4^& kuaklou o,",
            "Ai thay makmei apaap guay kuaklou o;",
            "He zaylou, zianlou, gaeklou o, Ravguangc,",
            "Amen! Amen!"
          ]
        }
