      "rongmei": {
        "language": "rongmei",
        "title": "Thuanc e, saengcdaic zanh tatmei nunc",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Thuanc e, saengcdaic zanh tatmei nunc,",
            "P’ry khou ractowmei nunc ta;",
            "Thuanc e, maansei khou Kahymdai",
            "Lyanloumei Poubauhmei ta.",
            "",
            "2 Thuanc e, ningting, tancbauhmei nunc,",
            "Kazaat ta zianmei nunc ta;",
            "’Zihmei khang baucna dingmei nunc,",
            "’Niu zaat lingc thaumei nunc ta.",
            "",
            "3 Thuanc e, kalung daihmei nunc ta,",
            "Ruak gayna lu suanmei nunc,",
            "Chariupwan kumhmei lu khwan @{4",
            "Meic lung tiithaumei nunc ta.",
            "",
            "4 Thuanc e, lungning chuzaenghmei nunc,",
            "Tampy duancloumei nunc ta;",
            "Thyamra gayna taancloumei nunc,",
            "Thouh thay khang ’chamloumei ta.",
            "",
            "5 Hei zaeng thuanc e, meic daihmei nunc",
            "P’ry khou zanh naimei nunc ta;",
            "Thuanc e, maansei khou Kahymdai",
            "Lyanloumei Poubauhmei ta."
          ]
        }
      },
