        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang ta Ravguangc }?2 ’duanghlou pwdiu!",
            "Katuang latdyn }?2 zaylou diu,",
            "Kalauziu pangc khou gaengclou diu,",
            "’Riw dat mak saanv Ravguangc ’duanghlou diu!",
            "",
            "’Riw mak saanv, ..’riw mak saanv,",
            "’Riw mak saanv,Jisu pamv khou;",
            "Riw mak saanv, .. ’riw mak saanv,",
            "’Riw dat mak saanv Ravguangc ’duanghlou diu!",
            "",
            "2 Nang ta Ravguangc }?2 ’duanghlou pwdiu!",
            "Kaswkaeng khou nkamhlou diu,",
            "Tingmik ’thuic manna tiilou diu,",
            "’Riw dat mak saanv Ravguangc ’duanghlou diu!",
            "",
            "3 Nang ta Ravguangc }?2 ’duanghlou pwdiu!",
            "Theih chaengkhaek }?2 zyn guang pwkhou,",
            "Zianthaymei baanc }?2 pamclou diu,",
            "’Riw dat mak saanv Ravguangc ’duanghlou diu!",
            "",
            "4 Nang ta Ravguangc }?2 ’duanghlou pwdiu!",
            "Nang ruc khou zianmei chuangh daanc diu,",
            "Theihmei duiluat ta tii’maan diu,",
            "’Riw dat mak saanv Ravguangc ’duanghlou diu!"
          ]
        }
