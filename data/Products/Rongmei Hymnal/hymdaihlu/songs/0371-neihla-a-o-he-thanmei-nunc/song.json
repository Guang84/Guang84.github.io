        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neihlaa o, ’thanmei nunc,",
            "Thuanckuna lu suan o,",
            "Neihlaa chuangcphey kazit bam the,",
            "Guangh Khrista tuang kros 1<~!",
            "",
            "Neihlaa! Neihlaa!",
            "Thuanckuna lu suan o!",
            "",
            "2 Alauc nic gaanthauh nic,",
            "Chabwan-chanu guay nic,",
            "Kauc ranvna neihlaa lu suan o,",
            "Ravguangc taanv ta thuancna.",
            "",
            "3 Kauh baanch’ra choir guay lev",
            "Dih khou ’thanmei nunc lev,",
            "Neihlaa zaenggay lu hei kauc o,",
            "Chwn gay liangmei khwan <~1.",
            "",
            "4 Panty chaenglwan khou hei",
            "Zingbangc kalaanv suan o,",
            "Chabwan khou <~1 thian keypui nganv,",
            "Ryanra, neihlaa ganv ’thuic.",
            "",
            "5 Chuanghphey zay kauh ranv o,",
            "Rihpwan piu katyn o,",
            "Rihphyan nunc zingh khou ’dow kumcna,",
            "Kachaekc zuk guang mak saanv."
          ]
        }
      },
