    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Duh thangc Ravguangc ta thay",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Duh thangc Ravguangc ta thay makmei nunc bamv khou,",
            "Meic aching-akha ’maan nina bam the;",
            "Thow thow tat ni, ringhbamv",
            "chamv dinclou tat khang,",
            "Jisu ta zaucna kakhang ning makna?",
            "",
            "“Ngamv kapwm Akhou tiilou the!",
            "Ngamv kapwm Akhou tiilou the!",
            "Kandih pwm khou tatna",
            "Gaychamv hei dinclou o,",
            "Zauclo, Ai taek mak ’duanghlou ni.”",
            "",
            "2 Kaikhamv laancna kabamv ’thuic kabai bam the:",
            "Khristian ricphyan thau tho, dinh khang tat tho!",
            "He khristian guay, thau tho, lungh khat sw lana,",
            "Gaychamv dinc tatna paapc riang sw taek go!",
            "",
            "3 “’Bui khang theic ni?” Ravguangc ^&8 kawna bam e,",
            "“ ’Bui khang theic ni?” rac kaluaihna tat ro,",
            "Jisu theiclou, theihmei khou ^&8 tiiringh khang,",
            "Ringhmei lev ringhbamv chamv ndauh tat ro.",
            "",
            "4 “ Ravguangc hymdaic diu,” zaatc’ kathuic suan nimei",
            "Tingmik 8^& Ravguangc ^&8 tiiguang zaic diu;",
            "Hei nungc kiu ringhbamv zaeng neihlaana kauc ni:",
            "“Hallelujah! Jisu hei Guangh kiu the!”"
          ]
        }
      },
