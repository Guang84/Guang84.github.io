        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kapmei ^&8 kanlou mak!",
            "Azaw mikdui phiangc sihni,",
            "Pingmei guay tii ’maan ngam mak,",
            "Paapc guay 8^& khiu ’than ngam mak,",
            "Kapmei ^&8 kanlou mak!",
            "",
            "Jisu kros khou akhaengvlou;",
            "Akhang ^&8 kapna theiclou;",
            "Jisu ’khwan bam tiiduak khang;",
            "Jisu na kan ngam e!",
            "",
            "2 Taanv ^&8 kanlou ngam mak!",
            "Gay liangmei taanv taanc sihni,",
            "’Than liangmei chwn ning sihni,",
            "Bumaengh tiikathanc ngam mak;",
            "Taanv ^&8 kanlou ngam mak!",
            "",
            "3 ’Khwanmei ^&8 kanlou mak!",
            "’Khuaina ngam makna bam khou;",
            "Zian thaymeipu khwan chu e;",
            "’Khwan bam ethei, theic ni the;",
            "’Khwanmei ^&8 kanlou mak!",
            "",
            "4 Lwmmei ^&8 kanlou ngam!",
            "Khrista khou tiilwmlou o,",
            "Kataanv khou tiilwmlou o;",
            "Kapamv khou zay guanglou o;",
            "Lwmmei ^&8 kanlou ngam!"
          ]
        }
