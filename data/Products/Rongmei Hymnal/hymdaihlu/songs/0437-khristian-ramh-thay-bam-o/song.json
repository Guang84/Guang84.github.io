        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Khristian ramh thay bam o, siimei’naa bam!",
            "Nang tatloupui bamv kathuic ramhthay o;",
            "’Paeng thangc phah nai, kalungc khou ’thiammei nai,",
            "Nang ta paapc khou tii key dat khang phu bam.",
            "",
            "Khristian ramhthay bam o: (3)",
            "Siimei ’naa bam!",
            "",
            "2 Khristian neihlaa bam o, pwanzingh ganv khou,",
            "Ting-pwanzingh #^5 tingpuk zingc bam sihni,",
            "Muangh zinghmei, ting-pwanzingh ’maan nuangc kan ni;",
            "Khou 5#^ nang Poubauhmei lev zaeng ’thaekc ni.",
            "",
            "Khristian neihlaa bam o: (3)",
            "Pwanzingh ganv khou.",
            "",
            "3 Khristian huayney bam o, bow key mak khang,",
            "Nang Poubauhmei ta kaw khang ’muc mak ’thei;",
            "Kaganv ’thuic huayneymei ’muc mak ethei;",
            "Nang ta gaeklou puni kaganv kathuic.",
            "",
            "Khristian huayney bam o: (3)",
            "Bow key mak khang.",
            "",
            "4 Khistian lwmgay bam o, nang’thaekc puni,",
            "Ryanramei guay rungh ’thaekc bamv tangc pwkhou;",
            "Latzanpouc #^5 swan tii khou saa puni:",
            "“Nang Poubauhmei neihlaamei khou gut tho!”",
            "",
            "Khristian lwmgay bam o: (3)",
            "Nang ’thaekc puni."
          ]
        }
      }
