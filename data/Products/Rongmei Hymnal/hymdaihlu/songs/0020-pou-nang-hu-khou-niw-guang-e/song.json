        "content": {
          "format": "source-lines",
          "lines": [
            "1 Pou, Nang hu khou ’niw guang e,",
            "Nang phaypav khou ’bum key e;",
            "’Niw huaymei malaalou rio,",
            "’Niw huath maek khang swlou rio.",
            "’Niw huath maek khang swlou rio.",
            "",
            "2 Pou, Nang khou ’niw ngangvlou e;",
            "Kadanlouna keylou o;",
            "Nang zauzian padiklou o,",
            "’Niw chy #<8 Nang ta thuanh khang.",
            "’Niw chy #<8 Nang ta thuanh khang.",
            "",
            "3 Nang #<8 nuhloumei thiak khou",
            "’Niw kaduaina ’khwan bam e;",
            "Pou, Nang suaihiamlou mak saanv",
            "’Niw tatpat dat ngam lak ge.",
            "’Niw tatpat dat ngam lak ge.",
            "",
            "4 Nang ta phumei kathuic #<8",
            "Phutow ngam khang ’khavlou o;",
            "Tiigaylou, tiiduaklou o,",
            "’Niw Nang khou neihlaa ngam khang.",
            "’Niw Nang khou neihlaa ngam khang.",
            "Amen."
          ]
        }
      },
