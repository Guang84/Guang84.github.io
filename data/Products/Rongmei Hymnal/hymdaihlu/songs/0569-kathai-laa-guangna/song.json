        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zauzian thw nrou o, nrou o, lauthwan zingh,",
            "Nrou o, kalaanv, tingzyn, kaganv ’thuic khou;",
            "Taypui ganv ta ’khwanna, kathai",
            "laa khang ’khwanna,",
            "Aniu neihlaa puni, kathai laa guangna!",
            "",
            "Kathai laa guangna!",
            "kathai laa guangna!",
            "Aniu neihlaa puni,",
            "kathai laa guangna!",
            "Kathai laa guangna!",
            "kathai laa guangna!",
            "Aniu neihlaa puni,",
            "kathai laa guangna!",
            "",
            "2 Neihriw khou nrou o, neih liampui bamv khou nic,",
            "Muangh zinghmei ping maekna, tingsei ping makna,",
            "Lau tay luai guang pwkhou,",
            "’niu taanv guay ’thaekc pwkhou,",
            "Aniu neihlaa puni, kathai laa guangna!",
            "",
            "3 Kum ’thei tat tho, kapna nrou o, Kaipouc khang,",
            "’Maanmei nunc khang aniu zaengsii bam sihni,",
            "Aniu kap tang pwkhou, Kamei riulou puni,",
            "Aniu neihlaa puni, kathai laa guangna!"
          ]
        }
