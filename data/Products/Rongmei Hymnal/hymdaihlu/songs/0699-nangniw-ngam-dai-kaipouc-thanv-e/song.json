      "rongmei": {
        "language": "rongmei",
        "title": "Nangniw ngam dai ? Kaipouc thanv e",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 “Nangniw ngam dai?” Kaipouc thanv e,",
            "“Ai lev thaengcluai ’chamc diw cho?”",
            "“N-guai,” twna ziap nunc daw e,",
            "“Theihpui nganv Nang thei lay ni.”",
            "",
            "“Kaipouc, ’niw ngam e,” ’niw hei Nang tuang de;",
            "Nang ta luihmei khou duanc chuylou tho;",
            "Nang zawpaanv riw ^&5 ’niw ta zaylou o,",
            "Baucna, biangpiuna Ravguangc khang lungc diu khang.",
            "",
            "2 “Nangniw ngam dai?” ningtow dai cho,",
            "Kaihouhmeipu ^&5 huay khou,",
            "Kuakloumei kamei laa towna",
            "Paradais thangc tat kanmei?",
            "",
            "3 “Nang nic ngam dai?” zinghmei lym ^&5",
            "Nang daeng zingc guang pw sihni,",
            "Ravguangc khou na nang ngangvlouna",
            "Nang panty katpat diw cho?",
            "",
            "4 “Nangniw ngam dai?”",
            "Kaipouc ’taw nganv",
            "Tingsaengzaeng thanvna bam e;",
            "Galili khou kumc ’seic nganvna",
            "Dihmei nunc ^&5 daw bam e:"
          ]
        }
      },
