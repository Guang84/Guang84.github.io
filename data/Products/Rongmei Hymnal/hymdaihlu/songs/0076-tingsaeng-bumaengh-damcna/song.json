            "1 Tingsaengzaeng Bumaengc, tingsaeng damcna bam e,",
            "Tingpuk tintou Nang lunghpui bamv ’thuic khou,",
            "Nang ningmei 6$% zuanh makna tat key bam e,",
            "Nang hym gaanhmei lauthwan gaanchuangc $%6 suan;",
            "’Ki kandih hei ramswng khou ’khwanna bam e,",
            "Maansei lung khou zinghmei $%6 padikna.",
            "",
            "2 He Ravguangc tuang padikmei lungcloumeipu,",
            "Ringhmei duipuak kalungc khou naimeipu;",
            "Katuang tiiringhmei Bumaengc $%6 dinclou e,",
            "Theihmei lev paapc ta meic nunc rih ngam khang,",
            "’Niw bumaengc hei Nang bamna khiu ’thanlou o,",
            "’Chumhmei $%6 ngam khang ’dow khou ’khavlou o.",
            "",
            "3 Kachwn chwn baicna agi bammei chung khou,",
            "Agay ’gimei, sucnumei zingbangc khou,",
            "Nang tuang zianmei pheychuan $%6 gum binlou o,",
            "Dwangdangvmei khang kaniw chaeng lyanlou tio,",
            "Bauhmei nunc ta Nang chwn khou tiibamlou o,",
            "Meic guay dwan khang gay khang phumei nunc ta.",
            "",
            "4 He meic guay khang gay khang ngangvlou bammeipu,",
            "Kahunungc $%6 Nang mei nunc ngangvpui bamv,",
            "Katuang suaihiam tingriu kumc bun keymeipu,",
            "Tingmik kathuic zikdui kumc chaenghringc e,",
            "’Niw bumaengc ta kachaengc tiiringclou dat ro,",
            "Pumtan thanh khou ’niw chaenglwan tat ngam khang."
          ]
        }
