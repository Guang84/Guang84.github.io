        "content": {
          "format": "source-lines",
          "lines": [
            "1 He baanch’rathiu, tingkauh thangc rui",
            "Kandih khou hei samc key o;",
            "Kandih damh khou lu suanmei thiu,",
            "Messiah puanhmei dinc o.",
            "",
            "Guang kalum o, guang kalum o,",
            "Khrista Ngasatna Guangc ta.",
            "",
            "2 Lauziu gaenghmei thiu, laupuk khou,",
            "Zingbangc thangc ’khwan bammei thiu,",
            "Meic nunc lev Ravguangc lungc ’chamc the,",
            "Ngasatna riw gaanc bam the.",
            "",
            "3 Pukit thiule, makumh ’thaekc tho,",
            "Duh thangc gaanhmei riw how the;",
            "Zaatc guay tuang machunc ta phu tho,",
            "Katuang gaanchuangcna how the.",
            "",
            "4 He ’thanmei thiu, ravcha hu khou",
            "Machunhna ’khwan bammei thiu,",
            "Thay mak daekna Poubauhmei kiu",
            "Karavkai khou gut puni!"
          ]
        }
      },
