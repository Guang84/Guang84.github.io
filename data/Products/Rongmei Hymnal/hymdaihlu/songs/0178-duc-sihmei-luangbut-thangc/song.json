        "language": "rongmei",
        "title": "Duc sihmei luangbut thangc",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Duc sihmei luanghbut thangc kros raan khat nai khwan e,",
            "Khrista ramrianra madanh tuang e;",
            "Ai zian e, mi kros 6_> kungc liang gay liangmei pu,",
            "Paapcmei nunc zaeng khang khou 6_> theiclou.",
            "",
            "Kros raan ta 6_> ai kungcna sw ni,",
            "Kahu khou aswan katlou mak saanv;",
            "Kros raan ta 6_> ai ’thukna sw ni,",
            "Neih khat Guangh pyrun lev akhiak ni.",
            "",
            "2 Dihmei _>6 malaana sw kanmei he kros raan,",
            "Akhang mu nang hei adih gay cho!",
            "Ravguangc Lauziu Nac 6_> kauh hym guay ganclouna,",
            "’Khaengvlou the zinghmei kalvari khou.",
            "",
            "3 Ravguangc zei ’zukloumei kunghmei kros raan khou 6_>,",
            "Ch’rynpui ramgai gaymei ai how e;",
            "Hei kros khou 6_> Jisu ryanra ’khaengvna theiclou,",
            "Ata kuaklou khang, sw ’thanlou khang.",
            "",
            "4 Hei kros raan lam khou 6_> zawsiimei akhaengv ni,",
            "Kaganv ’thuic hei khang ’twnna lungc ni;",
            "Duh thangc kai khou lungh khang Kamei _>6 kaw guang nungc,",
            "Kahym dai 6_> tingsaeng laa ’chamc ni."
          ]
        }
      },
