    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Ravguangc rui zaylou khang nuh",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc ^&8 zaylou khang nuhlouna,",
            "Kakhou na nang machunh ti thei",
            "Kamei nang khang pumtan tii puni,",
            "Siimei ganv khou pamclou puni,",
            "Ravguangc zianmei khou ngangvloumei",
            "Taudaic ruc khou kai swmei e.",
            "",
            "2 Reih rei bam o, Kata ’khwan bam o,",
            "Machunhmei khou neihlaa bam o,",
            "Pu ^&8 tiiguangmei guay nuhlou o,",
            "Zianpui zaeng ^&8 tiiguangmei guay;",
            "Kage nai liangmei ta thay e,",
            "’Niu ta Kapahloumei pu ^&8.",
            "",
            "3 Suan o, huay o, Kachaeng khou tat ro,",
            "Nang taanv guay khou biuhmei sw o,",
            "Kalat lwm o, nang biuh mak sihni,",
            "Mi hei nang khang guang tangc puni;",
            "Ravguangc ^&8 ganc ’rulou lak ge,",
            "Kakhou ngangvloumei bumaengc ta."
          ]
        }
      },
