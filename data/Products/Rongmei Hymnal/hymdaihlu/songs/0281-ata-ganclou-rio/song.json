        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ata ganclou rio, Gumeipu, Chulou o, huaymei;",
            "Nang meic baihmei ta kaw khou hei",
            "Ata ganclou rio.",
            "Guloumeipu, chulou o,huaymei,",
            "Nang meic baihmei ta kaw khou hei",
            "Ata ganclou rio!",
            "",
            "2 Nang zauzian guangc bamvpaeng khou <~1",
            "Ata zianlou o;",
            "Lungh kabiuna khuksun bam e,",
            "Ata ’khavlou o.",
            "",
            "3 Nang tuang taanv khou na ai lwmna,",
            "Ai guang e, Nang khou;",
            "Bakmei bumaengc tiigaylou o,",
            "Gulou o, zianna.",
            "",
            "4 Neihlaamei duipuakkai Nang e,",
            "Dih neilaa suangc e;",
            "Kandih, tingkauh khou Nang kumhmei",
            "Meic baihmei maek ge."
          ]
        }
