        "content": {
          "format": "source-lines",
          "lines": [
            "1. Nthukpui tingmik tang nithe,",
            "Nkhuanmei Immanuel;",
            "Pap le seitan man puinung rui,",
            "Kanloumei guai rui guang bam kariu ni.",
            "",
            "Chorus:",
            "Hei kumpui kan khou neilana suanni,",
            "Pourui damloumei tingsang gaipui ram akhang;",
            "He adi gai nicho, he adi gai nicho?",
            "Neilamei nai tan dat pulak khe.",
            "",
            "2. Tabui nung nicho poubaumei ?",
            "Gaipui tingmik 0({ hou khang;",
            "Jordan dui 0({ kanpat pukhou,",
            "Akhang tingkauh ganchuanga kum ganni.",
            "",
            "3. Kum kandiu tingsang poubaumei,",
            "Nangjei rui kanloumei guai;",
            "Nangjei rui liu loumei guai 0({,",
            "Akhou guango tuna salou mei 0({.",
            "",
            "4. He namthan daimei gai dinge,",
            "Damloumei namthan gaimei;",
            "Ngammei luthan gaimei guai 0({,",
            "Kandih hei luai puinung ai rui suanni."
          ]
        }
      }
    },
