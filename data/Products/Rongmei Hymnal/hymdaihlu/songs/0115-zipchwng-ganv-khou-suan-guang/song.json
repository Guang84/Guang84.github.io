        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zipchwng ganv khou suan guang khwan e,",
            "Hymdaihmei lu khwan 3)^;",
            "Baanch’ra nunc )}3 kandih ruc khou",
            "Kachaekc ’rac dow khwan e:",
            "Kandih khou chuzaenghmei nai diu,",
            "Gaymei lung padik diu;",
            "Kandih hei rimh rim bam khwan e,",
            "Baanch’ra nunc lu suanc khou.",
            "",
            "2 ’Taw nic chuzaenghmei sw ’lamvna",
            "Kauh baanch’ra nunc key e,",
            "Tingkauh lu 3)^ kagaengv bam e;",
            "Lakmei kandih ruc khou,",
            "Kaniw sw 3)^ kalaepc bam e,",
            "Ryanra nzaengc ruc khou,",
            "Kandih ruc khou lu suan bam e,",
            "Tingkauh baanch’ra nunc )}3.",
            "",
            "3 Ryanra lakmei kandih mei thiu,",
            "Puatrith phungc bam mei thiu,",
            "Chaengngaengv sii khou kaamcku lakna",
            "Nzaekcna bam mei thiu,",
            "Zauc lo, neihlaa zaenggaypui ganv",
            "Katumcna guang pw the;",
            "Chaeng daeng khou dungc keyn ’thaekcna",
            "Baanch’ra lu 3)^ ’king o.",
            "",
            "4 Zauc lo, tingmik 3)^ guang pw the,",
            "Muhzwng )}3 saamei 3)^,",
            "Kachaekc zuk kiu phungc guang pw the,",
            "",
            "Tat bammei tingkwm )}3;",
            "Chuzaenghmei )}3 kandih lik ni,",
            "Gaymei )}3 padik ni,",
            "Khou kiu kandih )}3 suan ’daw ni:",
            "Baanch’ra ’taw suanmei lu."
          ]
        }
