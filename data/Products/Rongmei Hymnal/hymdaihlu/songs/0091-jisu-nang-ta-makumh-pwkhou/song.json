    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Jisu Nang ta makumh pwkhou",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu, Nang ta makumh pwkhou,",
            "Lungh neihlaa padik ge;",
            "Nang zaw howmei gay ranv diangc e,",
            "Nang hu khou zaeng swmei.",
            "",
            "2 Khwan lev lung ^&8 suan tangc thuih lak,",
            "Makumh pat thuih lak e,",
            "Nang zanc suangc nuh gay dianghmei khwan,",
            "He Guloumeipule!",
            "",
            "3 He lungh bakmei khang machunhmei!",
            "He niamhmei nunc neihlaa!",
            "Bowmei ta Nang adih zianlou!",
            "Phumei khang suaihiam lou.",
            "",
            "4 Phutowmei nunc khang mu Nang hei",
            "Ch’rynmei suaihiam kiu e!",
            "Jisu ramzian tuang thukh hei mu",
            "Kamei nunc na thay e.",
            "",
            "5 Jisu, Nang na de ’niw neihlaa,",
            "Nang aniw thuanh sw diu!",
            "Nang hei aniw hymdaih sw diu!",
            "’Taw nic, tingsaengzaengna."
          ]
        }
      },
