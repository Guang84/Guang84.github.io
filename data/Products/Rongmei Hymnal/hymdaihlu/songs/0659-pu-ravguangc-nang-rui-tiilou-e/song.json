        "content": {
          "format": "source-lines",
          "lines": [
            "1 Pu Ravguangc, Nang <~1 tiilou e,",
            "’Thuihmei zianmei meic guayna",
            "khang;",
            "’Niw thuancku e, aniw guay khang,",
            "Heizumei suaihiam tiimei khang.",
            "",
            "2 Kaikhunh suaihiam khang",
            "thuancku e,",
            "Pui ramzian lev pu ramkadan,",
            "Ruprian nunc lev ’chamloumei nunc,",
            "’Niw lev puatrith phungc",
            "’chamcmei khang.",
            "",
            "3 How khang ’niw mik, chu khang nukuanc,",
            "’Khavlou khang baanhpwam",
            "tiiloumei,",
            "Puatrith phungh khang boukhuak tanhmei,",
            "Phay-baanh ’thuihmei khang",
            "thuancku e.",
            "",
            "4 Pingmei ta ngammei ramlum khang,",
            "Zianthaymei lung tiiloumei khang,",
            "Taanh khang pumtan, bauhmei",
            "lung khang,",
            "Ramh guay Kaipouc, Nang ta thuanc e.",
            "",
            "John H.Holmes"
          ]
        }
      },
