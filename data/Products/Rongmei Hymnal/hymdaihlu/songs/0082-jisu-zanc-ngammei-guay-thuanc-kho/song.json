        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu zanc ngamv meic guay thuanc kho!",
            "Baanch’ra nic kalum diu;",
            "Guangh pyrun 0({ laa thau lana,",
            "Runlou kho, Kaipouc khou! (2)",
            "",
            "2 He Ravguangc tuang martair nuncle,",
            "Kaipouc khou runlou o;",
            "Jessi kikta ta thuancku o,",
            "Runlou kho, Kaipouc khou! (2)",
            "",
            "3 Kapah patmei Israel mei zaat,",
            "Nang hei ’thyam khwan sihni",
            "Thuanc o, nang ta Gumeipu ta,",
            "Runlou kho, Kaipouc khou! (2)",
            "",
            "4 Zaatc kaguay, khwang kaguayna ({0,",
            "Kandih khou bam saanv khou,",
            "Poubauhmei hym hei ndauh diu,",
            "Runlou kho, Kaipouc khou! (2)",
            "",
            "5 Kauh thangc ’thanmei kangdai guay lev,",
            "Kaphay khou kalum ni,",
            "Nganv makna lu suan kariu ni,",
            "Runlou kho, Kaipouc khou! (2)"
          ]
        }
