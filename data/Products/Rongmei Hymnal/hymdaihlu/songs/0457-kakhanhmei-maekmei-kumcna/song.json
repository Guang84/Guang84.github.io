          "format": "source-lines",
          "lines": [
            "1 Kakhanhmei maekmei kumcna",
            "’Niu baanc zay thau mak ge;",
            "Machunhmei maekmeipu kumcna",
            "Theih khang na lwm mak ge;",
            "’Niu lwmmei hei egal ruay kumc",
            "Neihmik biak zauc ku ni,",
            "Neihlaana Nang khou kauc ku e,",
            "Pou, Nang ningmei sw diu!",
            "",
            "2 Kheih siimei )}3 meic guay ta",
            "Katuan bin guang pwkhou,",
            "Kaniw phay bangc khou ’bum key khang",
            "Nang )}3 laengvlou mak ge,",
            "Nang zanc khou ’niw ngamv",
            "sin thay ni,",
            "Baantan lev latkaeng )}3;",
            "Meic guay lungpuam ding khou kaniw",
            "Nang Lat chamv thay kan diu.",
            "",
            "3 ’Suanmei khang pumtan tii Pouc,",
            "Tanhmei ta tii ’twnlou;",
            "Duaihmei lat maek, ney tumei maek,",
            "Gaypui lwn swmei maek;",
            "Tingpuk bangc khou maansei khat )}3",
            "Khat ta rai bammei ta,",
            "He Pou, Nang baanc ngamv lyanlou o,",
            "Nang ningmei 3)^ sw diu!"
          ]
