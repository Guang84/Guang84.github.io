        "content": {
          "format": "source-lines",
          "lines": [
            "1. Khristianmei guai janggai,",
            "Lungning le bumang ni;",
            "Chu lo saloumei lat hei lat than,",
            "Asei hei Jisu puan the,",
            "Kiruai guai ni janggai e,",
            "Kiruai lailung khou jip bam khou,",
            "Asei khrista puan (2).",
            "",
            "2. Khristianmei guai janggai,",
            "Lungning le bumang ni;",
            "Chulo ringtak makpui lat janggai,",
            "Asei hei Jisu puan the,",
            "Tingkauh kaikham lan lou the,",
            "Meinun khang janggai puituang e,",
            "Asei Khrista puan.",
            "",
            "3. Khristianmei guai janggai,",
            "Lungning le bumang ni;",
            "Nangkhang thei khang ta pingmak chammei,",
            "Gulou khang Jisu puan the,",
            "Mei guaina ta kau bamme,",
            "Tingkauh ram gaimei tang khang e,",
            "Nangniu ta gulou khang#-5 puanpat lou the."
          ]
        }
      }
