    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "JISU ’NAA TANV BAM DE",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaluan luan ’niu tingpuk muangh #<8 zingc e,",
            "Lunghgeihmei #<8 ’niu lung padik ge,",
            "’Ki ’niu thay e tabui sw bam sihni",
            "Jisu ’naa tanv bam de.",
            "",
            "Kamei #<8 phungclou makmei puatrith maek ge,",
            "Phungc ’khavlou makmei lungh ryanramei maek;",
            "Ringhting khou ryanra khou nic, neihlaa khou nic,",
            "Jisu ’naa tanv bam de.",
            "",
            "2 ’Niu ringcting tuang katuakcmei guaychung khou,",
            "Taanv-ruai, puatrith #<8 ngangc thau lak khou,",
            "Ch’rynmei chwn-gay, swm-gayloumei lat re;",
            "Jisu ’naa tanv bam de.",
            "",
            "3 ’Diakc chuymei phuaic ding khou tat ruanlou khou,",
            "Khow-’tauh, ramvkaengv ramv khou tat bam khou,",
            "’Thukmei lat re, gaychuymei latryan e,",
            "Jisu ’naa tanv bam de.",
            "",
            "4 “Ai bam ’chamc tanv bam de,” twna hylou,",
            "Suai makna ’niu huainei dawlou ni;",
            "Kalat lwmna, Kalatryan khou ngangvlou,",
            "Jisu ‘naa tanv bam de."
          ]
        }
      },
