        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu Kabangc khang swan tii khang key khou",
            "Kalaanv pw, zingbangc pw nic,",
            "Lwmlou nuhmei swna ariw ni cho?",
            "’Niu maibungc chuangc gaanc ni cho?",
            "",
            "’Niu chamdaanv the, saa ngam the cho, chana?",
            "Bumaengh kai khang chamdaanv cho?",
            "Kaipouc ’niu ta laa khang guang dat pwkhou,",
            "’Khwanna changkhaanv bam khou ’riw ni cho?",
            "",
            "2 Lauthwan khwanzingh Kaipouc ?|7 aniu ta,",
            "Akhat khat swna kaw khou,",
            "Kaipouc khou ’niu talent ndauh pwkhou,",
            "“Gay the,” twlou puni cho?",
            "",
            "3 Kamei ?|7 ’niu khou nsinloumei 7?|",
            "Ngampui kamv taanc chuy bam cho?",
            "’Niu lung ?|7 ’niu ta tii’khuai mak ethei,",
            "’Niu hym daicna zaengthaek ni.",
            "",
            "4 Chamdaanv thaymei guay kiu dwan gay puni,",
            "Kahym kiu laylaa puni,",
            "Kamei lauthwan pw, zipchwng pw, key khou,",
            "Changkhaanv bam khou ’riw ni cho?"
          ]
        }
