    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Ai thaona apu dang thang",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Ai thaona apu dang thang tat dat kan nithe,",
            "Ahu khou muang jingmei kum jing;",
            "Ata jianlou nimei mak ge hei kandih khou,",
            "Apu ramma ari rana.",
            "",
            "Chorus:",
            "Nkhuai-na man kan sini,",
            "Karam gai 8#@ tuai mak;",
            "Ai rui lunglai dat re thei,",
            "Gaimei la dat nu e.",
            "",
            "2. Apu kai khou 8#@ sian lan naimei guai 8#@ mu,",
            "Rianra rianriumei guai khang e;",
            "Apumsa rui nap dap tari na thei nicho?",
            "Bui sukhang rianra tat tu cho?",
            "",
            "3. Adi gai cho apu dang khou bam pui kan khou,",
            "Kandih gaimei phu loumei guai;",
            "Ai rui thai than lana apu ta ning dat the,",
            "Lum gaina ai nei dat ni the.",
            "",
            "4. Ai nkhuai mei rui rianra rianriu na bam the,",
            "Akhang bam tilou dat ethei;",
            "Kandih munpuang arihta ai ning dat lak khe,",
            "Puang chui lou pui gan ni dui e."
          ]
        }
      },
