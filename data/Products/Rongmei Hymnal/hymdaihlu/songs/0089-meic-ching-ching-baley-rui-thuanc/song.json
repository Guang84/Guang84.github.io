        "content": {
          "format": "source-lines",
          "lines": [
            "1 Meic ching ching baley ?|7 thuanc diu!",
            "Thuakloumeipu hym ta!",
            "ARavguangc, Guangh daihmei hym ta,",
            "Rih ngammei zauzian ta.",
            "",
            "2 Zianthaymeipu aRavguangcle,",
            "Dinc ’dauh khang ’khavlou o,",
            "Kandih kapwm khou dinc lik khang,",
            "Chingkhiuhmei Nang hym ta.",
            "",
            "3 Pingmei tii’maanmei zanc Jisu!",
            "Ryanra tii’maanmei zanc,",
            "Paapcmei nu khang nuh gaymei lu,",
            "Ringhmei, chuzaenghmei zanc!",
            "",
            "4 Kamei ?|7 paapc ngamv sw baklou;",
            "Kangloumei ta riclou;",
            "Kazei ?|7 ’phuammei sw ’thanlou;",
            "Kamei ata kanlou."
          ]
        }
      },
