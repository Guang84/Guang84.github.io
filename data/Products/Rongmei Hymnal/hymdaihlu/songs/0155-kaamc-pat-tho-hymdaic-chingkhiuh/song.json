        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaamc pat tho, hymdaic chingkhiuhna!",
            "Zaatc guay Hosanna kauc bam the;",
            "He Guloumeipu, ruan pat tho,",
            "Phey, tadanvnuy, bamhmei chaeng khou.",
            "Kaamc pat tho, hymdaic chingkhiuhna!",
            "Liwmei lwn khou Nang theiclou khang.",
            "",
            "2 Kaamc pat tho, hymdai chingkhiuhna!",
            "Niamhna Nang theic nipui chaeng khou;",
            "He Khrista, Nang rih ngammei 1<~",
            "Theihmei lev paapc ruc khou lyan tho.",
            "",
            "3 Kaamc pat tho, hymdaic chingkhiuhna!",
            "Kauh ricmei guay zauc key bam the,",
            "Lungh kabiuna, ch’rynna bam the,",
            "’Khamhpui ganv ’naa guangmei howna.",
            "",
            "4 Kaamc pat tho, hymdaic chingkhiuhna!",
            "Liwmei lwn khou Nang theiclou khang!",
            "Theihmei ramsw khou ’bum key tho,",
            "Hei tangv Nang ngamv guanghdic laa tho. Amen."
          ]
        }
      },
