    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Nai e ngamv",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Paapc puat ’ritmei khou #^5 nang duak nii cho?",
            "Zei khou ngamv nai e, zei khou ngamv nai;",
            "Siimei ruc khou rih ngamna lungc nii cho?",
            "Zei khou 5#^ ch’rynpui ngamv nai e!",
            "",
            "Nai e, ngamv .. ngamv ch’rynpui taanv taanh khang,",
            "Lauziu Nac .. zei khou 5#^!",
            "Nai e, ngamv .. ngamv ch’rynpui taanv taanh khang,",
            "Kunghmei Lauziu Nac zei khou 5#^!",
            "",
            "2 Nang liantiimei khou #^5 duak pat nii cho?",
            "Zei khou ngamv nai e, zei khou ngamv nai;",
            "Guang o, Kalvari zei #^5 sw ’than khang,",
            "Zei khou 5#^ ch’rynpui ngamv nai e!",
            "",
            "3 Nang gunh khang suangc ’phwan ranvmei sw nii cho?",
            "Zei khou ngamv nai e, zei khou ngamv nai;",
            "Paapc rei guay 5#^ zei #^5 khiu ’than ngam e,",
            "Zei khou 5#^ ch’rynpui ngamv nai e!",
            "",
            "4 Jisu nang Guangc khang nang taanv sw nii cho?",
            "Zei khou ngamv nai e, zei khou ngamv nai;",
            "Nang tingmik ’thuic thuanhpui lu",
            "suan nii cho?",
            "Zei khou 5#^ ch’rynpui ngamv nai e!"
          ]
        }
      },
