        "language": "rongmei",
        "title": "Chaengmun khou gin khat bam e",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Chaengmun khou gin khat bam e:",
            "Tii .. gut ro!",
            "Kamei guang katup sih the:",
            "Tii .. gut ro!",
            "Tat dat mak khou tiigut ro,",
            "’Thanmeipu e tiigut ro,",
            "Pu Ravguangc Nac Jisu e:",
            "Tii.. gut ro!",
            "",
            "2 ’Taw nang lung kaikhamv laanc tho,",
            "Tii .. gut ro!",
            "Nyan ti thei tat kan puni:",
            "Tii .. gut ro!",
            "Nang Kaipouc e, tiigut ro,",
            "Kamei nang ta gaeklou ni,",
            "Katwan nganv gaeklou puni:",
            "Tii .. gut ro!",
            "",
            "3 Zianmei Kakhwan nang ’king o!",
            "Tii .. gut ro!",
            "’Taw hei Kata laalou tho:",
            "Tii .. gut ro!",
            "Chaengmun khou dingna bam the,",
            "Nang ta tiineihlaa puni;",
            "Nang Kata thuanc bam puni:",
            "Tii .. gut ro!",
            "",
            "4 Kamei hei tingkauh gin e:",
            "Tii .. gut ro!",
            "Nang ta khwmkiclou puni:",
            "Tii .. gut ro!",
            "Nang paap guay kuaklou puni,",
            "Kandih panty luai pwkhou,",
            "Tingkauh kai khou laalou ni:",
            "Tii .. gut ro!"
          ]
        }
