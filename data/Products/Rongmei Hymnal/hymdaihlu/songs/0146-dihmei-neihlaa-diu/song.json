        "content": {
          "format": "source-lines",
          "lines": [
            "1 Dih mei neihlaa diu, Pou guang the!",
            "Ngammei Ravguangc, tingsaeng ringhmei pu,",
            "Chuzaenghmei Guangc Nac!",
            "Lungning guay khou bamv chamvdaanv diu!",
            "Ngammei Racguangc tingsaeng ringhmeipu,",
            "Chuzaenghmei Guangc Nac!",
            "",
            "2 Guloumeipu #<8 guanghtu the!",
            "Ngammei Ravguangc, tingsaeng ringhmei pu,",
            "Chuzaenghmei Guangc Nac!",
            "Chyng, ’zaengc, khow ’taw guay #<8 thuanc diu!",
            "Ngammei Racguangc, tingsaeng ringhmeipu,",
            "Chuzaenghmei Guangc Nac!",
            "",
            "3 ’Chwmhmei lev zauzian #<8 sin the!",
            "Ngammei Racguangc, tingsaeng ringhmei pu,",
            "Chuzaenghmei Guangc Nac!",
            "Katuang ’twnmei #<8 gulou the;",
            "Ngammei Racguangc, tingsaeng ringhmei pu,",
            "Chuzaenghmei Guangc Nac!"
          ]
        }
