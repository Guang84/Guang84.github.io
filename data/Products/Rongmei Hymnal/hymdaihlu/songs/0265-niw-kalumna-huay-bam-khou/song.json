    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "’Niw kalumna huay bam khou",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Niw kalumna huay bam khou,",
            "Nang lung kabiu bam khou hei,",
            "Pu >|3 nang ta kaw bam khou,",
            "Chanale, nang guang lak cho?",
            "",
            "’Taw na hei, ’taw na hei,",
            "Jisu khou nang guang",
            "lak cho?",
            "",
            "2 Kai khou >|3 nang maeng duc the,",
            "Neih khat tat hianc dat ri tho;",
            "Ravguangc khou >|3 tat duh rio,",
            "’Seic Kazauzian laa la tho.",
            "",
            "3 Kandih khou nang phu tow mak",
            "Nang lung khang ’chuzaenghmei 3>|,",
            "Khrista khou guang o, lwm o,",
            "Chuzaenghmei laa tow puni.",
            "",
            "4 Kakhou nang khuay kalauhna,",
            "Guangna kuakloumei laa tho;",
            "Tingmik ’thuic Kakhou lwm o,",
            "Kamei >|3 zaylou puni."
          ]
        }
      },
