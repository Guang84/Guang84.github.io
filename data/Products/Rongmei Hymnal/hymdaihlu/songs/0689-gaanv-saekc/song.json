        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kachaekc riak hei amuc riu,",
            "Ngaek chuyna bam o;",
            "Baihmei khou nic taanclou tio,",
            "Nang laa niimei kumc.",
            "Zianna, ’zaenghna",
            "Kaniw puatrith phungc ’khav tio;",
            "Niamhna luh tio,",
            "Zianmei lungning #^5.",
            "",
            "Kachaekc riak hei amuc riu,",
            "Ngaek chuyna bam o;",
            "Baihmei khou taanclou tio,",
            "Nang laa niimei kumc.",
            "",
            "2 ’Suanmei nunc ta ’khavlou tio,",
            "Lakmei tiitanc o,",
            "Puatrith phunghmei lungning ta",
            "Swmmei lat saa tio.",
            "Daekmei maekna",
            "Nang khou naimei tiipat ro,",
            "Tiipat niina",
            "Maekmei khang tii o.",
            "",
            "3 Pou ta nanglungsyng zian o,",
            "Latdanv reymei e;",
            "Nang tuang kaining kaigei ta",
            "Nang ta kumc zian o.",
            "Latzan gayna",
            "Khat lev khat lung kariu o,",
            "Chamdaanv tan o,",
            "Kuaklou thay ngam khang."
          ]
        }
