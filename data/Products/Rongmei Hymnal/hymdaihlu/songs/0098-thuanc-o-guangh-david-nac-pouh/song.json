        "content": {
          "format": "source-lines",
          "lines": [
            "1 Thuanc o, Guangh David Nac ’Pouh",
            "Thauh teyloumeipu ta!",
            "Thuanc o, ’rianhloumei ganv khou",
            "Guanghtu khang guangmei ta!",
            "Rairiumei ngamv sw bak khang,",
            "Banghmei ta riclou khang,",
            "Khuay guay gancna ’chuzaenghna",
            "Lungc diu khang !}2 guang the!",
            "",
            "2 Kandih guangc guay Kahu khou,",
            "Pun keyna kalum ni,",
            "Zaatc guay !}2 Kata bwanna",
            "Thuanhpui lu suan puni;",
            "Kata thuanhpui lu khwan !}2",
            "Kandih ’thuic zin lik ni;",
            "Kaguangcdic daic kaluan ni,",
            "Kanganv nai dat lak khe!",
            "",
            "3 Zauczihmei guay ta ngamna",
            "Kabamvpaeng khou ’thaekc ni;",
            "Tingsaengzaeng hym daic bam ni,",
            "Dwan gaymei padik ni;",
            "Kaganv !}2 Kalatryan guay",
            "Tiikalaic dat lak khe;",
            "Katuang zianmei zanc hym hei",
            "Tingsaeng kalaic lak khe."
          ]
        }
      },
