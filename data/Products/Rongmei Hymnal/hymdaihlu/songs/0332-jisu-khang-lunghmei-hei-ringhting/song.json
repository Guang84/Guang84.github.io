      "rongmei": {
        "language": "rongmei",
        "title": "Jisu khang lunghmei hei ringhting",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu khang lunghmei hei ringhting ling e,",
            "Ataanv guay hei !}2 Kata tiipianna,",
            "Kata champouhna, Kakhou rouh makna",
            "Neihlaana lunghmei suaihiam chaenglwan e.",
            "",
            "He Jisu Guloumeipu,",
            "Nang khou ai tiigut ngam,",
            "Nang pumc kahak 2^< akhang",
            "Tiipatloupui zaeng !}2;",
            "Akhang Kaipouc baihmei maek,",
            "Alung Nang guangc bamv e,",
            "Ntaw khou !}2 thauna Khrista",
            "Nang khang na lung ni the.",
            "",
            "2 Aphaan theicloumei Jisu khang lungc ni,",
            "Kalvari khou apaap guay phungclouna;",
            "Hei ramzian paan !}2 kawmei ai dawlou,",
            "Kathei layna Kakhou tiigut ngam the.",
            "",
            "3 Kabamv kathuic Jisu khang ai lungc ni,",
            "Kazanc nthanmei khou taanv guay taancna;",
            "Ryanra, ’maanmei guay akhaengv khang ningna,",
            "Nthiammei kathuic akros khang chakna.",
            "",
            "4 Dih panty dak khou Jisu khang lungc ni,",
            "Ai kungc liangmei kiu Kazawpaanv ei e;",
            "’Maanmei bumaengc guay ta phuna lungc ni,",
            "Ryanramei ta Kakhou phungc guanglou ni."
          ]
        }
      },
