        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaipouc, Nang ta ai zian ’bu e!",
            "Kandih ramgai ta suangc,",
            "Sw ’maan ngam makmei chuzaenghmei",
            "Nang @<4 tiipui zaeng @<4.",
            "",
            "Paekri sihni saa ngam mak he,",
            "Padikmei zianmei lam!",
            "Paekri sihni saa ngam mak he,",
            "Zei @<4 khiu ’thanmei lam!",
            "",
            "2 Ai thay e, Nang ‘naa diangc bam e,",
            "Kandihmei nunc khang suangc,",
            "Nang ta makumhmei gay ranv e,",
            "Kandih lu gaymei suangc.",
            "",
            "3 Nang @<4 neihlaamei tiilou the,",
            "Ai neihlaa bam nuh the,",
            "’Thukmei Nang zauzian paan hamhna",
            "Ai neihlaa ngam lak ge.",
            "",
            "4 He kunghmei, he Guloumeipu,",
            "Dih khou heidi gay ’thei,",
            "Kauh thangc Nang lev lungc ’chamc pwkhou",
            "Adih gay ranv ni cho!"
          ]
        }
      },
