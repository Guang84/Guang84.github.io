        "content": {
          "format": "source-lines",
          "lines": [
            "1 He chulou o, ata zianlou na ro,",
            "Guanglou o, Thuakmeipu!",
            "Nang ta ai khuksun keyna kalum e;",
            "Guanglou o, Thuakmeipu!",
            "",
            "Ngouhdaih sangdiuh thangc,",
            "ai ruan tat khwan the,",
            "Kai khou #^7 ducna tat khwan the;",
            "Nang lauziu kuanc khou laa guanglou dat ro,",
            "Guanglou o, Thuakmeipu!",
            "",
            "2 Zinghmei khou #^7 ai duppuibamv maek khe,",
            "Guanglou o, Thuakmeipu!",
            "Nang zauc pat guai #^7 tiigaanclou nuh e,",
            "Guanglou o, Thuakmeipu!",
            "",
            "3 Apam arai maek ge, ai ryanra the,",
            "Guanglou o, Thuakmeipu!",
            "Nuic rimh rimna zauc riu khang machunh e,",
            "Guanglou o, Thuakmeipu!",
            "",
            "4 Alunglai ta Nang #^7 malaalou lak,",
            "Guanglou o, Thuakmeipu!",
            "Alung niamhna ai huaymei chulou o,",
            "Guanglou o, Thuakmeipu!"
          ]
        }
      },
