    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "AI NGAMPUI KAMV JISU KHANG TAANC",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai ngampui kamv Jisu khang taanc chuylou tha,",
            "Kros ruc khou theicloumei pu khang?",
            "Kalvari khou kanganv tangcna ’khaengvlou the.",
            "Akhou gay liangmei Kamei laa nii e.",
            "",
            "’Maan kanmei azuh ta ai zay thaulou tha?",
            "Kanglou bammei azuh ta tiiduak tha?",
            "Ai ngampui kamv Jisu khang taanc chuylou tha,",
            "Akhang heizu taancloumei khou.",
            "",
            "2 Ai kaganv sw ’maan kanmei hei geic hak the,",
            "Khrista khang piumei azuh mak;",
            "Ai Jisu ta zianmei hei rau langv tina,",
            "Kalung hei akhang bakna bam nuh e.",
            "",
            "3 Ai baihmei nunc ta kabiuc kadanlou tha?",
            "Kaniw na ta ganclou tu ny?",
            "Maengtatmei ta Gumei pu khou zay guangna,",
            "Ringhmei thw kakhou lingclou ni tuang e.",
            "",
            "4 Ai nzaengc khou hei tingsaengcna bam lak khe,",
            "Chyng kauhmei twan khou ku ni the;",
            "Dihmei nunc t’riina gaanv saekc ta ’khwan bam the,",
            "Guloumei pu ramzian lam dinclou khang."
          ]
        }
      },
