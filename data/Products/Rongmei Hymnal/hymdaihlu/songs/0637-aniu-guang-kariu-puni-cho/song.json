      "rongmei": {
        "language": "rongmei",
        "title": "Aniu guang kariu puni cho?",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Aniu guang kariu puni cho,",
            "Baanch’ra nunc chaeng kaanv khou 3)^,",
            "Ravguangc bamvpaeng khou )}3 patmei",
            "Kangranmei duithuak khou 3)^?",
            "",
            "N-guay, kariu puni khou 3)^",
            "Gaychuymei, gaychuymei duithuak khou 3)^,",
            "’Thanmei nunc lev ’niu kariu puni,",
            "Ravguangc bamvpaeng daeng khou 3)^.",
            "",
            "2. Gaanhmei duithuak guang tangh mak khou,",
            "’Niu puat phung guay lou key ni;",
            "Zauzian )}3 ’niu ta gaeklou ni,",
            "Pheybaan lev pyrun tii ni.",
            "",
            "3 Guloumei pu zawpaanv kumhmei",
            "Gaanc gaymei duithuak khou 3)^",
            "Theihmei )}3 kabiu ngam makmei",
            "’Thanmei nunc lu suan bam e.",
            "",
            "4 Duithuak 3)^ tangc zaic puni the;",
            "’Niu ’gyn taan zaic puni the;",
            "’Niu lung zaeng ’thaekc zaic puni the,",
            "’Chu-’zaenghna lu suan ni the."
          ]
        }
      },
