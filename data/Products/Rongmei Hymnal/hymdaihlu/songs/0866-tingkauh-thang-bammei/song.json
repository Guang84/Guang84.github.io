        "content": {
          "format": "source-lines",
          "lines": [
            "1. Tingkauh thang bammei guang Jisu,",
            "Lung rinaramei makmei Jisu;",
            "Kandih khou rianra bam khou hei,",
            "Akhanng khrista %&6 tigan lou.",
            "",
            "Chorus:",
            "Charin tuang e (2),",
            "Kajaujian hei charin tuang e;",
            "Kalvari khou akhang thei lou,",
            "Ai ning thukge kanloumei pu.",
            "",
            "2. Ning tan makge he guang Jisu,",
            "Ai thai tang ngam makmei Jisu;",
            "Lung rianramei timan lou o,",
            "Ringmei thingbang khou jailou o.",
            "",
            "3. Lung rianramei duidai bam khou,",
            "Kan ngam mak ge jai kanlou o;",
            "Charin tuange nang jaujian hei,",
            "Akhang khrista %&6 thei loumei.",
            "",
            "4. Timgkauh thang namdai gaimei nai,",
            "Lungning njangmei tilou o;",
            "Njianmei riang %&6 bang louo,",
            "Kai gaimei khou tibam lou o."
          ]
        }
      },
