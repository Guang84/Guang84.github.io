        "content": {
          "format": "source-lines",
          "lines": [
            "1. Hei kandihta akandih e tuna",
            "Ning khou !-2,",
            "Njianmei guai Jordan pang thang",
            "Lung khang tat kan the.",
            "",
            "Chorus:",
            "Neimik ni naimei nsa de,",
            "Buh le ganchuanga guai ni;",
            "Bansin kadimei nai lak khe,",
            "Ganmei Jisu hu khou tei.",
            "",
            "2. Hei kandih tei sumei naomei guai",
            "Nai dat lak khe,",
            "Njianmei guai ta ariu puni",
            "Jordan pang thang.",
            "",
            "3. Lummei guai mu tingkauh ramthang",
            "Tingsangjang lungni,",
            "Tat rei kanmei njianmei guaita",
            "Ariu puni."
          ]
        }
      }
    },
