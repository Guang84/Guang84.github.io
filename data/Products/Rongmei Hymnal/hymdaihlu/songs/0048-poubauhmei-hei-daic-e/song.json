        "content": {
          "format": "source-lines",
          "lines": [
            "1 Poubauhmei hei daic e,Kaipouc kiu e;",
            "Thauna suan o, thauna suan o!",
            "Khuksun keyna Poubauhmei phaypav khou,",
            "Thuancna Kahym tiidaic kho!",
            "",
            "He thuakloumei nuncle, zianpui ’rac 2}? dow o!",
            "Hym daihmeipu ta chakhwang }?2 thuanc kho!",
            "Guangh Poubauhmei ta hei khwan ranvna thuanc di kho,",
            "Thuancna Kahym tiidaic kho!",
            "",
            "2 Poubauhmei hei daic e, Kalat ngam e;",
            "Thauna suan o, thauna suan o!",
            "Chakhwang lev ngamv, guanghdic hei Katuang e,",
            "Thuancna Kahym tiidaic kho!",
            "",
            "3 Poubauhmei hei daic e, champouhlou o,",
            "Thauna suan o, thauna suan o!",
            "He kandihmei zaat guayle, neihlaa kho,",
            "Thuancna Kahym tiidaic kho!",
            "",
            "4 Poubauhmei hei daic e, Kazanc ’than e,",
            "Thauna suan o, thauna suan o!",
            "Kauh baanch’ra guay lev maansei guay thuanc o,",
            "Thuancna Kahym tiidaic kho!"
          ]
        }
