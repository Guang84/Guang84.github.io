        "content": {
          "format": "source-lines",
          "lines": [
            "1 Gumeipu kaw e, guang zauc lo,",
            "Ramh guay nang khang",
            "chamdaanvlou the!",
            "Ringhmei, zianmei Ravguangc",
            "khou ^&8,",
            "Khrista kahak ^&8 phungc guang the.",
            "",
            "",
            "“Akhou guangmei (3) kamv ta,",
            "Ganc pat dat lak khe (3) Ai ^&8!",
            "Akhou guangmei (3) kamv ta,",
            "Ganc pat dat lak khe (3) Ai ^&8!”",
            "2 Gumeipu kaw e, guang lak cho?",
            "Kakhwan 8^& lunghsii makna cho?",
            "Ziangrih patna nang ’king lak cho?",
            "’Khwan bam khou guang nii",
            "makna cho?",
            "",
            "3 Kamei nang paap ta thay bam de,",
            "Nang lung khou Kabamv khang tii o,",
            "Kamei gutna sw ’thanlou ni;",
            "Suaihiam kaguay tiilou puni."
          ]
        }
