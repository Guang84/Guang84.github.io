        "content": {
          "format": "source-lines",
          "lines": [
            "1. Khrista le phuamling khang niu kao thao kho,",
            "Guigaimei niu guang janChakhuang champou su kho;",
            "Chabuan pumtan ({0 niu chun louna tan kho,",
            "Nchummei guandih khang biangpuina dingkho.",
            "",
            "Chorus:",
            "Khrista thuakloumeipu khang,",
            "Khrista theiloumei khang;",
            "Jei({0 liuloumei phuamling khang,",
            "Sulou o bao khang pou.",
            "",
            "2. Khrista le phuamling khang huainei bam kho,",
            "Tingmik thui kross phungnaKachuangphei thei lai kho;",
            "Bumang tanmei ngam khou tigut lou ngamkho,",
            "Panti gan gai khou kasiamruai su dikho.",
            "",
            "3. Khrista le phuamling khang priuna tikho,",
            "Kaipou khang kagan le talentSianlan kat kho;",
            "Gailiangmei puatruai guai phung guangna tikho,",
            "Jianmei lungning lan kam makmei hei kat kho.",
            "",
            "4. Khrista le phuamling khang niu ganpat kho,",
            "Kakhang khangna ningmmeiLiantimei pingmei guai;",
            "Gaimei dam guang nimei tei machun lou kho,",
            "Theithang kaipou tuang banjat thang neilani."
          ]
        }
      }
