        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neihlaa zaenggay o, Kaipouc khou!",
            "He lungning ntwnmei thiule;",
            "He Kata laaloumei nuncle;",
            "Nang ryanra guay 7}$ hac ganc tho.",
            "",
            "Neihlaa! .. neihlaa!",
            "Neihlaalou o, Poubauhmei khou!",
            "Neihlaa! .. neihlaa!",
            "Neihlaalou o, Poubauhmei khou!",
            "",
            "2 Neihlaa o, Kamei Kaipouc e,",
            "Kauh lev dih khou daic liangmei e,",
            "Kalat #^7 ramh guay ta sin e,",
            "Thuaklou khang ngammei tanhmei e.",
            "",
            "3 Nzihmei lam khang ding pwkhou,",
            "Zauczihmei #^7 ngam ni kumh khou,",
            "Nang biak lianghmei Ravguangc ricmei,",
            "Zauczihmei suangc geic e, tanc e.",
            "",
            "4 Neihlaa zaenggay o, Kaipouc khou!",
            "Lu #^7 suan o, Kata thuancna;",
            "Nkhuangh, nrah lev meic khwan #^7,",
            "Hallelujah! tingsaeng kauc o."
          ]
        }
