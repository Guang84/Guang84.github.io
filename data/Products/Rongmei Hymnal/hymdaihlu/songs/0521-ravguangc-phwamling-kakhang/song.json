        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc phwamling, kakhang khang na ning makna,",
            "’Niw kariu e, Nang thei laymei kaguay;",
            "Lu suan ’chamc e, kalung bammei nunc guay lev,",
            "’Niw huayney khou Ravguangc ningmei phu e;",
            "Ravguangc phwamling, Nang ta zianmei ’niw khou nai,",
            "’Niw phungc guang e, ’niw tuang",
            "Alleluia!",
            "",
            "2 Ravguangc phwamling, hiw bammei kaeng khwan kumcna,",
            "Nang kabai e, pumtan guay phungc guang khang;",
            "Khrista ramgai lungc lyanna siamruai sw khang,",
            "Zianmei taanv khou machunhmei lyanlou khang;",
            "Ravguangc phwamling, paapc lev sunu ’maan pwkhou",
            "Nang khang suan ni ’niw tuang Alleluia!",
            "",
            "3 ’Niw bumaengc kai, neihlaana ’niw guang dat re,",
            "’Niw khwan ranvna Nang ta thuanc kariu khang;",
            "Neihlaamei dam laa kariumei ramgai khang,",
            "Tiineihlaamei pumtan, chuzaenghmei khang;",
            "Ravguangc phwamling, Nang ta ’niw lung ?|7 ning e,",
            "Nang khang kauhmei ’niw tuang",
            "Alleluia!"
          ]
        }
