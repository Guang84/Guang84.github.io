          "format": "source-lines",
          "lines": [
            "1 He aniw Guangc, ’niw panty",
            "Guangc, Nang paan ({0",
            "Lunghgutmei, biangpiumei swna bam ni!",
            "Guangh tuang chuanghphey hymdaihmei bangc khou aniw",
            "Nang zanc khou tancna Nang khang adow ni.",
            "",
            "Rigaanv khwan kauc o ! kasanv tanh tan o!",
            "Aniu bumaengc neihlaana lu suanna,",
            "Rigaanv khwan kauc o! meicbiang piu chuy o;",
            "He aniw Guangc, Nang paan ({0 ’niw ngam ni!",
            "",
            "2 ’Niu Guangc hymdaihmei Guangcta chakhwang sw ni,",
            "Lunghgutmei, biangpiumei swna bam ni,",
            "Baucna karamc ni zianna Kalat piu ni,",
            "Taanclou niina Kakhou ’niu taanclou ni.",
            "",
            "3 Guloumeipu, himdaih Guangc aniw lung khou,",
            "Nang ningmei ({0 guanghtuna lungclou o,",
            "Tiipat ngam the aniw chwn, niw kahaw guay;",
            "Nang chwn khou na ’niw hei lungc bam ni the."
          ]
        }
