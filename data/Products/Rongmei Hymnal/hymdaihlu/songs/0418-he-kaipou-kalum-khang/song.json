        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Kaipouc, Kalum khang",
            "Guang kaduai bam khou hei,",
            "Nang zaw karih ntheilou rio,",
            "Ai hei ’khuai khwan sihni.",
            "",
            "2 Ai $%6 maanvloumei guay",
            "Nang hu khou phungc guang e;",
            "Tiiduaklou khang, khiu ’thanlou khang,",
            "Nang pamv khou ’zwan guang e.",
            "",
            "3 Akhuay sing phuc ngam mak,",
            "’Ki Nang kuaklou ngam e;",
            "’Khuay lam khou lungh kabiu bam khou",
            "Kuakloumei tiilou o.",
            "",
            "4 Kaipouc, lungning howmei",
            "Alunglai zauclou o,",
            "Kandih lungning tii ’maanlou o,",
            "Khrista lung tiilou o."
          ]
        }
      },
