        "content": {
          "format": "source-lines",
          "lines": [
            "1 P’ry guangc 3>| raclou na ro,",
            "How makmei kauh chamv 3>|;",
            "Jisu lev Kahym daihmei,",
            "Jisu zauzian p’ry 3>|;",
            "Chiwmei thiak khou raclou o,",
            "Alauc khou raclou kum,",
            "Ai thu ’suanmei, ’pangmei e,",
            "’Khavloumei maekmei e.",
            "",
            "P’ry guangc 3>| raclou na ro,",
            "P’ry guangc 3>| raclou na ro,",
            "Jisu lev Kazauzian p’ry",
            "Akhou raclou na ro.",
            "",
            "2 Raclou o, kadwan swna,",
            "Ai laalou nuh diu khang;",
            "Ravguangc >|3 paapc kuaklou khang",
            "Thuakloumei tiimei 3>|;",
            "Raclou o, rac katupna,",
            "Ai thu ’muc dat tanc e;",
            "Lauthwan tuang zikdui guay >|3",
            "Kalaanv phui kumh tuang e.",
            "",
            "3 Raclou o, niamhmei khwan >|3,",
            "Lungsuc changhmei khwan >|3;",
            "Jisu >|3 gu khang keymei,",
            "Paapc mei kiu ai hei the;",
            "Ai ryanrapui ganv ’thuic khou",
            "Alung swmlou nii ’thei,",
            "P’ry hei nthaekc zat makna",
            "Akhou raclou bam o.",
            "",
            "4 Hei p’ry guangc hei raclou o,",
            "Hei kandih ramgai >|3",
            "Apanty sw ’maan bam the",
            "Twmei Nang thay pat khou;",
            "N-guay, kauh kandic ramgai",
            "Ai thay thau rap pwkhou",
            "“Nang ta Khrista tiigay the,”",
            "Twmei p’ry raclou o."
          ]
        }
      },
