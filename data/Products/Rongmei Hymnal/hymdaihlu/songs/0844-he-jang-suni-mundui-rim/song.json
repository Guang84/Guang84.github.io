        "language": "rongmei",
        "title": "He jang suni mundui rim",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. He jang suni mundui rim gaimei ram khou,",
            "Jianmei ta tam khang saguang pu the;",
            "Chunsimei mikdui tei luang kei lou lana,",
            "He Raguang ntam bam nimak ge.",
            "",
            "Chorus:",
            "Asei ntammei njianmei mikduiluang,",
            "Asei tingmik than pat datro;",
            "Lungjingmei tigan no he Raguang,",
            "Jianmeita janghuai na kap be salam.",
            "",
            "2. Chana le tau hei aniu tam kan dikho,",
            "Tat nimei luangbut ta jao lana;",
            "Phang jaolo mikdui rouna ntam kanmei,",
            "He Raguang akumma tat ni cho?",
            "",
            "3. Gaichuimei tingthan neiriu kumma jianmei,",
            "He jianmei tam khang saguang pu the;",
            "Pat lou the jianmei bansin kariu louna,",
            "He rangbang tat tuan kan the jianmei.",
            "",
            "4. Tingkauh thu Ragang jan khou khatna suni,",
            "Kum sini jangsimei #@8 gumliam;",
            "Ai kapma bampui dihta ning dat lak khe,",
            "Abanjat #@8 ham guange salam."
          ]
        }
      }
    },
