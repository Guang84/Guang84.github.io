        "content": {
          "format": "source-lines",
          "lines": [
            "1 Khristian mei, zaenggay o,",
            "Lungh, bumaengh, khwan pwm >|3!",
            "Chu lo, ’niw dinhmei latchamv: Gaychamv!",
            "’Seic hei Jisu ta puanc the;",
            "Kiruai guay nic kalum e,",
            "Kata kiruaikuak khou ’zilou,",
            "’Seic Khrista puanc the,",
            "’Seic Khrista puanc the.",
            "",
            "2 Khristian mei, zaenggay o,",
            "Lungh, bumaengh, khwan pwm >|3!",
            "Chu lo, taek makmei zaenggai, zaenggai!",
            "Hei khang Jisu ta puanc e;",
            "Tingkauh kaikhamv laanclou the,",
            "Maansei khang suaihiam phungc uang the;",
            "Hei khang Khrista puanc,",
            "Hei khang Khrista puanc.",
            "",
            "3 Khristian mei, zaenggay o,",
            "Lungh, bumaengh, khwan pwm >|3!",
            "Theihmei ta ping khang maek khe, ’zaengh the,",
            "Gulou khang Jisu puanc the,",
            "Meic guayna ta kaw tuang e,",
            "Tingkauh ramgai khou lungh khang e;",
            "Gulou khang puanc the,",
            "Khrista ta puanc the!"
          ]
        }
      }
    },
