        "content": {
          "format": "source-lines",
          "lines": [
            "1 Belsazar guangc khumkih khou,",
            "Kapam kaipouc ching khat lev",
            "Kachaekcbuangc puanc zangvna bam khou,",
            "’Thanmei Baibal ^&8 dinc e:",
            "",
            "Zingbangc 8^& guangh kaidai khou",
            "Tuzangv ’baana bam geih khou,",
            "Kaniw ta tii’luang phuanglou e,",
            "Ngaengsaengc khou baanc dangv 8^& ^&8!",
            "",
            "Ravguangc baanc",
            "ngaengsaengc khou baanc 8^&!",
            "Ravguangc baanc",
            "ngaengsaengc khou baanc 8^&!",
            "“Nang biuh mak ge!” tw puni cho,",
            "“Nang biu the,” tw puni cho,",
            "Baanh dangv 8^& ^&8 nang",
            "khang hy pwkhou?",
            "",
            "2 Zauc lo, bauhmei Daniel 8^&",
            "Meic guay hu khou 8^& dingna,",
            "Ramhkhe swmei guangc ta ’phutna,",
            "Kakhuay 8^& saa ’dauhlou the;",
            "Hyloumei 8^& paac pat the,",
            "Meic guay khang tasiat chamv e:",
            "“Nang guangcdic ’seic mut puni the!”",
            "Baanh dangv 8^& ^&8 hylou e.",
            "",
            "3 Aniu taanv guay nic chakna",
            "Hy bammei baanc khat nai e:",
            "He paapc mei, Jisu ta laa tho,",
            "Kalatdanv hei piu la tho,",
            "’Khamhpui tingmik guang pw the,",
            "Meic kathuic khang guang puni:",
            "Paapc mei khang tii nimei dandi",
            "Ngaengsaengc khou lyanpui neic 8^&!"
          ]
        }
