        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Thanmei, ’Thanmei, ’Thanmei Poubauhmei Ravguangc!",
            "Lauthwanzingh ’niw thuanhpui lu khwan Nang pamv tangc diu;",
            "’Thanmei, ’Thanmei, ’Thanmei, zianthaymei, ngammeipu!",
            "Guigaymei Racguangc, Gaanv Thumh khat swmei!",
            "",
            "2 ’Thanmei, ’Thanmei, ’Thanmei!",
            "’Thanmei nunc Nang ta bwan",
            "Nang hu khou kaniw kachaekc pyrun lou keyna,",
            "Cherubim lev Seraphim Nang hu khou khuksun e;",
            "Tat kanmei, bammei, guang nimei Kaipouc!",
            "",
            "3 ’Thanmei, ’Thanmei, ’Thanmei! zinghmei $%6 ’kamhlouna,",
            "Paapc phunghmei mik $%6 Nang ta how mak khwan sini,",
            "Nang na rap de, ’Thanmei, Nang kumhmei baihmei maek",
            "Ngamv, zianmei, ’thanmei Nang khou nthuih e!",
            "",
            "4 ’Thanmei, ’Thanmei, ’Thanmei Poubauhmei Ravguangc!",
            "Kandih, tingpuk, duidai khou Nang taanv $%6 thuanc diu;",
            "’Thanmei, ’Thanmei, ’Thanmei, zianthaymei, ngammeipu!",
            "Gaanv Thumh khat swmei hymdaihmei Racguangc!"
          ]
        }
