        "language": "rongmei",
        "title": "Nang tuang thouc tei ngampui kamv",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang tuang thouc 0({ ngampui kamv taanc chuyna",
            "Gumei pu chamv meic nunc khou dinc ethei,",
            "Lungh tangkhyn riu, meic nunc lwm mak sihni,",
            "Kaipouc saa puni, “Taanc chuy dyng the.”",
            "",
            "O, achaenglwan ai tatluai guangpui nungc kiu,",
            "Ryanra lakna, rih ngamna guang pwkhou,",
            "Builwang ’tunghna kros puancna ai guang pwkhou,",
            "Kaipouc saa puni, “Taanc chuy dyng the.”",
            "",
            "2 Ning laanh khwan e, Guloumei pu ta nic,",
            "Kros khou swluai, Ravguangc Nac kahak ta;",
            "Chu lo, Kamei Kapu khou huaybam e;",
            "“Anyng hamh e, Nang nyng sw kan diu.”",
            "",
            "3 Mi ringhting tuang taanvdwan hei luai pwkhou,",
            "Nang taanv guay khang swan",
            "laa khang guang pwkhou,",
            "Adih gaymei zaengthaekpui latkaeng cho,",
            "Kamei saa pwkhou: “Taanc chuy dyng the.”",
            "",
            "4 Nang ngampui kamv karamcna taanc sihni,",
            "Guang tangc lakna, phaybaanh zamh ngam sihni,",
            "Kros 0({ phungcna Kata sowriw ’khap tho,",
            "Kamei saa puni: “Taanc chuydyng the.”"
          ]
        }
