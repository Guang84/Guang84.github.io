    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "AKaipouc taanv taanc khwan e",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Akaipouc taanv taanc khwan e,",
            "Tingmik ’thuic dwan naina;",
            "Kata luic niimei guay _>6",
            "Taanv taanc ranv nina de;",
            "Taanv guay alinghna taanc o,",
            "Lungning ’thanmei taanv guay",
            "Taanhpuimei naipui bamv ’thuic",
            "Kaipouc mei 6_> nai the.",
            "",
            "2 AKaipouc hei duangda e,",
            "Lwmnuhmei pam khwan e,",
            "Kata luic niimei guay _>6",
            "Pam sw thay nina de;",
            "Neihlaana thuanhpui ganv khou,",
            "Kadanmei padik khou,",
            "Pam gaymei naipui bamv ’thuic",
            "Kaipouc mei 6_> nai the.",
            "",
            "3 AKaipouc ’khavlou thay e,",
            "Ryanramei ta thay e;",
            "Kata luic niimei guay _>6",
            "’Khavlou thay nina e;",
            "Meic kathuic phungc ’khav tithei",
            "Puatrith ’thaan maih puni;",
            "’Khavlou thaymei nai bam saanv",
            "Kaipouc mei 6_> nai the.",
            "",
            "4 Chanathiu, ’niu zauc-gay kho,",
            "Maansei khat kumc lungc kho;",
            "Aniu Kaipouc Kamei hei",
            "Maansei khat sw khwan e,",
            "Kakumhmei maansei nunc ta",
            "Kabamv ’’thuic phu bam e;",
            "Khat khat ta zianpui bamv khou",
            "Kaipouc mei nunc nai the."
          ]
        }
      },
