        "language": "rongmei",
        "title": "Rianramei kaguai nai dat lakkhe",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Rianramei kaguai nai dat lak khe,",
            "Tingkauh kandih tang pukhou;",
            "Mikdui keimei guai thut phui thanlou ni,",
            "Neilamei kauh mun hei tuai dat la khe,",
            "Kauh kandih thang.",
            "",
            "Chorus:",
            "Ntampui ban sin kariu louna,",
            "Chunsi jangsi kapma huai bamme;",
            "Kandih khou ntam lou sini,",
            "Tingkauh thang ariu ni tu e.",
            "",
            "2. Kauh kandih tangpui kan khou !@9na,",
            "Pap le seitan man puni;",
            "Salem chang mun gaimei tei akhang e,",
            "Njianmei nang ta ntam lou sini,",
            "Kaplou ri o.",
            "",
            "3. Laujiu pang khou !@9 ntam louna,",
            "Adi kha chunsi ni cho?",
            "Guloumeipu !@9 jai guang lou datro,",
            "Tat dukan the jao lana ai kalun,",
            "Hou dat mak khe.",
            "",
            "4. Sharon munpuang le ganguang datro,",
            "Bumang thanmei sam guang o;",
            "Lung nipui ram kau kandih gaimei khou,",
            "Neila tak maknga lung bam puni the,",
            "Jianmei nun le."
          ]
        }
      }
    },
