        "content": {
          "format": "source-lines",
          "lines": [
            "1 Riu e, neihlaa lauthwan,",
            "’Thanmei zaengthaek tingmik;",
            "Nang guang datmei thuanc e;",
            "Pou, Nang suaihiamlou o;",
            "’Naamei kandih taanvdwan khou #^7",
            "Tingsaeng neihlaa bamv ai ’zwan e,",
            "Tingsaeng neihlaa bamv ai ’zwan e.",
            "",
            "2 ’Taw thu Guangh #^7 keyna",
            "Kazauzian bun key o,",
            "Nang builwang ’tyng pat tho,",
            "’Thanmei nunc zauc bam khou;",
            "Nang Lat hei paapc mei nunc chu diu,",
            "Poubauhmei ta ping thay kan diu.",
            "Poubauhmei ta ping thay kan diu.",
            "",
            "3 Key o, kauh Akhouhna,",
            "Tiikaluanmei ngamv khou;",
            "Lyanlou o, Pou ramzian,",
            "Nang suaihiam tiilou o;",
            "Abumaengc hei chaenghringc thau ni,",
            "Kabah naina kalum puni,",
            "Kabah naina kalum puni."
          ]
        }
      }
