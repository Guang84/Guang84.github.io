          "format": "source-lines",
          "lines": [
            "1 Kunghmei thw nrou o,",
            "Lauthwan gaancra pat rap khou {:1;",
            "Kunghmei thw nrou o,",
            "Kalaanv ganv gay khou;",
            "Kunghmei thw nrou o,",
            "Chabwan nunc panty kasiamh khang;",
            "Kunghmei thw nrou o, kungc kadanlou o.",
            "",
            "Kunghmei thw nrou o, kunghmei thw nrou o,",
            "Kabamv kathuic khou nrou liksikh siklou o;",
            "Ringhmei ’Tyan bybakna,",
            "Gaychamv lat 1<: nchamlou o,",
            "Kunghmei thw nrou o, aniu kandic khou.",
            "",
            "2 Kunghmei thw nrou o,",
            "Tingzyn ramvgei neihkhyam key khou;",
            "Kunghmei thw nrou o,",
            "Zingc kamvramh ram khou;",
            "Kunghmei thw nrou o,",
            "Lwmsiipui tuang nai dat makna,",
            "Ramh guayna Ravguangc khou",
            "lwmna ganclou o.",
            "",
            "3 Kunghmei thw nrou o,",
            "Lungh gutlouna karamc ranvna;",
            "Kunghmei thw nrou o,",
            "Mathuangmei thw 1<:;",
            "Kunghmei thw nrou o,",
            "Nang baanc 1<: nrou nthaekc rio;",
            "Ravguangc khou huayney o, ting-neih tiilou khang."
          ]
