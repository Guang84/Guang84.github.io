        "content": {
          "format": "source-lines",
          "lines": [
            "1 Dih $%6 tii ngammei kungc liangmei suangc ’thukmei,",
            "Alung khou tiiguangmei chamv hei e:",
            "Jisu Karaana $%6 apaap zaeng theiclou the,",
            "Kalvari $%6 gumbinlou the.",
            "",
            "Kalvari $%6 gumlou the,",
            "Rii kanmei apaap guay 6$%;",
            "Khou6$% Jisu $%6 akhuay guay phungclou the,",
            "Kalvari $%6 gumbinlou the.",
            "",
            "2 Kazamzei guay lev sauh pyrun runmei $%6,",
            "Kanganv maekmei Karamzian lyan e;",
            "Ai Kazanc saanc pwkhou ai zakna ’bum key e,",
            "Kalvari $%6 gumbinlou the.",
            "",
            "3 Kida khang maekmei Kazauzian ’thukmei p’ry,",
            "Kros khou theicloumei Kaipouc Jisu,",
            "Theihmei thuakloumei hei Kakhou na $%6 laa e,",
            "Kalvari $%6 gumbinlou the.",
            "",
            "4 Adih gay tu cho kauh thangc hymdaihmei khou,",
            "Abumaengc hei Katuang sw ni the,",
            "Khou6$% ai kazauh ni neihlaa lu suanmei khou,",
            "Kalvari $%6 gumbinlou the."
          ]
        }
