        "content": {
          "format": "source-lines",
          "lines": [
            "1 Gumeipu khou guang tho, nyan ri tho;",
            "Kalat khou hei ’niu khang chaeng dinclou;",
            "’Taw ’niu pangc khou Kamei ding bam the,",
            "Niamhna saa e: “Guang tho!”",
            "",
            "Neihlaa, neihlaana ariw puni,",
            "Paapc khou <~1 ’niu duakna",
            "’than pwkhou;",
            "Gumeipu lev bam kariu puni,",
            "Nganv dat lakmei kai khou.",
            "",
            "2 “Alauc ta khaam riu,” saamei chu lo!",
            "Meic kathuicna lungh neihlaa thau diu:",
            "Lwmsiimei maekna Kata laa tho,",
            "Nyan la ri tho, guang tho!",
            "",
            "3 Kamei ’niu pangc khou ’taw hei bam e,",
            "Piu o, dwan gay nimei Kalatdanv;",
            "Chu lo, Kakhwan 1<~ niamhna thanv e:",
            "“Anacthiu, guang ni cho?”"
          ]
        }
