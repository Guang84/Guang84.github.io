          "format": "source-lines",
          "lines": [
            "1 Laanc kauh thau o, tingsaeng raengcmun guay,",
            "Hymdaihmei Guangc tat gut pw the;",
            "Kauh liangmei guangc bamvpaeng khou ku khang,",
            "Theihmei lev paapc ta ngammei pu.",
            "",
            "Hymdaih Guangc kiu thow 2}? cho?",
            "’Niu ta zauczihmei ta ngammei pu,",
            "Latzan khou ’niu phaan lynmei pu,",
            "Kros ruc khou rih ngamloumei pu,",
            "Kamei hymdaihmei Guangc e. (2)",
            "",
            "2 Kamei }?2 kandih hei damclou e,",
            "Duipui chung khou suamc thaulou e;",
            "Seitaan ricmei guay ta ngamlou the,",
            "Kros khou Kazei keylou nungc 2}?.",
            "",
            "3 Thow }?2 Katuang chyng khou ku ngam ni?",
            "Thow }?2 Kahu khou ding ngam ni?",
            "Kalvari zeipuak khou lowmei nunc,",
            "Zauzian }?2 thuakloumei nunc e.",
            "",
            "4 Lwmmei mik }?2 ’taw nic how ngam e,",
            "Pu bamvpaeng khou bammei Guangc ta;",
            "Kakhang guanghdic laa khang key nimei",
            "Khuangc ganv ta Kamei ’khwan bam e."
          ]
