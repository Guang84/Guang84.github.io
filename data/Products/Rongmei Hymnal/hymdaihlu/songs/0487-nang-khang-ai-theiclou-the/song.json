        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang khang Ai theiclou the,",
            "Azei luangc keylou the;",
            "Nang ta thuakpatlou khang,",
            "Theihmei tiiringclou khang,",
            "Nang khang ^&8 Apanty tii the,",
            "Nang tabui tiipat cho?",
            "",
            "2 APu kai gaanhmei lev",
            "Guangh bamvpaeng gaanhmei 8^&,",
            "Ai ganclou duc lana",
            "Kandih khou hei key the;",
            "Nang khang ^&8 hei guay ganc lou the,",
            "Nang tabui ganclou cho?",
            "",
            "3 Nang ^&8 saa ngam makmei",
            "Ryanra Ai akhaengv the,",
            "T’ruaih khou ^&8 thuaklou khang,",
            "Alung bakna ’khaengv the;",
            "Hei guay nang khang ^&8 ’khaengvlou the,",
            "Nang tabui ’khaengvlou cho?",
            "",
            "4 Ringh khang ringhbamv nsaa,",
            "Tingkauh thangc ^&8 phungc key;",
            "Kuakloumei lev zauzian",
            "Ai ^&8 phungc key tuang e,",
            "Nang khang kunghmei kaipat phungc key,",
            "Nang tabui phungc guang cho?"
          ]
        }
      },
