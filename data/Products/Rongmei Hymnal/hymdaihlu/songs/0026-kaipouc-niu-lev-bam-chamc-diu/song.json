      "rongmei": {
        "language": "rongmei",
        "title": "Kaipouc ’niu lev bam ’chamc diu",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaipouc, ’niu lev bam ’chamclou diu,",
            "’Niw guang kaduaipui sik;",
            "Meic guay chuzaenghmei laatow diu,",
            "Aniw tatpat mak khou.",
            "",
            "2 Kaipouc, ’niu lev tat ’chamclou diu,",
            "Kaibiak ’zwan dat pwkhou;",
            "Reih rei bam khou p’ry rac pwkhou,",
            "’Niu Ravguangc daeng tuanc diu.",
            "",
            "3 Kaipouc, ’niu lev bam ’chamlou diu,",
            "Zing key pwkhou nganvna;",
            "Kamei ’niu khang gaanhmei sw diu,",
            "’Niu kai Ginpu sw diu.",
            "4 Kaipouc, ’niu lev bam ’chamclou diu,",
            "’Niu ziprii tatpui nganv;",
            "’Niu kaikhunc guay ta gaeklou diu,",
            "Pumtan tiiluanlou diu. Amen."
          ]
        }
      },
