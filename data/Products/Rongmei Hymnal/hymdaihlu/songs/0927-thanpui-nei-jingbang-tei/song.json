        "title": "Thanpui nei jingbang tei",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Thanpui nei jingbang tei,",
            "Ram kaguai rimh rim khou;",
            "Kapui le nga nah dang gan e,",
            "Mangui phungmei thanpui nga nah tei,",
            "Jip bam e reih reina,",
            "Kauh tuang chujangmei khou.",
            "",
            "2. Rimh rimpui jingbang tei,",
            "Laujiu gangmei chu e;",
            "Kauh banchra nun lu hei kumna,",
            "Halleluijah Guangta thuan kho,",
            "Jisu Khrista puan the,",
            "Guloumeipu Jisu e.",
            "",
            "3. Thanpui nei jingbang tei,",
            "Raguang nah jianmei riu;",
            "Thanmei nang jau khou ({0 gan e,",
            "Thuakloumei jaujian lauthuan riu,",
            "Jisu nang puan nung tei,",
            "Jisu nang puan nung tei.",
            "",
            "4. Rimh rimpui jingbang hei,",
            "He ganchuang gan kei o;",
            "Kauh banchra le lusuan cham kho,",
            "Hallleluijah aniu guang khang,",
            "Jisu Khrista puan the,",
            "Guloumeipu Jisu e."
          ]
        }
      }
    },
