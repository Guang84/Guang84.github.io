        "content": {
          "format": "source-lines",
          "lines": [
            "1 Aniu ariw dat khang machunh e,",
            "Kandih panty luai pwkhou;",
            "Zianmei p’ry guang rah khang machunh e,",
            "Gaanc gaymei tingkauh ramc khou.",
            "",
            "Kachaekc kaidai khou,",
            "Gaanhmei tingkauc khou,",
            "Aniu Pu kai khou, neihlaapui dic khou,",
            "Ariw dat khang machunh, khou7?| sowriw dat khang",
            "Rih-ngam hymdaih pyrun run pwkhou.",
            "",
            "2 Aniu ariw dat khang machunh e,",
            "Ringhmei thingbang lym khou 7?|;",
            "Gumei pu ta thuanh khang machunh e,",
            "Gayna phungc guangloumei khang.",
            "",
            "3 Aniu ariw dat khang machunh e,",
            "Gumeipu bamvpaeng hu khou;",
            "Thuakpatloumei rihmei lev k’riu ni,",
            "Thuakpatmei lu suan puni.",
            "",
            "4 Aniu ariw dat khang machunh e,",
            "Kandih ataanv luai pwkhou;",
            "Neihlaamei baanc sin kariu dat ni,",
            "Nganv makna gaanhpui ramc khou."
          ]
        }
      },
