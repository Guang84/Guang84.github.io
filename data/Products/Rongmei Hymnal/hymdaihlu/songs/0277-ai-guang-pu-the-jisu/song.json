        "content": {
          "format": "source-lines",
          "lines": [
            "1 Bangh swmei, ryanra, zinghmei khou )}3,",
            "Ai guang pw the, Jisu Nang khou!",
            "Duakpui bamv neihlaamei, gaanhmei khou,",
            "Ai guang pw the Jisu!",
            "’Naumei khou )}3 Nang tuang pumhgay khou,",
            "Lungcsiimei khou )}3 Nang lunggai khou,",
            "Apaap khou )}3, he Kaipouc,",
            "Nang khou,",
            "Ai guang pw the Jisu!",
            "",
            "2 ’Maanmei, zakmei alwnlung khou )}3",
            "Ai guang pw the, Jisu Nang khou!",
            "Nang tuang kros paan )}3 hymdaihmei khou,",
            "Ai guang pw the Jisu!",
            "Dih sunu khou )}3 tiigaymei khou,",
            "Panty pwanzingh khou )}3 ’thaekcmei khou,",
            "Ryanramei khou )}3 neihlaamei khou,",
            "Ai guang pw the Jisu!",
            "",
            "3 Pian makmei lev liantiimei khou )}3",
            "Ai guang pw the, Jisu Nang khou!",
            "Nang tuang dwan gaymei",
            "chwn khou bam khang,",
            "Ai guang pw the Jisu!",
            "Nang tuang zianmei khou",
            "lungcna bam khang,",
            "Kauh tuang neihlaamei khou neihlaa khang,",
            "Akhouhna kumc samc guang",
            "tingsaeng khang,",
            "Ai guang pw the Jisu!",
            "",
            "4 T’rou ta pingmei khou )}3 duak patna,",
            "Ai guang pw the, Jisu Nang khou!",
            "Neihlaamei gaanhmei Nang kai khou hei,",
            "Ai guang pw the Jisu!",
            "Saa ngam makmei amaanmei khou )}3,",
            "Chuzaenghmei duploupui kai khou hei,",
            "Tingsaeng Nang hymdaih zaw how bam khang,",
            "Ai guang pw the Jisu!"
          ]
        }
