        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kalvari ching ngammei luangbut,",
            "Kauh rihmei guai !@9 thuan ku e;",
            "Mei guai !@9 ni thuanku puni,",
            "Kanloumeipu jei hang !@9na,",
            "Man kanmei guai ta kan lou e,",
            "Hou mumei guai ncham puni.",
            "",
            "2. Ching kapum khang suang kalvari,",
            "Katik kagun dai tap tap be;",
            "Khou tei guloumei dui luang e,",
            "Kandih ram khou hei luang kei e,",
            "Mei kapum ta tiring dat the,",
            "Tingsanga ring nipui dui e.",
            "",
            "3. Pap kuak pui bam kalvari ching,",
            "Mei guai pap khang !@9 thei lou e;",
            "Thei mei guai tei ni ring dat the,",
            "Guloumeipu puan lou khou !@9,",
            "Kandih mei pap khang lou kan the,",
            "Ti chum lou the kandih mei ta."
          ]
        }
      }
    },
