        "content": {
          "format": "source-lines",
          "lines": [
            "1 He khristian ricmei thiu, rih bamv khou gut ro!",
            "Hu thangc tat bammei pu Jisu ta zaucna,",
            "Kaipouc Khrista zaylou, zauczihmei hu khou;",
            "Kachuangcphey 8^& zaucna rih bamv khou gut ro.",
            "",
            "He Khristian ric mei thiu,",
            "Rih bamv khou gut ro!",
            "Hu thangc tat bammei pu",
            "Jisu ta zaucna.",
            "",
            "2 Seitaan ric mei pak ge, Jisu zanc chu khou,",
            "Thau tho khristian ric mei, rih",
            "ngammei chaeng khou!",
            "T’ruaih-ramc guay kadunh e, thuancna kauc pwkhou;",
            "Chana thiu, khwan ranvna thuanhpui u kauc o.",
            "",
            "3 Guangh bamvpaeng lev pyrun",
            "amaan nuh tuang de,",
            "Jisu tuang phwamling mu amaan dat mak khe;",
            "T’ruaih ngamv ^&8 phwamling ta",
            "thingc ngam zat lak ge;",
            "Khrista latryan nai e, mi 8^& suai mak ge.",
            "",
            "4 Hu thangc gut ro, meic nunc aniw khou gut ro,",
            "Ringhbamv lu suan pwkhou lay suan ’chamc di kho,",
            "Hymdaihmei, champouhmei Khrista khang sw diu,",
            "Maansei lev baanch’ra guay",
            "tingsaeng suan bam diu."
          ]
        }
      }
