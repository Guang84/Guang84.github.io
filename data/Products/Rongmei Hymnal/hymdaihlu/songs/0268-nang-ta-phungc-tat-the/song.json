        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang ta phungc tat duc kan the,",
            "Nang thouh swlou mak khou _>6;",
            "Nang ta phungc tat nzaeng zaengna phungc tat the;",
            "Duiluat _>6 phungc gut kan the,",
            "Nang ta zinghmei duipui thangc,",
            "Nang ta phungc tat nzaeng zaengna phungc tat the.",
            "",
            "Nang ta phungc tat the, phungc tat the,",
            "Pingmei, zinghmei duipui thangc,",
            "Nang ta phungc tat the;",
            "Nang Pu nzianmei khou _>6",
            "Swang dwang maekmei zinghmei thangc,",
            "Nang ta phungc tat nzaeng zaengna phungc tat the.",
            "",
            "2 Zauc lo, kai biak thangc riw _>6",
            "Suriak thay khang dinc bam e,",
            "Nang ta phungc tat nzaeng zaengna phungc tat the;",
            "Rungh ’thaekcbamv khou _>6 nang ta",
            "Duh thangc ’zuan ganclou puni,",
            "Nang ta phungc tat nzaeng zaengna phungc tat the.",
            "",
            "3 Kai biak thangc huaymei khwan 6_>,",
            "Chu taan khith khit guang pw the;",
            "Nang ta phungc tat nzaeng zaengna phungc tat the;",
            "He zianmeile, nyan ri tho!",
            "Ric mak khou chulou la tho,",
            "Nang ta phungc tat nzaeng zaengna phungc tat the."
          ]
        }
      }
