        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang chwn karum bam zat rio de,",
            "Tabui bui guang .. sihni;",
            "Zianpui swkaeng bangc khou bam o,",
            "Ravguangc kadan .. lou ni!",
            "",
            "Rav .. guangc .. kadan .. lou ni!",
            "Tingmik kathuic .. chaeng kathuic khou,",
            "Ka .. mei .. kadan .. lou ni!",
            "Ravguangc kadan .. lou ni!",
            "",
            "2 Ryanra khou lungning ’suan pwkhou,",
            "Ravguangc kadan .. lou ni!",
            "Nang chaeng khou theih chaengkhaek nai khou,",
            "Ravguangc kadan .. lou ni!",
            "",
            "3 Nang kahawmei Kamei tii ni,",
            "Ravguangc kadan .. lou ni!",
            "Nang neymei guay tiilou puni,",
            "Ravguangc kadan .. lou ni!",
            "",
            "4 Nang pammei guay lev bam phakna,",
            "Nang raana bam .. sii khou,",
            "Lungh kabiumei tii ’chulou ni!",
            "Ravguangc kadan .. lou ni!",
            "",
            "5 Tabui ’bui tuang pat pw sihni,",
            "Ravguangc kadan .. lou ni!",
            "Lakmei, Kangaengv khou ngangvlou tho,",
            "Ravguangc kadan .. lou ni!"
          ]
        }
