        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guangh ta kalum o, he ’thanmei nuncle,",
            "Neihlaana thuanc o, Kangamv Kazauzian khang;",
            "Aniu rilin e, gaekloumei Racguangc e,",
            "Chingkhiuhmei kauh kai khou thwan chung khou bam e.",
            "",
            "2 Kangamv dinc ’dauh o, Kazauzian suan o,",
            "Gaanhmei Kapwan e, Kakairuak tingpuk ge,",
            "Kakhei Kaliak ramgai guigay muigay e;",
            "Kalwnlung hei baantanc rilianghmeipu e.",
            "",
            "3 Nang ramkadanlou, ’kumhna rac ngam ni?",
            "Mi hei lyanlou e, mpwan khou, gaanhmei khou;",
            "Chyng thangc duithuak khou @<4 zaengc khou luangc key e,",
            "Zikdui khou, tingthw khou mi hei riu key e.",
            "",
            "4 ’Suanmei, ngam makmei, ’phuammei maansei nunc,",
            "Nang khou ’niw lwm e, Nang thu suai zat mak ge;",
            "Nang zauzian adih gay, adih ngam tu cho!",
            "Damclou, gaeklou, thuakloumei Kaipouc, ’niw Duang!"
          ]
        }
      },
