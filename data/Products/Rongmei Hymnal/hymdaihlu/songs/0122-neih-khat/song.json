      "rongmei": {
        "language": "rongmei",
        "title": "NEIH KHAT",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neih khat thuanhmei @{4 tingkauh padik khwan e,",
            "Neih khat kandih hei paapc @{4 zingc bam khou,",
            "Jisu @{4 keyna liuchang khou puanclou e;",
            "Meic pang khou lungcna gaymei khei lyanlou.",
            "",
            "",
            "Ringcna zianlou e, theicna gulou e,",
            "Phuplouna apaap phungc ganclou kan the;",
            "Ringcthau datna ata tii-nzihlou e;",
            "Neih khat key dat ni,hymdai liangpui neic!",
            "",
            "2 Neih khat Kata Kalvari thangc zay tat re,",
            "Neih khat thing ruc khou Kata hianbinlou,",
            "Malaa, ganc patmei, ryanramei ’khaengv khwan e,",
            "’Niu paap phungclou e, Thuakloumeipu @{4.",
            "",
            "3 Neih khat Kata t’rou khunc @{4 khaam ding ngam mak,",
            "Neih khat roukhamtauc thuira pat kan the;",
            "Kamei ringcthau the, theihmei ta ngamlouna,",
            "Tingkauh ku kan the, aPoubauhmei 4@<!",
            "",
            "4 Neih khat key dat khang trampet amuan puni,",
            "Neih khat kariw @{4 tingpuk gaanc puni;",
            "Zianmei nunc ta ’duanghna Kamei key puni,",
            "Hymdaihmei Jisu, ata Gumeipu!"
          ]
        }
      },
