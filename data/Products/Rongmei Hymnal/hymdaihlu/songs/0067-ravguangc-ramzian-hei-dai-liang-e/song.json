    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Ravguangc ramzian hei dai liang e",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc ramzian hei daic liang e,",
            "Baley >|3 saa tangc thuy mak ge!",
            "Kauh liangmei gaanchuangc ta rii e,",
            "’Naa liangmei t’ruaih nganv key tangc e!",
            "’Khuaimei gaanv nei ’bum key khwan e,",
            "Ravguangc KaNac tiilou,",
            "Jisu hei >|3 zay kariulou,",
            "Kapaap khou >|3 kuaklou.",
            "",
            "",
            "Ravguangc ramzian adih daic cho!",
            "Adih kha ’than cho, ngam cho!",
            "’Thanmei nunc lev baanch’ra nunc lu,",
            "Mi hei tingsaeng suan ni.",
            "",
            "2 Kandih ting hei luai guang pwkhou,",
            "Kandih guanghdic guay ’maan pwkhou,",
            "’Taw hei huayney zihmei nunc >|3",
            "Chyng lev taudaic khou kauc puni;",
            "Khou kiu nganvna Ravguangc ramzian",
            "Kachanh makna nai ni,",
            "Adam kikta thuakloumei hei",
            "’Thanmei nunc lu sw ni.",
            "",
            "3 Duipui dui ta muk sw sihni,",
            "Tingpuk tihei che sw sihni,",
            "Thingchiang guay koluam sw sihni,",
            "Meic kapwmna >|3 hy sihni,",
            "Ravguangc ramzian hei hy pwkhou",
            "Duipui hei thip puni;",
            "Tingpuk tin lou padik sihni;",
            "Kazihlou chan lak ge."
          ]
        }
      },
