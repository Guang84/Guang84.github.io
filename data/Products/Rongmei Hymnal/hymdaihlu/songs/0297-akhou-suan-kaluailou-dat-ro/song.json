          "format": "source-lines",
          "lines": [
            "1 Akhou suan kaluaihlou dat ro,",
            "Ch’rynmei Ringhmei Lat 1<:!",
            "Karamgai tiithay ’bulou o,",
            "Ch’rynmei Ringhmei Lat 1<:,",
            "He Ringhmei, Gaymei Lat,",
            "Lwmmei taanv dinclou o!",
            "",
            "Gay liangmei Lat! Ch’ryn liangmei Lat!",
            "Gay liang ch’ryn liangmei Lat!",
            "Gay liangmei Lat! Ch’ryn liangmei Lat!",
            "Ch’ryn liangmei Ringhmei Lat!",
            "",
            "2 Guigaymei Khrista {:1 tii e,",
            "Ch’rynmei Ringhmei Lat {:1!",
            "He paapc mei, kawmei kiu ’king o,",
            "Ch’rynmei Ringhmei Lat 1<:!",
            "Ramh guay nsa tiina",
            "Tingkauh ku khang zaengv bam.",
            "",
            "3 Gaychamv kaeng hei kagaengv bam e!",
            "Ch’rynmei Ringhmei Lat 1<:!",
            "Kuakloumei, chuzaenghmei tii e,",
            "Ch’rynmei Ringhmei Lat {:1!",
            "Jisu na {:1 gulou,",
            "’Than suang khang tiiswlou."
          ]
