        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Diakc chuymei chyngbut khat nai e,",
            "Kaidai tuang raengh paengc khou;",
            "Khou7}$ Pou ta hianbin khwan e,",
            "’Niu ta gu khang theiclou.",
            "",
            "2 Karamrianra ’khaengvlou thukh 7}$",
            "’Niu thay tangc thuy mak ge;",
            "’Ki ’niu thay e, ’niu zaeng khang e,",
            "Kamei kros khou theihmei.",
            "",
            "3 ’Niu ta kuaklou khang #^7 theiclou,",
            "’Niu gaymei sw diu khang;",
            "Kunghmei Kazei #^7 gulouna,",
            "’Niu tingkauh ku diu khang.",
            "",
            "4 Paapc manv 7}$ khangclou",
            "khang biuhmei",
            "Baihmei mei maek khwan e;",
            "Kamei na de tingkauh kaikhamv",
            "’Niu khang laanclou ngammei.",
            "",
            "5 He heidi kungcna zianlou the!",
            "’Niu nic Kata zian kho;",
            "Thuakloumei Kazei khou lwmna,",
            "Kataanv ’niu nic taanc kho.",
            "",
            "Optional Chorus",
            "He heidi kungcna zianlou the,",
            "’Niu nic Kata zian kho;",
            "Thuakloumei Kazei khou lwm kho,",
            "Kataanv taanh khang sw kho."
          ]
        }
