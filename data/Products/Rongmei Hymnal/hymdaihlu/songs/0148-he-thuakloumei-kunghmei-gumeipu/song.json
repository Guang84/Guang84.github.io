      "rongmei": {
        "language": "rongmei",
        "title": "HE THUAKLOUMEI, KUNGHMEI GUMEIPU",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kalvari chyng khou ryanra lakna",
            "Gumeipu Khrista tat bam khwan e;",
            "Paapc mei ramthei khou kros khou theih khang,",
            "’Maanmei ta Kamei gulou khang e.",
            "",
            "He Thuakloumei pu, kunghmei Gumei pu,",
            "Nang ta ’taw nganv kros khou how tukumc e;",
            "Zamv phungc, zeiphiangcna ,paapc mei khang huayna,",
            "Kamv khith khit keyna theiclou kanmei!",
            "",
            "2 “Apu, kuaklou tio,” Kamei huay e,",
            "Zei lyamna Kabuc tut key bam khou;",
            "Hei di suc sihni huaylou ngammei",
            "Hei di zian ngammei Jisu na de.",
            "",
            "3 Nang ta ai zian e, Guloumeipu,",
            "Nang ta ai thuanhmei hei kim lak khe;",
            "Kauh thangc tingkwm sing chak dat makna,",
            "Nang ta tingsaengzaeng ai thuanc bam ni."
          ]
        }
      },
