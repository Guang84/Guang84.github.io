        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Poubauhmei khou lwmlou tha?",
            "Gay ranvmei nai di he,",
            "Kazauzian 8^& laa tow tha?",
            "Gay ranvmei nai di he,",
            "Ch’ryn dyng e, Pu ramzian hei!",
            "Gay ranvmei nai di he,",
            "Kazauzian nsaa tiilou,",
            "Gay ranvmei nai di he.",
            "",
            "Nai di he, nai di he,",
            "Gay ranvmei nai di he.",
            "Ch’rynmei Kazauzian kiu e,",
            "Gay ranvmei nai di he.",
            "",
            "2 Jisu ’naa bammei thay cho?",
            "Gay ranvmei nai di he,",
            "Kamei ^&8 tiineihlaa cho?",
            "Gay ranvmei nai di he,",
            "Ch’ryn dyng e, Jisu zauzian!",
            "Gay ranvmei nai di he,",
            "Karamzian nsaa tiilou,",
            "Gay ranvmei nai di he.",
            "",
            "3 Bumaengh ngamv ta nang thay tha?",
            "Gay ranvmei nai di he,",
            "Tingriu kumc riu keyloumei,",
            "Gay ranvmei nai di he,",
            "Ch’ryn dyng e,Bumaengh ngamv hei!",
            "Gay ranvmei nai di he,",
            "Kapumtan nsa tiilou,",
            "Gay ranvmei nai di he."
          ]
        }
