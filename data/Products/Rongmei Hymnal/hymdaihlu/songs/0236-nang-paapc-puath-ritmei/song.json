    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Nang paapc puath ritmei",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang paapc puat ’ritmei phungc liat lak ethei,",
            "Nang lung khou Jisu tiigut ro;",
            "Panty thanh khou nang lungc dat nii ethei,",
            "Nang lung khou Jisu tiigut ro.",
            "",
            "’Taw hei nang lwmsii taan tho,",
            "’Taw hei Kata laalou tho;",
            "’Taw hei kaikhamv laanclou tho,",
            "Nang lung khou Jisu tiigut ro.",
            "",
            "2 Nang ’thanmei panty khou lungc nii ethei,",
            "Nang lung khou Jisu tiigut ro;",
            "Sw ’thanloumei duipuakkai luangc bam e,",
            "Nang lung khou Jisu tiigut ro.",
            "",
            "3 Nang pammei #<8 nang ta ganclou ethei,",
            "Nang lung khou Jisu tiigut ro;",
            "Jisu na hei gay liangmei Pam kiu e,",
            "Nang lung khou Jisu tiigut ro.",
            "",
            "4 Neihlaa zaenggay lu nang suan nii ethei,",
            "Nang lung khou Jisu tiigut ro;",
            "Zaeng ’thaekcmei kai khou",
            "nang lungc nii ethei,",
            "Nang lung khou Jisu tiigut ro."
          ]
        }
      },
