        "content": {
          "format": "source-lines",
          "lines": [
            "1 Baanh lau na nei Jisu khang",
            "taanh khang,",
            "Baley lau na Kata thuanh khang,",
            "Nukuanc lau na nei Kakhwan",
            "’king khang,",
            "Ruak lau na hei lu suan khang e.",
            "",
            "Pou, Nang khou ’niw'guang e,",
            "Alauc ganv panty lauthwan khou,",
            "Pou, Nang khou ’niw guang e,",
            "Nang ^&8 ’chamlou khang.",
            "",
            "2 Phay lau na nei laysuic tat khang e,",
            "Tingkauh kai khou tat ku tangh khang.",
            "Mik lau na nei Jisu khang tii khang,",
            "Jisu ramzian p’ry kathai bam khang.",
            "",
            "3 Lungthw lau na Jisu khang tii khang,",
            "Abumaengc Kamei gulou khang;",
            "Panty lau na khat Kataanv taanh khang,",
            "Atuang guay hei Kakhang tii khang."
          ]
        }
