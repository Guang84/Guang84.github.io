        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kamei jailou khou ai tatni,",
            "Kakhou lummei ramgai thai the;",
            "Ai ningtou e akhang dinge,",
            "Kalvari khou thei loumei ta.",
            "",
            "Chorus:",
            "Jisu ata jailou puni,",
            "Jingbang kalan changluan thui khou;",
            "Gailiangmei champan kamei e,",
            "Kalvari ta ai ningtou e.",
            "",
            "2. Kalat dan khou ai neila e,",
            "Karam jailou ta ai pian the;",
            "Kachun hei akhang gailiang e,",
            "Kalvari jei +:1 su than lou.",
            "",
            "3. Huthang ai gutni ping maknga,",
            "Khrista duanglou jang neilana,",
            "Neikhat souriu khang lumgai na,",
            "Kalvarimei pu Jisu ta."
          ]
        }
      },
