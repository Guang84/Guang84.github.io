    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "He adih zingc kan tha",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 He, adih zingc kan tha rey khou abumaengc!",
            "He, adih zaengsiimei lwnlung cho!",
            "Zauzian neicriw souclou,Pou ^&8 alung khou,",
            "Zinghmei tii’maanna tiigaylou the!",
            "",
            "Kalvari nganv akhang ^&8 tatlou kan the,",
            "Kamei tatlou, akhang tatlou;",
            "Kalvari nganv akhang ^&8 tatlou kan the,",
            "Ai duak khang theiclou the.",
            "",
            "2 Kadunhna kalum khwan, paapc mei ai Kata,",
            "Karamkuaklou lam thay mak khwan e;",
            "Zianmei khwan chu guang e, “Lungh kabiu taan tho,",
            "Nang khuay guay kuaklou, pow khangclou the,”",
            "",
            "3 He, ch’rynmei zauzian e! Guloumeipu ^&8",
            "Kaguangc bamvpaeng ganclou ’duc lana,",
            "Kalvari thangc akhang ryanra ’khaengvloumei!",
            "Kazanc tingsaeng thuancna ndauh o!"
          ]
        }
      },
