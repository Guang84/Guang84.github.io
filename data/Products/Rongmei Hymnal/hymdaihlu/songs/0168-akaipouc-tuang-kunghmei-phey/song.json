          "format": "source-lines",
          "lines": [
            "1 AKaipouc tuang kunghmei pheybaan nai,",
            "’Gaw @<4 nsanghlou e,",
            "Karamgai 4^& akhou guang tangcna",
            "Alung tiineihlaalou.",
            "",
            "Chingkhiuhmei kauh Guangc bamvpaeng thangc @<4",
            "Siangloumei dic khou hei,",
            "Gumeipu ata zian langvna",
            "Akhang keylou e.",
            "",
            "2 Kamei ryanra ’khaengvmei 4^& ch’ryn e,",
            "Kanganv tangcna ’khaengvlou;",
            "Katuang kros thukh 4^& makumh pwkhou,",
            "Ai amikdui key e.",
            "",
            "3 Kapheybaan khou tiigaymei ngamv nai,",
            "Guang kahimei guay khang;",
            "Paapc khou ai bowloupui ganv ’thuic khou",
            "Ata zaythaulou e.",
            "",
            "4 Hymdaih pheybaan piuna key dat ni,",
            "Kauh kaikhamv laanclou khang;",
            "Khou4^& akai tingkauh khou gutna",
            "Tingsaengzaeng ai lungc ni."
          ]
        }
