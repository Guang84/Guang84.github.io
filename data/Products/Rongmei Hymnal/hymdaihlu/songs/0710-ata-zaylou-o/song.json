        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ata zaylou o, aPu, kai zay guanglou o;",
            "Zingc liangmei ganv khou",
            "nchanvmei !}2 zyn pwkhou,",
            "Alung ta bangclou o, ai maengtat mak khang;",
            "Chaengdaeng khou ai pun key mak khang,",
            "Ata zaylou o.",
            "",
            "Ata zaylou o, aPu, kai zaylou o;",
            "Chaengdaeng khou ai pun key mak khang",
            "Ata zaylou o.",
            "",
            "2 Ata zaylou o, aPu, kai zay guanglou o;",
            "Nang na !}2 zaylou ngam arana tat ngam mak,",
            "Ai neihlaana lay ni, tingsaeng lay bam ni,",
            "Nang tuang zianmei baanc !}2 ata",
            "Kai zay guanglou o.",
            "",
            "3 Ata zaylou o, aPu, kai zayguanglou o;",
            "Ringhting hei luai pwkhou",
            "’tamvpui ganv guang pwkhou,",
            "Tamzinghmei dih khou !}2",
            "tingsaeng zaengthaek khang,",
            "Ata zaylou o, he aPu,",
            "Kai zay guanglou o."
          ]
        }
