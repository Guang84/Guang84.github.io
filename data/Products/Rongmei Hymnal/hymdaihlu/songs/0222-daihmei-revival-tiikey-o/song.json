        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Niw pangc khou guanglou o,",
            "Ravguangc,Kahunungc kumcna;",
            "Dih zin likmei revival dai,",
            "Tii key khang huay e.",
            "",
            "He Pou, revival tii key o,",
            "Daihmei revival 4^&, (2)",
            "He Pou , revival tii key o,",
            "Akhou @<4 tiithaulou o.",
            "",
            "2 ’Niw khou maikwam ngamv sw bakna,",
            "Hacpiang ganclou o;",
            "’Seic ’niw khou maekmei Nang ngamv 4^&",
            "Tiiguanglou dat ro.",
            "",
            "3 ’Niw machunc ravmaengc sw ’maan o,",
            "Paapc sw ’thanlou o,",
            "Nang taanv khou lunghlouna bam khang,",
            "Lungh thanh tiilou o.",
            "",
            "4 Kandih pwm ta Nang khang ngam khang,",
            "’Niw ta ’khavlou o;",
            "Minc nzinh bammei napthai guay",
            "Khuam kaduai ngam khang."
          ]
        }
