        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Ravguangc, thuanc e!",
            "Zianmei Nang Nac zaeng khang,",
            "Theiclouna kauh ku kanmei",
            "Pou Jisu zaeng khang.",
            "",
            "Hallelujah! Nang hym daic diu,",
            "Hallelujah! Amen!",
            "Hallelujah! Nang hym daic diu,",
            "Tiikaluanlou o!",
            "",
            "2 He Ravguangc, thuanc e!",
            "Bumaengh ’Thanmei zaeng khang,",
            "Guloumeipu ta ’niw khou",
            "Kamei dinclou e.",
            "",
            "3 Hymdaihmei sw diu,",
            "Ravguangc Lauziu Nac khou!",
            "Kamei >|3 ’niw paap phungclou,",
            "’Niw ta sw ’thanlou.",
            "",
            "4 Tiikaluanlou o!",
            "Zianmei padiklou o,",
            "Meic kathuic lung kauh mai >|3",
            "Tiichuangclou dat ro."
          ]
        }
