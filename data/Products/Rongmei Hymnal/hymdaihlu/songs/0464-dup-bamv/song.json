        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ngamp’rymeipu Racguangclym khou!",
            "Aniu Guangc Khrista lym khou,",
            "Ai dup bam e, dup bam,",
            "Kaswkaeng lym khou ai dup bam e,",
            "Duppuibamv gay khou ai bamna,",
            "Alung kimna lu suan e;",
            "",
            "Ai dup bam e, dup bam,",
            "Kaswkaeng lym khou ai dup bam e.",
            "Dup bam, (2) Kaswkaeng lym khou ai dup bam e,",
            "Dup bam, (2) Kaswkaeng lym khou ai dup bam e.",
            "",
            "2 Panty pwanzingh ’liu ranv guang khou,",
            "Kakhou anaa ranv guang e,",
            "Ai dup bam e, dup bam,",
            "Kaswkaeng lym khou ai dup bam e;",
            "Kazauzian khou ai dup bam khou,",
            "Chuzaenghmei Kamei tiilou;",
            "Ai dup bam e, dup bam,",
            "Kaswkaeng lym khou ai dup bam e.",
            "",
            "3 Apanty, ataanv, aramzian,",
            "Atuang guay Kakhou phungc guang",
            "Ai dup bam e, dup bam,",
            "Kaswkaeng lym khou ai dup bam e;",
            "Ata gayna zaylou puni,",
            "Kauh thangc mi lu suan mak saanv;",
            "“Ai dup bam e, dup bam,",
            "Kaswkaeng lym khou ai dup bam e!”"
          ]
        }
