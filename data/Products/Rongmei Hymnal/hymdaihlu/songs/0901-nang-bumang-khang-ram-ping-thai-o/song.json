      "rongmei": {
        "language": "rongmei",
        "title": "Nang bumang khang ram ping thai o",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Nang bumang khang ram ping thai o,",
            "Kandih chakin janggai gan o;",
            "Nang bumang hei kungpui tuang e,",
            "Nang poubaumei khou lum tip bo.",
            "",
            "Chorus:",
            "Nban ram hei naang kaai ram e,",
            "Chang khan loupui kai de ning o;",
            "Nban chakin guai gan lana,",
            "Nang bumang ring khang lunglai tho.",
            "",
            "2. Seitan !-2 nangta kao bam ,",
            "Pap guai chakin gan lou ngam o;",
            "Nang bumang !-2 kung pui tuang e,",
            "Nang bumang khangram ping thai o.",
            "",
            "3. Seitan !-2 nangta khuan bam e,",
            "Gai makmei pap tan dat ri tho;",
            "Nang bumang r!-2kung pui tuuang e,",
            "Nang poubaumei khou huainei o."
          ]
        }
      },
