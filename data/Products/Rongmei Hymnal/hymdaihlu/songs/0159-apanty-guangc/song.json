        "content": {
          "format": "source-lines",
          "lines": [
            "1 Apanty Guangc Nang ta thuanc e,",
            "Nang hym daihmei sw diu;",
            "Sauh pyrun 5^& ai ’muc mak khang,",
            "Kalv’ri khou zaylou o.",
            "",
            "Gethsamani ta ’muc mak khang,",
            "Nang ramrianra ta ’muc mak khang,",
            "Nang zianloumei ta ’muc mak khang,",
            "Kalv ’ri khou zailou o.",
            "",
            "2 Nang ta zaengsiina ’ziloumei",
            "Nang t’rou 5^& lyanlou o;",
            "Baanch’ra guay t’rou ta rigaanv e,",
            "Nang zipna bam khou 5^&.",
            "",
            "3 Meri ^&5 sw kanmei kumcna,",
            "Kaipat Nang khang phungc guang,",
            "T’rou raeng kiu akhou lyanlou o,",
            "Kalv’ri khou zaylou o.",
            "",
            "4 Pou, Nang khang tingmik ’thuic kros hei",
            "Ai phungc niina phungc ni,",
            "Ai nic Nang khang ryanra ’khaengvni,",
            "Nang akhang ’khaengvlou kumc."
          ]
        }
