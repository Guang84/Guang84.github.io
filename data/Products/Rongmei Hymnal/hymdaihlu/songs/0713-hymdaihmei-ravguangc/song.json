        "content": {
          "format": "source-lines",
          "lines": [
            "1 Hymdaihmei Racguangc,",
            "Ringhmei gaanhmeipu,",
            "Nang bamv hu khou khuksunna (2)",
            "Thwan chakhwang phungc guang,",
            "Nang hu khou he Guangh,",
            "Nang hym daihmei ta thuancna. (2)",
            "",
            "Chakhwang hymdaihmei sw diu Nang zanc,",
            "Tingsaeng ringhmei ngamp’rymei Racguangc,",
            "Ch’rinmei Nang ngamv ta kauh thangc thuakloumei nunc",
            "Thuancna bam e, zingbangcnic kalaanv nic;",
            "Tingpuk kandih duipui <~1 Nang zanc",
            "Tingsaeng thuancna bam e, he Ravguangc;",
            "Kauh Guangc bamvpaeng khou dunghmei",
            "Ngamp’ryrimei Racguangc.Amen. (8)",
            "",
            "2 Gaanv Thumh Khat Ravguangc,",
            "Tingsaengzaeng nganvna,",
            "Zaatc guay Nang daeng ding huamcna (2)",
            "Khwan ranvna thuanc ni,",
            "Guangh guay Guangc Nang ta:",
            "Baanch’ra nunc nic lay suan ni. (2)",
            "",
            "3 Tingkauh thangc bammei,",
            "Ngamp’rymei Racguangc;",
            "Thwan guay hei Nang khang sw diu (2)",
            "Chingkhiuh e, Nang hei,",
            "Tingsaeng guanghtu ni,",
            "He ’chumhmei tingkauh",
            "Racguangc. (2)"
          ]
        }
