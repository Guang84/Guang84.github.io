          "format": "source-lines",
          "lines": [
            "1 Guangh pyrun runlou o,",
            "Guangh Lauziu Nac py khou,",
            "’King o, kauh bamvdaih Lu ramgai!",
            "Lu baihmei guay ta bin e,",
            "Thau suan tho, he alung,",
            "Nang khang theihmei pu zanc,",
            "Thuanc o, saa ’da lakmei",
            "Guangc ta,",
            "Tingsaengc kanganv maekna.",
            "",
            "2 Kaipouc khou runlou o,",
            "Kabaanc kanaek zauc o,",
            "Kazam guay 1<: ’taw nganv thay e,",
            "’Taw hymdaic bam sihni,",
            "Tingkauh Baanch’ra sihni,",
            "Zamv 1<: zauc Ngam makna",
            "Kaniw zaw 1<: ’khum key bam e,",
            "Ch’rynmei kazam hu khou.",
            "3. Guang pyrun runlou o,",
            "Chuzaenmghmei Guangc py khou;",
            "Dihpy Dihba suc rih maekna",
            "Kata thuanc bam ni the;",
            "Kaguangcdic mut lak khe,",
            "Kaphaypav zam khou {:1",
            "Paradais mwnrym gaymei 1<:",
            "Tingsaengzang tiipat bam ni.",
            "",
            "4 Guangh pyrun runlou ni,",
            "Kaganv Kaipouc Nang khou;",
            "Nai bammei guay ta damhmei pu,",
            "Saengc daihmeipu Nang khou!",
            "Thuanc e, thuakloumei pu,",
            "Aniw khang theihmei pu,",
            "Taek makna Nang ta thuanc bam ni,",
            "Tingsaeng kanganv maekna."
          ]
        }
