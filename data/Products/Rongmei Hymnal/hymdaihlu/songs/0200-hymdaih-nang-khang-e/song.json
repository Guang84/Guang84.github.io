        "content": {
          "format": "source-lines",
          "lines": [
            "1 Hymdaih Nang khang e, ringcthau datmei pu,",
            "Theihmei ruc khou Nang #<8 rih ngamlou duc the,",
            "Baanch’ra nunc #<8 keyna roukhamtauc laanclou,",
            "Pou ta ’zipui bamv khou t’rou phey kadiplou.",
            "",
            "Hymdaih Nang khang e,",
            "Ringcthau datmei pu;",
            "Theihmei ruc khou Nang #<8",
            "Rih ngamlou duc the.",
            "",
            "2 Zauc lo, Jisu 8}@ ringcthau dat bam the,",
            "Nang ta ’zianna riu e, ping dat khang maek khe,",
            "Ravguangc tuang phwamling nic rihngam lu suan diu,",
            "Kaipouc ringcthau dat the, theihmei ngam mak khe.",
            "",
            "3 ’Niw lwmsii lak khe, hymdaihmei Guangc Nac,",
            "Nang paan hamhna ’niw hei ramh khat sic ngam mak,",
            "Ngammei nunc suangc ngammei ’niw ta swlou o,",
            "Jordan dui zay kaanna kai zay guanglou o."
          ]
        }
