        "content": {
          "format": "source-lines",
          "lines": [
            "1 Huaypui ganv suaihiam ganv e,",
            "’Niu lung niamh key khou hei;",
            "Guloumeipu, Jisu pamv khou guang kaduaina,",
            "Lwmna Kakhou huay pwkhou",
            "Kamei suaihiamlou e;",
            "Puc gaymei e lakmei khang!",
            "He adih gay tu cho!",
            "",
            "Huaypui ganv gaymei!",
            "Huaypui ganv gaymei!",
            "Huaypui mei khang tiilou e!",
            "He adih gay tu cho!",
            "",
            "2 Huaypui ganv suaihiam ganv khou,",
            "Jisu ’niu daeng ’naa guang;",
            "Kadanna Kamei nunc lat chu khang Kamei guang;",
            "’Niu ryanra guay Kapamv khou",
            "Tiigut khang saalou e;",
            "Puc gaymei e lakmei khang!",
            "He adih gay tu cho!",
            "",
            "3 Huaypui ganv suaihiam ganv e,",
            "’Thiam tiangchanhpui ganv khou,",
            "Gumeipu khou ’niu ryanra guay poulou pwkhou,",
            "Kamei #^5 kadanlou e;",
            "’Niu rianra laa ganclou;",
            "Puc gaymei e lakmei khang",
            "He adih gay tu cho!",
            "",
            "4 Huaypui ganv suaihiam ganv khou,",
            "Lwmgayna ney pwkhou,",
            "Aniu #^5 neymei suaihiam 5#^ laa tow changh e;",
            "Neihlaamei padik pwkhou,",
            "Ryanramei ’maan puni;",
            "Tiigaylou e, sunumei!",
            "He adih gay tu cho!"
          ]
        }
