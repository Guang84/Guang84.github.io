    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Hu thangc he kros ricmei thiule!",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Khrista khang tancbauhmei rih-phyan kage nai,",
            "Rih bamv khou huthwangmei sw khang bamv nai the;",
            "Hu thangc tat gut bam khou, paapc kandic khou hei,",
            "Tingkauh kandic hei ’niu laa nimei swan the.",
            "",
            "Hu thangc, kros rihphyanthiule,",
            "Lwmsii zat riu, lwm tanh tan o;",
            "Hu thangc, kros rih-phyan thiule,",
            "Pou ta lwm o, Kalat piu o,",
            "Hu biak thangc ngam gut tho.",
            "",
            "2 Seitaan $%6 ’niu ta chaeng zay laanh khang ’thiam e,",
            "’Ki ’niu ta zianmeipu paan $%6 ’niu ngam ni;",
            "Bauhmei rih-phyan baihmei nunc kahu nungc 6$%",
            "Mi chaenglwan tatna kaniw kai tangc kan the.",
            "",
            "3 ’Niu nic baucna chaenglwan hei tat ku di kho,",
            "Jisu ta zauc kho, changkhaanvna huayney kho,",
            "“Khrista Kaipouc e,” twna chuangh khou daanc kho,",
            "Hosanna ’niu kauh khou Seitaan bow puni."
          ]
        }
      },
