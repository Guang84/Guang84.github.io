        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc Bumaengc chulou na ro,",
            "’Niw lung khou lungclou o;",
            "Nang ngamv guay phungcna",
            "keylou o,",
            "Guanglou o, Bumaenghle.",
            "",
            "2 Gaanhmei swna guang lyanlou o,",
            "’Niw khou gatmei guay 2}?;",
            "’Thanmei panty lwnlung khou 2}?",
            "’Niw ta tiilungclou o.",
            "",
            "3 ’Niw lung ti hei raw ’thanlou o,",
            "Ravcha tuang maibwang kumc;",
            "’Niw lung hei ravkatpuat sw diu,",
            "Thuakloumeipu Nang khang.",
            "",
            "4 Akhouhna kumc Nang guanglou o,",
            "Chuzaenghmei sw laemvna;",
            "Dih khou Nang tuang phwamling",
            "guay hei",
            "Kauh thangc kumc gay kan diu.",
            "",
            "5 Guang o, mpwan kumc ’liu key o,",
            "Penticost nungc kumcna;",
            "Ntumei kikta kaguay hei",
            "Nang hym daihmei how diu."
          ]
        }
