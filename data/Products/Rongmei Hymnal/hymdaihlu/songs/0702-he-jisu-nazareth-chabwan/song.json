          "format": "source-lines",
          "lines": [
            "1 He Jisu, Nazareth chabwan,",
            "Guang nimei ric khang chamdaanv khang",
            "Meic guay lung khou tiihowlou o,",
            "’Thuihmei ’thanmei Nang panty ta.",
            "",
            "2 He Khrista Nang Latkaeng paan ^&8",
            "Galili ta tii chingkhiuhlou,",
            "Tiiduak ngammei Nang Lat tihei",
            "’Niw lung khou tiichingkhiuhlou o.",
            "",
            "3 He ryanra khaengvmeipu Jisu,",
            "Zianpui zaeng kros khou theihmeipu,",
            "Nang rianra 8^& nsaa hamh e,",
            "Nang zauzian khou ’niw lwm pwkhou.",
            "",
            "4 He padikmei panty Kaipouc,",
            "Puanhmei khou ^&8 rih ngammei nganv,",
            "Nang ta phaengcna ’niw huayney e,",
            "Nang ngamv 8^& ’niw khang tiilou o."
          ]
        }
