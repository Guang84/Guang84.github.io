        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nuh the ai ryanra ryanriu khaengv khang,",
            "Nchanv pwkhou ding khang;",
            "Nuh the kailuangc khou ai bam lana",
            "Baihmei ta thouc lyn khang.",
            "",
            "Nuh the tat khang, nuh the bam khang,",
            "Nuh the athouc taanh khang,",
            "Nuh the nthyammei daihmei taanh khou,",
            "Kamei ningmei taanh khang.",
            "",
            "2 Nuh the tatpat khang, puatrith phungh khang,",
            "Changkhaanvna huay bam khang,",
            "Nuh the matat khat ’khwannabam khang,",
            "Achaeng laanclou mak saanv.",
            "",
            "3 Nuh the saa pat khang, makumh bam khang,",
            "Lungh lev chwn kapwm @<4;",
            "Langloupui bamv khou ai ding bam khang,",
            "Kamei ningmei taanh khang.",
            "",
            "4 Nuh the dinc tat khang, ’chamlou bam khang,",
            "’Maanmei khang huay bam khang,",
            "Nuh the ringc bam saanv, theihpuinganvna,",
            "Kamei guang dat mak saanv."
          ]
        }
