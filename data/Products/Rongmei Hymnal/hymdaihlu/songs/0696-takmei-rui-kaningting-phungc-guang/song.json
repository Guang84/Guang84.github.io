        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Taw chabwan ganv gay khou",
            "Pumtan zaucgay bam khou,",
            "He lungning guay Kaipouc,",
            "Nang khang",
            "Katgut re, ’niw panty,",
            "Laalou o, ’niw kaipat,",
            "Piulou o, ’niw guay ta,",
            "’Niw ringcting saanv chaenglwan",
            "guay khou,",
            "Nang chwn khou ’niw lungh khang.",
            "",
            "2 ’Chamlou o, kabamv ’thuic,",
            "Nang hu khou kum lungh khang,",
            "Nang }?2 ’niw khou kahawmei guay",
            "Neihlaana taanc bam khang,",
            "Daihmei na phu makna",
            "Liwmei malaa makna,",
            "’Niw taanv guay Nang khang de twna",
            "Taanc chuy taanc daic thau khang.",
            "",
            "3 ’Chamlou o, ’niw zian khang,",
            "’Chumhmei, gaymei, ’thanmei,",
            "Matat khat sic ’niw lungning khou",
            "Siimei chwn tiinai rio;",
            "’Niw khou ngamv tiilou o,",
            "Tanc-baucna ding ngam khang,",
            "’Thanmei puat guay ta kahaw",
            "khang,",
            "Siimei ta karaeng khang.",
            "",
            "4 He Khrista Bumaengcle,",
            "’Niw ta katiulou o,",
            "Zianthaymei, kauh liangmei lwnlung",
            "’Niw guay lungc tangc ngam khang,",
            "’Niw ta chamdaanvlou o,",
            "Daic ranvmei panty khang,",
            "’Niw Pu kai khou ’kamh dat lakmei,",
            "Tingsaeng panty nganv khang.",
            "Amen!"
          ]
        }
