        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu Nang mei nunc kaduai khou,",
            "Nang zauzian bamvpaeng ta how e,",
            "Nang ta phu pui sik phutow e,",
            "Kabamv ’thuic hei ’thanmei bamv de.",
            "",
            "2 Nang ta ngaengsaengc ?|7 khamv mak ge,",
            "Niamhmei lung khou Nang lungclou e;",
            "Kaniw guang khou Nang ta phungc guang,",
            "Tatpat dat khou kai phungc tat re.",
            "",
            "3 Kapahloumei ta gaenghmeipu,",
            "Reynungc ramzian tiiluanlou o;",
            "’Khwan bammei nunc khou saalou o,",
            "Thuakloumei Nang zanc ramgai 7?|.",
            "",
            "4 Huayneymei ngamv ’niw thay kan diu,",
            "Lwmmei tiitanh khang ’khavlou o;",
            "’Suan keymei ta tiitanc dat khang,",
            "Tingkauh ta ’niw how tangc ngam khang. Amen."
          ]
        }
      },
