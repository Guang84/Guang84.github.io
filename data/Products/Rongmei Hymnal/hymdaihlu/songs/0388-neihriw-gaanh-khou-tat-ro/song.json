        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neihriw gaanh khou tat ro, gaanc chuypui riw khou,",
            "Lauthwan gaanc gay khou, zik keypui zingcbang khou;",
            "Jisu thei lay o, tingmik ’thuic lay gut ro,",
            "Chaeng kapwm Kathei lay o.",
            "",
            "Lay o, .. ’niu Jisu thei lay kho,",
            "Lay o, tingmik pum lay o;",
            "Lay o, zayloupui bamv kathuic,",
            "Chaeng kapwm ’niu Jisu thei lay kho.",
            "",
            "2 Gaanhmei neicriw khou nic, zingh- mei khou punic,",
            "Lauphunhswan ganv khou pw, chakaanv khou punic,",
            "Kaipouc kawmei ’king o, Kalat hei piu o,",
            "Chaeng kapwm Kathei lay o.",
            "",
            "3 Kachaekc neicriw khou nic, zinghmei swng khou nic,",
            "Pwanzingh taanc guang khou nic, pwanzingh maek khou nic,",
            "Kazauzian khou lwm o, tingmik luai mak saanv,",
            "Chaeng kapwm Kathei lay o."
          ]
        }
      },
