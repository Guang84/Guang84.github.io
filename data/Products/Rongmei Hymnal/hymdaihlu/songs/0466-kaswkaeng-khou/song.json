        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaswkaeng khou ai giuga makna bam e,",
            "Zingc ranv guang sihni, pwanzingh ranh sihni,",
            "Ata gulou puni twmei ai lwm e;",
            "Ata thuaklou the, ai Kanac di the.",
            "",
            "Kaswkaeng khou, zianmei khou _>6",
            "Thou _>6 tii ’tamv ngamna cho?",
            "Kaswkaeng khou abumaengc dup ni,",
            "Giuga makna dup bam ni.",
            "",
            "2 Kaswkaeng khou ryanra khou duppui bamv e,",
            "Khou6_> zaeng ’thaekc khang adih machunh cho!",
            "Dih khou ata tiigay khang puc maek pwkhou,",
            "Khou 6_> ata swmlou, tiigaylou e.",
            "",
            "3 Kaswkaeng khou neihlaamei hei ch’ryn tuang e!",
            "Panty ryanra nai saanv dup bam ni the;",
            "Siimei _>6 ata kabiu dat ngam mak khe,",
            "Jisu khou zaeng ’thaekclouna",
            "ai duak the.",
            "",
            "Rev. W.O. Cushing"
          ]
        }
