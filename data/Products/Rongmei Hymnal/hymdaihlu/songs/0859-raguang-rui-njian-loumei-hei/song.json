        "content": {
          "format": "source-lines",
          "lines": [
            "1. Raguang #!7 njian loumei hei,",
            "He adi nthuk cho, adi nthuk cho?",
            "Sangam makmei thuk pui jaujian,",
            "He adi nthuk cho, adi nthuk cho?",
            "",
            "Chorus:",
            "He adi nthuk cho (2), adi nthuk!",
            "Raguang #!7 njian loumei hei;",
            "He adi nthuk cho, adi nthuk cho?",
            "",
            "2. Kanpat lou the tingsangjang khang,",
            "He adi nthuk cho, adi nthuk cho?",
            "Kanpat louna tithan lou the,",
            "He adi nthuk cho, adi nthuk cho?",
            "",
            "3. Tabui khang tithai mak tu cho?",
            "He adi nthuk cho, adi nthuk cho?",
            "Kandih mei jat guaina khang e,",
            "He adi nthuk cho, adi nthuk cho?",
            "",
            "4. Jao njian lou pui tuang guai hei,",
            "He adi nthuk cho, adi nthuk cho?",
            "Man nimei nun #!7 thai ngam mak,",
            "He adi nthuk cho, adi nthuk cho?"
          ]
        }
      }
