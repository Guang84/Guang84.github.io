        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai thay tangh mak Ravguangc zauzian,",
            "Akhou tiithayloumei,",
            "Ai kumhmei biuh makmei tahei,",
            "Kamei kawlou pwmei!",
            "",
            "Tiki ai lwmmei pu ta thay e,",
            "Kakhou ai nsinlou kanmei guay 3)^",
            "Heipui neic nganv gaeklou ngam e,",
            "Twmei hei ’thanna thay e.",
            "",
            "2 Ai thay tangh mak Gumei ramlum",
            "Akhou tiilou tu cho?",
            "Kalat lwmpui paan )}3 ’kumhna",
            "Chuzaenghmei laa tow cho?",
            "",
            "3 Ai thay mak Bumaengh )}3 ’kumhna,",
            "Paapc lam dinclou tu cho,",
            "Baibal lat paan )}3 Jisu khou,",
            "Ata tiilwmlou cho!",
            "",
            "4 Ai thay tangh mak Kaipouc ’bui nungc,",
            "’Bui khou, ’kumhna key ni;",
            "Ai theic tang khou key puni ny,",
            "Ringcna sowriw ni cho?"
          ]
        }
