          "lines": [
            "1 Ai suan ni Khrista akhang ({0",
            "Theicloumei ch’ynmei p’ry hei;",
            "Hymdaihmei Kakai ganclouna,",
            "Kros khou theicloumei p’ry e.",
            "",
            "Ai suan ni Khrista akhang ({0",
            "Theicloumei ch’rynmei p’ry hei;",
            "Ai suan ni kauh ’thanmei nunc lev",
            "Kangranmei duipui paengc khou.",
            "",
            "2 Ai ruan ’maanmei lauziu khwan e,",
            "Jisu ({0 phutow datna,",
            "Zianpui baanc ({0 ata pamclou,",
            "Kachaeng khou ata zaylou.",
            "",
            "3 Bow katupna ai kabiu khou,",
            "Jisu ({0 tiigaylou the;",
            "Mik tiatna pingna bam khwan e,",
            "Jisu ({0 tiiduaklou the.",
            "",
            "4 Aruc khou siimei guang bam e,",
            "Ryanrapui chaeng tat bam e;",
            "Kum sihni Pou ({0 ’duangh bam e,",
            "Kabaanc ({0 zaylou bam e."
          ]
        }
