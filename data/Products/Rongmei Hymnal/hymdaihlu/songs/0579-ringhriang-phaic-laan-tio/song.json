      "rongmei": {
        "language": "rongmei",
        "title": "Ringhriang phaic laan tio",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ringhriang phaic laan tio duiluat siimei khou,",
            "Thangc 7}$ meic gaanv saekc dui alip bam the;",
            "Gaanv saekc ’riangluaic the! thow zaucgaylou ni,",
            "Theic ping makna kaniw ta gu khang tat khang?",
            "",
            "Ringriang phaic laan tio! (2)",
            "Gaanv saekc dui nzuan bam the!",
            "Ringriang phaic laan tio! (2)",
            "Gaanv saekc thu limc key bam the.",
            "",
            "2 Ringhriang phaic laan tio, mazatmei baanc #^7,",
            "Chanale, ’bui zaeng hei saan nyan bam cho?",
            "Zauc lo, limc bam the! he katumclou tho;",
            "Ringhriang phaic laan gut tio,",
            "’khap tho, ’seic tat tho!",
            "",
            "3 Ringhriang phaic laan tio, sansiimei nunc 7}$",
            "Nang tat zat makpui bamv thangc limc bam the;",
            "’Thiammei ’pwan lev ryanramei duiluat #^7",
            "Zinghmei zeic kwn thangc phungc gut zaic puni the.",
            "",
            "4 Gulou nuhpui ganv luai zaic puni the,",
            "Tingsaeng duikhuangc thangc phungc ganc nuangc ni the;",
            "’Khap tho, chanale, kaganv maek changh the;",
            "Ringhriang phaic laan gutna ’seic gulou tii tho."
          ]
        }
      },
