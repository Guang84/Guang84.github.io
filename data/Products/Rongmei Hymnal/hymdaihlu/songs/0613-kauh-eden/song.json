        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kauh Eden gaymei nzaengdic khou,",
            "Guloumei guay khou8^& lungc puni,",
            "Ryanra ryanriumei nai dat lak khe,",
            "Mui gaymei nzaengdic tangc pwkhou.",
            "",
            "He Eden .. kathanc 8^&!",
            "Reynungc tuang .. khang suangc gay,",
            "Khou8^& amanv-’baanvthai suang puni;",
            "Pou ^&8 damc thanloumei",
            "Eden khou.",
            "",
            "2 Kauh Eden gaymei nzaengc khou 8^&,",
            "Pwanzingh dic ta hei ’patlou pwkhou,",
            "’Thanmei nunc guang tangc reymei nunc ta",
            "Ariw puni Poubauhmei hu khou.",
            "",
            "3 Khou 8^& ’thanmei nunc ’peyna bam e,",
            "Muhzwng lev martair, guloumei guay,",
            "Alauc nunc guloumei guay 8^& lev",
            "Eden thanh khou thuanhpui lu suan e.",
            "",
            "4 Kauh Eden, Kaipouc lunghpui ramc 8^&,",
            "Kaipouc ^&8 kalwnlung gaanhmei 8^&,",
            "Baanch’ra nunc lev zianmei nunc ta 8^&",
            "How khang 8^& ai ^&8 ’khwan liat lak khe."
          ]
        }
      },
