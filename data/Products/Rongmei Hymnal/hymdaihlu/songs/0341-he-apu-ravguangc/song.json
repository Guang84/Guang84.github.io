        "content": {
          "format": "source-lines",
          "lines": [
            "1 He aPu Ravguangc, ai huay e,",
            "Ai kai khou ?|7 ducna tat khou,",
            "’Chamlou o, alung ?|7 saa khang;",
            "“Nang nyng sw diu!”",
            "",
            "Nang nyng sw diu!",
            "Nang nyng sw diu!",
            "’Chamlou o, alung ?|7 saa khang;",
            "“Nang nyng sw diu!”",
            "",
            "2 Tat rey kanmei zianmei nunc khang",
            "Zaengsii thiusaengc zayna kap khou,",
            "Khou 7?| sihni kumcna saa ni:",
            "“Nang nyng sw diu!",
            "",
            "3 ’Suanmei ata suaihiamlou o,",
            "Nang Bumaengc 7?| gut bamlou o,",
            "Ramh kapwmna Nang khou tii e,",
            "“Nang nyng sw diu!”",
            "",
            "4 Chwn thanh tiilou o, tingmik ’thuic,",
            "Nang chwn 7?| tiilou o, akhou;",
            "“Nang nyng sw diu!” saa kunghmei guay",
            "Laa ganclou o.",
            "",
            "5 Dih khou athiu laa taan pwkhou,",
            "Mikdui keyna ney taan pwkhou,",
            "Neihlaamei tingkauh thangc suan ni:",
            "“Nang nyng sw diu!”"
          ]
        }
