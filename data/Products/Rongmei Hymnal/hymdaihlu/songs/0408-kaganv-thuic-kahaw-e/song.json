          "format": "source-lines",
          "lines": [
            "1 Kaganv ’thuic kahaw e,",
            "Zauzian Kaipouc;",
            "Tiiswmpui khwan maek ge",
            "Nang khwan kumcna.",
            "",
            "Kahaw e, Guloucmeipu,",
            "Kaganv ’thuic kahaw e;",
            "’Taw ata suaihiamlou o,",
            "Nang khou guang e!",
            "",
            "2 Kaganv ’thuic kahaw e,",
            "Bam tuanclou o;",
            "’Thiammei }?2 ngam mak ge,",
            "Nang bam tuanh khou.",
            "",
            "3 Kaganv ’thuic kahaw e,",
            "Sii khou gay khou;",
            "Guangna bam ’duanghlou o,",
            "Ai ’maan mak khang.",
            "",
            "4 Kaganv ’thuic kahaw e,",
            "Nang chwn dinc o;",
            "Nang latryan ’thukmei 2}?",
            "Tii ’thuihlou o.",
            "",
            "5 Kaganv ’thuic kahaw e,",
            "’Than liangmeipu;",
            "Nang mei ling swlou o,",
            "He Pouc, Jisu."
          ]
        }
