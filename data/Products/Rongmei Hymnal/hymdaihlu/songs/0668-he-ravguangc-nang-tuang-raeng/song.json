        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Ravguangc, Nang tuang raeng khou",
            "Zug hei neih khat kumc e,",
            "Bw, Neih, Gaanchuangc ta kabamv khou",
            "Chaana bam khang duanclou,",
            "Nang khou ’niw pu nunc lwmna,",
            "Duipui kaanna tat re,",
            "’Suanmei kaniw ta ’khavlouna",
            "Nang kandic kasiamh khang.",
            "",
            "2 ’Seic nic mi lungning khou 8}@",
            "Nang nac nunc aniw hei,",
            "’Niw baanc zay thauna ’khwan bam e,",
            "Panty chaengkhaek khou hei,",
            "Aniw chaiclikna tat the,",
            "Meic khat sw khang phuna;",
            "Pumtan Racguangc, Nang ’khavlou o,",
            "Pu nunc Racguangc swna. Amen."
          ]
        }
      },
