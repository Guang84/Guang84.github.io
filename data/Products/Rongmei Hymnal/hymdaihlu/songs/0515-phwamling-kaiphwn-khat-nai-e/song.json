    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Phwamling kaiphwn khat nai e",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Phwamling kaiphwn khat nai e,",
            "Jisu Khrista hei e;",
            "Dui lev Kalatkaeng paan <~1",
            "Kata damc thanhlou the;",
            "Jisu kauh thangc <~1 keyna",
            "Phwamling ta nowpeic khang",
            "Phu tow lana liulou the,",
            "Kazei <~1 thuaklou the.",
            "",
            "2 Zaatc guay khou <~1 kapah e,",
            "Tiki phwam khat na de;",
            "Kaphwam tuang gaymei lwn kiu",
            "KaKaipouc khat na de;",
            "Lwmmei, puanhmei khat na de,",
            "Zanh khat khou kalum e,",
            "Taektw khat na tu ’chamc e,",
            "Machunhmei khat na de.",
            "",
            "3 Chaeng laanhmei <~1 sw kaguakc,",
            "Kaphwam phwam bam sihni;",
            "Meic nunc <~1 Kalwnlung ta",
            "Malaana bam sihni.",
            "’Thanmei nunc huayna kauc e:",
            "“Pou asaanh kum bam ni?”",
            "Kapmei zingbangc katumcna",
            "Neihlaa lauthwan guanh ni."
          ]
        }
      },
