        "title": "ADIH CH’RYNMEI GULOUMEI PU",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Khrista paapc zaeng khang #<8 theiclou,",
            "Adih ch’rynmei Gumeipu!",
            "Karan tiina ’niu ta ranclou;",
            "Adih ch’rynmei Gumeipu!",
            "",
            "Adih ch’rynmei Guloumeipu cho, aKaipouc hei!",
            "Adih ch’rynmei Guloumeipu cho, Kaipouc hei!",
            "",
            "2 Khiuloumei zei zaeng ai thuanc e,",
            "Adih ch’rynmei Gumeipu!",
            "Ravguangc khou guat tiiswlou the;",
            "Adih ch’rynmei Gumeipu!",
            "",
            "3 Kamei #<8 apaap sw ’thanlou,",
            "Adih ch’rynmei Gumeipu!",
            "Kamei alung khou guanghtu bam;",
            "Adih ch’rynmei Gumeipu!",
            "",
            "4 Kamei adaeng khou lwan tat bam,",
            "Adih ch’rynmei Gumeipu!",
            "Tingmik ’thuic Kalat tiipiulou;",
            "Adih ch’rynmei Gumeipu!",
            "",
            "5 Kamei akhang pumtan tiilou,",
            "Adih ch’rynmei Gumeipu!",
            "Nchanvpui sik ngam khang ’khavlou;",
            "Adih ch’rynmei Gumeipu!"
          ]
        }
      },
