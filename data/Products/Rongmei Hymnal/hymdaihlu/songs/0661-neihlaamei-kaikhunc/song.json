        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neihlaamei kaikhunc, Nang ta",
            "zian liangmei kai,",
            "He Guloumeipu, zian thaymei Kaipouc,",
            "Guangloumei pangc khou ’thuk",
            "liangmei gin swna",
            "Nang ta champouhna swmei kai 3>| e.",
            "",
            "2 Neihlaamei kaikhunc, meic kathuic >|3 Nang ta",
            "Niamhna Nang siamruai swmei kai 3>| e,",
            "Taanvmung kathuic hei daihmei, ’thanmei taanv e,",
            "Kaipouc Nang khang >|3 mi 3>| taanc pwkhou.",
            "",
            "3 Neihlaamei kaikhunc, Nang ta",
            "’muc makmei kai,",
            "Neihlaa zaenggaymei padikmei ganv khou;",
            "Ryanra zaengsii khou Amuh, ’Khavloumei pu,",
            "Nang khou phungclou e swmlou, ’khavlou khang.",
            "",
            "4 ’Khamhpui nungc kandih taanvdwan guay luai pwkhou",
            "Kauh kai khou Nang ta guang sowriw pwkhou,",
            "Nang lev tingsaengzaeng khou 3>| lungc ’chamc puni,",
            "’Zianmei, ’chu-’zaenghmei padikmei kai khou."
          ]
        }
      },
