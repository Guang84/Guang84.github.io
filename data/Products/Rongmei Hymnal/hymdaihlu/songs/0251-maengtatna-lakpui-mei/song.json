        "content": {
          "format": "source-lines",
          "lines": [
            "1 Maeng tatna lakpui mei ’king lo,",
            "Neihlaapui chamv phungc guang e,",
            "Khwmkih khang Jisu laengvlou the,",
            "Guang tho, nang ta riu bam the.",
            "",
            "Guang zihna ley saengc la ri tho;",
            "Jisu nang ta kaw bam the;",
            "Guang tho, ramh guay",
            "chamdaanv luai the,",
            "Tabui khang nyan bam ni cho?",
            "",
            "2 Nang paap 7?| ’ritmei puatphwng cho?",
            "Ravguangc khou ’taw guang",
            "dauh tho;",
            "Kuaklou khang Kamei ’khwan bam the,",
            "Tabui khang nyan bam ni cho?",
            "",
            "3 Jisu tuang zianmei baanc pwam khou,",
            "Ngangvlou tho, ’taw lwmlou tho;",
            "Kamei ?|7 nang ta kuaklou diu,",
            "’Taw guang tho, nyan la ri tho.",
            "",
            "4 Nowsuanh pheybaan gay liangmei 7?|,",
            "Kamei ’taw sinna bam the;",
            "Guang ’khap tho, khwmkihpui bamv khou,",
            "Gut la tho, nyan la ri tho."
          ]
        }
