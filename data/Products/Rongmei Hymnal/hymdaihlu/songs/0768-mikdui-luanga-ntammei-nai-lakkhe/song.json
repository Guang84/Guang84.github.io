      "rongmei": {
        "language": "rongmei",
        "title": "Mikdui luanga ntammei nai lakkhe",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Mikdui luanga ntammei nai lakkhe thei thangmu,",
            "Tingkau kandih Raguang bampui ram guangtangpukhou;",
            "Tingkau kandih gaimei khou neilana guang bam puni,",
            "Tingkau kandih gaimei khou Jisu le bam chamni.",
            "",
            "2. Laujiu Nah nthanmei 6$% hou puni thei thu rui,",
            "Njianmei ntam kanmei guai le bam cham ni;",
            "Kata thuan ku kariu ni hei khou 6$% mikdui kei lakkhe,",
            "Rianra jangsimei guai hei nai lakkhe hei khou 6$%.",
            "",
            "3. Njianmei guai le ntammei hei nai dat lakkhe,",
            "Rianra jangsi pui ram kandih hei nai dat lakkhe;",
            "Lili munpuang gaipui ram tingsanga bampui kankhou,",
            "Mikdui keimei rianramei guai hei nai dat lakkhe.",
            "",
            "4. Mikdui rou ntam kanmei tatreimei arup nun,",
            "Theimei duipang ram gaimei khou 6$% bam cham puni;",
            "Tingsangjanga ntam dat maknga lung bam puni the,",
            "Tingkau ram khou tingsangjang nban thai bam puni,",
            "",
            "5. Hei kandih mu rianramei le kaplou pui bamme,",
            "Panduithinga mikdui luang keilou pui bam dai e,",
            "Bumang kandih gaimei khou neilana ai guang bamni,",
            "Ganphiu gaimei kanloumeipu Guang supui ram khou."
          ]
        }
      },
