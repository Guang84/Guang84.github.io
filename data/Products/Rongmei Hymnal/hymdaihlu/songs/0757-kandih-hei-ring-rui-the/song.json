        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kandih hei ring-rui the,",
            "Kalung khou mansei guaini;",
            "Simei le lungjingmei rui luang lik ngam the,",
            "Njianmei guai le pouPei guai ni man ngam the.",
            "",
            "Chorus:",
            "He laujiu njangmei rui,",
            "Kasiam namthan 7#@;",
            "He abumang nang ni,",
            "Miram gai 7#@ phu o,",
            "Kandih lou du khou rui,",
            "Nang tingsang ram sukhang.",
            "",
            "2. Gaipui ram kasiam the,",
            "He tingsang jang gaipui ram;",
            "Rianra pui ram rih lai guang khuan sini,",
            "Khrista ta lum ethei,",
            "Namdai 7#@ tang puni.",
            "",
            "3. Rei khou pou-pei guai rui,",
            "Hou makpui tuang ram gaimei;",
            "Jei pan khou ruin tau hei ai hou datni,",
            "Ai tat ni pui chang 7#@,",
            "Aguang khrista hei e."
          ]
        }
      },
