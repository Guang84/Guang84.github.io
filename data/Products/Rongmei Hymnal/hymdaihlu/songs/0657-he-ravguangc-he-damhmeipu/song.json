        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Ravguangc, he Damhmeipu,",
            "Nang hu khou ’taw guangmei",
            "Mi nei hei pumh khat sw khang",
            "Nang {:1 damc thaulou e;",
            "Nang hym ndauhna lungc diu,",
            "Nang suaihiam khou lungc diu,",
            "Theihmei {:1 ntamv mak saanv",
            "Nrianhpui lat piu diu.",
            "",
            "2 Eden pic Paradais khou",
            "Maansei khou khuay maek khou,",
            "Pouh-peih Adam lev Eve ta",
            "Pou, Nang {:1 suanclou the;",
            "Aseic mi nei ta hei nic",
            "Pou, Nang {:1 suanclou o;",
            "Reynungc Isaak, Rebeka",
            "Tampy kumc lungc kan diu.",
            "",
            "3 Dih khou Pou, Nang bampui douc",
            "Galili Cana khou",
            "Nowsuanhpui kai khou guanglou;",
            "Nang {:1 suaihiam tiilou;",
            "Suaihiam duipuakkai swlou,",
            "Kakai khou 1<: suaicsamclou,",
            "Mi 1<: kumc hei kai ruc khou",
            "’Taw Nang suaihiamlou o.",
            "",
            "4 He Ravguangc, Suaihiam Kaipouc,",
            "Hei kai tampy thanh khou",
            "Nang suaihiam kathanc thanc khou",
            "Kaikhunh suaihiam sw diu!",
            "Zaengsii-zaenggay kathuic khou",
            "San khou patmei kathuic kiu",
            "Neihlaamei khang chaklou diu!",
            "Kauh tampy maengc nai diu!"
          ]
        }
      },
