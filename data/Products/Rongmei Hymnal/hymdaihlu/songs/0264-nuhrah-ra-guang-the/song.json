        "content": {
          "format": "source-lines",
          "lines": [
            "1 “Nuh rahra guang the,” ’taw lwmlou khang;",
            "“Nuh rahra guang the,” ’taw laalou khang;",
            "’Ki gaanv saekc saa kumc e:",
            "“Seic hamh e, Bumaenghle,",
            "Kadou chaamei nungc }?2",
            "Ai lwmlou ni.”",
            "",
            "2 “Nuh rahra guang the,” ’seic hei guang tho;",
            "“Nuh rahra guang the,” hanc dat ri tho;",
            "Jisu nang ta kaw e,",
            "Baanch’ra nunc ’khwan bam the,",
            "Zianmei nunc huay bam the,",
            "’Maanmei guang tho.",
            "",
            "3 “Nuh rahra guang the,” lautay luai the!",
            "“Nuh rahra guang the,” syang ganv guang the!",
            "Rahramei }?2 biuh mak,",
            "Rahrana ’maan puni,",
            "Rahrana theic ethei",
            "Adih sii cho!"
          ]
        }
      }
