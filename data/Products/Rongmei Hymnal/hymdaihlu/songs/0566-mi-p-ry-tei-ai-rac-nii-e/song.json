        "content": {
          "format": "source-lines",
          "lines": [
            "1 Mik !}2 how makmei tingkauh",
            "P’ry ai raclou nii e;",
            "Jisu lev Kahym lam e,",
            "Jisu ramzian lam e;",
            "Mi p’ry 2^< ai rac nii e,",
            "Mi hei ’chumhpui zaeng !}2;",
            "Mi !}2 alungh tiikwn e,",
            "Baihmei hei kumhmei maek.",
            "",
            "",
            "Mi p’ry 2^< ai rac nii e!",
            "Mi hei alatlu sw ni,",
            "Hymdaih nungc nganv rac bam ni,",
            "Jisu zianmei p’ry hei.",
            "",
            "2 Mi p’ry 2^< ai rac nii e,",
            "Dih p’ry gay liangmei suangc,",
            "Gay liangmei maengc guay khang suangc,",
            "Mi p’ry 2^< ch’ryn liang e;",
            "Mi hei !}2 akhang gaymei",
            "’Peyna taanclou bam the;",
            "Hei zaeng !}2 nang khou ai !}2",
            "’Taw hei raclou tuang e.",
            "",
            "3 Mi p’ry 2^< ai rac nii e!",
            "Rac kaluaih dat nii e;",
            "Mi hei rahpui ganv kathuic",
            "Gay ’bu hay hay thau e,",
            "Mi p’ry 2^< ai rac nii e,",
            "Gaanv saekc chu zat mak he,",
            "Ravguangc lat khou hyloumei",
            "Ringhbamv chamv gaymei hei."
          ]
        }
