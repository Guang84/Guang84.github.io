        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ramh guayna Kaipouc Nang tuang de,",
            "’Niw tuang maek ge, Nang khang kat khang;",
            "Thuanhmei lung ^&5 ’niw katgut re,",
            "Nang tuang, Kaipouc Nang phaypav khou.",
            "",
            "2 Raenghpouc nunc khou Nang chwn tiilou,",
            "Aniw baanc khou Nang taanv ’chamlou,",
            "Maansei nunc chwn, chamvraeng khou ^&5",
            "Nang tuang chamvraeng tiiguang tangclou.",
            "",
            "3 ’Suan khou, maek khou Nang khou ney e,",
            "Kandih tingkauh bam likmei pu,",
            "’Niw dwan gay khang damcloumei hei,",
            "Nang khang neihlaamei taanvdwan e.",
            "",
            "4 Mi ngaengsaengc khou suaihiam lou o,",
            "Kalungc khou Nang gut bamlou o;",
            "Mi kaimun hei ’niw ta Nang khou,",
            "Zayloumei raengcmun sw bam diu."
          ]
        }
      },
