    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "He zang ’thaekc nimei ramc",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 He zaeng ’thaekc nipui ramc tingkauh!",
            "Tabui nungc tangc ni cho?",
            "Tabui nungc aricpwan gancna",
            "Chuzaenghna lungc ni cho?",
            "",
            "Jisu .. guang mak saanv ’niu",
            "Taanc ni .. guang makpui saanv;",
            "Jisu .. guangpui nungc kiu",
            "Tingkauh khou kariu ni.",
            "",
            "2 Kandih khou neihlaamei maek ge,",
            "Chuzaenghmei nic maek ge;",
            "Hei dic mu ryanrapui bamv de,",
            "Khou hei akai maek ge.",
            "",
            "3 Zaeng ’thaekc khang Jisu khou guang e,",
            "Tat dat mak khang saa e;",
            "Zaengswmei kauh kai tangh mak saanv",
            "Kakhou bam khang saa e.",
            "",
            "4 Guloumei pu khou ai guang the,",
            "Ai tat pat dat lak khe;",
            "Theihpui nganv Kathei ai lay ni,",
            "Tingkauh kai tangh mak saanv."
          ]
        }
      },
