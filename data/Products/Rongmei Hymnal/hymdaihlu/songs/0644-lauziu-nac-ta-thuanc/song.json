        "content": {
          "format": "source-lines",
          "lines": [
            "1 Thuakloumei nunc tingkauh khou lu suan bam e,",
            "Kaniw pyrun guay Guangh hu khou lou keyna;",
            "Dih ryanra lev pingmei, siimei guay ’maan the,",
            "Thuakloumei ’thanmei nunc 4@<",
            "lu thanh suan e!",
            "",
            "Lau .. ziu Nac ta thuanc,",
            "Kalvari khou suluaimei pu,",
            "Lau .. ziu Nac ta thuanc,",
            "Tingsaengzaeng ringcbammei pu ta.",
            "",
            "2 He, nthuih kanmei zauzian tuang ch’rynmei lu!",
            "He, namhgaymei padikmei kachaekc ’gaw kuak!",
            "Paapc mei khang theicna ringc datmei pu paan @{4,",
            "Muh lev guangh swna tingsaeng ’niu lungc puni.",
            "",
            "3 Kaniw chy lev pwan sou ’thanmei nunc na @{4",
            "’Thanmei nunc lu khou 4@< lay suan ngam khang de,",
            "He Kaipouc, ’niu tuang paapc guay khiu ’thanlou o,",
            "Hymdaih neihlaa lu 4@< ’taw tii-suanlou tho."
          ]
        }
