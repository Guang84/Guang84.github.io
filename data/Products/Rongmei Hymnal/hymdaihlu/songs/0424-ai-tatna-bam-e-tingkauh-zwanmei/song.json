        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zinghmei paapc chaeng khou ai hei ruan tat saengc bam lak khe,",
            "Mbaanv khou akhang neihlaamei maek;",
            "Tingkauh kai ’zwan tat bammei nu lev tat ’chamc bam e,",
            "Ai tat bam e tingkauh ’zwanmei chaeng khou.",
            "",
            "Ai tatna bam e, ai tatna bam e;",
            "Ai tat bam e tingkauh ’zwanmeichaeng khou;",
            "Kaipouc ({0 kachaekc raengcmun khou ’khwan bammei ta how ni,",
            "Ai tat bam e tingkauh ’zwanmei chaeng khou.",
            "",
            "2 Chaenglwan hei nrum sihni Kamei zay suaklou ni,",
            "Tingmik ’thuic Kariw ({0 gaanclou e;",
            "Ai tat ’chamc ni malaaloumei Jisu ziap nunc lev,",
            "Ai tat bam e tingkauh ’zwanmei chaeng khou.",
            "",
            "3 Hymdaihmei kaidai kiu tingkauh thangc 0({ nai bam e,",
            "Khou 0({ akhang bamv chamdaanvlou e;",
            "Achaenglwan luai guang pwkhou khou 0({ Kata ’riw ni,",
            "Ai tat bam e tingkauh ’zwanmei chaeng khou."
          ]
        }
