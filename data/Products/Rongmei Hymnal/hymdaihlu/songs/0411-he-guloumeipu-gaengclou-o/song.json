        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Guloumeipu, gaengclou o,",
            "Lauziu gaengh kumc gaengclou o,",
            "Nang byn gaymei khou",
            "’duanghlou o,",
            "Nang kuanc khou tiibamlou o;",
            "Gaymei Jisu, gaymei Jisu,",
            "Nang ^&5 ’niw ta liulou the.",
            "",
            "2 ’Niw ta Nang duang tiiswlou o,",
            "’Niw chaeng Nang ^&5 zaylou o,",
            "’Niw ta paapc khou ^&5 gulou o,",
            "Chaeng maanv pwkhou phulou o;",
            "Gaymei Jisu, gaymei Jisu,",
            "’Niw ^&5 huaymei chulou o.",
            "",
            "3 Paapc geic ’suan khwan sihni ’niw ta",
            "Nang laalou ni, ’rianhlou e;",
            "’Khavlou, sw ’than, tiiduaklou khang,",
            "Pumtan, zauzian Nang khou nai;",
            "Gaymei Jisu, gaymei Jisu,",
            "Ngalanc guang e, laalou o.",
            "",
            "4 Alauc khou ^&5 Nang ta phu khang,",
            "Nang ^&5 ningmei phu thau khang,",
            "He guigaymei Guloumei pu",
            "Nang zauzian 5^& tiilou o;",
            "Gaymei Jisu, gaymei Jisu,",
            "Nang zianlou the, zian bam o."
          ]
        }
