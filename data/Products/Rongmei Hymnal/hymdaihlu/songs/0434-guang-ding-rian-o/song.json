        "content": {
          "format": "source-lines",
          "lines": [
            "1 Luanghbut lev chyng kauhmei ruc khou",
            "Gaychamv trampet khwan ’king o,",
            "Lungh tiithaupui khwan 8}@ ’king o,",
            "Latchamv 8}@ meic guay khang e.",
            "",
            "Guang ding rian o, rih adow khang,",
            "Trampet khwan khou kaduai tho;",
            "Guang tho! guang tho!",
            "Guang tho, khristian rihphyan guay.",
            "",
            "2 Khristian ricpwan guay 8}@ piu o,",
            "Hymdaih chuangcphey daanc kauh o,",
            "Chumhmei lev ’zihmei khang ’dow o,",
            "Baanch’ra guay #<8 phaengc bam the.",
            "",
            "3 ’Muan dat ro, kachaekc trampet 8}@,",
            "Rih-’saanvmei khwan ’muan ranv o;",
            "Meic kathuic Jisu khang ‘dow o,",
            "’Niu theic sihni rih ngam ni."
          ]
        }
      }
