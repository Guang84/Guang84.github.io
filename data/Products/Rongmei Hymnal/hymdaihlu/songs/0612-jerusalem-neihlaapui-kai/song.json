            "1 Jerusalem, neihlaapui kai,",
            "Nang ta ai rigwn e;",
            "’Bui nungc ataanv guay hei luaina,",
            "Nang khou neihlaa ni cho? (2)",
            "",
            "2 Tingkauh kachaekc raengc kat gaymei,",
            "’Bui nungc ai how ni cho?",
            "Tanhmei ringhbamv ^&8 swmei raengc,",
            "Kachaekc chaeng how ni cho? (2)",
            "",
            "3 Ryanra lakmei lev theihmei ta,",
            "’Bui khang ai ping ni cho?",
            "Kanaan ramgai 8^& ai how the,",
            "Tingsaeng gaanhmei ramc ta. (2)",
            "",
            "4 Aposal, martair, muhzwng nunc",
            "Gumei pu daeng khou bam;",
            "Dihmei Khrista khou ruprian guay",
            "Kaniw lev kariu ni. (2)",
            "",
            "5 Jerusalem, neihlaapui kai,",
            "Nang ta ai rigwn e;",
            "Lakmei ataanv guay ’thaekc puni,",
            "Nang ta howpui nungc kiu. (2)"
          ]
