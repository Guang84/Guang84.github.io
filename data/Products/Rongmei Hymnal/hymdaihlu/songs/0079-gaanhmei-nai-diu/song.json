      "rongmei": {
        "language": "rongmei",
        "title": "Gaanhmei nai diu",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ngammeipu Nang Lat khou",
            "Kaguakcmei, zinghmei guay,",
            "Samc tat khwan e;",
            "’Niw huaymei chulou o,",
            "Hymdaihmei Gaychamv riw",
            "Gaanclou makmei bamv ’thuic",
            "“Gaanhmei nai diu!”",
            "",
            "2 Thuakloumei swkaeng khou",
            "Tiigaymei, how datmei",
            "Phungc guangmeipu;",
            "Naumei khang pumh gaymei,",
            "How datmei tiilou o,",
            "He zaatc kathuicna khou",
            "“Gaanhmei nai diu!”",
            "",
            "3 ’Chumhmei, zianmei Bumaengc",
            "Tiiringhmei Akhouhna,",
            "Samc keylou o,",
            "Duipui guay ruanlou o,",
            "Ngammei Nang zauzian )}3,",
            "Zingc liangmei bamv guay khou",
            "“Gaanhmei nai diu!”",
            "",
            "4 He Gaanv Thumh khat swmei,",
            "Nang tuang zianmei lev ngamv,",
            "’Thanmei Racguangc,",
            "Duipui kumc kanganv maek,",
            "Duiluat kumcna lik e,",
            "Kandih tintou kathuic",
            "“Gaanhmei nai diu!”"
          ]
        }
