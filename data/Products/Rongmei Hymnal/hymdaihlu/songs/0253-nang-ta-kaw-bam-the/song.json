        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc ^&8 pak ’maan",
            "kanmei nunc ta kawna bam e,",
            "Chu lo, he Kamei ^&8 kaw bam e, nang ta,",
            "Kakhou ^&8 nang maeng duc tat sihni aseic guang tho,",
            "Chu lo, zianpui khwan ^&8 kaw e.",
            "",
            "Nang .. ta kaw bam the,",
            "Maeng tat .. mei nang, guang la tho,",
            "Nang .. ta kaw bam the,",
            "Maeng tat ..mei nang guang latho.",
            "",
            "2 Kaniam gayna nang Pu ^&8 ’taw nganv kawna bam e,",
            "Chu lo, he Kamei ^&8 kaw bam e nang ta,",
            "Bumaengh ’Thanmei ^&8 saa ’khavlou",
            "bam khou guang la tho,",
            "Chu lo, ’zianpui khwan ^&8 kaw e.",
            "",
            "3 Guang tho, nang Pu kai khou tiitu khang taektw nai e,",
            "Chu lo, he Kamei ^&8 kaw bam e nang ta,",
            "Zauclo, ngay khang tuzangvpui",
            "tuang chamdaanv luailou the,",
            "Chu lo, zianpui khwan ^&8 kaw e."
          ]
        }
      },
