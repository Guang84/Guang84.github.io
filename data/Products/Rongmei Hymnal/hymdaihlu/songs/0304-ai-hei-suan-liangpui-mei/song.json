    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Ai hei ’suan liangpui mei",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai hei ’suan liangpui mei, ganc patloumei khwan e,",
            "Nap ’daapc, tingsikna ai chaeng khou bow key the;",
            "Jisu _>6 Kalunggai akhou tiihowlou e;",
            "Kandih tuang lunggai hei Jisu e.",
            "",
            "Ai hei ’suan liangpui mei,ganc patloumei khwan e,",
            "Kamei _>6 akhang kachaekc kaphut tiilou e;",
            "Karaan dat zat lakmei kauh kaidai tiilou e;",
            "Kandih tuang lunggai hei Jisu e.",
            "",
            "2 Ai hei ’suan liangpui mei, pamrai maekmei khwan e,",
            "Zinghmei khou tingsaengcna ai dup bam khwan the,",
            "Jisu _>6 gaanc guang e, lauthwan neic riw kumcna,",
            "Apanty khang gaanhmei Jisu e.",
            "3 Ai hei lungcsii liangpui mei, syanlanv maekmei e,",
            "Tingkauh thangc _>6 keyna Kaipouc Jisu _>6",
            "Kros khou 6_> ryanramei akhaengvna theiclou e,",
            "Kamei _>6 abumaengc thuaklou the.",
            "",
            "4 Ai hei ’suan liangmei khwan e, Jisu guang mak saanv,",
            "Apaap khiu ’thanlouna gunh kumc phwan mak saanv;",
            "’Taw thu Kazei khou ai lup keyna low ’than the;",
            "He guloumei pumtan Jisu e."
          ]
        }
      },
