        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Thanmei nunc ?|7 tat rey kanmei chaeng khou,",
            "’Niu hu khou Guangh ?|7 tat huna,",
            "’Niu kai ’zwan bam e, tingkauh chyngbut thangc,",
            "Kalaanv gaanphiu ?|7 gaanclouna.",
            "",
            "Kai zuanh e, Tingkauh kai ga thangc,",
            "Neihlaa, ringhmei guangh pyrun run khang;",
            "Khou 7?| tangh nungc neihlaana kauc ni;",
            "“Hymdaih dic khou tangc the!”",
            "",
            "2 Thuakloumei nunc kumc aniu nic tat re,",
            "’Taw hei Zion biak kahuhna;",
            "Guangh latdyn thei layna aniu tat re,",
            "Aniu maibwang chuangc gaanc chuyna.",
            "",
            "3 Reynungc thiak kumcna lwm ’tipna ding ni,",
            "Zianmei ?|7 bang kariulou ni;",
            "Guangh ta how pwkhou adih neihlaa ni,",
            "Kamei lev lungc ’chamcpui nungc kiu!",
            "",
            "4 Aniu phay dui khou ding nkung sihni,",
            "Jordan dui kathuat sii sihni,",
            "Guangh lev kaamc ’chamcna dui",
            "paengc kaan patna",
            "Kata thuanh lu tingsaeng suan ni."
          ]
        }
