        "language": "rongmei",
        "title": "Neihlaapui lu suanna thuanc e",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neihlaapui lu suanna thuanc e,",
            "Thuanckuna ’niu guang kaduai,",
            "Ravguangc ramzian ta ’niu thuanh khang,",
            "Tingsaeng Pu, ’niu Ravguangc ta.",
            "",
            "Kakhou ’niu lungsyng <~1 neihlaa,",
            "Kamv zat lak ge Kahym hei,",
            "Karamgaeklou hei ’niw raengc e,",
            "Tingsaeng ringhmei, zianmeipu.",
            "",
            "2 Zingbangc khou <~1 gaanhmei phungc guang,",
            "’Niangbangv khou mwn tiipuangc e,",
            "Muanghbangv guay khou suaihiam phungc guang,",
            "Neihriw lev ting tiilou e.",
            "",
            "3 Kamei thaylou makmei maek ge,",
            "Ryanra, neihlaa, kathuic hei;",
            "Reynungc zianmei <~1 sinmei kumc,",
            "’Taw nic tingsaeng sin puni.",
            "",
            "4 Pou ta lungh khat swna thuanc kho,",
            "Kazanc hym hei tiidaic kho!",
            "Kalaih makmei Karamzian ta",
            "’Niu rac kaluaihna thuanc kho."
          ]
        }
      },
