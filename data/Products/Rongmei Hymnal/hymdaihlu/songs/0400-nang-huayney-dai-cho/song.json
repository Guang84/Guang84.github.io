      "rongmei": {
        "language": "rongmei",
        "title": "NANG HUAYNEY DAI CHO?",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Seic lauthwan nang bamv ganclou khou",
            "Nang huayney dai cho?",
            "Guloumeipu Khrista zanc khou,",
            "Kazauzian khang nang huay dai cho,",
            "’Seic n-gih sw khang ?",
            "",
            "Oh huayney pwkhou zaengthaekmei,",
            "Zingbangc ta kalaanv guanhlou;",
            "Ryanra khou nic neihlaa khou nic",
            "Huayney amuc rio.",
            "",
            "2 Nang ’thiammei ta akhangv pwkhou",
            "Nang huayney dai cho?",
            "Theihloumei Kazauzian paan $%6,",
            "Bumaengh ’Thanmei khou huay dai cho,",
            "Nang ta zaylou khang?",
            "",
            "3 Nang lungpuamhmei $%6 padik khou,",
            "Nang huainey dai cho?",
            "Pumtan khang nang huayney dai cho,",
            "Nang ta tiilunghpuamhmeipu ta",
            "Nang kuaklou ngam khang?",
            "",
            "4 Nang khou ’chanvmei ranv guang pwkhou,",
            "Nang huainey dai cho?",
            "Nang bumaengc ryanrana bam khou,",
            "Tiigaymei puc khang nai dai cho?",
            "Kalaanv raengcmun khou?"
          ]
        }
      },
