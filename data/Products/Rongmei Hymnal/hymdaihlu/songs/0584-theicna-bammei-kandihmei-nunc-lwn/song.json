            "1 Theicna bammei kandihmei lwn",
            "’Niu mik khou phaengc how e,",
            "Kage naimei ta ’niu thay e,",
            "Kap bammei khwan chu e;",
            "Pou Jisu, Nang tuang phwamling ta",
            "Tiikaluanlou dat ro,",
            "’Thukmei ganv khou Nang phwamling khang",
            "Bumaengh ngamv tiilou o.",
            "",
            "2 Thing-’tauh ta kalummei nunc !}2",
            "Zingc keymei ta ping e;",
            "Kaidai khou lungc bammei nunc !}2",
            "Chwnkarumna kap be.",
            "Pou Jisu, Nang tuang phwamling ta",
            "Tiichuangc thaulou dat ro,",
            "Ryanra-lakmei ta how thay khang,",
            "Zianthay, kadanthay khang.",
            "",
            "3 ’Seicdou thay-howmei ningting hei",
            "Mbu kuna bam khou,",
            "Nang Lat khou ngamv thanh tiilou o,",
            "Katumcna zin lik khang,",
            "Pou Jisu, Nang ngamv tiilou o,",
            "Natnw guay hei piuna,",
            "Duhmei ’naamei kandih ’thuic khou",
            "Nang Lat tiichu lik khang.",
            "",
            "4 Latzan kaeng khwan 2^< chu guang the,",
            "’Niu ruc khou kros nai e;",
            "Theicna bammei bumaengc nunc hei",
            "Adih sansii ni cho?",
            "Nang tuang phwamling ta thouclou o,",
            "Gaychamv dinc lik ’khap khang,",
            "Nang phwamling ta tii’luanlou o,",
            "Akhou !}2 thaulou o."
          ]
