            "1 Guang tho, ’niw ’khwan bammei Jisu,",
            "Nang meicnunc ta riclou tho;",
            "Pingmei paap khou ^&8 ’patlou tho;",
            "’Niw Nang khou zaeng sw ni the.",
            "Israel pumtan lev swmloumei,",
            "Dihmei guay machunc Nang e;",
            "Zaatc guay ^&8 machunhmei Nang e.",
            "Lung guay khang neihlaamei e.",
            "",
            "2 Nang mei guay ta thuaklou khang puanc,",
            "’Ki Nang hei aniw Guangc e;",
            "’Niw khou tingsaengc guanghtu khang puanc,",
            "’Taw Nang guangcdic phungc guang tho.",
            "Nang tuang tingsaengzaeng Bumaengc ^&8",
            "’Niw lung khou guanghtulou tho;",
            "Nang ramgai 8^& ^&8 aniw ta,",
            "Nang guangcdic khou zaylou o."
          ]
        }
