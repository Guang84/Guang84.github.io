          "lines": [
            "1. Kandih khou neilamei naidiu,",
            "Kaipou Jisu guang the;",
            "Meiguai lungkhou bam chamdan diu,",
            "Kauh le dih({0 thuan diu (2),",
            "Kauh le dih({0 kata thuan diu.",
            "",
            "2. Kandih khou neilamei naidiu,",
            "Poubaumei guang tuthe;",
            "Ching jang duidai thing tau guai le,",
            "Mei guai ({0 thuanku diu (2),",
            "Neilapui lu suan kaluai diu.",
            "",
            "3. Pap le rianramei nai lak khe,",
            "Saurang nai dat lak khe;",
            "Kasuaihiam tilou khang guang e,",
            "Siang naipuibam thui khou (2),",
            "Siang nai pui bam kathui nakhou.",
            "",
            "4. Kamei ({0 kandih hei sin the,",
            "Chummei le jaujian ({0;",
            "Chingkhiumei katuang tunmei le,",
            "Chrinmei kajaujian ta (2),",
            "Jat kaguai ({0 ti ndao e."
          ]
        }
