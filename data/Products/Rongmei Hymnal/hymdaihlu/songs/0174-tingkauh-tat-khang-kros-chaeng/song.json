          "format": "source-lines",
          "lines": [
            "1 Tingkauh tat khang kros chaeng khou tat ni tuang e,",
            "Mi hamhna chaeng baihmei maek;",
            "How mak puni gaanhmei tingkauh raengcmun,",
            "Kros chaeng khou ai tat mak ethei.",
            "",
            "Kros chaeng }?2 tingkauh zaylou,",
            "Kros chaeng }?2 akai ’duanghlou,",
            "’Zwan tat bam khou hei neihlaamei nai e,",
            "Kros chaeng }?2 tingkauh zaylou.",
            "",
            "2 Zei ’zukloupui chaeng ai tat khang kage nai,",
            "Guloumeipu tatpui chaeng;",
            "Kauh liangmei khou ai kulou tangc ethei,",
            "Ravguangc pamv khou zaeng sw ni the.",
            "",
            "3 Dih lwnlung guay ta ai ramnavlou duc the,",
            "Ai tat kaluaih dat lak khe;",
            "APoubauhmei “ Guang tho,” wna saa the,",
            "Kamei chaengmun khou ’khwan bam the."
          ]
        }
