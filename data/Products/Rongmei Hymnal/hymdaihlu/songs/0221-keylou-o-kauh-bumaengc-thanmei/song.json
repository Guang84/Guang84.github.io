      "rongmei": {
        "language": "rongmei",
        "title": "Keylou o, kauh Bumaengc ’ Thanmei",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Keylou o, kauh Bumaengc ’Thanmei!",
            "Tiikaluancmei ngamvle;",
            "Kauh ramzian mai tiichuangclou o,",
            "Nchumei ’niw lungh khou.",
            "",
            "2 ’Niw khuksunna kalum khwan e,",
            "Dih puat khou lunghlouna;",
            "’Niw bumaengc kachaengc sii bam e,",
            "Neihlaa suang ngam mak ge.",
            "",
            "3 ’Niw lu ramsuan hei kaluanc mak,",
            "Meic lungh tiithau ngam mak;",
            "Hosanna! saanc nic kaluanc mak,",
            "’Niw ramkalum theic e.",
            "",
            "4 Pou aniw asaanh kum bam ni,",
            "Amitmei lwnlung khou?",
            "’Niw Nang ta zianmei nchu e,",
            "Nang ramzian thu daic e.",
            "",
            "5 Key o, Bumaengh kauh Akhouhna!",
            "Tiikaluancmei ngamvle,",
            "Key o, Jisu zianmei tii o,",
            "’Niw ta tiichuangclou o."
          ]
        }
      },
