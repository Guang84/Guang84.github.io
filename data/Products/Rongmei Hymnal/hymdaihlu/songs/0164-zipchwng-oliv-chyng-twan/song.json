        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zipchwng, Oliv Chyngtwan khou hei",
            "Gaanhmei gaanchuangc guay kamv key the;",
            "’Taw zipchwng ganv khou pikwan khou",
            "Guloumeipu huayney bam e.",
            "",
            "2 Zipchwng, Kapam-karai maekna",
            "Pou #<8 pingmei ta akhangv bam,",
            "Zianmei Kaziap nunc #<8 nganvna",
            "Pou ramrianra thaylou mak khe.",
            "",
            "3 Zipchwng, baihmei khuay zaeng khou #<8",
            "Gumeipu zei phiangcna kap be,",
            "Lungh bakna huay bammei pu ta",
            "KaRavguangc #<8 nuhlou mak ge.",
            "",
            "4 Zipchwng, tingkauh nzaengc thangc #<8",
            "Baanch’ra na #<8 thaymei lu suan;",
            "Dihmei chu tow makmei lu #<8",
            "Gumeipu ramrianra swmlou."
          ]
        }
      },
