          "format": "source-lines",
          "lines": [
            "1 Zauzian! twmei khwan hei!",
            "Nuh gaymei lu khwan e!",
            "Tingkauh thangc _>6 kagaengv guang ni,",
            "Kandih pwm chu lik ni.",
            "",
            "Zauzian _>6 gulou;",
            "Mi hei alat re,",
            "Jisu meic guay khang theiclou,",
            "Mi 6_> akhang nic the.",
            "",
            "2 Azanc hylou kan the,",
            "Ringcsuangmei latrik khou;",
            "Zauzian _>6 ata phungc guanglou,",
            "Ravguangc Lauziu Nac khou.",
            "",
            "3 Zauzian hei _>6 ata",
            "Huayney thay khang ’chamlou,",
            "Zauzian _>6 ’seic nganv gaeklou the,",
            "Katwan nganv zaylou ni.",
            "",
            "4 Zauzian _>6 tii tanclou,",
            "Tingkauh tuang pumtan _>6;",
            "Apumtan guay Nang khang sw diu,",
            "Apanty nai saanv khou."
          ]
        }
