        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaipouc, ai Nang khou guang the,",
            "’Naa guang tuanc pw the;",
            "Duppui bamv Nang swkaeng khou",
            "Ai tingsaeng dup ni;",
            "Paapc lev lwmsiimei pwanzingh",
            "Akhou ranvna ’liu bam the;",
            "’Khavlou o, ai rih ngam khang,",
            "Kaipou, ’naa guang the!",
            "",
            "2 ’Naa guang the, he Pou, Taudaic,",
            "Bumaengh duppui bamv;",
            "Ping lak khe pwanzingh guang nic,",
            "Dui kamuatc khou nic,",
            "Pwanzingh ta ai ping lak khe,",
            "Ata kabiu ngam mak ge,",
            "Nang baancpwam khou",
            "ngangvlouna,",
            "Kaipouc, ’naa guang the!",
            "",
            "3 ’Naa guang the ’Khavloumei pu,",
            "’Naa guang tuanc pw the;",
            "Lungh niamhna ai saa ni the:",
            "\"Pou, Nang nyng sw diu!\"",
            "Ryanra chwnsii zaengsiimei,",
            "Akhou Nang tii guang sihni,",
            "Thay the zianpui zaeng ^&8 de,",
            "Kaipouc, ’naa guang the!",
            "",
            "4 He Kaipouc, ai ’naa guang the,",
            "He gaanhmei Ravguangc;",
            "Guigaymei Nang Nac paan ^&8",
            "Neihlaa chuzaengh the;",
            "",
            "Nang zianmei khou ai bam ni,",
            "Nang daeng khou ata lou o,",
            "’Kamhlou o, Taudaic lang khou,",
            "Kaipouc, ’naa guang the!"
          ]
        }
