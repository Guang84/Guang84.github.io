        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tingkwm asaanh lak khe,",
            "Kadan tingsaengc lak khe,",
            "Kapmei, nuihmei tingsaengc lak khe,",
            "Huaymei tingsaengc lak khe.",
            "",
            "2 Suaimei tingsaengc lak khe,",
            "Thiusaengc zay saengc lak khe,",
            "Kandih lu suan tingsaengc lak khe,",
            "’Tamvmei tingsaengc lak khe.",
            "",
            "3 Hei tangv tingsaeng lungc ni,",
            "’Tamv datmei nai lak khe,",
            "Tingsaeng hymdaihmei tingmik khou",
            "Tingsaeng lu suan ni the. Amen."
          ]
        }
      },
