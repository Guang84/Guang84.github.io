        "content": {
          "format": "source-lines",
          "lines": [
            "1. Arih puan hei lou kei pinge,",
            "Ai bammei dih rih hei pinge;",
            "Tingmik thui nthiammei pu %&6,",
            "Nangmei nun guaita nthiam bamme.",
            "",
            "Chorus:",
            "Rih puan ti o, Immanuel,",
            "Nang bumang %&6 nduang lou o;",
            "Pap %&6 rang sumei dih khou hei,",
            "Nang %&6 kagan thui duang lou o.",
            "",
            "2. Apumtan hei mak khuan sini,",
            "Nang rihmei khang biu mak sini;",
            "Khang thaimei guai khang guang pirun,",
            "Nang %&6 chamdan loumei tilou o.",
            "",
            "3. He jailou o kanloumeipu,",
            "Nang jei pan %&6 rih hei ngamni;",
            "Pap %&6 rang sumei dih khou hei,",
            "Pap phungmei guai jan phu ngam makge.",
            "",
            "4. Nang %&6 rih hei timan lou o,",
            "Nang jei pan %&6 rih hei ngamni;",
            "Nang jaujian %&6 nkhalou o,",
            "Nuan phungmei nun guaita jaipat khang."
          ]
        }
      }
    },
