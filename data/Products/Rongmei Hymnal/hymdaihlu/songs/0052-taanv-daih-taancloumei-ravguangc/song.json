        "content": {
          "format": "source-lines",
          "lines": [
            "1 Taanv daih taancloumei Racguangc hei hym daic diu!",
            "Dih ta heidi zianna KaNac ’Pouh tii the,",
            "Paapc kuaklou khang Kapanty tiipatlou the,",
            "Meic guay gut nuh khang ringhpui chaeng laanclou the.",
            "",
            "",
            "Poubauhmei ta thuanc o!",
            "Kakhwan dih guay chu diu!",
            "Poubauhmei ta thuanc o!",
            "Meic guay neihlaa kan diu!",
            "Guang o, Pu Ravguangc khou Nah Jisu paan _>6;",
            "Kata thuanc o, Kamei taanv daih taanclou the.",
            "2 He zei _>6 liuloumei ’thuihmei thuakloumei,",
            "Lwmloumei kathuic khang Ravguangc latryan e,",
            "Khuay daihpui mei sihni lwmlou changhpui mei,",
            "Kuakloumei kiu Jisu khou _>6 laatow e.",
            "",
            "3 ’Niw khou latlu daih dinclou, taanv daih taanclou,",
            "KaNac Jisu paan aniu zaenggay daic e;",
            "’Ki ’than ranv, kauh ranv, daic ranvmei sw puni,",
            "Ch’rynmei ’niw Guangc Jisu ta howpui nungc kiu."
          ]
        }
