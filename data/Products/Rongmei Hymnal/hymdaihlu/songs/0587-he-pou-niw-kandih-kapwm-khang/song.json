    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "He Pou, ’niw kandih kapwm khang",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Pou, ’niw kandih kapwm khang,",
            "Zaatc guay khang huay bam khou,",
            "’Niw lungc bammei ’niw kandic khang",
            "Huaymei hei chulou o.",
            "",
            "2 ’Niu duikhuangc, ramvrei kaguay khou",
            "Chuzaenghmei tiilou o;",
            "’Niw kaidai guay daicthau bam diu,",
            "Laupuk guay ’thuih kan diu!",
            "",
            "3 Nang ta zianmei lung tiilou o,",
            "Ningting, ’chumhmei phu khang,",
            "’Niu chyngbut lev nzaengc guay khou",
            "Nyngthav lu kagaengv diu!",
            "",
            "4 He zaatc guay Kaipouc, Nang baanc khou",
            "’Niw dic ta tiilou e;",
            "Kakhang ngangv bamv, duploupui bamv",
            "Tingsaengzaeng swlou o."
          ]
        }
      },
