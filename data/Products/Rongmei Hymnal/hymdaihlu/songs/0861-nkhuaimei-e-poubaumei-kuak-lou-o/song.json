        "content": {
          "format": "source-lines",
          "lines": [
            "1. Nkhuaimei e poubaumei kuak lou o,",
            "Ai lunglai na guang e;",
            "Nang phai bang khou.",
            "",
            "Chorus:",
            "Adang khou bam makge thei,",
            "Kandih ai thei pui bam;",
            "Nang phai bang khou.",
            "",
            "2. Baimei gaimei mak ge,",
            "Kandih khou hei ,",
            "Ntao nang khuan chuna ai guang datthe.",
            "",
            "3. Poubaumei le nang %&6,",
            "Khiu than lou o;",
            "Nangta ninga ai%&6 rih hei ngam ni."
          ]
        }
      },
