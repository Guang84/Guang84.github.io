        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ningting, zianmei, ngamv khou",
            "Thuanc bammei zanc guay hei",
            "Meic _>6 thay tanghmei guay,",
            "Baanch’ra nunc thuanhmei guay",
            "Kariu sihni khat sic biuh mak,",
            "Gumeipu zanc ta kida khang.",
            "",
            "2 Ravguangc Muhzwng Daihmei,",
            "Nang ta ai _>6 thuanc e,",
            "Nang paan _>6 neihlaamei,",
            "Ringhbamv chamv hei guang e;",
            "Paapc kuakloumei, t’ruaih ta ngammei,",
            "Chuzaenghmei, neihlaamei chamv hei.",
            "",
            "3 Jisu Tingkuh Daihmei,",
            "Kazei keyna theiclou,",
            "Khuay naimei alung khang,",
            "Baihmei ravcha maek ge;",
            "Kazei ngamv _>6 paapc kuaklou the,",
            "’Taw akhang dinglouna bam e.",
            "",
            "4 Nang hei ’chamloumeipu,",
            "Zayloumei, Kaipouc e,",
            "Ata gaengcloumeipu,",
            "Nang daeng tiituanclou o;",
            "Aphay kaamv hei chaeng maanv mak khang,",
            "Siimei chaeng khou tiitatlou rio.",
            "",
            "5 Gumeipu, aKaipouc,",
            "Rih ngammeipu, aGuangc,",
            "Nang builwang lev baengsaeng,",
            "Nang guangcdic ta thuanc e;",
            "Ngamv Nang tuang e, neihlaana ai",
            "Nang phaypav bangc khou gutlou e."
          ]
        }
