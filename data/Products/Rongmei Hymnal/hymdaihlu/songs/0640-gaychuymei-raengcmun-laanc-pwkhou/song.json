        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zinghmei zingbangc khou aniu",
            "ruan saengc lak khe,",
            "Gaychuymei raengcmun laanc pwkhou;",
            "Gaanhmei Ravguangc kaidai",
            "khou ’niu ruan puni,",
            "Gaychuymei raengcmun laanc pwkhou.",
            "",
            "Gaychuymei raengcmun laanc pwkhou,",
            "Gaychuymei raengcmun laanc pwkhou,",
            "Aniu neihlaa ni, Kaipouc ta how pwkhou,",
            "Gaychuymei raengcmun laanc pwkhou.",
            "",
            "2 Zianmei nunc ata ’khwan bam e, duipaengc khou,",
            "Gaychuymei raengcmun laanc pwkhou;",
            "Kai khou riulou ni, paapc khou ({0 ai duak ni,",
            "Gaychuymei raengcmun laanc pwkhou.",
            "",
            "3 Dih khou kumc ryanra sucnumei nai lak khe,",
            "Gaychuymei raengcmun laanc pwkhou;",
            "Rey khou kumc ruprian guay lev neihlaa bam ni,",
            "Gaychuymei raengcmun laanc pwkhou.",
            "",
            "4 Saa ngam lakmei neihlaa 0({ akhang sw ni,",
            "Gaychuymei raengcmun laanc pwkhou;",
            "Rav tuang ’thanmei, gaymei 0({ akhang sw ni,",
            "Gaychuymei raengcmun laanc pwkhou.",
            "",
            "5 Panty puatphung ({0 tii-katuakc dat lak khe,",
            "Gaychuymei raengcmun laancpwkhou;",
            "Khrista lev neihlaa taek maknga bam ni the,",
            "Gaychuymei raengcmun laancpwkhou."
          ]
        }
