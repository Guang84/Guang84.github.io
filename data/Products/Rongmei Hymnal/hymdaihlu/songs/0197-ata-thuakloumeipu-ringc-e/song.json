            "1 Ata Thuakloumei pu ringc e,",
            "Kamei theiclou kan the;",
            "Ai ryanra khou Kamei swmlou,",
            "Chuzaenghmei tiilou e.",
            "",
            "2 T’rou ta ngamlouna ringc bam e,",
            "Pu baanzat khou bam e;",
            "Ringhmei abumaengc gaeklou",
            "khang,",
            "Hym tiidaiclou bam khang.",
            "",
            "3 Kamei ringc e, ai nic ringcna",
            "Kazauzian ’dauh bam khang,",
            "Kamei ringc e, ’thanmei Kazanc",
            "Champouhna lungc bam khang.",
            "",
            "4 Tingkauh lu khwan 7?| kagaengv diu,",
            "Meic guay ?|7 lu dai 7?|,",
            "Akhang ’khaengvloumei pu Khrista",
            "Tingkauh Guangc khang suan diu."
          ]
