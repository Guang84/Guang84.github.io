        "content": {
          "format": "source-lines",
          "lines": [
            "1 Duibaek paengc thangc dih khat nai e,",
            "Tingsaeng gaymei kandih kaw e;",
            "Lwmmei paan na <~1 thangc 1<~ ’niu tangc nuh e;",
            "Theic dat makna ’niu lungc bam khang,",
            "Khat khat swna khou 1<~ gut ni,Nang lev akhang kachaekc kaeng 1<~ hiw pwkhou.",
            "",
            "Kaeng khwan hei nang chu makna cho?",
            "Baanch’ra nunc lu chu makna cho?",
            "“Hallelujah! Jubili!” twna suan e;",
            "Duc sih thangc tingsaeng gaymei ramc ,",
            "Duibaek paengc thangc naimei ramc khou,",
            "Nang lev akhang kachaekc kaeng 1<~ hiw pwkhou.",
            "",
            "2 Duipui hei rungh chau twan pwkhou,",
            "Rungh ’thaekcbamv kiu guang tangc pwkhou,",
            "Paapc lev ryanramei ta ’niu thay dat lak khe;",
            "’Niu Pu <~1 zianloumei ta lev",
            "Kasuaihiam na ta thay puni;",
            "Nang lev akhang kachaekc kaeng 1<~ hiw pwkhou.",
            "",
            "3 Aniu ringcting hei luai pwkhou,",
            "Theicna aniu zip key pwkhou,",
            "’Niu bumaengc ’niu pamv khou <~1 tat pat pwkhou,",
            "Ryanramei ariw dat makna",
            "Gaychuymei tingkauc tangc puni;",
            "Nang lev akhang kachaekc kaeng 1<~ hiw pwkhou."
          ]
        }
