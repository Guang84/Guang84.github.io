        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neihmik key nuangc puni the,",
            "Khou kiu ’niu taanv guay luaina,",
            "Ryanra ryanriu guay ’thaekc puni the;",
            "Tingpuk, kandih Kaipouc >|3",
            "’Niu ta ’chyangthaulou puni,",
            "Aniu ariw dat ni Zion khou.",
            "",
            "Aniu ariw puni,",
            "He aniu ariw puni;",
            "Guloumei pu ta luicna",
            "Gaanc chuymei kandic khou 3>|;",
            "Aniu ariw puni",
            "He aniu ariw puni,",
            "Kahymdaih dam laa puni.",
            "",
            "2 Nzaengc khou swng hei zingc the,",
            "Pingmei pwanzingh khwan tanc the,",
            "Pwanzingh kananghna ’niu",
            "chaeng zingc the;",
            "Kumsic Pou >|3 zaylou ni,",
            "Gaanhmei kalaanv dic khou 3>|",
            "Khou3>| dih tuang pwanzingh",
            "guang mak khe.",
            "",
            "3 Mikdui luanlai bam sihni,",
            "Pingmei lung padik sihni,",
            "Dih panty ryanra padik sihni,",
            "Neih khat Kaipouc key puni,",
            "Kakai khou phungc kulou khang,",
            "Khou3>| ryanramei nai dat lak khe."
          ]
        }
