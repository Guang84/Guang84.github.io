    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Khou hei Poubauhmei,",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Khou hei, Poubauhmei, Nang zawpaanv ai how e,",
            "Ai how tangh makmei ta kahitow e;",
            "Khou hei tingsaeng zauzian ta laatow e,",
            "Arianra guay Nang khou ai ngangvlou e.",
            "",
            "2 Khou hei ai Ravguangc tuang ’tyan 4@< tutow e,",
            "Nang lev zangv e, tingkauh drakhadui 4@<;",
            "Khou hei kandih puatrith guay lou key e,",
            "Paapc kuakloumei ramgai ai laa tow e",
            "",
            "3 ’Niu lu luai pwkhou ramh guay katiamhlou e,",
            "Khumkih taektw tu luai zangv luai pwkhou;",
            "’Tyan lev drakhadui laa tat kan sihni,",
            "Nang thu adaeng bam tuanctanh tan puni.",
            "",
            "4 Khwmkih taektw hei tu dat kaluaih luaih e,",
            "Kauh tuang neihlaa khwmkih dai ta lyan e,",
            "Neihlaa ngay dai ramgai ta lyanlou e,",
            "Lauziu Nac tuang Nowsuan khwmkih Ngay dai. Amen."
          ]
        }
      },
