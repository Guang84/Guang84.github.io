          "format": "source-lines",
          "lines": [
            "1 Thuancku e, Thuakloumeipu khang!",
            "Nang chamdaanvloumei guay khang;",
            "Thuancku e, tat kanmei ganv khou",
            "Jisu bam ’duanghloumei khang;",
            "Thuanku e, lauphunhswan ganv khang,",
            "Tingsei ganv tiiloumei khang,",
            "Thuancku e, mikdui keymei khang,",
            "Chuzaenghmei tiiloumei khang.",
            "",
            "2 Thuancku e, ravsuai dawloumei,",
            "Dawlou makmei guay khang ta;",
            "Thuancku e, pwanzingh akhangv khang,",
            "Nang !}2 nuhloumei guay khang;",
            "Thuancku e, suhmei amanvmei,",
            "Neihlaamei, chwnswmei khang;",
            "Thuancku e, nganv makmei zauzian,",
            "Kidalakmei zianmei khang.",
            "",
            "3 Thuancku e, mwnpwang gaymei khang,",
            "Sauhraengh naimei bang guay khang;",
            "Thuancku e, kaikhunh, maimangh bamv,",
            "Machunhmei tiiloumei khang;",
            "Thuancku e, neihlaa, ryanramei,",
            "Tingkauh tuang chuzaenghmei khang;",
            "Thuancku e, guang nimei ganv khang,",
            "Tingsaengzaeng tuang machunc khang."
          ]
        }
