        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu khou zingbangc kaipouc khat guang e,",
            "Ringhbamv lev gaanhmei chaeng",
            "Kakhou thanv khang e;",
            "Poubauhmei )}3 latling 3)^ dinc ’thanlou e:",
            "“Nang puancthanh nina de!",
            "",
            "Nang puancthanh nina de!",
            "Nang puancthanh nina de!",
            "Ai )}3 nang khou saa",
            "diangc-siakloupui tuang e,",
            "Nang puancthanh nina de!”",
            "",
            "2 He maansei nac nunc, lat hei",
            "makumh o,",
            "Poubauhmei Jisu ’thukpui lat",
            "saamei 3)^;",
            "Thouh sw mak la rio, mi ’thukpui latbamv hei,",
            "“Nang puancthanh nina de!”",
            "",
            "3 Hymdaih zaengthaek khou gut niipui mei thiu,",
            "Thuakloumei nunc lev neihlaa lu suan nimei,",
            "Ringcsuangmei panty kiu lataw nii ethei,",
            "“Nang puancthanh nina de!”",
            "",
            "4 Nang lung )}3 how niimei pu khat kauh thangc",
            "Gay chuypui raengcmun khou",
            "nang ta ’khwan bam e;",
            "Hei zaeng )}3 ’thukmei latdyn hei nking o:",
            "“Nang puancthanh nina de!”"
          ]
        }
