        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tingmik kathuic lwm bam ni,",
            "Panty pwanzingh chaenglwan khou;",
            "Aramlum ’thyam khwan sihni,",
            "Jisu na ta lwm bam ni.",
            "",
            "Kaganv >|3 samc bam khou hei,",
            "Tingmik >|3 tat bam khou hei,",
            "Tabui lwnlung pat sihni,",
            "Jisu na ta lwm bam ni.",
            "",
            "2 KaBumaengc >|3 gaanclou the,",
            "Luih makmei alung khou hei,",
            "Kamei zaylou, ai bow lak,",
            "Jisu na ta lwm bam ni.",
            "",
            "3 Neihlaa khou lu suan bam ni,",
            "Ryanra khou huayney bam ni,",
            "Dwangdangv khou Kata kaw ni,",
            "Jisu na ta lwm bam ni.",
            "",
            "4 Panty nai saanv lwm bam ni,",
            "Kandih nai saanv lwm bam ni,",
            "Tingkauh ramc guang tangh mak saanv,",
            "Jisu na ta lwm bam ni."
          ]
        }
      },
