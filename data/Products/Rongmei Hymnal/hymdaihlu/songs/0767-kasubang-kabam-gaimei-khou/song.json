        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kasubang kabam gaimei khou,",
            "Kanloumei guai banthai puni;",
            "Kaniu guai 6$% tingsang ringmei la",
            "Pui kan khou neila puni the.",
            "",
            "Chorus:",
            "Lung puni lungsuang puni the,",
            "Poubaumei jaojian 6$% thuanna;",
            "Tingsangjang neila bampuni the,",
            "Kasubang kabam gaimei khou.",
            "",
            "2. Kasubang mang bam gaimei khou,",
            "Kapmei rianramei nai lakkhe;",
            "Simei le nthiampui rih daimei,",
            "Mak ge namdai gaimei khou 6$%.",
            "",
            "3. Kasubang mang bam gaimei khou,",
            "Rianra rianriu mei nai lakkhe;",
            "Ringmei duikhun khou dui lou puni,",
            "Gun nphuanmei suang nphuan ni.",
            "",
            "4. He’ hei khou 6$% bammei guai 6$%,",
            "Kandih rianramei khang lakkhe,",
            "Tingkau ram gaimei 6$% lapuni,",
            "Tingkau rang guai hang puni the."
          ]
        }
      }
