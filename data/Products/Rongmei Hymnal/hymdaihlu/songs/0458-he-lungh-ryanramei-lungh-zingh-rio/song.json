        "language": "rongmei",
        "title": "He lungh ryanramei, lungh zingh rio",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 He lungh ryanramei, lungh zingh rio,",
            "Ryanramei paengc thangc kai nai e,",
            "Sii key dat zat mak khe kai 2^<,",
            "Khou 2^< lungc zihmei nai lak ge.",
            "",
            "’Khwan o, he tanglum-tanglai makna;",
            "’Khwan o, he tanglum-tanglai makna!",
            "’Khwan o, ’khwan o,",
            "’Khwan o, tanglum makna!",
            "",
            "2 Nang san khou phungc nipui puat 2^<",
            "Nritna ’bumna phungc pwkhou;",
            "Zauc thau o, kauh kai tangc ni the;",
            "’Khwan o, tanglum-tanglai makna!",
            "",
            "3 Nang chaeng khou sauhraengh",
            "nai pwkhou,",
            "Ning o, Katuang sauh pyrun 2^<;",
            "Nang lung ryanramei nai pwkhou,",
            "Ning o, nang khang",
            "’khaengvloumei 2^<.",
            "",
            "4 Taancruai bam o, ryanra sihni,",
            "Kathai laatow mak kumc sihni;",
            "Zaengthaek tingmik pat puni the;",
            "’Khwan o, tanglum-tanglai makna!"
          ]
        }
      },
