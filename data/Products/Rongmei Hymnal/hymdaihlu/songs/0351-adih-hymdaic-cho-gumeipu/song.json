        "content": {
          "format": "source-lines",
          "lines": [
            "1 Adih hymdai cho, Gumeipu,",
            "Rav zauzian phunghmei Nang panty!",
            "Ch’rynpui ramzian zianloumei 1<:",
            "Akhang dyng the! akhang dyng the!",
            "",
            "He Gumeipu .. ai sw ni the",
            "Nang khang tiimei .. nringh kaipat;",
            "’Taw {:1 thauna tingsaengzaeng nganv,",
            "Nang khang sw ni! .. Nang khang sw ni!",
            "",
            "2 Nang mik ’ganvna huayney gaanhmei,",
            "Sinnui, malaa, ganc patloumei,",
            "Gethsamani khou rianra 1<:",
            "Akhang dyng the! akhang dyng the!",
            "",
            "3 Nang sanpiang khou sauh {:1 swnmei,",
            "Ata gu khang Nang zei keymei,",
            "He, Kalvari tuang ch’rynmei kros!",
            "Akhang dyng the! akhang dyng the!",
            "",
            "4 Nang tuang zianmei, chuzaenghmei 1<:,",
            "Nang tuang tingkauh lunggai guay 1<:,",
            "Kachanh lakmei tiingsaeng zauzian",
            "Akhang dyng the! akhang dyng the!"
          ]
        }
