        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaganv tat khou ’niu nic tat re,",
            "Tingmik tatmei kumc tat re;",
            "Hei dic hei ’patlou zaic ni the,",
            "’Niu kai tingkauh thangc tat khang.",
            "",
            "Kaganv @<4 tatmei khou ’niu nic tat re,",
            "Kaganv @<4 tatmei khou ’niu nic tat re;",
            "Aniu @<4 aniu kai biak ’zwan bam e,",
            "Kaganv @<4 tatmei khou ’niu nic tat re.",
            "",
            "2 Tingkwm ramhbiuc ’niu lungc guang the,",
            "Lungc key lungc ku lungc ’riw the;",
            "Lungh ryanra neihlaa ariw the,",
            "Kap guai nuic guaina lungc the.",
            "",
            "3 He, tingmik ’thuic Pou ta lwm kho,",
            "Nchumhmei khou zaylou khang;",
            "Kum ’thei ’niu chaeng maanv mak puni,",
            "Paapc lev zingbangc chaeng khou 4^&.",
            "",
            "4 Kandih chaeng chyam guay tat ngamna,",
            "Kachyam khat khat tat luaina,",
            "Bumaengh lunghpui bamv tangc ni the,",
            "N-gyn chaeng tat luai pwkhou."
          ]
        }
