        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tingpuk, kandih, duipui Racguangc,",
            "Ramh kaguayna ta Damhmeipu,",
            "Ramh guay Nang paan nai bam tuang e,",
            "Hei guay ringhmei Nang paan @<4 e.",
            "",
            "2 Neihriw khou Nang zauzian nai e,",
            "’Pwan khou Nang tuang ringhmei how e,",
            "Tingthimc ganh key, tingp’lik pwkhou,",
            "Nang ngamv how e, ramh guay ruc khou.",
            "",
            "3 Tingzyn ganv khou Nang ta how e,",
            "Nang chingkhiuh ta zingbangc how e;",
            "Lauthwan gaanhmei pat dat pwkhou",
            "Nang khwan chu e: “gaanhmei nai diu.”",
            "",
            "4 Tiki kauh ranv, how ’than ranvna",
            "Maansei nunc khou Nang ta how e;",
            "Nang ta luihmei, Nang kahak ta,",
            "Nang lungcloumei nunc khou how e.",
            "Amen."
          ]
        }
      },
