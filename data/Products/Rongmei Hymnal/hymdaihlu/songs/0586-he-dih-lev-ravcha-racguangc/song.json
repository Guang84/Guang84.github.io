        "content": {
          "format": "source-lines",
          "lines": [
            "1 He dih lev ravcha Racguangc,",
            "’Niw huaymei chulou o,",
            "’Niw dih kaipou nunc suai de,",
            "’Niw mei nunc chaeng maanv e;",
            "Dih-lanv ({0 nymphuplou e,",
            "Karaengmei ({0 sw bak;",
            "’Niw khou Nang ngamv laa ganh rio,",
            "’Niw gaengh laa ganclou o.",
            "",
            "2 Ping-rouhmei tuang guay khou ({0,",
            "Saaraamhmei guay khou ({0,",
            "Meicsiimei khang zaenggaymei,",
            "Gaeng makmei lat khou ({0,",
            "Chingkhiuh lev thoucna guay ta",
            "Chauphupmei lwn khou ({0,",
            "Zipriimei lev syang khou ({0",
            "Kaipouc, gaeklou na ro!",
            "",
            "3 Pingmei riang ({0 bangclou o,",
            "Tingkuh, guangh lev bangh ta;",
            "’Niw ta bang kariulou o,",
            "Riaplou o, gaeklou o,",
            "Lunghpuamh khou lev neihlaa khou,",
            "Lwmmei, nyngswmei ({0",
            "Ringc bammei zaat tiiswna",
            "Nang hu khou nai bam diu.",
            "Amen."
          ]
        }
