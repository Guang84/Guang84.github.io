          "format": "source-lines",
          "lines": [
            "Ringhpouc, Katuang Ravkai khou bam e,",
            "Ringhpouc, ’Thanmei Ravkai khou bam e,",
            "Kandihmei guay reih reina",
            "Kahu khou hei bam kan diu;",
            "Kahu khou reih rei diu,",
            "Reih rei diu, Kahu khou! Amen!"
          ]
        }
