          "lines": [
            "1 He ’Thanmeipu, damhmei Kaipouc,",
            "Zauzian, chuzaenghmei duipuak",
            "Aniu Swngpouc Jisu paan ({0,",
            "Katuang twnmei tiilou o;",
            "He tingkauh Pu, he tingkauh Pu,",
            "’Niw ruc khou suaihiamlou o.",
            "",
            "2 ’Thanmei Jisu, hymdaih Kaipouc,",
            "Baanch’ra guay ({0 thuanhmeipu,",
            "Nang ta kalum khang kaduaina,",
            "Aniw Nang p’ry ’king bam khou,",
            "Thuakloumeipu, Thuakloumeipu,",
            "’Niw khou zaenghmei tiilou o.",
            "",
            "3 Bumaengh ’Thanmei sw ’thanmeipu,",
            "Tingkauh ngamv 0({ phungc key o;",
            "’Niw lung hei tiipadiklou o;",
            "Guloumeipu ramzian ({0;",
            "Swmloumeipu, Swmloumeipu,",
            "’Niw lung tiineihlaalou o.",
            "",
            "4 Kaipouc Ravguangc, zaatc kathuic khou",
            "Nang ramzian hei gaanc lik diu,",
            "Nang ringcbamv chamv lu gaymei hei",
            "Zaatc kathuic lat ({0 thuanc diu;",
            "He Poubauhmei, he Poubauhmei,",
            "’Niw lung Nang tuang swlou o.",
            "Amen."
          ]
