      "rongmei": {
        "language": "rongmei",
        "title": "Chu lo, Kaipouc chaengmun khou",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Chu lo, Kaipouc chaengmun khou ding bam e,",
            "Tiigut ro, .. tiigut ro;",
            "Kamei katupna kaikhamv ’chow bam the,",
            "Tiigut ro, .. tiigut ro.",
            "",
            "Gumeipu e chaengmun khou bammei,",
            "Kamei ’khwanna chang-khaanvna bam the;",
            "Nang lung 4^& laanc daiclou tio,",
            "Guloumeipu gut kan diu;",
            "Tiigut ro, .. tiigut ro.",
            "",
            "2 Kamei nang khang gay liangmei",
            "Pam kiu e,",
            "Tiigut ro, .. tiigut ro;",
            "Kaganv ’thuic gaeklou nimei pu kiu e,",
            "Tiigut ro, .. tiigut ro.",
            "",
            "3 Kata nsa khou kaikhamv tii ’chow rio,",
            "Tiigut ro, ... tiigut ro;",
            "Kamei guang dat zat makna taan nuh e,",
            "Tiigut ro, .. tiigut ro.",
            "",
            "4 Kakhwan zianthaymei khwan 4^& chulou o,",
            "Tiigut ro, .. tiigut ro;",
            "Gut ro, twna riulouna neihlaa tho,",
            "Tiigut ro, .. tiigut ro."
          ]
        }
      },
