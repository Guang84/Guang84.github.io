        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Apanty hei laalou o,",
            "Kaipouc Nang khang katpat the;",
            "Aganv, ating laalou o,",
            "Taek makna Nang ta thuanh khang.",
            "",
            "2 Abaanc nei hei laalou o,",
            "Nang ta zianpui taanv taanh khang;",
            "Aphay nei hei laalou o,",
            "Katumcna Nang khang tat khang.",
            "",
            "3 Akhwan ti hei laalou o,",
            "Kaganv ’thuic Nang ta thuanh khang;",
            "Achy ti hei laalou o,",
            "Nang Lat gaymei hei saa khang.",
            "",
            "4 Asyan-alanv laalou o,",
            "Ramh khat shini daek lak ge;",
            "Aningting hei laalou o,",
            "Nang ningmei phuna taanh khang.",
            "",
            "5 Achwn Nang khang laalou o,",
            "Mi hei atuang sw lak khe;",
            "Alung hei Nang laalou o,",
            "Mi hei Nang bamvpaeng sw khang.",
            "",
            "6 Aramzian hei laalou o,",
            "Nang phaypav khou bunlou the;",
            "Ai kapwm ta laalou o,",
            "Nang khang na ai lungc ni the."
          ]
        }
      },
