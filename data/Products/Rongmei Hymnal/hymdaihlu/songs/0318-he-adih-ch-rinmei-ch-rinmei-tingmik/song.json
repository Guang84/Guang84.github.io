        "content": {
          "format": "source-lines",
          "lines": [
            "1 He, adih ch’rynmei, ch’rynmei tingmik cho,",
            "Amuc dat lakmei tingmik;",
            "Zinghmei khou ducna ai maeng tatmei tangv,",
            "Jisu ta ai sowriw the,",
            "Adih niamhmei, zianthaymei",
            "Duangda cho,",
            "Kamei }?2 lungh tiikwnlou;",
            "Zinghmei lev ramswng Kamei }?2 laa ganclou,",
            "Ai azaeng gayna saa tuang e!",
            "",
            "Tingkauh hymdaih }?2 alung padik the,",
            "Gumeipu ata kros khou tiigay nungc",
            "Apaap guay khiu ’thanlou,",
            "Zingbangc ta kalaanv guanhlou,",
            "Tingkauh hymdaih }?2 alung padik the.",
            "",
            "2 Tingkauh panty khou Bumaengh }?2 puanclou,",
            "Ravguangc tuang kaikhunc lungc khou,",
            "Kalvari tuang ramzian }?2 tii’chumhlou,",
            "Ai hei khuay maekmei di the;",
            "Adih katumcna kalaiclou tu cho!",
            "Ai paapc mei swna guangna,",
            "Katuang zauzian kaipat laalou nungc ata",
            "Gulou the, thuanc o, Kazanc ta!",
            "",
            "3 ’Taw thu ’maan dat lakmei machunc nai the,",
            "Akhang kaganv luai sihni;",
            "Akhang thei thangc lungh khang bamv nai bam the,",
            "Gaychuymei tingkauh kai khou;",
            "Mi hei kros khou ai lwmlou nungc tingmik,",
            "Ch’rynmei tingmik paan }?2 e;",
            "Tingsaeng lanv lev muigay nimei 2}? nai the,",
            "Kabaanc khou }?2 laa tow tuang e."
          ]
        }
