        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaipouc khang gay liangmei tii o,",
            "Chabwan pumtan 7?| tii o;",
            "Nang lungning kaguay tiipatna",
            "Nchumhmei khang adow o;",
            "Jisu ?|7 kathiak ’chinlou e,",
            "Kamei bauc e, ping mak ge,",
            "Biangpiumei, champouhmei lyan o,",
            "Nang khou gay liangmei tii o.",
            "",
            "Kaipouc khang gay liangmei tii o,",
            "Chabwan pumtan 7?| tii o;",
            "Ringhbamv ricpwan",
            "kapwm piuna",
            "Nchumhmei khang adow o.",
            "",
            "2 Kaipouc khang gay liangmei tii o,",
            "Kata nang ning ’thuk liang o,",
            "Nang taanv guay khou Kachwn thanv o,",
            "Ramh guay Kakhang tiipat ro;",
            "Tiipat ro, nang khang tii puni,",
            "Ravguangc KaNac ta tii the;",
            "Neihlaana Kasiamruai sw o,",
            "Nang khou gay liangmei tii o.",
            "",
            "3 Kaipouc khang gay liangmei tii o,",
            "Zauzian pow 7?| khangclou o;",
            "Nang ta thuakloupui manv khang 7?|",
            "Kapumc kahak tiipat the;",
            "Kahym guay lou ducna key the,",
            "Nang zaeng khang ?|7 theiclou the,",
            "Nang lungh gutna Kata ’bwan o,",
            "Nang khou gay liangmei tii o."
          ]
        }
