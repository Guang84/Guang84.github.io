        "language": "rongmei",
        "title": "Chunsimei muang rui gumliam the",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Chunsimei muang rui gumliam the,",
            "Hei kandih khou hei;",
            "Njian liangmei champan thiu le,",
            "Ntam pui gan guang the.",
            "",
            "Chorus:",
            "He tam dat nimak ge (2),",
            "Jianmei champan thiu le;",
            "Tingkau bumang than diu kei o,",
            "Tingmik thui duang lou khang.",
            "",
            "2. Kalan jingbang 6$% nai makge,",
            "Raguang thuan ku khang;",
            "Ntam pui gan 6$% guang datna,",
            "Jianmei nun mik dui kei.",
            "",
            "3. Alung hei neilana nangta,",
            "Ning bam kanni the;",
            "Raguang rui jaujianmei lung khou,",
            "Tingkaumei su cham ni.",
            "",
            "4. He bumang than duang lou o,",
            "Ntam puni the;",
            "Njianmei nun jangsi bam khou,",
            "Sharon mun guang puang o.",
            "",
            "5. Jangsi rikho jianmei nun le,",
            "Ntam kan dikho;",
            "Aban jat hei rui ham guange,",
            "Jianmei guai le salam."
          ]
        }
      },
