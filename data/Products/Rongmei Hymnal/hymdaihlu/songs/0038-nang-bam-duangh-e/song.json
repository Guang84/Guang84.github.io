        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang bam ’duangh e, lauthwan gaancra pat pwkhou,",
            "Nruay thauruay guay #<8 zip’chyang thau khou;",
            "Lauthwan suangc gay, kalaanv khang suangc gay ranv e,",
            "Ai hei Nang lev bammei thay pat pwkhou.",
            "",
            "2 Nang lev bamna chingkhiuhmei ramvswng ding khou,",
            "Chingkhiuh dyng e tingmik thanh patmei hei,",
            "Nang lev bamna Nang ta bwanmei lu suan e,",
            "Zikdui ding khou chaenghringhmei lauthwan khou.",
            "",
            "3 Ai lak langvna mik rak pat ngam lak khou nganv,",
            "Mik tanguihna huayney e, Nang zanc khou;",
            "Bam zuh zu e, Nang swkaeng #<8 sungclouna,",
            "’Ki gay ranv e, Nang ta sowriw towmei.",
            "",
            "4 ’Khamhpui nungc kiu hymdaih lauthwan pat pwkhou,",
            "Zip thau pwkhou ramvswng guay maek pwkhou,",
            "Mi ganv khou 8}@ kalaanv suangc gaanc ranv puni,",
            "Adih ch’ryn ni, Nang lev lungc ’chamc nimei."
          ]
        }
      },
