        "content": {
          "format": "source-lines",
          "lines": [
            "1 Bumaengh ’Thanmei zayloumei!",
            "Khristian ta ’duanghloumei pu,",
            "Zaylou na ro, Nang baanc #^7,",
            "Ryanra dih khou gin nunc ta,",
            "Lakmei bumaengc neihlaa diu;",
            "Neihlaa khwan meic nunc chu diu:",
            "“Maengtatmei Athei lay o,",
            "Nang ta kai thangc ’duanghlou ni!”",
            "",
            "2 Kaganv ’thuic bam ’chamcmei Duang,",
            "’Khavlou khang ’naa tanvmeipu,",
            "’Patlou ri-o, pingmei khou,",
            "Zinghmei khou katham bam khou,",
            "Pwanzingh ’liu ranvna bam khou,",
            "Lungh ryanrana ningdwang khou,",
            "Saalou o: “He maengtatmei,",
            "Nang ta kai thangc ’duanghlou ni!”",
            "",
            "3 Taanc-ruaihmei panty luaina,",
            "Duakpatmei ta ’khwan bam khou;",
            "’Niu zanc naimei ta lwmna,",
            "Tingkauh na machunh bam khou,",
            "Lungh zinghmei duidai kaanna,",
            "Jisu zei ta huay bam khou,",
            "Saalou o: “He maengtatmei,",
            "Nang ta kai thangc ’duanghlou ni!”"
          ]
        }
