          "format": "source-lines",
          "lines": [
            "1 Jisu guanghtu bam the,",
            "Tingkauh guangc bamvpaeng khou;",
            "Kapy khou guangh pyrun run the,",
            "’Thanmei nunc bwan bam the.",
            "Khou 5#^ ’thanmei nunc lev",
            "Kadaeng khou bam pwkhou,",
            "’Niu lung kim puni the, ’saanh mak khou;",
            "’Saanh mak khou,’saanh mak khou;",
            "’Niu lung kim puni the, ’saanh mak khou!",
            "",
            "2 Chak ngam lakmei kangdai",
            "Kangranmei pwan piuna,",
            "Meic kathuic tadanvkwan sinna,",
            "Thuanhpui lu suan bam e.",
            "",
            "3 Kaniw phaan swluaimei",
            "Lauziu Nac ta thuanc e;",
            "Kuakloumei Kazei paan khou #^5",
            "Kaniw pyrun run e.",
            "",
            "4 He Bumaengh ’Thanmeile,",
            "’Khavlou o, aniw ta;",
            "Kaniw pangc khou kazauh ngam khang,",
            "Tingkauh khou 5#^ bam khang."
          ]
        }
