    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Jisu rui ’niu ta kaw e",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Chuzaengh maekmei panty khou )}3",
            "Jisu )}3 ’niu ta kaw e;",
            "Zianpui khwan )}3 tingmik ’thuic kaw:",
            "“He khristian, Athei lay o!”",
            "",
            "2 Gaeng makmei kandih syan-lanv ta",
            "Aniu )}3 kalum bam khou,",
            "Ravmaengc khou )}3 Jisu kaw e:",
            "“Khristian, Ata zian diangc o!”",
            "",
            "3 Neihlaa bam khou,ryanra bam khou,",
            "Amanv khou, lak khou kaw e;",
            "‘Taw nganv kaw bam,thala khou )}3:",
            "“Hei suangc Ata zian diangc o!”",
            "",
            "4 Jisu kaw e, zauzian paan )}3,",
            "He Pou, Nang khwan ’niw chu diu;",
            "’Khavlou o, Nang lat piu diangh khang,",
            "Zian diangcna siamruai sw khang!"
          ]
        }
      },
