        "content": {
          "format": "source-lines",
          "lines": [
            "1 Niamhmei Meri kaNac ta",
            "Kiruaikuak khou ’zilou,",
            "Khuay maekmei pu zip bam e,",
            "Gin swna kandih khou,",
            "Mi kumhmei Ngasatna hei",
            "Gumeipu kiu dai cho?",
            "Zaatc kathuic khou thanv zauc o,",
            "Kakhou lwmmei guay khou.",
            "",
            "2 Baanch’ra nunc Kata thuanc e,",
            "’Takmei nunc }?2 phu e,",
            "Kauh gaanchuangc }?2 gaanc key e,",
            "Hymdaihmei Kadaeng khou;",
            "Lauziu gaenghmei nunc how e,",
            "Baanch’ra lu khwan chu e,",
            "Kabamv ’thuic tiigaanc lik the,",
            "Lu khwan }?2 padik the.",
            "",
            "3 Niamhmei Meri kaNac ta",
            "Kiruaikuak khou ’zilou,",
            "Khuay maekmei Pu Kamei hei",
            "’Taw thu ginpu hamh the;",
            "Ravguangc Nac liwna puanhmei, Adih gaymei chamv cho,",
            "Dih kathuic Kazanc thuanc o, Hymdaih Guangc ta thuanc o!"
          ]
        }
