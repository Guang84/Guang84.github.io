      "rongmei": {
        "language": "rongmei",
        "title": "’Taw chabwan ganv gay khou",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang panty chaenglwan hei kaamc thau the,",
            "Saenghmei, gay hakmei chaenglwan e;",
            "’Thiammei aching ching sowriw puni,",
            "Kaidai guay siimei padik ge;",
            "Kandih khou how gaymei ’peyna nai,",
            "Theic nuhpui bamv ’peyna nai e;",
            "",
            "Nang tuang ’suanmei khou",
            "’thiam guang pw khou",
            "Nuh mak ge, twna saa ngam o.",
            "Nuh mak ge, tw o, abungle, (2)",
            "Nang bauc o, abung, (2)",
            "Nuh mak ge, tw o, abungle.",
            "",
            "2 Bauhmei >|3 nang ta tiiduak puni,",
            "Panty chaenglwan tat thau pwkhou,",
            "Pu Ravguangc khou nang ngangvlou pwkhou,",
            "Paapc khou >|3 nang ta gaeklou ni,",
            "’Thiammei hei geic ranv khith khit puni,",
            "Nang panty hei tat ku pwkhou;",
            "Nang hei maansei khat sw nii ethei",
            "Nuh mak ge, twna saa ngam o.",
            "",
            "3 Ramthay o, nang pam kapah pwkhou,",
            "Bauhmei, kalingmei ta phu o;",
            "Nchanv pwkhou pam ta ganclou rio,",
            "Pam ling phaan pam thanh kapah rio,",
            "Pam siimei >|3 nang ta ’thiam pwkhou,",
            "Zouhbuangc puanc ’chamc khang khanv pw khou,",
            "Ding ’tipna khaengsaengcna nang ding o,",
            "Nuh mak ge, twna saa ngam o."
          ]
        }
