      "rongmei": {
        "language": "rongmei",
        "title": "’Than khang kaganv laa o",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Than khang kaganv laa o, Pou lev kachuc o;",
            "Kakhou bam tanh tan o, Kalat kathai o;",
            "Lwmmei pang khou bam o, ’suanmei ta ’khav o,",
            "Khat sihni amuc rio, Kasuaihiam ney khang.",
            "",
            "2’ Than khang kaganv laa o, dih taanv taanc sihni;",
            "Jisu lev nang ney na bammei ganv geic o;",
            "Jisu ta zauc ti thei Kata nang luic ni,",
            "Nang khei khou Kakumhmei nang rup nunc how ni.",
            "",
            "3 ’Than khang kaganv laa o,",
            "Kata tiihu o;",
            "Kahu pak kasuakc rio, tabui bui punic;",
            "Neihlaa pw, ryanra pw, Kaipouc theilay o,",
            "Jisu ta zauc bam o, Kalat lwm bam o.",
            "",
            "4 ’Than khang kaganv laa o, lumh lumna bam o;",
            "Nang lungning, nang chwn guay Kata tiisin o;",
            "Bumaengh @{4 zaylou ni zianmei duipuak khou,",
            "Ravguangc taanv khou piu khang nang biuhmei sw ni."
          ]
        }
      },
