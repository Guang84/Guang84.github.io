        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kata ’niu khuay zaeng khang bai zamh the,",
            "Kamei $%6 ’niu paap guay kros ruc khou phungclou;",
            "’Niu khang chuzaenghmei tiilou,",
            "Bangcloumei ta riclou the;",
            "Kazam paan $%6 (3) ’niu gay dat the.",
            "",
            "2 ’Khuaimei pangc khou Kata chaklou the,",
            "Kata Ravguangc $%6 ganc patmei khang chaklou,",
            "’Niu ravcha swna theiclou;",
            "Latzan latdanv tii ’thuih khang,",
            "’Niu paap guay 6$% (3) Kakhou lou the.",
            "",
            "3 ’Niu meic guay chaeng maanvna maeng tat the,",
            "Lauziu Gaenghmeipu khou $%6 ’niu tat duc the;",
            "’Ki Kamei $%6 phungc guang e,",
            "’Niu ta khow’tauh ram khou $%6;",
            "Kai ’duangh guang e (3) Ravguangc pamv khou.",
            "",
            "4 Thow $%6 Katuang meikin chak ngam cho?",
            "Kros khou Kamei rih ngammei thow dinc ’dauh ni?",
            "Theihmei nunc aching ’ching 6$%",
            "Kathei layna ringc dat the;",
            "Rih ngammei pu (3) guang nimei Guangc!"
          ]
        }
