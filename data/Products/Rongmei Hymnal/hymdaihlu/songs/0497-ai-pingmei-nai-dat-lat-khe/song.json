    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "AI PINGMEI NAI DAT LAT KHE",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guloumei pu ta tat ’chamc ni,",
            "Araana thu tat ping e,",
            "Kadaeng khou ai bam tuanc bam ni,",
            "Kabaanc <~1 pamclou bam khang.",
            "",
            "Ai pingmei nai dat lak khe,",
            "Kamei <~1 zaylou bam khou,",
            "Ai nrauc makna tat ni the;",
            "Kaphaykaamv ’thuic lay tat ni.",
            "",
            "2 Guloumei pu ta tat ’chamc ni,",
            "Aramlum hei thu ’suan e;",
            "Kamei <~1 ata swmgay ngam,",
            "Baihmei lat <~1 swm ngam mak.",
            "",
            "3 Guloumei pu ta tat ’chamc ni,",
            "Panty hu biak ’zwan tat khou,",
            "Tingpwanzingh ding lev neihriw khou,",
            "Rihbamv lev rihphyan bamv khou.",
            "",
            "4 Guloumeipu ta tat ’chamc ni,",
            "Kamei <~1 chaeng zaylou ni,",
            "Jordan nzaengc guang tanghmak saanv,",
            "Kamuatcmei dui kaan mak saanv."
          ]
        }
      },
