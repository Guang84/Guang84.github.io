        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tingkauh kaidai aniu ’zwanna tat re,",
            "Kachaekc guanghdic tangh khang 8^&;",
            "Aniu guang kariu puni thei thangc kiu,",
            "Kachaekc guangcdic tingkauh khou.",
            "",
            "Kachaekc guangcdic tingkauh khou,",
            "Kachaekc guangcdic tingkauh khou,",
            "’Tamv bam khwan sihni thei thangc ’riw dat ni,",
            "Kachaekc guangcdic tingkauh khou.",
            "",
            "2 Zianmei nunc ta khou 8^& sowriw puni,",
            "Kachaekc guangcdic tingkauh khou;",
            "Rih hei ngam pwkhou aniu ariw ni,",
            "Kachaekc guangcdic tingkauh khou.",
            "",
            "3 Jisu ^&8 tii ni pyrun tingkauh khou,",
            "Kachaekc guangcdic tingkauh khou;",
            "Ryanramei khou ^&8 duak ni the khou8^&,",
            "Kachaekc guangcdic tingkauh khou.",
            "",
            "4 Thuakloumei lu 8^& aniu suan puni,",
            "Kachaekc guangcdic tingkauh khou;",
            "Jisu lev lungcna neihlaa suang ni the,",
            "Kachaekc guangcdic tingkauh khou."
          ]
        }
