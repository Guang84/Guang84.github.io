        "content": {
          "format": "source-lines",
          "lines": [
            "1 He minc bammei lau khou lautaymei,",
            "Lakmei ’suanmei nunc thiu,",
            "Guang o, Kaipouc khiuzaeng ta ’khwan o,",
            "Pumtanv tii ’luanlou khang.",
            "",
            "“Kaipouc ta ’khwanna bammei guay,",
            "Pumtan tii .. ’luan ni;",
            "Kaniw !}2 samc ku ni,",
            "Samc ku puni Egal-ruay kumcna,",
            "Pak sihni .. ryanra lak khe,",
            "Tat bam sihni lak dat lak,",
            "Pak sihni ryanra dat lak khe,",
            "Lak dat bam lak khe.”",
            "",
            "2 Geih thangc lakna chwnswpui zaeng !}2",
            "Kaipouc khou poulou e,",
            "Guloumeipu khou lwmna bam khou",
            "Kumhna lak bam ni cho?",
            "",
            "3 Neihlaa kho, Kamei ’duanghlou bam e,",
            "Katwan nganv ’duanghlou ni!",
            "Zauc thau o! baucna hu thangc gut ro,",
            "Kamei pumtan tii ni!"
          ]
        }
      },
