        "content": {
          "format": "source-lines",
          "lines": [
            "1 Amik <~1 Poubauhmei key nimei",
            "hymdaihmei ta how the;",
            "Kalungpuam drakha peicloumei",
            "khou Kaphay nii pat pw the,",
            "Katuang meic pingmei baengsaeng khou <~1 tingpalikmei pat the;",
            "’Niu Ravguangc ruan pat the.",
            "",
            "Kahym daic e, Hallelujah!",
            "Kahym daic e, Hallelujah Kahym daic e, Hallelujah!",
            "’Niu Racguangc ruan pat the.",
            "",
            "2 Kauh ricmei nunc rigaanv mairam chung khou Pou ta ai how the;",
            "Tingzyn zikdui ding khou Kakhang kaniw <~1 ravcha swlou;",
            "’Chumhmei Kalatzan 1<~ chuangc",
            "bammei maibwang riw khou how the;",
            "’Niu Racguangc ruan pat the.",
            "",
            "3 Kamei <~1 trampet ’muan kan the,",
            "ngalanh khang ’muan dat lak khe;",
            "Kalatzan bamvpaeng hu khou",
            "meic guay lung ta nzang bam the,",
            "’Khap tho, he abumaengc,neihlaana",
            "Kamei kaw khou daw khang;",
            "’Niu Racguangc ruan pat the.",
            "",
            "4 Duipui paengc thangc lilipwang ding",
            "khou Khrista puanclou khwan e,",
            "Nang lev ata tiiguanhlih ngammei",
            "hym Kakhou nai khwan e;",
            "’Niu khang Kamei theiclou kumc ’niu",
            "nic meic nunc khang theiclcou kho;",
            "’Niu Racguangc ruan pat the."
          ]
        }
