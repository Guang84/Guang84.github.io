          "format": "source-lines",
          "lines": [
            "1. Zaylou tho, he tingsaeng Guangc,",
            "Ngam gutmei ting tangc the;",
            "Nang rih ngamloumei bamv 5#^,",
            "’Niu lwng bamv sw ni the;",
            "Chamdaanv bampui ganv khou #^5",
            "Zauzian #^5 tiitanclou,",
            "Thau tho, he tingsaeng Guangcle,",
            "Nang khang rih-lu suan e.",
            "",
            "2 Zaylou tho, he tingsaeng Guangc;",
            "Paapc ric dai luai mak saanv;",
            "’Thanmei lev chuzaenghmei #^5",
            "Kandih hei zin mak saanv;",
            "Baengsaeng haimei #^5 hamh e,",
            "Rih khuangc khwan #^5 hamh e,",
            "Zianmei lev zauzian taanv #^5",
            "Kauh Guangcdic phungc guang ni.",
            "",
            "3 Zaylou tho, he tingsaeng Guangc,",
            "’Niw pingmei nai lak khe;",
            "Nang zaw howpui bamv ’thuic khou",
            "Neihlaamei padik ge,",
            "Nang tuang kros ’niw ruc khou nai,",
            "Mi #^5 chaeng zaylou e,",
            "Pyrun ’niw hu khou nai the,",
            "Zaylou tho, he ’niw Guangc."
          ]
