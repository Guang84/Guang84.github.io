      "rongmei": {
        "language": "rongmei",
        "title": "Amik hei tiirak patlou",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Amik hei tiirak patlou o,",
            "Nang lat thukh 2^< ai how ngam",
            "khang;",
            "Nsinlou o, khamvtaan chabi 2^<,",
            "Ata riclouna tiiduak khang;",
            "Reih reina ai Nang ta ’khwan e,",
            "Nang ningmei taanh khang",
            "chamdaanvna;",
            "Tiiraklou o, tiigaanclou o;",
            "Ravguangc Bumaengc.",
            "",
            "2 Anukuanc hei tiichulou o,",
            "Nang tiiguangmei ’chumhmei",
            "khwan 2^<;",
            "Nang khwan anu khou chutow",
            "pwkhou",
            "Laanhmei khwan guay ’maan kan puni;",
            "Reih reina ai Nang ta ’khwan e,",
            "ARavguangc Nang ningmei phuna;",
            "Anukuanc hei tiichulou o,",
            "Ravguangc Bumaengc.",
            "",
            "3 Amwang hah pat khang ’khavlou o,",
            "Nang tuang lat thukh ai dinc ngam",
            "khang,",
            "Chamdaanvlou o, alung laanclou o,",
            "Nang mei nunc lev kadam laa khang,",
            "Reih reina ai Nang ta ’khwan e,",
            "ARavguangc Nang ningmei phuna;",
            "Alung laanclouna tiigaanc o,",
            "Ravguangc Bumaengc."
          ]
        }
