        "content": {
          "format": "source-lines",
          "lines": [
            "1 By baklou o Ringhtyan; Kaipouc akhang,",
            "Reynungc duipui paengc khou by baklou kumc,",
            "’Thanmei Latrik paengc thangc, he Ringhmei Lat,",
            "Nang ta t’riina phu e, abumaengc ({0.",
            "",
            "2 Suaihiamlou o akhou, Nang Lat paan ({0,",
            "Nang reynungc ’tyan ruc khou suaihiamlou kumc,",
            "Khou kiu ai duak puni, kangriang taek ni,",
            "Chuzaenghmei ai laa ni, Kaipouc Nang khou.",
            "",
            "3 Nang Ringhtyan e, akhang, he Poubauhmei,",
            "’Thanmei Nang Lat paan ({0 ata gulou;",
            "Nang lev lungc ’chamc ngam khang tiitulou o;",
            "Nang Lat kahaw thay khang nchamlou o.",
            "",
            "4 Tiikey o, Nang Bumaengc ’taw hei akhou,",
            "Amik kahilouna tiihowlou o;",
            "Nang Lat thukh 0({ akhou tiithaylou o,",
            "Nang Latrik khou Nang lwn tiihowlou o."
          ]
        }
