        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaipouc Jisu, Nang khou huay e,",
            "’Khavlou mak ’thei theic puni the;",
            "Nang ringcbamv akhou tiilou o,",
            "",
            "Laalou na ro ata!",
            "Laalou na ro ata!",
            "Laalou na ro ata!",
            "Azaeng khang Jisu theiclou the,",
            "Laalou na ro ata!",
            "",
            "2 Ngam makmei ai, khuay geihmei e,",
            "Nang zei keymei 8^& akhang e;",
            "Nang ningmei ata swlou o,",
            "Laalou na ro ata!",
            "",
            "3 Ramh sw thuy lakmei e ai hei;",
            "Alungdyng guay ding ngam mak ge,",
            "’Ki Nang ata kanlou ngam e,",
            "Laalou na ro ata!",
            "",
            "4 Pou, ai Nang phaypav khou guang the,",
            "Nang ^&8 kahawmei swlou tho;",
            "Nang taanv gaymei taanc suaklou tho,",
            "Laalou na ro ata!"
          ]
        }
