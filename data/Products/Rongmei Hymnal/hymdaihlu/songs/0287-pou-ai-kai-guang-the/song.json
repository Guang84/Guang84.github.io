        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc khou ?|7 ai tat duc the,",
            "’Taw ai kai guang the,",
            "Paapc chaeng khou ai tat saengckhwan the,",
            "Pou, ai kai guang the.",
            "",
            "Kai guang the, kai guang the,",
            "Tat ’maan dat lak khe;",
            "Zauzian paan Nang mei sw ni,",
            "Pou, ai kai guang the.",
            "",
            "2 Kunghmei kaganv guay sw ’maan the,",
            "’Taw ai kai guang the;",
            "Mikdui keyna alung laic the,",
            "Pou, ai kai guang the.",
            "",
            "3 Paapc khou ai ryanra the, Kaipouc,",
            "’Taw ai kai guang the;",
            "Nang lat, Nang zauzian ai lwm ni,",
            "Pou, ai kai guang the.",
            "",
            "4 Bumaengh nau the, lungh kabiu the,",
            "’Taw ai kai guang the;",
            "Pumtan, machunh tii ’thanlou o,",
            "Pou, ai kai guang the."
          ]
        }
      },
