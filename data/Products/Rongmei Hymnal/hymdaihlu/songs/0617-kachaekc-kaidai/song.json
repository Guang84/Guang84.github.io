        "content": {
          "format": "source-lines",
          "lines": [
            "1 Theihmei ’zaengc paengc thangc 5#^ kaidai akhat nai e,",
            "Karamgai 5#^ saa tangc thuy mak ge;",
            "Neihmik nic key dat mak,thingnwang nic kamv dat mak;",
            "Gaychuymei kachaekc kaidai",
            "khou 5#^.",
            "",
            "Neihmik nic .. key dat mak,",
            "Thingnwang nic kamv dat mak,",
            "Lwmloumei guay mik #^5",
            "Kaipouc ta how puni;",
            "Gaychuymei kachaekc kaidai khou 5#^.",
            "",
            "2 Khou 5#^ ’niu zianmei pu, Guangh, Guloumei pu ta",
            "Lwmloumei nunc #^5 how puni the;",
            "’Thanmei nunc gaanchuangcna",
            "kumc tingsaeng gaanc bam ni;",
            "Gaychuymei kachaekc kaidai khou 5#^.",
            "",
            "3 Kros daeng khou ’niu #^5 phungc guangloumei bumaengc guay,",
            "Khuam guangloumei lauziu guay 5#^ #^5",
            "Kachaekc dandi swna ’niu pyrun karuh ni,",
            "Gaychuymei kachaekc kaidai khou 5#^."
          ]
        }
