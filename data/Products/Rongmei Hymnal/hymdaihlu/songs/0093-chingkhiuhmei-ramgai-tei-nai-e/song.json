          "format": "source-lines",
          "lines": [
            "1 Chingkhiuhmei ramgai 7}$ nai e,",
            "Gumeipu zawpaanv khou,",
            "Hymganhmei #^7 Kapyrun e,",
            "Zauzian hei Kalat re. (2)",
            "",
            "2 Kamei lev kida khang maek ge,",
            "Maansei nac nunc pang khou;",
            "Tingkauh thangc gay liangmei khang suangc",
            "Kamei hei gay ranv e. (2)",
            "",
            "3 Theic nimei alwnlung howna,",
            "Thuaklou khang keylou e;",
            "Zakmei kros 7}$ akhang phungclou,",
            "Aryanra guay phungclou. (2)",
            "",
            "4 Ai ringhmei hei Kapaan #^7 e,",
            "Kakhou ai neihlaa e;",
            "Theihmei ruc khou rih tiingamlou,",
            "T’rou khou #^7 gulou e. (2)",
            "",
            "5 Kakhou #^7 heizu laatowmei,",
            "Zauzian pow phunghmei hei,",
            "Alungthw chingkha nai khwan ’thei",
            "Pou, Nang khang na tii ni. (2)"
          ]
        }
