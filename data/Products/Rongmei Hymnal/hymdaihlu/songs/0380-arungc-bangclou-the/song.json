        "content": {
          "format": "source-lines",
          "lines": [
            "1 Panty duipui khou abumaengc",
            "tat khwan e,",
            "Paapc lev ryanra puatrith phungcna;",
            "“Akhou guang o,”twna kawmei khwan ai chuna,",
            "Ai guang ’thaekc the, “Rungh ’thaekc zeic kwn” khou.",
            "",
            "Arungc bangclou the,",
            "“Rungh ’thaekpui zeic kwn” khou,",
            "Duipui khou ai ruan dat lak khe;",
            "Kathuak siimei pwanzinghaliu ranv guang sihni,",
            "Jisu khou ai tingsaeng zaengthaek the.",
            "",
            "2 Kamei #<8 ata nzianna pamclou e,",
            "Kalat khou ai kwmlou nungc 8}@,",
            "Kangriang guay 8}@ taek the,",
            "abumaengc zaengthaek the,",
            "AKaipouc hei “Rungh ’thaekc zeic kwn” e.",
            "",
            "3 Kaipouc #<8 ata tiigaylou nungc 8}@ #<8",
            "Suaihiam lu hei ai suan bam e,",
            "Kakhou guangmei guay ta Jisu #<8 gulou ni,",
            "Tiibamlou ni, “Rungh ’thaekc zeic kwn” khou.",
            "",
            "4 Guang tho, Jisu khou, nang ta ’khwan saengc guang the,",
            "Katuang Rav ngamv #<8 gulou khang;",
            "Guang ’thaekclou tho,nang bumaengc",
            "“Rungh ’thaekc zeic kwn” khou,",
            "“AKaipouc hei akhang the,” twna."
          ]
        }
