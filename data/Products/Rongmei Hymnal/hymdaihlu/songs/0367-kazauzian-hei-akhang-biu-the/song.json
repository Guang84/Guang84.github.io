        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kazauzian hei akhang biuc the!",
            "Ai ping kadunhna Kadaeng khou anaa guang khou,",
            "Kamei )}3 apaap guay lev alung sw ’thanlou,",
            "Kazauzian hei akhang biuc the.",
            "",
            "Akhang, akhang,",
            "Kazauzian hei akhang biuc the,",
            "Akhang, akhang,",
            "Kazauzian hei akhang biuc the.",
            "",
            "2 Kazauzian hei akhang biuc the!",
            "Ai chu e Kamei )}3 “ Ping riu,” twna saamei,",
            "Phahraengh kathuic khou )}3",
            "gaeklouna tiiduaklou;",
            "Kazauzian hei akhang biuc the.",
            "",
            "3 Kazauzian hei akhang biuc the!",
            "Akhang kadanlou e, kai biak zay guanglou e;",
            "Kaswkaeng bangc khou zaeng ’thaekcna lu suan bam ni,",
            "Kazauzian hei akhang biuc the.",
            "",
            "4 Kazauzian hei akhang biuc the!",
            "Gaychuymei kai thangc kiu mi hei alu sw ni;",
            "AGuangc ta thuancna ai tingsaengzaeng suan bam ni;",
            "Kazauzian hei akhang biuc the."
          ]
        }
