        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tingmik ’thuic neihmik patna",
            "Lauthwan pum tiigaanclou kumc,",
            "Pou ’niw lungh khat na swna",
            "’Niw lungsyng Nang ta thuanc e.",
            "",
            "2 Tingmik ’thuic taektw tiilou,",
            "Gaymei guay Nang khou ^&8 e,",
            "’Niw bumaengc khang pumtan hei",
            "Ringhmei ’Tyan, Nang khou ^&8 e.",
            "",
            "3 Paapc khou ^&8 gaeklou na ro,",
            "Zayloumeipu swlou o,",
            "Nang khou ^&8 maeng tat mak khang,",
            "’Niw phaykaamv ta gaeklou o.",
            "",
            "4 Bumaengh ^&8 tiiluanlou o,",
            "Nang ningmei khou tat ngam khang;",
            "’Niw Nang Lat kathai bam khou",
            "Ningting tiilou o, Kaipouc. Amen."
          ]
        }
      },
