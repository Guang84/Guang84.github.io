    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "He nthukmei zauzian! akhang cho",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Laanclou bammei raenghmun khat nai,",
            "Chaengmun khou #^5 gaanc pat re,",
            "Duh thangc ding bammei kros riw 5#^,",
            "Gumeipu ramzian lyanna.",
            "",
            "He, ’thukmei zauzian! akhang cho,",
            "Raengh kaimun laanclou bammei hei?",
            "Akhang .. akhang?",
            "Akhang laanclou bam cho?",
            "",
            "2 Laancloumei raenghmun meic guay khang,",
            "Ringhbamv phupui mei khang e;",
            "Lungcsii, lungcgay, ’thyamhmei, daihmei,",
            "Zaatziu kathuicna khang e.",
            "",
            "3 Gut tho, zauczihmei nai sihni,",
            "Zauzian raengcmun laanc bam khou;",
            "Kros hei phungc tho, pyrun laa khang,",
            "Tingsaeng zauzian madan hei.",
            "",
            "4 Dui paengc kaan pat nungc lou key ni,",
            "’Taw phungc bammei ’niu kros hei,",
            "Khou kiu ringhmei pyrun runna",
            "Kauh khou Kata zian diangc ni."
          ]
        }
      },
