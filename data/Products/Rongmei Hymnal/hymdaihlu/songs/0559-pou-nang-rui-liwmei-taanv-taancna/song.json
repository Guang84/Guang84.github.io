    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Pou , Nang rui liwmei taanv taancna",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Pou, Nang ^&8 liwmei taanv taancna",
            "Nang ramzian 8^& lyanlou e;",
            "Kros khou ganc ’ruloumei paan ^&8",
            "Zauzian taanv taanc ’thuihlou the;",
            "Nang bangc nunc Nang ta kalum e,",
            "Khwan lev lungning kapwm ^&8;",
            "Nang taanv khang ^&8 reicpatlou e,",
            "Nang tuang kaipat kaguay hei.",
            "",
            "2 Nang nac nunc kai maekmei nai e,",
            "Ndaapc tariimei nai e;",
            "Nyngswmei kahawna bam e;",
            "He Kaipouc, kadanlou o,",
            "Tiigaylou, tiiduaklou o,",
            "Nang Bumaengc paan ^&8 zianmei ^&8",
            "Meic nunc lung tiigaylou o.",
            "",
            "3 ’Niw kalum bam khou tiilou o,",
            "Nang ramzian thukh ta thay khang,",
            "Kasaanv-kadiat, kakau-kathukh",
            "’Niw lung khou how tangc ngam khang;",
            "Kage naimei lev puatrith guay",
            "Meic nunc khou tiithaylou khang;",
            "Nang tuang padikmei panty 8^&",
            "Meic nunc nic kadam laa diu!",
            "",
            "4 Kalummei khou ^&8 taanvdwan khou",
            "Nang zanc khou ’niw tatpat re,",
            "Alauc, gaanthauh, chabwan nunc khou",
            "Zianmei taanv 8^& lyanlou ni;",
            "Machunhmei, pumh gay, swmloumei,",
            "Chuzaenghmei ’niw phungc guang e,",
            "Khou kiu Nang nah nunc nyngswna",
            "Nang ramzian thayna lungc ni."
          ]
        }
      },
