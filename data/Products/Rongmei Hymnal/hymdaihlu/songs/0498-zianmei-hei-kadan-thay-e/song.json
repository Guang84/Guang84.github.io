        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zianmei hei kadan thay e,",
            "’Khaengvsaengc e, lungning niamh e;",
            "Zianmei thu sii khang sw mak,",
            "Zianmei tiilou o.",
            "",
            "2 Ravmundinhmei ’thaekc puni,",
            "Kalaanv riw khou ’maan kumcna;",
            "Zianmei thu nai bam puni,",
            "Zianmei tiilou o.",
            "",
            "3 Lwmmei hei how tangc pwkhou,",
            "Machunhmei guang tangc pwkhou,",
            "Zianmei thu gaanc ranv puni,",
            "Zianmei tiilou o.",
            "",
            "4 Lwmmei, machunhmei, zianmei,",
            "Kathumh hei nai bam puni,",
            "Tiki mi kathumh pangc khou",
            "Zianmei daic liang e."
          ]
        }
      },
