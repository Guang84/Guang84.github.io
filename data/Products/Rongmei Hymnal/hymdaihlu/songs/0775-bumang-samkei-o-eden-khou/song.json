      "rongmei": {
        "language": "rongmei",
        "title": "Bumang samkei o Eden khou",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Bumang samkei o Eden khou puat guai,",
            "Mungam louna nang ramgai 5#^ juanni;",
            "Houni kagun daimei kapumma,",
            "Thuanku puilat puan kumma liu louni.",
            "",
            "Chorus:",
            "Immanuel nang jaujian pilung khou,",
            "Rianra pui rihdai e naguang datro;",
            "Ngalan guang o aniu ringmei nange,",
            "Nang jaujian pilung khou hei,",
            "Rianra pui rihdai e.",
            "",
            "2. He neilamei le suaihiam pui tingmik,",
            "Nang ringmei chang gaimei khou duang lou o;",
            "He Jordan dui daimei rui kamuatna,",
            "Kanan ram gaimei khou kan pat lou o.",
            "",
            "3. Sam thaina akhou na kum sam ethei,",
            "Ai ningmei kalvari ching samtang ni;",
            "Kandih ramgai hei ai lou dupu khou,",
            "Neilapui ram gaimei 5#^ njuanni.",
            "",
            "4. He ai neilapui tingmik man pukhou,",
            "Neilamei namdai gai khou ai bamni,",
            "Kalvari ching thuanna ai lu suanni,",
            "Khangloumei 5#^ mu maknga suan bamni."
          ]
        }
      },
