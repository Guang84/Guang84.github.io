    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Duipui khou rui duipui nganv",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Duipui khou #<8 duipui nganv,",
            "Pou, Nang ta laalou diu;",
            "Nang ta bwanna kalum diu;",
            "Guangh, Nang lat piu kan diu;",
            "Chyngkauh guay lev nzaengc guay,",
            "Nwm lev laupuk guay #<8,",
            "Duibaek, zeihlat, duipuak guay",
            "Kaipouc, Nang ta thay diu.",
            "",
            "2 He Khrista, Nang zanc zaeng khang,",
            "’Niw kandih zaeng khang #<8,",
            "’Niw niamhna Nang khou huay e,",
            "Nang hym lungc lyan ngam khang,",
            "Pou, Jisu, Nang baanbaengv ta",
            "’Niw thay khang swlou o;",
            "’Niw ravpuat tiigaylou o,",
            "’Thiammei ta rih ngam khang.",
            "",
            "3 He Guloumei pu, ’niw Guangc,",
            "Gaeklou, zaylou na ro;",
            "Nang ramzian, Nang tuang gaanhmei,",
            "Lungc lyan khang ’khavlou o;",
            "Biangpiuna siamruai sw khang,",
            "Nang lat #<8 zin lik khang,",
            "Duipui khou #<8 duipui nganv,",
            "Nang ta laalou mak saanv.",
            "Amen."
          ]
        }
      },
