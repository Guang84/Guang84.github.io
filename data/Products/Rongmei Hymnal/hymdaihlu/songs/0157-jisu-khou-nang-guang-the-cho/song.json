    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Jisu khou nang guang the cho?",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Khiu ’thanlou khang Jisu khou nang guang the cho?",
            "Lauziu Nac zei khou 3>| khiu the cho?",
            "’Taw na hei nang Kazauzian khou lwm the cho?",
            "Lauziu Nac zei khou 3>| khiu the cho?",
            "",
            "Khiu the cho, zei khou 3>|?",
            "Bumaengh sw ’thanmei Lauziu zei khou,",
            "Nang pheybaan guay gunh kumc sou ’phwan ngam the cho?",
            "Lauziu Nac zei khou 3>| khiu the cho?",
            "",
            "2 Gumeipu lev tingmik pum tat bam the cho?",
            "Lauziu Nac zei khou 3>| khiu the cho?",
            "Kros khou theicloumei pu khou zaeng ’thaekc bam cho?",
            "Lauziu Nac zei khou 3>| khiu the cho?",
            "",
            "3 Nowpouc guang khou nang pwan guay 3>| ’phwan ni cho?",
            "Lauziu Nac zei khou sou ’phwan the cho?",
            "Gaanhmei kai khang nang bumaengc chamdaanv the cho?",
            "Lauziu Nac zei khou 3>| khiu the cho?",
            "",
            "4 Luak ganc ngam tho, paapc >|3 sw ’phuammei pheybaan,",
            "Lauziu Nac zei khou 3>| khiu the cho?",
            "’Phuammei bumaengc khiu ’than khang duipuak luangc bam,",
            "He, Lauziu Nac zei khou khiu la tho!"
          ]
        }
      },
