          "format": "source-lines",
          "lines": [
            "1 Pou, ai Nang mei e, Nang khwan ai chuna,",
            "Nang zauzian khou lwmlou the;",
            "’Ki lwmmei paan _>6 Nang pamv khou kuna",
            "Nang daeng tuancna bam nii e.",
            "",
            "Zay guanglou .. o, guigaymei Kaipouc,",
            "Nang theicloumei kros khou 6_>;",
            "Zay tuanclou o, ata guigaymei Kaipouc,",
            "Nang zei keyloumei bamv khou.",
            "",
            "2 Nang taanv khang ata ’taw reicpatlou o,",
            "Ravguangc zauzian baantan _>6;",
            "Alungning ’tipna machunhna zauc diu,",
            "Ai ningmei Nang khou ’maan diu.",
            "",
            "3 He adih neihlaa matat khat sihni",
            "Nang lev kadam laa ’chamcmei!",
            "Khuksunna huayna, aRavguang, Nang ta",
            "Duangda ta kumc kachuc khou.",
            "",
            "4 Ai _>6 thay tangc lakmei ramzian nai e,",
            "Duimei panty luai mak saanv;",
            "Ai thay tangc lakmei ramneilaa nai e,",
            "Nang pamv khou zaeng sw mak saanv."
          ]
