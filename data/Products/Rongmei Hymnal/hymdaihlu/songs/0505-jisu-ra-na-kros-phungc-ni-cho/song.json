        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu raana kros phungc ni cho,",
            "Meic guay pumsa tatna?",
            "Hamh e, meic kathuic khang kros nai,",
            "Akhang nic kros khat nai.",
            "",
            "2 Katpatmei kros hei ai phungc ni,",
            "Apanty luai mak saanv;",
            "Hei tangv tingkauh kai thangc ’zwan ni,",
            "Khou 8^& pyrun laa ni.",
            "",
            "3 Kangran gaymei tingkauh kai khou,",
            "Jisu phayba bam khou,",
            "Neihlaana pyrun luak key ni;",
            "Kunghmei zanc thuanc dat ni.",
            "",
            "4 He kunghmei kros! he Guangh pyrun!",
            "He ringcthaumei tingmik!",
            "He baanch’ra thiu, samc keylou o,",
            "Ata phungc kulou o!",
            "",
            "Thomas Shepherd"
          ]
        }
