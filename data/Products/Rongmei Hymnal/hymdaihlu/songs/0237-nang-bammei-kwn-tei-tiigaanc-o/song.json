    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Nang bammei kwn tei tiigaanc o",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Taanv daihmei taanc nuhmei",
            "ganv guang mak saanv ’khwan bam rio,",
            "Nang riw tiigaanc duh khang",
            "’khwan bam rio;",
            "Nang daeng khou nai geihmei taanv guay taanc chuyna taanc o,",
            "Nang bammei kwn 7}$ tiigaanc o.",
            "",
            "Nang bammei kwn 7}$ tiigaanc o,",
            "Nang bammei kwn 7}$ tiigaanc o,",
            "Jisu khou #^7 duhmei gaanv saekc",
            "Nang riw how diu khang,",
            "Nang bammei kwn 7}$ tiigaanc o.",
            "",
            "2 ’Niu ruc khou muangh zinghmei hac ganh khang ’khavlou nuh e,",
            "Nang khang na chwn #^7 nang chaeng thingh rio;",
            "Nang lu #^7 lungh ryanramei",
            "ta tiineihlaa nuh e,",
            "Nang bammei kwn 7}$ tiigaanc o.",
            "",
            "3 Kalat kathai pwkhou Ravguangc #^7 ’khavlou pwni,",
            "Paapc #^7 nang taanv ta tii’phuamlou rio;",
            "Nang zaw gaanhmei khou #^7",
            "meic nunc Kaipouc ta how diu,",
            "Nang bammei kwn 7}$ tiigaanc o."
          ]
        }
      },
