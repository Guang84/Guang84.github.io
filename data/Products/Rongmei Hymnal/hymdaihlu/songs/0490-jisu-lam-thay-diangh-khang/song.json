        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu lam ai thay diangc nii e,",
            "Meic khou zauzian ’buna lyan khang;",
            "Kamei guloumei thay diangh khang,",
            "Zianna theicloumei thay diangh khang.",
            "",
            "Jisu lam thay diangh khang,",
            "Jisu lam thay diangh khang,",
            "Guloumei lam thay diangh nii e,",
            "Zianna theicloumei thay diangh khang.",
            "",
            "2 Jisu lam hei kathai diangc ni,",
            "Kamei kahawmei thay diangh khang;",
            "Bumaengh ’Thanmei $%6 Jisu lam",
            "’Chamloumei pu tiiswlou o.",
            "",
            "3 Ravguangc Lat hei ai kathaina,",
            "Kaipouc lev kadam laa ’chamcna,",
            "Latkaeng ’thuic khou Kakhwan chuna,",
            "Kalatryan guay akhang laa ni.",
            "",
            "4 Jisu lam hei thay diangc nii e,",
            "Kahym daicna guanghtu nimei,",
            "Kaguangcdic daicthau changh nimei,",
            "Guangh swna guang dat nimei lam."
          ]
        }
