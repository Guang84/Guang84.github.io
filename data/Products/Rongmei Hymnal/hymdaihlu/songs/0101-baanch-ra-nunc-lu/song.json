        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zingbangc zipchwng tingpuk thangc <~1",
            "Kauh hymdaih lu suan chinh chin key e;",
            "Nuh gay kanmei lu daihmei e,",
            "Baanch’ra kangdai <~1 suanmei lu 1<~!",
            "",
            "“Kauh liangmei khou hymdaic kan diu!",
            "Dih khou chwn gay, chuzaengh- mei nai diu!\"",
            "Kagaengv bam diu meickin kathuic,",
            "Kauc ’daw diu, Neihlaa dih <~1!",
            "",
            "2 Lauziu gaenghmei nunc <~1 how e,",
            "Chutow e, baanch’ra nunc latchamv 1<~;",
            "Khuksun keyna kaniw kalum,",
            "Lu khwan <~1 tingpuk kangim bam khou.",
            "",
            "3 Thauh teyloumei, Guloumeipu,",
            "’Niu pow khangclou khang dih khou key e,",
            "Ryanrapui mei, ganc patpui mei,",
            "Ravguangc Lauziu Nac kiu Kamei e."
          ]
        }
      },
