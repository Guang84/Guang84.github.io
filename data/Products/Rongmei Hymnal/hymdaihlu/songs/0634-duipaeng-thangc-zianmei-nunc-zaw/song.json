        "language": "rongmei",
        "title": "Duipaeng thangc zianmei nunc zaw",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Dui paengc thangc ’zianmei nunc zaw how e,",
            "Lauthwan lwn kumc gay,",
            "chaengphaengc bam e,",
            "Kaniw khou ryanra lakmei maek khe;",
            "",
            "Aniu ta chaengphaengcna ’khwan bam e.",
            "’Niu biak zauc bam e, ’niu biak zauc bam,",
            "Khou6$% zianmei nunc chaengphaengc bam e;",
            "Lauthwan lwn kumc gay, kalaanv kumc gaanc,",
            "Zianmei nunc hymdaihmei khou phaengc bam.",
            "",
            "2 Pui lev pu $%6 dui paengc kaan patna,",
            "Zianmei guay ta nkhwanna bam e;",
            "Aniu guangmei chaengphaengcna bam e;",
            "Rungh-’thaekcbamv khou",
            "nkhwanna bam e.",
            "",
            "3 Chana swanrey nunc tat rey kan the,",
            "Aniu guangmei ta nkhwan bam e;",
            "Kaniw pwanrai guay gunh suangc ’phwan e,",
            "Zianmei nunc guangmei ta",
            "’khwan bam e.",
            "",
            "4 ’Pamv-’ziwna kunghmei tat kanmei 6$%,",
            "Zianmei kaikhunhmei ta ’khwan bam e,",
            "Neihriw kumc gaanhmei, zikdui kumhmei",
            "Nzianmei nac 6$% nkhwan bam e.",
            "5 Gaanhmei lauthwan gaanphiu Jisu $%6",
            "Sangdiuh thangc ’maanmei ta phaengc bam e;",
            "Chu lo, chamv gaymei, ’puay tat ritho,",
            "“Kai guang o, paapc mei!” Jisu kaw e."
          ]
        }
      }
