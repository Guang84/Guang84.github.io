      "rongmei": {
        "language": "rongmei",
        "title": "APUMSA A I TAT NINA CHO?",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Apumsa ai tat nina cho,",
            "Thuakloumeipu ariw khang?",
            "Neih khat na sic taanclou makna",
            "Kakhou tabui phungc guang ni?",
            "",
            "Apumsa ai tat nina cho,",
            "Thuakloumei pu ariw khang?",
            "Gaanv khat sihni ’duangh guang makna",
            "Abaanc raeng ’kumh guang ni cho?",
            "",
            "2 Theihmei ta mu ai ping mak khe,",
            "Poubauhmei ^&5 gulou the;",
            "Apumsa Kata ariw khang",
            "Alung ryanrana bam e.",
            "",
            "3 Paapc taanv khou ’maan kanmei ganv guay",
            "Kaw guang dat ngam nuh khwan ’thei,",
            "Gumei pu khang ai tiipatna",
            "Kachwn khou lungc ni tuang e.",
            "",
            "4 Thau la tho, he ’thanmei guayle,",
            "Kaganv nai khou taanc la tho!",
            "Theihmei 5^& ^&5 lay tangh mak khou,",
            "Bumaengh khuam nuh khou khuam tho."
          ]
        }
      },
