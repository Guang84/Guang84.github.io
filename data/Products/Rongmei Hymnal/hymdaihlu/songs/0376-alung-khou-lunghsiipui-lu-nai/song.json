        "content": {
          "format": "source-lines",
          "lines": [
            "1 Alung khou lunghsiipui lu nai,",
            "Neihlaa zaenggaypui lu chyam e;",
            "Ai suan kaluaih luaihna suan e,",
            "Chuzaenghmei Ravguangc kaipat.",
            "",
            "Chuzaenghmei e,",
            "Tingkauh tuang ch’rynmei kaipat;",
            "He ch’rynmei, ch’rynmei chuzaenghmei,",
            "Chuzaenghmei Ravguangc kaipat.",
            "",
            "2 Kros paan _>6 chuzaenghmei liulou,",
            "Karamthei _>6 apow khangclou;",
            "Hei hamhna baihmei chaeng maek ge,",
            "Ravguangc tuang chuzaengh laa khang.",
            "",
            "3 Jisu ta ai laalou khou _>6",
            "Alung khou chuzaenghmei padik,",
            "Suaihiam geicna ai laa tow the;",
            "Chuzaenghmei Ravguangc kaipat.",
            "",
            "4 Jisu paan ai chuzaengh bam the,",
            "Kadaeng khou ai bam tuanc pwkhou",
            "Chuzaenghmei _>6 padik puni,",
            "Chuzaenghmei Ravguangc kaipat."
          ]
        }
      },
