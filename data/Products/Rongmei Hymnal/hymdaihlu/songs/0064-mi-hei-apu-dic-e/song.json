        "content": {
          "format": "source-lines",
          "lines": [
            "1 Mi hei aPu dic e,",
            "Damcloumei puat guay lev,",
            "Mbaanv guay ({0 thuanhpui lu khwan",
            "Anu khou chu guang e;",
            "Mi hei aPu dic e,",
            "Khow, dui, thing-’tauh, tingpuk,",
            "Kabaansyam guay makumh pwkhou",
            "Alung khou thuancku e.",
            "",
            "2 Mi hei aPu dic e,",
            "’Ruayna guay ({0 thuanc e,",
            "Lauthwan gaanhmei lev mwnpwang guay",
            "Damhmeipu ta thuanc e;",
            "Mi hei aPu dic e,",
            "Kariw ({0 tigaanc e;",
            "Thingnwang kathiau khou Kapha khwan",
            "Kabamv ’thuic Kakhwan chu.",
            "",
            "3 Mi hei aPu dic e,",
            "Ata tiimuclou rio,",
            "Siimei ({0 zyn bam kumc sihni",
            "Latzanpouc Ravguangc de,",
            "Mi hei aPu dic e,",
            "Diw sii bam khang nai cho?",
            "Ravguangc ({0 guanghtwna bam de,",
            "Kauh lev dih neihlaa diu."
          ]
        }
