        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kandih lwn ramgai zaeng khang,",
            "Tingpuk kauh ramgai zaeng khang,",
            "Zianmei #<8 ’niw ringcting saanv",
            "’Niw daeng guay zynmei zaeng khang.",
            "",
            "He ramh guay Kaipouc Nang ta",
            "Neihlaapui lu #<8 thuanc e.",
            "",
            "2 Kaganv ’thuic gaymei zaeng khang,",
            "Zingbangc lev kalaanv zaeng khang,",
            "Chyng, ’zaengc, thing-’tauh, nwm zaeng khang,",
            "Bw, Neih, Gaanchuangcna zaeng khang.",
            "",
            "3 Maansei riangluaic guay zaeng khang,",
            "Khat khat ta zianmei zaeng khang,",
            "Kauh lev dih pam nunc zaeng khang,",
            "Kadanthaymei lung zaeng khang.",
            "",
            "4 Nang tuang phwamling kaganv ’thuic,",
            "’Thanmei baanc zay kauh thauna,",
            "Kabamv ’thuic khou Karamzian",
            "Nang khang kat bammei zaeng khang."
          ]
        }
      },
