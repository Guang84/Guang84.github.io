          "format": "source-lines",
          "lines": [
            "1 Guang tho, he lungh kabiumei thiu,",
            "Jisu ruan pat pw the;",
            "Zauc o, zay kariumei pu zaw,",
            "Zauzian guang laa la tho.",
            "",
            "Ruan .. pat the, .. ruan pat the,",
            "Katumcna chaeng khou ariw tho,",
            "Jisu aseic ruan pat pw the;",
            "Ruan .. pat the, .. ruan .. pat the.",
            "",
            "2 Guang tho, ndaapc t’riimei thiule,",
            "Jisu ruan pat pw the;",
            "Ringhmei taektw tiilou pw diu,",
            "Nang ta tiikimlou diu.",
            "",
            "3 Guang tho, he lakmei, zaeng ’thaekc tho,",
            "Jisu ruan pat pw the;",
            "Guang tho, kahawmei tiilou diu,",
            "Kapamv khou guang bam o.",
            "",
            "4 Guang tho, puatcrith",
            "phunghmei thiule,",
            "Jisu ruan pat pw the;",
            "Nang huayneymei chulou puni,",
            "Suaihiam tiilou puni."
          ]
        }
