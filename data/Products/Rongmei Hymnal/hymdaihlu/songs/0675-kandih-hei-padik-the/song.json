        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kandih hei padik the,",
            "Tingpuk kachan the;",
            "Zawpaanv guay gaanc gay the,",
            "Nzianmei riw khou;",
            "Meic kathuic neihlaa e,",
            "Thuanhmei padik ge,",
            "Neihlaamei lu khwan {:1",
            "Zingbangc kalaanv suan.",
            "He p’riuhna tiimei pu,",
            "Ramh guay lyamlaih the,",
            "Lautay ramneihlaa kumc,",
            "Nang khou neihlaa e.",
            "",
            "2 Neihriw lev chapuak ting,",
            "Zikdui tiilou e;",
            "Lauphunhswan, tinglwm khou",
            "Tiikaluanlou e;",
            "Chakaanv ganv gaymei khou",
            "Napbi padik ge,",
            "Sakbi-sakba makna",
            "Saamh khou phungc guang e.",
            "",
            "3 Dih laupuk minc ngam the,",
            "Gaanhmei neicriw {:1;",
            "’Niu tatloupui bamv ’thuic",
            "Gaanhmei phungc guang e;",
            "Lautaymei thouclou o,",
            "Minhmei lauzam khou;",
            "Zaatc guay ta khuam guang khang,",
            "Ringhbamv tiilou khang."
          ]
        }
      },
