        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Gaymei panty dui sih e,",
            "Thingnuy paanvnu ’tangv kumc e,",
            "Napchu bangcmei lev ’chamc e;",
            "Nyan lam e!",
            "Samhmei tingmik @{4 dinc e,",
            "Nang san ndauh puni the,",
            "Theic nimei san sw lam e;",
            "Nyan lam e!",
            "",
            "Nyan lam e! .. nyan lam e!",
            "Jisu @{4 nang ta kaw bam khou,",
            "Nyan lam e!",
            "Paapc khou nang bam saengc ethei,",
            "Raenghmun mbangh rey kan ni;",
            "Nang kapmei gaengc mak puni;",
            "Nyan lam e!",
            "",
            "2 Gaymei mwnpwang kim nuangc e,",
            "Chabwan lev gaymei thian de;",
            "Nang ringc saengc bam khang ning riu;",
            "Nyan lam e!",
            "Ravguangc Bumaengc kaw bam khou,",
            "Paapc mei ruan saengc bam ri tho,",
            "Hamh ethei nang chuak lam e;",
            "Nyan lam e!",
            "",
            "3 Kaganv katumcna tat the,",
            "Latzan lev theihmei ’naa the;",
            "Jisu pamv khou samc guang tho,",
            "Nyan lam e!",
            "Kathukh hei chak chuy zauc o,",
            "Theihmei @{4 lay tangh mak khou,",
            "Bumaengh t’ruaih khou ’maan",
            "mak khou,",
            "Nyan lam e!",
            "",
            "4 Paapc mei, lat hei ’king chuy lo,",
            "Kaipouc Jisu ta laa tho,",
            "Tingkauh guay neihlaa puni;",
            "Nyan lam e!",
            "Zingh khou @{4 gaanh khou",
            "guang tho,",
            "Jisu tii nzihlou diu;",
            "Guang tho, tingkauh tat thau tho;",
            "Nyan lam e!"
          ]
        }
      },
