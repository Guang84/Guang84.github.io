    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Alungsyng thangc neihlaa lu",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Alungsyng thangc neihlaa lu khwan nai,",
            "Jisu akhou saalou e:",
            "“Ping riu, Ai nang lev lamluai bam e,”",
            "Panty chaenglwan kathuic khou.",
            "",
            "Jisu, Jisu, Jisu,",
            "Kungc liangmei zanc e,",
            "Kahaw tuang guay tiilou,",
            "Ata lu tiisuanlou e.",
            "",
            "2 Kazauzian daihmei ai laa towna,",
            "Kaswkaeng khou zaeng ’thaekcna,",
            "Kazawpaanv ta mating tanv bam e,",
            "Hei zaeng @<4 ai suan tuang e.",
            "",
            "3 ’Thukmei dui khou tiitatlou sihni,",
            "’Chanvmei ’peyna ’riw sihni,",
            "Ramvrungh sii, chaengnganv sii kumc sihni",
            "Kaphaypav maengc how bam e.",
            "",
            "4 Key nuangc puni the, ata laa khang,",
            "Tingpuk paengc thangc phungc ku khang;",
            "Thay makmei dic thangc samc ku puni,",
            "Kamei lev lungc ’chamc puni."
          ]
        }
      },
