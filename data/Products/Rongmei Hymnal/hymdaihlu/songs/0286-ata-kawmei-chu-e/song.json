        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ata kawmei chu e,",
            "Kaipouc, Nang khou guang khang;",
            "Kalvari tuang kunghmei zei _>6",
            "Ata sw ’thanlou khang.",
            "",
            "Guang the, Poubauhmei!",
            "’Taw Nang khou guang the!",
            "Ata khiu ’thanlou na ro,",
            "Kalvari tuang zei _>6.",
            "",
            "2 ’Suanna, ’phuamna guang khou,",
            "Nang _>6 pumtan tiilou;",
            "’Phuammei guay Nang _>6 khiu ’thanlou,",
            "’Thanmei ai sw mak saanv.",
            "",
            "3 Jisu ata kaw e:",
            "Lwm ’thuih khang, zian ’thuih khang,",
            "Machunh khang, ning khang, chuzaengh khang;",
            "Dih khou lev kauh thangc khang.",
            "",
            "4 Mi hei Jisu _>6 e:",
            "Muigaymei tiiloumei;",
            "Paapc _>6 zyn bampui mei lung khou",
            "Zauzian tii bammei hei."
          ]
        }
      },
