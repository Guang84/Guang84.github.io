        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang kai khou >|3 ’niw tatpat the,",
            "Ki Nang ta ’niw ganclou mak ge;",
            "Ramh khat na >|3 sihni ’niw ta,",
            "Pou, Nang khou >|3 tii’tamv ngam mak.",
            "",
            "2 ’Niw Nang lauziu, Nang kai khou bam,",
            "Nang ta ’niw how kariupui bamv;",
            "’Niw kabamv baic baicna tat khou,",
            "Nang lev kadam laa ’chamc tat re.",
            "",
            "3 Kailangv kauhmei 3>| ra mak ge,",
            "’Taw thu aching ching kingc pat the;",
            "Dih kathuic khou ziap nunc kaduai,",
            "Nang phay Nang baanc zam ta zauc e.",
            "",
            "4 ’Niw kai biak ’zwan tat dat pwkhou,",
            "’Niw lung hei mai kumc kagut re,",
            "Zingc key pwkhou Emma-u thangc kumc",
            "’Niw chaeng khou Nang phay khwan chu e."
          ]
        }
      },
