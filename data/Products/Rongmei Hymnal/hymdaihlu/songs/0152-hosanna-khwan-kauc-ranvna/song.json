        "content": {
          "format": "source-lines",
          "lines": [
            "1 Hosanna, khwan kauc ranvna,",
            "Alauc nunc !}2 suan e;",
            "Ravkai kainung kaizaengc guay",
            "Kaniw lu kagaengv e;",
            "Kaniw ta suaihiamloumei",
            "Jisu ta thuanckuna,",
            "Alauc nunc !}2 lu suan e,",
            "Kaniw lungsyng thangc !}2.",
            "",
            "2 Oliv Chyng thangc !}2 key the,",
            "Maansei kangdai chung khou,",
            "Rih ngam tadanvnuy sinna,",
            "Khwan kauc ranvna suan e;",
            "Baanch’ra lev meic guay Kaipouc,",
            "Niamhmei lwn khou guang the,",
            "’Khwan bammei alauc nunc ta",
            "Kamei ’patlou mak ge.",
            "",
            "3 “Kauh liangmei khou Hossana!”",
            "Reynungc lu ’niu suan e;",
            "Thuakloumeipu Khrista khang,",
            "Kauh lev dih Kaipouc khang,",
            "’Niu lung ringhting lev khwan !}2",
            "Tingsaeng Kata thuanc diu,",
            "Kahu khou ’niu zaeng ’thaekc ni,",
            "Tingsaeng neihlaa bam ni."
          ]
        }
      }
