        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Thukmei Ravguangc ramzian,",
            "saa ’da lakmei ramzian e;",
            "Kanganv maekmei Ravguangc",
            "ramzian Jisu khou nai e.",
            "",
            "Thay the lwm the, ai laalou the;",
            "Ch’rynmei, ch’ryn liangmei lat hei,",
            "Ravguangc ramzian khou ai lungc the;",
            "Kazei !}2 khiu ’thanlou the.",
            "",
            "2 Ravguangc latkaeng kahak !}2 mi hei ndauhlou the;",
            "Hyloumei Ravguangc lat !}2 mi hei ndauhlou the.",
            "",
            "3 Lwmmei paan !}2 laa tow the,",
            "Ravguangc !}2 zianloumei;",
            "Kalvari khou lwmlou the, apaap guay kuaklou the.",
            "",
            "4 ’Thanmei Bumaengc lungclou the, kauh tuang sakhi swna;",
            "’Thukmei chamv dinclou the,",
            "Ravguangc ramzian Jisu khou."
          ]
        }
      },
