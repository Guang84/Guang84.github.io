        "content": {
          "format": "source-lines",
          "lines": [
            "1 Meic guay thuanc e, Emmanuel!",
            "Aniw pyrun lou keyna,",
            "Lungh kathuic >|3 Nang nyng piu diu,",
            "Khwan guay >|3 Nang ta thuanc diu,",
            "Guloumeipu Guangh ta thuancna",
            "Tingkauh nra guay 3>| dow e,",
            "Hymdaih lu khwan kachyn lik e;",
            "Thuanc e! thuanc e! (2) Emmanuel!",
            "",
            "Thuanc! Emmanuel! mmanuel! (2)",
            "Hymdaih lev champouhmei lev daihmei,",
            "Ningting lev ngammei Nang khang sw diu;",
            "’Taw nic taek makna!",
            "Thuanc! .. Emmanuel! Emmanuel! (2)",
            "Guangh guay Guangc, Kaipouc guay Pouc,",
            "Thuanc e! Emmanuel!",
            "",
            "2 Meic guay thuanc e! Emmanuel!",
            "Thuakpatloumei guay >|3 bwan,",
            "Kandih guangc guay nic kauc bam e,",
            "Nang khou pyrun runlou khang;",
            "Thuakloumei nunc heizumei >|3",
            "Nang guangc bamvpaeng khou ing huamcna,",
            "’Maan zat lakmei lu suan bam e,",
            "Thuanc e! thuanc e! (2) Emmanuel!",
            "",
            "3 Meic guay thuanc e! Emmanuel!",
            "Ringcthaumei Guloumeipu!",
            "Zauczihmei ta ngammei Nang e,",
            "Nganv makna ngammeipu e;",
            "Theihmei paap t’ruaih >|3 zyn mak khe,",
            "Seitaan ngamv ta ngamlou kan the,",
            "Nganv makna Nang zanc hymdaic diu,",
            "Thuanc e! thuanc e! (2) Emmanuel!"
          ]
        }
      },
