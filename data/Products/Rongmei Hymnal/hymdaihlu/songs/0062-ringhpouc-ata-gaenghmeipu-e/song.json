        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ringhpouc, ata Gaenghmeipu e,",
            "Akhang gatmei maek khe;",
            "Phuairyaupung khou ’zi keylou e,",
            "Chunghmei dui khou zaylou.",
            "",
            "2 Abumaengc ta chaengh tiiringclou,",
            "Kazanc zaeng khang ata",
            "Ntwnpui chaeng khou zaylou e,",
            "Ata tiitatlou e.",
            "",
            "3 Theihmei ’zaengc lym khou tat sihni",
            "Ai pingmei nai lak khe;",
            "Nang builwang !}2 ata gaeklou,",
            "Ata tiineihlaalou.",
            "",
            "4 Akhang taektw Nang chamdaanvlou,",
            "Howmumei nunc hu khou;",
            "Apy khou Nang thauh teylou e,",
            "Abuangc padik lyam the.",
            "",
            "5 Gaymei, zianmei !}2 lamluai ni,",
            "Aringcting nai bam saanv;",
            "Ravguangc kai khou tingsaengzaengna",
            "Ai lungc bam puni the."
          ]
        }
      },
