        "content": {
          "format": "source-lines",
          "lines": [
            "1 Hymdaih, thuanh lev champouhmei,",
            "Thuakloumeipu Guangc khang,",
            "Alauna guay mwang khou {:1",
            "Hosanna kauc bam e:",
            "Israel mei Guangc Nang e,",
            "David Nac ’Pouh Nang e,",
            "Poubauhmei zanc khou guangmei,",
            "He Guangh, guigaymei pu.",
            "",
            "2 Baanch’ra kangdai {:1 kauh thangc",
            "Nang ta thuancna bam e;",
            "Maansei lev mbaanv guay {:1",
            "Kaniw lu suan bam e;",
            "Meic guay tadanvnuy sinna,",
            "Nang hu khou tat khwan e;",
            "’Niw thuanh huayney lev ’niw lu",
            "Nang hu khou katgut re.",
            "",
            "3 Nang theic nipui nit hu khou",
            "Thuanhpui lu suan khwan e;",
            "’Niw nic thuanhpui lu suan e,",
            "Kauhliangmeipu Nang khang;",
            "Kaniw thuanh nang laalou kumc",
            "’Niw thuanh nic laalou o;",
            "’Niw ruc khou neihlaalou o,",
            "Gaymei, zianthaymei Guangc."
          ]
        }
      },
