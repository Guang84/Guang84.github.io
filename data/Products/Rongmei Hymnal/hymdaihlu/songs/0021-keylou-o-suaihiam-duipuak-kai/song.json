          "format": "source-lines",
          "lines": [
            "1 Keylou o, suaihiam duipuakkai,",
            "Nang zauzian tiisuanlou o;",
            "Luangc taek makmei Nang zauzian khang",
            "Khwan ranvna thuanc bam khang nai;",
            "Lunghsiipui lu 7}$ ’chamlou o,",
            "Tingkauh mei suanpui lu 7}$;",
            "Thuanc e, ai zaucna bammei chyng,",
            "Thuakloumei zauzian chyng ta.",
            "",
            "2 Ebenezer ai suamc thau the,",
            "Hei nganv Nang paan ai tangc the;",
            "Nang ramgai ta ai lwmgay e,",
            "Gayna kai tiiguang tangh khang;",
            "Ravguangc khou #^7 maeng ’maan bam khou,",
            "Jisu #^7 ata phu guang,",
            "Theic nuhmei khou #^7 kanlou khang",
            "Kunghmei Kazei keylou the.",
            "",
            "3 Ai hei zauzian pow phunghmei e,",
            "Tingmik ’thuic phungcna bam e!",
            "Nang ramgai #^7 p’reiriang kumcna",
            "Alungning ta bangclou o;",
            "Tat pat dat khang ning raph rap be",
            "Zianmei Racguangc pamv khou #^7;",
            "Alungning ta hei bangclou o,",
            "Tingkauh khang #^7 bangclou o."
          ]
        }
