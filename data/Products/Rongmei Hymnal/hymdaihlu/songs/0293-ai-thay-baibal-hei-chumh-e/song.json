        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai thay, Baibal hei Ravguangc Lat re,",
            "Kaguangc Kathanc Latdyng hei,",
            "Ravguangc Kakhou #^5 patmei Lat re,",
            "Ai thay, Baibal hei ’chumh e.",
            "",
            "Ai thay, .. ai thay,",
            "Ai thay, Baibal hei ’chum e,",
            "Ravguangc tuang Lat re,",
            "Kalat pwm hei,",
            "Ai thay Baibal hei ’chumh e.",
            "",
            "2 Ai thay, Khrista tuang p’ry hei ’chumh e,",
            "Liuchang khou #^5 puanhmei 5#^,",
            "Puanhmei, theihmei lev ringcthaumei 5#^,",
            "Dih khou key dat nimei 5#^.",
            "",
            "3 Ai thay Baibal Lat pwm hei ’chumh e,",
            "Akhou chuzaenghmei tii e;",
            "Hei #^5 ata tiineihlaalou e,",
            "Paapc ta ngam khang swlou e.",
            "",
            "4 Meic nunc Baibal Lat lwm mak sihni,",
            "Kathukh 5#^ dinclou khang e;",
            "’Chumhmei hei dinhpui sik gay ku e,",
            "Ai thay, Baibal hei ’chumh e."
          ]
        }
