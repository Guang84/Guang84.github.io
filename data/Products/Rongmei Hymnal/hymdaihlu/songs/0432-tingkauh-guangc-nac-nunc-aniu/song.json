        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tingkauh Guangc nac nunc aniu",
            "Kai ’zwan bam khou lu suan kho;",
            "Guloumei pu ta thuanc kho:",
            "Ch’rynmei taanv lev lwnlung khang.",
            "",
            "’Niu kai zwan .. Ravguangc bamv thangc,",
            "Pu-pou nunc .. tatpui chaeng e,",
            "Kaniw neih .. laana bam e;",
            "Aniu how nuangc puni the.",
            "",
            "2 Phaengc zauclo, gaanhmei nac thiu,",
            "Zion kaidai kiu how the,",
            "Khou 8^& aniu lungc puni,",
            "’Niu Kaipouc ta how puni.",
            "",
            "3 Ping ri tho, baucna ding tho,",
            "Ramvrei daeng khou tat bam khou!",
            "“Rouh makna tat tho,” twna",
            "Ravguangc Nac Jisu saa e.",
            "",
            "4 Kaipouc Nang lat piu ni the,",
            "Dih puat guay ganclou ni the,",
            "Nang ta na ’niw zauc ni the,",
            "Nang thei ’niw lay tat ni the."
          ]
        }
      },
