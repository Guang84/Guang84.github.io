          "format": "source-lines",
          "lines": [
            "1 Zauc lo, Lauziu Gaenghmei pu 6$%",
            "Mangui zawpaanv phungc e;",
            "Alauc nunc ta kaw guang lana",
            "Kaniw ta pamclou e.",
            "",
            "2 “Kaniw ta Akhou tiiguang o,",
            "Kaniw ta khaamlou rio,",
            "Hei kumhmei alauc nunc khang $%6",
            "Kaipouc lungc guang tuang e.”",
            "",
            "3 Kaniw ta Nang khou phungc guang e,",
            "Neihlaana katlou e;",
            "’Niw hei Nang tuang swmei kumcna",
            "’Niw nac nunc nic sw diu!"
          ]
        }
      },
