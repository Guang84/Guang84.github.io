        "content": {
          "format": "source-lines",
          "lines": [
            "1. Niu thuankho Raguang tuang chrinmei kajaujian khang,",
            "Tak makna gaklou bam puijang khang;",
            "Agau rim kum niu thuanmei khuanni ku kandiu;",
            "Kalum khang guang kaduai bam khouhei.",
            "",
            "Chorus:",
            "Thuan dikho kalum kho,",
            "Katuang tan guuai jang khang;",
            "Karamgai karam gaklu din kho,",
            "Agau rim kum niu thuanmei khuanni ku kandiu,",
            "Kalum khang guang kaduai bam khou hei.",
            "",
            "2. Niu thuan kho kajaujian tuang chrinmeiKaipat tei,",
            "Kamei ({0 niu khou lian loumei khang;",
            "Jisu le madiatna kadam lacham pukhou,",
            "Kabampang dang niuta jai guangni.",
            "",
            "3. Huainei kho kasuaihiam tak maknaTilou khang,",
            "Niu changluan tigan lou bamdiu khang;",
            "Kamei ({0 aniuta titui lou pui pan({0,",
            "Niu bumang kaguangdih khou lungkhang."
          ]
        }
