        "content": {
          "format": "source-lines",
          "lines": [
            "1. Poubaumei ta ariu nimei nun 0({,",
            "Neilana gaina ariu khang;",
            "Kachak namdai khou guangtang khang 0({,",
            "Jaujian louna nduang lou datro.",
            "",
            "Chorus:",
            "He suaihiam lou o aniu guai ta,",
            "Munpuang gaimei 0({ ai ning tan mak;",
            "Nduanglou o nangbang nun guai ta,",
            "Nangriu 0({ tikei lou datro.",
            "",
            "2. Njianlou o nangbang nun aniu ta,",
            "Karim gaimei munpuang ruin a;",
            "Nang ram 0({ airui na ning tan mak ge,",
            "Nangriu 0({ neiriu khang suang gai e.",
            "",
            "3. Gan gaimei 0({ Jisu riu dai e,",
            "Aniu ruina nangta ning khang;",
            "Laujiu na guai le bam diu khang,",
            "Hosana tuna kao lou dat khang.",
            "",
            "4. Jerusalem than gaimei damloumei,",
            "Kalun gaimei Raguang rui na;",
            "Muang rui gumliamme nang lun gaimei,",
            "Nei rui patna ndao lou datro."
          ]
        }
      }
