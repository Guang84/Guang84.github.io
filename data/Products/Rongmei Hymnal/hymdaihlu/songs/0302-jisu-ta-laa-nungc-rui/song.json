        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kathanc raana di the akhang,",
            "Jisu ta laa nungc @{4;",
            "Daihmei zauzian ta ai how the,",
            "Zianthaymei Jisu kros khou.",
            "",
            "Lwmsii, pingmei guay maek khe,",
            "Zingbangc 4@< kalaanv guanh the;",
            "Tingkauh hei duh mak kumc the,",
            "Jisu ta laa nungc @{4.",
            "",
            "2 Zianpui zaeng @{4 ata phu guang,",
            "Jisu ta ariw the;",
            "Ringhbamv phungc key tingkauh thangc @{4,",
            "Kunghmei Guloumeipu @{4.",
            "",
            "3 Muangh @{4 ata tuklyam sihni,",
            "Guloumeipu nai de;",
            "How mak sihni tat ’chamc bam de,",
            "Kaganv ’thuic bam ’chamc bam de.",
            "",
            "4 Kabaanc ata zaylou bam e,",
            "Kata laalou nungc @{4;",
            "Guangh bamvpaeng khou ata zaylou,",
            "Khou4@< Kata ai how ni."
          ]
        }
