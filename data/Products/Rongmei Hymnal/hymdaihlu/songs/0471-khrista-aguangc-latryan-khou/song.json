        "content": {
          "format": "source-lines",
          "lines": [
            "1 Khrista aGuangc latryan khou hei ai ding e,",
            "Nganv tuang maekna Katathuanhmei khwan kauc diu;",
            "Kauh liangmei khou hymdaihmei ta ai suan ni,",
            "Ravguangc latryan khou hei ai ding e.",
            "",
            "Ding .. e, ding .. e,",
            "Guloumei pu aRavguangc latryan khou ding e,",
            "Ding .. e, ding .. e,",
            "Ravguangc latryan khou hei ai ding bam e.",
            "",
            "2 Suai makmei Racguangc latryan khou ai ding e,",
            "Lwmsiimei, pingmei pwanzingh akhangv pwkhou,",
            "Ringhmei Racguangc lat paan #^7 ai #^7 ngam ni,",
            "Ravguangc latryan khou hei ai ding e.",
            "",
            "3 Latryan khou ding khou #^7 ’taw mu ai thay the,",
            "Nthuih the, zei #^7 apaap khiu ’thanlou the,",
            "Khrista #^7 ata anyng tiiswlou the;",
            "Ravguangc latryan khou hei ai ding e.",
            "",
            "4 Kaipouc Khrista latryan khou hei ai ding e,",
            "Zianmei riang #^7 tingsaeng khang ata bangclou,",
            "Bumaengh ’Thanmei ngamv #^7 tingmik ’thuic ngamlou,",
            "Ravguangc latryan khou hei ai ding e."
          ]
        }
