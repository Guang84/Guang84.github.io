          "lines": [
            "1. Latjan tingmik naguang puthe (3),",
            "Kagan naguang puthe.",
            "",
            "Chorus:",
            "Kap puni khuaimei guai (3),",
            "Jisu latjan khou khuaimei guai.",
            "",
            "2. Kao bam sini guang nituang ram (3),",
            "Pap padik mei guai mu.",
            "",
            "3. Pap phungmei guai guagtang ngam mak (3),",
            "Tingkauh kandih khou kiu.",
            "",
            "4. Kauh kandih khou guang nimei guai (3),",
            "Kross phungmei na khang de.",
            "",
            "",
            "Favourite song: G. Khuandin"
          ]
        }
