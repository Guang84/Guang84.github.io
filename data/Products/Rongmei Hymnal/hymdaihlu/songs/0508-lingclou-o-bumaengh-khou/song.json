        "content": {
          "format": "source-lines",
          "lines": [
            "1 Lingclou o, Bumaengh khou neih khat khat swna;",
            "Zauzian phuling thw 6$% chaeng saanvsaengh lingc o;",
            "Lingclou o, Bumaengh khou",
            "Kaipouc khou lwmna;",
            "Aniu taanv taanc chuy kho swangaymei laa khang.",
            "",
            "Lingc o, neihriw gay khou,",
            "Neihkhyam key pw the,",
            "Lakmei lwn sw ri kho;",
            "Taanv taanc suak mak saanv.",
            "",
            "2 Lingclou o, Bumaengh khou, huayneyna tat ro;",
            "Lingclou kanmei thw 6$% kabwan thau nuangc ni,",
            "Lwmna lingc chuylou o, ting tiiriulou ni,",
            "Kachaekc phuling laupuk aniu how puni.",
            "",
            "3 Lingclou o, Bumaengh khou lwmmei ’thyam sihni;",
            "Lingclou o, suan puni, mikdui key puni;",
            "Lingc o, nyan nic zaic nic taanv hei suak mak saanv,",
            "Lautay guang pwkhou kiu neihlaa bam ni the."
          ]
        }
      },
