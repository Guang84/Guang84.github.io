    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Ai suan ni Thuakloumeipu lam",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ata Thuakloumei pu lam lev",
            "Ch’rynmei Kazauzian suan ni;",
            "Siimei kros khou Kamei khaengvlou,",
            "Syang khou )}3 tiiduaklou khang.",
            "",
            "Ai suan ni, Thuakloumei pu lam!",
            "Kazei )}3 .. ata liulou!",
            "Kros ruc khou akhuay guay kuaklou!",
            "Pow khangclou, nyng tiiswlou!",
            "",
            "2 ’Maan khwanmei ata gulou khang",
            "Nganv makmei Kazauzian )}3,",
            "Thuakloumei nsa tiiswloumei",
            "Ch’rynmei p’ry hei ai rac ni.",
            "",
            "3 Thuakloumei pu ta ai thuanc ni,",
            "Ngammei pumtan ai rac ni;",
            "Paapc lev theihmei, t’ruaih ngamv ruc khou,",
            "Rih ngammei p’ry ai rac ni.",
            "",
            "4 Thuakloumeipu lam ai suan ni,",
            "Tingkauh tuang zianmei suan ni;",
            "Theihmei khou )}3 tiiringclou the,",
            "Jisu lev lungc ’chamc bam khang."
          ]
        }
      },
