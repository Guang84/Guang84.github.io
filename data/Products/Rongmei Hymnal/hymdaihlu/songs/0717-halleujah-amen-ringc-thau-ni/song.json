      "rongmei": {
        "language": "rongmei",
        "title": "HALLEUJAH! AMEN RINGC THAU NI",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ringcthau datpui nungc lauthwan kiu,",
            "Ravguangc tiangka ’muan pwkhou,",
            "’Niu thau ni, ringcthau ni!",
            "’Thanmei nunc neihlaana guang ni;",
            "Mikdui keymei nai lak khe,",
            "’Niu thau ni, ringcthau ni!",
            "",
            "Hallelujah! Amen! Ringcthau ni!",
            "Ringcthau datpui nungc lauthwan kiu,",
            "T ’rou roukham laanc patpui nungc kiu,",
            "’Niu thau ni, ringcthau ni!",
            "",
            "2 Ringcthau datpui nungc lauthwan kiu,",
            "Aniu ariw dat puni;",
            "’Niu thau ni, ringcthau ni!",
            "Aniu puipu guay ta how ni,",
            "Zianmei guay ta how dat ni,",
            "’Niu thau ni, ringcthau ni!",
            "",
            "3 Ringcthau datpui nungc lauthwan kiu,",
            "Adih neihlaa puni cho;",
            "’Niu thau ni, ringcthau ni!",
            "Guloumeipu ta ai how ni,",
            "Akhang theicloumeipu ta,",
            "’Niu thau ni, ringcthau ni!",
            "",
            "4 Ringcthau datpui nungc lauthwan kiu,",
            "Tingpuk khou Kata ’riw ni,",
            "’Niu thau ni, ringcthau ni,",
            "Hymdaihmei khou phungckulou ni,",
            "Gaanhmei tingkauh kai khou 5^&,",
            "’Niu thau ni, ringcthau ni!"
          ]
        }
