          "format": "source-lines",
          "lines": [
            "1 Zinghmei nai dat lak khe,",
            "Jisu key khou,",
            "Zinghmei nai dat lak khe,",
            "Jisu key khou,",
            "Zinghmei nai dat lak khe,",
            "Jisu key khou,",
            "Kamei nunc laa khang key khou.",
            "",
            "Kamei nunc laa khang key khou,",
            "Kamei nunc laa khang key khou,",
            "Zinghmei nai dat lak khe, Jisu key khou,",
            "Kamei nunc laa khang key khou.",
            "",
            "2 Ryanra ryanriu nai lak, Jisu key khou,",
            "Ryanra ryanriu nai lak, Jisu key khou,",
            "Neihlaa zaenggaymei lauthwan sw puni,",
            "Kamei nunc laa khang key khou.",
            "",
            "3 Theihmei kapmei nai lak,",
            "Jisu key khou,",
            "Theihmei kapmei nai lak,",
            "Jisu key khou,",
            "Dwan gayna lautay ni,",
            "Jisu key khou,",
            "Kamei nunc laa khang key khou.",
            "4 Ariwna neihlaa zaenggay lu suan ni,",
            "Kaipouc Jisu @{4 key datpui nungc kiu;",
            "Neihlaa zaenggay padikna ariw ni,",
            "Kamei nunc laa khang key khou."
          ]
