          "format": "source-lines",
          "lines": [
            "1 He Kaipouc, Nang amachunc swlou o,",
            "Nang hamhna akhang thu baihmei maek ge,",
            "Zingbangc kalaanv Nang gayliangmei chwn e;",
            "Zip key rak pat khou Nang bam ’duangh bam e.",
            "",
            "2 He Pou, Nang akhang ningting swlou o,",
            "Ai Nang daeng bam tuanc bam khang swlou o,",
            "Nang hei aPu e, ai hei Nang nac e,",
            "Nang akhou bam e, ai Nang khou bam e.",
            "",
            "3 Syanlanv ta ning mak, thwan ta kahaw mak,",
            "Nang hei Adam kik the, kaganv ’thuic khou;",
            "Nang na hei akhang gayliangmei kiu the;",
            "He tingkauh Guangc dai alanv kiu Nang e.",
            "",
            "4 He tingkauh neicmik, ai hei rih ngamna",
            "Tingkauh neihlaa khou 8}@ ku lungc tow ni,",
            "He alung tuang lungthw, kaganv kathuic",
            "Nang atuang machunc sw tanh tan bam o."
          ]
        }
