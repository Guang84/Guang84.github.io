            "1 Meic guayna Jisu zanc thuanc kho,",
            "Baanch’ra nic kalum diu, (2)",
            "Guangh pyrun 6_> laa thau lana,",
            "Runlou .. o;",
            "Runlou, runlou, runlou,",
            "Runlou .. o, Kaipouc khou.",
            "",
            "2 He Ravguangc tuang martair nuncle,",
            "Kaipouc khou runlou o, (2)",
            "Jessi kikta ta thuancku o,",
            "Runlou .. o,",
            "Runlou, runlou, runlou,",
            "Runlou .. o, Kaipouc khou.",
            "",
            "3 Kapahpatmei Israel mei zaat,",
            "Nang hei ’thyam khwan sihni, (2)",
            "Thuanc o, nang ta Gumeipu ta,",
            "Runlou .. o;",
            "Runlou, runlou, runlou,",
            "Runlou .. o, Kaipouc khou.",
            "",
            "4 Zaatc kaguay, khwang kaguayna _>6",
