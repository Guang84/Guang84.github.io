      "rongmei": {
        "language": "rongmei",
        "title": "Guang o, paapc rui zyn bampui mei",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guang o, paapc ^&8 zyn bampui mei,",
            "Pou khou zauzian nai e;",
            "Suai makna zaeng tii’thaekclou ni,",
            "Kalat khou lwmlou ’thei.",
            "",
            "Kakhou lwm o! Kakhou lwm o!",
            "’Taw Kakhou lwm tho!",
            "Kamei Nang ta gulou puni!",
            "’Taw gulou puni!",
            "",
            "2. Jisu kunghmei Kazei keylou,",
            "Daihmei suaihiam tii khang;",
            "’Taw hei Kazei khou 8^& lup tho,",
            "Gunh kumc tii’phwanlou khang.",
            "",
            "3. Jisu hei ’Chumhmei e, Chaeng e,",
            "’Thaekcpui bamv zaylou khang;",
            "Nyan la ri tho, Kakhou lwm tho,",
            "Suaihiam nang laa puni.",
            "",
            "4. Guang tho, ’thanmei pangc khou guang tho,",
            "Hymdaih khou tat di kho,",
            "Neihlaa taek makmei tingkauh khou,",
            "Aniu lungc ’chamc di kho."
          ]
        }
      },
