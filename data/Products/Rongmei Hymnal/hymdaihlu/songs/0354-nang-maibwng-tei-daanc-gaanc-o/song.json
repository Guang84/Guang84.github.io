          "format": "source-lines",
          "lines": [
            "1 Pu zauzian kachan gay bam e,",
            "Tingsaeng gaanhmei kai thangc }?2;",
            "’’Ki ’niu ta Kamei thouclou e,",
            "Duikhuangc maibungc zauc bamkhang.",
            "",
            "Nang maibungc 2}? daanc gaanc chuy o!",
            "Duiluat zinghmei gaanc kaan tio!",
            "Sansiimei rungh khou tuanghmei ta",
            "Nang mai riw }?2 kan nuh e.",
            "",
            "2 Paapc zingbangc hei zingc miw bam the,",
            "Ting-pwanzingh khwan ranv",
            "guang the;",
            "Lakmei nunc machunhna phaengc bam,",
            "Duikhuangc khou mai riw khang ta.",
            "",
            "3 Nang maibungc phwan giak ’than chuy tho,",
            "Ting-pwanzingh akhaengvmei nunc;",
            "Rungh ’thaekc bamv guang khang karamc bam,",
            "Zingh khou kaniw ’maan nuh e."
          ]
