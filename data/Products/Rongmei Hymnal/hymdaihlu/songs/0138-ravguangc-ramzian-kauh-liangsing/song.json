        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc ramzian kauh liangsingmei,",
            "Kauh neilaa dih khou key o;",
            "Aniw lung khou key bamlou o,",
            "Nang zauzian }?2 padikna,",
            "Jisu, Nang hei zianthaymei e,",
            "Nganv makmei ramzian Nang e;",
            "Phungc guang o, Nang tuang ringcbamv 2}?,",
            "T’riimei lung khou gutlou o.",
            "",
            "2 Mbunlou o, Nang Bumaengc 2}?,",
            "Lungh kabiu bammei guay khou,",
            "Nang khou }?2 aniw laa tow ni,",
            "Nang zaengthaek aniw laa ni;",
            "Guang o, gulou khang Ngammeipu,",
            "Nang zauzian aniw laa ni;",
            "Keylou o, ’taw hei aniw khou,",
            "Tat patlou dat zat ri tho.",
            "",
            "3 Damcthanhmei taanv hei luailou tho,",
            "Aniw ’thanna lungc ngam khang,",
            "’Niw ringcbamv hei tii ’thuihlou tho,",
            "Nang }?2 sw ntiplou o,",
            "’Than ranvmei khou kalaiclou o,",
            "Kauh thangc ’niw bamv laa mak saanv,",
            "Nang hu khou pyrun lou keyna",
            "Zianna thuancku bam mak saanv."
          ]
        }
