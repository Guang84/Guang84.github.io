        "content": {
          "format": "source-lines",
          "lines": [
            "1 Alung tanhmei ’taw thu bowlou the,",
            "Ai Nang khang na sw kan ni the;",
            "Ai huaymei ravsuai kiu mi hei the:",
            "“Pou, akhou Nang ningmei sw diu.”",
            "",
            "Ravguangc chwnmei @<4 pamc ’tiplou,",
            "Ai hei Nang khou manclou",
            "mak saanv;",
            "Ravguangc chwnmei @<4 pamc ’tiplou,",
            "Ai hei Nang khou manclou mak saanv.",
            "",
            "2 Paapc khou lak the, aphay tat chungc the,",
            "Zinghmei chaeng hei sii khith khit the;",
            "’Ki gaanhmei riw achaeng khou how the,",
            "Akhang bw, neih, gaanchuangcNang e.",
            "",
            "3 Nang chwnmei @<4, he Guloumei pu,",
            "Ata pamclou, bam ’kuay bam e,",
            "Katuakcmei guay, nthaekc key kan the,",
            "Abumaengc phah khou @<4 duak the.",
            "4 Bangc binlou, tingsaengzaeng khang, Kaipouc,",
            "Aphay @<4 chaeng maanv dat mak khang;",
            "Thow @<4 ata tii’tamv dat ngam cho?",
            "Ravguangc ningmei 4^& achwn the."
          ]
        }
      },
