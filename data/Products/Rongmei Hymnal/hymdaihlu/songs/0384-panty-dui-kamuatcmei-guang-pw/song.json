        "content": {
          "format": "source-lines",
          "lines": [
            "1 Panty dui kamuatcmei pwanzingh guang pwkhou,",
            "Nang machunc guay ’maan ngamna diwsii pwkhou,",
            "Suaihiam sing phuc o, kazanc khatkhat swna,",
            "Kaipouc taanv guay khou 4^& nang khang ch’ryn puni!",
            "",
            "Suaihiam sing phuc o, khat khat swna,",
            "Suaihiam sing phuc o,",
            "Ravguangc taanv 4^&!",
            "Suaihiam sing phuc o, khat khat swna,",
            "Kaipouc taanv guay khou 4^& nang khang ch’ryn puni!",
            "",
            "2 Nang nritmei puat phungc tanh tan bam tucho?",
            "Kros 4^& phungh khang nrit pwng e ning tucho?",
            "Suaihiam sing phuc o, lwmsiimei ’maan puni,",
            "Tingmik nai bam saanv nang lu suan bam puni.",
            "",
            "3 Meic kai puat guay lev syanlanv nang how pwkhou,",
            "Saa ngam makmei lanv Khrista tii ni ning o;",
            "Suaihiam guay sing phuc o, syan @<4 liu ngam mak,",
            "Kauh thangc naimei nang swan lev tingkauh kai 4^&.",
            "",
            "4 Rih sw pwkhou nthyam nic, daic nic pingc rio,",
            "Lungh geih rio, Ravguangc bam e kabamv ’thuic khou;",
            "Suaihiam sing phuc o, baanch’ra guay thaylou ni,",
            "Nang tuang chaenglwan suakpui nganv ’khavlou puni."
          ]
        }
