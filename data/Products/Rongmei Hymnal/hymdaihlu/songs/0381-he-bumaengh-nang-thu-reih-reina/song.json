        "content": {
          "format": "source-lines",
          "lines": [
            "1 He abumaengc, nang thu reih reina bam o!",
            "Poubauhmei #^7 nang biak liangcna bam de,",
            "Nang rianra guay Ravguangc",
            "khou tiigutlou tio;",
            "Kalaih makmei lwm nuhmei Kamei e.",
            "Reih rei bam o, Ravguangc taanv swlou bam de,",
            "Sauh-raengh chaeng #^7 gaymei",
            "khou zaylou khang.",
            "",
            "2 He abumaengc, nang thu reih reina bam o!",
            "Ravguangc nang ta thei-hu zaylou bam de,",
            "Nang machunhmei, lwmgaymei 7}$ ’maan zat rio,",
            "’Taw tamzinghmei thei thangc neihlaakhang de.",
            "Reih rei bam o, pwanzingh,duiluat kaguay hei,",
            "Kaipouc khwan ta ’taw nic thayna bam de.",
            "",
            "3 He abumaengc, nang thu reih reina bam o!",
            "Pou lev tingsaeng lungc nimei ganv ’naa the,",
            "Pian makmei lev lungh ryanramei nai lak khe,",
            "Ryanramei hei ’mucna neihlaa puni.",
            "Reih rei bam o, mikdui keymei nganv pwkhou,",
            "Chwn-gay neihlaana thei thangc ow riw ni."
          ]
        }
