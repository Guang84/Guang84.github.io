        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Thiam-chanhmei ganv khou ’niu kumna ning e:",
            "’Bui zaeng akhou thu kum bam tu cho,",
            "Arupmei nunc thu khuay nai bam sihni,",
            "Ryanramei khat sic ’riw zat mak ki.",
            "",
            "Asaanh mak khou ’niu kabah thay puni,",
            "Asaanh mak khou ’niu thay nuangc puni,",
            "Neihlaa o, chana gaanhmei biak zauc o,",
            "Thei thangc kiu ’niu thay ’thannuangc puni.",
            "",
            "2 ’Niu zianmei theic ’tamv khou ’niu kaikhunc khou",
            "Chwnsw diwsiimei padik pwkhou,",
            "Thanv e, ’bui zaeng mi ’niu khou pat tu cho,",
            "Meic baihmei ta thu kahi makna?",
            "",
            "3 Chaengkhuat siimei tat tow khou ’niu thanv e,",
            "’Bui zaeng chaengnganv ’niu kaphat bam cho,",
            "Meic baihmei nunc thu amanvna bam khou,",
            "’Maanmei khang ’niu thu kap bam tu cho?",
            "",
            "4 Asaanh mak khou ’niu",
            "Guloumei pu lev",
            "Tingpuk paengc thangc kai khou lungc puni,",
            "Tat rey kanmei ta khou kiu sow riw ni,",
            "Khou kiu ramh guayna thay ’than puni."
          ]
        }
      }
