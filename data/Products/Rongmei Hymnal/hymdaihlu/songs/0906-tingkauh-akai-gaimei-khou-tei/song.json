        "content": {
          "format": "source-lines",
          "lines": [
            "1. Tingkauh akai gaimei khou tei,",
            "Theimei rianra lung geimei mak;",
            "Kabam neimik khang suang gan e,",
            "Hei ram gai tei akai suni.",
            "",
            "Chorus:",
            "Khou tei tatni (2),",
            "Thei makpui ram gaimei khoutei;",
            "Thei makpui ram khou tei tatni,",
            "Khou tei tingsangjang ai lungni.",
            "",
            "2. Tingkauh akai gaimei khou tei,",
            "Khou tei apu Raguang lung e;",
            "Jangsimei makpui ram tingkauh,",
            "Kandih hei patlou na tatni.",
            "",
            "3. Mei nun phu e lunggai khang tei,",
            "Man dat nimei kandih khou hei;",
            "Poubaumei guang bampang hu khou,",
            "Tingsang hei ram khou ai lungni."
          ]
        }
      }
    },
