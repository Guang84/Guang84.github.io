        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kabamv ’thuic Jisu ’duanghna ai ping mak khe!",
            "Kamei @<4 ata zayloupui bamv ’thuic khou!",
            "Jisu bam makmei bamv khou neihlaa suang mak,",
            "Kabamv ’thuic Jisu ’duanghna ai ping mak khe!",
            "",
            "Kabamv ’thuic! kabamv thuic!",
            "Ai ping dat lak khe,",
            "Kabamv ’thuic Jisu ’duanghna",
            "ai ping maek khe!",
            "",
            "2 Jisu ’duanghloupui bamv ’thuic ara na hamh,",
            "Pam nunc @<4 ganclou sihni aPam ling e!",
            "Ryanra liangpui chaeng khou zaylou pw sihni,",
            "Jisu bampui bamv ’thuic thuanhmei padik ge.",
            "",
            "3 Kabamv ’thuic Jisu ’duanghna ai zip ngam e,",
            "Zinghmei lym @<4 adaeng chingc liam guang sihni!",
            "Zip ’chyang thau dat pwkhou maeng tat dat lak khe;",
            "Jisu ’duanghpui bamv guay lungh kwnpui kai e!"
          ]
        }
      },
