        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Thanpui neic zingbangc 6$%!",
            "Ramh kaguay rimh rim khou,",
            "Kapui lev Ngana daeng gaanc e,",
            "Mangui phunghmei ’thanpui Ngana 6$%,",
            "Zip bam e, reih reina,",
            "Kauh tuang ’chuzaenghmei khou.",
            "",
            "2 Rimh rimpui zingbangc 6$%!",
            "Lauziu gaengh mei chu e,",
            "Kauh baanch’ra nunc lu hei kumcna:",
            "“Hallelujah! Guangh ta thuanc kho!",
            "Jisu Khrista puanc the,",
            "Guloumeipu Jisu e”.",
            "",
            "3 ’Thanpui neic zingbangc 6$%!",
            "Ravguangc Nac zianmei riw,",
            "’Thanmei Nang zaw khou $%6 gaanc e,",
            "Thuakloumei zauzian lauthwan riw,",
            "Jisu Nang puanh nungc 6$%,",
            "Jisu Nang puanh nungc 6$%.",
            "",
            "4 Rimh rimpui zingbangc hei",
            "He gaanchuangc, gaanc key o;",
            "Kauh baanch’ra lev lu suan ’chamc kho,",
            "Hallelujah! aniu Guangc khang,",
            "Jisu Khrista puanc the,",
            "Guloumeipu Jisu e."
          ]
        }
