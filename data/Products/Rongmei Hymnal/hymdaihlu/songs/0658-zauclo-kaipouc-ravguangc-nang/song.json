        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zauzian Kaipouc Ravguangc, Nang ({0",
            "Kaikhunh ramgai, pamrai tiilou;",
            "Nang lauziu pang ta pamclou e,",
            "Kahunungc kumc kadanlou e.",
            "",
            "2 ’Niw khwan hei Nang chulou lak cho,",
            "Lungh khat swna thuanhmei khwan hei,",
            "Neihlaa zaenggaymei lu khwan ({0",
            "Thuancku kariu bammei khwan hei.",
            "",
            "3 Suaihiam lungc towmei guay zaeng khang,",
            "Ryanramei lungc riumei guay khang,",
            "Zangsii-zaenggay lungc riumei khang,",
            "Theihmei ’tamvmei guay khang thuanc e.",
            "",
            "4 Tat kanmei kalaanv neicriw khang,",
            "Mut changh kan nimei gaanh riw khang,",
            "Neihkhyam key kanmei panty khang,",
            "Kauhranvmei panty khang thuanc e.",
            "",
            "5 Pu Ravguangc,Nang zauzian paan ({0",
            "’Niw riangluaic guay ta pamclou o,",
            "Tingkauh thangc khang chamdaanvlou o,",
            "’Niw khou chuzaenghmei tiilou o."
          ]
        }
      },
