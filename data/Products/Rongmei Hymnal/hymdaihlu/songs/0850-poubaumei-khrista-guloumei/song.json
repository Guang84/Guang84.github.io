        "content": {
          "format": "source-lines",
          "lines": [
            "1. Poubaumei Khrista guloumei,",
            "Thuan ku dikho jat guai na #@8;",
            "Neila gaina bam kariu khang,",
            "Kajaujian #@8 nduang lou kandiu.",
            "",
            "Chorus:",
            "Thuan ku dikho kaguangta aniu,",
            "Kamei #@8 nduang lou khou #@8;",
            "Ntam kanmei jianmei guai le,",
            "Neilana aniu ariu dat the.",
            "",
            "2. Khrista jan khou jianmei guai le,",
            "Nangniu jau hou khang neila na;",
            "Ariu loupui welcome bam khou,",
            "Thuan pui lu khuan #@8 lung neila the.",
            "",
            "3. Hei tei kumma nkham pui nung,",
            "Tingkauh thanmei guai ni neila;",
            "Kandih mei le kauh thanmei guai,",
            "Kajan thuan pui lu suan cham puni."
          ]
        }
      }
    },
