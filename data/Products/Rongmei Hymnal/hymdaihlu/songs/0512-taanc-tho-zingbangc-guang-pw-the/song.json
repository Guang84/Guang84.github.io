        "content": {
          "format": "source-lines",
          "lines": [
            "1 Taanc tho, zingbangc guang pw the!",
            "Taanc tho, lauthwan ganv khou,",
            "Taanc tho, zikdui nai bam khou,",
            "Kaganv gay khou hei;",
            "Taanc tho, kalaanv ganv khou hei,",
            "Taanc tho, neih suc bam khou,",
            "Taanc tho, zingbangc guang pw the!",
            "Taanv taanc nuh lak khe.",
            "",
            "2 Taanc tho, zingbangc guang pw the!",
            "Taanc tho, kalaanv neic khou,",
            "Gaanh khou hei ranvna taanc tho,",
            "’Thaekc zaic puni the;",
            "Samc bammei ganv lungc khou hei",
            "Theidwan khang taanc laa tho,",
            "Taanc tho, zingbangc guang pw the!",
            "Taanv taanc nuh lak khe.",
            "",
            "3 Taanc tho, zingbangc guang pw the!",
            "Neihmik key changh mak khou,",
            "Gaanhriw hei amaan mak khou,",
            "Taanc tho, zingc guang the;",
            "Taanc tho, gaanhriw nai bam saanv,",
            "Tingsaeng khang zingh mak khou",
            "Taanc ranv tho, zingc key pw the,",
            "Taanv taanc nuh lak khe."
          ]
        }
      },
