        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu zei lev kachangcmei khou",
            "Hamhna baihmei khou ding mak ge,",
            "Baihmei ramgai khou ai lwm lak,",
            "Jisu zanc khou na ngangvlou ni.",
            "",
            "Taudaic Khrista khou ai ding e;",
            "Baihmei bamv guay mu syniang de,",
            "Pangv kan nimei syniang-pung de.",
            "",
            "2 Zinghmei #^5 Kazaw sungc liam khou,",
            "Ai zaeng ’thaekc ge Kazauzian khou,",
            "Pwanzingh tanhmei ’liupui ganv khou",
            "Arungc banghchei Kakhou bangclou.",
            "",
            "3 Kalatryan lev Kazei hei #^5",
            "’Khavlou e, dui daic guang pwkhou;",
            "Baanhou maekna dwangdangv pwkhou,",
            "Amachunc kiu Kamei na de.",
            "",
            "4 Kamei trampet ’muanna key khou,",
            "’Twnmei kheiliak 5#^ ai piuna,",
            "Kapaan #^5 khuay maekmei swna,",
            "Kaguangc bamvpaeng hu khou ding ni."
          ]
        }
      },
