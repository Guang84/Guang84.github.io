        "content": {
          "format": "source-lines",
          "lines": [
            "1 He aRavguangc, ati hei zauclou o,",
            "Chada zauclou o, achwn kaguay hei,",
            "Siimei lungchwn alung khou nai khwan ’thei",
            "Ata khiu ’thanlouna tiiduaklou o.",
            "",
            "2 Nang ta thuanc e, ata khiu ’thanlouna",
            "Alungsyng nganvna Nang sw ’thanlou o,",
            "Zakmei kheiliak mai $%6 kau ’thanlou o,",
            "Nang zanc hym tiidaic ngam khang swlou o.",
            "",
            "3 Pou, apanty Nang khang na swlou tho,",
            "Tiipadiklou o, Nang ramzian 6$% $%6,",
            "Atun, achwn, agaengh guay tiigut the,",
            "Ai Nang khou bowlou the, Nang laalou tho.",
            "",
            "4 He Bumaenghle, Nang $%6 tiilou lou e,",
            "Tiikaluanlou tho, akhou $%6 thauna,",
            "Ramh guay akhou tiilou khang ’rianhlou e,",
            "’Taw khou $%6 ata suaihiamlou di tho."
          ]
        }
      },
