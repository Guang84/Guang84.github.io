      "rongmei": {
        "language": "rongmei",
        "title": "’Niw neihpat thangc mei ’takmei",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Niw neihpat thangc mei ’tak mei nunc",
            "Kaipat phungcna kaniw ’zwan guang,",
            "Chyng, ’zaengc, duithuak, laupuk kaanna,",
            "Gaanchuangcna ta ’zwan guang.",
            "",
            "He ch’rynmei zingbangc gaanchuangcna,",
            "Guangh riw gaanhmei gaanchuangcna,",
            "Neihkey biak ’niw ta zaylouna,",
            "Gaanc chuymei khou zaylou o.",
            "",
            "2 Guangh khat puanc the Bethlehem khou,",
            "Kakhang kachaekc ai phungc guang e,",
            "Taek dat makna tingsaengzaengna,",
            "’Niw ruc khou guanghtu o.",
            "",
            "3 Namh gaymei mwndui phungc guang e,",
            "Mi hei Ravguangc khang kat tuang e,",
            "Meic guay thauna, thuancna, huayna,",
            "Kaipouc ta kalum o.",
            "",
            "4 ’Gaw hei thauh maruai nkhucmei,",
            "Zinghmei guang nimei ta lyan e;",
            "Ryanra, zei keyna, theiclouna,",
            "T’rou khou phuplou puni.",
            "",
            "5 Zauc lo, Kahym daicna thau the,",
            "Guangh lev Ravguangc lev ravkat puat,",
            "Hallelujah! Hallelujah!",
            "Kauh lev dih suan ’daw diu."
          ]
        }
      },
