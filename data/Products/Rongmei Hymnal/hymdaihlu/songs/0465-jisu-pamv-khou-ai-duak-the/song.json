        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu pamv khou ai duak the,",
            "Kangaengv khou ngangvlouna,",
            "Kazauzian ^&5 gungclouna",
            "Abumeangc zaeng ’thaekc ni,",
            "’King o, baanch’ra nunc khwan kiu",
            "Lu ^&5 akhou phungc guang,",
            "",
            "Hymdaihmei laupuk guay lev",
            "Gaanhmei duipui ruc khou.",
            "Jisu pamv khou ai duak the,",
            "Kangaengv khou ngangvlouna,",
            "Kazauzian ^&5 gungclouna",
            "Abumaengc zaeng ’thaekc ni.",
            "",
            "2 Jisu pamv khou ai duak the,",
            "Siimei khou ^&5 duak the,",
            "’Thiammei guay khou ^&5 duak the,",
            "Paapc ^&5 kabiu lak khe;",
            "Lungh ryanramei guay maek khe,",
            "Lwmsii, pingmei maek khe;",
            "’Chanvmei asaekc na nai e,",
            "Mikdui asaekc nai e.",
            "",
            "3 Jisu ai gutloupui bamv,",
            "Jisu akhang theiclou,",
            "Jisu tingsaeng Taudaic khou",
            "Taek makna lwmlou ni;",
            "Khou hei ’khaengv thayna ’khwan ni,",
            "Zingbangc hei luai mak saanv,",
            "Kachaekc duikhuangc thangc lauthwan",
            "Patmei ta how mak saanv."
          ]
        }
