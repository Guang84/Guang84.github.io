        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guloumeipu Jisu zei 1<:",
            "Akhang nic keylou dina cho?",
            "Ai kumhmei khang theiclou tu cho?",
            "Kata swluaimei pu akhang.",
            "Ch’rynmei ramzian! tukumh pwna,",
            "aRavguangc akhang theiclou cho?",
            "",
            "Ch’rynmei ramzian! tukumh pwna,",
            "ARavguangc akhang theihlou cho?",
            "",
            "2 KaPu guangcbamv ganclou ducna,",
            "Key pwmei nganv makmei ramzian!",
            "Hym guay luaklou, pumraeng keyna,",
            "Zianna Adam kik khang theiclou;",
            "Daihmei ch’rynmei ramzian dyng e,",
            "Ata phu towmei zauzian hei.",
            "",
            "3 Paapc tuang kangkai khou ai bam khou,",
            "Nang tuang ringh riw 1<: gaanc gutna,",
            "Kangriang taek the, alung ’thaekc the,",
            "Ai thauna Nang thei lay tat the,",
            "Kangriang taek the, alung ’thaekc the,",
            "Ai thauna Nang thei lay tat the.",
            "",
            "4 Tii’khuai pw khang ping dat mak khe,",
            "Ai Pou khang e, Pou akhang e;",
            "Ringhmeipu khou ai lungc bam e,",
            "Katuang ’twnmei phey ai piu the,",
            "Baucna ai Nang hu khou guang e,",
            "Khrista paan {:1 pyrun laa khang."
          ]
        }
