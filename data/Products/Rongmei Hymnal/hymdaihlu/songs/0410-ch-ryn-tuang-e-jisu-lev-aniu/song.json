      "rongmei": {
        "language": "rongmei",
        "title": "Ch’ryn tuang e Jisu lev aniu",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ch’ryn tuang e Jisu lev aniu",
            "Duangda swmei lwnlung hei!",
            "Aniu ryanra guay lev paapc guay",
            "Kamei @{4 phungclou khang e!",
            "Ramh guay phungc guang nuhpui ganv e,",
            "Ravguangc khou huayney khou hei;",
            "Ramh guay phungc guang makpui zaeng e,",
            "Nsa ryanra ’khaengvmei hei!",
            "",
            "2 ’Niu khou nchanvmei nai bu cho?",
            "’Thiammei, katuakcmei nai cho?",
            "’Niu lung tiitangkhyn zat ri kho;",
            "Hei khang Kaipouc khou ney kho,",
            "’Niu rianra phungh khang lwm nuhmei,",
            "Kakumhmei Duangda nai cho?",
            "Jisu aniu ramsuan thay e,",
            "Pou khou hei guay khang ney kho.",
            "",
            "3 ’Niu ’ritmei puat phungc bam tu cho?",
            "Tyndwangmei @{4 khamvnamv cho?",
            "Jisu hei duploupui bamv e,",
            "Pou khou heiguay khang ney kho;",
            "Nang rup nunc @{4 ’patlou bu cho?",
            "Kaipouc khou hei khang ney kho,",
            "Kabaancpwam @{4 sungclou puni,",
            "Khou kiu nang ’baanv thay puni!"
          ]
        }
      },
