        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kida khang maekmei Jisu gunc",
            "Gaanc bammei Kahym daihmei hei,",
            "Ai saa tangc ngam khwan ’thei,",
            "Ai samc kuna kauh ’rac downa,",
            "Gabriel lev lu ’khyam ni tuang e;",
            "Kamei kauh lu suan khou. (2)",
            "",
            "2 Paapc lev Ravguangc lungpuam khou )}3",
            "Kanlou khang Kazei keyloumei,",
            "Ai suan bam ni tuang e;",
            "Karamgai ai thuanc ni tuang e,",
            "Abumaengc tingsaeng gaanc bam khang,",
            "Tingkauh pwan piuloumei. (2)",
            "",
            "3 Kakhou naimei Kakheiliak guay,",
            "Zianmei padikmei lwnlung ta,",
            "Ai thuanc bam ni tuang e;",
            "Ranv liang nuh gay liangmei khwan )}3",
            "Ai suan ni tuang e tingsaengzaeng",
            "Katikgunc ndauhna. (2)",
            "",
            "4 He mi tingmik kiu guang puni,",
            "Tingkauh tangcna aKaipouc zaw,",
            "Ai how nipui nungc kiu;",
            "Khou kiu Guloumeipu lev ai,",
            "Tingsaengzaeng neihlaana lungc ni,",
            "Zauzian paan rih ngamna. (2)"
          ]
        }
