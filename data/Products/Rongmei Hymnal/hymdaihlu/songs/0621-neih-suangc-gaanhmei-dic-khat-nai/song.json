        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neih suangc gaanhmei dic khat nai e,",
            "Katingpuk gaanc suang e;",
            "Zingbangc zinghmei nai dat mak khe,",
            "Gaanhmei 1<: Jisu e.",
            "",
            "Lungh ’zaenghna .. kros phungc ethei,",
            "Swan pyrun .. run puni,",
            "’Thanmei nunc .. lev lungc ’chamc ni,",
            "Taek makna gaanhpui dic khou.",
            "",
            "2 Rav-rih gaymei kandic nai e,",
            "Panty duipui paengc thangc;",
            "Khou 1<: pwanzingh guang dat mak khe,",
            "Aniu dilung sw ni.",
            "",
            "3 Khou 1<: chingkhiuhmei kai nai e,",
            "Gaymei kauh kai kiu e;",
            "Tangc rey kanmei zianmei nunc {:1,",
            "Khou1<: riulou puni.",
            "",
            "4 Kandih ta hei ganclou ni the,",
            "Kim keymei dih ta hei;",
            "Kauhmei guay lev lungc ’chamc nii the,",
            "Khou1<: neihlaa kim mak."
          ]
        }
