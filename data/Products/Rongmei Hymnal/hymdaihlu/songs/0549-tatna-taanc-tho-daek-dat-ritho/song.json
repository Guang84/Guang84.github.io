      "rongmei": {
        "language": "rongmei",
        "title": "Tatna taanc tho , daek dat ritho",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tatna taanc tho, daek dat ritho,",
            "Neihlaana Pu {:1 chwnmei khou;",
            "Kaipouc tatpui chaenglwan khou hei",
            "Kabangc nunc nic lay tat lak cho?",
            "",
            "2 Tatna taanc tho, nsa hamh the,",
            "Tingkauh thangc nang dwan gay khang e;",
            "Meic {:1 thaylou, thuanclou mak diu,",
            "Kaipouc {:1 thuanckulou bam de.",
            "",
            "3 Tatna taanc tho, gaanc bam khou hei,",
            "Kandih zinghmei ganv guang pw the;",
            "Mazat la tho, du daih ritho,",
            "Zauc gayna bumaengh khuam tat tho.",
            "",
            "4 Liat lak ritho, huayney ranv tho,",
            "Ramh thayna ’maanmei ta khuam tho;",
            "Tat pat tho, kandih chaeng dai khou,",
            "’Maanmei ta kabai guang geic tho."
          ]
        }
      },
