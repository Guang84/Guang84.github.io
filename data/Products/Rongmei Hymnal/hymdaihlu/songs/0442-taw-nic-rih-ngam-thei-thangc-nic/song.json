            "1 ’Taw nic rihngam, thei thangc nic ngam khang,",
            "Guangh 0({ kaamc thau the, ngamv khou,",
            "Biangpiumei rihmei kangdai ’duanghna",
            "Gut tho, adowpui bamv khou;",
            "Zauc lo, baucna kaniw gut the,",
            "Ding rian lana, chamdaanvna,",
            "Kaniw Kaipouc zanc 0({ saancna;",
            "Chu lo, ‘Hozam’ kauhmei kiu.",
            "",
            "“Tanc rap tina ngam tuang hamh e,",
            "Mazatmei ({0 nic ngam mak,",
            "Lwm nuhmei lev biangpiumei ({0,",
            "Zauzian paan rih ngam khang de.”",
            "",
            "2 ’Taw nic rihngam, thei thangc nic ngam khang,",
            "Thow cho mi ch’rynmei Guangc hei?",
            "Bui thangc ({0 guang cho,",
            "Karicmei nunc,",
            "Kata thuanc bammei nunc hei?",
            "Kamei Thuakmei pu, Kaipouc e,",
            "Gumei pu, Guangh, Ravguangc e,",
            "Kaniw hei gaanchuangc kumc tingsaeng",
            "Guanghdic khou gaanc nimei e.",
            "",
            "3 ’Taw nic rihngam, thei thangc nic ngam khang.",
            "He Jisu, Nang Kaipouc e;",
            "Guangh bamvpaeng guay lev ngamv guay ’maan ni,",
            "Guangh pyrun guay taek key ni;",
            "’Ki Nang ’duangh tatmei rihmei nunc",
            "Katwan nganv dingmei nunc 0({",
            "Nang kai khou zaeng ’thaekc suang bam ni,",
            "Kaniw rih 0({ luai pwkhou."
          ]
