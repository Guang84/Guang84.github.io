        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Maanmei bumaengc ta phu o,",
            "Chaeng maanv tatmei guay ta;",
            "Sangli-’khaengvna zaylou tio,",
            "Nrummei chaeng khou 5^&;",
            "Kaniw daeng khou beic keyna,",
            "Kaniw khou saalou o:",
            "Pou ^&5 khwmkih khou kaw e,",
            "Meic guayna khang bamv nai.",
            "",
            "Meic .. guayna khang .. bamv nai,",
            "Dinc tat ro, ngayraeng luai the,",
            "Meic guayna khang bamv nai.",
            "",
            "2 Ryanramei nzaengc khou ^&5,",
            "Zinghmei zingbangc khou ^&5,",
            "Kachaekc neic riw gaanhmei khou,",
            "Chuzaenghmei gaanh riw khou,",
            "’Taw khuam guang o, Jisu khou,",
            "Dinc kaluaih luaihlou o,",
            "Dinclou tio, ngayraeng luai the:",
            "Meic guayna khang bamv nai.",
            "",
            "3 Tat ro zianmei lung phungcna,",
            "Tat ro Kaipouc zanc khou;",
            "Bumaengh ringcsuangmei chamv hei,",
            "Kandih thuic dinc tat ro;",
            "Katumc tho, neih riw nai khou,",
            "Zingc key nuangc puni the;",
            "Dinc tat ro, ngayraeng luai the:",
            "Meic guayna khang bamv nai."
          ]
        }
