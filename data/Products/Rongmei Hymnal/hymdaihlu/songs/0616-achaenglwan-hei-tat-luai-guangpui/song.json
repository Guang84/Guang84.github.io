        "content": {
          "format": "source-lines",
          "lines": [
            "1 Achaenglwan hei tat luai guangpui nungc kiu,",
            "Aringcting hei luaina zaengthaek pwkhou,",
            "“Kai khou gut tho,” Jisu saamei chu khou,",
            "Akhang neih thanh patmei sw ni!",
            "",
            "‘Thuanh kiu neih patmei, tingmik thanh patmei,",
            "Hymdaih lauthwan kiu akhang ’khwan bam e;",
            "‘Thuanh kiu neih patmei, tingmik thanh patmei,",
            "Tingsaeng Jisu lev lungc’chamhmei lauthwan!",
            "",
            "2 Guangh daihmei ta karamgai how nungc kiu,",
            "Thuakloumei guay lev thuanhpui lu suan khou,",
            "Atuang chingkhiu Kakhou phungc guang nungc kiu,",
            "Akhang neih thanh patmei sw ni.",
            "",
            "3 Panty luaina neihmik key kan pwkhou,",
            "Kauh rungc ’thaekcbamv khou",
            "arungc ’thaekc pwkhou,",
            "Guloumei pu Jisu ta how pwkhou,",
            "Akhang neih thanh patmei sw ni!"
          ]
        }
      }
    },
