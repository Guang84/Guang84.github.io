    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Jisu kumc niamhmei Pam baihmei",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu kumc niamhmei pam baihmei maek ge,",
            "Khat sic maek! khat sic maek!",
            "Bumaengh ravpuat tiigay ngammei maek ge;",
            "Khat sic maek! khat sic maek!",
            "",
            "",
            "Jisu ’niu ryanra lam guay thay e,",
            "Neihmaryn Kamei zaylou ni;",
            "Jisu kumcna niamhmei Duangda maek ge;",
            "Khat sic maek! khat sic maek!",
            "",
            "2 Jisu kumcna ’thanmei Duangda maek ge,",
            "Khat sic maek! khat sic maek!",
            "Jisu kumna zaenghmei Duangda maek ge;",
            "Khat sic maek! khat sic maek!",
            "",
            "3 ’Niu khou ?|7 Kamei duhmei ganv maek ge,",
            "Khat sic maek! khat sic maek!",
            "Tiineihlaa ngam lakmei zinghmei maek ge;",
            "Khat sic maek! khat sic maek!",
            "",
            "4 Kamei nunc ta ’patloumei gan nai cho?",
            "Khat sic maek! khat sic maek!",
            "Kamei laalou lakmei paapcmei nai cho?",
            "Khat sic maek! khat sic maek!",
            "",
            "5 Kaipouc tuang kaipat kumc tiime nai cho?",
            "Khat sic maek! khat sic maek!",
            "Kauh kai khou ’niu ta laalou lak ni cho?",
            "Khat sic maek! khat sic maek!"
          ]
        }
      },
