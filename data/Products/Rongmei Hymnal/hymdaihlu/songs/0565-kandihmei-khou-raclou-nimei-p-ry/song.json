        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kandihmei khou raclou niimei p’ry nai,",
            "’Chumhmei khou zaylou nimei p’ry,",
            "Nchumh liangmei zauzian p’ry e,",
            "Chuzaenghmei gaanhmei p’ry e. (2)",
            "",
            "Zingh khou )}3 lauthwan tiiguanhlou ni,",
            "Lauthwan khou )}3 kalaanv guanhlou,",
            "Khrista guangcdic, dih khou keylou ni,",
            "Nzianmei gaanhmei guangcdic.",
            "",
            "2 Kandihmei khou suanlou nimei lu nai,",
            "Pou ta thuanc bam niimei lu e;",
            "Mi lu )}3 siimei ta ngam ni,",
            "Mi )}3 suc-rih sw ’maan ni.(2)",
            "",
            "3 Kandihmei khang gaypui latchamv khat nai,",
            "Tingkauh thangc bammei Kapu )}3",
            "’Niu khang Kanac tiikeylouna,",
            "Zianmei lyanloumei chamv e. (2)",
            "",
            "4 Kandihmei khang lyanlou niimei pu nai,",
            "Ryanra ’khaengvloumei Jisu e,",
            "Kandih tuang saengcdaihmei nunc nic",
            "Ravguangc khou guang kan diu khang. (2)"
          ]
        }
