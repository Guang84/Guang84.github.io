    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Nang lung kaikhamv laanc tho",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang lung kaimun khou",
            "Guloumeipu ’khwan bam e;",
            "Kamei gut niina bam e, tiitat dat ri tho;",
            "Kamei ’khaengvsaengcna reynungc $%6 kaw bam di the;",
            "Nang lung kaikhamv laanc la tho.",
            "",
            "Nang lung kaikhamv laanc tho,",
            "Nang lung kaikhamv laanc tho,",
            "Jisu guang pwkhou paapc khou $%6 gulou ni,",
            "Nang lung kaikhamv laanc la tho.",
            "",
            "2 Ringhbamv tiilou khang Pu khou $%6 Kamei key e,",
            "Kazanc Jisu e, Thuakloumeipu e, Guangh e;",
            "Nang ta gulou khang Kamei taek makna huay' e,",
            "Nang lung kaikhamv laanc la tho.",
            "",
            "3 Kakhou naimei zianmei hei kanganv nai mak ge,",
            "Nang tuang panty, nang lung khou Kakhang bam nai cho?",
            "Nang ta tiiringh khang suaihiamlou khang ’khwan bam the;",
            "Nang lung kaikhamv laanc la tho.",
            "",
            "4 Nang ta neihlaamei kai khou Kamei zaylou ni,",
            "Kachaekc kaidai khou nang chaeng tat mutlou pwkhou,",
            "Zingbangc nai lak khe panty chaenglwan luai pwkhou,",
            "Nang lung kaikhamv laanc la tho."
          ]
        }
      },
