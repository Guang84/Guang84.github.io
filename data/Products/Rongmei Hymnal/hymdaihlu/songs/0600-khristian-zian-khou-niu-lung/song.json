        "title": "KHRISTIAN ZIAN KHOU ’NIU LUNG",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Khristian zian khou ’niu lungc",
            "Banghmei riang guigay diu;",
            "Chwn chamh, kadam laa",
            "’chamcmei hei",
            "Kauh thangc lwnlung kumc e.",
            "",
            "2 ’Niu Pu bamvpaeng hu khou,",
            "’Niu huayneymei bunlou;",
            "’Niu pingmei, tamhmei, machunhmei,",
            "Kadanmei khat na de.",
            "",
            "3 Ryanra akhaengv ’chamcmei,",
            "Puat ’ritmei phungc ’chamcmei,",
            "Khat khat khang mikdui keyloumei",
            "Zianmei khristian riak ge.",
            "",
            "4 Aniu ’tamvmei ganv khou",
            "Lungh ryanramei nai e,",
            "Kumsic ’niu lung alamv bam ni,",
            "Gayna ’riw dat mak saanv."
          ]
        }
      },
