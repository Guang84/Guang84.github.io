        "content": {
          "format": "source-lines",
          "lines": [
            "1 Swan kiu ’niu hu khou nai the,",
            "Kalat )}3 katiu bam the,",
            "Ravguangc mik phaengc key bam e, kauh thangc )}3!",
            "Kamei ’zianna kaw bam e,",
            "Paapc )}3 tiiping bam khou hei,",
            "Jisu khwan ’zaenghna kaw e anaa khou.",
            "",
            "Katumcna sowriw puni, katumcna kalum puni,",
            "Jisu Kahym daicna guanghtupui nungc kiu;",
            "Katumcna sowriw puni,",
            "katumcna kalum puni,",
            "Jisu Kahym daicna guanghtupui nungc kiu.",
            "",
            "2 Zayloupui bamv khou tat ni,",
            "Kicloupui bamv khou tu ni,",
            "Kauh thangc )}3 saa keymei",
            "Kalat piu ni!",
            "Gaanthauh nganv ’pat dat lak khe,",
            "’Niu rigwn guang tangc puni,",
            "Lwmmei thai nsaa lak ge, Jisu nai!",
            "",
            "3 ’Niu kai tingkauh gaanc bam e,",
            "Sw kaguakc tuang nai lak khe;",
            "’Niu Jisu nzian bam, kauh kai khou 3)^!",
            "’Niu Kakhang karamclou ni,",
            "Kazanc nganv makna thuanc ni,",
            "Nthukmei Kalat guay hei suai mak ge."
          ]
        }
