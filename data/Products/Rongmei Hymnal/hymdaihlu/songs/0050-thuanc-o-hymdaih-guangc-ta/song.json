        "content": {
          "format": "source-lines",
          "lines": [
            "1 Thuanc o, hymdaih Guangc ta,",
            "Kamei Ravguangc e!",
            "Ch’rynmei taanv 4@< aniu khou lyanlou zaeng @{4,",
            "Tingkauh ’zwan khou zaylou khang rianhlou zaeng @{4,",
            "Maibwang lev muanghtiangc",
            "zingc-gaanh zaylou zaeng @{4.",
            "",
            "Thuanc .. ku o, baanch’ra thiu,",
            "Ka .. chaekc ’rac downa,",
            "Thuanc .. o, he Kamei nunc,",
            "Ka .. zaw howmei nunc,",
            "Ka .. guanghdic daihmei khou",
            "’Taw .. nic thei thangc nic,",
            "Kataanv guay @{4 thuanc ni,",
            "Kataanv guay @{4 thuanc ni,",
            "Kataanv guay @{4 thuanc ni,",
            "Abumaengc, thuanc o!",
            "",
            "2 Thuanc o, meic kathuic khang thuakloumei tiimei,",
            "Thuanc o, ’niu ta tiigay ngammei duipuak khang,",
            "Thuanc o, zianna kadanlou bammei zaeng khang,",
            "Thuanc o, huayneymei tiilou bampu zaeng khang.",
            "",
            "3 Thuanc o, nchanvmei @{4 zianmei riang swna,",
            "Kauh thangc tuang khou ’niu ta bangcloumei zaeng khang,",
            "Rih ngammei ramlum, kim dat lakmei machunc,",
            "Zianmei guay Kakhou kariu nimei zaeng khang."
          ]
        }
