        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Bui cho, apaap khiu ngammei?",
            "Baihmei maek, Jisu zei na de!",
            "’Bui cho, tiigay ’thuih ngammei?",
            "Baihmei maek, Jisu zei na de!",
            "",
            "He, ’manv kunghmei zei e,",
            "Gunh kumc tii ’phwan ngammei!",
            "Baihmei duipuak maek ge,",
            "Baihmei maek, Jisu zei na de!",
            "",
            "2 Ata sw ’thanlou ngammei",
            "Baihmei maek, Jisu zei na de!",
            "Ata kuaklou khang ney khang",
            "Baihmei maek, Jisu zei na de!",
            "",
            "3 Baihmei maek, apaap tiikuak khang",
            "Baihmei maek, Jisu zei na de!",
            "Ataanv gaymei paan hamh e,",
            "Baihmei maek, Jisu zei na de!",
            "",
            "4 Mi hei amachunc di the,",
            "Baihmei maek, Jisu zei na de!",
            "Akhang ’twnmei chaklou khang",
            "Baihmei maek, Jisu zei na de."
          ]
        }
      },
