        "content": {
          "format": "source-lines",
          "lines": [
            "1 Lauphunhswan lu ’niw suan dat re,",
            "Tingsei 7}$ tat kan the,",
            "Neihriw lev ting phungc guanglou e,",
            "Kairiak ganv guangmei #^7;",
            "Lungsyng thangc #^7 ’niw neihlaa e,",
            "Tinglwm guang datmei khang.",
            "",
            "2 Reynungc swloumei latryan 7}$",
            "’Taw nganv phungc guang bam e;",
            "Phuling bang hei thau bam puni,",
            "Lau taanhmei nunc dam khang;",
            "Tingkwm gwan ’thuic kathai luan ni,",
            "Kaganv hei luai mak saanv.",
            "",
            "3 Pou ta thuanc e, lauphunhswan khang,",
            "Chaenghringhmei tiimei khang,",
            "Kachaekc ganv hei ’niw katlou e,",
            "Nang khang taanv sw bam khang,",
            "Paapc ngamv khou #^7 tiiduaklou o,",
            "Guloumeipu, Guanghle."
          ]
        }
      },
