        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tingsaeng Taudaic, Duppuibamv!",
            "Tiiduplou o, Nang lang khou!",
            "Nang zak khou #<8 luangc patmei,",
            "Zei lev dui #<8 tiigay o;",
            "Paapc tuang ramphum kaguay lev",
            "Paapc tuang ngamv kaguay khou #<8.",
            "",
            "2 Abaantan #<8 ngam mak ge,",
            "Nang latdanv piu nthuih khang;",
            "’Thaekc makna taanc bam sihni,",
            "Mikdui key taek mak sihni,",
            "Paapc guay tiikuak ngam mak ge,",
            "Nang na #<8 kuaklou khang de.",
            "",
            "3 Ai ramh khat sic phungc guang mak,",
            "Nang kros khou na ngangvlou the;",
            "Pwan piu khang pumtang guang e,",
            "Zianlou khang Nang ta zauc e,",
            "He Khrista, khiulou na ro,",
            "Hamh ethei ai theic ni the.",
            "",
            "4 Ai theih thiula laa bam khou,",
            "Theicna mik tanguih pwkhou,",
            "Ai thay makpui dic tangcna",
            "Latzan bamvpaeng how pwkhou,",
            "Tingsaeng Taudaic, Duppuibamv!",
            "Tiiduplou o, Nang lang khou!"
          ]
        }
      },
