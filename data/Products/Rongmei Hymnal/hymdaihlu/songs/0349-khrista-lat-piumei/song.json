        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neihkei nzaengc thangc )}3 latdyn lu khwan guang e,",
            "Latdyn kiu thu: latpiu o, Khrista lat piu o!",
            "Lu 3)^ kagaengv guang e, chyng guay )}3 lay suan e;",
            "Latpiumei lu, latpiumei, Khrista lat piumei lu.",
            "",
            "“Rih hei ngam gut tho!",
            "rih hei ngam gut tho!”",
            "Rihpy latdanv e, “ ’Daw tho!”",
            "Kalatdanv they gut kho,",
            "Kandih 3)^ laa ni the,",
            "Kalat piumei, n-guay,",
            "Khrista lat piumei paan )}3!",
            "",
            "2 King o, bauhmei nuncle, dih zinlikmei khwan hei,",
            "Kalat piu o, lat piu o, Khrista lat piu o!",
            "Thau tho, baucna taanc tho, dinc tho, Kalatdanv 3)^,",
            "Kalat piu o, latpiu o, he Khrista lat- piu o.",
            "",
            "3 Guang o, ’niw khou zauc o, ravsic guay hac ganc kho,",
            "Kalat piumei, latpiumei, latpiumei paan )}3;",
            "Seitaan chuangcphey bamv khou",
            "’niu trampet ’muan gut kho;",
            "Kalat piu o, latpiu o, he Khrista lat piu o.",
            "",
            "4 ’Niw chabwan pumtan hei Jisu khou katlou the,",
            "Kalat piuna, latpiuna, Khrista lat piuna;",
            "Gaychamv 3)^ dinc ’dauh ni, kandih pwm lik diu khang,",
            "Kalat piu o, latpiu o, he Khrista lat piu o."
          ]
        }
