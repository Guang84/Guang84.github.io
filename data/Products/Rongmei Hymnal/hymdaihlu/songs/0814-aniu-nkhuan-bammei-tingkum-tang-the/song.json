        "content": {
          "format": "source-lines",
          "lines": [
            "1. Aniu nkhuan bammei tingkum tang the,",
            "Neilana lusaun di kho;",
            "Poupei riak ning maknga,",
            "Aniu huthang jao kho.",
            "",
            "Chorus:",
            "Neilana thuankue nang kagan tingkumm gaimei,",
            "Mei guai lungning mun kumma tipuang lou o,",
            "Kandih mei riak ta ning dat mak khang.",
            "",
            "2. Chunsi jangsi tuang guai man kanmei hei,",
            "Tingkum kathan guang hou dat;",
            "Khang nang pan khou rui na,",
            "Thuan diu mei kapumma.",
            "",
            "3. Suaihiammei tingkum hei man kan sini,",
            "Jisu jaujian 1@: akhang;",
            "Jat kapumma guai khang,",
            "Tingkum than hou dat diu."
          ]
        }
      },
