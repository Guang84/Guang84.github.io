        "content": {
          "format": "source-lines",
          "lines": [
            "1 Mi hei lat changc cho, Jisu @<4",
            "Kros khou ryanra ’khaengvna ata liumei,",
            "Ai thay mak khou @<4 zian reymei?",
            "He, adih ’thukmei Pam cho, Kamei hei!",
            "",
            "He, mi hei ch’ryn tuang e!",
            "Ch’rynmei, ch’ryn liangmei tuang e!",
            "Heidi daihmei Kazauzian!",
            "He, mi hei ch’ryn dyng e!",
            "Ch’rynmei, ch’ryn liangmei tuang e!",
            "Akhou zianloumei guay hei!",
            "",
            "2 Ata phu towpui zaeng thuanc e,",
            "Gulouna Kadaeng khou tiibamlou e",
            "P’riuhna Kasuaihiam tiilou bam,",
            "Jisu hei akhang gay hay hay thau the.",
            "",
            "3 He, ata adih ’khwan kan tha!",
            "’Thukpui ganv 4^& akhou guang tangh mak saanv,",
            "Thuaklou ngammei Jisu ngamv khou,",
            "Ai bowlouna Kakhou gutlou mak saanv.",
            "",
            "4 Kaganv ’thuic Kamei phu bam e,",
            "Akhou Kazauzian tii padiklou khang,",
            "’Thanmei nunc lev kadam laa khang,",
            "Baihmei lwn khou ata kapuihlou khang."
          ]
        }
