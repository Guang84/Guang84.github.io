      "rongmei": {
        "language": "rongmei",
        "title": "Ata bam ’duanglou o zingc key",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ata bam ’duanghlou o, zingc key pw the,",
            "Zingc khith khit key the, Pou, bam ’duanghlou o;",
            "’Khavloumei maekna lungh ryanra bam khou,",
            "’Khavloumei maekmei ata ’duanghlou o.",
            "",
            "2 Panty tingmik katumcna dui guang the,",
            "Kandih neihlaa lev hymdaih guay ’maan the;",
            "Ramh guayna kalaicna kim key ngam the,",
            "He kalaih makmei pu, bam ’duanghlou o.",
            "",
            "3 Guangh guay Guangc kumc pingmei lwn phungh makna,",
            "Guang o, zauzian lev tiigaymei phungcna;",
            "Ryanra zaengsii bammei ta ’khavlou khang,",
            "Guang o, paapc mei nunc Pam bam ’duanghlou o.",
            "",
            "4 Nang bam ’chamcmei kaganv ’thuic kahaw e,",
            "Nang zauzian )}3 ’thiammei ngamv sw ’maan e;",
            "Nang kumhmei nai cho, ata zayloumei?",
            "Zingc nic gaanc nic ata bam ’duanghlou o.",
            "",
            "5 Nang lev bamna zauczihmei ta ping mak,",
            "Sunumei, mikdui keymei ta ping mak;",
            "Theihmei sat ’bui thangc, t’rou ngamv nic ’bui thangc?",
            "Ai )}3 ngam ni, Nang bam ’duanghlou ethei.",
            "",
            "6 Amik tanguih key khou bam ’duanghlou o,",
            "Zinghmei tiigaancna kauh chaeng dinclou o;",
            "Tingkauh lauthwan pat, kandih zinghmei ’maan,",
            "Theic nic ringc nic, Poubauhmei ’duanghlou o."
          ]
        }
      },
