    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "’King o ! banch’ra nunc lu kiu",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 King o! baanch’ra nunc lu kiu,",
            "“Guangh Ngasatna hym daic diu,”",
            "Dih khou chuzaenghmei nai diu,",
            "Ravguangc paapc mei zay k’riu the!",
            "Zaatc guayna neihlaa thau o,",
            "Lay suan o, rihngam lu khou;",
            "Baanch’ra nunc lev kauc daw o,",
            "“Khrista puanc Bethlehem khou,”",
            "King o! baanch’ra nunc lu kiu",
            "“Guangh Ngasatna hym daic diu!”",
            "",
            "2 Khrista ta kauh thangc bwan e,",
            "Khrista tingsaeng Kaipouc e,",
            "’Khwan saengc guangmeipu Kamei",
            "Liuchang khou >|3 lungc guang the;",
            "Maansei guanhna lungc guangmei,",
            "Ravguangc ta meic guay thuanc kho,",
            "Meic nunc lev bam ’chamc nimei",
            "Immanuel Jisu e!",
            "King o! baanch’ra nunc lu kiu",
            "“Guangh Ngasatna hym daic diu!”",
            "",
            "3 Thuanc o, Chuzaenghmei Guangh Nac!",
            "Thuanc o, ’Twnmei Neicmik ta!",
            "Gaanhmei lev ringhmei phung guang,",
            "Tiigaymei phungcna guang the,",
            "Rav-hym guay ganclou ducna,",
            "Maansei theic dat mak khang puanc,",
            "Puanc luan neimei tiilou khang,",
            "Kandih khou Khrista lungc guang;",
            "’King o! baanch’ra nunc lu kiu,",
            "“Guangh Ngasatna hym daic diu!”"
          ]
        }
      },
