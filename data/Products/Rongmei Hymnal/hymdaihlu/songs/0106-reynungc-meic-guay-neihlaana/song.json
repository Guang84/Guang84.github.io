        "content": {
          "format": "source-lines",
          "lines": [
            "1 Reynungc mei guay neihlaana",
            "Gaanchuangcna ta phaengc kan kumc,",
            "Zayloumei riw gaanhmei ta",
            "Neihlaana lay ’zwan kan kumc,",
            "He Poubauhmei, ’niw ta nic",
            "Nang pamv khou zay guanglou o.",
            "",
            "2 Neihlaamei phay kaamv kaamcna",
            "Kiruai kuak zy ta ’zwan kumc,",
            "Kauh lev dih Guangc Kahu khou",
            "Pun keyna kalum kan kumc,",
            "He Pou, ’niw nic neihlaana",
            "Zauzian bamvpaeng ta ’zwan diu.",
            "",
            "3 Kungc liangmei kaipat guay 6_>",
            "Nang hu khou katlou kumcna,",
            "’Niw nic Nang khang neihlaana",
            "Paapc _>6 sw ’phuammei maekna,",
            "Kungc liangmei kaipat kat diu,",
            "Khrista tingkauh Guangc Nang khang.",
            "",
            "4 Jisu, ’niw ta tingmik thuic",
            "’Rumpui chaeng khou zaylou o;",
            "Kandih panty luai pwkhou",
            "’Niw bumaengc ta zaylou o,",
            "Muangh _>6 Nang hym daihmei ta",
            "Nkamh dat makpui ramc khou."
          ]
        }
