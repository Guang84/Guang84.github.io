    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "He Poubauhmei, Nang taanv",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Poubauhmei, Nang taanv",
            "Tiikaluanlou dat ro!",
            "Meic nac kathuic khou saalou o!",
            "Nang mei guay chu diu o!",
            "",
            "Nang taanv kaluanlou o,",
            "Ney e, he Poubauhmei!",
            "He zauzian Kaipouc, keylou o!",
            "Ntaw suaihiamlou o!",
            "",
            "2 Nang taanv kaluanlou o!",
            "Nang taanv tiidaiclou o!",
            "Nang zauzian meic lung",
            "kathuic khou",
            "Maibwang kumc chuangc thau diu!",
            "",
            "3 Kaipouc, Nang Lat ruc khou",
            "Nang suaihiam tiilou o!",
            "’Thanmei, ’chumhmei Nang lat bah hei",
            "Chuna meic nunc lwm diu!",
            "",
            "4 Nang taanv kaluanlou o,",
            "Pentikos nungc kumcna!",
            "Hymdaihmei Kaipouc khang sw diu!",
            "Suaihiam ’niw khang sw diu!"
          ]
        }
      },
