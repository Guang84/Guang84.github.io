    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "’KHAVLOUMEI GUANG THE",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Rac tat ro, gaypui lat, meic",
            "howmei kathuic khou,",
            "Meic naipui bamv kathuic, lungh",
            "ryanramei guay khou;",
            "Khristian kathuic mwang #<8,",
            "",
            "ndauh o, neihlaa khwan;",
            "’Khavloumeipu guang the!",
            "",
            "’Khavloumeipu guang the,",
            "’Khavloumeipu guang the!",
            "Tingkauh Bumaengc ’Thanmei,",
            "Pu #<8 ’rianhloumei e;",
            "Rac tat ro, gaypui lat, mei",
            "howmei kathuic khou;",
            "’Khavloumeipu guang the!",
            "",
            "2 Zinghmei 8}@ tat kan the, lauthwan kiu pat pw the,",
            "Pingmei pwanzingh khwan 8}@,",
            "’taw thu ’thaekc key kan the,",
            "Kachaekc luangcbut twan khou,",
            "neihmik 8}@ pat pw the,",
            "’Khavloumeipu guang the!",
            "",
            "3 Guangh guay Guangc swkaeng",
            "khou, tiigaymei phungc guang e;",
            "Kangloumei bumaengc khang",
            "thuakloumei phungc guang e;",
            "Kangkai raengv guay khou #<8,",
            "rihngam lu kauc pat the,",
            "’Khavloumeipu guang the!",
            "",
            "4 Nganv makmei Rav zauzian!",
            "abaley ngamv na #<8,",
            "Akumh ai saa ngam ni, saa ’da",
            "lakmei zauzian!",
            "Kata lungc ’chamc nuh khang,",
            "Kalwn kumc gaanc nuh khang,",
            "’Khavloumei pu guang the!",
            "",
            "5 Ravguangc ta thuanhhpui khwan,",
            "tingpuk kagaengv twan diu,",
            "Tingkauh ’thanmei nunc lev dihmei",
            "suan adaw diu:",
            "Suan kim dat lakmei lu, Rav zauzian lu suan diu;",
            "’Khavloumeipu guang the!"
          ]
        }
      },
