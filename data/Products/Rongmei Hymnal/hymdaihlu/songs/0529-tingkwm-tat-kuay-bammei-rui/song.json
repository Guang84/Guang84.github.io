        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tingkwm tat ’kuay bammei )}3",
            "Suaihiam tingmik phungc guang e,",
            "Phwamling ruc khou Ravguangc )}3",
            "Souclou reypui tingmik ge,",
            "Alleluia!",
            "",
            "2 Baley kumhmei maibwang 3)^",
            "Meic kathuic khou keylou e;",
            "Baley hei meic guay chu khang;",
            "Maibwang hei zianmei nai khang,",
            "Alleluia!",
            "",
            "3 Ravguangc tuang ch’rynmei taanv 3)^,",
            "Ch’rynmei thiak khou lik kan the;",
            "Zaatc kathuic tuang pui lat khou",
            "Ch’rynmei taanv tiithay lik the,",
            "Alleluia!",
            "",
            "4 Pou, Bumaengh tuang padikmei",
            "Nang tuang Church khou bunlou o;",
            "Ch’rynmei nchinloumei lev",
            "Lat tuang pumtan tiilou o;",
            "Alleluia! Amen."
          ]
        }
      },
