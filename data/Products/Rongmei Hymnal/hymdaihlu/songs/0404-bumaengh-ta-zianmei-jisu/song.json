        "content": {
          "format": "source-lines",
          "lines": [
            "1 Bumaengh ta zianmei Jisu,",
            "Nang pamv khou tiibamlou o,",
            "Dui kamuatcmei ’naa guang khou,",
            "Pwanzingh ranvna bam khou hei;",
            "He Kaipouc, tiiduplou o,",
            "Panty pwanzingh luai mak saanv,",
            "Tingkauh nganvna gaeklou o,",
            "Abumaengc laa thaulou o!",
            "",
            "2 Baihmei duppui bamv maek ge,",
            "Abumaengc Nang khou ngangvlou,",
            "Araana ta ’patlou rio,",
            "Ata tiineihlaalou o,",
            "",
            "Aramlum Nang khou lou ngam,",
            "Nang ram ’khavlou ta huay e;",
            "Duppuibamv maekmei ata",
            "Nang swkaeng bangc khou lou o.",
            "",
            "3 He Khrista, Nang khou laatow,",
            "Akhang kage naimei guay;",
            "Bowmei, ’suanmei ta zay thau,",
            "’Naumei, miktiatmei tiigay,",
            "’Chumhmei, ’thanmei Nang zanc e,",
            "Ai hei thu ’than makmei e,",
            "Ai hei paapc padikmei e,",
            "Nang thu zauzian Kaipouc e.",
            "",
            "4 Nang khou zauzian padik nai,",
            "Apaap pwm gum binlou khang,",
            "Ringhphaengdui tiiluangc guangna",
            "Ata low nthanlou o;",
            "Ringhmei duipuakkai Nang e,",
            "Nsa na tiizangvlou o,",
            "Alung tii-chuangc thaulou o,",
            "Nganv mak khang tiithaulou o."
          ]
        }
      },
