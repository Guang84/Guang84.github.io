        "content": {
          "format": "source-lines",
          "lines": [
            "1 Hu thangc gut kho, khristian chabwan!",
            "Alauc nunc ta gulou kho;",
            "Jisu bamv khou nduangh guang kho;",
            "Katumcna chaeng hei dinc kho.",
            "",
            "Hu thangc gut kho, khristian chabwan!",
            "Nchumhpui biak thangc gut kho;",
            "Amaanmei ta zinghmei khou $%6",
            "Gaanc gaymei khou zaylou kho.",
            "",
            "2 Hu thangc gut kho, khristian chabwan!",
            "Tabui khang nyan bam ni cho?",
            "Ravguangc zauzian ntaamvlouna",
            "Siina amaan ngam kan the.",
            "",
            "3 Hu thangc gut kho, khristian chabwan!",
            "Ringhmei ’Tyan tu khang kaw kho;",
            "Lauziu Gaenghmeipu Jisu $%6",
            "Kaniw ta tiitulou diu.",
            "",
            "4 Hu thangc gut kho, khristian chabwan!",
            "Kaganv gay khou taanc di kho;",
            "Tingkauh nzwanpui chaenglwan khou",
            "Neihlaa lu suanna tat kho."
          ]
        }
      },
