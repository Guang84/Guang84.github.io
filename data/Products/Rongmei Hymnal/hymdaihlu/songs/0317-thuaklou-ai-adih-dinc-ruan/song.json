      "rongmei": {
        "language": "rongmei",
        "title": "Thuaklou, ai adih dinc ruan",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Thuaklou, ai adih dinc ruan nii cho!",
            "Lauziu Nac zei <~1 thuaklou the,",
            "Kanganv maekmei Kazauzian paan <~1",
            "Tingsaeng khang ai Kanac di the.",
            "",
            "Thuaklou, thuaklou!",
            "Lauziu Nac zei <~1 thuaklou the!",
            "Thuaklou, thuaklou!",
            "Tingsaeng khang ai Kanac di the.",
            "",
            "2 Thuaklou ai Kakhou neihlaa bam e,",
            "Aramneilaa saa ngam mak ge,",
            "Ai thay the, Kamei <~1 taek makna",
            "Ata lamluai bam puni the.",
            "",
            "3 Thuakloumeipu lam ai makumh e,",
            "Neihmaryn ai Kata ning e,",
            "Reih rei bam ngam lakna lu suan e,",
            "Karamzian hei alu kiu the.",
            "",
            "4 Ai zianmei Guangc ta ai how puni,",
            "Katuang chingkhiuhmei ta ai how ni,",
            "Aphay kaamv guay Kamei makavlou,",
            "Zingbangc chaeng nganv lu tiisuanlou."
          ]
        }
      },
