      "rongmei": {
        "language": "rongmei",
        "title": "Ringpui kan hei munpuang",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Ringpui kan hei munpuang kum e,",
            "Tingsanga man ngam puni;",
            "Jingbang amang man kanmei tei,",
            "Man kanmei tei kum tuang e.",
            "",
            "Chorus:",
            "He abumang tingkauh ku o,",
            "Kandih ta bui khang ning cho?",
            "Nang tingsang ramgai tei,",
            "Juano tingkauh thanmei ram khoutei.",
            "",
            "2. Theimei kandih tabui khang cho?",
            "Naomei le lung niammei;",
            "Neila pui tuang kapum nani,",
            "Munpuang tuaimei tei kum e.",
            "",
            "3. Njianmei champan tat reimei,",
            "Neilana guangtang kan the;",
            "Guang bampang khou dunga lusuan,",
            "Tingsang guang ta thuan ku kho.",
            "",
            "4. Kagun daimei gaichuimei tei,",
            "Neimik khang suang gangai e;",
            "Khou tei kagun daipui ram khou,",
            "Poubaumei Jisu hou ni.",
            "",
            "5. Kakhuan gaimei kapum nani,",
            "Thuan kuni guangtang pukhou;",
            "Akhou na kumma samthai ethei,",
            "Sam ni tingkauh ram khou tei."
          ]
        }
      },
