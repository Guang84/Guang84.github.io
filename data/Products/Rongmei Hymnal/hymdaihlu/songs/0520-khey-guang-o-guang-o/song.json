        "content": {
          "format": "source-lines",
          "lines": [
            "1 Luanghbut khou thingbang ding khou Ravkai khat nai,",
            "Kailuang khou gay liangmei bamv e;",
            "Alaucdou mi bamv 6_> suangc akhang",
            "Chingkhiuh ranvmei baihmei bamv maek ge.",
            "",
            "Khey, guang o, guang o,",
            "Guang o, ringhmei Racguangckai khou;",
            "Ravguangc ta kalum khang guang o,",
            "Paapc kuakloumei ta laa khang guang o,",
            "Katuang pumtan ta laa khang guang o.",
            "",
            "2 Khou6_> Jisu ramzian p’ry chutow the,",
            "Apaap lam khou lungh kabiu the,",
            "Kazei _>6 apaap guay khiu ’thanlou,",
            "Katuang ringcbamv kaipat ai laa the.",
            "",
            "3 Nchanvmei _>6 apanty zyn pwkhou,",
            "Luanghbut thangc Ravkai ai ’zwan e,",
            "Apuatrith Jisu _>6 laa ganclou,",
            "Atuang kros phungh khang ngamv tiilou the."
          ]
        }
      },
