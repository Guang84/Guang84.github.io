        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Taw zaengsw kanmei ’thanmei nunc zaeng khang,",
            "Kandihmei khou Nang sakhi swmei khang,",
            "Jisu, Nang zanc tingsaeng thuanhmei sw diu,",
            "Alleluia, Alleluia.",
            "",
            "2 Nang ^&5 kaniw Taudaic, Rihpan swlou,",
            "Pou, Nang ^&5 kaniw Ricpy swlou the;",
            "Zinghmei, pingmei, gaanhmei Nang tiiswlou,",
            "Alleluia, Alleluia.",
            "",
            "3 Nang ricmei nunc lwmnuhmei sw kan diu,",
            "’Thanmei nunc kumcna baucna ’dow diu,",
            "Ngammei pyrun kaniw laatow kan diu,",
            "Alleluia, Alleluia.",
            "",
            "4 Rih tanc pwkhou rih hei dow saengc pwkhou,",
            "Duh thangc trampet khwan ’nu khou tiichu o,",
            "Thouna nai dat, pumtan nai dat kan diu,",
            "Alleluia, Alleluia.",
            "",
            "5 Kachaekc tingzyn neihkey thangc gaanc pat the,",
            "Lwmnuhmei rihmei khang ’thaekcmei guang the,",
            "’Baanvthay puni, Paradais gay khou 5^&,",
            "Alleluia, Alleluia."
          ]
        }
