        "content": {
          "format": "source-lines",
          "lines": [
            "1 Pui swmei, kauh e, tingsaeng e,",
            "Ravguangc ’zianmei chwn khou nai;",
            "Tingsaengzaeng ’niw ta pamclou o,",
            "’Niw ta kaduaph liamlou o;",
            "Khaengvsaengc, ’zianthay, kuaklou thay e,",
            "’Niw chaengmaanv guang tisihni;",
            "’Zaenghna luh e, chaeng dinclou e,",
            "Zianna kai ’duangh guanglou e.",
            "",
            "2 Laanhmei kathuic tii ’twnlou e,",
            "Siimei khei guay laa ganclou;",
            "’Chumhmei, ’twnmei latzan swlou,",
            "Gay ranvmei khou zaylou e,",
            "Pui _>6 kanac nunc ta kawna,",
            "Bow pwkhou puanc thaulou e,",
            "Kaniw ta kapuih chuylou e,",
            "Pui ramzian _>6 gungclou e.",
            "",
            "3 Ravguangc zianmei e,",
            "tingsaeng khang,",
            "Pui ramzian ta suaihiamlou;",
            "Nai tingswang e, tanc liang bam e,",
            "Baihmei ramzian ta rii e!",
            "Pumtan, ningting paan _>6 hamh e,",
            "’Niu ta zay thauloumei hei;",
            "Pui ramzian _>6 ramh guay swlou,",
            "Pui lungning Ravguangc khou nai. Amen."
          ]
        }
      }
