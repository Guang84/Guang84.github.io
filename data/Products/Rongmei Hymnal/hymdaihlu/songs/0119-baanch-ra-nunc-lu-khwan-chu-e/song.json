        "content": {
          "format": "source-lines",
          "lines": [
            "1 Baanch’ra nunc lu khwan chu e,",
            "Nzaengc ruc khou suan bam e;",
            "Chyngbut guay khou kagaengv e,",
            "Kaniw neihlaa lu khwan 1<~.",
            "",
            "Kauh .. liangmei khou",
            "Ravguangc hym daic kan diu!",
            "",
            "2 He lauziu gaenghmei thiule,",
            "Bui zaeng hei di neihlaa cho?",
            "Dinc o, bui chamv naina cho?",
            "Heidi neihlaana thuanhmei?",
            "",
            "3 Guang zauc tho, Bethlehem khou",
            "Baanch’ra nunc <~1 thuanc bammei,",
            "Ngasatna Guangh Khrista ta",
            "Guang kalum tho, pun keyna.",
            "",
            "4 Zauc lo! guaihkuak khou zip bam",
            "Kauh lev dih Kaipouc, Jisu!",
            "Meri, Joseph nang ney nic",
            "Pou ta ’niw lev thuanc ’chamc kho."
          ]
        }
      },
