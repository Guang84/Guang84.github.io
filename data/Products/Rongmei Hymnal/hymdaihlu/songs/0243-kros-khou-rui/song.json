        "content": {
          "format": "source-lines",
          "lines": [
            "1 Suamc kauhloumei kros khou {:1,",
            "Pou Jisu theih bamv khou {:1,",
            "Adih nuh gaypui khwan cho,",
            "Anu khou chu guangmei hei!",
            "“Thuakloumei taanv 1<: luai the,",
            "Guang tho, he paapc mei, guang tho!”",
            "",
            "2 Khwmkih khang chamdaanvlou the,",
            "Gat makna ramh guay nai the;",
            "’Zwan guang tho, nang Pupamv khou,",
            "Nang ta Ravguangc nac kaw ni,",
            "Kakhou {:1 tat dat mak khang,",
            "Guang tho, he paapc mei, uang tho!",
            "",
            "3 “Tingmik hei rau guang pw the,",
            "Zauc lo, Ai guang dat pw the!",
            "Gaanc taek makmei kalaanv ramc,",
            "Atuang tingsaengzaeng kai khou,",
            "Nang bumaengc guang tangc nuh khang",
            "Guang tho, he paapc mei,guang tho!”"
          ]
        }
