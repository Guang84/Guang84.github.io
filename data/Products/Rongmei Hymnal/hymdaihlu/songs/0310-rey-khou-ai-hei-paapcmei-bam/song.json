        "language": "rongmei",
        "title": "Rey khou ai hei paapcmei bam",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Rey khou ai hei paapc mei bam khwan e,",
            "Kaipouc khou kuaklou khang guang e,",
            "Kuakloumei nsa na laa tow the,",
            "Kalatryan kalaih mak ge.",
            "",
            "Tingkauh kai thangc zanh thanh khat hylou the;",
            "Azanc e, hyloumei 6$%!",
            "Kauh baanch’ra nunc neihlaa lu suan bam the:",
            "“Paapc mei khat kai guang the”!",
            "Hymdaihmei dic khou zanh thanh khat hylou the,",
            "Azanc e, hyloumei 6$%!",
            "Akhuay guay kuaklouna ai tingkauh ’zwan bam the,",
            "Maeng tat dat lak khe.",
            "",
            "2 Khuksun key e, niamhna ai kros khou,",
            "Ravguangc tuang lungpuam ta pingna,",
            "Kauh kaikhamv laanc pat ki ai how the:",
            "Azanc hylou bammei ta.",
            "",
            "3 “Zauzian $%6 gulou the!” twmei hei",
            "Ringhpui Latrik khou hylou the;",
            "Zei paan $%6 tiigay the, kuaklou the,",
            "Alungsyng $%6 thuancku e."
          ]
        }
      },
