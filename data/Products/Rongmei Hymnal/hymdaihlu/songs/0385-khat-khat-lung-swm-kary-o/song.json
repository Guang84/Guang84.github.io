        "content": {
          "format": "source-lines",
          "lines": [
            "1 “Nang lung chwnsw-katuakc rio,”",
            "Khrista khou zaeng ’thaekc go;",
            "Rigwnmei maek kumc kap rio;",
            "Khrista khou theihmei nunc thu",
            "Muangh khou key dat puni.",
            "",
            "Hei zaeng )}3 nangniw khat khat lung swm kary o,",
            "Mi lat )}3 khat khat lung swm karyna bam o;",
            "Hei zaeng )}3 nangniw khat khat lung swm kary o,",
            "Khat khat lung swm kary o, mi lat )}3.",
            "",
            "2 “Nang lung chwnsw-katuakc rio,”",
            "Khrista khou lwm ethei",
            "Zaengsiimei 3)^ zaenggaymei,",
            "Zingbangc 3)^ kalaanv gaanhmei,",
            "Nang khang tiiguanh puni.",
            "",
            "3 Changkhaanv tho, kaganv ’naa the,",
            "Kaipouc key puni the;",
            "Tingkauh ku kanmeipu 3)^",
            "’Niu )}3 huay bammei nunc lev",
            "Key dat nuangc puni the."
          ]
        }
      },
