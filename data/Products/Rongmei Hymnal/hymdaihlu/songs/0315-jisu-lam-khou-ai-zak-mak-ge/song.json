      "rongmei": {
        "language": "rongmei",
        "title": "Jisu lam khou ai zak mak ge",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu lam khou ai zak mak ge,",
            "Laalou khang, biak liangh khang;",
            "Kalat chingkhiuhmei hei piu khang,",
            "Hymdaih kros hei laa khang.",
            "",
            "Kros khou 1<:! kros khou 1<:!",
            "Gaanhmei ta ai how the,",
            "Alung puat ’ritmei guay 1<: ’maan kan the;",
            "Lwmmei paan khou 1<: amik how dat the,",
            "’Taw ai tingmik ’thuic neihlaa bam e.",
            "",
            "2 Jisu aRavguangc zanc thay e,",
            "Kazanc khou ai lwm e;",
            "Ata tiizak ni tu hamh e",
            "Amachunc tii’maan lak.",
            "",
            "3 Kaguangc bamvpaeng ntipmei kumc",
            "Kalatryan hei ’tip be;",
            "Kakhou ai tiigutloumei 1<:",
            "Latzan nganv gaeklou ni.",
            "",
            "4 Luih makmei azanc laalouna",
            "KaPu hu khou lyan ni;",
            "Jerusalem Kathanc khou kiu",
            "Akhang bamv tii puni."
          ]
        }
      },
