        "language": "rongmei",
        "title": "GAY RANV HAY HAY PUNI",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu khou tingmik ’thuic alung hei ’naa khith khit guang e,",
            "Kamei hei lauthwan gaanc pat thuai khou khang suangc gay diangc e;",
            "Amakumc, amang gay liangmei",
            "suangc Kamei gay ranv e;",
            "Tingmik ’thuic Kamei hei kahu nungc suangc gay hay hay e.",
            "",
            "Paekri sic makumh tangh mak,",
            "Kachaekc duikhuangc thangc 3>|;",
            "Khou3>| Kamei kahu nungcsuangc",
            "Gay ranv hay hay puni.",
            "",
            "2 Duh thangc >|3 Kata ai how khou Kahym 3>| lyanlou e,",
            "Lili pwang suangc gay e, lauthwan gaanphiu suangc gaanc ranv e;",
            "Abumaengc >|3 machunhmei guay Kamei >|3 tiilou e,",
            "Tingmik ’thuic Kamei hei kahu nungc suangc gay hay hay e.",
            "",
            "3 Alung ryanra pwkhou Kamei >|3 neihlaalou e;",
            "Achwn karum pwkhou ata",
            "Kangaengv khou pamclou e;",
            "Apuatrith guay phungcloumei Pu",
            "Khrista ta ai zian e;",
            "Tingmik ’thuic Kamei hei kahu nungc suangc gay hay hay e."
          ]
        }
