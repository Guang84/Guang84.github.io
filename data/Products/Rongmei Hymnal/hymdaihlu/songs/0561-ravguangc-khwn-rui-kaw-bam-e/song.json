    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Ravguangc khwn rui kaw bam e",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc khwan #^7 kaw bam e,",
            "Meic nunc ta kabaina;",
            "Zion khou thanv kanmei kumc,",
            "’Taw nic thanv dat bam e:",
            "“Thow ta Ai thouclou ni cho,",
            "Amei nunc ta zuak khang?",
            "Zakmei, agaamvmei kangriang",
            "Thow #^7 ric ganc ni cho?”",
            "",
            "2 “Amei nunc kapna bam e,",
            "Kai lev taanvbamv guay khou,",
            "Laupuk guay khou, kaithyan khou,",
            "Kaidai chaengluang guay khou,",
            "Amei nunc punkey bam e,",
            "Zinghmei, dwangdangvmei khou;",
            "Thow ta Ai thouclou ni cho,",
            "Kaniw ta tiiduak khang?”",
            "",
            "3 Pou, ’niw Nang kawmei chu e,",
            "’Niw daw e, “Niw nuh the,",
            "Nang latdiu khang thouclou tho,",
            "’Niw Nang bangc sw ni the;",
            "’Niw pumtan thu taniang de,",
            "’Niw panty hei dui e,",
            "’Ki ’niw ramsuan ta Nang #^7",
            "Nang ngamv khang piu nuh e.",
            "",
            "4 Chiwmei, liamhlaihmei khou #^7",
            "’Niw ta tiiduaklou o;",
            "’Naamei chwn khou #^7 ’niw ta",
            "Kauhmei khou zaylou o;",
            "’Niw ta sw ’thanlou na ro,",
            "Nang chwn khou zaylou o,",
            "’Niw khou Nang latdanv tii o,",
            "’Niw Nang lat piu ni the. Amen."
          ]
        }
      },
