        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu khou ai lwm ’tip bam the,",
            "Simei ’riw dat lak khe;",
            "Kalv’ri khou apuat luak ganclou,",
            "Ravguangc ta thuanc bam e.",
            "",
            "Panty saanv saengh khou lu suan ni",
            "APoubauhmei ta ai thuancna,",
            "Panty saanv saengh khou lu suan ni,",
            "Apuatrith guay Jisu phungclou.",
            "",
            "2 Pingmei padikna bam khwan e,",
            "“Pingriu,” saamei ai chu;",
            "Huayney pwkhou pingmei ’maan the,",
            "’Maan kan the puatrith guay.",
            "",
            "3 Jisu dinclou Ravguangc ramzian,",
            "Kamei ’patlou zat mak;",
            "Kauh khou tingsaeng aRavguangc ^&8",
            "Ai kahaw guay tii ni.",
            "",
            "4 Pu Ravguangc pamv khou guang pwkhou",
            "Kalatryan suai mak ge,",
            "Kamei ^&8 ata pamclou ni,",
            "Apuatrith phungclou ni."
          ]
        }
      },
