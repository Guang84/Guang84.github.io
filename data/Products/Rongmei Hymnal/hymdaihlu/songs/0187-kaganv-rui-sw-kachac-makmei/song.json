          "format": "source-lines",
          "lines": [
            "1 Kaganv )}3 sw ka-chac makmei",
            "Khrista kros khou hym daic e;",
            "’Thanmei p’ry guay 3)^ lyanlou e,",
            "Chingkhiuhmei kros tiangc khou 3)^.",
            "",
            "2 Ryanramei )}3 liam guang sihni,",
            "Ningmei guang tangh mak sihni,",
            "Kros )}3 ata ’patlou zat lak,",
            "Chuzaengh, neihlaa nai khou 3)^.",
            "",
            "3 Achaeng khou suaihiam neicriw )}3",
            "Gaanhmei, zianmei souclou khou,",
            "Kros khou )}3 gaanc kachan guangna,",
            "Neihlaa ’bumei tiilou the.",
            "",
            "4 Rumhmei, gaengmei, suhmei, ’maanmei,",
            "Kros paan )}3 sw ’thanlou the;",
            "Nganv makmei chuzaenghmei nai the,",
            "Tingsaeng neihlaamei nai the."
          ]
        }
