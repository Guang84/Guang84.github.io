      "rongmei": {
        "language": "rongmei",
        "title": "HE GAANHMEILE, ZAYLOU NARO",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 He gaanhmeile, tamzinghmei muangc chung khou",
            "Zaylou na ro!",
            "Zingbangc zingc the, ai kai khou ^&8 duc the,",
            "Chaeng zaylou o!",
            "Makavlou o, how duh khang neih maek khe,",
            "Phaikaamv khat na sihni zaylou na ro.",
            "",
            "2 Kahu nungc Nang khou ata zaylou khang",
            "Huay mak khwan e;",
            "Anyng ’raeng sw nii khwan the, ’ki ’taw mu",
            "Nang zaylou tho!",
            "Daic nii, saengc nii, lungkwng padik khwan e,",
            "Reynungc taanv ta ning towlou dat ri tho.",
            "",
            "3 Hei saan ata Nang zay guang the, ’taw nic",
            "Zaylou puni;",
            "Khow ’tauh, duithuak, ramvkaengv,",
            "’pat tat kan khou,",
            "Gaanc pat mak saanv;",
            "Lauthwan pat khou ai ^&8 machunh guangmei",
            "Nuic rimh rimmei baanch’ra nunc zaw how ni!"
          ]
        }
      },
