        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Jisu, abumaengc neicmik,",
            "Nang bam ethei zingbangc maek ge,",
            "Kandih muangc )}3 Nang",
            "bangc mik khou",
            "Nang zawpaanv ta gumliamlou rio.",
            "",
            "2 Mik tanguihna zip key pwkhou,",
            "Mi hei nkhamhmei chwn sw diu,",
            "He Guloumeipu, Nang pamv khou,",
            "Tingsaeng zaeng swmei adih gay !",
            "",
            "3 Lauthwan khou )}3 zingbangc nganvna,",
            "Ata bam ’duangh tanh tanlou o;",
            "Bam tuanclou o, zingc key pwkhou,",
            "Nang bam mak khou ai theic ping e!",
            "",
            "4 Lat liammei Nang nac gaanv saekc )}3",
            "’Seic Nang lat liamna bam ethei,",
            "Pou, ’taw zauzian taanv taanclou o,",
            "Paapc khou kata tiizip key rio.",
            "",
            "5 Rak bam saanv khou bam ’duanghlou o,",
            "Kandih panty nai bam saanv khou;",
            "Duipui kumhmei Nang zauzian khou,",
            "Tingkauh thangc ’niw zangsw mak saanv."
          ]
        }
