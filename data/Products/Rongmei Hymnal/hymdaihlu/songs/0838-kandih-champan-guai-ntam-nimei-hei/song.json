        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kandih champan guai ntam nimei hei,",
            "Tingmik kathan pat datro gai khuan o.",
            "",
            "2. Hei kandih khou hei lungkiang lou khang mak,",
            "Timgmik kathui simei !@9 gum liamme.",
            "",
            "3. Neikhat neila lu tei suan cham sini,",
            "Munpuang tuaimei tei kumma tuai lou the.",
            "",
            "4. Ntam nimei hei kandih jangsi e,",
            "Ram le thing nui chung ngam the guang datro.",
            "",
            "5. Kauh ram gai khou tei ntammei makge,",
            "Khou tei ariu dat khang !@9 tam lou the.",
            "",
            "6. Kandih rukhou hei banthai khangmakge,",
            "Munpuang tuai meitei kumma tuai nuang e."
          ]
        }
      }
    },
