        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Thau o, he alung neihmik kumei kumcna,",
            "Nang nic nang taanvdwan taanc thau tho,",
            "Lauthwan kalummei taanvdwan 5^& sw latho,",
            "Neihmaryn Ravguangc ’duanghlou khang.",
            "",
            "2 Kalaanv siamruai taanv 5^& alinghna taanc o,",
            "Thei thangc kaganv ^&5 thau kan khou,",
            "Aniau taanv sw nuh makpui ganv guang puni;",
            "Kaganv gay khou siamruai sw tho.",
            "",
            "3 He Ravguangc, ata gaengc chuylou bammeipu,",
            "Theidwan panty 5^& zaylou o;",
            "Aseic lam ai ^&5 thaymei khang suangc sihni,",
            "Ravguangc, Nang nthuanh lam thay e.",
            "",
            "4 Thau o, he alung neihmik kumei kumcna,",
            "Lwmmei panty hei daic thau tho,",
            "Karav gaymei, rih ngammei panty sw tho,",
            "Ravguangc mikzaw khou ntwn o."
          ]
        }
      },
