        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 He kaidai launa Bethlehem, nang hei rimh rim bam e!",
            "Nang ziptheicna bammei ruc khou gaanchuangcna guay tat kaan;",
            "’Ki zinghmei nang chaengluang khou tingsaengc riw gaanc bam e,",
            "Kating saengcna machunh guangmei",
            "Nang khou ’seic guang tangc the!",
            "",
            "2 Meri khou ^&8 Khrista puanc the, meic nunc ziprii bam khou;",
            "Baanch’ra nunc ^&8 guang kaduaina Karuc khou rigaanv e;",
            "He lauthwan gaanphiu guayle, Jisu puanhmei dinc o,",
            "Ravguangc ta thuancna lu suan o,",
            "Dih khou ’zaenghmei nai diu!",
            "",
            "3 Adih reih reina tiilou cho, ch’yinmei kaipat ta hei!",
            "Ravguangc ^&8 maansei guay lung khou tingkauh suaihiam tii the;",
            "Paapc dic khou Kamei guangmei, meic thaylou mak sihni,",
            "’Taw nic Kata laaloumei khou, Khrista gut bamlou e.",
            "",
            "4 He ’thanmei Bethlehem Ngana, keylou o, ’niw huay e;",
            "Paapc laa gancna gut bamlou o, ’niw khou ’seic puanclou o;",
            "Baanch’ra nunc ^&8 phungc guangmei neihlaa chamv 8^& chu e,",
            "Guang o, ’niw lev bam ’duanghlou o, he Pou Emmanuel."
          ]
        }
      }
