        "content": {
          "format": "source-lines",
          "lines": [
            "1 Apanty taanv hei luaina",
            "chanunghdui ai kaan pwkhou,",
            "Gaanc gaymei hymdaihmei",
            "lauthwan how pwkhou;",
            "Dui paengc kaan pat pwkhou",
            "Thuakloumei pu ta ai thay ni,",
            "Nuic rimh rimna Kamei ata riu puni.",
            "",
            "Ai thay ni, ... Kata ai thay .. ni.",
            "Thuaklouna Kadaeng khou ai ding pwkhou;",
            "Ai thayni, .. Kata ai thay .. ni,",
            "Kabaanc khou zotpi zam khou 4^& @<4.",
            "",
            "2 He adih neihlaa ni cho,",
            "Kazawpaanv 4^& how pw khou!",
            "Zian thaymei Kamik-khwan",
            "4^& ai how pwkhou!",
            "He adih thuancku bam khang",
            "nai cho, zianloupui zaeng khang!",
            "Kauh thangc akhang bamv chamdaanvloupui zaeng khang.",
            "",
            "3 Zianmei nunc hymdaih khou bam,",
            "ata guang khang baanh ’zaapna;",
            "Kandih khou ’tamv kanmei 4^& makumh pat re;’",
            "Gaychuymei Eden nzaengc",
            "khou kaniw lu suan riu ni,",
            "’Ki Jisu ta ai ariw rey liang nii e.",
            "",
            "4 ’Phwanmei pheychuan piuna kaidai raengcmun khou ’duangh gutna,",
            "Mikdui key dat makmei bamv khou zaylou ni;",
            "Tingsaengc lu, tingkauh lu 4^& ai neihlaana suan puni,",
            "’Ki Jisu ta ai ariw rey liang nii e."
          ]
        }
