        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zauc lo, Kaipouc ’taw hei kaw bam the,",
            "Lautaypuimei ling khang;",
            "Kachaekc laupuk mincna ’khwan bam the,",
            "Taypuimei thu raw e.",
            "",
            "Tat ro, ’khaengvthayna, zianlou thayna;",
            "Tat ro, Kaipouc zanc khou,",
            "Nsa tiimei ringhbamv chamv gaymei",
            "Kandih pwm dinc lik go.",
            "",
            "2 Tat ro, paapc _>6 zyn bampui bamv khou,",
            "’Maanmei ta kanlou o;",
            "Tat ro, kangriang guay sw taeklou o;",
            "Kaniw ta gulou o.",
            "",
            "3 Tat ro, lungcsiimei ta kaw guang o,",
            "Khwmkihmei tu diu khang;",
            "Ringcsuangmei ’Tyan, Jisu Kamei _>6",
            "Kaniw ta riu puni.",
            "",
            "4 Tat ro, tingmik hei raw guang pw the,",
            "Zingc nuangc kan puni the,",
            "Nkhamhpui ganv katumcna guang the,",
            "Taanv taanc nuh mak ni the."
          ]
        }
