        "content": {
          "format": "source-lines",
          "lines": [
            "1 Daihmei baantanc rilianghmei dic,",
            "Swmei zaeng khang na hamh e,",
            "Napbi ’thuihmei zaeng na hamh e,",
            "’Niw }?2 Nang ta thuanhmei hei;",
            "Tat kanmei guang nimei kak khou,",
            "’Taw ganv khou hei ding lana,",
            "Pou, ’niw lungsyng thangc }?2 thuanc e,",
            "How tangh makmei guay khang ta.",
            "",
            "2 Rih tuang rungh, rihpan khang hamh e,",
            "Baengsaeng ngamv guay khang hamh e,",
            "Rih ngammei lung tiiloumei khang,",
            "Pou, Nang ta ’niw thuancku e;",
            "’Niw nyngthav swna lunghmei khang,",
            "Kaikhunh, phwamling lev skul khang,",
            "Meic nunc }?2 sinmei kandih khou",
            "Meic sw nuhmei chaeng guay khang.",
            "",
            "3 Kaniw zanc thay tow makmei nunc,",
            "Lwm nuhmei rihmei nunc khang,",
            "Zanh tatmei, dih ta zianmei nunc,",
            "Meic nunc ta zayloumei khang;",
            "Muhzwng nunc lev Aposal nunc,",
            "Ringhmei Lat dinc tatmei nunc,",
            "Bumaengh khou meic daihmei nunc khang,",
            "Pou, ’niw Nang ta thuancku e."
          ]
        }
