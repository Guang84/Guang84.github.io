        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu zei #<8 tii’phwanloumei",
            "Pwan 8}@ #<8 ’niu karuh lana,",
            "Aniu sowriw nuangc puni the;",
            "’Tamv pw khang pingmei nai lak khe",
            "Dui daic bammei paengc thangc!",
            "Dui dai .. bammei pangc thangc! (3)",
            "’Tamvmei nai dat lak khe!",
            "’Tamvmei .. nai dat lak khe! (3)",
            "Dui daic bammei paengc thangc!",
            "",
            "2 ’Taw mu siimei ta ping mak khe,",
            "Lwmmei paan tingkauh kai how the;",
            "Baanch’ra kumcna saamei chu the:",
            "“Ravguangc #<8 mikdui roulou ni”",
            "Dui daic bammei paengc thangc!",
            "",
            "3 Zianmei guay ta sowriw pwkhou",
            "Adihkamv neihlaa puni cho!",
            "Kachaekc raenghkat laanclou pwkhou",
            "Adih zaenggayna gut ni cho!",
            "Dui daic bammei paengc thangc!",
            "",
            "4 Guloumeipu, chaeng zaylou o,",
            "Aramneihlaa kami tangh khang;",
            "’Niu mikdui rouloupui zaeng khang",
            "Taek makna thuanckuna bam khang,",
            "Dui daic bammei paengc thangc!"
          ]
        }
