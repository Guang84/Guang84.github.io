        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Gay liangmei Jisu!",
            "Ramh kaguayna Kaipouc,",
            "Ravguangc Nac maansei lwn Nang e,",
            "Nang ta ’niw zian e,",
            "Chakhwang champouh ni,",
            "Nang abumaengc pyrun kiu e.",
            "",
            "2 Phuaithingc ramv gay e,",
            "Thingding nwm gay ranv e,",
            "Lauphunhswan mwn $%6 karuhna;",
            "Hei guayna khang suangc",
            "Jisu gay ranv e,",
            "Ryanra lung tiineihlaameipu.",
            "",
            "3 Neih riw hei gay e,",
            "Bwkaanv riw gay ranv e,",
            "Gaanchuangcna guay riw nic gay e,",
            "Jisu gay ranv e,",
            "Jisu ’than ranv e,",
            "Kauh baanch’ra guay suangc gay diangc e.",
            "",
            "4 He Guloumeipu,",
            "Zaatc kaguayna Kaipouc,",
            "He Ravguangc Nac lev Maansei Nac!",
            "Chakhwang champouhmei,",
            "Hymdaihmei, thuanhmei,",
            "’Taw nic tingsaeng Nang khang sw diu."
          ]
        }
      },
