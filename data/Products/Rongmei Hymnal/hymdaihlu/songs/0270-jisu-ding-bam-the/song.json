        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu ding bam the Pilat hu khou,",
            "Pamrai maek, ganc ’rulou, ’muclouna;",
            "King o, ’bui ’bah cho, kauc patmei kiu!",
            "Nang tu kumh ni Jisu ta?",
            "",
            "Nang tu kumh ni Jisu ta?",
            "Chakakmei sw nuh mak!",
            "Neih khat nang raana thanv puni:",
            "“Ata tu kumh puni?”",
            "",
            "2. Jisu latzan bamv khou ding bam he,",
            "Lwm nuh makmei swna lungc nuh e,",
            "Lwm nuhmei swna nang lungc nuh e;",
            "Nang tu kumh ni, Jisu ta?",
            "",
            "3 Pilat kumc Kata ganclou ni cho?",
            "Tabui puni Kata laa ni cho?",
            "Nang nkamh ngam mak ge",
            "Kakhou ^&8,",
            "Nang tu kumh ni Jisu ta?",
            "",
            "4 Pitor kumc Kata nuh mak ni cho?",
            "Kata howmumei ta ping makna,",
            "Theic nic, ringc nic Kakhang ding ni cho?",
            "Nang tu kumh ni Jisu ta?",
            "",
            "5 “Jisu, Nang khang alung tiigut the!",
            "Ringc bam saanv ai Nang thei lay ni the;",
            "Nang Lat piu ni twna saa ni cho;",
            "Ai sw ni the, Jisu khang."
          ]
        }
