        "content": {
          "format": "source-lines",
          "lines": [
            "1 1 Tinggaanc pat pwkhou Jisu t’rou bamv khou,",
            "Kapam nunc lungh zingcna guang khou,",
            "Guang anaa pwkhou t’rou raeng ta how the;",
            "Kaniw khou pingmei padik the,",
            "",
            "Ringcthau the! Ringcthau the!",
            "Zauczihmei ta ngamna Khrista ringcthau the;",
            "Ringcthau the! Ringcthau the!",
            "Kaipouc ta thuanc o, he abumaengc.",
            "",
            "2 Zianmei taanv daih 2}? Jisu taanclou the,",
            "Kamei ringcthau reymei thai the;",
            "Ch’ryn sihna kaniw neihlaa dat kan the,",
            "Huay bammei pu ta how datna.",
            "3 T’ruaih ngamv ta ngamna Jisu ringcthau the,",
            "Theihmei ngamv ta ngamlou ducna;",
            "Aniu nic Kakumc ringcthau dat puni,",
            "Kamei nunc ta laa khang key khou."
          ]
        }
      }
