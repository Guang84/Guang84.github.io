          "format": "source-lines",
          "lines": [
            "1 ’Niw khou naimei guay hei",
            "He Kaipouc, Nang tuang de;",
            "Nang tuang Nang khang tiidat tuang de,",
            "Laalou o, Poubauhmei.",
            "",
            "2 Geicna Nang tiilou e,",
            "’Niw tamthiwmei swna",
            "Nthai luan reymei phuling hei",
            "Neihlaana phungc guang e.",
            "",
            "3 Swmlou, katiuloumei,",
            "Lungh bakmei tii gaymei,",
            "Sansiimei nunc ta ’khavloumei",
            "Ravguangc taanv ling kiu e.",
            "",
            "4 Banghmei ta ricloumei,",
            "’Maanmei ta phungc guangmei,",
            "Ringhmei chaeng khou zayloumei hei",
            "Khrista ningmei taanv e.",
            "",
            "5 Aniw Nang Lat lwm e,",
            "’Niw ramlum ’thyam sihni,",
            "’Niw taanhmei kathuic hei Kaipouc,",
            "Nang khang @{4 taanh tuang e."
          ]
        }
