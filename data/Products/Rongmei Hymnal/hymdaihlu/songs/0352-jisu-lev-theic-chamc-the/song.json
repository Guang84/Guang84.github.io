        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu lev theic ’chamc the, aphaan theih khou,",
            "Jisu lev ringc ’chamc e, panty thanh khou,",
            "Hymdaih riw pat mak saanv Kata zauc ni,",
            "Kaganv ’thuic Kaipouc, ai Nang mei di the!",
            "",
            "Kaganv ’thuic Kazauzian khou ata lou,",
            "Kaganv ’thuic kauh tuang ringhmei akhang nai,",
            "Hymdaih riw pat mak saanv Kata zauc ni,",
            "Kaganv ’thuic Kaipouc, ai Nang mei di the.",
            "",
            "2 Nchanvmei kathuic khou Kamei ’khavlou,",
            "Puatrith guay Kamei ({0 phungc ’khavlou e;",
            "Ryanramei kathuic khou ’khaengv",
            "’khavlou e,",
            "Kaganv ’thuic Kamei ata gaeklou e.",
            "",
            "3 Lungh kabiu, ryanra kalanghmei guay khou,",
            "Mikdui key, chwnsii zaengsiimei",
            "guay khou,",
            "Theic nuhpui bamv guay khou",
            "Kamei nunc khang,",
            "Kaganv ’thuic Kamei ({0 kadanlou e.",
            "",
            "4 Aramsuan guay ta Kamei thaylou e,",
            "Tiigay ngam dat lakmei sunu",
            "maek ge,",
            "Ryanra khou, neihlaa khou, kaganv ’thuic khou,",
            "Ata ’duanghlou na ro, Guloumei pu!"
          ]
        }
