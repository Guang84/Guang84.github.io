        "language": "rongmei",
        "title": "’King o, paapc meile, Ravguangc",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’King o, paapc meile, Ravguangc nang ta kaw bam the,",
            "Linghmei lev zaenghuaymei lat ?|7 kaw bam e;",
            "Kalat hei piu lo, latzan khou nang ding lam e,",
            "Lautay luai guang the, lailwm luai puni the.",
            "",
            "Lautay ganv luai guang the,",
            "lailwm luai guang the,",
            "Lautay ganv luai guang the,",
            "lailwm luai guang the.",
            "",
            "2 Theic nuhmei bamv khou, khuay lam khou saa katup the,",
            "Heidi katupna zauzian p’ry rac bam e.",
            "’Khap tho, nang ta laalou khang",
            "Kamei ’khwan bam khou,",
            "Lautay luai guang the, lailwm luai puni the.",
            "",
            "3 Malaamei, ganc patmei swna ganclou puni,",
            "Pingmei chwn karummei padik puni the;",
            "’Khap tho, he paapc mei, Kamei ?|7 laalou nuh khou;",
            "Lautay luai guang the, lailwm luai puni the.",
            "",
            "4 Gumeipu ?|7 latzan khang nang ta kaw puni,",
            "Paapc guay ganc pat tho, Kata nang Pam sw tho;",
            "Kata laalou tho, katumcna Kata bwan o.",
            "Lautay luai guang the, lailwm luai puni the."
          ]
        }
      },
