        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang nyng swlou o, he Poubauhmei!",
            "Lai kasiamhmei Nang, ai gambic e,",
            "Nang kahawmei khou kasiamhlou o,",
            "Alung bowlouna ai ’khwan bam khou.",
            "",
            "2 Nang nyng swlou o, he Poubauhmei!",
            "Phuna zauclou o, Kaipouc ata!",
            "Gunh khang suangc ’phwan khang khiu ’thanlou o,",
            "Nang hu khou khwanna ’khuksun bam khou.",
            "",
            "3 Nang nyng sulou o, he Poubauhmei!",
            "Ryanra lakmei e, ’khavlou na ro!",
            "Ngamv guay Nang tuang e, he Poubauhmei!",
            "Ata kahina tiigaylou o.",
            "",
            "4 Nang nyng swlou o, he Poubauhmei!",
            "Nang kahawmei guay taanc tangclou tho!",
            "Akhou Nang Bumaengc padiklou tho,",
            "Khrista lungc bammei how tanh tan khang."
          ]
        }
      },
