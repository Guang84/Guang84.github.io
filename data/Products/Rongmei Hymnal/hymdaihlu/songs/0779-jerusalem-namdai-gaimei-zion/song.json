        "language": "rongmei",
        "title": "Jerusalem namdai gaimei Zion",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Jerusalem namdai gaimei Zion,",
            "Martyr guai le bumang nthanmei guai;",
            "Nkhuaimei guai khrista pan khou rui,",
            "Bam puni e neikei dat mak piu ram khou.",
            "",
            "Chorus:",
            "Hallelujah poutikgun dai kandiu,",
            "Hallelujah Amen hallelujah;",
            "Mei ti nthan loudiu khang guang e,",
            "He kaguang Immanuel hallelujah.",
            "",
            "2. Kross rukhou rui nthuk pui jeih luang kei,",
            "Jisu jeih nthukmei kalvari khou;",
            "Aniuta kanlou khang rui luang kei,",
            "He nthuk ge Jisu jeih hallelujah.",
            "",
            "3. Poubaumeita ariu nimei nun 5#^,",
            "Gehem kaipou poubaumei Jubili;",
            "Alau nun rui thuanku e pouta,",
            "Nangta thuan e nthukliangmei hosana.",
            "",
            "4. Jerusalem guang Jisu dailiangmei,",
            "Jerusalem khou guang dailiangmeipu;",
            "Guang jan khou guangmmei ta thuanku e,",
            "Messiah ariuna kao e hosanna."
          ]
        }
      }
    },
