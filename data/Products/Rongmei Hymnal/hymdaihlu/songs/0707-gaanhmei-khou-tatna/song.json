        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guloumeipu phaykaamv suih khang karamcna,",
            "’Niu Guangc Jisu thei lay khang karamcna,",
            "Kakheiliak #^5 ’niu panty kasiamhlouna,",
            "Adih gay tu cho, Kakaamv lay kaamhmei!",
            "",
            "Guloumeipu phaykaamv lay",
            "kaamhmei adih gay cho!",
            "Gaanhmei khou tatna,",
            "gaanhmei khou tatna,",
            "Guloumeipu phaykaamv lay",
            "kaamhmei adih gay cho!",
            "’Chumhmei chaeng zaylou!",
            "",
            "2 ’Niu chaenglwan khou tat biang khang ’thiam guang pwkhou,",
            "Zayloumeipu daeng khou tat tuanc ranvna,",
            "Gaeklou ngammei Kabaancpwam tihei lwmna,",
            "Adih neihlaa cho, Kata thuancku kho!",
            "",
            "3 Lwmmei paan #^5 Kaipouc thei ’niu lay tatna",
            "Tangc nipui bamv thangc khith khitna guangna,",
            "Aniu Guangc tuang kagai 5#^ howpui nungc kiu,",
            "Adih neihlaa ni, Kadaeng khou bamna!"
          ]
        }
