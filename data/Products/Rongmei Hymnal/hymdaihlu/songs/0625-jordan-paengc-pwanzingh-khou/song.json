        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jordan paengc pwanzingh khou dingna",
            "Agwnna ai phaan e,",
            "’Baanvthaypui dic Kanaan ramc ta;",
            "Khou3>| akai nai e.",
            "",
            "Zaeng ’thaekc ni aniu ’baanvthaypui dic khou,",
            "Gaymei dui paengc khou tangc pwkhou,",
            "Lauziu Nac lev Mousi lu 3>| suanna bam ni,",
            "Jisu lev tingsaeng lungc ’chamc ni.",
            "",
            "2 Daihmei nzaengc dic pwm khou 3>|",
            "Kalaanv swna gaanc e;",
            "Khou3>| Jisu >|3 guanghtu e,",
            "Zingbangc nai dat mak khe.",
            "",
            "3 Tingsaeng neihlaa ’baanvthay ramc kiu,",
            "’Bui nungc ai tangc ni cho?",
            "’Bui nungc aPu zaw kiu howna",
            "Kapamv khou ’thaekc ni cho?",
            "",
            "4 Alung neihlaamei padik the,",
            "Khou hei bam saengc zih the,",
            "Jordan dui kamuatc bam sihni",
            "Ping makna kaan ni the."
          ]
        }
      },
