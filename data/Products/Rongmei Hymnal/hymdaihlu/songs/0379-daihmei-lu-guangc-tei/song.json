        "content": {
          "format": "source-lines",
          "lines": [
            "1 Daihmei lu guangc 8^& aniu suan kim nii zat mak ge;",
            "Ravguangc hym daic, Hallelujah!",
            "Aniu ramlum daicthaumei lev lu heisuan ranv ni;",
            "Ravguangc hym daic Hallelujah!",
            "",
            "He Pu Ravguangc nac thiule,",
            "Lu hei kauc ranvna suan kho,",
            "Chaeng hei gaanc gayna bam the,",
            "’Niu bumaengc hei samc thau the,",
            "Khith khitna ’niu tat gut re,",
            "Guangh kaidai thangc 8^& ’zwanna!",
            "Ravguangc hym daic,Hallelujah!",
            "",
            "2 Thuakloumei zauzian tuang",
            "neihlaa khou aniu bam e,",
            "Ravguangc hym daic, Hallelujah!",
            "Neihlaa swkaeng ^&8 chyngtwan",
            "ku khang ’niu samc ku e,",
            "Ravguangc hym daic, Hallelujah!",
            "",
            "3 Kaphut ^&8 kasiamhmei kaidai thang ’niu tat bam e,",
            "Ravguangc hym daic, Hallelujah!",
            "Tik gunc daicna Guangh ^&8 bammei ’niu how nuangc ni the,",
            "Ravguangc hym daic, Hallelujah!",
            "",
            "4 Khou 8^& thuakloumei lu thanh ’niu neihlaana kauc ni,",
            "Ravguangc hym daic, Hallelujah!",
            "Jisu thuanhpui lu thanh 8^&",
            "’thanmei nunc lev suan ni,",
            "Ravguangc hym daic, Hallelujah!"
          ]
        }
      },
