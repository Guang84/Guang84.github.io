        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc, ’niw ta suaihiamlou o,",
            "Neihlaamei, chuzaenghmei khou;",
            "Aniw kathuic Nang zauzian khou,",
            "Rih ngammei tiiswlou o;",
            "Aniw lung tiikaluanlou o,",
            "Ramvzingh khou n-gyn bam khou.",
            "",
            "2 Thuancku e, aniw kalum e,",
            "Neihlaamei Gaychamv zaeng khang;",
            "Nang tuang ringcbamv thai gaymei 1<:",
            "Aniw lung khou padik diu;",
            "Lwmlou nuhmei ’twnmei swna,",
            "’Niw ta sowriwmei sw diu.",
            "",
            "3 Kandih hei ’niu ganclou duh khang",
            "Kaipouc {:1 kaw guang pwkhou,",
            "Baanch’ra nunc sw {:1 tingkauh thangc",
            "Aniu ta phungc ku pwkhou,",
            "Taek makna tingkauh guanghdic khou",
            "Khrista lev guanghtu ’chamc diu."
          ]
        }
