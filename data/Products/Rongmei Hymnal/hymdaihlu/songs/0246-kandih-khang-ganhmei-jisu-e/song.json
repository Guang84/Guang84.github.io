    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Kandih khang ganhmei Jisu e",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Paapc zinghmei khou kandih",
            "kapwm ’maan khwan the,",
            "Kandih khang gaanhmei Jisu e!",
            "Kalaanv neicriw kumc Jisu riw }?2 gaanclou,",
            "Kandih khang gaanhmei Jisu e!",
            "",
            "Gaanh khou guang o,",
            "Nang khang gaanc bam the;",
            "Akhang mu gaanc chuyna gaanclou the;",
            "Mik tiat khwanmei ’taw thu ai how the:",
            "Kandih khang gaanhmei Jisu e!",
            "",
            "2 Jisu khou bammei ’niu khou",
            "zinghmei maek khe,",
            "Kandih khang gaanhmei Jisu e!",
            "Jisu thei lay ethei ’niu gaanh khou tat re,",
            "Kandih khang gaanhmei Jisu e!",
            "",
            "3 Zingh khou lunghmei paapc }?2 mik tiat bammeithiu,",
            "Kandih khang gaanhmei Jisu e!",
            "Kalat piuna khiu tat ro, how puni the,",
            "Kandih khang gaanhmei Jisu e!",
            "",
            "4 Neihriw hei tingkauh thangc thu kage maek khe,",
            "Tingkauh thangc gaanhmei Jisu e!",
            "Kachaekc kaidai khou gaanhmei",
            "Lauziu Nac e,",
            "Tingkauh thangc gaanhmei Jisu e!"
          ]
        }
      },
