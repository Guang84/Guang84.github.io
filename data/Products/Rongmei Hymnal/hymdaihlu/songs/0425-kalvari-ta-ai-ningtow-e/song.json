        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kamei zaylou khou ai tat ni,",
            "Kakhou lwmmei ramgai thay the;",
            "Ai ningtow e, akhang dyng e;",
            "Kalvari khou theicloumei 1<~.",
            "",
            "Jisu ata zaylou puni,",
            "Zingbangc kalaanv, kaganv",
            "’thuic khou,",
            "Gay liangmei Pam kiu Kamei e,",
            "Kalvari ta ai ningtow e.",
            "",
            "2 Kalatdanv khou ai neihlaa e,",
            "Karamzaylou ta ai pian the;",
            "Kachwn hei akhang gay liang e,",
            "Kalvari zei <~1 sw ’thanlou.",
            "",
            "3 Hu thangc ai gut ni, ping makna,",
            "Khrista ’duanghlou zaeng neihlaana,",
            "Neih khat sowriw khang lwmgayna,",
            "Kalvarimei pu Jisu ta."
          ]
        }
