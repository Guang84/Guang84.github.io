      "rongmei": {
        "language": "rongmei",
        "title": "’Taw thu ’niu Ravguangc ta thuanc e",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Taw thu ’niu Ravguangc ta",
            "’Niu khwan lev baanh )}3 thuanc e,",
            "Ch’rynmei taanv taanclou the,",
            "Kandihmei guay neihlaa e;",
            "Aniu pui pamv khou )}3",
            "’Taw nganv suaihiamlou the,",
            "Zianmei kaipat peyna",
            "’Taw nganv laatow bam e.",
            "",
            "2 He priuhmei Racguangc hei",
            "’Niu ringcting saanv bam ’duangh diu,",
            "’Niu ta tii neihlaa diu,",
            "Chuzaenghmei lung tiilou diu,",
            "Kazauzian lungc ’dauh diu,",
            "Dwangdangv khou zaylou diu,",
            "Siimei guanglou mak khang",
            "’Taw nic, thei thangc nganvna.",
            "",
            "3 Thwan lev thuanckumei hei",
            "Pu Ravguangc khang sw kan diu,",
            "Kauh thangc guanghtu bammei",
            "Nah Pouh ta thuanhmei sw diu;",
            "Tingsaengzaeng Ravguangc ta",
            "Kauh lev dih )}3 thuanc diu,",
            "Kahunungc kumc ’taw nic",
            "Tingsaengzaeng nganv thuanc diu!"
          ]
        }
      },
