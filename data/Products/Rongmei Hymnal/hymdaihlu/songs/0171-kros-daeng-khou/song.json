            "1 Pou Jisu, ata lou o,",
            "Kunghmei Nang kros daeng khou;",
            "Nsaa tiigaymei duiriang",
            "Luanghmei kalvari khou.",
            "",
            "Kros khou hei, kros khou hei,",
            "Ahymdaih bamv sw ni,",
            "Phungc kuloumei abumaengc,",
            "Kauh thangc zaeng ’thaekc",
            "mak saanv.",
            "",
            "2 Pingmei du kros daeng guang e,",
            "Zauzian {:1 laalou e,",
            "Khou1<: lauthwan gaanphiu {:1",
            "Ata tiigaanclou e.",
            "",
            "3 He Ravguangc Lauziu Nacle,",
            "Kros lwn tiihowlou o;",
            "Tingmik ’thuic panty chaeng khou",
            "Kros hei {:1 sungclou o.",
            "",
            "4 Ai ’khwan bam ni kros daeng khou,",
            "Taek makna lwm bam ni;",
            "Dui paengc thangc kachaekc dic 1<:",
            "Ai guang lungc tangh mak saanv."
