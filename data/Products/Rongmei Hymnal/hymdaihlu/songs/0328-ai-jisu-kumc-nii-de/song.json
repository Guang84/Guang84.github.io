        "content": {
          "format": "source-lines",
          "lines": [
            "1 Dih ramgai $%6 ata kaw e,",
            "Ai Jisu kumc ni de;",
            "Dih $%6 ata ’thiam ngam pw lak,",
            "Ai Jisu kumc ni de!",
            "",
            "Jisu kumc ni alu e,",
            "Kai khou lev charuangcbam khou;",
            "Kaganv ’thuic Jisu kumc ni!",
            "Ai Jisu kumc ni de!",
            "",
            "2 Kamei $%6 kangriang guay sw taek,",
            "Ai Jisu kumc ni de!",
            "Kasiamruai sw chuy diangh khang e,",
            "Ai Jisu kumc ni de!",
            "",
            "3 Kandih khou $%6 hymdaihmei nganv,",
            "Ai Jisu kumc ni de!",
            "Kap’ry rac kaluaih luaih bam ni,",
            "Ai Jisu kumc ni de!",
            "",
            "4 Kauh thangc ata Kamei ’riw khang,",
            "Ai Jisu kumc ni de!",
            "\"Gay the!\" twna ata ’riw khang,",
            "Ai Jisu kumc ni de!"
          ]
        }
      },
