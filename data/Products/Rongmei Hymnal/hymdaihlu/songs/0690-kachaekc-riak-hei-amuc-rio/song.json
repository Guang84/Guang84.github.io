        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Thukmei thouc khou ding ’tipna",
            "Ravguangc lat piumei,",
            "Geih mak ge lwmnuhmei nunc!",
            "Zauc lo, Daniel Kangmei!",
            "",
            "Daniel kumcna bauc e!",
            "Ding kiangc ping mak ge!",
            "Kathouc thay e, ding ’tip be!",
            "Dinc ’dauh khang ping mak!",
            "",
            "2 Tancbauhmei nunc bow kan the,",
            "Ding ’tip ngam makna;",
            "Ravguangc ricmei sw khwan e,",
            "Daniel Kang khou zaucna!",
            "",
            "3 Liangtuangh ’peyna kandih khou",
            "Liang tat bammei nunc,",
            "Kandih khou pun key puni,",
            "Daniel Kangmei hu khou!",
            "",
            "4 Gospel chuangcphey daanc kauh tho,",
            "Ngam khang tat gut tho,",
            "Seitaan ngamv ta athwng o,",
            "Kauc o, Daniel Kangmei!"
          ]
        }
      }
    },
