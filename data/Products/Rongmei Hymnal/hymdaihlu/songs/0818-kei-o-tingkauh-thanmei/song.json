      "rongmei": {
        "language": "rongmei",
        "title": "Kei o tingkauh thanmei",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kei o tingkauh thanmei khouna,",
            "Nangbou keiduan bammo;",
            "Alung khou hei Raguang jaujian,",
            "Louna lung jang ti o (3).",
            "",
            "2. Kandih man dat nimei lung khou,",
            "Alung gut lou ngam the;",
            "Tingsangjang ring nimei biak thu,",
            "Alung gut dat mak khe (3).",
            "",
            "3. Alu ramsuan ni gaikhang mak,",
            "Meilung gut khang mak ge;",
            "Gaipui lu ni suan kim nuang e,",
            "Ai lummei nthan mak (3).",
            "",
            "4. He Raguang jaujian hei kumma,",
            "Asan bam nina cho?",
            "Nang jajian phu ngam makmei 1@:,",
            "Ai rui thai ngam mak ge (3).",
            "",
            "5. He tingkauh bumang thanmei le,",
            "Bam tan ri o alung khou;",
            "Lungning thanmei le njangmei,",
            "Alung khou tilou o (3)."
          ]
        }
      },
