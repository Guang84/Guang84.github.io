        "content": {
          "format": "source-lines",
          "lines": [
            "1 Poubauhmei lev aniu Kalat riw khou tat khou,",
            "Aniu chaeng adih tiigaanclou cho!",
            "Kanyng piulou ti thei aniu lev bam ’chamc e,",
            "Lwmna piumei guay lev bam ’chamc e.",
            "",
            "Lwmna piu o, hei hamhna chaeng maek ge,",
            "Jisu khou neihlaa bam khang",
            "Lwmna piumei na de.",
            "",
            "2 Gumliam khang tingpuk khou",
            "muangh !}2 ’thau ngam mak ge,",
            "Kamei !}2 muangh ta hac ganc puni,",
            "Lwmsiimei pingmei maek, mikdui",
            "keymei 2^< maek,",
            "Lwmna piu bam khou khat sihni maek.",
            "",
            "3 ’Niu !}2 phunghmei puatphung,",
            "ryanra khaengvmei guay khang,",
            "Kamei !}2 suaihiam ’’buna tiilou,",
            "Chwnsii-zaengsii, ’maanmei, kros",
            "phunghmei kathuic hei,",
            "Suaihiam de, lwmna piumei guay khang.",
            "",
            "4 Gaymei dam laa ’chamcna Kapamv khou ’niu bam ni,",
            "Tat pwkhou Kamei lev tat ’chamc ni;",
            "Ndiupui lat piu ni, thouhpui bamv khou tat ni,",
            "Khat sihni ping lak lwmna piu ni."
          ]
