        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kabou khou ({0 duhmei ’ruaihnakhat kumc ai hei",
            "Ruan tat the Gumeipu, Nang khou ({0;",
            "Zianmei khwan ({0 ata kai guang khang Nang kaw e,",
            "Ata riulou ni twmei thay e.",
            "",
            "Riulou ata, Gumei pu ({0!",
            "Ata neihlaana laalou e!",
            "Akhouhna kumc Nang khou nthaekc the,",
            "Nang khou gayna ai duplou the!",
            "",
            "2 Ai duak the hih lungc khou ’taw thu ai zaeng ’thaekc the,",
            "Zianthaymei pu aRavguangc pamv khou;",
            "Nang lev bamna akhou neihlaamei padik the,",
            "Nganv makna neihlaa bam puni the.",
            "",
            "3 ’Taw mu ai Jisu khou zaeng ’thaekc the, ping mak khe,",
            "Adeang guay dui kamuatc guang sihni;",
            "Zingc key makpui tingmik ai zaucna bam ni the,",
            "Alung khou neihlaa lu suan bam ni."
          ]
        }
      },
