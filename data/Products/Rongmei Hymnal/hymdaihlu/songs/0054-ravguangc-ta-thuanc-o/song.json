            "1 Ravguangc ta thuanc o!",
            "Ravguangc ta thuanc o!",
            "Hym daic liangmeipu",
            "Ravguangc ta!",
            "Ravguangc ta thuanc o!",
            "Ravguangc ta thuanc o!",
            "Thuanc o, Damhmeipu",
            "Ravguangc ta.",
            "",
            "2 Ravguangc ta ping o!",
            "Ravguangc ta ping o!",
            "Hym daic liangmeipu",
            "Ravguangc ta!",
            "Ravguangc lat piu o!",
            "Ravguangc lat piu o!",
            "Piu o, Damhmeipu",
            "Ravguangc lat.",
            "",
            "3 Khrista ariw o!",
            "Khrista ariw o!",
            "Kauh liangmeipu",
            "Ravguangc Nac ta!",
            "Hosanna! kauc o!",
            "Hosanna! kauc o!",
            "'Riu o, nangniw Guangc",
            "Khrista ta.",
            "",
            "4 Kazanc ’thanmei ta",
            "ning ’thukna thuanc o,",
            "’Thanmei zanc ta kungcna",
            "thuanc o;",
            "Kazanc hym daic diu!",
            "Kazanc hym daic diu!",
            "Ringhbamv pu Jisu ta",
            "thuanc o."
