        "language": "rongmei",
        "title": "Himdai kandiu pou Jisu jan",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Himdai kandiu pou Jisu jan,",
            "Kandih le tingkauh khou;",
            "Banchranun Raguang kalummei,",
            "Seitan pinga kadun.",
            "",
            "Chorus:",
            "Akhang ntang mak tuang makge,",
            "Baimei ta kahao mak....",
            "Khrista akhang theimei biu the,",
            "Akhang %&6 thei tuang e.",
            "",
            "2. Pap phungmei nun khang khrista thei,",
            "Gai makmei nun phan thei;",
            "Nuan guaina khangh lou ngam kan the,",
            "Neilamei tilin the.",
            "",
            "3. Karam jian hei tithai lik go,",
            "Thuak patmei ndao o;",
            "Ai %&6 ranimei chamdin kiu,",
            "Laujiu Nah pari e.",
            "",
            "4. Neilana kajan ndaoni,",
            "Apanti nai bam khou;",
            "Mei guaina khou ra ndaoni,",
            "Laujiu Nah pari hei."
          ]
        }
      },
