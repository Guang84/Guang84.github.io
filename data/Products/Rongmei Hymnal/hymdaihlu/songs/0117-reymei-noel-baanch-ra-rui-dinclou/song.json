        "content": {
          "format": "source-lines",
          "lines": [
            "1 Reymei Noel, baanch’ra {:1 dinclou,",
            "Lauziu gaenghmei nunc laupuk khou aliau bam khou,",
            "Lauziu gaekna bammei laupuk khou,",
            "Tingsikmei tingsei zingbangc rimh rimmei ganv khou.",
            "",
            "Noel, Noel, Noel, Noel!",
            "Isreal mei Guangc kiu puanc the.",
            "",
            "2 Neihpat biak thangc Gaanphiu how khwan e,",
            "Duhmei neihpat biak thangc kariw 1<: gaanc bam e,",
            "Kariw kandih khou tiigaanc key e,",
            "Hei 1<: kumc zingbangc, kalaanv tiigaanc key khwan e.",
            "",
            "3 Gaanphiu riw ta 1<: nzwan lana,",
            "Ningtyngmei nunc sangdiuh thangc {:1 phu guang khwan e;",
            "Guangh ta kaniw phu guangpui tuang e,",
            "Gaanphiu {:1 zayloupui bamv kathuic lay ’zwanna.",
            "",
            "4 Neihkei biak thangc gaanphiu 1<: guang the,",
            "Bethlehem namv ruc khou hei 1<: ’thaekclou khwan e,",
            "Khou 1<: guang tangc pwkhou ding kan the,",
            "Jisu ta nzilou bammei kaanv ruc khou 1<:.",
            "",
            "5 Ningtyngmei nunc kainung khou gut the,",
            "Khuksun keyna Jisu ta kaniw kalum the;",
            "Kaniw kaipat kathumh katlou the,",
            "Kaipat 1<: kachaekc, mwndui lev ’gaw 1<: khwan e."
          ]
        }
