        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Chu lo, ryanramei thiu, Poubauhmei kaw e:",
            "“He puatrith phunghmei thiu, Akhou guang ’thaekc go,",
            "Guang tho, nyan bam ri tho,",
            "Ai phungclou pumc e,",
            "Nang puatrith, dwanman guay",
            "Akhou phungc guang o.”",
            "",
            "“A .. khou guang o, zaeng ..",
            "tii ’thaekclou ni;",
            "A .. puat hei nang phungc o,",
            "A .. lat hei piu o;",
            "Ai lungh niamhmei pu e,",
            "Angamv ta lwm o:",
            "Guang o, Athiak chiw e,",
            "Apuat hei ’thaan e.",
            "",
            "2 Nang lung kwn tuang maekna",
            "maeng tat bam tu cho,",
            "Lwmsii, dwan manhmei >|3",
            "nang puatrith swna?",
            "Mphuammei lungning >|3",
            "sw kaguakc bu cho?",
            "Phungc guang o Jisu khou",
            "zaeng tii’thaekclou ni.",
            "",
            "3 Paapc >|3 zinghmei chyng",
            "khou kalanv-kalowna,",
            "Maikwam maikhunc biak thangc",
            "’zwan tat bam tu cho?",
            "Paapc ngamv >|3 rairiuna sw",
            "kaguakc bu cho?",
            "’King o, Lauziupouc khwan,",
            "“Akhou guang ’thaekc tho.”",
            "",
            "4 Nthiammei >|3 nang ta ngam",
            "katup bu cho?",
            "Nang ’suanmei lwnlung khang",
            "ryanra bam tu cho?",
            "Khrista sw ’thanlou ni nang",
            ">|3 ney tithei;",
            "Bumaengh ’Thanmei khou",
            "zaeng tii’thaekclou puni."
          ]
        }
      },
