        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neihkhyam keyna zingc key the,",
            "Kalaanv, zingbangc ramnav the,",
            "Tingpuk khou maibungc pang !}2",
            "Gaancna bam khou hei aniu",
            "Kalum di kho.",
            "",
            "’Thanmei, ’Thanmei, ’Thanmei Kaipouc Ravguangc,",
            "Tingkauh lev dih khou lik ge,",
            "Kauh lev dihmei !}2 thuanc e,",
            "Kauh liangmei Guangc.",
            "",
            "2 He Ringhmeipu, Poubauhmei,",
            "Nang kainung tingpuk bangc khou",
            "Nang ta phumei guay guang e,",
            "Nang pamv khou ’zwan guang bam e,",
            "Gaeklou na ro.",
            "",
            "3 Zingc ranv khith khit key khou hei,",
            "Nang zaw ta ’kamhlou bammei",
            "Gaanchuangc ta samc rii kuna",
            "Aniw lungchwn Nang pamv khou",
            "’Zwan guang pw the.",
            "",
            "4 ’Niw mikzaw khou !}2 ’maan diu,",
            "Kalaanv, zingbangc gaanchuangc guay;",
            "Baanch’ra Kaipouc ’niw mik khou",
            "Tingsaeng lauthwan tiilou o,",
            "Zinghmei ’maan diu."
          ]
        }
