        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu hei Amuh Daihmei e,",
            "Zauzian daihmei Amuh e;",
            "Suhmei naumei tiigaylou e,",
            "Huayneymei guay tiilou e.",
            "",
            "Ramh kaguayna Kaipouc e,",
            "Ramh kaguay ta damclou e;",
            "Katuang nzav tuang maek ge,",
            "Guhsw-gahsw mak ge.",
            "",
            "2 Aniw pangc khou guang bamlou o,",
            "Luihmakmei kaibangc khou hei;",
            "Ringhpui baanc >|3 kahilou o,",
            "Aniw huayney bam khou hei.",
            "",
            "3 Bumaengh ’naumei tiigaylou e,",
            "Lungning pumtan tiitanclou,",
            "Ryanramei lung tiineihlaalou,",
            "Lunglaihpuimei paap kuaklou.",
            "",
            "4 Tingkauh kaidai guang tangc pwkhou,",
            "Aniu kata how pwkhou,",
            "Kabamvpaeng hu khou lu suan ni,",
            "Jisu zanc ta thuanc bam ni."
          ]
        }
