        "content": {
          "format": "source-lines",
          "lines": [
            "1 Aramrianra guay Jisu khou pou ni,",
            "Araana puatrith hei phungc ngam mak;",
            "Arianra guay Kamei ’khavlou puni,",
            "Nzian taek makna kadanlou e.",
            "",
            "Suai makna Jisu khou ai poulou ni!",
            "Araana ryanra ’khaengv ngam mak ge;",
            "Suai makna Jisu khou ai poulou ni!",
            "Jisu ’khavlou ngam, Jisu na de.",
            "",
            "2 Katuakcmei ganv khou Jisu khou pou ni,",
            "Kamei zianthaymei Duangda kiu e;",
            "Poulou rap ti thei Kamei thuaklou ni,",
            "Katuakcmei guay tii ’maanlou puni.",
            "",
            "3 Tiangchanhmei ganv khou Jisu kage nai,",
            "Arianra phungcloumei Kamei e;",
            "Suai makna Jisu khou ai poulou ni,",
            "Apuatrith guay phungc ’khavlou puni.",
            "",
            "4 Siimei taanc diu khang mbaanv _>6 ’thiam e,",
            "Paapc taanc diu khang alung ta ’thiam e;",
            "Jisu _>6 ata nkhavlou puni,",
            "Mbaanv ngamv ta rih ngamlou puni."
          ]
        }
      },
