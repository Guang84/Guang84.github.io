        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu Nang rih ngammei ramzian,",
            "Alung khou bunlou o,",
            "Khou kiu alung tarai lak khe,",
            "Ravguangc khou bam ’tip ni,",
            "Ravguangc khou bam ’tip ni.",
            "",
            "2 He ’Thanmei Mai, alung khou hei,",
            "’Taw hei gut chuangclou o!",
            "’Twn makmei khei kau ’thanlou o,",
            "Siimei tiimaanlou o,",
            "Siimei tii’maanlou o.",
            "",
            "3 He Pentikos nungc keymei pu,",
            "Paapc guay kau ’thanlou o,",
            "He chuangc bammei Bumaengh ’Thanmei,",
            "He Bumaengh guanglou o!",
            "He Bumaengh guanglou o!",
            "",
            "4 Sw-’thanmei Mai, tiigaanclou o,",
            "Nang ramring tiilou o,",
            "Natnw kathuic zinliklou o,",
            "Kapwm sw ’thanlou o,",
            "Kapwm sw ’thanlou o.",
            "",
            "5 Kadyng dingmei alungning hei",
            "Kalung dat zat lak khe,",
            "Khrista paan )}3 alungsyng khou,",
            "Zianmei padik pwkhou,",
            "Zianmei padik pwkhou."
          ]
        }
