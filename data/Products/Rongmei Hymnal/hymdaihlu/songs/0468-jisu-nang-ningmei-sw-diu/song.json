          "format": "source-lines",
          "lines": [
            "1 Jisu Nang ningmei sw diu!",
            "Nang chwn 8^& achwn sw diu!",
            "Zian thaymei Nang baancpav khou",
            "Atun guay bowlou the.",
            "Ryanra neihlaamei guay ^&8",
            "Nang daeng zay guang tuanclou o,",
            "Ata ’saa khang ’khavlou o,",
            "“Pou, Nang ningmei sw diu!”",
            "",
            "2 Jisu Nang ningmei sw diu!",
            "Mikdui keymei ’riw sihni,",
            "Amachunc tiikamvlou riu,",
            "Mi 8^& tii’maanlou riu,",
            "Dih khou Nang kaplou khwan e,",
            "Ryanra azuh ’khaengvlou e,",
            "Nang lev kap ’chamc khang ethei",
            "“Pou, Nang ningmei sw diu!”",
            "",
            "3 Jisu, Nang ningmei sw diu!",
            "Mi 8^& akhang gay liang e;",
            "Thei thangc guang nimei guay hei",
            "Nang khou ai ngangvlou the;",
            "Tingkauh akai biak zaucna",
            "Lwmgayna ai tat ni the,",
            "Theic nic ringc nic ai suan e,",
            "“Pou, Nang ningmei sw diu!”"
          ]
        }
