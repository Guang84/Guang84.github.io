        "content": {
          "format": "source-lines",
          "lines": [
            "1 He bumaengh, nang ryanra lak bu cho?",
            "Gaanhmei how makna bam tu cho?",
            "Khrista ta zauhmei khang gaanhmei nai e,",
            "Padikmei, duakmei panty nai!",
            "",
            "Jisu ta nang mik zauc o,",
            "Ch’rynmei Kazawpaanv mating o;",
            "Kahu khou kandih puat guay kamv puni,",
            "Hym gaanhmei, zauzian zawpaanv riw khou.",
            "",
            "2 Theihmei khou )}3 tingsaeng ringhmei khou",
            "Kamei gut kumc ’niu nic gut re;",
            "’Niu ruc khou paapc )}3 zyn ngam dat lak khe,",
            "Ngammei nunc suangc ’niu ngammei e!",
            "",
            "3 Kalat suai mak ge twna ’rianhlou,",
            "Lwm o, ramh guay gay ngam puni;",
            "Kum ethei theic bammei nunc khou tat tho,",
            "Katuang ringcbamv chamv dinclou tiu!"
          ]
        }
      },
