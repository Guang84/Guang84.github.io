        "content": {
          "format": "source-lines",
          "lines": [
            "1 Saa ngam makmei siimei naimei nzaengc khou punic,",
            "Neihriw naipui bamv khou chuzaenghna ai bam punic,",
            "Zingc punic, gaanc punic, ai ramh khat na thay e,",
            "Jisu tat ’chamc ethei kabamv ’thuic tat ni.",
            "",
            "Jisu ’duanghlou ’thei ai tat ni, kabamv ’thuic,",
            "Tabui khou punic Jisu ’duanglou ’thei tingkauh di the,",
            "",
            "Khou hei san-gaymei khang chak ge Kakros phunghmei,",
            "Jisu ’duanghlou ’thei ai tat ni kabamv ’thuic.",
            "",
            "2 Ringhmei lat dinc tat khang ata kawlou ’khwan ethei,",
            "Sypungram tat kaanna paapc )}3 zynpui bamv thangc 3)^,",
            "Kachuangcphey daanc tat khang asan khou nai khwan ’thei, tat ni.",
            "",
            "3 Gaanv saekc )}3 ryanrana duipui paengc thangc tat bam khou,",
            "Ai thu kai khou bam khang asan khou nai khwan ethei,",
            "Kalatzan khou lwmmei Kakhou ndauhlou ni,",
            "Kamei bam ’chamc ethei kabamv ’thuic bam ni.",
            "",
            "4 AKaipouc latzan ta thanv bam khang athouc hamh e,",
            "Kalat )}3 zayloumei suihmei hei athouc kiu the,",
            "Tat punic, bam punic, tabui bui khou punic,",
            "Kaipouc lev bam ’chamcna lungh kimna bam ni."
          ]
        }
