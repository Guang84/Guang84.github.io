        "content": {
          "format": "source-lines",
          "lines": [
            "1 Gaymei ric ’dow tho, ngamv patna,",
            "Khrista hei nang pumtan kiu the;",
            "Ringhmei hei nang sin ’tip ethei",
            "Tingsaeng neihlaa pyrun sw ni.",
            "",
            "2 Rav zauzian khou lauluangc pak tho,",
            "Ngangc phaengc ku o, Kazawpaanv ta;",
            "Ringhmei lev chaeng ’niu hu khou nai,",
            "Khrista hei chaeng lev swan kiu the.",
            "",
            "3 Nang dwanman guay Kakhou lou tio,",
            "Karamzian #^7 ’khavlou puni;",
            "Kakhou lwmna nang ngangvlou tio,",
            "Khrista hei ringhmei, zianmei e.",
            "",
            "4 Ping riu, lak riu, Kamei ’naa bam,",
            "Kamei kalaih mak, zian bam de,",
            "Lwm rap ti thei nang thay puni,",
            "Khrista hei ramh guayna di the."
          ]
        }
      },
