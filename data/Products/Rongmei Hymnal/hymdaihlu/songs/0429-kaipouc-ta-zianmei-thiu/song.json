        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaipouc ta zianmeithiu,",
            "’Niu neihlaamei lyan kho;",
            "Lungh khat swna lu suan ’chamc kho, (2)",
            "Guangh bamvpaeng ding huamcna. (2)",
            "",
            "’Niu Zion ’zwan bam e,",
            "Gaychuymei, gay chuymei Zion!",
            "’Niu tat ku bam e Zion thangc,",
            "Gaychuymei Ravguangc kaidai thangc.",
            "",
            "2 Rav ta thay makmei ^&5",
            "Lu hei suan zih kan diu;",
            "Kum sic tingkauh Guangc nac nunc hu (2)",
            "Kaniw neihlaa ’daw diu. (2)",
            "",
            "3 Zion luangcbut khou hei",
            "Suaihiam ’peyna nai e;",
            "Tingkauh laupuk guang tangh mak khou, (2)",
            "Kachaekc chaeng tat mak khou. (2)",
            "",
            "4 Neihlaana lu suan kho,",
            "’Niu mikdui thut phui kho;",
            "Immanuel dih tat kaanna, (2)",
            "Tingkauh ramc ’zwan bam khou. (2)"
          ]
        }
      },
