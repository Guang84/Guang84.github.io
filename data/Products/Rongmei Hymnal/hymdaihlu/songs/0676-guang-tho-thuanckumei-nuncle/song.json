          "lines": [
            "1 Guang tho, thuanckumei nuncle,",
            "Lau tay guangmei lu suan kho;",
            "Phuling guay khuam guanglou the,",
            "Tingsei ganv 0({ guang mak khou;",
            "Damcloumei pu Racguangc ({0",
            "Kage naimei guay tiilou,",
            "Guang tho, Ravguangc kai khou hei,",
            "Lau tay guangmei lu suan kho.",
            "",
            "2 Dih hei Ravguangc laupuk ge,",
            "Phuling guay hei Katuang e;",
            "Nap lev napriak thau ’chamc e,",
            "Ryanra, neihlaa kariu e;",
            "Kanuy, kapwang pat rey e,",
            "Hei tangv kathai nthai e;",
            "He lau Kaipouc, ’niw huay e,",
            "’Niw hei ’takmei thai sw khang.",
            "",
            "3 Kaipouc Ravguangc guang pw the,",
            "Katuang napthai khuam guang khang,",
            "Hei nungc kiu Kalaupuk khou",
            "Napgung guay hunc ganc puni;",
            "Baanch’ra nunc ta langlouna",
            "Napriak guay mai thou puni;",
            "’Takmei thw guay khuam guangna",
            "Kasaamc khou rylou puni.",
            "",
            "4 Amen! guang ’khap tho, Kaipouc,",
            "Nkhamvmei lautai tay khang!",
            "Nang mei guay ta khuamlou tho,",
            "Paapc lev ryanramei duak khang;",
            "Khou kiu tingsaeng sw ’thanna",
            "Nang hu khou tingsaeng lungh khang,",
            "Guang tho, Nang baanch’ra nunc lev",
            "Hymdaih lau tai lu suan khang."
          ]
        }
