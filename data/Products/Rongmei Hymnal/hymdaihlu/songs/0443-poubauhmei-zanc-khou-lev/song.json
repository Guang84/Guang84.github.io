        "content": {
          "format": "source-lines",
          "lines": [
            "1 “Poubauhmei zanc khou lev",
            "Kangamv khou nang tanc o!”",
            "Kalat khou ’chumhmei khang ding ’tip bam o;",
            "Rih tanhmei bamv khou <~1",
            "Kamei nang ta gaeklou ni,",
            "Poubauhmei zanc khou nang rih ngam puni.",
            "",
            "Ding ’tip bo, .. ’zihmei khang!",
            "Rih ngam tho, Guangh tuang latdanv paan <~1!",
            "Poubauhmei zaw sw khang lev",
            "Rih ngammei Kalat khang <~1",
            "Kaipouc tuang pumtan khou ding ’tip bo!",
            "",
            "2 “Poubauhmei zanc khou lev",
            "Kangamv khou nang tanc o!”",
            "Zauczihmei hu khou <~1 pak dat zat rio,",
            "’Zihmei khang nang ’dow khou,",
            "Kamei nang daeng dinglou ni;",
            "Kapumtan khou hu biak thangc tat gut tho!",
            "",
            "3 “Poubauhmei zanc khou lev",
            "Kangamv khou nang tanc o!”",
            "Kalatryan khat sihni suai zat mak ge,",
            "’Zihmei khang nang ’dow khou",
            "Kamei nang baanc zaylou ni,",
            "Kakhou lwm e thei nang ngam bapuni."
          ]
        }
      },
