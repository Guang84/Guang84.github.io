        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai hei ginpu khat re, gin ramc kandic khou hei,",
            "Akai thu duh thangc e, kachaekc kandi thangc 4@<,",
            "Ai hei dihkhynmei e, duipaengc",
            "thangc guanghdic tuang;",
            "AGuangc taanv khang ai bam tuang e.",
            "",
            "Ai phungc guangmei chamv kiu hei e,",
            "Baanch’ra nunc suan nimei chamv e,",
            "O, nang guat sa la tho,”",
            "Twna aGuangc saa e.",
            "\"Ravguangc khou nang guat sw la tho.\"",
            "",
            "2 Mi hei Guangh latdanv e,",
            "kabamv ’thuic meic guayna,",
            "Lunghlaicna ngalanc tho,",
            "siimei paapc phac khou @{4;",
            "Latpiumei guay tingsaeng",
            "Kamei lev guanghtu ni,",
            "AGuangc khang ataanv kiu hei the.",
            "",
            "3 Akai kachan diangc e, Sharon",
            "mwnpuang ’zaengc suangc,",
            "Ringcsuang, neihlaa suangmei",
            "kabamv ’thuic khou nai e;",
            "Khou4@< maansei nunc @{4 gut",
            "nuhpui thiak dinh khang",
            "AGuangc @{4 ata thouclou e."
          ]
        }
