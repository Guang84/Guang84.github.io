        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang ta thuanc e,Guloumeipu,",
            "Nang zauzian tiiloumei khang;",
            "Gulou, khiu ’than, tiipadiklou,",
            "Ai Nang tuang duichaeng sw khang.",
            "",
            "Duichaeng na de zianmei Kaipouc,",
            "Ki ch’rynmei Nang ngamvguay 5^&",
            "Tiiluangclouna Nang piulou o,",
            "Tingmik ’thuic kaganv ’thuic khou.",
            "",
            "2 Bun ganclou the, tiipadik khang,",
            "Nang khang ’thanmei buangc sw khang,",
            "Ngamv maek ge, Nang tiimei",
            "hamhna,",
            "Latdanv kathuic piu biuh khang.",
            "",
            "3 Sakhi sw nii Nang guloumei,",
            "Paapc khou ^&5 tiiduakloumei;",
            "Ata liulou Nang sin sw khang,",
            "Pou, gut bam padiklou tho.",
            "",
            "4 Nang Bumaengc tiipadiklou o,",
            "Katgutmei ’niw lung khou hei;",
            "Ringhmei dui 5^& duiriang kumcna,",
            "’Niw lung khou ^&5 luangc bam khang."
          ]
        }
      },
