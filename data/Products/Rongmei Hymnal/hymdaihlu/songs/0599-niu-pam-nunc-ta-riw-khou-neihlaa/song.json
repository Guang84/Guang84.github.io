        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Niu pam nunc ta ’riw khou neihlaamei",
            "Asaanh mak kumc ning e;",
            "Tiki zaengsiimei chwn 5#^ guang e,",
            "’Niu ’tamv nipui ganv khou.",
            "",
            "Saa dat lak khe “Saalam” kauh thangc,",
            "’Niu saa lak khe “Saalam”",
            "Neihlaamei, gaymei dic thangc 5#^,",
            "Saa dat lak khe “Saalam.”",
            "",
            "2 Adikamv neihlaamei machunc cho,",
            "Zianmei khat theic pwkhou,",
            "Kandih taanvruai hei ’niu luai pwkhou",
            "Kaniw lev lungcsuang ni.",
            "",
            "3 ’Tamvmei lat hei saa dat zat lak khe,",
            "Gay chuymei tingkauc khou;",
            "Neihlaa, chuzaengh, zaenggaymei lu 5#^",
            "Tingsaeng ’niu suan bam ni."
          ]
        }
      },
