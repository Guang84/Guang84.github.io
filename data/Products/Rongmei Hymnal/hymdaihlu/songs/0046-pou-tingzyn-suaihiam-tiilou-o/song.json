        "content": {
          "format": "source-lines",
          "lines": [
            "1 Pou, tingzyn suaihiam tiilou o.",
            "’Niw bumaengc zaeng sw mak khou,",
            "’Niw paap guay Nang khou kalauh e,",
            "Kuaklou khang, tiigaylou khang.",
            "",
            "2 Theic nuhmei lwnlung padik ge,",
            "Sauhpailu samc kaan bam e,",
            "Nang baanch’ra nunc gaeklou bam e,",
            "Nang ’naa bam khou ’niw duak ge.",
            "",
            "3 Zingbangc hei zingc ranv hak sihni,",
            "Zinghmei ({0 nkamh ngam mak,",
            "Nang thu lak zat makmeipu e,",
            "Nang mei nunc ta gaek bam khou.",
            "",
            "4 Aseic zingbangc theic nangc sihni,",
            "’Niw laeng hei t’rou guanh sihni,",
            "Kauh lauthwan khou tiithaulou ni,",
            "Theic dat lakmei pwan piuna. Amen."
          ]
        }
      },
