          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 He, Kaipouc Nang hu khou khuksun key e;",
            "Nang latryan khou ngangvlouna ai huay bam;",
            "Ata sw ’thanlou o, ntaw hei khiulou o;",
            "Paapc guay khiu ’thanlou o, Jisu akhang.",
            "",
            "2 Alung laihmei mikdui luangc key bam e,",
            "Ai lwmlou thay diu khang ’khavlou na ro,",
            "Ai kahaw e Nang ta, mi hei amachunc e;",
            "Jisu akhang theiclou, Jisu akhang.",
            "",
            "3 ’King o, zianmei lat, niamh gayna keymei,",
            "Kauh thangc >|3 chulou the, ai >|3 huaymei;",
            "Lwmsiimei guay ’maan the, tanhmei lung sw bak the,",
            "Ai Nang khang na di the,",
            "Jisu akhang.",
            "",
            "4 ’Taw nganv Nang hu khou khuksunna bam e,",
            "Nang latryan khou ngangvlouna ai huay e,",
            "Lwmmei paan ai guang e, mi hei ai lwmmei e:",
            "Jisu akhang theiclou, Jisu akhang."
          ]
        }
      },
