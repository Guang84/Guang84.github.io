        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tingkauh Guangc tuang chuangc- phey daanclou khang tii the,",
            "Guangh tuang ric mei nunc daanh khang,",
            "Gaymei chuangcphey hei aseic ’niu zay thau the;",
            "Aniu lu suanna bam khou.",
            "",
            "Ruan tat kho! ruan tat kho!",
            "Khrista khang ramh guay ganc pat kho;",
            "Kakhou Guangh pyrun .. runlou khang,",
            "Taanc kho kros chuangcphei bangc khou!",
            "",
            "2 Zauczihmei @<4 dui daih kumcdinghaengv sihni,",
            "Chuanghphei 4^& zay kauh thau o!",
            "Kaipouc ricmei suna chuangh bangc khou bamna,",
            "’Chumhmei khang baucna ding kho!",
            "",
            "3 Dih lev duipui khou, meic lunghpui bamv ’thuic khou,",
            "Hymdaihmei chamv tiithay kho:",
            "Haengcringhmei chuangcphey p’ry hei ’taw dinclou kho,",
            "Kaipouc @<4 meic khuam bam khou!",
            "",
            "4 Hymdaihmei tingmik pat nimei ’naa guang the,",
            "Neih khat neih khat ’naa guang the;",
            "Zauczihmei guay ’niu Guangc hu khou ’maan puni;",
            "Kros @<4 kandih ta ngam ni."
          ]
        }
