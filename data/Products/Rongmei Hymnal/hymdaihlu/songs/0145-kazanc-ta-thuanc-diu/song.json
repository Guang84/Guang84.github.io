      "rongmei": {
        "language": "rongmei",
        "title": "Kazanc ’ta thuanc diu",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Thuanc o, kauh thangc guanghtu bammei,",
            "Ngamp’rymei Racguangc ta;",
            "KaNac ta theih khang tiipat re,",
            "Meic nunc ta thuaklou khang.",
            "",
            "",
            "Kazanc ta thuanc diu! Kazanc ta thuanc diu!",
            "Poubauhmei zanc thuanhmei sw diu!",
            "Kazanc ta thuanc diu! Kazanc ta thuanc diu!",
            "Poubauhmei zanc thuanhmei sw diu!",
            "",
            "2 Kazanc hei kauh liangsingmei e,",
            "Kauh hay hay ku bam e;",
            "Pu Ravguangc baanzat khou bam e,",
            "Baanch’ra nunc ^&8 bwan e.",
            "",
            "3 Guloumeipu, maansei nunc hei",
            "Paapc khou ’maanna bam khou,",
            "Ringhmei chaeng Nang ^&8 kasiamhlou,",
            "Kaniw khang theiclouna.",
            "",
            "4 Kazanc Chamloumeipu kaw e,",
            "Chuzaenghmei Guangc Nac e,",
            "Rih ngammeipu guanghdic guay ta",
            "Tingsaengzaeng sin puni."
          ]
        }
      },
