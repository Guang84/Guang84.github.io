        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ndiulou the nang ta laupuk khou taanh khang,",
            "Kaphydam maek, zianlou thaylou makna,",
            "Mphut luhmei, sinnui, malaamei ’khaengv khang,",
            "Thouclou tu the, Akhang ryanra ’khaengv khang.",
            "",
            "2 Ndiulou the lungh bak, zamv suhmei ding khou,",
            "Mikdui keyna, lakna siamruai sw khang,",
            "Ryanra lakmei kandihmei puatrith phungh khang,",
            "Thouclou tu the Azaeng ryanra ’khaengv khang.",
            "",
            "3 Ndiulou the chwn karumna, machunhna,",
            "How dat makmei zianmei nunc ta ningna,",
            "Kailau, riangluaih, pamrai guay ganclou duh khang,",
            "Thouclou tu the Aramzian na thay khang.",
            "",
            "4 Ndiulou the kahawmei guay ganclou khang,",
            "Ningmei, tamhmei, machunc guay ganclou khang,",
            "Howmumei ta zianna, lakna taanv sw khang,",
            "Thouclou tu the nang panty ’zuklou khang.",
            "",
            "5 Ndiulou the lungning tanhmei nunc ding khou,",
            "Karaengmei !}2 miktiat bammei pangc khou,",
            "Daeklou makna, zei keymei nganv tiipat khang,",
            "Thouclou tu the Kalvari thukh thay khang.",
            "Pu !}2 Ata thouclou kumc",
            "Nang ta thouclou the."
          ]
        }
