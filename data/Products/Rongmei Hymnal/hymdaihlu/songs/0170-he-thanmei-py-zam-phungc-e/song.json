        "content": {
          "format": "source-lines",
          "lines": [
            "1 He ’thanmei py, zamv phungcna",
            "Ryanrana ’bum key the;",
            "Adih malaana runlou",
            "Sauh !}2 pyrun swna!",
            "Suc langvna Nang zaw ’dav the,",
            "Rairiuloumei zamv !}2!",
            "Lauthwan kumhmei zawpaanv 2^<",
            "’Kumhna kamv key tu cho!",
            "",
            "2 He ’thanmei py, ’taw nganv hei",
            "Adih hym daic khwan cho!",
            "Zeikouh raana khwan sihni",
            "Ai thu akhang sw ni;",
            "Nang rianra, Nang ramzian 2^<",
            "Paapc mei khang gaengmei e;",
            "’Khuaimei kiu ai hei dyng the,",
            "’Ki Nang zamv suclou the.",
            "",
            "3 Bui latkaeng !}2 ai thuanc ni,",
            "He Poubauhmei, Nang ta,",
            "Theihpui nganv ryanra ’khaengvna",
            "Nang zianloumei khang hei?",
            "Pou, ata tingsaengzaeng khang",
            "Nang khang na swlou tho:",
            "Theicloumei Nang zauzian ta",
            "Ai tiizak dat lak khe."
          ]
        }
      },
