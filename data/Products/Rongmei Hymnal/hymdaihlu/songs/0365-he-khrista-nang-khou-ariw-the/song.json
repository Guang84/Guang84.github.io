        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Khrista, Nang khou ariw the,",
            "Hei saan ai phu guangmei,",
            "Bumaengc neihlaamei, chuzaenghmei;",
            "He Pou, Nang khou na nai.",
            "",
            "Khrista na #^5 lungh tiikim e!",
            "Zanh baihmei maek akhang,",
            "Zianmei, ringhmei, neihlaa suangmei,",
            "Jisu khou na nai e.",
            "",
            "2 Neihlaa, zaengthaek ai phu khwan e,",
            "Nang ta phu mak khwan e;",
            "’Ki Gumei pu khou guang pwkhou",
            "Karamzian #^5 ngam the.",
            "",
            "3 Bakmei duikhunc khou dui phu ki",
            "Khou5#^ dui maek khe, Pou!",
            "Zangv khang ’bum key’ki pak kan the,",
            "Ai kapmei ta nuic the.",
            "",
            "4 Neihlaamei ’maan khou kap khwan e,",
            "Nang khang kaplou zat mak,",
            "Zauzian #^5 mik tiiraklouna",
            "Nang ramgai how mak saanv."
          ]
        }
      },
