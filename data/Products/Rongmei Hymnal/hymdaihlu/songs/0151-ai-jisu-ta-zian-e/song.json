          "lines": [
            "1 Ai )}3 chu niimei zanc khat nai,",
            "Ai )}3 thuanc bam nii e,",
            "Mi 3)^ akhang lu gaymei e,",
            "Ndeih liangmei zanc e.",
            "",
            "Ai Jisu ta zian e,",
            "He ai adih zian cho!",
            "Ai Jisu ta zian e,",
            "Ata zian rey zaeng )}3.",
            "",
            "2 Gumeipu ramzian lam dinc e,",
            "Ai duak khang theicloumei;",
            "Kunghmei Kazei keyloumei 3)^",
            "Paapc mei khang ngangvbamv e.",
            "",
            "3 Apu )}3 tingmik ’thuic akhang",
            "Chamdaanvlouna bam e,",
            "Achanglwan hei zingcna bam khou",
            "Neihriw tiigaanclou e.",
            "",
            "4 Alungsyng thangc ryanramei ta",
            "Thay tangc ngammei pu e;",
            "Baihmei )}3 phungc ’khav ngam lakmei",
            "Aryanra phungc ’khavlou."
          ]
