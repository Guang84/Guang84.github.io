      "rongmei": {
        "language": "rongmei",
        "title": "HE BAKMEI, RAVGUANGC PHWAMLING",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 He bakmei Ravguangc Phwamling,",
            "Chwnchamh makmei phwam hei",
            "Latlu ^&8 swkow ngam the,",
            "Ringhmei, ’chumhmei, chaeng ta;",
            "Swangdwang maekmei kandic ^&8",
            "Nang ta zaucna bam e,",
            "He Khrista Gaychamv Phwamling",
            "Nang tabui saa ni cho?",
            "",
            "2 Zinghmei ngamv ^&8 taanv sw e,",
            "Zauczihmei rihmei kumc,",
            "’Twnmei, ’chumhmei, nzihmei,",
            "Rihpan biak ’dow guang the,",
            "Siimei ngamv ^&8 kandih ’thuic",
            "Meic guay ta zyn guang the,",
            "Ravguangc Phwamling pumtan khou",
            "Thau tho, nang dyng ding tho!",
            "",
            "3 Kalangv langv khaihmei ’thaekc tho,",
            "Agay-agi taan tho,",
            "Chuzaenghmei Guangc Nac Khrista",
            "Chuanghphey zay kauh thau o,",
            "Kaipouc, lwmmei, khat na de,",
            "Ravguangc khat na lwm e;",
            "Tat tho, Phwamling lungh ’chamh o,",
            "Kazanc khou rih ngam tho!"
          ]
        }
      },
