        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ramh khamv mak khe, Kaipouc lev akak khou,",
            "Hei kandih tuang ^&5 khamv tuang maek khe;",
            "’Patlou ngam the, paapc tuang thala kaguay,",
            "Jisu akhang! ramh khamvmei maek khe.",
            "",
            "Ramh khamv mak khe, Kaipouc lev akak khou,",
            "Suaihiam zawpaanv ai how bam nuh khang;",
            "Ramh khat ^&5 sihni",
            "Kasuaihiam ta khamv mak;",
            "Chaeng sw ’than the! ramh tii khamv mak khe.",
            "",
            "2 Ramh khamv mak khe, kandih thala ^&5 nic,",
            "Sii hak mak kumhmei lung-khei ^&5 nganv,",
            "Alung ta Kakhou ^&5 tii’tamv zat lak;",
            "Kamei di the! ramh khamvmei maek khe.",
            "",
            "3 Ramh khamv mak khe, gaengh sw liantiimei ^&5,",
            "Araana ^&5, pam-rai ^&5 khaam lak;",
            "Akhang kunghmei ’peyna ’riw pw sihni,",
            "Alung ding the, ramh khamvmei maek khe.",
            "",
            "4 Ramh khamv mak khe, nchanvmei geic sihni,",
            "Kandih pwm ata zauczih sihni,",
            "Huayneymei lev akhaengvthaymei paan ^&5",
            "Ai rih ngam ni, ramh khamvmei maekna."
          ]
        }
      },
