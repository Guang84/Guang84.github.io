        "content": {
          "format": "source-lines",
          "lines": [
            "1. Salem ram thang njuan di kho,",
            "Hu thang njuan tat ro;",
            "He poubaumei ta ai phuna.",
            "",
            "Chorus:",
            "He poubaumei tingsang ringmei neilamei,",
            "He tikei lou o he apoubaumei,",
            "Asei hei neila khang.",
            "",
            "2. Kandih rianra ram tuan pukhou,",
            "Lung geimei nai lak khe;",
            "Kanloumei puta hou pukhou.",
            "",
            "3. Ai thuan bam ni poubaumei ta,",
            "Panti ngan na thuan ni;",
            "Noupou pu lun ai hou mak san.",
            "",
            "4. Poubaumei #@8 jailou puni,",
            "Suaihiam mei poubaumei;",
            "Nang ban #@8 ata jai lou o."
          ]
        }
      }
    },
