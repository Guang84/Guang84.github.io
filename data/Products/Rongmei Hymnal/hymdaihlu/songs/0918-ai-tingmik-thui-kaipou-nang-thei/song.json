        "title": "Ai tingmik thui kaipou nang thei",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Ai tingmik thui kaipou nang thei lai tatni,",
            "Ai hei kaipou nang tuang e;",
            "Changkhou ai punkei bam khuansini nanghei,",
            "Akaipou sulou bam e.",
            "",
            "Chorus:",
            "Nthiammei puanjing ran guang pusini,",
            "Ting-nei sihguang sini ai nang tuang;",
            "Tingsangjang khang ai nangtuang suni the,",
            "Ai hei kaipou nang tuang e.",
            "",
            "2. Meinun +:1 karang jaojih guang khuansini,",
            "Ai hei kaipou nang tuang e;",
            "Champan guai ata ganlou du pusini,",
            "Ai hei kaipou nang tuang e.",
            "",
            "3. Kandih kabam thui khou ruantat bamsini,",
            "Ai hei kaipou nang tuang e;",
            "Ai thei ni ringni tabui guang pusini,",
            "Ai hei kaipou nang tuang e."
          ]
        }
      }
    },
