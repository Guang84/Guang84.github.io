          "format": "source-lines",
          "lines": [
            "1 Guloumeipu Nang pamv khou",
            "Ai zip keyna zaeng sw the,",
            "Amik tanguih key khou hei",
            "Achwn tiizaeng swlou o.",
            "",
            "Nang baanch’ra {:1 gaeklou diu,",
            "Ai zaeng swna zip pwkhou.",
            "",
            "2 Pou, maeng tanhmei alung hei",
            "Nang ta luicna lungc ngam khang,",
            "Siimei chwn guay tii’maan o,",
            "Apumtan tiiluanlou o.",
            "",
            "3 Ringhmei ting hei luai keyna,",
            "Neihkhyam keymei ganv uang khou,",
            "Duipui ai kaan pwkhou nganv,",
            "Nang khou ai bam ’tip bam ni."
          ]
        }
