        "content": {
          "format": "source-lines",
          "lines": [
            "1 Khristian thau tho zip ri tho,",
            "Gaanv saekc thu kapna bam khou,",
            "Kaipouc #^7 ndiu bam khou,",
            "Baanh ’suina dungc bam kho cho?",
            "",
            "Taanc tat ro, .. ’taw hei thau tho!",
            "’Maanmei ta .. phu khang tat ro,",
            "Zinghpui bamv .. paapc bamv khou #^7,",
            "Khwmkih bamv khou ’duangh guang o!",
            "",
            "2 Kaipouc zanc ta ’niu zian cho?",
            "Kalatryan ta ’niu lwm cho?",
            "’Niu tuang guay tii khang ding cho?",
            "Kamei saamei piu lak cho?",
            "",
            "3 Kata ’niu lwmgay di cho?",
            "Kamei saa kumc lungc bam cho?",
            "Aniu Katuang na di cho?",
            "Aniu taanv #^7 ndauh kho!",
            "",
            "4 Phungh mak nuh makmei kros nai,",
            "Pyrun run ni, ning ethei;",
            "Pumtan thanh khou thau di kho;",
            "Kaganv rau tingmik dui the."
          ]
        }
      },
