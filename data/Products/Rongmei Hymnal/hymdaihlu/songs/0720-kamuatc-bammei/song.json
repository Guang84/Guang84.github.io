        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kamuatc bammei duipui thangc",
            "^&8 kauc guang e,",
            "“Tiigaanc o! Tiigaanc o!”",
            "Zay kaanna gulou khang",
            "bumaengh guay kauc bam,",
            "“Tiigaanc o! Tiigaanc o!”",
            "",
            "’Niu dinc ni tingsaeng gaanhmei chamv hei,",
            "’Niu lungning lev baantan ^&8;",
            "Ravguangc khang hymdaihmei tii bam ni,",
            "’Niu Kalatdan piu bam ni!",
            "Tiigaanc o, Gaychamv lat gaanhmei 8^&!",
            "Tiigaanc o, kabamv ’thuic khou!",
            "Tiigaanc o, Gaychamv lat gaanhmei 8^&!",
            "Tiigaanc o, nganv dat makna!",
            "",
            "2 Mesidoniamei ramkau ’seic ’niu chu the,",
            "“Tiigaanc o! Tiigaanc o!”",
            "Neihlaamei aniu puatkat kros khou lou e,",
            "“Tigaanc o! Tigaanc o!”",
            "",
            "3 Meic guayna khou Jisu zauzian nai lik diu,",
            "“Tiigaanc o! Tiigaanc o!”",
            "Tingkauh thangc swan pyrun khang ’niu ’khuam bam khou,",
            "“Tiigaanc o! Tiigaanc o!”"
          ]
        }
