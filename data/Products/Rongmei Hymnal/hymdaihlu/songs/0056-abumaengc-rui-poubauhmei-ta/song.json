      "rongmei": {
        "language": "rongmei",
        "title": "Abumaengc rui Poubauhmei ta",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Poubauhmei, ch’ryn e, Nang ngamv ai ping e!",
            "Nang #<8 damhmei puat guay ta phu minc ki;",
            "Gaanchuangcna how, tingthimc ganh key khwan chu e;",
            "Mbaanv kapwm khou Nang ngamv lyanlou e!",
            "",
            "Abumaengc #<8 Poubauhmei ta thuanc e,",
            "Nang hei adih daic cho, ngam cho!",
            "Guloumeipu, aRavguangc ta thuanc e!",
            "Nang hei adih daic cho, ngam cho!",
            "",
            "2 Nwmding, ngouhding, phuaithingc ding khou tat ruan khou,",
            "Nruayna guay lu gaymei chu pwkhou;",
            "Luanghbut kauhmei twan khou #<8 ramvphaan bam khou,",
            "Duithuak khwan chu, ’pwan liu rih ri tow khou.",
            "",
            "3 KaNac, ’Pouh ta Ravguangc #<8 daeklou makna,",
            "Apaap zaeng khang theih khang ’diu key pwmei,",
            "Kros khou ryanra ’khaengvna akhang theicloumei,",
            "Makumh pwkhou ai ning tangc ngam thuy lak.",
            "",
            "4 Khrista hymdaicna keyna ata kai khou",
            "Phungc ku nungc kiu adih neihlaa puni!",
            "Kata thuancna ai kalum bam ni khou kiu,",
            "“ARavguangc, Nang adih daic cho!” kauc ni."
          ]
        }
      },
