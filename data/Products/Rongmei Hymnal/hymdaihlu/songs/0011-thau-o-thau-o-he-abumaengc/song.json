          "lines": [
            "1 Thau o, thau o! he abumaengc!",
            "Thuanc o, kauh Ravguangc ta;",
            "Suan thau o, nganv makpui lu 1<~,",
            "Thuakloumei zauzian lu!",
            "Kamei <~1 apaap phungclou the,",
            "Kros khou theiclou khou 1<~,",
            "Kazei <~1 liuna thuaklou the,",
            "Thuaklou sw ’thanlou the.",
            "",
            "Thau o, thau o! .. he abumaengc!",
            "Suan o, thuanc o, .. Kauh Ravguangc ta;",
            "Suan thau o, nganv .. makpui lu 1<~,",
            "Suan o, .. thuakloumei hei!",
            "",
            "2 Poubauhmei <~1 thuakpatlou the,",
            "Tingmik ’thuic gaeklou the;",
            "Thuakpatloumei zianmei pow 1<~,",
            "Ai khangc ngam thuy lak khe,",
            "Luih makmei akaipat laa khang",
            "Kazauzian tiilou e;",
            "Ravguangc zauzian daihmei paan <~1",
            "Ata zay guanglou e.",
            "3 Kalaih makmei kauhmei zauzian,",
            "Tingkauhmei nunc sihni",
            "Kasaanv, kadiat, kathukh thay mak,",
            "Nganv makmei zauzian ta;",
            "Mi zauzian <~1 dih ta guam e,",
            "Kauh kaidai padik ge,",
            "Tingsaengzaengna kanganv maek ge,",
            "Thuancku o, Ravguangc ta."
          ]
