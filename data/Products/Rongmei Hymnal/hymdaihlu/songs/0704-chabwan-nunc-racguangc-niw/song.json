        "content": {
          "format": "source-lines",
          "lines": [
            "1 Chabwan nunc Racguangc ’niw Nang khou",
            "’Niw lungning #<8 thuanhmei phungc guang,",
            "Akhyampui mung kathuic na khou,",
            "Aseic dou tuang ningting zuk khou;",
            "Chabwan Racguangc, Nang ’khavlou o,",
            "’Niw ’muc mak khang, ’niw ’muc mak khang.",
            "",
            "2 Pumh-gay zei-gay, phaay-baanh tancna,",
            "Tanc-bauhmei ta rili pwkhou;",
            "Gay ranvpui lanv 8}@ tiilou o,",
            "Sw ’kamh makmei, biangpiumei lung,",
            "Chabwan Racguangc, pumtan tii o,",
            "’Chumhmei taanh khang, ’chumhmei taanh khang.",
            "",
            "3 Akhyam rilimei dwan guay khou",
            "Pumtan lev ’khapmei phu pwkhou,",
            "Ranv dianghmei ringhting ric nai e,",
            "Khou8}@ pumtan kage nai khou,",
            "Chabwan Racguangc, katiulou o,",
            "Nang ningmei 8}@ ’niw taanc",
            "ngam khang. Amen."
          ]
        }
