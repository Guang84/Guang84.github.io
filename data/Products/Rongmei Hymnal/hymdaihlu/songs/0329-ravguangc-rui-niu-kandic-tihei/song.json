        "language": "rongmei",
        "title": "Ravguangc rui ’niu kandic tihei",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc #^5 ’niu kandic ti hei",
            "Heidi gayna damclou,",
            "Kalaanv zingbangc tiigaanclou khang",
            "Bw-neih, gaanchuangc damclou,",
            "’Ki bumaengh nunc maeng tat bam e,",
            "Zinghmei chaeng khou ruanna,",
            "Gumei pu ata piulou o,",
            "Zayloumei riw swna.",
            "",
            "Zayloumei riw swna",
            "Piulou o, Pou ata;",
            "Zianmei riw #^5 Nang hym dauh diu,",
            "Zayloumei riw swna.",
            "",
            "2 Meic ’peyna ta ’khavlou khang nai,",
            "Zianmei lat saalou khang,",
            "Zauzian daihmei ngammei Pam lam,",
            "Kaniw khou raclou khang,",
            "Nang khwan hei ai chu nuangc",
            "ngam khang,",
            "Piu ngam khang ’khavlou o,",
            "Ryanramei lungning khang ai hei",
            "Zayloumei riw sw khang.",
            "",
            "3 Gaanv saekc thu gaanh-kai kumc gaanc e,",
            "Gaanv saekc khuailiw mai kumc,",
            "’Ki ’niu Kakhang gaanc chuy ti thei,",
            "Meic guay ta kage nai;",
            "Kabumaengc #^5 tingmik machang",
            "Ata zaylou pw diu;",
            "Khou kiu ai hei biuh mak sihni",
            "Zayloumei riw sw ni."
          ]
        }
      },
