    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "’Kumhmei nac cho Meri pamv khou",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Kumhmei Nac cho, Meri pamv khou",
            "Zaeng swna zip bammei Nac hei,",
            "Baanch’ra nunc lu suanna",
            "thuanhmei,",
            "Lauziu gaengc bammei nunc khou?",
            "",
            "Mi hei Guangh Khrista e,",
            "Baanch’ra nunc thuanc",
            "bammeipu the!",
            "’Khap tho, guang kalum tho,",
            "Ngana, Ravguangc Nac",
            "Pouh ta.",
            "",
            "2 Bui zaeng hei di liwmei lwn khou",
            "Kiruai ding khou zip bam tu cho?",
            "Thaylou o, khwan pat mak sihni",
            "Paapc mei nunc ta huay bam e.",
            "",
            "3 Kachaekc, mwndui, ‘gaw phungc",
            "guang tho,",
            "Lungcgaymei, lungcsiimei guang",
            "tho;",
            "Guangh guay Guangc ringhbamv",
            "phungc guang the,",
            "Zianna Kata laalou tho!"
          ]
        }
      },
      "english": {
        "language": "english",
        "title": "What Child is This?",
