        "content": {
          "format": "source-lines",
          "lines": [
            "1 Greenland tuang gunh chyng khou @<4,",
            "India duitin khou @<4,",
            "Neih suhmei Africa tuang",
            "Sypungram guay khou @<4,",
            "Reynungc duithuak guay khou @<4,",
            "Tadanvbang ’zaengc khou @<4,",
            "Zinghmei khou @<4 gulou khang,",
            "’Niu ta kawna bam e.",
            "",
            "2 Mpwan aliu rih ri e,",
            "Shri langka pwkakdic,",
            "Ramv bamv guay how gay ngam e,",
            "Maansei na de siimei;",
            "Ravguangc kaipat heizumei",
            "Lyamlaihna tiilou the,",
            "Rav ta thay makmei nunc @<4",
            "Thing-’tauh ta kalum e.",
            "",
            "3 Gaanhmei laatowmei ’niu hei,",
            "Kauh ningting laa towna,",
            "Zinghmei khou bammei nunc khang",
            "Ringh riw tiigaanc lak cho?",
            "Ringhbamv chamv, ringhbamv chamv!",
            "Neihlaa chamv dinc lik go,",
            "Kandih tintou lunghmei guay",
            "Messaiah zanc thay diu!",
            "",
            "4 Aliu lik go, mpwanle,",
            "Duitin thuic Kap’ry hei,",
            "Dihpy, dihba, kabamv ’thuic",
            "Duipui kumc lik mak saanv;",
            "Paapc mei khang theicloumei pu,",
            "’Niu ruc khou guanghtu khang",
            "Thuakmei pu, Guangh, Damhmei pu",
            "Swna guang dat mak saanv."
          ]
        }
      },
