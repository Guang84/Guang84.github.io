        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai _>6 chu e, Guloumeipu kauh",
            "thangc _>6 keymei lam 6_>,",
            "Ai kumhmei ta thuakpatlou khang _>6, kalvari khou theiclou;",
            "Ai _>6 chu e, ryanrana kunghmei",
            "Kazei keyloucmei lam,",
            "Apaap khou _>6 ai lunghlaihna",
            "paapc ta rih ngamlou the.",
            "",
            "He rih ngam the! tingsaeng khang, Gumeipu Jisu paan,",
            "Gumeipu _>6 ata phuna zei _>6 thuaklou;",
            "Ata zianmei ai thay the,",
            "Zianloumei pow ai phungc the,",
            "Nthanmei Kazei paan _>6 ata",
            "rih ngamlou the.",
            "",
            "2 Ai _>6 chu e, tii’thanmei ngamvkhou _>6 tiigaymei lam 6_>,",
            "Kaphay baumei ta tiitatloumei, miktiatmei tiihowmei,",
            "Ai kauc khwan e, bakruap bammei alungh ta tiigaylou khang,",
            "Jisu guanglouna thuaklou the, ai rih ngammei sw the.",
            "",
            "3 Ai _>6 chu e, akhang kai gay Kamei _>6 chamdaanvloumei,",
            "Kangran gaymei duidai paengc",
            "thangc 6_>, kachaekc chaengluang lam nic,",
            "Ai _>6 chu e, baanch’ra guay lu lev thuakloumei p’ry 6_> nic,",
            "Neih khatpui tingmik khou kiu ai rih ngam lu suan puni."
          ]
        }
