    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Thow rui ringh hic chau ni",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Thow ^&8 ringh-hic chau ni, pwanzingh akhangvna?",
            "Bumaengh ’peyna ’lip bam, ’khavloumei maekna;",
            "Zauc lo, baanh kazaapcna kaudai kauc bam the!",
            "“ ’Khavlou o! ’niw ’maan the,” theih mak khou kan o!",
            "",
            "Thow ^&8 ringh-hic chau ni, thow zaucgaylou ni?",
            "Theic nimei bumaengc guay kanc khang thow tat ni?",
            "Thow ^&8 ringh-hic chau ni, duiluat chau tapna,",
            "Theic ping makna tatna bumaengh kan ni cho?",
            "",
            "2 Zauclo, taurung ding khou hih kaning bam the!",
            "’Khavlou ’khap mak ethei, theic ngam puni the;",
            "’Niu daeng khou duiluat ^&8 ’niu ta liak bin lak,",
            "Lwmnuhmei Hihpouc ^&8 hih hei chau bam khou.",
            "",
            "3 Zingc ranv hay hay guang the, diwsii zingbangc hei,",
            "Kasanv adaw gut tio, mairam daanc gaanc tio;",
            "Neihlaa chamv phungc gut tio, zeihlaa zingh thangc 8^&,",
            "“Hihpouc Khrista guang the, ’maanmei kanlou khang.”"
          ]
        }
      },
