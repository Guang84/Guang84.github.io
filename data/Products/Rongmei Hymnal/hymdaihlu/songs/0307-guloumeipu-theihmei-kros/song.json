        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guloumeipu theihmei kros bangc khou,",
            "Paapc khou ^&8 sw ’thanlou khang huay e,",
            "Alungsyng khou Kazei rimlou the;",
            "Kazanc hym daic diu!",
            "",
            "Kazanc hym daic diu!",
            "Kazanc hym daic diu!",
            "Alungsyng khou Kazei rimlou the;",
            "Kazanc hym daic diu!",
            "",
            "2 Paapc khou ^&8 ch’ryn sihna gulou the!",
            "Jisu alung khou bam chuy bam the;",
            "Ata laamei 8^& kros khou 8^& e;",
            "Kazanc hym daic diu!",
            "",
            "3 Adih kunghmei zei duipuakkai cho!",
            "Ai neihlaa sihna khou 8^& lup the;",
            "Khou 8^& Jisu ata sw ’than the,",
            "Kazanc hym daic diu!",
            "",
            "4 Zei puakkai khou hei nang guang la tho,",
            "Jisu pamv khou nang bumaengc guang tho;",
            "Lup tho, aseic sw ’than thiak la tho;",
            "Kazanc hym daic diu!"
          ]
        }
