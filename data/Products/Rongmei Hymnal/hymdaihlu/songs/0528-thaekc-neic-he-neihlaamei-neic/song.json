        "title": "’THAEKC NEIC HE NEIHLAAMEI NEIC",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Thaekc neic, he neihlaamei neic,",
            "He gaanhmei tingmikle,",
            "Ryanra tiikuakmei tingmik,",
            "He gay liangmei tingmik;",
            "Nang mei nunc @<4 Nang hu khou",
            "Khuksun keyna suan e:",
            "\"Thanme i, Thanmei, Thanmei e,",
            "Gaanv Thumh khat Ravguangc hei.”",
            "",
            "2 ’Seic hei daepc mei zaat guay khou",
            "Kauh manna tiikey e;",
            "’Thanmei Nang Phwamling guay khou",
            "Gaychamv lat @<4 kaw e;",
            "Tingkauh riw 4^& gaanc bam e,",
            "Kachan gaymei riw 4^&,",
            "Ringhmei duiriang luangc bam e,",
            "Tiikaluanmei dui 4^&.",
            "",
            "3 Suaihiam thanh thanh laatow e,",
            "’Thaekc neic tingmik khou hei;",
            "Lwmloumei bumaengc guay @<4",
            "Zaeng ’thaekc nimei maengc e;",
            "Khou kiu kauh ’thanmei guay lev",
            "’Niu nic hymdaic puni;",
            "Ch’rynmei p’ry 4^& lu suan e:",
            "Jisu ramzian p’ry 4^&."
          ]
        }
      },
