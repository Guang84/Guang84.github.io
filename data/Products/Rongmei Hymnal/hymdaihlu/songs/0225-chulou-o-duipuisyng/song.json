          "lines": [
            "1 Chulou o, duipuisyng",
            "’Thukmei ta gungcna,",
            "Thau reymei baansyam ta",
            "Tiiringc thaumei pu;",
            "Bumaengh ’Thanmei Nang {:1",
            "Ringhmei thiu tiilou,",
            "’Niw khou mbunlou o,",
            "Nang ta layluih khang.",
            "He gaanhmei lev ringhmei,",
            "’Niw khwan chulou o;",
            "Huayneymei lev thuanhmei",
            "Kariuna suan e.",
            "",
            "2 Muangh maekmei tingpuk khou",
            "Neihmik pat pwkhou,",
            "Nang ’naa bammei thay ni,",
            "He Bumaengh ’Thanmei;",
            "Gaanclou o, Nang riw 1<:,",
            "Muangh gummei maekna,",
            "’Niw hu khou ringhting hei",
            "Nang chwn khou lungh khang.",
            "",
            "3 Kalaanv neicrin kin khou,",
            "Rih tanc liang pwkhou,",
            "’Niw ta phungc kulou o,",
            "Gumeipu pamv khou;",
            "Khou 1<: ai duplou ni,",
            "’Niw taanv luai mak saanv;",
            "Khou 1<: rih adow ni,",
            "Rih hei ngam mak saanv.",
            "",
            "4 Neihkhyam key kan pwkhou,",
            "Chwn karum pwkhou,",
            "Zingc ranv khith khit pwkhou,",
            "Lungh ryanra pwkhou,",
            "Nang ramzian kadan {:1",
            "Tiigaanclou pw diu,",
            "Hymdaih riw souclou diu,",
            "Tingzyn tingpuk khou.",
            "",
            "5 Lauthwan, kalaanv, tingzyn,",
            "’Bui ganv khou punic,",
            "Nang khou {:1 chaengh ringhmei",
            "Tiilou o, ’niw khou;",
            "Tiiringc ngammei ramring",
            "Karamzian ramring,",
            "Theihmei tiiringc ngammei",
            "Kauh ramring tii o."
          ]
        }
