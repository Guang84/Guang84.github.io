        "content": {
          "format": "source-lines",
          "lines": [
            "1 Pou Ravguangc khou neihlaa ni cho?",
            "Chingkhiuh lanv 7?| chak go,",
            "Kalat khou lwmmei khou naimei",
            "Nganv makmei lanv chak go.",
            "",
            "Kuakloumei, .. chuzaengh lev ngamv",
            "Nthanmei lev .. paradais nai,",
            "Hei guay akhang .. Khrista paan ?|7",
            "Neihlaapui lu ?|7 Kata thuancku diu!",
            "",
            "2 Ravguangc zauzian paan kuakloumei",
            "Nsa na tiilou the;",
            "Kuakloumei paan chuzaenghmei hei",
            "Jisu zei paan akhang.",
            "",
            "3 Zauzian ?|7 paapc ngamv sw bak khang",
            "Pou ?|7 ngamv tiilou e;",
            "Bumaengh ’Thanmei ?|7 ’niu lung hei",
            "Paapc khou ?|7 sw ’thanlou.",
            "",
            "4 Bumaengh khuam guangmei ngamv 7?| nic",
            "Bumaengh ?|7 tiilou e;",
            "Pou Khrista tuang kaipat Kamei",
            "’Niu lung khou lungc bam e.",
            "",
            "5 Suaihiam guay hei ’niu laa tow e,",
            "Lwmsihsingmei paan ?|7;",
            "Ravguangc ?|7 neihlaana tii e,",
            "’Niu khou Khrista paan ?|7."
          ]
        }
