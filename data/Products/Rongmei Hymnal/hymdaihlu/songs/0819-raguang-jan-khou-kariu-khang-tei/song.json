        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Raguang jan khou kariu khang 1@:,",
            "Guango mei naimei guai;",
            "Jaujian loumei hei thuan ku kho,",
            "Neila pui lukhuan rui (2).",
            "",
            "2. Mei guai rih sukhang ping ri kho,",
            "Nthiampui rih tani;",
            "Aniu theimei ngan na dou kho,",
            "Seitan rihdai khou 1@: (2).",
            "",
            "3. Arup njianmei nun thiu le,",
            "Sup ping pinglou ri o;",
            "Aniu pumni bumang hei ni,",
            "Jisu rui gak lou ni (2).",
            "",
            "4. Aniu rianra rianriu sini,",
            "Tingkauh ram la puni;",
            "Khou 1@: Raguang rui ti puni,",
            "Tingkau pirun 1@: ni(2).",
            "",
            "5. Hei jang khou rui kamthao dikho,",
            "Seitan rih adou khang;",
            "Rihpi jan sanna lusuan kho,",
            "Hojam 1@: ni kao na (2)."
          ]
        }
      },
