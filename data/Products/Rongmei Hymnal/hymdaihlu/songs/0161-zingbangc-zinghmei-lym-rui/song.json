        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zingbangc zinghmei lym ?|7",
            "’Zaengc guay gum liam the;",
            "Tazik chikh chik khwan e,",
            "Ramh guay zip ngam the,",
            "Ryanra ’khaengvmei pu Khrista",
            "Mikdui, talanv, zei phiangc,",
            "Pikwan khou pun key khou,",
            "Ravguangc khou huay khou.",
            "",
            "2 Katuang khuay hamhmei khang",
            "Kata riaplou the;",
            "’Niu khuay zaeng khang Kamei",
            "Mikdui keylou the;",
            "Swmlou thaymei pam maek khe,",
            "’Khavlou thaymei maek khe,",
            "’Zaenghmei, niamhmei pu ?|7",
            "Huayney bam khou 7?|.",
            "",
            "3 APu, he APule,",
            "Nang ?|7 nuh ethei",
            "Ryanramei buangc na hei",
            "Ganclou khang huay e;",
            "Kum sic nuh mak ethei mu",
            "Nang Nac khat namei khou",
            "APu, he APule,",
            "Nang nyng swlou tho."
          ]
        }
      },
