          "lines": [
            "1 Thau tho, he ringhbamv nac nuncle,",
            "Khrista thei laymei nuncle;",
            "Seitaan Zion ta sin mak khou,",
            "Thau tho, he ngammei rihmei.",
            "",
            "Suan thau tho ngammei lu dai 4@<,",
            "Suan thau tho ngammei lu dai 4@<,",
            "Duipui khwan .. tingthimh kumcna,",
            "Khrista zei @{4 thuaklou khou @{4,",
            "Ngammei nunc suangc ’niu ngam e! (3)",
            "Khrista zei @{4 thuaklou khou @{4,",
            "Ngammei nunc.. suangc’niu ngam e.",
            "",
            "2 Reynungc bauhmei, ’thanmei nunc 4@<,",
            "Mi phaydyng khou ding ’tip the;",
            "Zauc lo, kaniw tuang",
            "chuangcphey 4@<,",
            "Jisu zei paan @{4 ngam the.",
            "",
            "3 Pingpui tuang maek ge, theic lak ge,",
            "Panty Khrista khou lou the;",
            "Kamei guangpui nungc lauthwan kiu,",
            "Hym duidaih kumc daic puni.",
            "",
            "4 Kahu khou ’niu ding nuangc ni the,",
            "Kaipouc ta ’niu how ni the,",
            "Neihlaana Kata thuanc ni the,",
            "Suan lana neihlaa ni the."
          ]
