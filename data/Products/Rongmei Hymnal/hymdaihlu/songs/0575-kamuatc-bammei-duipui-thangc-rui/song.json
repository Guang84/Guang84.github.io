        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kamuatc bammei duipui thangc ?|7 kauc guang e,",
            "“Tiigaanc o! .. Tiigaanc o!” guay kauc bam,",
            "“Tiigaanc o! .. Tiigaanc o!”",
            "",
            "Tiipat ro, .. Gaychamv lat gaanhmei 7?|!",
            "Tiigaanc o! .. kabamv ’thuic khou!",
            "Tiipat ro, .. Gaychamv lat gaanhmei 7?|!",
            "Tiigaanc o! .. nganv dat makna!",
            "",
            "2 Mesidoniamei ramkau ’seic ’niu chu the,",
            "“Tiigaanc o! .. Tiigaanc o!”",
            "Neihlaamei aniu puatkat kros khou lou e,",
            "“Tiigaanc o! .. Tiigaanc o!”",
            "",
            "3 Meic guayna khou Jisu zauzian nai lik diu,",
            "“Tiigaanc o! .. Tiigaanc o!”",
            "Khrista lungning kumhmei kabamv ’thuic nai diu,",
            "“Tiigaanc o! .. Tiigaanc o!”",
            "",
            "4 Nzianmei taanv taanh khou ’niu lak key rikho,",
            "“Tiigaanc o! .. Tiigaanc o!”",
            "Tingkauh thangc swan pyrun khang ’niu ’khuam bam khou,",
            "“Tiigaanc o! .. Tiigaanc o!”"
          ]
        }
      },
