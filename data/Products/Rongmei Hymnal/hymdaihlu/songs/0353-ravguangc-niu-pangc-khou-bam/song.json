    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Ravguangc ’niu pangc khou bam",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc ’niu pangc khou bam,",
            "Aniu Kata bwan kho,",
            "Chingkhiuhna Kahu khou guang kho;",
            "Ravguangc ’niu lung khou bam,",
            "Meic guay Kata ping o,",
            "Lungh niamhna Kadaeng khou guang kho;",
            "Kamei nunc Ravguangc ta",
            "Niamhna kalum kan diu,",
            "Panty guay katlou diu.",
            "",
            "2 Alung khou bamlou o,",
            "Meri khou kumc akhou,",
            "Nang lunghpui bamv tiiswlou o;",
            "Guang o, Bumaengh ’Thanmei,",
            "Tiikalaihmei Bumaengc,",
            "Apanty guay ai tiipat the;",
            "Ai tatloupui bamv ’thuic",
            "Nang hu khou ’bum keyna,",
            "Nang ta thayna bwan ni.",
            "",
            "3 Neihlaana katlou the,",
            "Kandih tuang syanlanv guay,",
            "Gaengh swmei lev paapc thala guay;",
            "Tingsaeng Nang tuang sw khang",
            "Neihlaana katlou the,",
            "’Niw bumaengc lev ringhting guay hei;",
            "Nang ta na thay ni the,",
            "’Niw natnw guay Ravguangc;",
            "Nang khang na lungc ni the. Amen."
          ]
        }
      },
