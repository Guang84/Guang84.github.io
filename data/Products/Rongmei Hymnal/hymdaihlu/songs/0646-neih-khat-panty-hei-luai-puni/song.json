          "lines": [
            "1 Neih khat panty hei luai puni,",
            "’Taw suanmei lu suan ’thaekc puni,",
            "’Ki ai zip ’chyang thaupui nungc kiu",
            "Kauh thangc adih neihlaa ni cho!",
            "",
            "Ai how puni, .. Kaipouc zawpaanv,",
            "Zauzian paan guloumei thuanc ni,",
            "Ai how puni, .. Kaipouc zawpaanv,",
            "Zauzian paan guloumei thuanc ni.",
            "",
            "2 Neih khat bow ni kandih kai hei,",
            "Adih zaic ni, ai thay mak ge,",
            "’Ki ai thay e, aKaipouc _>6",
            "Kauh thangc bam chamdaanvlou bam e.",
            "",
            "3 Neih khat kachaekc neic key pwkhou",
            "Pou _>6 akhou saalou puni,",
            "“Taanc chuy dyng the, gaymei bangcle!”",
            "Kazaengthaek khou ai gut puni.",
            "",
            "4 Neih khat ai thu ’khwan bam ni the,",
            "Amaibungc hei daanc gaanc chuyna;",
            "AKaipouc _>6 raengh laanc pwkhou,",
            "Kakhou abumaengc samc ku ni."
          ]
