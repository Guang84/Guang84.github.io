      "rongmei": {
        "language": "rongmei",
        "title": "Kaganv duikhuangc khou gaanh-kai",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaganv duikhuangc khou gaanh-kai kumcna dingna,",
            "Paapc lev zinghmei taanv tuang duiluat tiigaanh khang,",
            "Nang kailat laanc pat ro, ’thukmei taanv nai the,",
            "Tiigaanc o, Gaychamv riw 8^&!",
            "",
            "Tiigaanc o, Gaichamv riw 8^&!",
            "Tiigaanc o, Gaichamv riw 8^&!",
            "Nang maibungc riw gaanc gay khang thaamc ’than chuy o,",
            "Tiigaanc o, Gaychamv riw 8^&!",
            "",
            "2 Maansei rungh kalaihmei kabamv ’thuic nai e,",
            "Kheiliak, zinghmei lwn nic, kabamv ’thuic nai e!",
            "Ramh thay khang dinclou tio, kaniw duak kan diu;",
            "Tiigaanc o, Gaychamv riw 8^&!",
            "",
            "3 Nang tuang gaanhmei riw 8^& ’giuh ^&8 gumliam rio,",
            "Nang maibungc lou chuy o,",
            "kaphwan giak ’than o,",
            "Suaihiam nang phungc guang tio,zinghmei tiigaanc o,",
            "Tiigaanc o, Gaychamv riw 8^&!",
            "",
            "4 Nang panty mut mak khou Jisu khang lungc o,",
            "Mi chaenglwan khou nang tat towdat pw lak khe;",
            "Kamei ^&8 nang ta dui paengc khou ’riw mak saanv,",
            "Tiigaanc o, Gaychamv riw 8^&!"
          ]
        }
      },
