        "content": {
          "format": "source-lines",
          "lines": [
            "1. Suaihiam tilou khang,",
            "Tingkauh thu latjan su the;",
            "Eden kaikham lan lou dat the,",
            "Gut ro Zion tinggan pat the.",
            "",
            "Chorus:",
            "Thuan o (2), kanloumei pu,",
            "Laujiu na guang the;",
            "Thuan o halleluijah Amen,",
            "Halleluijah kanloumeipu guang datthe.",
            "",
            "2. Jingbang lung geimei %&6,",
            "Kandih ti jang silou;",
            "Eden khou puanmei %&6 thuan ne,",
            "Bui tei cho kalan ganchuanga.",
            "",
            "3. Guang guaina guang %&6,",
            "Zion thu latjan sulou;",
            "Meinun %&6 nu lou nimak ge,",
            "Njian loumei hei nthuk ge.",
            "",
            "4. Tingkauh thanmei nun %&6,",
            "Thuan kupui lu suan ne;",
            "Duipui ramkiang kabam thui khou,",
            "Zion likdiu halleluijah."
          ]
        }
      }
    },
