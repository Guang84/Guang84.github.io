        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaipouc tuang trampet ’muanpui nungc kiu,",
            "Kaganv luaipui nungc kiu,",
            "Tingsaeng gaanc gaymei lauthwan patpui nungc kiu,",
            "Kandih khou gulou tangpui mei guay",
            "Duipaengc khou kariuna,",
            "Tingkauh thangc zanh kawmei ganv khou ai bam ni.",
            "",
            "Tingkauh thangc zanh kawmei ganv khou, (3)",
            "Tingkauh thangc zanh kawmei ganv khou ai bam ni.",
            "",
            "2 Nrangting patmei lauthwan, Khrista",
            "Khou theihmei nunc thauc nungc,",
            "Ringcthau datmei Kahym 7?| laylaa nungc kiu;",
            "Kamei ?|7 kadahloumei guay 7?|",
            "Kai khou 7?| kariuna,",
            "Tingkauh thangc zanh kawmei ganv khou ai bam ni.",
            "",
            "3 Lauthwan zingh khou ?|7 neih keymei nganv",
            "Kaipouc khang taanv taanc ni,",
            "Ch’rynmei Kazauzian lam hei ai rac bam ni;",
            "Kandih apanty hei luai pwkhou,",
            "Ataanv hei luai pwkhou,",
            "Tingkauh thangc zanh kawmei ganv khou ai bam ni."
          ]
        }
