          "lines": [
            "1 Jordan paengc thangc aniu kariu pwkhou,",
            "Thuakloumei nunc ta ’niu how pwkhou,",
            "Duipui syniang sing phuc ngam makmei kumc",
            "Hei kiu adihkamv ch’ryn puni cho!",
            "",
            "Duipui syniang sing phucngam makmei kumc!",
            "Duipui syniang phucngam makmei kumc!",
            "He adih ch’ryn ni cho,",
            "Thuakloumei nunc kariu khou",
            "Duipui syniang phuc ngam makmei kumc puni!",
            "",
            "2 Guloumei guay ta aniu how pwkhou,",
            "Ryanramei khou {:1 duakmei nunc ta,",
            "Tingkauh tuang neihlaa khou sowriw pwkhou",
            "Hei kiu adihkamv ch’ryn puni cho!",
            "",
            "3 Gaychuymei dui paengc khou ’niu ding pwkhou,",
            "Ringhmei tiimei thingbang lym khou 1<:,",
            "’Rianhloumei ramc 1<: aniu how pwkhou",
            "Hei kiu adihkamv ch’ryn puni cho!",
            "",
            "4 Thuakloumeipu ta ’niu howpui nungc kiu",
            "Kahymdaih ta ’niu how pw khou kiu,",
            "Guanghdic kaguay ruc khou",
            "guanghtu pw khou",
            "Hei kiu adihkamv ch’ryn puni cho!"
          ]
