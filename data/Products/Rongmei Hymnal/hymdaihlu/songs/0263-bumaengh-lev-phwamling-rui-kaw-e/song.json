    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Bumaengh lev phwamling rui kaw e",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Bumaengh lev phwamling <~1 kaw e,",
            "Ringhmei dui guang zangv tho;",
            "Suaihiam latchamv, Gaychamv",
            "kiu e,",
            "Paapc khou lakmei nunc khang.",
            "",
            "Bumaengh <~1 kaw e,",
            "Phwamling <~1 kaw,",
            "Ringhmei dui 1<~ nsaa",
            "guangna zangv lo",
            "",
            "2 Chumei kathuic “Guang o,” kaw diu,",
            "Neihlaa sakhi tii diu;",
            "Ai chu the, duiriang phu tow the,",
            "Ai zangvna ’taw ringc the.",
            "",
            "3 He t’rii bammei bumaengh guayle,",
            "Ganc tho, bakmei duilai;",
            "Guangna zangv tho zangv guai khou <~1",
            "Bumaengh t’rii kim puni.",
            "",
            "4 “Guang ni” twmei kamv guang nuh e,",
            "Khrista tiikimlou ni;",
            "Kamanv maek ge, nang lev akhang,",
            "Guang niimei kathuic khang."
          ]
        }
      },
