        "content": {
          "format": "source-lines",
          "lines": [
            "1 Gaanhmei kachaekc lauthwan kiu",
            "Meic Nac ’Pouh 2^< guang dat pwkhou,",
            "Katuang hymgaanhmei 2^< ’niu how puni the;",
            "Zaatc guay khou !}2 Kamei nunc",
            "Kai khou kaw guang kariu pwkhou,",
            "Adih ch’rynmei guang kariumei puni cho!",
            "",
            "Adih ch’rynmei guang kariumei!",
            "Adih ch’rynmei guang kariu cho,",
            "Thuakloumei nunc kariu khou;",
            "Adih ch’ryn cho, guangkariumei!",
            "Thuakloumei nunc tingkau",
            "kai khou kariumei!",
            "",
            "2 Jisu khou theicloumei nunc Kakhwan chuna ringc thau pwkhou,",
            "T’rou lev duipui khou !}2 ringc thau dat pwkhou,",
            "Hymdaihmei bumaengh pumc khou kata tingpuk khou sowriw khou,",
            "Adih ch’rynmei guang kariumei puni cho!",
            "",
            "3 Kai daihmei ’peyna naimei Kaidai 2^< ’niu !}2 how pwkhou,",
            "Chungcringh ringmei duithuak 2^< ’niu how pwkhou,",
            "Zianmei nunc theic kanmei ta neihlaana khou2^< sowriw khou,",
            "Adih ch’rynmei guang kariumei puni cho!",
            "",
            "4 He Guangh 2^< guang dat pw the, Katingmik 2^< ’naa guang pw the;",
            "Rianhloumei neihlaamei tingmik how pwkhou,",
            "Mikkhip dak khou guanhlihna",
            "hymdaihmei pumc 2^< ’niu piuna",
            "Kamei lev tingsaengzaeng lungc ’chamc puni the."
          ]
        }
