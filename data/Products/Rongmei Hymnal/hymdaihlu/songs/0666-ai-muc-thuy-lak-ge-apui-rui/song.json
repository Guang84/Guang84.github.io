        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai ’muc thuy lak ge apui ^&8",
            "Zianna akhou kadyloumei,",
            "“Apamv khou ^&8 tatpat sihni",
            "Nang pui nang khang huaylou bam e.”",
            "",
            "Apui ramzian makumh pwkhou,",
            "Kamei ’taw nic ringc bam kumc e,",
            "Mpwan aliu rih rimei ^&8",
            "Apui huaymei tiiningtow e.",
            "",
            "2 Ai ’mu thuy lak ge kaganv ’thuic,",
            "Ata tiineihlaamei khwan 8^&;",
            "Chaeng ’maanna ai maeng tat sihni",
            "Apui ravsuai ai ningtow e.",
            "",
            "3 Tingkwm geic sih tat kan sihni",
            "Zianmei latkaeng ai chu bam he;",
            "Zianmei apui ta ai how e,",
            "Kabamv khou huayney bammei ta.",
            "",
            "4 Ai ’muc thuy lak Gumeipu ^&8",
            "Apaap khiu ’thanloumei ganv 8^&;",
            "Hei dyng khou 8^& dawlou dyng the,",
            "Apui akhang huayneyloumei."
          ]
        }
      },
