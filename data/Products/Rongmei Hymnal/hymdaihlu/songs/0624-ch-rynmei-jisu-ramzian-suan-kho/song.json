          "format": "source-lines",
          "lines": [
            "1 Ch’rynmei Jisu zauzian suan kho,",
            "Karamzian lu hei suan kho;",
            "Aniu bamv khang tingkauh kai khou",
            "Kamei chamdaanvlou puni.",
            "",
            "’Niu tingkauh tanghpui nungc kiu",
            "Adih neihlaapui tingmik puni cho!",
            "Jisu ta how pwkhou",
            "’Niu rih-ngam lu kaucna suan ni.",
            "",
            "2 Tingkauh ’zwan tatpui",
            "chaenglwan khou",
            "Muangh }?2 gumliam bam nuh e;",
            "’Ki tingkauh ramc guang tangc pwkhou",
            "Ryanra zinghmei nai lak khe.",
            "",
            "3 Kum ethei Kalat diu piu kho,",
            "Tingmik ’thuic siamruai sw kho;",
            "Hymdaihmei Kazaw how pwkhou,",
            "’Niu ryanra guay ’muc puni.",
            "",
            "4 Aniu khang swan chamdaanvlou the!",
            "Karamgai how nuangc ni the;",
            "Kachaekc raengcmun laanc nuangc ni the,",
            "Kachaekc chaeng khou ruan ni the."
          ]
