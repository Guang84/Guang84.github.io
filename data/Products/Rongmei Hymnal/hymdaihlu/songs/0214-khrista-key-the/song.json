      "rongmei": {
        "language": "rongmei",
        "title": "KHRISTA KEY THE",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Lauthwan gaanc pat rey thuai na",
            "khou ny thay mak ge,",
            "Neih riw gaanhmei _>6 zinghmei",
            "ta ngampui ganv khou,",
            "Jisu Kamei nunc ta dih khou _>6 laa thau khang,",
            "Kahym daicna key dat nimei kiu.",
            "",
            "He Pou, asaanh ’khwan ni,",
            "’Niw _>6 neihlaa lu hei suan khang?",
            "Khrista key the! Hallelujah!",
            "Hallelujah! Amen! (2)",
            "",
            "2 Kalaanv ny, tingzyn zingc key khou",
            "ny thay mak ge,",
            "Zipchwng zingc liangmei ganv",
            "khou bam kho nic nuh e,",
            "Kahym _>6 zinghmei tiigaancna",
            "Pou Jisu _>6",
            "Kamei nunc laa khang key nimei kiu.",
            "",
            "3 Tingkauhmei nunc “Hosanna” kaucna keypui nungc,",
            "’Thanmei nunc lev baanch’ra nunc _>6 bwanna key nungc,",
            "Chingkhiuhmei Kahym _>6 gaancna keypui nungc kiu,",
            "Jisu Kamei nunc ta laa puni.",
            "",
            "4 Adih zaenggay ni! theih makna ’niu ku puni!",
            "Kapmei, ryanramei, sucnumei,",
            "theihmei maekna,",
            "Kaipouc lev aniu muangh khou",
            "tuangcna ku puni,",
            "Kamei nunc ta Jisu laa nungc kiu."
          ]
        }
      },
