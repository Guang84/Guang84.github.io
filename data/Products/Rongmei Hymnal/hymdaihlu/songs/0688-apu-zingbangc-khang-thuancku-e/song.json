        "content": {
          "format": "source-lines",
          "lines": [
            "1 Gaanv saekc gaymei taanv taanclou e,",
            "Kage naimei khou ’khavlou e;",
            "Gaanv saekc neihlaana lu suanna",
            "Tingmik saanvsaengh tiigaanclou e:",
            "Nang nic heikumh tu cho ? (2)",
            "",
            "2 Gaanvsaekc thu aliauh azihna",
            "Gay liangmei ganv ta sw ’maan e,",
            "Gaanv saekc gaeng makmei lwnlung khou",
            "Nsa panty khou lungclou e:",
            "Nang nic hei kumh tu cho? (2)",
            "",
            "3 Gaanv saekc $%6 gaanhmei phungc guang e,",
            "Zingbangc guay ta hac ganclou e;",
            "Neihlaa ’chuzaenghmei laatow e,",
            "Katuang panty 6$% mut lak khe:",
            "Nang nic hei kumh tu cho ? (2)"
          ]
        }
