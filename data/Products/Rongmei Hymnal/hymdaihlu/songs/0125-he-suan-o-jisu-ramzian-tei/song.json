        "content": {
          "format": "source-lines",
          "lines": [
            "1 He suan o, kunghmei p’ry guangc 7?|",
            "Guloumeipu ramzian 7?|;",
            "Jisu lev Kahym lam suan o,",
            "Thuakloumei guay lev suan o!",
            "",
            "He suan o, Jisu ramzian 7?|!",
            "Kagaengv diu, duh thangc, ’naa khou,",
            "Suan kaluaih o, ch’rynmei p’ry hei,",
            "Kandih pwm chu lik mak saanv!",
            "",
            "2 He suan o, Jisu theihmei lam,",
            "Lu ?|7 Karamzian suan o;",
            "Nang lu ?|7 Thuakloumeipu khou,",
            "Zaatc guay ta zay guanglou diu.",
            "",
            "3 He thuakloumei guayle, suan o!",
            "P’ry 7?| suan kaluaih dat ro,",
            "Neihlaamei Jisu p’ry lu hei,",
            "Zaatc kaguay suan ’chamc mak saanv."
          ]
        }
