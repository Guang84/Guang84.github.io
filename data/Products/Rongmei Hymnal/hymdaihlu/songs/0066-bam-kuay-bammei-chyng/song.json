        "language": "rongmei",
        "title": "Bam kuay bammei chyng",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Bam ’kuay bammei chyng guay khou phaengc ku e,",
            "Ai rigwnna;",
            "’Khavloumei hei ’bui thangc ru guang ni cho?",
            "Thow ta zauc ni?",
            "Ravguangc hei ata ’khavloumeipu e,",
            "Tingpuk kandih Kamei }?2 damclou e.",
            "",
            "2 Kamei }?2 nang phaykaamv tii- kachac lak,",
            "Guakgau lak khe;",
            "Ziprii makna mik tanguih key makna",
            "Gaeklou puni;",
            "Zauc lo, ’niu Ravguangc ziprii zat ak ge,",
            "Israel mei ta kadanloumeipu hei.",
            "",
            "3 Jehovah hei nang ta gaekloumeipu",
            "Nang baanc swng e;",
            "Jehovah hei baanzat biak thangc naimei Rilin kiu e,",
            "Kalaanv neicriw }?2 nang ta sw khamv lak,",
            "Bwkaanv riw }?2 zingbangc sw khamv lak khe.",
            "",
            "4 Siimei khou }?2 nang ta gaeklou puni,",
            "Paapc guay khou }?2;",
            "Nang tatpatmei guang datmei gaek- lou ni,",
            "Jehovah }?2;",
            "Kauh thangc }?2 nang ta gaeklou- meipu }?2",
            "’Taw }?2 thauna tingsaeng gaeklou puni."
          ]
        }
      },
