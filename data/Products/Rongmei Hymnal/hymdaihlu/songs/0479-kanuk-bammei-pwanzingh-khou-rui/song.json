        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kanuk bammei pwanzingh khou <~1,",
            "Ryanramei duiluat guay khou <~1,",
            "Duploupui bamv, zaengthaekpui bamv,",
            "Zauzian bamvpaeng bangc khou nai e.",
            "",
            "2 Neihlaapui thauc 1<~ Jisu <~1",
            "’Niu py khou teyloupui bamv nai;",
            "Zei <~1 liuloumei, ’thuk liangmei",
            "Zauzian bamvpaeng 1<~ gay liang e.",
            "",
            "3 Lungning manyatpui bamv nai e,",
            "Ruprian guay lungh khat swpui bamv,",
            "Bam ’tamv sihni lwmmei paan <~1",
            "Zauzian bamvpaeng khou sow ’riw e.",
            "",
            "4 ’Bui thangc ’khavlou khang ai pak ni,",
            "’Thiam ’chanv khou, chwnsw, diwsii khou,",
            "Maikwam ngamv ta ’kumhna ngam ni,",
            "Zauzian bamvpaeng 1<~ maek khwan ’thei!",
            "",
            "5 Khou1<~ egal kumc samc ku ni,",
            "Paapc chwn <~1 zyn makpui bamv khou;",
            "Tingkauhmei nunc ta sow ’riw ni,",
            "Hymdaihmei zauzian bamvpaeng khou."
          ]
        }
      },
