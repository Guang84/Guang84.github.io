        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu p’ry akhou raclou o,",
            "Ai chu nii e;",
            "Kamei khou hei bam tuang ethei",
            "Thanv ni tuang e;",
            "Chaeng daeng khou lwn guay,",
            "Zeihlat khou p’ry;",
            "Jisu p’ry guay 6_>",
            "Raclou na ro.",
            "",
            "2 Alauc nunc Kadaeng guangmei p’ry",
            "Chu rey nii e,",
            "Akhou nic suaihiamloumei ta",
            "Ai makumh ni;",
            "Zianmei latkaeng guay,",
            "Zauzian taanv guay,",
            "Jisu zawpaanv khou",
            "Zianmei riw nai.",
            "",
            "3 Kaidai thangc Kathei ai lay ni,",
            "Alauc pangc khou;",
            "Tadanv kwan 6_> zay kauh thauna",
            "Ai kahai ni;",
            "Katuang guangcdic chamv",
            "Ai lu suan ni,",
            "“Jisu hei Guangh e!”",
            "Ai kauc bam ni."
          ]
        }
      },
