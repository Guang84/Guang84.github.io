        "content": {
          "format": "source-lines",
          "lines": [
            "1 Pou, ’khamhpui khuangc ganv khou",
            "’Niw ta tiitiplou o;",
            "Nang Lat ’chumhmei lev ngamv 1<~ <~1",
            "’Niw ta sin gaeklou tho.",
            "",
            "2 Chuzaenghmei tiilou o,",
            "Zianmei lung tiilou o,",
            "Lwmna, khaengvsaengcna ’niw lungh khang,",
            "Kauh zaengthaek ta phu khang.",
            "",
            "3 Ravguangc khat namei ta",
            "Zuk kathuic champouh diu;",
            "Phwamling khou hymdaihmei nai diu,",
            "Jisu Khrista paan <~1. Amen."
          ]
        }
      },
