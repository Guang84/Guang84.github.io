        "content": {
          "format": "source-lines",
          "lines": [
            "1 Thau tho, abumaengc, neihlaana,",
            "Thuakloumeipu ta thuancna suan o;",
            "Kata thuancna ai suan bam e,",
            "Karamzian hei adih ’thuk cho!",
            "Kadanloumei, kadanloumei,",
            "Karamzian hei adih ’thuk cho!",
            "",
            "2 Ai bowna ’maanna bam khwan e,",
            "Khou4@< nganv ata zianlou khwan e;",
            "’Maanmei khou @{4 ata gulou;",
            "Karamzian hei adih daic cho!",
            "Kadanloumei, kadanloumei,",
            "Karamzian hei adih daic cho!",
            "",
            "3 Kandih lev maikwam tuang ngamv @{4",
            "Achaeng bam thingcna athwng sihni,",
            "Kamei ata zayduaklou ni;",
            "Karamzian hei adih tanc cho!",
            "Kadanloumei, kadanloumei,",
            "Karamzian hei adih tanc cho!",
            "",
            "4 Katuakcmei @{4 muanghbangv kumcna",
            "Aruc khou chingcliam guang pw sihni",
            "Kamei adaeng ’naa tanv bam e;",
            "Karamzian hei adih gay cho!",
            "Kadanloumei, kadanloumei,",
            "Karamzian hei adih gay cho!"
          ]
        }
