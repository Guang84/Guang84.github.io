        "content": {
          "format": "source-lines",
          "lines": [
            "1 Poubauhmei, Nang na hei",
            "’Khavlou ngammei pu e,",
            "Chulou o, ’niw huaymei,",
            "N-gyn phaylaanhmei khang;",
            "Ngamp’rymei baanc #^7 sungclou o,",
            "Dui-rih kaanna tatmei nunc ta.",
            "",
            "2 Zianmei #^7 sungclou o,",
            "Kaniw chaenglwan ’thuic khou,",
            "Nang tuang gaanhmei, ’chumhmei,",
            "Kaniw lung khou nai diu;",
            "Ramh guay khou Nang chwn khou lungcna,",
            "Kaniw lung chuzaenghna tat diu.",
            "",
            "3 Kaniw ta gaeklou o,",
            "Tasiat-chariat khou #^7,",
            "Kaniw khou ’chamlou o,",
            "Nang ngamv suai zat mak ge;",
            "Kaniw lev tat ’chamc mak sihni",
            "Pou, Nang baanc khou nsinlou the."
          ]
        }
      },
