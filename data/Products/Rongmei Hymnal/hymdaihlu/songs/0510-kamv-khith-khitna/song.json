        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kamv khith khitna lauthwan",
            "gaanchuangcna guay @<4",
            "Neihriw khou kariw amaanmei kumcna,",
            "Taanc-ruaihmei dic khou @<4 ’niu tat kan pwkhou",
            "’Niu taanv paan na @<4 ningtow bam puni.",
            "",
            "’Niu taanv paan na @<4, ’niu taanv paan na @<4,",
            "’Niu taanv paan na @<4 ningtow bam puni;",
            "Taanc-ruaihmei dic khou @<4 ’niu tat kan pwkhou",
            "’Niu taanv paan na @<4 ningtow bam puni.",
            "",
            "2 ’Niu lingcloumei hei baihmei @<4 tay pwkhou,",
            "’Niu taanv huath ta meic thaylou puni cho?",
            "Kathw lingcloumei nunc 4^& maek kan sihni,",
            "Kaniw taanv 4^& kathai @<4 nchin e.",
            "",
            "3 ’Niu panty khou nchumhmei saaloumei 4^&,",
            "’Niu @<4 kathw guay nrouloumei 4^&;",
            "’Niu ta ’muc kan sihni ningtow bam puni,",
            "Kathai 4^& @<4 aniu taanv nchin e.",
            "",
            "4 Gumei pu @<4 taanv thai nzanhpui nungc kiu",
            "Neihlaamei swan pyrun runpui nungc kiu,",
            "Ziap nunc ryanra, neihlaana",
            "taancloumei 4^&,",
            "Kaniw taanv 4^& hei nungc kiu ndauh ni."
          ]
        }
      }
