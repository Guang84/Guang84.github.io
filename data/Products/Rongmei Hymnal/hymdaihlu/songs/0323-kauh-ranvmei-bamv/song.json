        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tingkauh chaeng ai tat ku bam the,",
            "Tingmik ’thuic kauh hay hay ku the;",
            "Ai huayney e, chaenglwan khou hei;",
            "“Kauh ranvmei khou,Pou,zaylou o.”",
            "",
            "He Poubauhmei, zay kulou o,",
            "Lwmmei paan ?|7 tingkauh zaengc khou,",
            "Khou7?| zianmei neihlaamei nai,",
            "Kauh ranvmei bamv khou zaylou o.",
            "",
            "2 Alungning ?|7 bam nii mak khe,",
            "Lwmsii, pingmei geihpui bamv khou,",
            "Gaanv saekc ?|7 bam nii khwan sihni",
            "Ai machunh e, kauh ranvmei bamv.",
            "",
            "3 Ai ku nii e, muangh ruc thangc 7?|,",
            "Nrangting patmei tingpuk thangc,",
            "Kandih tuang katuakcmei ruc thangc,",
            "Chuzaenghmei bamv thangc 7?| ’thaekc khang.",
            "",
            "4 Kauh liangmei thangc ku tangc nii e,",
            "Chaenglwan siina ku kungc sihni;",
            "Ku bam khou alu kagaengv ni,",
            "Kauh ranvmei khou, Pou, zaylou o.",
            "",
            "5 Chyng hei ku bam khou zaylou o,",
            "Zayloumei maekna ku ping e;",
            "Tingkauh khou ai ku tangc pwkhou,",
            "Kaipouc Nang ta thuancna bam ni."
          ]
        }
