        "content": {
          "format": "source-lines",
          "lines": [
            "1 He gaychuymei huaineypui ganv!",
            "Katuakcmei dic khou {:1 ata,",
            "APu pamv khou zay guanglou e,",
            "Ai kahawmei guay huayney khang;",
            "Ryanra ryanriupui ganv guay khou,",
            "Abumaengc zaengthaek laa tow e,",
            "Rasic phac khou {:1 ai duak ge,",
            "He huayneypui ganv nang paan {:1;",
            "Rasic phac khou {:1 ai duak ge,",
            "He huayneypui ganv nang paan {:1.",
            "",
            "2 He gaychuymei huaineypui ganv!",
            "Nang {:1 aravsuai phungc kuna,",
            "Suaihiamlou khang ’khwan bammei pu,",
            "Ravguangc pamv khou phungc tangclou e;",
            "Ravguangc saa e, Kata phu khang,",
            "Kalat lev Kazauzian lwm khang,",
            "Hei zaeng Kakhou lwmlou ni the;",
            "Ai Nang ta ’khwanna bam ni the;",
            "Aryanra Kakhou lou ni the,",
            "He huayneypui ganv Nang paan {:1.",
            "",
            "3 He, gaychuymei huayneypui ganv!",
            "Nang ganv hei ai laa tanv bam ni,",
            "Pisga luangcbut twan gay khou {:1",
            "Akai howna samc tat mak saanv;",
            "Tingsaengzaeng swan ai laa khang {:1",
            "Ndaw pumc hei luaklou ducna,",
            "Mpwan ta ai samc kaan bam khou",
            "Ramnavpui lat kadylou ni,",
            "“He, gaychuymei huayneypui ganv!",
            "Bam duc khwan tho, bam duckhwan tho!”"
          ]
        }
      },
