        "content": {
          "format": "source-lines",
          "lines": [
            "1 Paapc khou ’maan bam khou",
            "phumei 6$% Jisu zauzian e,",
            "Kakuanc khou phungc guang",
            "datmei 6$% ch’rynpui zauzian e;",
            "“Kazauzian thukh hei duipui",
            "’thukmei khang suangc ’thuk ge;",
            "Tingpuk khang suangc kauh e,” twmei hei alat’lu e.",
            "",
            "Tingkwm tat hay gay hay hay,",
            "Tingkwm tat hay gay hay hay;",
            "Jisu zauzian hei gaymei mbu hay hay e,",
            "Tingkwm tat hay gay hay hay.",
            "",
            "2 Reynungc Judia khou Kamei",
            "’puay tat bam khwan e,",
            "Tiigaymei Kazauzian laa khang",
            "meic nunc huamc guang e;",
            "Miktiatmei tiihowlou e, lungh",
            "katuakcmei tiigay,",
            "Ntaw nic aruc khou nganvna",
            "nzianlou bam e.",
            "",
            "3 Nzianpui zaeng $%6 aniu phaan",
            "ryanra ’khaengvlou e,",
            "Ryanramei kros 6$% reih reina",
            "Kamei phungclou e;",
            "Nthanmei nunc lev aniu lu akhat na suan kho;",
            "Tingkauh lev kandih suan adangv",
            "mak saanv suan thau kho."
          ]
        }
      },
