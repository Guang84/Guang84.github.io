        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc Kamei kahak",
            "’Niu lev bam ’chamc bam e,;",
            "Chingkhiuhna Kahu khou guang kho;",
            "Ravguangc Kamei bam e,",
            "Katuang Ravkai khou hei,",
            "Reih reina pun keyna bwan kho;",
            "Kamei na Ravguangc e,",
            "’Niu Racguangc, Gumeipu,",
            "Tingsaeng thuanhmei sw diu.",
            "",
            "2 Ravguangc ’niu lev bam e;",
            "Nrah khwan 3)^ ’king o,",
            "Guangh bampaeng ding huamhmei nunc khwan:",
            "“Thanmei, ’Thanmei, ’Thanmei,”",
            "Thuanhmei lu khwan ’king o,",
            "’Thanmei nunc lev baanch’ra nunc khwan;",
            "’Niw khwan hei chulou o,",
            "He Khrista ’kinglou o,",
            "Nang phwamling )}3 thuanhmei.",
            "",
            "3 He suaihiam Duipuakle,",
            "Ata khiu ’thanlou o,",
            "Nang zauzian khou na ngangvlou e;",
            "Nang zaw how tanv` bammei",
            "’Thanmei baanch’ra nunc kumc,",
            "Ai Nang ta taek makna bwan ni;",
            "’Thyammei, daihmei kathuic",
            "Nang kahawmei kumcna",
            "Taanc ngam khang phu kan diu. Amen."
          ]
        }
