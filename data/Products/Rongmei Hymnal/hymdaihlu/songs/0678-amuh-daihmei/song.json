        "content": {
          "format": "source-lines",
          "lines": [
            "1 Amuh daihmei ’niu daeng bam e,",
            "Kadanthaymei Jisu e,",
            "’Suan keymei lung tiithaulou e,",
            "He king o, Jisu khwan 2}?.",
            "",
            "Baanch’ra lu khou gay liangmei,",
            "Maansei nunc khang ’deih liangmei,",
            "Nuhgay liangmei lu kiu e;",
            "Jisu, kunghmei Jisu!",
            "",
            "2 Nang paap guay 2}? kuaklou ngam the,",
            "He king o, Jisu khwan ta!",
            "Chuzaenghna nang tingkauh tat tho,",
            "Jisu lev pyrun run tho.",
            "",
            "3 Ringc thau datmeipu hym daic diu,",
            "’Taw ai Jisu ta lwm the;",
            "Guloumeipu zanc ta zian e,",
            "Jisu zanc ta ai zian e.",
            "",
            "4 Kazanc }?2 pingmei tii’maan e,",
            "Baihmei zanc khou ngamv maek ge;",
            "He alung }?2 chu bam nii e,",
            "Kungc liangmei Jisu zanc hei.",
            "",
            "5 Tingkauh kandic guang tangc pwkhou,",
            "Aniu Kata how pwkhou,",
            "Guang bamvpaeng ding huamcna suan ni,",
            "Jisu zanc ta thuanc bam ni."
          ]
        }
