        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ringcthau datmei Gumeipu,",
            "Siamruai ai sw bam e,",
            "Meic nunc tabui saa bam diu,",
            "Kamei ringcna bam de;",
            "",
            "Kazauzian baanc ai how e,",
            "Kakhwan 0({ ai chu e,",
            "Kata kahawpui ganv ’thuic anaa bam e.",
            "",
            "Kamei ringc e, Khrista ringcna bam e!",
            "Ai lev tat ’chamc, saa ’chamc bam e,",
            "’Rummei panty chaeng khou,",
            "Kamei ringc e, ringhbamv tiilou khang e!",
            "Ringc e twmei thaymei kiu thu",
            "Kamei alung khou bam.",
            "",
            "2 Kandih kabamv kathuic khou",
            "Kazauzian ai how e,",
            "Alung ryanra thau sihni",
            "Achwn tut key lak khe;",
            "Pwanzingh ganv khou zaylou e,",
            "Kangamv guay ai thay e,",
            "Kamei guang datpui neic kiu Kata how ni.",
            "",
            "3 Neihlaa, neihlaa, he khristian,",
            "Khwan kauc ranvna suan o,",
            "Nganv makmei Hallelujah!",
            "Guangh Jisu Khrista khang!",
            "Kata phupui mei guay ta",
            "’Khavloumeipu kiu e,",
            "Kakumcna zianmei, gaymei baihmei maek ge."
          ]
        }
