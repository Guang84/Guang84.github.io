        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu ta kahaw e, kachaekc kaphut suangc,",
            "Ai Kakhang sw ni, lunggaichingkhiuh khang suangc,",
            "Jisu ta kahaw e, kailau ta suangc,",
            "Zotpi zam baanc #^5 chaeng zayloumei ta!",
            "",
            "Guanghdic dai ruc khou guanghtuna lungcna,",
            "Paapc #^5 zynna lunghmei suangc,",
            "Dih khou tabui punic gaymeikhang suangc",
            "Jisu ta kahaw e.",
            "",
            "2 Jisu ta kahaw ranv, meic nunc ramthuan suangc,",
            "Kakhang lwm nuhmei swna ai lungc ni;",
            "Jisu ta kahaw ranv, zanhtatmeita suangc,",
            "’Thanmei Kazanc khou ai ding ’tip bam ni.",
            "",
            "3 Jisu hei gay diangc e, Lili pwang khang suangc,",
            "Jisu ndeih ranv e, ’khuaihdui ’deihmei suangc,",
            "’Daapc mei abumaengc khang taektw Kamei e,",
            "Kamei zayloumei ai kahaw liang e."
          ]
        }
      },
