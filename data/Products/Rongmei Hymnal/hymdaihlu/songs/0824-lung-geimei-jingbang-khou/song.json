        "content": {
          "format": "source-lines",
          "lines": [
            "1. Lung geimei jingbang khou,",
            "Guang daimei Jisu rui;",
            "Hei 0({ ajanne, ajei hei tujang mei rui,",
            "Ata ningtan mak khang.",
            "",
            "Chorus:",
            "Poubaumei la ni mak,",
            "Zion pilung khou 0({;",
            "Khalou nimei maknga,",
            "Siangding kross khou dup the.",
            "",
            "2. Jaolo hei khou 0({ rui,",
            "Tat patkan puni the;",
            "Nkhuaimei khang phulou,",
            "Poubaumei thanmei ta,",
            "Rianramei khou jai lou.",
            "",
            "3. Latjan 0({ luai lana,",
            "Kalvari ching thang 0({;",
            "Amu daimei nun le,",
            "Rihmei bui sinmei le,",
            "Poubaumei ta jai tat.",
            "",
            "4. Njangmei poubaumei,",
            "Rianramei kross phunga;",
            "Houmu nun rui jai na,",
            "Kalvari juan na tat,",
            "Khaloumei maknga tat."
          ]
        }
      },
