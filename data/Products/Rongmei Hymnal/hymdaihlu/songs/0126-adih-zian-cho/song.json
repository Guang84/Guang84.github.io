        "content": {
          "format": "source-lines",
          "lines": [
            "1 Meic guay ramzian suangc ’bumei nai,",
            "Adih zian cho!",
            "Chana nunc ramzian suangc ’thuk ge,",
            "Adih zian cho!",
            "",
            "Dih rup nunc thu ’patlou nuh e,",
            "Neih khat zian, neih khat karaeng e,",
            "Kaipouc Jisu thu kumh mak ge,",
            "Adih zian cho!",
            "",
            "2 Kata thaymei ringcsuangmei e,",
            "Adih zian cho!",
            "Aniu Kapow phunghmei chak kho,",
            "Adih zian cho!",
            "Kunghmei Kazei ^&8 ’niu ta liu,",
            "Tazikramv khou ’niu ta phutow,",
            "Kakuanc khou ’niu ta phungc guanglou,",
            "Adih zian cho!",
            "",
            "3 Jisu ta aPam sw tow the,",
            "Adih zian cho!",
            "Aniu khang suaihiam tii nii e,",
            "Adih zian cho!",
            "Kalat chu khou adih neihlaa,",
            "Kadaeng khou bam khang saa pwkhou!",
            "’Bui khang Kalat lwm zih ni cho?",
            "Adih zian cho!",
            "",
            "4 Kazanc paan aniu ta kuaklou,",
            "Adih zian cho!",
            "Zauczihmei guay ta hac ganclou,",
            "Adih zian cho!",
            "Aniu dwan gay khang nramhlou",
            "Gaymei ^&8 aniu dwan sw ni,",
            "Hymdaih khou ’niu ta zaylou ni,",
            "Adih zian cho!"
          ]
        }
