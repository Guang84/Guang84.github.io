        "content": {
          "format": "source-lines",
          "lines": [
            "1 Taanc-ruaihmei, nchanvmei guay nganv pwkhou,",
            "Tingkauh khou gayna ai guang bam pwkhou,",
            "Ai zianmei Kaipouc daeng khou bam pwkhou,",
            "Panty lungsing hymdaihmei sw puni.",
            "",
            "Hei kiu adih .. hymdaic puni!",
            "Hymdaihmei kiu .. akhang di the!",
            "Zauzian paan #^7 Kazawpaanv how pwkhou,",
            "Hei kiu adihkamv hymdaic puni cho!",
            "",
            "2 Kanganv nai makmei Kazauzian paan #^7,",
            "Ata tingkauh khou tiilungclou pwkhou,",
            "Kazaw kahak ta 7}$ how pwkhou kiu,",
            "Panty lungsing hymdaihmei sw puni.",
            "",
            "3 Zianmei ruprian guay khou7}$ bam puni,",
            "Neihlaamei duiriang kumc luangc bam puni;",
            "Guloumei pu nuic rimh rimlou pwkhou,",
            "Panty lungsing hymdaihmei sw puni."
          ]
        }
