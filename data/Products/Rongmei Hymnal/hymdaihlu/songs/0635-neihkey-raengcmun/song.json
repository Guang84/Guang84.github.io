        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neihkey raengcmun biak ai tat bam e,",
            "Kai ’zwanna ai tat bam e;",
            "Tingzyn neic suc katynmei kumcna",
            "Neihkei raengcmun ’naa guang khou!",
            "",
            "Tingzyn kaeng .. khwan ai chu e,",
            "Neihkey raengcmun ’naaguang khou!",
            "",
            "2 Neihkey khou nchuna zaeng ’thaekc ni,",
            "Chuzaenghmei khou zip key ni;",
            "Neihkey khou ai kai tangc pwkhou kiu",
            "Chuzaenghmei khou zip key ni.",
            "",
            "3 Nzianmei nunc daeng khou tangc pwkhou,",
            "Aryanra guay lou key ni;",
            "Niamhmei Kaipouc khwan ni chu pwkhou",
            "Aryanra guay lou key ni.",
            "",
            "4 Tinggaanc pwkhou ai thau dat puni,",
            "Hymdaihmei 5#^ ai piu ni;",
            "Theihmei 5#^ laa ganc kan pwkhou kiu,",
            "Hymdaihmei 5#^ ai piu ni."
          ]
        }
      },
