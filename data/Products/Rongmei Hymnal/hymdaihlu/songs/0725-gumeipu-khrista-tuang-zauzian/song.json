          "format": "source-lines",
          "lines": [
            "1 Gumeipu Khrista tuang zauzian,",
            "Pu Ravguangc tuang ramzian 5#^,",
            "Bumaengh ’Thanmei tuang lamluaimei",
            "’Niu khou nai bam kan diu tho!",
            "",
            "2 ’Niu chwn chamhna lunghmei sw diu,",
            "Khat khat khou lev Khrista khou,",
            "Kadam laa ’chamcmei ramgai 5#^",
            "’Niu khou naimei sw kan diu!",
            "Amen!"
          ]
        }
      },
