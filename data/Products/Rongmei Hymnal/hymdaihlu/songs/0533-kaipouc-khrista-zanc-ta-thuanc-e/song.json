        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaipouc Khrista zanc ta thuanc e,",
            "Kalat khang ’niu kata thuanc e,",
            "Kapu ningmei 1<~ taanc niina",
            "Katuang ’twnmei taanc ’thuihmei khang.",
            "",
            "2 ’Niu nic Kathiak layluaih niina",
            "’Thukmei riak ta taanc ’thuihlou the,",
            "Dui <~1 ’niu lwmmei nymlou the,",
            "Lat piu nimei 1<~ ’niw lyanna.",
            "",
            "3 Duilup be, Pu Ravguangc zanc khou,",
            "Nah Pouh lev Bumaengh",
            "’Thanmei khou,",
            "’Niu lung ’thanna, Kakhou ’thaekc ge,",
            "’Chuzaenghna Jisu zei paan <~1.",
            "",
            "4 Zauzian <~1 “Abba, Pu” kaw e,",
            "’Khavloumei pu ta thouclou e;",
            "Zauzian zaeng khang ’niw zianmei hei",
            "Tingsaengzaeng Nang khang na tii ni. Amen."
          ]
        }
      },
