    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "NANG KHOU JISU KHANG BAMV NAI CHO ?",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang khou Jisu khang bamv nai cho,",
            "Nang paap guay phungcloumeipu khang?",
            "Kaikhamv ’chowna Kamei thanv e:",
            "Paapc mei, nang tiigut lak cho?",
            "",
            "Hymdaihmei Guangc Jisu khang bamv!",
            "’Khap tho, ’taw Kalat piu o;",
            "Nang lung kaikhamv laanc daic pat ro,",
            "Kaw gutlou tho, nuh bam khou.",
            "",
            "2 Thala khang, alic khang bam nai,",
            "’Ki theicloumei pu Khrista khang,",
            "Kamei gutloupui bamv maek cho,",
            "Theih phaan lynloumei lung khou?",
            "",
            "3 Nang khou Jisu khang bamv nai cho,",
            "Zauzian khou kaw dat dat bam khou?",
            "O, ’seic hei laaloupui neic the,",
            "’Thuanh thu nyan langv puni the.",
            "",
            "4 Bamv lev kaganv Kakhang tii tho,",
            "Zauzian ting luai nuangc puni the;",
            "Nang lung nchu key puni the,",
            "Gumeipu huay taan puni."
          ]
        }
      },
