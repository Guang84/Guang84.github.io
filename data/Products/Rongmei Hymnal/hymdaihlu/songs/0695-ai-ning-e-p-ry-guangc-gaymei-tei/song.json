    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Ai ning e p’ry guangc gaymei tei",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Takmei <~1 kaningting phungc guang,",
            "Naimei <~1 lanv phungc guang,",
            "Gaanv saekc <~1 kaniw tuang saeng-dai,",
            "Pumtan, pumhgay phungc guang;",
            "’Niu nic ’niu tuang lanv gay liangmei",
            "Guangh khang phungc guang nii e,",
            "’Niu khou lanv lev ningting maek ge;",
            "Tabui katlou kho cho?",
            "",
            "2 Zianmei lung Kakhou phungcguang ni,",
            "Thuanckumei lung tii ni,",
            "’Thanmei chaeng khou ’niu tat ngam khang,",
            "Niamhna ’niu karamc ni.",
            "Hei guay hei the ’niu tuang lanv kiu,",
            "Guangh khou kat nimei kiu;",
            "Lungcsii liangmei nac <~1 sihni",
            "Mi hei katlou ngam e.",
            "",
            "3 ’Niu thouc kamung guay phungc guang ni,",
            "Tingmik kathuic thouc 1<~;",
            "Kata tiipian khang karamc ni,",
            "Kai khou, school khou, rwan khou;",
            "Mi hei gay ranvmei lanv kiu e,",
            "’Niu Guangc khang katlou khang;",
            "Alauc <~1 nganv phungc guang ngam e,",
            "Lanv daih suangc ’thuk diang e."
          ]
        }
      },
