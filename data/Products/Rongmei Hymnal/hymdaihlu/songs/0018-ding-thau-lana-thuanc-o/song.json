        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ding thau lana thuanc o,",
            "Poubauhmei bangc nuncle;",
            "Thuanc o, Ringhpou, Nang Ravguangc ta,",
            "Lungning lev khwan guay ^&8.",
            "",
            "2 Thwan guay ruc thangc bam e,",
            "Suaihiam guay ruc singc e,",
            "Kazanc ’thanmei thow ping lak cho,",
            "Kahym tiidaic lak cho?",
            "",
            "3 He ringhmei maibwang 8^&",
            "Karavchapaeng khou ^&8",
            "Aniw chy khou kahilou o,",
            "’Niw lung tii chuangclou o.",
            "",
            "4 Ravguangc ’niu pumtan e,",
            "Karingcbamv ’niu khang e;",
            "Karamzian hei dinc ndauh o,",
            "Thuakloumei ngamv dinc o.",
            "",
            "5 Ding thau lana thuanc o,",
            "Nang Ravguangc ta bwan o,",
            "Ding thauna Kazanc ta thuanc o,",
            "’Taw nic tingsaengzaengna."
          ]
        }
      },
