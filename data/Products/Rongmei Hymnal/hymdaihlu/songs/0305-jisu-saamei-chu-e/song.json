        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu saamei chu e:",
            "“Nang pumtan ’suanmei e,",
            "Changkhaanv o, huay o, ney o,",
            "Akhou ramh guay laa lo.”",
            "",
            "Jisu ?|7 khangclou",
            "Ai Kapouh phungc lyn;",
            "Miwmei paap 7?| sw ’than the,",
            "Gunh kumc khiu ’phwanlou the.",
            "",
            "2 Ai thay the, ’taw Pou ngamv",
            "Ngamv hei Nang khou na de;",
            "’Phaanhmei zam tiigaylou khang,",
            "Tanhmei lung sw bak khang.",
            "",
            "3 Akhou gaymei maek ge,",
            "Nang suaihiam laa biuhmei,",
            "Kalvari Lauziu zei khou",
            "Sou ’phwan ni apheybaan.",
            "",
            "4 Guangh bamvpaeng hu khou 7?|",
            "Ai guang ding pwkhou kiu",
            "Athwan guay Kakhou lyan ni,",
            "Kaphaypav khou lou ni."
          ]
        }
