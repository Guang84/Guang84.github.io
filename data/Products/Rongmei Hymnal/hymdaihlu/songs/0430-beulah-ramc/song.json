        "content": {
          "format": "source-lines",
          "lines": [
            "1 Lungcgay chingkhiuhpui dic tangc the,",
            "Mi lunggai guay akhang di the;",
            "Kalaanv gaanc suangpui ramc kiu e,",
            "Zingbangc zinghmei guay ’maan kan the.",
            "",
            "He Biulah Ramc, lungcgaypui ramc,",
            "Nang tuang luangcbut kauh khou dingna",
            "Duipui phaengc twanna ai phaan e,",
            "Akhang chamdaanvloumei kai ta!",
            "Hymdaih duikhuangc ta phaengc how e,",
            "Gaanc gaymei akai, tingkauh ta!",
            "",
            "2 Guloumeipu _>6 guang ’duanghna,",
            "Aney neihlaana tat ’chamc e;",
            "Kabaanc _>6 ata zaylou e,",
            "Mi hei tingkauh ramvrei kiu e.",
            "",
            "3 Kanganv maekna puanghmei mwn rym,",
            "Namh gaymei mwnpwang padik ge,",
            "’Pwan _>6 kabamv ’thuic phungc lik ge,",
            "Khou 6_> ringhmei duiriang luangc e.",
            "",
            "4 Nuhgaymei tingkauh lu khwan hei",
            "’Pwan _>6 anu khou phungc guang e,",
            "’Phwanmei pheychuan piumei nunc lev",
            "Baanch’ra nunc suanmei lu khwan 6_>!"
          ]
        }
      }
