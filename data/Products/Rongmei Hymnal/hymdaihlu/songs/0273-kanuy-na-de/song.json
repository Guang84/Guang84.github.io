        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kanuy na de. Bumaengh lungngiu,",
            "’Maan kanmei ganv khang ta;",
            "Paapc khou lungcna, lunghngiuh",
            "makmei,",
            "Latryan swna ngaek ngam makmei,",
            "Kaguakcmei panty ta!",
            "Kanuy na de, kanuy na de!",
            "",
            "2 Kanuy na de, khwam kaduai mak,",
            "Minc bammei thai guay ta,",
            "Kathw ’roulou, napriak tay tu,",
            "Taanv swmei phaan nsa lat rac,",
            "Ryanramei thai tay tu,",
            "Kanuy na de, kanuy na de!",
            "",
            "3 Kanuy na de, lunghngiuc bam e,",
            "Nkamh dat ngam mak khe,",
            "’Niu taancloumei zauc hanc datna,",
            "Sw ’maan kanmei ganv guay chakna,",
            "’Khamh khou ’niu thay pat the;",
            "Kanuy na de, kanuy na de!",
            "",
            "4 O Kaipouc ta ’kumhna ’riw ni,",
            "Kanghmei nuy na phungcna;",
            "Pingmei latzan bamvpaeng hu khou,",
            "Kaipouc phaypav khou loukey ni,",
            "Kachaekc napchu phaan khang;",
            "Kanuy na de, kanuy na de!"
          ]
        }
      }
    },
