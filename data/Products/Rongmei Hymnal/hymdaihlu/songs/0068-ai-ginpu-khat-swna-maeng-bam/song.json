        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai ginpu khat swna maeng bam khwan e,",
            "Tingsikmei, zinghmei paapc zingbangc khou,",
            "Jisu @{4 ata phutow khwan e,",
            "’Taw thu ai kai ’zwan bam di the.",
            "",
            "",
            "Nang ramgai, Nang ramzian @{4 lamluai bam ni,",
            "Apanty, aringcting nai bam saanv. (2)",
            "",
            "2 Ai lak pwkhou achaengc tiiringclou e,",
            "Tingmik ’thuic khang pumtan tiilou e;",
            "Chunghmei dui khou ata zaylou e,",
            "Aphaykaamv ’thuic makavlou e.",
            "",
            "3 Chwn karummei nzaengc ai tat kaan khou,",
            "Gumeipu @{4 ai lev tat ’chamc ni;",
            "Kabaanc @{4 ata zay guang tangc ni,",
            "Akhang chamdaanvloumei kai khou.",
            "",
            "Coda:",
            "Ringhpouc kai khou ai lungc",
            "bam puni the,tingsaengzaeng",
            "Chamdaanvloumei taektw guay ai tu bam ni;",
            "Nang ramgai, Nang ramzian @{4 lamluai bam ni,",
            "Apanty, aringcting nai bam saanv.",
            "Apanty, aringcting nai bam saanv."
          ]
        }
