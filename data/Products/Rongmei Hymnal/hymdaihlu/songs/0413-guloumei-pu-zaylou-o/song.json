        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guloumeipu, zaylou o!",
            "’Zaengna chaeng saanv zaylou o;",
            "Nang daeng khou bamna duak the,",
            "Nang zianmei khou ai bam ni.",
            "",
            "Chaeng .. zay .. lou .. o,",
            "Zay .. lou mak ’thei chaeng maanv ni,",
            "Ka .. ganv tat khou zaylou o,",
            "Chaeng saanvsaengh Pou, zaylou o.",
            "",
            "2 Panty pwanzingh guang pwkhou,",
            "Abumaengc dup bamv Nang e,",
            "Nang ’naa bam khou ai duak ge,",
            "Nang zauzian khou ngangvlou e.",
            "",
            "3 Zaylou o, katwan nganvna,",
            "Panty pwanzingh luai pwkhou,",
            "Mikdui guay rouloupui bamv,",
            "Kalaanv ramc ai tangh mak saanv."
          ]
        }
      },
