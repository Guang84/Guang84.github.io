          "format": "source-lines",
          "lines": [
            "1 Ravguangc lungcloumei kaikhunc 2}?",
            "Neihlaamei kaikhunc e;",
            "Ningmei, huaymei khat na swmei,",
            "Zianmei naimei kai 2}?.",
            "",
            "2 Jisu zanc saanhmei kaikhunc 2}?",
            "Neihlaamei kaikhunc e;",
            "’Thyam-’thauh guay }?2 Kap’ry racna,",
            "Kata kunghmei kai 2}?.",
            "",
            "3 Huayneymei, thuanhmei kaikhunc 2}?",
            "Neihlaamei kaikhunc e;",
            "Ravguangc lat ta chakhwang swna,",
            "Piu khang swmei kai 2}?.",
            "",
            "4 He Kaipouc, ’niu kaikhunc khou hei",
            "Nang }?2 taanv swlou o;",
            "Nang ta zian khang aniw lung hei",
            "Nang }?2 bang k’riulou o."
          ]
        }
