        "content": {
          "format": "source-lines",
          "lines": [
            "1 Thuanhpui lu #^7 zaenggay lu #^7",
            "Lungh neihlaana Kata thuanc kho,",
            "Zianna zaylou bammeipu ta,",
            "Chabwan nunc ta zianmeipu ta.",
            "",
            "Neihlana ’niu ding kho,",
            "Lungh lev baanh kariuna,",
            "’Maanmei ta khuam guang kho,",
            "Paapc lev siimei khou #^7;",
            "Mi hei aniu thouc e,",
            "Kazanc hym tiidaihmei,",
            "Thuakloumeipu Jisu lam lev",
            "Karamzian ’dauhmei hei.",
            "",
            "2 Khou hei aniu kariu bammei",
            "Nzianmei phwam, kunghmei rup nunc,",
            "’Niu ravsuai ’gaw rym kumc ku diu;",
            "Zauzian Kaipouc Ravguangc bamv khou.",
            "",
            "3 He Pou Ravguangc, alauc nunc Pam,",
            "Chaeng zaylou o, gaeksianlou o,",
            "Ngammei Nang baanc #^7 zaylou o,",
            "Chabwan phwam ta kakalou o."
          ]
        }
      },
