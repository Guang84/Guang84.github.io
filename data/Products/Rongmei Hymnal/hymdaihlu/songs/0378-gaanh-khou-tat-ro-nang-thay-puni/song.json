        "content": {
          "format": "source-lines",
          "lines": [
            "1 Gaanh khou tat ro nang thay puni!",
            "Zianmei kadam laamei;",
            "Kabumaengc na ^&8 tii ngam e,",
            "Kauh thangc bammei Pu ^&8.",
            "",
            "2 Gaanh khou tat ro, nang laa tow ni,",
            "Kalung lev tamzuanmei;",
            "Kamei gaanhmei kai khou bam e,",
            "Kakhou zinghmei maek ge.",
            "",
            "3 Gaanh khou tat ro, nang khang sw ni,",
            "Zinghmei hac gancloumei;",
            "Kalaanv gaanhriw ’thuihmei 8^& ^&8",
            "Nang khou souc gaanclou the.",
            "",
            "4 Gaanh khou tat ro, nang chu puni,",
            "Sauhding khou gaanhmei chamv,",
            "Ravguangc nang khou lungclou puni,",
            "Kamei hei gaanhmei e."
          ]
        }
      },
