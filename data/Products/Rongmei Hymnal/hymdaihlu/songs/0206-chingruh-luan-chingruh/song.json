        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ching ruh luan ching ruh mei nunc,",
            "Kachanmei pwan piuna,",
            "Thuaklou tangmei ricmei nunc 2^<,",
            "Gaanh kai khou kaduai e,",
            "Luai the, ’taw thu luai ngam the,",
            "Paapc lev theihmei ric 2^< !",
            "Kachaekc raengcmun laanc",
            "daiclou the,",
            "Ngammei nunc !}2 gut khang.",
            "",
            "Hallelujah ! Hallelujah !",
            "Swluaimei Lauziu Nac khou !",
            "Hallelujah ! Hallelujah !",
            "Ringc dat bammei pu khou.",
            "",
            "2 \"Hallelujah\" Kauhmei khwan,",
            "Dih lev kau kachin e !",
            "Alim, ’rah ching ching khwan !}2",
            "Rih ngammei ta ndauh e;",
            "Hei nungc khang !}2 ramh guay lev",
            "Zaatc guay ta damclou the;",
            "Adih neihlaa! ryanra guay khang !",
            "Neihlaamei khanglou the.",
            "",
            "3 Adih neihlaana riu ni",
            "Kanaan dic gay khou kiu",
            "Adih ’tipmei phwamling puni cho,",
            "’Tamvmei nai dat lak khe,",
            "Swmmay nai dat lak khe."
          ]
        }
