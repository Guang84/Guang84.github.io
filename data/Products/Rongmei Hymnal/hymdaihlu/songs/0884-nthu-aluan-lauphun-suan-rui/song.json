        "content": {
          "format": "source-lines",
          "lines": [
            "1. Nthu aluan lauphun suan @&4,",
            "Zeliangrong kandih hei mu;",
            "Riu @&4 tigan lou.",
            "",
            "Chorus:",
            "Aniu lung kaluan thao na,",
            "Khrista ta thuan kho;",
            "Nkhuang baza kajaona –",
            "Kata thuan ku kho,",
            "Adi nthuk kan tu cho?",
            "Raguang ram dam hei.",
            "",
            "2. Ahu alang duipui suna,",
            "Luang bam pui kan khou;",
            "Zeliangrong kandih hei mu,",
            "Kim kanei lak ge.",
            "",
            "3. Zeliangrong kandih nam rukhou,",
            "Gailiangmei padik;",
            "Zeliangrong kandih guai ta,",
            "Raguang ning sudiu.",
            "",
            "4. Ahu alang duipui ru khou,",
            "Ai sam tat bam ni;",
            "Rangsou kumma sam bam ni,",
            "Nchu rih rina.",
            "Favourite song: Samson Pastor"
          ]
        }
      }
    },
