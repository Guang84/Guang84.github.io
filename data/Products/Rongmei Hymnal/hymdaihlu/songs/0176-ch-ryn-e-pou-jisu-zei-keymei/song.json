        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ch’ryn e! Pou Jisu zei keymei!",
            "Daic Liangmei Guangc theihmei!",
            "Ramhrik kumhmei ai kumhmei khang,",
            "Kazei katpatmei hei!",
            "",
            "2. ’Khuaimei ai taanhmei zaeng khang cho,",
            "Kros khou ’khaengvloumei 4@<?",
            "Saa ngam makmei ch’rynpui zauzian,",
            "Akhang taanclou pwmei!",
            "",
            "3 Neih @{4 Kariw nkamh biuc e,",
            "Kahym mbangh biuc e,",
            "Maansei paap zaeng khang @{4 Khrista,",
            "Damcloumeipu theih nungc.",
            "",
            "4 Ai nic zakzaw nkamh biuc e,",
            "Kazauzian kros lyan khou;",
            "Thuanckuna alung kabiuna,",
            "Amikdui key biuc e.",
            "",
            "5 Zauzian pow hei khangc ngam thuy lak,",
            "Lungh kabiumei na @{4;",
            "Pou, apumc kahak tiipat the,",
            "Mi hei angamv kiu the."
          ]
        }
