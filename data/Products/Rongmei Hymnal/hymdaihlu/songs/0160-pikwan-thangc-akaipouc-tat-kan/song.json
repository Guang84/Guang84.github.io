            "1 Pikwan thangc aKaipouc tat kan the,",
            "Lakna huayney khwan e,",
            "Pikwan khou aKaipouc guang khwan e,",
            "Zakmei ’khaengvlou khwan e;",
            "’Ki oliv bang nunc 6_> kaniw mik tiat mak,",
            "Kanwang guay _>6 Pou ta kadan khwan e,",
            "Sauh bang nganv Kata lunghsuc khwan e,",
            "Kaipouc pikwan khou guang khou.",
            "2 Pikwan khou _>6 Kamei tatpat the,",
            "Kaipouc Kalung kwnna;",
            "Pikwan khou _>6 Kaipouc tatpat the,",
            "Zakmei ’khaengvna theih khang;",
            "Zakmei ’khaengvna theicloumei ganv guang pwkhou",
            "Kata kros ruc khou zay kauh thau khwan e,",
            "Kros ruc khou Kata swluai khwan e,",
            "Pikwan khou _>6 pat dat khou."
          ]
