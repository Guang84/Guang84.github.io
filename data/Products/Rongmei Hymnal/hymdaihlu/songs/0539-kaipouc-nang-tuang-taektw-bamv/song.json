        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaipouc, Nang tuang taektw bamv khou",
            "Aniw kariu bam e;",
            "’Niw tumei ’tyan hei Nang zanc e,",
            "Drakhadui Nang zei e.",
            "",
            "2 Heipui taektw swmei pu hei",
            "Dih khou keyna theiclou;",
            "Heipui ravkatpuat hei tu khang",
            "Aniu ta kawlou e.",
            "",
            "3 Nang ramzian kumhmei khat sic maek,",
            "Guloumei pu, Jisu!",
            "Nang khang kunghmei abumaengc hei",
            "Nang khang laa biuc rap be.",
            "",
            "4 Alung, abumaengc, apumtan,",
            "He Pou, Nang khang tii the;",
            "Apanty nganv Nang khang tii ni,",
            "Nang ?|7 kawlou pwkhou."
          ]
        }
      },
