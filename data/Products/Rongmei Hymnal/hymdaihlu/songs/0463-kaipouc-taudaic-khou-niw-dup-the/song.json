        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaipouc, Taudaic khou ’niu dup the;",
            "Pwanzingh guang khou duppuibamv e!",
            "Duak ge, siimei naimei kathuic,",
            "Pwanzingh guang khou duppuibamv e!",
            "",
            "Pou Jisu, Taudaic e, lakmei kandic khou!",
            "Lakmei dic khou, lakmei dic khou!",
            "Pou Jisu, Taudaic e, lakmei kandic khou,",
            "Pwanzingh guang khou duppuibamv e!",
            "",
            "2 Kalaanv ramvsung, zingbangc gaekmei,",
            "Pwanzingh guang khou duppuibamv e!",
            "Zauczihmei ta ping khang maek khe,",
            "Pwanzingh guang khou duppuibamv e!",
            "",
            "3 Pwanzingh aliu ranv guang sihni,",
            "Pwanzingh guang khou duppuibamv e!",
            "Duppuibamv hei ’pat zat lak ge,",
            "Pwanzingh guang khou duppuibamv e!",
            "",
            "4 Taudaic Racguangc, he duppuibamv!",
            "Pwanzingh guang khou duppuibamv e!",
            "Kaganv ’thuic ’niw ta ’khavlou o,",
            "Pwanzingh guang khou duppuibamv e!"
          ]
        }
      },
