        "content": {
          "format": "source-lines",
          "lines": [
            "1 Gaychuymei luangcbut guay khou {:1",
            "Muangh guay raapat kan pwkhou;",
            "Duibaek guay lev chyng haap guay khou,",
            "Neihriw souc liklou pwkhou,",
            "’Niu Pu latryan ta ning tow e:",
            "Muangsingc ta ’niu how pwkhou;",
            "’Niu khat khat ta thay diangc chuy ni,",
            "Muangh guay raapat kan pwkhou.",
            "",
            "’Niu ta thaymei kumc thay ni,",
            "’Niu raana tat dat lak khe;",
            "Neihlaamei gaanc chuymei tingmik,",
            "Lauthwan kiu gaanc pat pwkhou,",
            "’Niu khat khat ta thay diangc chuy ni:",
            "Muangh guay raapat kan pwkhou.",
            "",
            "2 Kaluan luan khou ’niu chaenglwan hei",
            "Lakna puat ’ritna tat re;",
            "Ryanramei khaengvna taanv sw e,",
            "’Niu laupuk kak hei duc e,",
            "’Ki “guang tho, he suaihiammei thiu,”",
            "Twna Kaipouc kaw pwkhou,",
            "’Niu lakmei guay ’muc ngam puni,",
            "Muangh guay raapat kan pwkhou.",
            "",
            "3 ’Niu neihlaa zaenggayna guang ni,",
            "Guangh bamvpaeng dinghuamc puni,",
            "Zianmei nunc ta how dat pwkhou,",
            "’Niu ta thaymei kumc thay ni,",
            "’Niu ta thuakloumei lu khwan {:1",
            "Tingkauh kachin lik puni,",
            "Zinghmei swng hei ’maan kan pwkhou,",
            "Muangh guay raapat kan pwkhou."
          ]
        }
      },
