        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Gaychamv kaeng 4^& hiw bam e,",
            "Duipui lev kandih ruc khou;",
            "Nsa tiiloumei ringhbamv chamv,",
            "Nang lev akhang tii bam e;",
            "“Ravguangc dih ta zianna",
            "KaNac Mpouh tiilou the;",
            "Thow punic Kakhou lwmmei mu",
            "Ringcsuangmei 4^& laa puni.”",
            "Gaychamv kaeng .. hiw bam e !",
            "Duipui lev kandih ruc khou;",
            "Gaychamv kaeng .. @<4 phungc guang",
            "Dwan-gay chamv nang lev akhang.",
            "",
            "2 Gaychamv kaeng ’niu ta kaw e,",
            "Meic guay ta khwmkih bamv khou;",
            "Kawmei 4^& ntaamvlou la rio,",
            "Zianna kawmei khou zih rio;",
            "“Ringhmei ’Tyan kiu Ai e,",
            "Tu tho, he ndaapcmei thiu,",
            "Nang paap 4^& haengc mumh khwan sihni,",
            "Gunh kumcna tii’phuanlou ni.”",
            "",
            "3 Gaychamv kaeng @<4 tiithay e,",
            "Tingmik ’thuic hiw tanh tanna;",
            "Tingsaengzaeng nyan nimei nunc khang,",
            "’Khwan bammei dwan siimei lam;",
            "“Ringh khang nang pak duak tho,",
            "Nzaengc khou bam saengh ritho!",
            "Thei thangc ziangrih pat dat ritho;",
            "Mai rawmei akhaengv puni!”",
            "",
            "4 Gaychamv kaeng neihlaapui khwan",
            "Kagaengv e, duh khou ‘naa khou;",
            "Kros khou theicloumei Jisu paan",
            "Kuakloumei chamv dinc bam e;",
            "“Daihmei neihlaapui chamv,",
            "Meic guay khou ai phungc guang e,",
            "Nang khang Guloumeipu puanc the,",
            "Kamei Khrista e, Guangh e.”"
          ]
        }
      },
