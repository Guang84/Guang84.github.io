        "content": {
          "format": "source-lines",
          "lines": [
            "1. Rianrapui ram hei patlouna,",
            "Kau Jerusalem than gai khou;",
            "Tabui nung rui tang ni nacho?",
            "Tingsang gai pui ram khou 9!@.",
            "He! Ningtan mak ge,",
            "",
            "Chorus:",
            "Tam dat mak pui ram khou;",
            "Ringmei dui luang e,",
            "Kanloumei guai rui jaona,",
            "Tingsang gaimei hou e.",
            "",
            "2. Laujiu Nah rui bam pui ram 9!@,",
            "Tingmik thui ai ningtan mak ge;",
            "He! Bumang thanmei sam guang o,",
            "Nang ramgai khou jai lou o.",
            "",
            "3. Hei khou 9!@ poubaumei bam e,",
            "Kalun neimik kumma ti e;",
            "Ata ti e, hei 9!@ ruina,",
            "Tingsanga ring diu khang rui."
          ]
        }
      }
    },
