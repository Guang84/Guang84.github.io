        "content": {
          "format": "source-lines",
          "lines": [
            "1 Akhou saalou o, he Kaipouc,",
            "Nang khwan 1<~ ai dinc kadai khang,",
            "Ata phulou kumc ai phu khang,",
            "Chaeng maanv bammei Nang nac nunc ta.",
            "",
            "2 Pumtan tii o, ai ding ngam khang,",
            "Taudaic, Nang ruc khou ding ’tip khang,",
            "Abaanc ’tyng patna ’khav ngam khang,",
            "Ryanra duipui khou lupmei ta.",
            "",
            "3 Tiipadiklou o, Pou, Nang <~1,",
            "Alung hei padik lyam mak saanv,",
            "Katiulou khang, tiichuangclou khang,",
            "Nang ramzian dinh khang lev thuanh khang.",
            "",
            "4 Ata piulou o, he Kaipouc,",
            "Tabui khou nic Nang ningmei khou,",
            "Nang zawpaanv ta ai how mak saanv;",
            "Nang hym daihmei ai laa mak saanv."
          ]
        }
      },
