        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Paapc mei ta Jisu laalou!",
            "Zauzian chamv hei dinc lik go;",
            "Tingkauh chaeng ’maanmei guay khou,",
            "Bumaengh ’maan nimei guay khou.",
            "",
            "Mi chamv hei suan dat dat ro:",
            "Paapc mei ta Khrista laalou!",
            "Mi chamv hei dinc nthan o:",
            "Paapc mei ta Khrista laalou!",
            "",
            "2 Guang o, zaeng tii’thaekclou ni,",
            "Lwm o, Kalat suai mak ge,",
            "Paapc geihpuimei ta sihni",
            "Khrista ^&5 laalou bam e.",
            "",
            "3 Alung ^&5 tiikhuai mak khe,",
            "Latdanv hu khou ai ’than the;",
            "’Phuammei khiu ’thanmeipu ^&5,",
            "Apaap guayna phungc kan the.",
            "",
            "4 Paapc mei ta Khrista laalou!",
            "Ata nganvna laalou e;",
            "’Phuammei guay ta khiu ’than the,",
            "Tingkauh khou ai gut nuh the."
          ]
        }
      },
