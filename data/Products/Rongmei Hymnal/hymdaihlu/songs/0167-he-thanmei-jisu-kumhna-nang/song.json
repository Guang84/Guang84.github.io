    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "He ’Thanmei Jisu, kumhna Nang",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 He ’thanmei Jisu, kumcna Nang nuhlou cho,",
            "Meic nunc #^5 Nang ta ’khuaimei latzan sw khang?",
            "Zauczihmei hu khou Nang mei nunc #^5 ganc pat,",
            "Ryanra ’khaengvmeipu.",
            "",
            "2 Thow khuay zaeng khou #^5 Nang khou keylou tu cho?",
            "Akhuay zaeng khou #^5 Nang khou keylou tuang the;",
            "Kaipouc Jisu Nang ta ai nuh mak khwan the,",
            "Nang ta thaengcluai the.",
            "",
            "3 Akhang Jisu hei Ravguangc Maansei kiu the,",
            "Nang ryanra ’khaengvloumei, Nang pumc tiipatmei,",
            "Nang ram rianra ’khaengvloumei, theicloumei 5#^,",
            "Ai ringc diu khang e.",
            "",
            "4 Hei zaeng #^5 Jisu Nang pow ai khangc ngam mak,",
            "Tingsaengzaeng Nang ta bwanna kalum bam ni;",
            "Kalaih makmei Nang ramzian makumh pwkhou,",
            "Ai hei biuh mak ge."
          ]
        }
      },
