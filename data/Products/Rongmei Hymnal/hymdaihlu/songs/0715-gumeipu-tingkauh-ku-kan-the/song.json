        "content": {
          "format": "source-lines",
          "lines": [
            "1 Gumeipu tingkauh ku kan the,",
            "’Niu khang theicloumeipu e;",
            "He raenghmun guay laanc daic pat ro,",
            "Hymdaih Guangc ta tiigut ro.",
            "",
            "Hallelujah! Hallelujah!",
            "Kahym hei dinc lik tat ro;",
            "Hymdaih lev chakhwang champouhmei,",
            "Tingsaeng Khrista khang sw diu;",
            "Guangh guay Guangc ! he ch’rynpui p’ry e;",
            "Zauczihmei ta ngamlou the;",
            "Khrista ’niu Kaipouc,",
            "Hymdaihmei Guangc e;",
            "Ringcthau rey liangmeipu e.",
            "",
            "2 Ringcthau dat reymeipu swna",
            "Jisu ’taw hei ringc bam e;",
            "He ’thanmei nunc lev baanch’ra thiu,",
            "Hymdaih Guangc ta kalum o.",
            "",
            "Khrista taanvdaih taanc luailou the,",
            "Seitaan ngamv khou >|3 thuaklou",
            "’Taw hymdaicna guanghtu bam the.",
            "Theic dat makna Guanghtu ni;",
            "Guangh guay Guangc !",
            "he ch’rinmei p’ry e,",
            "Zauczihmei ta ngamlou the;’",
            "Khrista ’niu Kaipouc,",
            "hymdaihmei Guangc e,",
            "Ringcthau rey liangmeipu e.",
            "Lauziu Nac hei biuhmei e,",
            "Hallelujah! he thuanc o!",
            "Kazanc hym dinc o, tiidaic o;",
            "Thuakloumeipu,",
            "Kaipouc, Guangh!",
            "Lauziu Nac hei biuhmei e,",
            "Hallelujah! he thuanc o!",
            "Kazanc hym dinc o, tiidaic o!",
            "Thuakloumeipu,",
            "Kaipouc Guangh!",
            "Hallelujah!"
          ]
        }
