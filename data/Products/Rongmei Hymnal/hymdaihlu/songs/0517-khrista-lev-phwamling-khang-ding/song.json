        "content": {
          "format": "source-lines",
          "lines": [
            "1 “Khrista lev Phwamling khang” ding,",
            "Lung lev baanh kariuna;",
            "Thuanhpui lat ’niu saa khang,",
            "’Suanmei ta nkhav khang;",
            "’Maanmei guay ta phu khang;",
            "“Khrista .. lev Phwamling khang.\"",
            "",
            "“Khrista .. lev Phwamling khang” ding,",
            "Lung lev baanh kariuna;",
            "Aniu panty hei tiipat re,",
            "“Khrista lev Phwamling khang.”",
            "",
            "2 “Khrista lev Phwamling khang” ney,",
            "Tingmik kathuic taanc e,",
            "Lunghgutmei lev baucna,",
            "Karamcna taanv taanc e;",
            "’Niu latryan khou ding e,",
            "“Khrista lev Phwamling khang.”",
            "",
            "3 “Khrista lev Phwamling khang” suan,",
            "“Hosanna!” saanc lana;",
            "Kamei >|3 tiiduak ge,",
            "Rihngam khang ’rianhlou e,",
            "’Niu latdanv mi hei e:",
            "“Khrista lev Phwamling khang.”"
          ]
        }
      },
