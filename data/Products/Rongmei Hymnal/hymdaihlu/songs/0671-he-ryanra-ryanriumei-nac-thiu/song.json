        "content": {
          "format": "source-lines",
          "lines": [
            "1 He ryanra ryanriumei nac thiu,",
            "Jisu zanc hei phungc tat ro;",
            "Hei #^5 tiineihlaalou puni,",
            "Tatpui bamv kathuic phungc o.",
            "",
            "Kunghmei zanc .. adih gay!",
            "Kandih #^5 machunhmei e!",
            "Kunghmei zanc... adih gay!",
            "Tingkauh khang neihlaamei e!",
            "",
            "2 Taek makna Jisu zanc phungcna,",
            "Phah hu khou n-gih sw o;",
            "’Thiammei nang ta bam haangv pw khou,",
            "Zanh hei saancna huayney o.",
            "",
            "3 He adih kungc cho, Jisu zanc !",
            "Aniu lung tiichuangc thau e,",
            "Zianmei baanc #^5 laalou pwkhou,",
            "Aniu Kalu suan pwkhou.",
            "",
            "4 Jisu zanc khou khuksun keyna,",
            "Kaphaypav khou pun keyna,",
            "Guangh guay Guangc pyrun runlou ni,",
            "Aniu tingkauh tangc pwkhou."
          ]
        }
      },
