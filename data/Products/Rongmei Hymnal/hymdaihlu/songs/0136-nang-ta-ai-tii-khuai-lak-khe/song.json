        "content": {
          "format": "source-lines",
          "lines": [
            "1 \"Nang ta Ai tii’khuai lak khe!\"",
            "Ch’rynmei zauzian latkaeng!",
            "Nang paap guay kros khou phungclou the,",
            "Chwn gayna nang tat tho.",
            "",
            "“Nang ta Ai tii ’khuai lak khe!”",
            "Suan dat kaluaih luaih o,",
            "“Nang ta Ai tii ’khuai lak khe,”",
            "Paapc taanc dat ri tho.",
            "",
            "2 “Nang ta Ai tii’khuai lak khe!”",
            "Nang khang nic ’taw nai the;",
            "“Tii’khuai dat lak khe,” nang ta nic,",
            "Kros khou ’bum key pwkhou.",
            "",
            "3 “Nang ta Ai tii’khuai lak khe!”",
            "Ai tii’khuai khang guang mak,",
            "Nang ta gulou khang Ai guang e,",
            "Paapc khou ({0 tiiduak khang.",
            "",
            "4 “Nang ta Ai tii’khuai lak khe!”",
            "Ravguangc zauzian thuanc o,",
            "He Guloumeipu ta thuanc o,",
            "Chuzaenghmei Kalat khang."
          ]
        }
      },
