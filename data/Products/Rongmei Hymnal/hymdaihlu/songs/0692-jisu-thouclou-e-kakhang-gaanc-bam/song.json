        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu !}2 ata kahaw e,",
            "Neih builwang sw bam khang;",
            "Kata tiipian khang karamc ni,",
            "Kai khou, kabamv ’thuic khou.",
            "",
            "Neih builwang, neih builwang;",
            "Jisu !}2 ata kahaw e,",
            "Neih builwang, neih builwang;",
            "Kakhang neih builwang sw ni.",
            "",
            "2 Ai zianthaymei ta kahaw e,",
            "Kadanlou thaymei ta;",
            "Kanac nunc adih neihlaa cho,",
            "’Twnmei lungc lyan ngam khang.",
            "",
            "3 Jisu ’khalou khang ai huay ni,",
            "Paapc khou keylou mak khang,",
            "Karamgai ta ai lungc lyan khang,",
            "Kakhang lungc gaanc bam khang.",
            "",
            "4 Jisu khang neih builwang sw ni,",
            "Karamc tithei ngam ni;",
            "Kaganv ’thuic Kasiamruai sw ni,",
            "Hei tangv kauh thangc lungc ni."
          ]
        }
      },
