        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc <~1 zauzian khou",
            "Ringhbamv chaeng kasiamhlou",
            "Kazauzian paan <~1 paapc mei ta",
            "Kadahlou kanlou khang.",
            "",
            "Zauzian paan <~1 gulou e,",
            "Lwmmei paan e;",
            "Lwmmei paan e nang paan hamh e,",
            "Lwmmei paan e nang paan hamh e;",
            "Taanv zaeng hamh, taanv paan hamh,",
            "Taanv zaeng hamh e gaengh sw khang hamh e,",
            "Ravguangc tuang kaipat de;",
            "Taanv zaeng hamh e gaengh sw khang hamh e,",
            "Ravguangc tuang kaipat de, (4)",
            "Rav kaipat de.",
            "",
            "2 Ravguangc tuang zauzian hei",
            "Khrista khou <~1 lyan e,",
            "Jisu kros khou theicloumei 1<~",
            "Ravguangc zauzian lyan e.",
            "",
            "3 Khrista paan Ravguangc khou,",
            "Lwmloumei kathuic 1<~,",
            "Zauzian paan ringhbamv laatow the,",
            "Ravguangc nac nunc sw the."
          ]
        }
      },
      "english": {
        "language": "english",
        "title": "\"By Grace are ye Saved!\"",
