        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Niu Ravguangc Guangh tuang baansyam guay,",
            "Khwan kauc thauna lu suan ’chamc kho:",
            "Alleluia! Alleluia!",
            "He kalaanv tiigaanhmei neihmik,",
            "He zingbangc ta tiigaanhmei bw,",
            "Pou ta thuanc o, Pou ta thuanc o:",
            "Alleluia! (3)",
            "2 He ’liu bammei ’pwanle, thuanc o,",
            "He kauh samhmei muangcle, thuanc o,",
            "Alleluia! Alleluia!",
            "He lauthwan, neihlaana thuanc o;",
            "He tingzyn gaanhriw guay, thuanc o;",
            "Pou ta thuanc o, Pou ta thuanc o:",
            "Alleluia! (3)",
            "3 He luangc bammei ’thanmei dui guay,",
            "Nang thuanhpui lu 8^& tiichu o,",
            "Alleluia! Alleluia!",
            "He tanhmei taanv taanc bammei mai,",
            "Gaanhmei, lwmmei tiiloumei mai,",
            "Pou ta thuanc o, Pou ta thuanc o:",
            "Alleluia! (3)",
            "",
            "4 He lungning ’buaihmei maansei nunc,",
            "Meic baihmei ta kuakloumei nunc,",
            "Nangniw suan o, Alleluia!",
            "He ryanra khaengv saenghmei nuncle,",
            "Kakhou nang dwanman phaiclou tio,",
            "Pou ta thuanc o, Pou ta thuanc o:",
            "Alleluia! (3)",
            "thuanc diu,",
            "Niamh keyna Kata kalum diu,",
            "Pou ta thuanc o, Alleluia!",
            "Pu, Nah ’Pouh lev Bumaengh ’Thanmei,",
            "Thuanc o, Gaanv Thumh khat Racguangc ta,",
            "Pou ta thuan o, Pou ta thuanc o:",
            "Alleluia! (3)"
          ]
        }
