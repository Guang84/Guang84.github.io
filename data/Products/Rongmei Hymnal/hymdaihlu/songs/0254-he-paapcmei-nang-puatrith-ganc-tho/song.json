          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 He paapc mei, nang puatrith ganc tho,",
            "Lungh mbangh ri tho,",
            "Dih ramgai mang khou #<8 thauna,",
            "Nang lung laanc pat tho.",
            "",
            "Panty maibungc chuangc bam khou hei,",
            "Ravguangc #<8 ’khwanna bam khou hei,",
            "Kazauzian pamv khou hanc guang tho,",
            "Ruan tat dat ri tho.",
            "",
            "2 Jisu nzaenghna kaw bam khou,",
            "Lungh mbangh ri tho.",
            "Zianna kaw bam khou kinglou tho,",
            "Nang lung laanc pat tho.",
            "",
            "3 Gaychamv #<8 ’zaenghna kaw bam khou,",
            "Lung mbangh ri tho,",
            "’Thuihmei ringcbamv hei laalou tho,",
            "Nang lung laanc pat tho.",
            "",
            "4 Kim dat zat lakmei neilaa khang,",
            "Lungh mbangh ri tho,",
            "Taek makmei chuzaenghmei laa khang,",
            "Nang lung laanc pat tho."
          ]
        }
      },
