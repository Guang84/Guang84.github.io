          "format": "source-lines",
          "lines": [
            "1 T’rou lungc khou zip bam the,",
            "Akaipouc Jisu!",
            "Kating tanghmei ’khwanna",
            "Kaipouc Jisu!",
            "",
            "T ’rou khou ^&5 Kamei thau the,",
            "Theihmei ric ta ngamlou duc lana,",
            "Zinghmei dic ta ngammei pu swna thau the,",
            "’Thanmei nunc lev tingsaeng guanghtuna lungh khang,",
            "Khrista 5^& .. ringcthau the!",
            "Hallelujah! Ringcthau the!",
            "",
            "2 Nsa khang rihgaanv e,",
            "Kaipouc Jisu ta!",
            "Nsa khang sil diangc e,",
            "Kaipouc Jisu!",
            "",
            "3 Theihmei ^&5 khaamding mak,",
            "Kaipouc Jisu ta!",
            "Theihmei ngamv sw bak the,",
            "Kaipouc Jisu!"
          ]
        }
