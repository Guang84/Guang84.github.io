    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Kabamv ’thuic Gumeipu ata zaylou o",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kabamv ’thuic Gumeipu ata zaylou o,",
            "Nang baanc tii-n-guaklou o, Nang bammei thay khang,",
            "Sauhraengh, phahkih nai sihni,",
            "ai Nang thei lay ni,",
            "Kabamv ’thuic ai lay ni, Nang zaylou ethei.",
            "",
            "He .. Guloumeipu, kabamv ’thuic",
            "Ai Nang thei lay ni, .. ai Nang thei lay ni,",
            "He .. Guloumeipu, kabamv ’thuic",
            "Nang .. zaylou ethei.",
            "",
            "2 Kabamv ’thuic Gumeipu ata zaylou o,",
            "Akhou pumtan tiilou o, paapc _>6 ngam mak khang,",
            "Achaenglwan khou zingc sihni ai ping zat lak khe,",
            "Kabamv ’thuic Gumeipu, Nang bam ’chamc ethei.",
            "",
            "3. Kabamv ’thuic Gumeipu, mi na hei huay e:",
            "’Rumpui chaeng khou zaylou o,",
            "chaeng tii ’maanlou rio,",
            "",
            "Paapc _>6 ’thiam khou duak ngam",
            "khang ata ’khavlou o;",
            "Nang _>6 zaylou ethei ai chaen maanv lak khe."
          ]
        }
      },
