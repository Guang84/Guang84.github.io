        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu, Sharon mwnpwang, akhou puangclou o,",
            "Nang tuang ’chumhmei, ’thanmei ramgai tiilou o,",
            "Pu Ravguangc ramzian ta thaymei ramgai 4^&,",
            "Tatpui bamv, ’thuic apanty khou @<4 how khang.",
            "",
            "",
            "Jisu, Sharon mwnpwang,",
            "Alung khou puangc gaanc chuyna Nang puangclou o.",
            "",
            "2 Jisu, Sharon mwnpwang, gay liangsingmei pu,",
            "Dih mwnpwang gay liangmei khang suangc gaymei pu,",
            "Nang tuang zauzian lev ’thanmei @<4 ingmik ’thuic,",
            "Apanty khou tiipadiklou khang huay e.",
            "",
            "3 Jisu, Sharon mwnpwang, tiigay ngammei pu,",
            "Nang tuang zauzian @<4 tiigaylou khang huay e,",
            "Ryanra lak bammei puatrith phunghmei nunc khang,",
            "Tiigaymei, machunhmei 4^& tiilou dat ro.",
            "",
            "4 Jisu, Sharon mwnpwang, tuai zat makmei pu,",
            "Kandih bamv ’thuic khou Nang hym daihmei how diu,",
            "Zaatc kathuic ruc khou Nang @<4 uanghtu mak saanv,",
            "Pun keyna Nang phaypav khou kalum mak saanv."
          ]
        }
