      "rongmei": {
        "language": "rongmei",
        "title": "MUHZWNG NUNC RACGUANGC",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Muhzwng nunc Racguangc, Nang suaihiamlou o,",
            "Elijah ngamv Elisha khou tii kumc,",
            "Meickin kathuic khou ’thukmei thouc khang kaw,",
            "Kin kathuic gay ranvmei kin tiisw o.",
            "",
            "2 Nang thauh teylou o, muhzwng nunc khou hei,",
            "Kaniw nu ’tak diu, Ravguangc,",
            "Nang Lat khou;",
            "Baucna saa diu, kage naimei lat 5^&,",
            "Katiulou khang, siimei ta sw bak khang.",
            "",
            "3 Tingkuh nunc hei nic huayney ngam kan diu,",
            "Kuakloumei, zianmei, chuzaenghmei nai khang;",
            "Kandihmei nunc ^&5 laa laanh pw sihni,",
            "Khrista kumc kaniw katpat ngam kan diu.",
            "",
            "4 Pou, thauh teylou o guangh swna lungh khang,",
            "Nah ’Pouh Bumaengc ^&5 pumtan tiilou o;",
            "Guangh pyrun, baengsaeng, kaniw khang hamh e,",
            "Khrista ramzian ^&5 guanghdic ta ngam ni.",
            "",
            "5 He muhzwng guangh nunc zuk 5^& hanc guang tho,",
            "He ’chumhmei lwmmei, ’niw zuk ta sin o;",
            "Jisu Khrista ’niw lev lungc ’chamclou o,",
            "Lakmei dic hei Nang guanghdic ta ’khwan e. Amen."
          ]
        }
      },
