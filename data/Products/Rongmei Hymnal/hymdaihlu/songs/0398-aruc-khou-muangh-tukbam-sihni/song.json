    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Aruc khou muangh tukbam sihni",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Aruc khou muangh tuk bam sihni,",
            "Araana tat kumc sihni,",
            "Ryanramei ding khou bam sihni,",
            "Neihlaamei ’maan kan sihni,",
            "Jisu ta akhang sw ethei,",
            "Atingpuk hei gaanc puni;",
            "Gaanc gaymei neicmik Kamei e,",
            "Bethlehem gaanchuangcna e.",
            "",
            "2 Kandih khou achaenglwan khou hei",
            "Ryanramei na ’riw sihni,",
            "Panty thingphaanmwn phu pwkhou",
            "Mwn phaan sauh ariw sihni,",
            "Jisu ta akhang sw ethei,",
            "Gay liangmei laa towmei the;",
            "Nzaengc Lili kiu Kamei e,",
            "Sharon mwn kiu Kamei e.",
            "",
            "3 Tat kanmei zianmei nunc khang ta",
            "Chwnsii-zaengsii, puihuayna,",
            "Ryanra zinghmei panty khou hei",
            "Dwangdangvmei na ariw sic",
            "Jisu ta akhang sw ethei,",
            "Katwan nganv ’duanghlou puni,",
            "Maansei mik #<8 how mak sihni",
            "Baanch’ra #<8 gaeklou puni."
          ]
        }
      },
