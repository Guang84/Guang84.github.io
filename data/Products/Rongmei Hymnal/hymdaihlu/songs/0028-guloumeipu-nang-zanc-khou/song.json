        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guloumeipu, Nang zanc khou suan dat re!",
            "Lungh khat swna thuanc e, piangpui lu ({0;",
            "Thau dingna thuanc e, ’niw piang pat ni khou,",
            "’Khwan e, Nang latkaeng chuzaenghmei Lat ta.",
            "",
            "2 Kai ’zwan tat khou chuzaenghmei tiilou o,",
            "Tingmik thaumei, luaimei Nang khou sw ni;",
            "’Taw Nang zanc saanhmei mwang lev lung guay hei,",
            "Gaeklou o, paapc khou keylou dat mak khang.",
            "",
            "3 Zingbangc saanv saengh chuzaenghmei tiilou o,",
            "Zingbangc zinghmei, gaanhmei tiiguanhlou o;",
            "Siimei khou ({0 ’niw ta gaekduaklou o,",
            "Zinghmei, gaanhmei hei khat na de Nang khang.",
            "",
            "4 Panty saanvsaengh chuzaenghmei tiilou o,",
            "Naumei nunc khang puc gaymei swlou o,",
            "’Niw ryanra guay hei Nang tii ’thaekc pwkhou,",
            "Kawlou o, ’niw ta chuzaengh suangmei khou."
          ]
        }
      },
