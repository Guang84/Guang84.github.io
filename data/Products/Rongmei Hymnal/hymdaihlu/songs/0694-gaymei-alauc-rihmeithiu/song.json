        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai ning e, p’ry guangc gaymei",
            "0({ ai pactow pwkhou",
            "Jisu ({0 kandih khou bammei dou 0({,",
            "Kamei alauc nunc ta Kapamv khou kaw guangmei,",
            "Kaniw lev ai nic tat ’chamc ni tuang e.",
            "",
            "2 Kabaanc 0({ apy khou ’baenglou",
            "khwan ’thei gay chuy ni,",
            "Kabaancpwam ({0 ata pamclou",
            "khwan ’thei;",
            "Kazawpaanv how nii e zianmei",
            "lat saa khou 0({:",
            "“Alauc nunc ta Apamv khou tii guang o.”",
            "",
            "3 ’Taw nic ai huayney khou Kaphaypav khou guang nuh e,",
            "Karamzian kadam asaekc laa nuh e;",
            "Hei khou hei lungh gutna ai Kata phu tithei,",
            "Tingkauh thangc Kata ai how ngam puni.",
            "",
            "4 Gay chuypui bamv chamdaanvlou",
            "khang Kamei tat kan the,",
            "Kuakloumei, khiu ’thanloumei kaguay khang,",
            "Alauc nunc ’peyna nic Kamei lev bam puni,",
            "Tingkauh kai hei mi kumhmei nunc khang e.",
            "Amen."
          ]
        }
