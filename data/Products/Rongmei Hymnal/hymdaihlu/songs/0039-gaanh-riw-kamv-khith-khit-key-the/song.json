        "content": {
          "format": "source-lines",
          "lines": [
            "1 Gaanhriw kamv khith khit key the,",
            "Adaeng khou zingc guang pw the,",
            "Kadanmei, pingmei maekna;",
            "Pou, Nang ta ai alamv ni.",
            "",
            "2 How ngamp’rymei Nang mik #^7",
            "Kalungc kapaengc how ngam e;",
            "’Kamhmei paap guay lyanlou o,",
            "Akhuay guay ta kuaklou o.",
            "",
            "3 Akhang kalaanv neic riw hei,",
            "Tingsaeng khang maek kan pwkhou,",
            "Paapc lev ryanramei khou #^7",
            "Laalou o, Pou, Nang pamv khou.",
            "",
            "4 Nang thu paapc maek khwan sihni",
            "Maansei ramsuan ta thay e;",
            "Nang tuang Guangc bamvpaeng khou #^7,",
            "Jisu, ata zianlou o. Amen."
          ]
        }
      },
