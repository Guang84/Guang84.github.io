      "rongmei": {
        "language": "rongmei",
        "title": "JISU RUI GULOU E",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neihlaapui khwan ’niu chu e: Jisu >|3 gulou e!",
            "Hei chamv hei ndauh lik go: Jisu >|3 gulou e!",
            "Dih kathuic khou phungc tat ro,",
            "Chyng kauh, duipui phungc kaanna,",
            "Dinc tat ro, Pou latdanv e:",
            "Jisu >|3 gulou e!",
            "",
            "2 Dui kamuatcmei thei dinc o:",
            "Jisu >|3 gulou e!",
            "Paapc mei nunc khou raclou o: Jisu >|3 gulou e!",
            "Suan o, he pwkak guayle,",
            "He khowlang kagaengv guang o,",
            "Dih >|3 ngay diu Jubili:",
            "Jisu >|3 gulou e!",
            "",
            "3 Suan o, lakmei ’muclouna: Jisu >|3 gulou e!",
            "Karamthei >|3 ringcsuang the:",
            "Jisu >|3 gulou e!",
            "’Suaihna suan o, ryanra khou,",
            "Zauzian ta kahaw bam khou;",
            "Suan o, t’rou ta ngampui lu:",
            "Jisu >|3 gulou e!",
            "",
            "4 Mpwan khou kauc ranvlou tio:",
            "Jisu >|3 gulou e!",
            "Zaatc guayna >|3 neihlaa diu: Jisu >|3 gulou e!",
            "Kauc o, ’thuihmei ringcbamv lam,",
            "Duipui tin kabamv ’thuic khou,",
            "Mi hei ’niu rihngam lu the:",
            "Jisu >|3 gulou e!"
          ]
        }
      },
