    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Duc kanmei duipaengc thangc",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Duc kanmei duipaengc thangc kandih khat chamv chu e,",
            "Kalam 6_> Baibal khou dinclou e,",
            "Khou6_> mu ryanramei, zinghmei hei nai lak khe,",
            "Ramh kaguay sii key dat lak khe.",
            "",
            "Gaymei kandic khou 6_>, duhmei duipaengc thangc 6_>",
            "Ting-neih siimei, pwanzingh maek khe;",
            "Kakaidai chaeng 6_> kachaekc _>6 sw e,",
            "Neihmik nic khat sihni keymak khe.",
            "",
            "2 ’Diakc gaymei bang guay khou ’pwan ’liu rih rilou e,",
            "Kathai 6_> kachaekc suangc kangran e,",
            "Nrah-alim khwan _>6 padik ge hei khou 6_>;",
            "Ramh kaguay sii key dat lak khe.",
            "",
            "3 Chingkhiuhmei kai nai e,",
            "Pu Ravguangc baanzat thangc,",
            "Khou6_> neihlaamei saa ngam mak khe;",
            "Kim makna lauphunhswan, nuhgaymei ’ruayna lu,",
            "Ramh guayna sii key dat lak khe.",
            "",
            "4 Theicloumei Gumeipu, Kabaanchaamvna bam e,",
            "Paapcmei ta kuaklou ni laalou ni,",
            "Kapaap kuakloumei guay hei ramc khou 6_> lungc ni,",
            "He adih gaymei lwnlung cho!"
          ]
        }
      },
