    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Jisu thay dai?",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu thay dai alung kabiuna",
            "Ai neihlaa ngam lak guang pwkhou,",
            "Puat ’ritmei phungh khou, lungh",
            "geicna bam khou,",
            "Achaenglwan tat liat lak pwkhou?",
            "",
            "Ata Kamei kadan bam e,",
            "Kalung kabiulou bam e;",
            "Kalaanv, zingbangc akhang",
            "ryanra ngam lak khou,",
            "Kamei kadanlou e.",
            "",
            "2 Jisu thay dai achaeng zingc pwkhou",
            "Tinggiumei, pingmei guang pwkhou?",
            "Kalaanv neichriw 2}? zinghmei guanh pwkhou,",
            "Zianna adaeng tuanc bam dai cho?",
            "",
            "3 Jisu thay dai ’thiammei guang pwkhou,",
            "Ai akhangv ngam lak guang pwkhou;",
            "Lungh kabiu langvna aswang maek pwkhou,",
            "Mikdui luangc taek makna bam khou?",
            "",
            "4 Jisu thay dai zian liangmei nunc ta",
            "’Tamvlouna lungh kabiu bam khou,",
            "Alung bakpui nganv ai ryanra pwkhou,",
            "Kamei lunghsuc kadan bam dai?"
          ]
        }
      },
