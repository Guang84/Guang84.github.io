    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Ai kros ricmei khat swna",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai kros ricmei akhat swna",
            "Jisu thei laymei cho?",
            "Kataanv ai taanc ping bam ni cho?",
            "Kazanc saa zak ni cho?",
            "",
            "Kazanc khou, .. kunghmei zanc khou,",
            "Theicloumei Kazanc khou,",
            "Guangh pyrun laa ni zauzian ^&5,",
            "Ai, phunghmei kros paan ^&5.",
            "",
            "2 Swan laa khang meic nunc rih ‘downa",
            "Ryanra ’khaengv bam geih khou,",
            "Ai thu amanv khang na phuna",
            "Athouc ley bam ni cho?",
            "",
            "3 Akhang thu zauczihmei maek cho?",
            "Kaan khang duidai maek cho?",
            "Siimei dic ta duang swmei ^&5",
            "Pou daeng zaylou ni cho?",
            "",
            "4 Guanghtu khang rih ’dow bam khou hei,",
            "Ngamv tiilou o, Kaipouc!",
            "Ai taanc ni, ryanramei ’khaengv ni,",
            "Nang lat ^&5 zaylouna."
          ]
        }
      },
