        "content": {
          "format": "source-lines",
          "lines": [
            "1 “Khrista lev Phwamling khang” ’niu kauc thau kho,",
            "Guigaymei ’niu Guangc zancchakhwang champouh sw kho;",
            "Chabwan pumtan ({0 ’niu chwnlouna taanc kho,",
            "Nchumhmei guanghdic khang biangpiuna ding kho.",
            "",
            "Khrista .. Thuakloumei pu khang,",
            "Khrista .. theicloumei khang;",
            "Zei ({0 liuloumei Phwamling khang,",
            "Swlou o, bauh khang, Pou.",
            "",
            "2 “Khrista lev Phwamling khang” huayney bam kho,",
            "Tingmik ’thuic kros phungcna",
            "Kachuangcphey thei lay kho;",
            "Bumaengh ’Thanmei ngamv khou tiigutlou ngam kho,",
            "Panty ganv gay khou Kasiamruai sw di kho.",
            "",
            "3 “Khrista lev Phwamling khang” p’riuhna tii kho,",
            "Kaipouc khang kaganv lev talent, syan-lanv kat kho;",
            "Gay liangmei puat-ruai guay",
            "phungc guangna tii kho,",
            "Zianmei lungning, lanv kamv makmei ei kat kho.",
            "",
            "4 “Khrista lev Phwamling khang” ’niu ganc pat kho,",
            "Kakhang khang na ningmei,liantiimei, pingmei guay;",
            "Gaymei dam guang nimei 0({ machunhlou kho,",
            "Thei thangc Kaipouc tuang baanzat thangc neihlaa ni."
          ]
        }
