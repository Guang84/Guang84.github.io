      "rongmei": {
        "language": "rongmei",
        "title": "Panty pwanzingh ’khangv bam khou",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Panty pwanzingh ’khangv bam khou,",
            "Dui kamuatc daic guang sihni,",
            "Alung geic bam khang maek ge,",
            "Pwanzingh ’liu ranv guang sihni,",
            "Akhang rungh banghchei nai the,",
            "Tingsaengzaeng kachac lak khe.",
            "",
            "Rungh banghchei lingc ’tiplou the,",
            "He pwanzingh aliu tan diu,",
            "Arungc hei ’thyam khwan sihni",
            "Nkhan zat ni tuang hamh the;",
            "Arungc bangclou the, bangc ’tiplou the.",
            "",
            "2 Adaeng khou dui kamuatc re,",
            "Dui lungc khou siimei nai e,",
            "Muangh @{4 tingpuk gumliam the,",
            "Pwanzingh nic ’liu ranv guang the;",
            "Kum sihni akhangv diw e,",
            "Taudaic khou rungh bangclou the.",
            "",
            "3 Katuakcmei @{4 thumliam guang,",
            "Ryanra dui kamuatc kumc guang,",
            "Chaeng tat ’maan khang ’thiambam e,",
            "Pwanzingh @{4 gaanhmei sw liam,",
            "Kumsic ai akhangv ngam e;",
            "Duak lakmei rungc-chei nai the."
          ]
        }
      },
