        "content": {
          "format": "source-lines",
          "lines": [
            "1 Meic guay Ravguangc",
            "KaBumaengc ^&5,",
            "Dihpy dihba zin e,",
            "Kangamv ^&5 gaanchuangc guay bangclou",
            "Kalangv akhat swna;",
            "Ringhmei, gaanhmei nsa tiilou,",
            "Maansei nac kathuic khou,",
            "Nang khou ’niw huayneyna bam e,",
            "’Niw hei khat na sw khang.",
            "",
            "2 Nang ningmei phumei nunc guay hei",
            "Kapang khat sw bam e;",
            "Nang Latdanv guay piu ’thuih ngam khang",
            "Tut makna karamc e.",
            "Kadam khat na laa ’chamc bam e,",
            "Laanhmei ta athwng khang;",
            "Bumaengh baengsaeng 5^& zay thau e,",
            "’Suanmei nunc ta gaek khang.",
            "",
            "3 ’Chumhmei khou ’niu khat na sw e,",
            "Tiibauhmei ramlwm khou;",
            "Zianmei ^&5 khat na khang bangclou,",
            "’Khavlou khang, gulou khang;",
            "Howduhmei khou khat na sw e,",
            "Chuzaenghmei guangcdic ta;",
            "Khou5^& ramh guay khat na sw ni,",
            "Ramh guay Kaipouc Nang khou."
          ]
        }
      },
