        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Ngamp’ryrimei Guangc!",
            "Nang zanc thuanh khang keyna nkhavlou o;",
            "Hymdaihmei, rih ngammeipu Ravguangc keylou o;",
            "Nganv makmeipu ’niw ruc khou guanghtu o.",
            "",
            "2 He maansei guanhmei Lat,",
            "Ngammei Nang baengsaeng _>6 sin gaeklou o,",
            "Keyna suaihiamlou o, Nang mei nunc ruc khou hei,",
            "Nang Lat ngamv nai diu khang tiisw lou o.",
            "",
            "3 He Bumaengh ’Thanmeile,",
            "’Niw lev bam ’chamclou o, mi ganv khou hei,",
            "Meic kathuic lungning khou Nang _>6 guanghtulou o,",
            "He Bumaengh, ’niw khou _>6 tat dat ri tho.",
            "",
            "4 Gaanv Thumh khat Racguangc ta,",
            "Kauh liangmei khou thuanc diu, tingsaengzaengna,",
            "Kauh liang, daic liangmei lwn kauh thangc aniu how ni,",
            "Kanganv maekna chakhwang champouh sw diu."
          ]
        }
      },
