        "content": {
          "format": "source-lines",
          "lines": [
            "1 He zauzian Kaipouc, nzianmei duipuakkai,",
            "Nang bamvpaeng hu khou khuksunna ney e,",
            "Nang samsuiloumei hei kai nowpuc ney hei",
            "Panty lunghsingna dwan-gayna lungc diu.",
            "",
            "2 Hei nei khat khat ta zian kuanghna lungc kan diu,",
            "Theihmei !}2 kaney ta tii-’tamv mak saanv,",
            "Gaanv nei kariuna Khrista khang lungc kan diu,",
            "Khrista ramgai kiu lungc lyanna lungc diu.",
            "",
            "3 Ryanra lak pwkhou Nang khou na ngangvlou diu,",
            "Chwnsii-zaengsii khou Nang !}2 swmlou diu;",
            "Zaengsii-zaenggay ’thuic gaymei khang chaklouna",
            "Gay ranvmei khang 2^< machunhna lungc diu.",
            "",
            "4 He suaihiam Kaipouc, Nang !}2 suaicsamclou o,",
            "Nang !}2 suamloumei tampy thanh khou hei",
            "Siimei khamvnamvmei guay khou !}2 gaeklou o,",
            "Tingkauh thangc Nang pamv khou zaengsw mak saav."
          ]
        }
