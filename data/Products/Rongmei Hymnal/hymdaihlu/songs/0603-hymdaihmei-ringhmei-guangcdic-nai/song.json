          "format": "source-lines",
          "lines": [
            "1 Hymdaihmei, ringhmei guanghdic nai,",
            "Kandih tuang ringhting paengc thangc,",
            "Thuakloumei tuang ch’rynmei p’ry hei",
            "Mi dic tuang latlu kiu the.",
            "",
            "Nganv makna zianmei lev thuanhmei,",
            "Mang manv tangh .. makmei hymdaih,",
            "Nganv maekmei .. ringcbamv neihlaa hei,",
            "Thuakpatloumei nunc lu the.",
            "",
            "2 Thow cho neihlaa lu suan nimei,",
            "Tingsaengzaeng nganv dat makna,",
            "Lungh ryanra, chwn swmei maekna,",
            "Zaengsiimei nai dat makna!",
            "",
            "3 Thow suan ni, Ravguangc ringcbamv lu,",
            "Thow laa ni, ringc taek makmei?",
            "Rairiumei akhaengv ngampuimei,",
            "Paapc ta ngampuimei 1<: e.",
            "",
            "4 Kaniw dih puat guay lou ducna",
            "Jisu thei laymei nunc e;",
            "Jisu kros khou theihmei paan {:1",
            "Ringhbamv laapui mei nunc e."
          ]
        }
