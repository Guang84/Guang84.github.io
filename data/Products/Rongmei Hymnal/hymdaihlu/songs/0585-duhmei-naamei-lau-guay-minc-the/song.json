      "rongmei": {
        "language": "rongmei",
        "title": "Duhmei, ’naamei lau guay minc the",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Duhmei, ’naamei lau guay minc the,",
            "Lauzamdai minc ngam bam the;",
            "Luanghbut guay lev nzaengc guay khou,",
            "Lau hei minc nzinh zin the.",
            "",
            "Laupouc, lautaymei thouclou o,",
            "’Niu huay bammei chulou o;",
            "’Taw thouclou tho, napchu khuam khang,",
            "Lautay ganv hei rii mak khou.",
            "",
            "2 Thouclou o, lauthwan khwanzingh khou,",
            "Thouclou o, kalaanv ganv khou,",
            "Tingzyn neic hei key changh mak khou,",
            "Kabamv ’thuic khou khuam tat khang.",
            "",
            "3 Napguy guay nkhuk key bam the,",
            "Khuam tho, minc raam changh mak khou;",
            "Tingzyn keyna kai guang pwkhou,",
            "’Niu neihlaana guang puni."
          ]
        }
      },
