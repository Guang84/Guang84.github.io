        "language": "rongmei",
        "title": "Jisu kaniam gayna nang ta kaw",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu kaniam gayna nang ta kaw bam e,",
            "Nang ta ata kaw bam e;",
            "Jisu ’khaengv thayna ’khwan",
            "saengcna zauc bam e,",
            "Nang lev ata zauc bam e!",
            "",
            "“Kai khou .. guang o!",
            "Ryanra lakpui mei guang o!”",
            "Lungh gutna niamh gayna",
            "Jisu kaw bam e:",
            "“Guang o, he paapc mei, kai khou!”",
            "",
            "2 Jisu kaw bam khou bui khang nyan bam ni cho,",
            "Nang lev ata kaw bam khou?",
            "Kazauzian ta bui khang thouh sw mak ni cho,",
            "Nang lev ata zianloumei?",
            "",
            "3 Kaganv hei reih reina katumcna tat the,",
            "Nang lev akhou _>6 tat the;",
            "Zinghmei lev theihmei hei anaa guang pw the;",
            "Nang lev akhang guang pw the. ’rianhlou e,",
            "Nang lev akhang ’rianhlou e;",
            "Paapc taanc khwan sihni kuaklou khang zauzian nai,",
            "Nang lev apaap kuaklou khang!"
          ]
        }
      },
