        "content": {
          "format": "source-lines",
          "lines": [
            "1 “Nang paap haengcmumh bam sihni,",
            "Gunh kumcna tii’phwanlou ni;",
            "Mi 6_> haengcmumh bam sihni,",
            "Langhpanv kumc ’phwan ni:”",
            "“Nang paap 6_> haengcmumh sihni,",
            "Nang paap 6_> haengcmumh sihni,",
            "Gunh kumcna tii’phwanlou ni,",
            "Gunh kumcna tii’phwanlou ni.”",
            "",
            "2 Nang ta huaymei khwan ’king o;",
            "Ravguangc khou hanc guang at tho!",
            "Kamei zian thaymeipu e,",
            "Zianmei Kaipouc e;",
            "Nang ta huaymei khwan ’king o:",
            "Nang ta huaymei khwan king o:",
            "Ravguangc khou hanc guang dat tho!",
            "Ravguangc khou hanc guang dat tho!",
            "",
            "3 Nang paap guay kuaklou puni,",
            "Ningtow bam dat zat lak khe;",
            "“Ata zauc lo, he meic nunc,”",
            "Ravguangc _>6 saa e.",
            "Nang paap guay kuaklou puni,",
            "Nang paap guay kuaklou puni,",
            "Ningtow bam dat zat lak khe,",
            "Ningtow bam dat zat lak khe."
          ]
        }
