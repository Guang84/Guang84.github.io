        "content": {
          "format": "source-lines",
          "lines": [
            "1 Raclou na ro Jisu p’ry 5^&,",
            "Alung khou tiirimlou o,",
            "Kungc liangmei p’ry hei raclou o,",
            "Nuh gay liangmei p’ry guangc 5^&;",
            "Baanch’ra nunc ^&5 Kamei puanh nungc",
            "Kata thuancna suan kanmei:",
            "“Kauh liangmei khou Kahym daic diu,",
            "Dih khou chuzaenghmei sw diu!”(2)",
            "",
            "2 Tazikramv khou munthiangc kanmei,",
            "Karaana akhaengv kanmei,",
            "’Niu paap zaeng Kata ’thiam kanmei,",
            "’Khamh khou Kamei rih ngammei;",
            "Raclou o, Karwanry guay 5^&:",
            "Lakloumei, ryanra ’khaengvmei,",
            "Kata malaana ganc patmei,",
            "Lungcsii, rairiu ’khaengv kanmei. (2)",
            "",
            "3 Kata kros khou hianbinloumei,",
            "Zamv suc ’khaengvna ryanramei,",
            "Kata t’rou khou mbeihloumei,",
            "Kamei ringcthau dat kanmei;",
            "Mi p’ry hei ai makumh pwkhou",
            "Karamzian thukh ai how the;",
            "Kamei ^&5 ata ranclou the,",
            "Jisu hym tingsaeng daic diu! (2)"
          ]
        }
      },
