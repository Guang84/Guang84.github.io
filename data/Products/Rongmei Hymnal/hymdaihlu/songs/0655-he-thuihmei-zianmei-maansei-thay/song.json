        "language": "rongmei",
        "title": "HE ’THUIHMEI ZIANMEI MAANSEI THAY",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 He ’thuihmei ’zianmei, maansei thay tangc lakmei",
            "Nang bamvpaeng hu khou khuksunna ney e;",
            "Mi nei ramzian hei mut makmei sw kan diu,",
            "Nang )}3 suamloumei tampy thanh khou hei.",
            "",
            "2 He Ringhmei Bangbi, mi nei khang hei Nang )}3,",
            "’Zaenghmei, zianthaymei, lwmmei tiilou o;",
            "Bauhmei machunhmei,",
            "khaengvsaenghmei tiilou o;",
            "Theic-suc ping makmei ramlum tiilou o.",
            "",
            "3 Nang tuang neihlaa )}3 dih ryanra tii-’maan diu,",
            "Nang tuang ’chu-’zaengh )}3 katuakcmei swm diu;",
            "Kaney ringcting khou gay ranvmei guang nimei,",
            "Tingsaeng hymdaihmei panty ta ning diu.",
            "",
            "4 He zianthaymei pu, kuaklou thaymei Kaipouc,",
            "’Niw )}3 huaymei hei Nang )}3 chulou diu,",
            "Mi tampy thanh khou Nang )}3 suaicsamclou tho,",
            "Pu, Nah, Bumaengh ’Thanmei zanc khou ney e. A-men."
          ]
        }
      },
