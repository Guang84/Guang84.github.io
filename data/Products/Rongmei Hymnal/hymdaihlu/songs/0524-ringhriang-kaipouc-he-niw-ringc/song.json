      "rongmei": {
        "language": "rongmei",
        "title": "Ringhriang Kaipouc he ’niw ringc",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ringhting Kaipouc, he ’niw ringcbamv Racguangcle,",
            "Zaatc guay machunc, ’niw zinghbangc khou gaanchuangcna,",
            "Chulou na ro, Nang tuang phwamling #<8 huaymei,",
            "Ngamp’rymei Racguangc.",
            "",
            "2 Rih nanw #<8 ngam lak pwkhou",
            "Nang nai e,",
            "Nang gu ngam e, paapc #<8 ’niu ta zyn pwkhou,",
            "Theihmei lev maikwam #<8 Nang ta ngam lak ge,",
            "Chuzaenghmei tii o.",
            "",
            "3 ’Niw lungchwn khou siimei chwn guay tii’maanna,",
            "Nang phwamling khou chana-punav lunghchamh khang,",
            "Kandih khou hei suc-rih maekna chuzaengh khang,",
            "Pou, mathimlou o.",
            "",
            "4 Siimei ngamv ta ’niw ngam mak saanv ’khavlou o,",
            "Nang tuang ’twnmei meic guay thay khang ’khavlou o,",
            "Pou, ’khavlou o, dih khou chuzaenghna lungh khang,",
            "Kauh thangc chuzaengh khang.Amen."
          ]
        }
      },
