        "language": "rongmei",
        "title": "KAIPOUC NANG LEV TIITATLOU O",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaipouc, Nang lev tiitatlou o,",
            "Niamhmei taanv taanh khou ’khavlou o;",
            "Nang thukh akhou dinclou na ro,",
            "Ryanra lak khou ’khavlou na ro.",
            "",
            "2 Lungh tiithau khou ’khavlou na ro,",
            "’Zianpui lat saa khou ’khavlou o;",
            "Chaeng zay thay khang ’chamlou na ro,",
            "Kai biak zaylou khang ’khavlou o.",
            "",
            "3. Nangram khaengthai ’chamlou na ro,",
            "Nang lev ’naa diangc, zian diangc bam khang,",
            "Lwmmei tiitanc thaumei taanv khou,",
            "Siimei ta ngammei ramlum khou.",
            "",
            "4 Machunhmei #^7 tiigaylou o,",
            "Guang nimei panty chaenglwan ta;",
            "Nang na tii ngammei",
            "chuzaengh khou,",
            "Kaipouc, Nang lev tiilungclou o."
          ]
        }
      },
