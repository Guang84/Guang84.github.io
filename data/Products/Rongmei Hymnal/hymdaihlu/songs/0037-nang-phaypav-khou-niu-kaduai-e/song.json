    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Nang phaypav khou ’niu kaduai e",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang phaypav khou ’niw kaduai e,",
            "Pu Ravguangc, Nang suaihiam khang,",
            "Taanphy thaymei lung padikna,",
            "Thuanckuna taanc kahouh khang;",
            "Thuanc e kauh thangc tuang gaanhriw ^&8",
            "’Niw chaeng tiigaancloumei khang;",
            "Thuanc e, zian kadanloumei ^&8",
            "Kachaekc riang kumc bangcloumei.",
            "",
            "2 Jisu, Nang paapc mei ta zianmei,",
            "Kros ruc khou 8^& lyanlou the;",
            "Thuanckuna ’niw ^&8 katlou e,",
            "’Niw lung hei Nang khang swna;",
            "Hei kumhmei Pam ’niw khang naina,",
            "Baucna hu thangc gut ni the;",
            "Suai makna ’niw ta gaeklou ni,",
            "Howmumei kathuic khou ^&8.",
            "",
            "3 Tingmik ’thuic hei gay hay hay e,",
            "Zauzian zawpaanv how pwkhou;",
            "Puatrith guay phungc gay maih puni",
            "Nang khou ^&8 guangmei thayna;",
            "Zianmei chuanghphey ^&8 hwamlou o,",
            "’Niw khou pumtan tiilou o;",
            "Laancloumei kaidai raengcmun khou",
            "Nang hym daihmei how mak saanv."
          ]
        }
      },
