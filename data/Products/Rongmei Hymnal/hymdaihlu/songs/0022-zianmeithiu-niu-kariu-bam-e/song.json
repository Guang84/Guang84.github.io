        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zianmeithiu, ’niu kariu bam e,",
            "Pu Ravguangc ta kalum khang;",
            "Lunghgutna huayneylou ni cho,",
            "Aniu Kalat dinc ni khou?",
            "Bumaengh ’Thanmei keylou mak ethei,",
            "Aniu huath hei nsa de;",
            "Zianmeithiu, aniu huayney kho,",
            "’Thanmei manna tiikey khang.",
            "",
            "2 Zianmeithiu, zauc lo, paapcmei nunc,",
            "Maikwam tin khou zip bam the;",
            "Theihmei lev maikwam guang pw the,",
            "Kaniw ta ganclou ni cho?",
            "Zauc lo, aniu pui aniupu,",
            "’Niu nac nunc paapc khou ’lip bam;",
            "Zianmeithiu, aniu huayney kho,",
            "’Thanmei manna tiikey khang.",
            "",
            "3 Tanpuithiu nic ’khavlou ni cho,",
            "Miriam, Mousi ta ’khav kumc;",
            "Paapc ric ’downa kap bammei ta,",
            "Nangniw nic ’khavlou ni cho?",
            "Guloumeipu lam dinclou tio,",
            "Kakhou guang khang dinclou tio,",
            "Tanpuithiu, aniu huayney kho,",
            "’Thanmei manna tiikey khang.",
            "",
            "4 Aniu Ravguangc ta nzian kho,",
            "Khat lev khat ta nic zian kho;",
            "Paapcmei nunc khang huayneylou kho,",
            "Kaniw 6$% puancthanh mak saanv,",
            "’Niu ta tingkauh thangc kaw guang khou,",
            "Kakuakpaeng khou dungc ’chamc ni;",
            "Khrista $%6 ’niu siamruai swna,",
            "’Thanmei manna ’zanh puni."
          ]
        }
      },
