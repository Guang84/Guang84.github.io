      "rongmei": {
        "language": "rongmei",
        "title": "Thuanc o, thuanc o!",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Thuanc o! thuanc o!Thuakloumeipu Jisu zanc ta!",
            "He kandihle, Karamzian suan ’dauh o,",
            "Thuanc o! thuanc o! daic liangmei tingkauh baanch’ra guay;",
            "Pumtan chakhwang Kazanc khou tiigut ro!",
            "Lauziu gaenghmei kumc Kanac nunc ta gaeklou,",
            "Kabaancpwam ^&5 neih maryn pamclou e.",
            "",
            "Thuanc o! thuanc o!",
            "Jisu hym daihmei suan dauh o;",
            "Thuanc o! (2) tingsaeng eihlaa lu ^&5!",
            "",
            "2 Thuanc o! thuanc o! Thuakloumeipu Jisu zanc ta!",
            "’Niu paap zaeng khang ryanra, zei key, theiclou;",
            "Kamei ’niu khang Taudaic, nganv makmei ringcbamv e;",
            "Thuanc o! thuanc o! theicloumei Jisu ta,",
            "’Niu rianra guay Khaengvloumeipu ta thuanc o,",
            "Saa ngam makmei, ch’rynmei ramzian thuanc o!",
            "",
            "3 Thuanc o! thuanc o! Thuakloumeipu Jisu zanc ta!",
            "Tingkauh raengckat “ Hosanna! ” kagaengv diu!",
            "Guloumeipu Jisu tingsaeng khang guanghtu the;",
            "Pyrun ’lou o, Muhzwng, Tingkuh, Guangh khou!",
            "Khrista key the, kandih ta hei rih ngamna,",
            "Pumtan, hymdaih hei Poubauhmei tuang e."
          ]
        }
      },
