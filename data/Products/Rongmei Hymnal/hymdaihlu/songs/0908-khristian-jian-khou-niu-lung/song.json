        "content": {
          "format": "source-lines",
          "lines": [
            "1. Khristian jian khou niu lung,",
            "Bangmei riang guigai diu;",
            "Chun cham kadam lacham meihei,",
            "Kau thang lunlung kumme.",
            "",
            "2. Niu pu bampaeng hu khou,",
            "Niu huainei mei bun lou;",
            "Niu pingmei tammei machun mei,",
            "Kadan mei khat na de.",
            "",
            "3. Rianra akhang chammei,",
            "Puatrit mei phung chammei;",
            "Khat khat khang mikdui kei loumei,",
            "Jianmei khristian riak ge.",
            "",
            "4. Aniu tammei gan khou,",
            "Lung rianramei nai e;",
            "Kumsi niu lung alam bamni,",
            "Gaina riu dat mak san."
          ]
        }
      }
    },
