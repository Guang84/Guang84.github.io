        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Maanmei ta phu o, zianna kaw guang o,",
            "Chaeng ’maanna nwm khou maeng tatmei ta;",
            "Akhou guang o,” ’seic Kaipouc kaw bam e,",
            "Mi lat hei kaniw khou dinclou tio.",
            "",
            "Tatpat duc o, .. chyng daihmei thangc 4@<,",
            "Phungc guang dat ro, maeng tatmei ta phu guang o,",
            "Thuakloumei pu .. lauziu kuanc lung khou,",
            "Paapc khang khaengloumei Lauziu Nac,",
            "Jisu pamv khou.",
            "",
            "2 ’Maanmei ta phu o, Jisu khou guang khang,",
            "’Suanmei bumaengc ta chaeng zaylou o;",
            "Kaniw ta ringhbamv chaeng khou zaylou o,",
            "Ringhmei chaeng kaniw khou dinclou o.",
            "",
            "3 Zianthaymei taanv hei aniu taanv sw ni,",
            "Tingmik thuic Kaipouc phaykaamv suicna,",
            "Zaengsii tiineihlaa, bowmei zaythauna,",
            "’Maanmei ta Jisu khou zaylouna."
          ]
        }
