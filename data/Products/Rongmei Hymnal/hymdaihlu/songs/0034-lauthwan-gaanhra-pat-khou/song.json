        "content": {
          "format": "source-lines",
          "lines": [
            "1 Lauthwan gaancra pat khou",
            "Ai zip thauna thuanc e,",
            "Jisu ta thuanc kan diu!",
            "Tanc bam khou, huayney khou;",
            "Jisu khou ngangvlou e,",
            "Khrista hym tiidaic diu.",
            "",
            "2 Ravkai kaeng hiw pwkhou,",
            "Chingh zaengc chu lik pwkhou,",
            "Jisu ta thuanc kan diu!",
            "King o, suan bammei kiu,",
            "Neihlaana hiw bam khou,",
            "Khrista hym tiidaic diu.",
            "",
            "3 Zingbangc kalaanv guanh e,",
            "Mi lu hei suan pwkhou,",
            "Jisu ta thuanc kan diu!",
            "Zinghmei ngamv _>6 ping e,",
            "Mi lu hei chu pwkhou,",
            "Khrista hym tiidaic diu.",
            "",
            "4 He maansei zaat guayle,",
            "Lungh khat swna suan o,",
            "Jisu ta thuanc kan diu!",
            "Kandih kabamv ’thuic khou,",
            "Neihlaa lu hei suan diu,",
            "Khrista hym tiidaic diu."
          ]
        }
      },
