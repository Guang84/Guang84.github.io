          "format": "source-lines",
          "lines": [
            "1 Kauh kaidai thangc azanc ’thanna",
            "Ai pac towpui nungc kiu,",
            "Pingmei kaguay ’maan ngam puni;",
            "Amikdui thutphui ni: (3)",
            "Pingmei kaguay ’maan ngam puni,",
            "Amikdui thutphui ni.",
            "",
            "2 Kandih <~1 ata zauczihna",
            "Mailu peic guang sihni,",
            "Seitaan lungpuam 1<~ ping makna",
            "Dih ngamv ta akhangv ni; (3)",
            "Seitaan lungpuam ta ping makna",
            "Dih ngamv ta akhangv ni.",
            "",
            "3 Katuakmei duidai kumc guang diu,",
            "Ryanra pwanzingh guang diu,",
            "Gayna tingkauh ai tangc puni,",
            "ARavguangc pamv ’zwan ni; (3)",
            "Gayna tingkauh ai tangc puni,",
            "ARavguangc pamv ’zwan ni.",
            "",
            "4 Khou kiu lakmei abumaengc hei",
            "Kauh khou zaeng ’thaekc ni the,",
            "Ryanramei hei nai dat lak khe,",
            "Chuzaenghna lungc ni the; (3)",
            "Ryanramei hei nai dat lak khe,",
            "Chuzaenghna lungc ni the."
          ]
        }
