        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Aseic akhang nthuanh guang mak nuh e,",
            "Nthuanh neihmik patmei how mak nuh e;",
            "’Seic tingzyn ?|7 ataanv luai bam nuh e,",
            "Aseic akhang nthuanh guang mak nuh e.",
            "",
            "2 Aseic akhang, neihlaapui lu suan khang,",
            "Alu ?|7 gaanv saekc ta katiu nuh e;",
            "Aphaykaamv suangc kakaamv ’suan bam nuh e,",
            "Aseic akhang, neihlaapui lu suan khang.",
            "",
            "3 Aseic akhang, ’zian thaypui taanv taanh khang,",
            "Puatrith phungc bammei nunc ta ’khavlou khang;",
            "Bumaengh ’saekc ta ’khavlou khang ai tat ni,",
            "Aseic akhang, ’zian thaymei taanv taanh khang.",
            "",
            "4 Aseic akhang nthuanh guang mak nuh e,",
            "’Seic neih key khou apanty luai nuh e;",
            "Kaipouc akhou “Gay the,” twlou ni cho?",
            "Aseic akhang nthuanh guang mak nuh e."
          ]
        }
      },
