        "content": {
          "format": "source-lines",
          "lines": [
            "1 Daihmei Poubauhmei zaylou o!",
            "Tazikramv khou tat bam khou;",
            "Ai suan e, ’ki Nang thu tanc e,",
            "Ngammei baanc ^&8 zaylou o;",
            "He tingkauh ’tyan, he tingkauh ’tyan;",
            "Ata tii n-gulou o! (2)",
            "",
            "2 Alyngmei duipuak laanclou o,",
            "Ringhphaengdui patmei duipuak;",
            "Maibwang lev muanghtiangc ^&8 ata,",
            "Chaenglwan saanvsaengh zaylou o,",
            "Thuakloumei pu,Thuakloumei pu,",
            "Apumtan n-gih Nang e. (2)",
            "3 Jordan tin khou ai tat bam khou,",
            "Pingmei tii-amaanlou o,",
            "Dui daic bam khou zay kaanlou o,",
            "Kanaan khou zay guanglou o;",
            "Thuanhpui lu ^&8, thuanhpui lu ^&8,",
            "Ai tingsaeng Nang ta thuanc ni! (2)"
          ]
        }
      },
