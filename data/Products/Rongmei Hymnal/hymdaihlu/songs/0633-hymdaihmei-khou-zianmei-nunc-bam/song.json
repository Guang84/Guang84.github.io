          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Hymdaihmei khou zianmei nunc bam,",
            "’Taw kaniw lev ’tamv bam e,",
            "Kandih panty luaipui nungc kiu",
            "Kaniw lev lungc ’chamc ni cho?",
            "",
            "Kaikhunh ’tamv makna lungc ni cho,",
            "Thei thangc kiu, thei thangc kiu,",
            "’Khwan bammei kai gay ranvmei khou,",
            "Tingkauh khou, tingkauh khou?",
            "",
            "2 Zaenggay panty alauc dou 7}$,",
            "Zianpui p’ry kaniw rac e,",
            "Zian thaymei pu Jisu lam e;",
            "’Taw kaniw Jisu lev bam.",
            "",
            "3 Tingkauh lu 7}$ nang makumh o,",
            "Alauc dou suan bammei 7}$,",
            "Heipui lu 7}$ lunghsii mak cho?",
            "Kandih lu 7}$ kahaw cho?",
            "",
            "4 Reydouc maimangh daeng dungc hwamna",
            "Bammei douc ta makumh o;",
            "Kapna ’tamvmei 7}$ makumh o;",
            "Nang ta ganclou duh nungc 7}$.",
            "",
            "5 Khat khat swna tat ngam kan the,",
            "Kaniw bamv ganc nsalou the;",
            "Khou hei kaikhunhmei guay ’tamv the;",
            "Neih khat kariu dat ni cho?"
          ]
        }
      },
