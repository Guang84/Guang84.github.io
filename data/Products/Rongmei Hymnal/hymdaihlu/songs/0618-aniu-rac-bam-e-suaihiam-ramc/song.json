        "content": {
          "format": "source-lines",
          "lines": [
            "1 Aniu rac bam e suaihiam ramc,",
            "Gaanhmei gaychuymei dic lam 4^&,",
            "Karamgai lam rac katub e;",
            "Guang tangc pwkhou adih gay ni!",
            "",
            "Hei khou 4^& ! .. hei khou 4^&!",
            "Guang tangc pwkhou adih gay ni!",
            "Hei khou 4^& ! .. hei khou 4^&!",
            "Guang tangc pwkhou adih gay ni!",
            "",
            "2 Aniu rac bam e kachaekc chaeng,",
            "Kaphut @<4 karuhmei raengc lam,",
            "Saa ngam makmei karamgai lam,",
            "Guang tangc pwkhou adih gay ni!",
            "",
            "3 Paapc khou @<4 duakna nyngswmei,",
            "Ryanra, ’thiammei khou @<4 duakmei;",
            "’Chanvmei maekmei ramc tingkauh khou,",
            "Guang tangc pwkhou adih gay ni!",
            "",
            "4 Neihlaa, ryanra guay khou ’niu ta",
            "Tingkauh thangc khang chamdaanvlou o;",
            "’Saanh mak khou ’niu thay puni the,",
            "Khou4^& guang lunghmei ramgai kiu."
          ]
        }
      },
