        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang tuang Baibal sin tat ro,",
            "Kasuaihiam guay tiipat ro;",
            "Kaganv ’thuic nang ta ’khavlou ni,",
            "Sin tat ro tatpui bam ’thuic!",
            "",
            "Sin tat ro tatpui bamv ’thuic,",
            "Sin tat ro tatpui bamv ’thuic,",
            "Ravguangc zianmei chamv",
            "kauh thangc tuang Lat hei,",
            "Sin tat ro nang tatpui bamv ’thuic.",
            "",
            "2 Kuakloumei Lat sin tat ro,",
            "Tingmik thuic gay hay hay ni;",
            "Gaanv saekc chu niina ’khwan bam e,",
            "Sin tat ro tatpui bamv ’thuic.",
            "",
            "3 Ch’rynmei p’ry hei sin tat ro,",
            "Lungh ryanra bammei nunc khang;",
            "Suaihiammei, thuakloumei chamv hei,",
            "Sin tat ro tatpui bamv ’thuic.",
            "",
            "4 Latryan Lat hei sin tat ro,",
            "Paapc mei nunc paap ngamv khou $%6",
            "Ravguangc tuang duakmei chaeng thay khang,",
            "Sin tat ro tatpui bamv ’thuic."
          ]
        }
      },
