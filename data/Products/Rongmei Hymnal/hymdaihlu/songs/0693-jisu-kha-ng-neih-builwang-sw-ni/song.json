        "content": {
          "format": "source-lines",
          "lines": [
            "1 Gaymei alauc ricmei thiu,",
            "Neihlaa lu 1<: kauc ranv o,",
            "Jisu ringc e twmei chamv",
            "Dinc lik go.",
            "Kros khou Kamei theiclouna",
            "’Niu paap guay Kamei phungclou,",
            "’Taw ’niu ta tiiduaklou khang",
            "Ringc bam e.",
            "",
            "Gaanthauh maihna saeng-dai mak saanv,",
            "Nangniw ’khwan bam riu,",
            "Jisu khang kariuna suan o,",
            "Tatpui bamv ’thuic khou.",
            "Nang khwan kauc ranvna suan o,",
            "Tingpuk kandih kagaengv diu,",
            "Jisu ringc bammei chamv hei",
            "Dinc lik go.",
            "",
            "2 Alauc nunc giu-gau makna,",
            "Chabwan nunc {:1 neihlaana,",
            "Kandih lev duipui ’thuic khou,",
            "Suan lik go.",
            "Maansei zaat guay khang gaanhmei,",
            "Mik tiatmei khang how datmei,",
            "Meic kathuic khang ringhmei nai,",
            "Jisu khou.",
            "",
            "3 Jisu ringc e, ch’rynmei chamv.",
            "Guangh guay Guangc, Kaipouc guay Pouc,",
            "Kros 1<: puanc kauhna suan o,",
            "Jisu khang.",
            "Paapc kangkai sw raalou the,",
            "Theihphey guay ganc pat kan the,",
            "Theihmei ta ngamlou duc the,",
            "Tingsaeng khang."
          ]
