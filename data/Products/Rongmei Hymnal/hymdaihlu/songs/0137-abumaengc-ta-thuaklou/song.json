        "content": {
          "format": "source-lines",
          "lines": [
            "1 Abumaengc ta thuaklou khang <~1",
            "Kros khou ryanra akhangvloumei,",
            "Gumeipu Jisu ramzian hei,",
            "Ai saa dat ngam mak khe!",
            "",
            "",
            "Karamzian saa dat ngam mak khe!",
            "Karamzian saa dat ngam mak khe!",
            "Jisu <~1 ata zianmei hei",
            "Ai saa dat ngam mak khe!",
            "",
            "2 Ai ringcsuangna ringc bam khang <~1",
            "Kamei ryanra phungcloumei 1<~,",
            "He, sauh pyrun runloumei 1<~,",
            "Ai saa dat ngam mak khe!",
            "",
            "3 Akhang huayney bammei Khrista,",
            "Kapaan chuzaenghmei naimei hei,",
            "Kunghmei Khrista tuang zei thukh hei,",
            "Ai saa dat ngam mak khe!",
            "4 Kamei ’naa bam khou neilaa hei,",
            "Kamei tiimei zaeng thaekmei hei,",
            "Kakhou naimei machunhmei hei,",
            "Ai saa dat ngam mak khe!"
          ]
        }
      }
