        "content": {
          "format": "source-lines",
          "lines": [
            "1 Akhang huayney bammei",
            "Gumeipu nai e,",
            "Kandih pamrai rau sihni Kamei nai e;",
            "’Taw hei Kamei ata zianna gaeklou bam e,",
            "Gumeipu the twna nang nic laa la tho.",
            "",
            "Nang khang huayney bam e,",
            "Nang khang huayney bam e,",
            "Nang khang huayney bam e,",
            "Ai huayney bam e.",
            "",
            "2 Ata zianmei pu Ravguangc nai, Kamei ?|7",
            "Akhang tingsaeng khang",
            "machunhmei tiilou the,",
            "Kauh thangc Kata sowriw khang",
            "kaw nuangc puni the;",
            "Nang nic tat ’chamc nuh ethei adi gay ni!",
            "",
            "3 ’Phwan krip ripmei pheychuan",
            "khat akhang nai the,",
            "Mi 7?| tingkauh thangc akhang",
            "daeklou bam the,",
            "Hei di kachanmei pwan 7?| ai",
            "laapui nungc kiu",
            "Nang khang nic tiimei ta ai how puni cho?",
            "",
            "4 Duiriang kumc ’chuzaenghmei akhou nai e,",
            "Mi hei kandih rup nunc ?|7 thay zat a de,",
            "Hei 7?| nang khang nic laa kan",
            "khang machunh e."
          ]
        }
