        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Niu ta bangcloumei zianmei hei",
            "Phak dat makmei sw diu;",
            "’Niu pumc swna tat ’tamv sihni,",
            "Lungning thu khat na de.",
            "",
            "2 Khrista khou ’niu guay alamv e,",
            "Thouhpui bamv khou tat re,",
            "Jisu phaykaamv suicna tat re,",
            "Karamgai lungc lyan e.",
            "",
            "3 Kamei lev ’niu tat ’chamc bam diu,",
            "Baihmei ^&8 khamv makna;",
            "Theicloumei Jisu ta hamhna",
            "Baihmei ta ning mak diu.",
            "",
            "4 Gumeipu zauzian laa ’chamcmei,",
            "Lungh khat chwn khat swna",
            "Ryanra, neihlaa, ringhmei, theihmei,",
            "Hei guay ^&8 tii ’tamv lak,"
          ]
        }
      },
