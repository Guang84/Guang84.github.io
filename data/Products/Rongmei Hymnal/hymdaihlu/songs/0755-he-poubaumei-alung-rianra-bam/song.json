      "rongmei": {
        "language": "rongmei",
        "title": "He poubaumei alung rianra bam",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. He poubaumei alung rianra bam,",
            "Sansimei rui gumliam louna;",
            "Kapmei le rianra jingmei kgou hei,",
            "Nikdui keina ai phu guang e.",
            "",
            "Chorus:",
            "He poubaumei alung geimei kapum,",
            "Nang banpa dai khou ti kan the;",
            "Lungeimei ti neila kaipou,",
            "Tingmik thui ti neila lou o.",
            "",
            "2. He poubaumei alung neila khang,",
            "Nang ram mak neila khang mak ge;",
            "Thou kum mei khou ai juan nicho?",
            "Ata ti neila khang nang na de.",
            "",
            "3. Lung rianra muang rui akhang jinghjing,",
            "David guang kanloumei pilung;",
            "Rianramei ata suliam lou,",
            "Rianra nkhuaimei aini guang e.",
            "",
            "4. Reikhou Kanan ram bam kathui khou,",
            "Jangsimei guai ti neila lou;",
            "Rianramei guai nang ta huai e,",
            "Akhang neila liangmei nang nade."
          ]
        }
      },
