          "format": "source-lines",
          "lines": [
            "1 Ai kai tangc pwkhou kachaekc pyrun run ni,",
            "Ai kai tangc pwkhou puatc ’ritmei loukey ni,",
            "Ata phungc guangmeipu p’ry 5^& ai rac puni;",
            "Chingkhiuhmei pwan piu ni, kai tangc pwkhou.",
            "",
            "Kai tangc.. pwkhou, kai tangc .. pwkhou,",
            "Ryanra ryanriumei guay hei nai dat lak khe;",
            "Kai tangc.. pwkhou, kai tangc.. pwkhou,",
            "Ryanra ryanriumei guay hei nai dat lak khe.",
            "",
            "2 Ai kai tangc pwkhou zinghmei guay nai lak khe,",
            "Ai kai tangc pw khou gaanhmei kiu how puni,",
            "Gaanhmei kauh thangc keyna achaeng khou gaanc puni,",
            "Zaylou puni ata, kai tangh mak saanv.",
            "",
            "3 Ai kai tangc pwkhou Poubauhmei zaw how ni,",
            "Ai kai tangc pwkhou zauzian lu suan dat ni;",
            "Kahu khou ai dingna Kata bwanna bam ni;",
            "Taek makna lungc ’chamc ni, kai tangc pwkhou."
          ]
        }
