        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guangh hu khou ’niu ding puni,",
            "Baanch’ra guay lev suan puni;",
            "Thei thangc kiu, thei thangc kiu!",
            "Gaanhmei kachaekc dui khuangc",
            "khou",
            "Taek makna Kata thuanc ni,",
            "Thei thangc kiu, thei thangc kiu!",
            "",
            "Guangh hu khou .. ’niu ding puni,",
            "Baanch’ra guay lev suan puni,",
            "Aniu Guangc hym daic kan diu!",
            "Hallelu .. jah! Hallelu.. jah!",
            "Guangh hu khou ’niu ding puni.",
            "",
            "2 Hiw o, he tingkauh kaeng guay!",
            "Guangh hu khou ’niu ding puni,",
            "Thei thangc kiu, thei thangc kiu!",
            "Khou2}? ’niu ryanra duak ni;",
            "Kazanc ta thuancna bam ni,",
            "Thei thangc kiu, thei thangc kiu!",
            "",
            "3 Thau tho, he abumaengcle,",
            "Guangh hu khou nang ding puni,",
            "Thei thangc kiu, thei thangc kiu!",
            "Nang swan Kahu khou lou o,",
            "Kakumc nthuihmei sw o;",
            "Thei thangc kiu, thei thangc kiu!"
          ]
        }
