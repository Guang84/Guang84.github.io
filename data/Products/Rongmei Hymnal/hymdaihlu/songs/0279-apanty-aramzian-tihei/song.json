        "content": {
          "format": "source-lines",
          "lines": [
            "1 Apanty, aramzian tii the,",
            "Theiclou kanmei Lauziu Nac khou;",
            "Kaganv ’thuic lwm nuhmei sw ni,",
            "Gumeipu, aRavguangc!",
            "",
            "Ai lungc ni the Gumeipu khang,",
            "Adihkamv ai neihlaa ni cho!",
            "Ai lungc ni the Gumeipu khang,",
            "Gumeipu aRavguangc !",
            "",
            "2 Laalou puni twmei lwm the,",
            "Ai ringh khang {:1 Nang theiclou the;",
            "’Taw {:1 thauna Nang khou lwm ni,",
            "Gumeipu aRavguangc!",
            "",
            "3 Ata thuaklouna tiiduak khang",
            "Kalvari khou theicloumei pu;",
            "Apanty Nang khang tiigut the,",
            "Gumei pu aRavguangc!"
          ]
        }
      },
