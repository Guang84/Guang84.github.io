        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zuk kathuic hu biak thangc,",
            "Kariang taek makna,",
            "Lwmloumei nunc tat re;",
            "Ravguangc kawmei khou;",
            "Kaipat thu bai bai e,",
            "Lungning khat na de;",
            "Taanvbamv kasing geic e,",
            "Swan thu khat na de.",
            "",
            "Zuk kathuic hu biak thangc,",
            "Kariang taek makna,",
            "Lwmloumei nunc tat re,",
            "Ravguangc kawmei khou.",
            "",
            "2 Guanghdic daic khith khit re,",
            "Zianmei ^&8 sin e;",
            "Lwmmei how tangh mak saanv",
            "’Niu taanc ranv bam ni;",
            "Muhzwng nunc dinc kasuakc,",
            "Martair nunc ^&8 suan,",
            "Lu hymei nunc thuanc e,",
            "Bauhmei nunc theiclou.",
            "",
            "3 ’Niu raa na rih ngam mak,",
            "’Niu raa na bouh mak,",
            "Ngammei, bauhmei kathuic",
            "Meic guay kazauh e;",
            "Ravguangc taanv ^&8 bangclou",
            "Ringhmei phwam swna,",
            "’Niu kalung nchamc e,",
            "Tangc nimei biak thangc."
          ]
        }
