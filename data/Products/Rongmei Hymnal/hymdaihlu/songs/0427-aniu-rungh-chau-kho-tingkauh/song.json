        "content": {
          "format": "source-lines",
          "lines": [
            "1 Aniu rungh chau kho tingkauh ’zwanna,",
            "Machunhmei rungcphey 3>| laamv o;",
            "Zianmei nunc ’khwan bammei ta ning o;",
            "Rungh ’thaekc pwkhou sowriw pw nimei.",
            "",
            "Mikdui tangv neihriw khou guang kariuna",
            "Taanv guay luaina guang zaengthaek kariuna,",
            "’King o, thuakloumei kangdai >|3 lu suanmei kiu!",
            "Dwan-gaypui kai khou guang kariu bam the!",
            "",
            "2 Aniu rungh chau kho tingkauh ’zwanna,",
            "Pingpui tuang maekna tat di kho;",
            "Chuzaenghmei rungh ’thaekcbamv ’naa pwkhou,",
            "Rungh ’thaekc bamv tuang gaanhmei ta how ni.",
            "",
            "3 Tingkauh luangcbut hei gay e, gaanc e,",
            "Lauphunhswan mwn >|3 karuh e;",
            "’Niu ta zianna Thuakloumei pu khou,",
            "Neihlaana thuanckupui lu suan ni.",
            "",
            "4 Tingkauh tuang ’pwan 3>| liu rih ri e,",
            "Lauthwan ramgai 3>| gay changh e,",
            "’Zianmei nunc ta sowriw nuangc ni the,",
            "Khou kiu ryanra, theihmei nai lak khe."
          ]
        }
      }
