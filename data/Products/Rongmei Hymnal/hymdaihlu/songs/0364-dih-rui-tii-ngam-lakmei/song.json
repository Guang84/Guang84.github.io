        "content": {
          "format": "source-lines",
          "lines": [
            "1 Dih $%6 tiingam lakmei chuzaenghmei akhou nai,",
            "Mi hei dih $%6 laa ganc ngam mak;",
            "Nchanvmei $%6 muangh kumc padik guang pw sihni,",
            "Alung khou chuzaenghmei ’maan dat lak.",
            "",
            "Taek .. makna nai bam e,",
            "Ji ..su akhang,",
            "Taek .. makna nai bam e, ingkauh neihlaa;",
            "Kamei ganc ’rulou zat lak, zianna saalou e;",
            "“Ai nang ta ’pat zat lak,”",
            "Jisu akhang!",
            "",
            "2 Dih kapwm Ravguangc ta thuancku bam tu kumc the,",
            "Chuzaenghmei akhou gut pwkhou,",
            "Ryanra guay tat kan the, zingbangckalaanv guanh the,",
            "He Jisu, Nang hym adih daic cho!",
            "",
            "3 Bih $%6 swmei ravkai, akhou lanv hei nai the,",
            "Kaphaypan dih khou ruan bam khou;",
            "Hymdaihpui neic ata laa khang key dat puni,",
            "Tingkauh akai khou 6$% lungc diu khang!"
          ]
        }
      }
