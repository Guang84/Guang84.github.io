    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "’Seic gaanhmei tingmik ge",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Seic gaanhmei tingmik ge;",
            "’Seic hei gaanhmei nai diu;",
            "Guang gaanclou o, ’niw zingbangc khou,",
            "Zinghmei hac ganclou o.",
            "",
            "2 ’Seic ’thaekcmei tingmik ge;",
            "’Niw zaeng tiitanc dat khang;",
            "Lakmei buak lev pumh khang Nang #^5",
            "Pumtan zikdui tii o.",
            "",
            "3 ’Seic chuzanghmei neic e;",
            "Chuzaenghmei nai kan diu;",
            "Lungh ’chamh makmei tii ’maanlou o,",
            "Agay ’gimei ’thaekc diu.",
            "",
            "4 ’Seic huayneymei neic e;",
            "Tingkauh ’naa guang pw diu;",
            "Nang khiuzaeng laa khang phaengc ku e,",
            "Keyna sowriwlou o.",
            "",
            "5 Rey liangmei tingmik ge;",
            "Nang thiu mbunlou o;",
            "Theihmei lung hei tiichuangclou o,",
            "Theihmei ta ngammei pu."
          ]
        }
      },
