        "content": {
          "format": "source-lines",
          "lines": [
            "1 He tingkauh Pu, Kazauzian #<8",
            "’Niw bumaengc ta rancloumeipu,",
            "Nang hu khou ’niw ’bumkey bam e,",
            "Kuakloumei zauzian tiilou o.",
            "",
            "2 Ngamp’rymei Nah ’Pouh, he Latkaeng,",
            "Muhzwng, Tingkuh, Thuakloumeipu;",
            "Nang hu khou ’niw ’bum key bam e,",
            "Guloumei zauzian tiilou o.",
            "",
            "3 Tingsaeng Bumaengc Kangamv paan #<8",
            "Theihmei bumaengc tiiringhmeipu;",
            "Nang hu khou ’niw ’bum key bam e,",
            "’Niw ta tiichuangc thaulou na ro.",
            "",
            "4 He Ravguangc Pu,Nah ’Pouh, Bumaengh;",
            "He Gaanv Thumh khat swmei Racguangc,",
            "Nang hu khou ’niw ’bum key bam e,",
            "’Niw khou Nang zauzian tiilou o."
          ]
        }
      },
