        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu khou ai tiigut ngam the,",
            "Ramh kapwmna tiigut the;",
            "Kaganv ’thuic ai lwm ni zian ni,",
            "Tingmik ’thuic Kakhou lungc ni.",
            "",
            "Ai tiigut ngam the, (2)",
            "He Gumei pu, ramh guay",
            "Nang khou",
            "Ai tiigut ngam the.",
            "",
            "2 Jisu khou ai tiigut ngam the,",
            "Nang phaypav khou kalwm e;",
            "Kandih thala guay ganc ngam the,",
            "Ata laalou tho, Jisu.",
            "",
            "3 Jisu khou ai tiigut ngam the,",
            "Nang mei ling tiiswlou o;",
            "Bumaengh ’Thanmei sakhi sw diu,",
            "Ai Nang tuang, Nang hei akhang.",
            "",
            "4 Jisu khou ai tiigut ngam the,",
            "Ai kahak tiigutlou the;",
            "Zauzian, pumtan padiklou o,",
            "Aruc khou suaihiamlou o."
          ]
        }
      },
