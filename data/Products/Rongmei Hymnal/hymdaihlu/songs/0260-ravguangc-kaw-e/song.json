      "rongmei": {
        "language": "rongmei",
        "title": "Ravguangc kaw e",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc kaw e! ai chu lak cho?",
            "Dih thala ta ai zian ni cho?",
            "Panty tingkwm samc tat bam khou,",
            "Abumaengc ziprii bam ni cho?",
            "",
            "Kaw .. bam the, chu la tho! (2)",
            "Ravguangc kaw bam e;",
            "He Kakhwan ’king o, kaw e!",
            "Kaw .. bam the, chu latho! (2)",
            "Ravguangc kaw bam e,",
            "He chu lo, kaw bam e!",
            "",
            "2 Ravguangc kaw e! ai thau lak cho?",
            "Kamei kawmei thouhsw lak cho?",
            "Karamzian ta sinnui ni cho?",
            "Kaw bam khou ai nyan ngam ni cho?",
            "",
            "3 Ravguangc kaw e! ai piu lak cho?",
            "Kangkai khou bam tanh tan ni cho?",
            "Ai nyan sihni ’patlou mak ge,",
            "’Taw nganv kaw bam, thau tho alung!",
            "",
            "4 Ravguangc kaw e! bam ngam mak khe,",
            "Ai nuhlou the, nyan ngam mak khe;",
            "He kandihle, bam duc khwan tho!",
            "Ravguangc khwan alung khou tangc the."
          ]
        }
      },
