        "content": {
          "format": "source-lines",
          "lines": [
            "1 Abumaengcle, nang khang",
            "Guloumeipu,",
            "Nsa tiilou bam the;",
            "He Pou, ’taw hei alung ding rap ni the,",
            "Nang ta ai laa ni the.",
            "",
            "Ai ding ni the!",
            "He Pou, ai Nang tuang sw ni the,",
            "Nang ’khavlouna!",
            "Kunghmei Nang zei @{4 ata liulou the,",
            "Ai hei Nang tuang di the!",
            "",
            "2 Zauzian paan ai ’taw Nang zauzian laa ni,",
            "Nang ramzian @{4 ngam the:",
            "He Pou Khrista, Nang khou ai lwm ni the,",
            "Nang khou na lwm ni the.",
            "",
            "3 Ai adih ’suan, Poubauhmei, Nang thay e,",
            "Chaeng maanv pingmei thay e;",
            "Siamruai sw khang Nang khou pumtan ney e,",
            "Nang na de tiingammei!",
            "",
            "4 He Pou, ’niw lev bam ’chamcmei nunc khou nic",
            "Nang zauzian tiilou o;",
            "Lungsyng thangc @{4 ’niw lev suan ’chamc nuh khang",
            "“Ai Khrista tuang sw ni!”"
          ]
        }
