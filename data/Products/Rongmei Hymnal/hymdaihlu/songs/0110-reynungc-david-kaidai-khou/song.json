        "content": {
          "format": "source-lines",
          "lines": [
            "1 Reynungc David kaidai khou 8}@",
            "Khouringh kai khat nai khwan e,",
            "Kapui #<8 KaNac ta ’zilou,",
            "Kiruai gypuikuak lungc khou;",
            "Hei pui 8}@ niamhmei Meri e,",
            "Ngana 8}@ Pou Jisu e.",
            "",
            "2 Kauh thangc #<8 kandih khou key e,",
            "Kamei meic guay Racguangc e;",
            "Khouringh kai ta Kakai sw e,",
            "Guaihkuak ta Kazy sw e;",
            "Lungcsiimei, ryanramei ding khou",
            "Lungclou e, Guloumeipu.",
            "",
            "3 Aniu alauc nunc daicthau kumc",
            "Khith khitna daicthau khwan e,",
            "’Thyammei, ’suanmei, kapmei, nuihmei,",
            "Kamei nic ’niu kumc thay e,",
            "Aniu ryanra Kamei thay e,",
            "Neihlaa nic neihlaa ’chamc e.",
            "",
            "4 Thei thangc ’niu mik #<8 how puni,",
            "Thuakloumei zauzian paan #<8;",
            "’Niu kunghmei, niamhmei Ngana hei",
            "Tingkauh thangc ’niu Kaipouc e;",
            "Kamei #<8 tatpui bamv thangc 8}@",
            "Zaylou e, Kanac nunc ta.",
            "",
            "5 Heipui guaickai khou 8}@ hamh the,",
            "Guaih bampui bamv khou hamh the,",
            "’Niu how nimei thu kauh khou de,",
            "Ravguangc tuang baanzat khou de;",
            "Kanac nunc guangh pyrun run ni,",
            "’Phwanmei pwan piulou puni."
          ]
        }
      },
