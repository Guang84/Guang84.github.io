    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Lakna ruan tingsaengc lak khe",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Lakna ruan tingsaengc lak khe,",
            "Kai tangc puni the!",
            "Pwanzingh akhangv saengc lak khe,",
            "Kai tangc puni the!",
            "Tingmik asaekc kros phungc ethei,",
            "Khrista lev pyrun run puni;",
            "Lakna ruan tingsaengc lak khe,",
            "Kai tangc puni the!",
            "",
            "Kaganv duithuak kaanna",
            "Tingsaengzaeng ’thaekc puni;",
            "Lakna ruan dat lak khe,",
            "’Niu kai tangc pwkhou!",
            "",
            "2 Kapmei zingbangc saengh mak khe,",
            "Kai tangc puni the!",
            "Rigaanv bam tingsaengc lak khe,",
            "Kai tangc puni the!",
            "Paapc ric asaekc ngam khang nai e,",
            "Napchu asaekc khuam khang nai e,",
            "Lakna ruan tingsaengc lak khe,",
            "Kai tangc puni the!",
            "",
            "3 Zianmei riang tap saengc lak khe,",
            "Kai tangc puni the!",
            "Zianmei lat saa saengc lak khe,",
            "Kai tangc puni the!",
            "Ramnavmei luan asaanh makna",
            "Kanaan dic khou gut puni the,",
            "Lakna ruan tingsaeng lak khe,",
            "Kai tangc puni the."
          ]
        }
      },
