        "content": {
          "format": "source-lines",
          "lines": [
            "1 He ’king o, aniu ch’rynpui p’ry hei,",
            "’Maan kanmei ta phutow e;",
            "Tingkauh hymdaihmei khou $%6 keyna",
            "Manv tiina ’niu ta gulou.",
            "",
            "Thow $%6 ’maanmei khou $%6 gulou?",
            "(Kros khou theihmei Ravguangc Nac $%6)",
            "Kamei ’bui taanc?",
            "(Kamei theiclou)",
            "’Taw ’bui thangc bam?",
            "(Nang lwm o, Kamei kauh thangc huayney bam e)",
            "Tingkauh thangc huayney bam e.",
            "",
            "2 Kauh baanch’ra $%6 Kaphaan lyn ngam mak,",
            "Kauh liangmei sw bam sihni;",
            "Kros khou ’patloumei ’zianmei pu 6$%,",
            "Gaanv Thumh khat Racguangc 6$% e.",
            "",
            "3 Gumei pu khou nang tiigut ngam cho?",
            "Kapamv khou lungh niamh keyna",
            "Karamzianlou nang nic thay puni,",
            "Nang ta ’taw gulou puni."
          ]
        }
      },
