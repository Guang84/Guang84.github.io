    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Ai paapc zeic khou zuanglouna",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai paapc zeic khou zuanglouna,",
            "Thau dat ngam mak khwan e;",
            "Apaap khang lungh kabiuna,",
            "Zianlou khang huay khwan e;",
            "Ai ngam makna huaymei khwan",
            "Duipuipouc #^7 chulou;",
            "Khrista #^7 zay thaulouna,",
            "Ai ringc dat the.",
            "",
            "Zianpui zaeng #^7, zay thaulou e;",
            "Khrista #^7 ata zianna zay thaulou e;",
            "Zianpui zaeng #^7, zay thaulou e;",
            "Khrista #^7 ata zianna zay thaulou e.",
            "",
            "2 Theic nuhmei bumaengc guayle,",
            "Jisu gaeklou ngam e;",
            "Nang ta zay thaulou puni,",
            "Dui kamuatcmei khou #^7;",
            "Kamei duidai Kaipouc e,",
            "Dui #^7 Kalat piu e;",
            "Kamei gulou nii bam the,",
            "Aseic guang tho!",
            "",
            "3 Dui kamuatc kumc ryanra khou,",
            "Ai ngam mak bam pwkhou;",
            "Kamei abaanc zaylouna,",
            "Kamei suaihiamlou e;",
            "Pingpui tuang guay tii ’maanna,",
            "Alung tiikwnlou e;",
            "Kalat piumei guay ta zaeng",
            "Tii ’thaekclou e."
          ]
        }
      },
