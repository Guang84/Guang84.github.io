    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "’King o ! he abumaengc!",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 King o! he abumaengc! kauh baanch’ra nunc lu,",
            "Dih lev duipui khou kagaengv lik bam e;",
            "Kaniw lu #<8 dinhmei latchamv adih gay,",
            "Paapc nai dat lakmei panty thanh chamv e.",
            "",
            "He baanch’rathiu, biang piumei swna suan o!",
            "Tingkauh lu chyam 8}@ ’niw khou suanlou o,",
            "Kapmei zingbangc neihlaa lauthwan guanh mak saanv,",
            "Ryanramei hei neihlaamei sw mak saanv.",
            "",
            "2 Duh thangc tingzyn kaeng khwan chu guangmei kumcna",
            "Jisu khwan #<8 chyng, zaengc duipui lik ge;",
            "Lakmei bumaengc ching ching #<8 ’zwanna guang e;",
            "He Jisu, Nang daeng khou zay guanglou o.",
            "",
            "3 “Guang o, lakmei bumaengc!” Jisu kaw bam e,",
            "Mi lu hei ’niu kingna hu thangc gut kho;",
            "Zinghmei bamv khou lu khwan hei kagaengv bam e,",
            "Gaychamv lu #<8 ’niu ta kai thangc zaylou."
          ]
        }
      },
