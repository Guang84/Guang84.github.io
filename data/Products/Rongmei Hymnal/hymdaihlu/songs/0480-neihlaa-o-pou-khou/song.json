          "format": "source-lines",
          "lines": [
            "1 Neihlaa o, Pou khou! neihlaa, Kazauzian khou!",
            "Bangh swmei khou }?2 ’patlou the:",
            "Zei }?2 thuaklou the, ’bui khang ping bam ni cho,",
            "Jisu aniu khang sw bam khou?",
            "",
            "Ravguangc hei ’niu biak liangcna bam ethei,",
            "’Niu biak liangc ethei,",
            "Thow }?2 ’niu ta ngam ni?",
            "Thow, .. thow, .. thow?",
            "Thow }?2 aniu ta ngam bam ni cho?",
            "",
            "2 Kaipouc khou tanc o! Kangamv khou neihlaa o,",
            "Tingmik machang Kalat piu o;",
            "Siimei taanc pwkhou nzihmei khang bauc o,",
            "Kamei hei aniu pumtan e!",
            "",
            "3 Lwm o, Kalat khou, Kalatryan suai mak ge;",
            "Kakhou “N-guay lev Amen” e;",
            "Kandih ’maan sihni Kalat thu ’maan lak ge,",
            "Mi latdyng hei kalaic lak ge.",
            "",
            "4 Kaipouc khou bam o, gaekloumei khou bam o;",
            "Mi hei ringcsuangmei panty e,",
            "’Suan liangmei ta nganv Kabaancpav lungc khou }?2",
            "Asut pat dat ngam zat lak khe!"
          ]
