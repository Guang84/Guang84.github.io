    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Khrista khou neihpat neihkey maek",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Khrista khou neihpat neihkey maek,",
            "Dihpy dihba maek ge.",
            "Mi hei zianmei phwam daih khat de,",
            "Dih pwm tuang phwam dai de.",
            "",
            "2 Khrista khou kabamv ’thuic mei lung",
            "Lungh khat chwn khat sw e;",
            "Kataanvruai hei kachaekcriang e,",
            "Meic guay ta banglou e.",
            "",
            "3 Lwmmei khou chana swmei thiu,",
            "Nang zaat baic baic sihni,",
            "Pu ta na swna siamruaimei",
            "Khrista khwangmei nunc e.",
            "",
            "4 Khrista khou neihpat neihkey k’riu,",
            "Dihpy dihba k’riu the;",
            "Khrista luihmei guay khat na de,",
            "Kandih pwm khat na de."
          ]
        }
      },
