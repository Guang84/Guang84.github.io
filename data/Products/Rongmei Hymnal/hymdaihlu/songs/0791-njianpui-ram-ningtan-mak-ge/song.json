        "content": {
          "format": "source-lines",
          "lines": [
            "1. Njianpui ram ningtan mak ge,",
            "Rianra ram me khou hei;",
            "Lungbam san hei rianra khang nai,",
            "Ai leini kap pui ram.",
            "",
            "Chorus:",
            "Kandih rianramei man pu khou,",
            "Kap pui tingmik ni man ni;",
            "Poubaumei lun hou pu khou rui,",
            "Ning dat lak khe kandih hei.",
            "",
            "2. Kalvari nthuk pui jei rui,",
            "Tingkau kaikham lan lou;",
            "Gut la tho he abumang le,",
            "Nang ram tang khang na the.",
            "",
            "3. Kapmei rianra mei man ni the,",
            "Jordan duipang thang 3)_;",
            "He abumang le pat la tho,",
            "Kandih kap pui ram hei.",
            "",
            "4. Tabui nung guang tang nina cho?",
            "Tingkau gaipui ram 3)_;",
            "Kandih ram hei pat lou pukhou,",
            "Ning lak khe kap pui ram."
          ]
        }
      }
    },
