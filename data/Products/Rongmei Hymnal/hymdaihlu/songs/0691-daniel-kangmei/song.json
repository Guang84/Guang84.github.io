          "format": "source-lines",
          "lines": [
            "1 Jisu thouclou e, Kakhang gaanc bam khang,",
            "Khuailiw thaucmai kumc zinghmei khou gaanc bam khang,",
            "Zinghmei kandih khou hei gaanc bam khang,",
            "Nang )}3 nang tuang kwn khou, ai akwn khou.",
            "",
            "2 Jisu thouclou e, Kakhang gaanhriw khang,",
            "’Niu maibwang ’thyam sihni",
            "Kamei how ngam de,",
            "Kauh thangc )}3 zauc keyna how bam e,",
            "Nang )}3 nang tuang kwn khou,ai akwn khou.",
            "",
            "3 Jisu thouclou e, Kakhang gaanc bam khang,",
            "Kandih kabamv ’thuic zinghmei )}3 padik ge;",
            "Paapc lev ryanramei khou tiigaanc kho,",
            "Nang )}3 nang tuang kwn khou, ai akwn khou."
          ]
