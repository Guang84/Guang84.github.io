          "format": "source-lines",
          "lines": [
            "1 Ravguangc ta ’thanmei ramhou gai khou kalum o,",
            "Py ’bum keyna Kahym daihmei suan o;",
            "Latpiumei kachaek lev lungniamhmei agaw 7}$",
            "Phungc guangna bwan diu, Poubauhmei zanc ta.",
            "",
            "2 Kadanmei puatphung 7}$ Kaphaypav khou lou o,",
            "Kamei nang ta Kangaeng khou pamclou ni;",
            "Nang ta swmlou ni nang ravsuai dawlou puni,",
            "Nang phaikaamv ta Kamei #^7 zaylou ni.",
            "",
            "3 Katuang Ravkai khou tat gut khang nang howrouh riu,",
            "Nang ramlungsii ta ningna tingsik riu;",
            "’Chumhmei ramgai lev zianmei tuang lunghgutmei 7}$",
            "Ravcha swna Kakai khou katlou o."
          ]
        }
