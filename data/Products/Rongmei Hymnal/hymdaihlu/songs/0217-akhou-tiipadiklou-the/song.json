        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Niw pangc khou tiikeylou the,",
            "Tingkauh ngamv tingriuc kumcna;",
            "Padikna bun keylou e,",
            "Akhou tiipadiklou the.",
            "",
            "Hallelujah ! thuancku e,",
            "Tingriuc kumc tiikeylou the,",
            "Padikna bun keylou e,",
            "Akhou tiipadiklou the.",
            "",
            "2 Kauh zauzian riw keylou o,",
            "’Niw pangc khou Nang bamlou o;",
            "Nang ladanv tiipatlou o,",
            "Akhou ’taw tiikeylou khang.",
            "",
            "3 Nang khou na pumtan nai e,",
            "Nang paan hamhna lungc ngam lak;",
            "Nang taanv khang pumtan tii o,",
            "Akhou ’taw tiikeylou o."
          ]
        }
