        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neihlaa kaeng hiw e, alauc nunc lu suan bam e,",
            "Kaniw lu #^7 kachin the;",
            "Neihlaamei lu khwan #^7,",
            "zaenggaymei khwanring #^7,",
            "Lu riang 7}$ tiipadik the.",
            "",
            "Neihlaa kaeng khwan hiw nthaekc riu nang tuang kaeng khwan.",
            "’King o, suan bammei lu khwan, neihlaa kaeng khwan.",
            "Alauc nuncle, suan ’thaekc riu nangniw lu swan 7}$,",
            "’King o,suan bammei lu khwan, neihlaa kaeng khwan.",
            "",
            "2 Neihlaa kaeng hiw e alauc nunc lu suan bam e,",
            "’King o, kaniw khwan ranvna,",
            "Aniu nu khou chu guang bam e, chingkhiuh lu 7}$,",
            "Tingkauh tuang lu khwan kumc e.",
            "",
            "3 Kandih gaanc gay ranv kumc",
            "lungning neihlaa ranv kumc,",
            "Kaniw lu khwan gaymei #^7,",
            "Lungning ryanramei tii ’maanna tiineihlaa e,",
            "Neihlaana suanmei khwan #^7.",
            "",
            "4 Neihlaa lu khwan hei ’naa ranv e, chu ’than ranv e,",
            "Lungh kadunhmei maek pwkhou,",
            "Tingpuk hei how gay e, lu hei chu ’than ranv e,",
            "Neihlaa kaeng khwan kabamv ’thuic."
          ]
        }
      }
