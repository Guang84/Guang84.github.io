          "format": "source-lines",
          "lines": [
            "1 He lauziu Gaenghmei pu ’niw ta,",
            "’Niw zaeng tiitanclou o,",
            "Tazikramv khou tuang manna lev",
            "’Tauhbut tuang dui 8^& ^&8.",
            "",
            "2 Ndaapc t’riina ngam mak bam e,",
            "Nang sw kanmei kumcna,",
            "Nang rianra paan ^&8 tiiguangmei",
            "Kauh neilaa ta phu e.",
            "",
            "3 Taektw na ^&8 ’niw ringc ngam mak,",
            "Zauzian Latkaeng paan ^&8",
            "Tingkauh ’zwan khang pumtan tiilou,",
            "’Niw lunghpui bamv tangh khang.",
            "",
            "4 ’Tyan bybak khou bam ’chamclou o,",
            "’Niw ta gancrulou rio,",
            "Guloumei pu bam ’duanghlou o,",
            "’Niw ta tiitulou o.",
            "",
            "5 Zauzian paan ^&8 tu ’chamclou o,",
            "Nang pumc lev Nang zei 8^&",
            "Ringhmei ’tyan, drakhadui swna,",
            "Tingsaeng tiitulou o. Amen."
          ]
        }
