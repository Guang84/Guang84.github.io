        "content": {
          "format": "source-lines",
          "lines": [
            "1 Paapc lev siimei lung padik sihni,",
            "Poubauhmei, Nang khou lwmna guang e,",
            "Nang khou sw ’than patlou khang ngamv nai:",
            "Kai khou ai guang the.",
            "",
            "Kai guang the, kai guang the,",
            "Paapc chaeng khou ai maeng",
            "tat bam saengc lak khe,",
            "Ai kai guang the, kai guang the,",
            "He Pou Jisu, ai kai guang the.",
            "",
            "2 Chaeng ’maanmei nac ta kapu phu kumc,",
            "Phu e, ata Nang tazikramv khou;",
            "Paapc }?2 sw ’phuammei ngamv maekmei e:",
            "Kai khou ai guang the.",
            "",
            "3 Niamh gayna kawpui khwan ai chu e,",
            "Hei kumhmeipu ta ai ganc ni cho?",
            "Akhuay lev pingmei Nang laa ganc ni:",
            "Kai khou ai guang the.",
            "",
            "4 Kunghmei Khrista zei luangc keymei }?2",
            "Khiu ’thanlou o, gunh kumcna ’phwan khang;",
            "Kaipouc, Nang khou na ai lwm ni the;",
            "Kai khou ai guang the."
          ]
        }
