        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Pou, aniw guang e,",
            "Nang tiiloumei chaeng khou;",
            "Nang latdanv khou saamei piuna,",
            "Latryan daihmei sw e.",
            "",
            "2 Nthanmei riak ta hei",
            "Suaihiamlou o, he Pou,",
            "’Niw ta Nang khou tiibamlou o,",
            "Pumtan nic tiilou o.",
            "",
            "3 Nang tuang ’thanmei phwam khou",
            "Bamna kadam laa khang,",
            "Nang siamruai 1<: ’twnna sw khang,",
            "’Thanmei riak hei laa ni.",
            "",
            "4 He Pou, Nang lev aniw",
            "Dui-t’rou khou phup ’chamcna",
            "Bumaengh khou ringcthaumei sw ni,",
            "Nang latdanv hei piu ni.",
            "",
            "5 He Pou, suaihiamlou o,",
            "Nang latdanv piu bam khou,",
            "Reynungc Nang khou keymei 1<: kumc",
            "Bumaengh samc keylou o."
          ]
        }
