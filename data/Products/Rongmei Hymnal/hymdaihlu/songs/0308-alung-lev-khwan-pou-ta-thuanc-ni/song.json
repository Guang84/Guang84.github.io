      "rongmei": {
        "language": "rongmei",
        "title": "Alung lev khwan Pou ta thuanc ni",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Alung lev khwan #<8 Pou ta thuanc ni,",
            "Kakhou ai neihlaa bam ni,",
            "Kamei zianloumei lu ai suan ni,",
            "Mi hei alu sw ni.",
            "",
            "Apaap guay Kamei phungclou kan the,",
            "Nthan e, Kazanc! ’Thanmei zanc thuanc o!",
            "Apaap guay Kamei phungclou kan the,",
            "Hallelujah! Kazanc khou!",
            "",
            "2 Apaap guay phungcna Kakhou guang the,",
            "Chuzaengh lev zaengthaek laa khang,",
            "Ai #<8 huaymei chulou, tiiduaklou,",
            "Mi hei alu sw ni.",
            "",
            "3 Abuc tut key khou nganv ai thuanc ni,",
            "Theihmei ta ngammei zaeng khang;",
            "Tingsaengzaeng ai Kata thuanc bam ni,",
            "Mi hei alu sw ni."
          ]
        }
      },
