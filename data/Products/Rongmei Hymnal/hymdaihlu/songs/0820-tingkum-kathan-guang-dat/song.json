        "content": {
          "format": "source-lines",
          "lines": [
            "1. Tingkum kathan guang dat puthe,",
            "Chunsi jangsi pui tuang gei e;",
            "Kabam kathui phangjao bam khou,",
            "Njianmei nun guai ntang mak.",
            "",
            "Chorus:",
            "He buithang bam cho jianmei nun,",
            "Poubaumei tingsang gai pui ram;",
            "Guango he ringmei mun gaimei,",
            "Rim gaimei mun 1@: la dikho.",
            "",
            "2. Kagan 1@: rui tak dat lak khe,",
            "Kachak namdai gaimei khou 1@:;",
            "Rianra rianriu mei nai lak khe,",
            "Tingsang gaichui pui ram khou 1@:.",
            "",
            "3. Ai ninge njianpui ram 1@:,",
            "Juan dikho rianra ram khou rui;",
            "Tingsanga Salem namthan gaimei,",
            "Njianmei nun bam pui ram 1@:."
          ]
        }
      }
    },
