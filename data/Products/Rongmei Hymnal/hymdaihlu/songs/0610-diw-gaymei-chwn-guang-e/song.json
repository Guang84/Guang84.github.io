        "content": {
          "format": "source-lines",
          "lines": [
            "1 Diwgaymei chwn guang e,",
            "Kaluaih luaihna guang e,",
            "Aseic akai ’naa ranv guang the,",
            "Rey khou suangc ’naa guang the.",
            "",
            "‘Naa the akai, ’naa the akai,",
            "‘Naa ranv guang the akai aseic,",
            "Rey khou 6_> suangc ’naa the.",
            "",
            "2 ’Naa guang the, aPu kai,",
            "Khou6_> kai ’peyna nai;",
            "’Phwanmei guangh bamvpaeng ’naa ranv the,",
            "’Naa the kachaekc kaidai.",
            "",
            "3 Panty ramvrei ’naa the,",
            "’Ritmei puat lou key khang;",
            "Kros 6_> ganc key khang ’naa ranv the,",
            "Pyrun laa khang ’naa the.",
            "",
            "4 Akhou ’naa guanglou o,",
            "Aphaydyng sii pwkhou;",
            "Kai tangh khang ’naa ranv the aseic,",
            "Ai ningmei suangc ’naa the."
          ]
        }
      }
