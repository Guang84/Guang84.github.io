          "format": "source-lines",
          "lines": [
            "1 Kabai guang o! ’taw nganv bamv nai he,",
            "Guangh _>6 khwmkihmei khou tu khang;",
            "Kabai guang o! Kakai padik kan diu,",
            "Ndaapcmei, lungcsiimei tu diu.",
            "",
            "Chaengdai khou lev chaengkwn haengkuaic khou 6_>,",
            "Paapc chaeng zinghmei bamv khou 6_>,",
            "Tat ro, tat ro, zianpui lung phungcna;",
            "’Maanmei guay ta khuam guang o!",
            "",
            "2 Kabai guang o! ’taw nganv bamv nai he,",
            "’Niu lung hei adih kabiu cho!",
            "Kawmei ta thouh swlou",
            "makmei nunc 6_>,",
            "Kawpui khwan chu dat pw lak khe!",
            "",
            "3 Kabai guang o! ’taw nganv bamv nai he,",
            "Mi hei tingkauh Racguangc Lat re;",
            "He, kabai guang geic o, zauzian kai khou,",
            "Guloumeipu zauzian pamv khou!"
          ]
        }
