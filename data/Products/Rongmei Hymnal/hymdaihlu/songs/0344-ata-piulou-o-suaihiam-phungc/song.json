            "1 Ringhting tuang chaengluang dai lev chaengbian khou,",
            "Ryanra lakna bam geic the,",
            "Zingh khou bammei khang gaanhmei phungc guang tio,",
            "Ryanra lung tiineihlaa tio.",
            "",
            "Ata piulou o, suaihiam phungc guang khang,",
            "Jisu ramgai akhou how diu;",
            "Ata piulou o, he Guloumei pu;",
            "Aseic gaanv saekc khang",
            "suaihiam phungc guang khang.",
            "",
            "2 Khrista lev Kazauzian p’ry raclou tio,",
            "Karamkuaklou tuang chamv 8}@,",
            "Nang lwnlung khou Karamgai lungc lyan tio,",
            "Meic nunc Kakhou lwm puni.",
            "",
            "3 Nang #<8 laatowmei kumc tiipat dat ro,",
            "Kakumc nang nic zianthay o,",
            "’Suanmei nunc ta ’’khavlou thaymei sw o;",
            "Nang thouc taanc chuyna taanc o."
          ]
