          "format": "source-lines",
          "lines": [
            "1 ’Niu thuanc kho, Ravguangc tuang ch’rynmei Kazauzian khang,",
            "Taek makna gaeklou bampui zaeng khang;",
            "Agaw rym kumc ’niu thuanhmei khwan nic ku kan diu,",
            "Kalum khang guang kaduai bam khou hei.",
            "",
            "",
            "Thuanc di kho, kalum kho,",
            "Katuang taanv guay zaeng khang,",
            "Karamgai, Karamgaeklou dinc kho;",
            "Agaw rym kumc ’niu thuanhmei khwan nic ku kan diu,",
            "Kalum khang guang kaduai bam khou hei!",
            "",
            "2 ’Niu thuanc kho, Kazauzian tuang ch’rynmei kaipat 3)^,",
            "Kamei )}3 ’niu khou lyanloumei khang;",
            "Jisu lev madyatna kadam laa ’chamc pwkhou,",
            "Kabamvpaeng daeng ’niu ta zay guang ni.",
            "",
            "3 Huayney kho, Kasuaihiam taek makna tiilou khang,",
            "’Niu chaenglwan tiigaanclou bam diu khang;",
            "Kamei )}3 aniu ta tii’thuihloupui paan )}3,",
            "’Niu bumaengc Kaguangcdic khou lungh khang."
          ]
        }
