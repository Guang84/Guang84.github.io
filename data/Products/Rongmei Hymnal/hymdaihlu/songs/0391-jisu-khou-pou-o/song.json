        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ryanra bam cho, nang lung zingc bam tu cho?",
            "Jisu khou pou o, Jisu khou pou o;",
            "Zaengsii bam cho, nang neihlaamei ’maanna?",
            "Jisu khou na poulou o.",
            "",
            "Jisu khou pou o,",
            "Jisu khou pou o,",
            "Kamei thay dianghmei Pam e;",
            "Chana, nang khang Kakumhmei Pam maek ge,",
            "Jisu khou na poulou o.",
            "",
            "2 Taek makna nang mikdui key bam tu cho?",
            "Jisu khou pou o, Jisu khou pou o;",
            "Meic nunc hu khou ’kamhmei paap nang nai cho?",
            "Jisu khou na poulou o.",
            "",
            "3 Ryanramei muangh zinghmei ta nang ping cho?",
            "Jisu khou pou o, Jisu khou pou o;",
            "Nthuanh khang nang lung ryanra bam tu cho?",
            "Jisu khou na poulou o.",
            "",
            "4 Theih khang pingmei >|3 lungh katuakc bu cho?",
            "Jisu khou pou o, Jisu khou pou o;",
            "Khrista guangcdic 3>| how khang machunh cho?",
            "Jisu khou na poulou o."
          ]
        }
      },
