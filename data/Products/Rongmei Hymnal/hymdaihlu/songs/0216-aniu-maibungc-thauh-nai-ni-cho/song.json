    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Aniu maibungc thauh nai ni cho?",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Aniu maibungc thauh nai ni cho,",
            "Nowpouc guang pwkhou?",
            "Aniu mairiw gaanc chuy ni cho,",
            "Nowpouc guang pwkhou?",
            "Zingbangc kiu, ch’rynpui zingbangc,",
            "’Niu maibungc gaanc gay ni cho,",
            "Nowpouc guang pwkhou.",
            "",
            "He, chamdaanv lo! (3)",
            "Nowpouc guang pwkhou!",
            "",
            "2 “Nowpouc guang the, ariw la tho,”",
            "Kawmei chu ni cho?",
            "Neihlaapui khwan kauc ’daw ni cho,",
            "Nowpouc guang pwkhou?",
            "Zingbangc kiu, ch’rynpui zingbangc,",
            "’Niu maibungc gaanc chuy ni cho,",
            "Nowpouc guang pwkhou?",
            "",
            "3 Chamdaanv luai nyan bam la ri tho,",
            "Nowpouc guang mak saanv;",
            "Ntamvpui tuang pat maanv pwng e,",
            "Nowpouc guang pwkhou;",
            "Zingbangc kiu, ch’rynpui zingbangc,",
            "’Niu maibungc gaanc chuy ni cho,",
            "Nowpouc guang pwkhou?",
            "",
            "4 Hymdaicna ’niu ariw puni,",
            "Nowpouc guang pwkhou!",
            "“Hallelujah! kaucna ’riw ni,",
            "Nowpouc guang pwkhou!",
            "Zingbangc kiu, ch’rynpui zingbangc,",
            "’Niu maibungc gaanc chuy puni,",
            "Nowpouc guang pwkhou!"
          ]
        }
      },
