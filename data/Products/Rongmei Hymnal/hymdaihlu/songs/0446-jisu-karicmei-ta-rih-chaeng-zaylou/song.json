        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’King o, kawpui khwan hei:",
            "“Aseic thow tat ni?",
            "Asiamruai sw nimei",
            "Lat piu nimei thow?",
            "Thow chuanghphey kazit ni?",
            "Thow rih khou gut ni?",
            "Ravguangc lev ’chumhmei khang",
            "Thow rih aphyan ni?”",
            "",
            "Jisu Karicmei ta",
            "Rih chaeng zaylou e,",
            "Rih ngamna ’chumhmei @{4",
            "Kandih sin puni!",
            "",
            "2 Ravguangc ngamv ta lwm o,",
            "Rih hei ngam mak saanv;",
            "Seitaan ric aphyan tho,",
            "Rihpwan na piu tho,",
            "’Thanmei, kachangcmei khang",
            "Adow bam khou hei,",
            "Lungning baanc kariu tho,",
            "Ravguangc khang thau tho!",
            "",
            "3 King o, rihmei nunc khwan",
            "Ruanna suanmei khwan:",
            "“Niu ricpy hym daic diu,",
            "’Niu Guangc hym daic diu!”",
            "Dih kwn padeih mei guay",
            "Lungh khat na swna,",
            "Suanmei khwan 4@< ’king o,",
            "Rihbamv tatpui khwan!"
          ]
        }
