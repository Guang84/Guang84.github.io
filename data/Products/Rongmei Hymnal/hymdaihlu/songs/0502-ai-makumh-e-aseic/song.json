        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai makumh e aseic, neihmik key kan pwkhou",
            "Tangc nimei gaychuypui ramc ta 6_>;",
            "Zauzian paan _>6 Gumei pu daeng khou ding pwkhou",
            "Apyrun khou gaanchuangc nai ni cho?",
            "",
            "Apyrun khou gaanchuangc nai ni cho, gaanchuangcna,",
            "Tingzyn kiu neihmik key kan pwkhou?",
            "Dwan-gaymei nunc lev ai zaengthaek kai tangc pwkhou,",
            "Pyrun khou gaanchuangcna nai ni cho?",
            "",
            "2 Taanc ranv ni, huayney ni Kaipouc tuang pumtan khou,",
            "Bumaengh khuammei swna changkhaanv ni,",
            "Hymdaih neic duidai khwan kumc",
            "Kata thuanc pwkhou",
            "Gaanc gaimei gaanchuangcakhang sw khang.",
            "",
            "3 Ai adih neihlaa ni Kazawpaanv how pwkhou,",
            "Ringhmei lanv Kahu khou lou pwkhou,",
            "Ai neihlaa diangc puni kachaekc kaidai khou kiu,",
            "Apyrun khou gaanchuangc nai ethei."
          ]
        }
