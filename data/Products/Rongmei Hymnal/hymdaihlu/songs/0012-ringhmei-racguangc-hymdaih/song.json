            "1 Ringhmei Racguangc hymdaih",
            "Guangc bamv khou dunghmei,",
            "Meic guay Nang hu khou khuksunna huay diu!",
            "Nang ramzian }?2 kandih ta suaihiam lou the,",
            "Eden khou gaanhmei, ringhmei tiilou the.",
            "",
            "2 He ’Thanmei Pu, Nang nac nunc ta zaylou the,",
            "Mai lev muanghtiangc }?2 zuk lwan kathuic khou,",
            "Duipui chung khou ramkaengv kumc tiitatlou the,",
            "Nang ta chakhwang swna ’niw ’bum key e.",
            "",
            "3 ’Thanmei Jisu chuzaenghmei Guangc Nac,Nang }?2",
            "’Niw lungctow bammei chuzaenghmei tiilou,",
            "Meic siimei }?2 rairiumei ta mathimlou,",
            "Maansei lungpuam pwanzingh guay khaamlou e.",
            "",
            "4 Bumaengh ’Thanmei, Swmloumeipu, gaanhmei lev,",
            "’Niw khou souclou o, tiiduakmei riw }?2;",
            "Zinghmei khou }?2 ’niw lung hei tiiduaklou o,",
            "Chumhmei riw 2}? ’taw khou }?2 gaanclou o. Amen."
          ]
