        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kandih juk hei luai guang puthe,",
            "Khat +:1 khat ta jianna lung o;",
            "Jaojimei +:1 padik pukhou,",
            "Ntunmei guai rukhou nai e.",
            "",
            "Chorus:",
            "Gaimei tingmik hou nimei guai,",
            "Simei tan guai npat latho;",
            "Poubaumei mik jaopan tei mu,",
            "Ntunmei guai rukhou nai e.",
            "",
            "2. Kandih khou nangniu lung chammei,",
            "Khat +:1 khatta njian makna;",
            "Mik +:1 hou makmei Raguang ta jian e,",
            "Samei nkhuaimei e.",
            "",
            "3. Simei tanh tan puijang khou +:1,",
            "Rianra akhang mei khang suangmu;",
            "Gaimei tanh tanpui jang khou +:1,",
            "Rianra akhangmei +:1 gai e."
          ]
        }
      }
    },
