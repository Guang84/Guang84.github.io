        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ch’rynmei Jisu zauzian hei",
            "Apaap khang suangc daic e;",
            "Abaley na @{4 ’kumhna",
            "Mi hei thuanc ngam ni cho?",
            "Apuatrith 4@< laa ganclou,",
            "Abumaengc tiiduaklou;",
            "Ch’rynmei Jisu zauzian hei",
            "Akhou guang tangc the.",
            "",
            "",
            "Kida khang maekmei",
            "Jisu zauzian, kida khang maekmei,",
            "Kamuatcmei duipui khang suangc ’thuk ge,",
            "Duipui suangc ’thuk,",
            "Jisu zauzian hei akhang biuc e, Akhang nganv biuc e,",
            "Akhuay guay suangc daic ranv e, Kazauzian,",
            "Jisu zauzian apaap suangc daic e;",
            "Kunghmei Jisu zanc hei tiidaic pat ro, thuanc o, Kazanc!",
            "",
            "2 Jisu zauzian amaanmei",
            "Kathuic khou guang tangclou,",
            "Jisu zauzian @{4 ata",
            "Tingsaengzaeng khang gulou,",
            "Bangcloumei kangriang riclou,",
            "Ata nyng tiiswlou;",
            "Ch’rynmei Jisu zauzian hei",
            "Akhou guang tangc the.",
            "",
            "3 Ch’rynmei Jisu zauzian hei",
            "’Phuam liangmei khou tangclou,",
            "Hei zauzian @{4 paapc mei ta",
            "Ravguangc nac tii swlou,",
            "Chuzaenghmei lev tingkauh hei",
            "Tingsaengzaeng khang liulou,",
            "Ch’rynmei Jisu zauzian hei",
            "Akhou guang tangc the."
          ]
        }
      },
