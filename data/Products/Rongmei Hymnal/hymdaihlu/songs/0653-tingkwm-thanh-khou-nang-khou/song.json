    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Tingkwm thanh khou Nang khou",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tingkwm thanh khou Nang khou guang e,",
            "He zayloumei Racguangc;",
            "Panty saanvsaengh suaihiamlou e,",
            "Paapc khou tiiduaklou e,",
            "Aniw duak khang theicloumei Pu,",
            "Aniw Nang ta thuanc e;",
            "Tingkwm kathanc laan pat khou hei",
            "Nang khou ’niw guang dat re.",
            "",
            "2 He aniw Pu, Nang ta thuanc e,",
            "Kadanloumei zaeng khang;",
            "Taektw tiiloumei zaeng thuanc e;",
            "Lwngbamv tiiloumei zaeng;",
            "Ting-neih sii khou akhangv duak khang",
            "Tiiloumei pwan-rai zaeng;",
            "Tingkwm kathanc laan pat khou hei",
            "Nang ta thuanc kaluan e.",
            "",
            "3 Aniw ta zayloumei taanv 5#^",
            "Makumhna thuancku e;",
            "Tazikramv khou zayloumei 5#^,",
            "Muanghtiangc swloumei 5#^,",
            "Rihpy, Pou Jisu kazauhna",
            "Hymdaih lyanloumei 5#^,",
            "Tingkwm kathanc laan pat khou hei",
            "Nang zanc ta thuanc dat re.",
            "",
            "4 Pou Ravguangc, Nang hym daihmei khou",
            "Key datmei ta ’khwan e;",
            "’Khavlou o, aniw kaganv ’thuic",
            "Chamdaanv thayna bam khang;",
            "Paapc mei nunc khang theicloumei pu",
            "Jisu ta ’riw ngam khang,",
            "Tingkwm kathanc laan pat khou hei",
            "Thuanc e, guanghtu kan diu!"
          ]
        }
      },
