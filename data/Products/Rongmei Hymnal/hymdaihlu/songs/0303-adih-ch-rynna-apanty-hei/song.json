        "content": {
          "format": "source-lines",
          "lines": [
            "1 Adih ch’rynna apanty hei tiiguanhlou cho!",
            "Jisu alung khou gut khou ^&5!",
            "Ai phu bammei gaanhmei 5^& alung khou nai the,",
            "Jisu alung khou gut khou ^&5!",
            "",
            "Jisu alung khou gut khou ^&5!(2)",
            "Neihlaamei alung khou duiluat kumc daic thau e,",
            "Jisu alung khou gut khou ^&5!",
            "",
            "2 ’Taw mu akhang suai lakmei rigwnmei nai the,",
            "Jisu alung khou gut khou ^&5!",
            "Lwmsiimei muangc ^&5 achaeng sw zingc dat mak khe,",
            "Jisu alung khou gut khou ^&5!",
            "",
            "3 Theihmei nzaengc khou akhang mu gaanhmei nai the,",
            "Jisu alung khou gut khou ^&5!",
            "Tingkauh tuang raengckat 5^& alung khou phaengc how the,",
            "Jisu alung khou gut khou ^&5!",
            "",
            "4 Tingkauh kaidai khou 5^& lungh",
            "khang ai tat puni,",
            "Jisu alung khou gut khou ^&5!",
            "Tingkauh kai ’zwan tat bam khou hei ai neihlaa e,",
            "Jisu alung khou gut khou ^&5!"
          ]
        }
      },
