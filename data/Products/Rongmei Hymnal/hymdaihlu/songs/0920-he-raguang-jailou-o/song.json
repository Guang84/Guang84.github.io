        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. He Raguang jailou o,",
            "Kandih panti luai maksan;",
            "Muang kumma jingmei kandih khou hei,",
            "Ata jailou o.",
            "",
            "Chorus:",
            "Nang +:1 rammak neila khang makge,",
            "Lung tineila lou nimei;",
            "Panti tingmik hei luai guang puthe.",
            "Aniuta khuan mak khe.",
            "",
            "2. Juan dikho ganmei thang,",
            "Gumeipu phaikam suina;",
            "Thiammei +:1 dui kumma guang sini,",
            "Ping maknga tatni.",
            "",
            "3. Kandih apanti hei,",
            "Lili mun kum tuai nuang e;",
            "Pingmei +:1 padikmei kandih khou,",
            "Ata jailou o."
          ]
        }
      },
