        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Apanty saanvsaengh gaanhmei khou tat re,",
            "Chyngbut ruc khou lev nzaengc baek khou;",
            "Jisu saalou e, “Ai nang ta pat lak,”",
            "Suai dat zat lakmei Rav latryan e.",
            "",
            "Tingkauh tuang neicriw,",
            "tingkauh tuang neicriw,",
            "Alung khou liak guang, Rav hym gaanhmei 3>|;",
            "Hallelujah! ai neihlaa bam e,",
            "Thuanckuna suan e, Jisu akhang.",
            "",
            "2 Adaeng bam ’kuaymei muangh zinghmei guay >|3",
            "Ata Gumeipu ta bam zingh mak;",
            "Kamei gaanhmei e, Kakhou zinghmei maek,",
            "Kaganv ’thuic ai hei Kadaeng byan e.",
            "",
            "3 Neihriw gaanhmei khou neihlaa taekc makna,",
            "Kauh kaidai ta machunhna tat re;",
            "Thuanhpui lu suanna, neihlaana at re,",
            "Neihriw khou tat re, zianmei riw hou."
          ]
        }
      },
