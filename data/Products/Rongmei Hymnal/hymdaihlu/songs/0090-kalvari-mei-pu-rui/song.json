        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kandih khou gay liangsinghmeipu,",
            "Daihmei khou daic liangsingmeipu,",
            "Ravguangc gunc padik sikhmeipu,",
            "He ch’rynmei Kalvarimeipu!",
            "",
            "Kalvarimeipu ^&8",
            "Alungning ta ngam the,",
            "Ai duak khang theiclou the,",
            "Zauzian thaymeipu e!",
            "",
            "2 Paapcmei bumaengc ta tiiringclou,",
            "Kang bangcloumei ta ricpatlou,",
            "Aniu duak khang Kazei keylou,",
            "Zianthaymei Kalvarimeipu!",
            "",
            "3 Maansei khang gay liangmei kaipat",
            "Saa ngam makmei zauzian tiilou,",
            "’Than thiakh thiakmei lwnlung tiilou,",
            "P’riuhmei Kalvarimeipu ^&8!",
            "",
            "4 Tiineihlaaloumeipu Jisu,",
            "Gay liangpui neic Nang ta ’riw ni,",
            "Nang tik Nang gunc gaymei how ni,",
            "He ch’rynmei Kalvarimeipu!"
          ]
        }
