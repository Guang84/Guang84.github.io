        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neih key dat makpui ramc khou,",
            "Namvdai gaymei nai e;",
            "Kamv datmei nai dat lak khe,",
            "Khou5^& zingbangc maek khe.",
            "",
            "Ravguangc ^&5 mikdui roulou,",
            "Theihmei, suhmei, pingmei maek;",
            "Tingkwm sing phuc dat lak khe,",
            "“Khou5^& zingbangc maek khe.”",
            "",
            "2. Raenghkat guay 5^& kangran e,",
            "Namvdai gaymei khou 5^&;",
            "Chaengluang guay kachaekc ^&5 sw,",
            "Khou5^& zingbangc maek khe.",
            "",
            "3 Raenghmun 5^& ’bangh zat mak ge,",
            "Namvdai gaymei khou 5^&;",
            "Ringhphaeng dui khou5^& luangc e,",
            "Khou5^& zingbangc maek khe.",
            "",
            "4 Neih riw hei kage maek khe,",
            "Namvdai gaymei khou 5^&;",
            "Lauziu Nac ^&5 gaanc bam e,",
            "Khou5^& zingbangc maek khe."
          ]
        }
      },
