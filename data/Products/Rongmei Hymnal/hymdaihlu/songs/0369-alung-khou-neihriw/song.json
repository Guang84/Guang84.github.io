        "content": {
          "format": "source-lines",
          "lines": [
            "1 Alung khou neihriw gaanhmei nai,",
            "Kachan gayna gaanc e,",
            "Kandih tingpuk suangc gaanc ranv e,",
            "Gaanhmei kiu Jisu e!",
            "",
            "Nai e, .. neihriw, suaihiam neicriw,",
            "Chuzaenghmei, neihlaamei panty khou;",
            "Jisu zawpaanv ai how pwkhou,",
            "Neihriw hei nai alung khou.",
            "",
            "2 Alung khou lu khwan gaymei nai,",
            "AGuangc ta thuanhpui khwan;",
            "Ai suan thay makmei lu nganvna",
            "Jisu {:1 chu ngam e.",
            "",
            "3 Alung khou lauphunhswan 1<: nai,",
            "Kaipouc ’naa bam pwkhou,",
            "Chuzaenghmei bumaengc {:1 lu suan,",
            "Zauzian mwnpwang puangc e!",
            "",
            "4 Alung khou neihlaamei nai e,",
            "Rigwnmei, thuanhmei nai;",
            "’Taw tiiloumei suaihiam guay khang,",
            "Kauh thangc tii nimei khang."
          ]
        }
