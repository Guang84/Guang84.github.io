        "content": {
          "format": "source-lines",
          "lines": [
            "1 Meic kathuic, kandih kathuic khang",
            "Lungdyng laapui ganv guang e;",
            "’Chumhmei lev laanhmei adow khou;",
            "Siimei gaymei biak liangc e,",
            "Taanv daih asaekc Messaiah ?|7",
            "Suaihiamlou e, gancpat re,",
            "Zinghmei lev gaanhmei kapahmei",
            "Tingsaengzaeng tat key bam e.",
            "",
            "2 ’Chumhmei biak lianghmei gaymei e,",
            "Ryanramei dam ’niu laa ni,",
            "Zanh tatmei phungc guang mak khou ?|7,",
            "’Twnmei gaengcmei thay mak khou;",
            "Bauhmei na ?|7 hei khang ding e,",
            "Zammei nunc ding thei bam khou,",
            "’Khamh khou meic guay laylou dat re,",
            "Kaniw nuhmuloumei ta.",
            "",
            "3 Chuangc bammei martair nunc riw khou,",
            "Khrista zei phaykaamv suic e,",
            "Kalvari khou kaphat ku e,",
            "Hanc dat makna, kros phungcna,",
            "Kabamv, kaganv kathanc than khou,",
            "Ramh guay kalaic ngam pwkhou,",
            "Chanahmei khou taanvsw bam khang",
            "Tat kuna hu thangc gut ni.",
            "",
            "4 Siimei ?|7 lung zyn bam sihni,",
            "’Chumhmei thu kalaih mak ge,",
            "Mbaukai khou lungc bam sihni,",
            "Guangh nunc ?|7 nuh mak sihni,",
            "Meic thay mak khou guang nimei ta",
            "Mbaukai 7?| ?|7 sin e;",
            "Kaswng khou Ravguangc ding bam e,",
            "Kamei nunc ta gaek bam e."
          ]
        }
      },
