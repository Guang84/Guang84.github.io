        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ch’rynpui zauzian! adih gay cho,",
            "Ai kumhmei ta gulou!",
            "Ai ’maan khwan the, ’taw phu tow dat,",
            "Miktiat khwanmei how dat.",
            "",
            "2 Zauzian >|3 pingthay khang ’chamlou,",
            "Ai pingmei tii ’maan e;",
            "Adih ’thuk cho zauzian taanv hei,",
            "Ai lwmlou rap nungc 3>|!",
            "",
            "3 Ryanra ryanriu,phahraengh khou >|3",
            "Ai hei duakna guang the;",
            "Zauzian paan e, hei saan guangmei,",
            "Tingkauh nganv zaylou ni.",
            "",
            "4 Kauh khou ’niu neih kumc gaanh nungc kiu,",
            "Kwm ching ruh lungh nungc kiu",
            "Ravguangc thuanhmei taek mak thuanc ni,",
            "’Taw thuanhmei suangc thuanc ni."
          ]
        }
