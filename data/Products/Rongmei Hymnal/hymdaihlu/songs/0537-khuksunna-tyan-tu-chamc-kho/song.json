          "lines": [
            "1 Nang ^&5 bybakloumei ’tyan khang,",
            "Nang tiimei drakhadui khang,",
            "Nang ^&5 tiiloumei latkaeng khang,",
            "Pou, Nang ta ’niw thuancku e.",
            "",
            "2 ’Niw ta Nang ’zianloumei paan ^&5,",
            "Chuzaenghmei tiimei paan ^&5,",
            "Tingkauh thangc kawloumei paan ^&5,",
            "’Niw panty sw ’thanlou o.",
            "",
            "3 Hymdaihmei thangc ’thanmei nunc 5^&",
            "Pu pamv khou zaengsw bam e;",
            "Nang ta ’khwan bammei",
            "phwamling hei",
            "Zianmei riang taek mak kan diu.",
            "",
            "4 Nang taanv khou ’niw ta ’khavlou o,",
            "’Niw lung ta sin-gaeklou o;",
            "’Niw ta thoucloumei kandih khou,",
            "Pou, Nang guangcdic tii guang o. Amen."
          ]
