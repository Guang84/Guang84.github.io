          "format": "source-lines",
          "lines": [
            "1 Jisu hei akhang the kachangcna",
            "Twmei khou Ravguangc ramgai adih nai!",
            "Kazei paan @<4 ringhbamv liulou the,",
            "KaBumaengc ’Thanmei paan puancthanh the.",
            "",
            "Mi hei ap’ry e, mi alu e;",
            "Gumei pu ta tingsaeng thuanhmei hei,",
            "Mi hei ap’ry e, mi alu e:",
            "Gumei pu ta tingsaeng thuanhmei hei!",
            "",
            "2 Tiigutlou p’rymei adih neihlaa!",
            "Alung mik khou ’taw rapchar ta howthe,",
            "Kauh thangc @<4 baanch’ra nunc phungc key e,",
            "Zauzian khwan gaymei kagaengv keymei.",
            "",
            "3 Tiigutlou p’rymei zaeng nthaekc ge,",
            "Guloumeipu khou ai neihlaa bam the;",
            "Tingkauh ta machunhna ’khwan bam e,",
            "Karamgai @<4 tiipadiklou e."
          ]
        }
      }
