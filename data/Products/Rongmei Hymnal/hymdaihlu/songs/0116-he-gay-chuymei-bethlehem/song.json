        "content": {
          "format": "source-lines",
          "lines": [
            "1 He gaychuymei Bethlehem gaanchuangc,",
            "Zinghmei khou gaanc bammei gaanchuangc,",
            "Reynungc mei nunc khou gaancloumei gaanh riw,",
            "Ningtyngmei nunc ta chaeng zaylouna",
            "Jisu bamv khou zayloumei riw,",
            "Gaychuymei Bethlehem gaanchuangc, gaanc o.",
            "",
            "He gaychuymei Bethlehem gaanchuangc",
            "Tingkauh hymdaih 2^< ’niw khou gaanc key o,",
            "He ’niw chaenglwan hei tiigaanclou o,",
            "Kalaanv gaancchuymei ramc ’zwan khang,",
            "Gaychuymei Bethlehem gaanchuangc gaanc o.",
            "",
            "2 He ringc nimei machunc gaanchuangcna,",
            "’Thanpui bamv ’zwan tatmei nunc ta",
            "Lauthwan pat mak saanv chaenglwan ’thuic zaylou,",
            "Kalaanv gaancchuypui ramc tangc pwkhou,",
            "Nang riw hei gaanc chuy diangc puni,",
            "Gay chuymei Bethlehem gaanchuangc, gaanc o.",
            "",
            "3 He zaeng ’thaekc nimei machunc, aanchuangc,",
            "Thuaklou tangmei nunc tingkauh thangc,",
            "Hymdaih pyrun 2^< laa nimei machunc,",
            "Jisu hei tingkauh gaanchuangcna e,",
            "Gaanc ranv hay hayna gaanc puni,",
            "Gaychuymei Bethlehem gaanchuangc, gaanc o."
          ]
        }
