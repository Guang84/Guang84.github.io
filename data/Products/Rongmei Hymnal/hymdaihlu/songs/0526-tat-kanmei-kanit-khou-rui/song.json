        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tat kanmei kanit khou $%6",
            "Poubauhmei $%6 ’duanghlou the;",
            "Kalumpui kai khou bamna,",
            "Kasuaihiam ’taw ’niu ney kho;",
            "Tingmik ruang khou gay liangmei,",
            "Tingsaeng zaengthaek tuang maengc e. ( 2)",
            "",
            "2 Thuakloumei pu zanc khou $%6",
            "Kuaklou khang zauzian ney e;",
            "Paapc lev zakmei laa gancna,",
            "Nang zawpaanv tiihowlou o;",
            "Dih chwn guay laa ganclou o,",
            "Nang pamv khou ’niw zaengsw ni. (2)",
            "",
            "3 ’Niw Nang zanc thuanh khang guang e,",
            "’Niw pangc khou guang bamlou o,",
            "Nang hymdai tiihowlou o;",
            "Nang kai khou ’niw guang bam khou;",
            "Pou, ’niw ta tii ’baplou o,",
            "Kauh thangc khwmkihmei ramgai.(2)",
            "",
            "4 Neihlaamei Gaychamv khwan $%6",
            "Paapcmei nunc ta ngam diu o;",
            "Lwmmei nunc lung tiithau diu,",
            "Sunu guay tiigaylou diu;",
            "Kauh phwamling khou ’zauh mak saanv,",
            "Zauzian thai padiklou o. (2)"
          ]
        }
      }
