      "rongmei": {
        "language": "rongmei",
        "title": "Duiluat liak pat kan the",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Duiluat liak pat kan the,",
            "Liak pat kan the;",
            "’Niu ta nic duiluat )}3 phungcna",
            "Duipui thangc phungc tat the,",
            "Phungc tat kan the duipui",
            "Kanganv maekmei thangc,",
            "",
            "Ringhmei kandic khou )}3",
            "Tingseangzaeng thangc 3)^.",
            "Phungc tat kan the,",
            "Tingsaengzaeng duipui daih thangc 3)^.",
            "",
            "2 Duiluat liak pat kan the,",
            "Liak pat kan the;",
            "Gaanv saekc ta duiluat )}3 phungcna",
            "Duipui thangc phungc tat the,",
            "Ryanramei dic khou )}3",
            "Hymdaihmei dic thangc;",
            "Thuaklou tangmei nunc bam",
            "Tingkauh gaanhmei khou.",
            "",
            "3 Duiluat liak pat kan the,",
            "Liak pat kan the;",
            "Gaanv saekc ta duiluat )}3 phungcna",
            "Duipui thangc gut kan the;",
            "Zianmei, gaanhmei khou )}3",
            "Zingh thangc gut kan the;",
            "Tingpwanzingh akhangvmei",
            "Zingc taan makmei thangc.",
            "",
            "4 Duiluat liak pat kan the,",
            "Liak pat kan the;",
            "’King o, duipui khou kauc laanna",
            "Khwan khat )}3 kauc bam e;",
            "Guloumeipu khwan e,",
            "Kamei kabai e:",
            "“Akhou guang o, lakmei,",
            "Zaeng tii’thaekclou ni.”"
          ]
        }
