        "language": "rongmei",
        "title": "Tingzyn neih key makmei hu khou",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tingzyn neih key makmei hu khou",
            "He Pou, ’naumei Nang khou guangmei",
            "Suhmei ravpuat heizumei 1<~",
            "Tiigayloumei laatow kan e!",
            "",
            "2 ’Seic nic tingzyn ramgei khou hei",
            "Suhmei, ’naumei ’peyna guang e,",
            "Nang lwn aniw how mak sihni",
            "Khou hei Nang bammei ’niw thay e.",
            "",
            "3 He Pou Khrista, tiigaylou o,",
            "Gaanv saekc ’nau bam, gaanv saekc ryanra,",
            "Gaanv saekc Nang ta zianmei lung maek,",
            "Gaanv saekc ramzian ’maan dat kan the.",
            "",
            "4 He Pou, zaeng ’thaekcmei ta huay e,",
            "Paapc khou <~1 duakmei ta huay e,",
            "Nang lat piu chuy niimei nunc 1<~",
            "Karam ’suan ta thay pat diangc e.",
            "",
            "5 Reynungc ngamv 1<~ ’taw Nang khou nai,",
            "Nang lat kathai maekna taan lak,",
            "’Taw ’thukmei tingzyn ganv khou hei",
            "Zianna ’niw ta tiigaylou o."
          ]
        }
      },
