          "lines": [
            "1 Ravguangc Nac rih ’dow khang tat re,",
            "Guangh pyrun 0({ laa khang,",
            "Kachuangcphey duh thangc ({0 how e;",
            "Thow Kathei suic tat ni?",
            "Ryanramei Kabuangc 0({ zangvmei,",
            "Suhmei akhaengv ngammei,",
            "Katuang kros 0({ phunghpui mei 0({",
            "Kathei laypui mei e.",
            "",
            "2 Martair reymei 0({ how ducna",
            "T’rou phaengc kaanna zauc e,",
            "Kakaipouc ta kauh thangc how e,",
            "Kanlou khang huay khwan e,",
            "Kakumc kuakloumei lat saa e,",
            "Kata raimei nunc ta;",
            "Kaniw khang huayneylou khwan e;",
            "Thow Kathei lay ni cho?",
            "",
            "3 Kapahloumei katit na khou",
            "Bumaengh keylou khwan e;",
            "Ping mak ge, ruhnakanei 0({",
            "Kros lev maikhunc hu khou;",
            "Meicsiimei baengsaeng ta ping mak,",
            "Kamang ta nganv rouh mak;",
            "Theih khang kaniw ’bum keylou the;",
            "Thow kaniw thei lay ni?",
            "",
            "4 Maansei kangdai meicpui-meicnac,",
            "’Thyam ’thauh ’peyna guangna,",
            "Neihlaana Kabamvpaeng dinghuamc,",
            "Gaanhmei pwan piulouna;",
            "Tingkauh chaengkhuat kaamc ku khwan e,",
            "Ryanra khaengvpui paan ({0;",
            "He Ravguangc, zauzian tiilou o,",
            "Kaniw thei lay ngam khang."
          ]
        }
