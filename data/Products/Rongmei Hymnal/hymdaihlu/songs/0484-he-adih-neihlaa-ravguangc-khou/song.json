          "format": "source-lines",
          "lines": [
            "1 He adih neihlaa, Ravguangc khou bammei,",
            "Nganv makmei baancpwam khou zaeng’thaekcmei!",
            "Adih suaihiam cho, adih",
            "chuzaengh cho,",
            "Nganv makmei baancpwam khou zaeng ’thaekcmei.",
            "",
            "Zaeng .. ’thaekc, zaeng .. ’thaekc,",
            "Katuakcmei guay khou _>6",
            "duak the;",
            "Zaeng ..’thaekc, zaeng ..’thaekc,",
            "Nganv makmei baancpwam",
            "khou zaeng ’thaekc the!",
            "",
            "2 Guakgaumei maek khe, kauh",
            "’zwanpui chaeng khou,",
            "Nganv makmei baancpwam khou zaeng ’thaekcna!",
            "Tingmik ’thuic achaeng gaanc khith khit ku the,",
            "Nganv makmei baancpwam khou zaeng ’thaekcna!",
            "",
            "3 Thow ta ai ping ni,thow ta ai rouh ni?",
            "Nganv makmei baancpwam khou zaeng ’thaekcna!",
            "Chuzaenghna bam e, Gumeipu",
            "pamv khou,",
            "Nganv makmei baancpwam khou zaeng ’thaekcna!",
            "",
            "Rev. E.A. Hoffman"
          ]
