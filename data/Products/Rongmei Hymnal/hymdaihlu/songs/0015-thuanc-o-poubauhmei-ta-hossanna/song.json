        "content": {
          "format": "source-lines",
          "lines": [
            "1. Thuanc o, Poubauhmei ta hossana kaucna,",
            "Thuancku o, lungh neihlaana;",
            "Lungh neihlaana Kaguangc bamvpaeng khou guang o,",
            "",
            "’Thanmei Kazanc tiidaic o,",
            "Ruantat ro, Kachuangcphey gaanhmei bangc khou,",
            "Kazauzian hei lwmlouna tat kho,",
            "Katuang gaanhmei ’niu ruc khou gaanclou puni;",
            "Kabaantan ^&5 zaylou puni, ’taw nic nganv makna.",
            "",
            "Lwan riph rip ruan tat kho,",
            "Chuanghphey kazitna ’niu ruc khou,",
            "Lwan riph rip ruan tat kho,",
            "Neihlaapui lu suanna tat kho,",
            "Lwan riph rip ruan tat kho,",
            "Mai lev muanghtiangc thei ’niu lay tatna,",
            "Hymdaihmei tingkauh kai 5^& ’zwan tat di kho.",
            "",
            "2 Thuanc o, Poubauhmei hei nganv makmei Guangc e!",
            "Kauh thangc Ravguangc hym daic diu!",
            "Thuanc o, Poubauhmei tuang zauzian ndauhna;",
            "Lay suan o, tingkauh lu 5^&.",
            "Ruanna tat ro, neihlaana ruan tat ro,",
            "Jisu lev ruan tat ’chamcna tat kho,",
            "Thuakloumei nunc dwan-gayna lunghpui kai khou,",
            "Guloumeipu zanc ta thuancku bam ni makna."
          ]
        }
