        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc {:1 ch’rynmei taanv taanc e,",
            "Kadath datmei thiak khou;",
            "Duipui ta kaphaygim sw e;",
            "Pwanzingh khou tuangc tat re.",
            "",
            "2 Ping tanhmei nunc, diw sii bam rio,",
            "Muanghbangv ta rouh bam riu,",
            "Zauzian padikmei muangcbangv de,",
            "Suaihiam phungc guang puni.",
            "",
            "3 Ravguangc ta nang cham khou ning riu,",
            "Kazauzian ta lwm o,",
            "Kaipouc nuic rimh rimna bam de,",
            "Tamzinghmei guay paengc thangc.",
            "",
            "4 Katuang raeng guay guang tangc puni,",
            "Khith khitna lyan puni,",
            "Kazik 1<: nkhuc bam sihni",
            "Kapwang namh gay puni.",
            "",
            "5 Lwm makmei thu chaeng tatmaanv e,",
            "Rav taanv ta how pat mak,",
            "Ravguangc Kataanv lyan puni de,",
            "Meic guay how puni de."
          ]
        }
      },
