        "content": {
          "format": "source-lines",
          "lines": [
            "1. Laujiu gangmei nun tei jingbang,",
            "Laujiu ta khuan bam khou;",
            "Poubaumei banchra khat keina,",
            "Kaniu dang tigan lou.",
            "",
            "2. Pingriu Seraph tei ({0 sa e,",
            "Kaniu pingna bam khou;",
            "Neila daimei cham ai phung guang,",
            "Nangniu le mei guai khang.",
            "",
            "3. Nangniu khang David kaidai khou,",
            "David tuang jeiriang khou;",
            "Gumeipu kaipou Khrista kiu,",
            "Sei hei puan lou bam the.",
            "",
            "4. Tingkauh nganah ta hou pui,",
            "Mansei guanna puanmei;",
            "Pheinuaina ({0 kadup louna,",
            "Kaikhuang khou jiloumei.",
            "",
            "5. Seraph tei ({0 satang pukhou,",
            "Kauh banchra kangdai ({0;",
            "Raguang tikgun daimei thuanna,",
            "Janggai pui lu suan e.",
            "",
            "6. Tingkauh thang Raguang himdai diu,",
            "Dih khou jangmei naidiu;",
            "Kauh le dih khou gaimei cham hei,",
            "Taoni tingsang nai diu."
          ]
        }
      }
