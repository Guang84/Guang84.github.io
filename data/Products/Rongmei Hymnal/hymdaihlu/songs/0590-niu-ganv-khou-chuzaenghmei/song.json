          "format": "source-lines",
          "lines": [
            "1 ’Niw ganv khou chuzaenghmei",
            "Zaatc guay khou tiilou o,",
            "Ntwnmei khou suamc thauloumei",
            "Nang chwnmei chuzaenghmei,",
            "Bumaengh naumei nunc ta",
            "Bangclou bammei kangriang",
            "Nang na @{4 sw taeklou ngam e,",
            "Tii gaylou dat ngam e.",
            "",
            "2 Lwmsiimei, pingmei @{4",
            "Meic nunc lung sin guang the,",
            "He Tingkauh Thiule, ’liu key o,",
            "Kandih pwm ’liu lik go;",
            "Guang tho, reynungc kumcna",
            "Zianmei ngamv 4@< phungcna,",
            "Meic nunc Nang ta na kalum diu,",
            "Rav baihmei ganclouna!",
            "",
            "3 He ’niw thay zat lak cho",
            "Nchumhmei Latkaeng hei,",
            "’Niw kai ramsu hei gaengc mak ge,",
            "Rav’ @{4 ’khavlou mak ’thei;",
            "He ringc bammei Khrista,",
            "’Niw puat phungc ’khavmei Pu,",
            "Guanglou o, meic kathuic lung khou",
            "Nang @{4 gut lungclou o."
          ]
