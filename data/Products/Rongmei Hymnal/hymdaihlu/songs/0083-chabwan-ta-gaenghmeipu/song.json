        "content": {
          "format": "source-lines",
          "lines": [
            "1 Chabwan ta Gaenghmeipu,",
            "Zianmei lev ’chumhmei khou",
            "Zayloumeipu,",
            "Khrista rih ngammei Guangc,",
            "’Niw Nang zanc ta thuanc e;",
            "’Niw nac nunc ta phungc guang",
            "Nang hym thuanh khang.",
            "",
            "2 Nang ’Thanmei Kaipouc e,",
            "Ramh guay sinmei Latkaeng,",
            "Tiigaymeipu,",
            "Nang hym guay lou ducna",
            "Paapc khou <~1 gulou khang,",
            "Ringhmei 1<~ tiilou khang,",
            "Nang keylou e.",
            "",
            "3 Nang Tingkuh daihmei e,",
            "Tingkauh ramzian khwmkih",
            "Chamdaanvlou the;",
            "Ryanra lakmei nunc <~1",
            "Nang khou zaenghuay pwkhou",
            "Kaniw ta ’khavlou tio,",
            "Tingkauh thangc <~1.",
            "",
            "4 ’Niw ta chaeng zaylou o,",
            "’Niw ta Nang builwang <~1",
            "Gaengclou bam o;",
            "Jisu Khrista - Ravguangc,",
            "Nang tuang Ringhmei Lat <~1",
            "Lwmmei tiitanclou o,",
            "Nang thei lay khang.",
            "",
            "5 ’Niw theih makpui nganvna",
            "Nang hym thuancna bam ni,",
            "Lu kauc ranvna;",
            "Nang tuang phwamling nac nunc",
            "’Thanmei nunc kariuna",
            "Khwan kauc ranvna suan diu,",
            "Guangh Khrista khang!"
          ]
        }
      },
