        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu #<8 ata zian e!",
            "Baibal #<8 akhou saa e;",
            "Alauc guay hei Katuang e;",
            "Kaniw ’suan, Kamei tanc e.",
            "",
            "Jisu ata zian,",
            "He ata zian e!",
            "Jisu ata zian,",
            "Baibal #<8 dinclou e!",
            "",
            "2 Jisu akhang theiclou e,",
            "Kamei #<8 apaap khiulou,",
            "Tingkauh raengcmun laanclou e,",
            "Alauc nunc ta tiigut re.",
            "",
            "3 Jisu #<8 ’duanghlou puni,",
            "Kabamv ’thuic chaenglwan saanv khou,",
            "Kata zianna lungc tithei,",
            "Tingkauh kai khou zaylou ni."
          ]
        }
