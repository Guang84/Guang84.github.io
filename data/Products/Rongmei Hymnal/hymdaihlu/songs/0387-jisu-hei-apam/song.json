        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu pam swmei adih gay,",
            "Ai kumhmei ’suanmei {:1!",
            "Kakumhmei baihmei pam nai cho,",
            "Tingkauh khou zaylou khang?",
            "",
            "Jisu hei aPam",
            "Tingkauh tuang Pam e;",
            "Adihkamv gaymei duangda cho,",
            "Jisu hei aPam kiu e.",
            "",
            "2 Pam baihmei guay ’maan",
            "kan pwkhou,",
            "Baihmei guay suai pwkhou;",
            "Neihlaamei, chuzaenghmei tiimei",
            "Pam kiu Kamei na de.",
            "",
            "3 Zinghmei khou {:1 zayloumei Pam,",
            "Chaeng zay thaymei Pam e;",
            "Aramsuan ’khavloumei Pam e;",
            "Pow khangcloumei Pam e.",
            "",
            "4 ’Nau sunupui ganv khou Pam e,",
            "Theihmei ’naa guang khou Pam;",
            "Theihmei nzaengc tatruan bam khou",
            "Nkhavloumei Pam e."
          ]
        }
      },
