        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaamv khat di the Jisu khou!",
            "’Bui zaeng ’taw guang mak cho?",
            "Guang tho, nang paap kalauh tho,",
            "Pou hu khou khuksunna.",
            "",
            "Kaamv khat di the, kaamv khat di the;",
            "Guang tho, ’khwan bam the;",
            "Guangna nang paap ndauh tho;",
            "Suaihiam nang laa tow puni,",
            "Nang khang nsa tiipatmei",
            "Kazauzian laa zih rio.",
            "",
            "2 Kaamv khat di the Jisu khou!",
            "Lum tho, nang ringc puni;",
            "Nang ta zianna ’khwan bam the,",
            "Kuaklou khang chamdaanvna.",
            "",
            "3 Kaamv khat di the Jisu khou!",
            "Paapc khou ^&5 zauzian khou;",
            "Nang lung akumh ding the cho?",
            "Kaganv thu ’khwan mak khe.",
            "",
            "4 Kaamv khat di the Jisu khou!",
            "’Bui zaeng guang saa mak cho;",
            "\"Guloumeipu, Nang khou ai",
            "Apanty tiipat the.\""
          ]
        }
      },
