          "format": "source-lines",
          "lines": [
            "1 Ravguangc tuang chuzaenghmei guanglou dat ro,",
            "Chuzaenghmei Guangc lungc guang nungc 6_> kumcna,",
            "Tiigaymei phungcna guang kahilou o,",
            "Heipui kandic _>6 kage nai bam e.",
            "",
            "2 Karangmei rihpwan guay sw ’maanlou o,",
            "Zauczihmei guay ta hacpiang ganclou o,",
            "Kamut-kamai bammei ric bamv guay khou,",
            "Nang tuang chuzaenghmei mwnpwang lingclou o.",
            "",
            "3 Kakhang guhmei ta zinghpui bamv khou _>6",
            "Guloumei pu kros riw khou phungc guang o;",
            "Ch’rynmei kaipat hu khou meic guay lung hei",
            "Chana-punav ramzian padik puni.",
            "",
            "4 He Ravguangc tuang’chuzaenghmei phungc guang o,",
            "Ryanramei khang Ravguangc tuang swmloumei;",
            "Neih key kan khou gaanchuangc pat lyn kumcna,",
            "Guang o, chuzaenghmei ’niwlung sinlou o."
          ]
        }
