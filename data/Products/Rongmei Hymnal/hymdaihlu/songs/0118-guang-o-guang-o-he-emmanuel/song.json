        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guang o, guang o, Emmanuel;",
            "Israel ta tiiduaklou tho,",
            "Kangkai khou pui-huayna bam e,",
            "Ravguangc Nac ’Pouh guangmei ’khwanna.",
            "",
            "Neihlaa, neihlaa, he Israel!",
            "Guanglou puni Emmanuel!",
            "",
            "2 Guang tho, he Jessi kiktale,",
            "Seitaan ({0 rai bammei khou ({0,",
            "Nang mei nunc ta tiiduaklou tho;",
            "T’rou ta rih ngammei tiilou tho.",
            "",
            "3 Guang tho, he lauthwan gaanphiule,",
            "Aniw lung tiineihlaalou tho;",
            "Gaanhmei ’niw khou phungc guanglou tho,",
            "Zinghmei lym guay hac ganclou tho.",
            "",
            "4 Guang tho, he zaatc guay machuncle,",
            "Meic guay lung bang kariulou tho;",
            "Mamav, agay ’gimei ’maan khang,",
            "Dih khou kauh tuang ’zaenghmei nai khang."
          ]
        }
      },
