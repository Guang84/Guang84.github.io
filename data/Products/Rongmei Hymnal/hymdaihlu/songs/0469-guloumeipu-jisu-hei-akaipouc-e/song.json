        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guloumei pu Jisu hei aKaipouc e,",
            "Ch’rynmei Guloumei pu kiu e;",
            "Abumaengc ta taudaic lap khou ’kamhlou e,",
            "Khou 8^& gaymei duiriang how e.",
            "",
            "Kamei ^&8 ata taudaic lap khou ’kamhlou,",
            "Phuimei ramvkaengv khou",
            "sungclou e;",
            "Karamzian syng thangc ata tiiduplou the,",
            "Kabaancpav ^&8 gum binlou e,",
            "Kabaancpav ^&8 gum binlou e.",
            "",
            "2 Guloumeipu Jisu hei aKaipouc e,",
            "Apuat ’ritmei guay phungc kan the;",
            "Bow dat mak khang Kamei ata pamclou e,",
            "Tingmik ’thuic khang pumtan tiilou.",
            "",
            "3 Kasing phuc ngam lakmei suaihiam tii bam e,",
            "Karamgai ^&8 tiipadik ge;",
            "Ravguangc ta thuancna neihlaa lu ai suan e,",
            "Thuakloumei pu aRavguangc e.",
            "",
            "4 Kakumc guanhna ’niu ta kauh thangc phungc kuna,",
            "Muangh khou Kata sow ’riw pwkhou,",
            "Ch’rynmei ramzian, ringhbamv hei kauh thangc mei nunc",
            "Ching ruh, ching ruh lev kauc bam ni."
          ]
        }
