        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nazarethmeipu Jisu lam,",
            "Ning pwkhou akhang ch’ryn e;",
            "’Kumhna ata zianlou tu cho,",
            "’Khuaimei, ’phuammei paapc mei ta!",
            "",
            "Adih ch’ryn cho! Adih ch’ryn cho!",
            "Mi tingsaeng alu sw ni,",
            "Adih ch’ryn cho! Adih ch’ryn cho!",
            "Ata Gumeipu ramzian!",
            "",
            "2 Azaeng khang e Kamei huaymei,",
            "Anyng hamh, Nang nyng sw diu,",
            "Karianra khang mikdui key mak,",
            "Zei talanv 5#^ akhang e.",
            "",
            "3 Apaap guay lev arianra guay,",
            "Katuang swna laalouna,",
            "Kalvari kros khou phungclou the,",
            "Karaana ’khaengvna theiclou.",
            "",
            "4 Thuakloumei nunc lev hym daicna,",
            "Kazawpaanv ai how pwkhou,",
            "Tingsaeng neihlaana ai suan ni,",
            "Ata zianloumei lam hei."
          ]
        }
