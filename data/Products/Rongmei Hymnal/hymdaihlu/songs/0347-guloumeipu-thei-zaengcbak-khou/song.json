    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Guloumeipu thei ’zaengcbak khou",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guloumeipu thei ’zaengc baek khou ai lay tat ni,",
            "Mwnpwang puangc zangv gaypui",
            "dui luanghpui bamv khou 5#^;",
            "Kamei #^5 zayloupui bamv ’thuic ai",
            "Kathei lay ni,",
            "Pyrun laa mak saanv Kaphay kaamv suic tat ni.",
            "",
            "Lay ni! lay ni! Jisu thei ai lay ni!",
            "Kabamv ’thuic, kaganv ’thuic",
            "Kathei lay tat ni!",
            "Lay ni! lay ni! Jisu thei ai lay ni!",
            "Kamei #^5 zayloupui bamv ’thuic ai lay ni!",
            "",
            "2 Guloumeipu thei ’zaengc baek khou ai lay tat ni,",
            "Khou 5#^ pwanzingh tanc bam e, zinghmei dui luangc e,",
            "Kabaanc #^5 ata zaylou, ai ping dat zat lak khe,",
            "Jisu ’naa bam khou ata tiiping ngam mak.",
            "",
            "3 ’Zaengc baek khou punic, ramrungh siimei khou punic,",
            "Guloumeipu #^5 ’duanghnna abumaengc ping lak;",
            "Kamei tatpui chaeng khou gayna zaylou bam puni,",
            "’Thanmei guay kaduaimei",
            "Ravguangc chyng nganvna."
          ]
        }
      },
