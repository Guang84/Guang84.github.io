    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "He Khrista ai Nang ta zian diangh",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Khrista, ai Nang ta",
            "Zian diangc bam khang,",
            "Khuksunna ai ney e tiiswlou o;",
            "Mi hei aramhuai e:",
            "Nang ta zian diangc bam khang",
            "He Pou Khrista tiiswlou o!",
            "",
            "2 Kandih ramgai laa khang",
            "Ai phu khwan e,",
            "’Taw mu Nang ta phu e",
            "Tiikwnlou o!",
            "Mi hei aramhuai e:",
            "Nang ta zian diangc bam khang",
            "He Pou Khrista tiiswlou o!",
            "",
            "3 Ryanra sunupui tuang",
            "Guang geic sihni,",
            "Nang khou >|3 guangmei guay",
            "Gay khang >|3 de;",
            "Hei guay paan >|3 ai hei",
            "Nang ta zian diangc bam khang",
            "He Pou Khrista tiiswlou o!",
            "",
            "4 Ai theic ni khou nganvna",
            "Nang ta thuanc ni,",
            "Mi hei ramnavpui lat swna saa ni;",
            "Khou kiu nganv ai huay ni,",
            "Nang ta zian diangc bam khang",
            "He Pou Khrista tiiswlou o!"
          ]
        }
      },
