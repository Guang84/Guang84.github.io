        "content": {
          "format": "source-lines",
          "lines": [
            "1 He raenghmun guay, laanc kauh thau o,",
            "Zauc lo, hymdaih Guangc ’khwan bam the;",
            "Guangh guay Guangc 7?| ’naa guang pw the,",
            "Dih ta Guloumeipu guang the!",
            "",
            "2 Lungning kaikhamv guay laanc daic tho,",
            "Reicpatloumei ravkai swna;",
            "Ravguangc taanv khang tiipiulou o,",
            "Zianmei, neihlaamei padikna.",
            "",
            "3 Thuakloumeipu, guang bamlou tho,",
            "’Niw lung Nang khang laanc daiclou the,",
            "’Niw khou bammei lwn lyanlou tho,",
            "Zianmei lev zauzian padikna."
          ]
        }
      },
