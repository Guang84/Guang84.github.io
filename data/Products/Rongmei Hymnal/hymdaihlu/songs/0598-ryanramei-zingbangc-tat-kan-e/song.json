    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Ryanramei zingbangc tat kan e",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ryanramei zingbangc tat kaanna,",
            "’Thanpui ramc ’zwanna tat re;",
            "Machunhmei lu suanna tat re,",
            "’Rianhloumei dic ta phaanna;",
            "Zinghmei chung khou ’niu phaengc how e,",
            "Zayloumei riw gaanhmei ta;",
            "Khat khat baanc 6$% zamc karyna,",
            "Pingmei maekna tat gut re.",
            "",
            "2 Ravguangc khat na $%6 bam ’duanghlou,",
            "Thuakloumei Kamei nunc ta;",
            "Tamzinghmei, pingmei hacganclou,",
            "’Niu chaenglwan guay tiigaanclou;",
            "Tangclou nipui bamv khat na de,",
            "’Niu $%6 lwmmei khat na de,",
            "’Niu $%6 machunhmei khat na de,",
            "’Khwan bammei lam khat na de.",
            "",
            "3 Lu khat na suanna meic ching ching",
            "Lungh khat na swna suan e,",
            "Kalam khat na khang adow e,",
            "Ravguangc zanc khou lwan gut re,",
            "Kalam khat na khou neihlaa e,",
            "Tingsaeng duitin tangc pwkhou,",
            "Khou6$% Ngamp’rymei Pu Ravguangc",
            "Tingsaeng guanghtuna bam e.",
            "",
            "4 Hu thangc gut kho, chana thiule,",
            "Kros ta zaucna tat gut kho,",
            "Zakmei ’khaengv kho, rih adow kho,",
            "Kaswng khou ’niu ’thaekc mak saanv;",
            "Asaanh mak khe, zip’chyang thau khang,",
            "T’rou ta thuirana thau khang;",
            "Khou kiu ramswng guay ’maan ngam ni,",
            "Ryanramei nai dat lak khe.",
            "Amen."
          ]
        }
      },
