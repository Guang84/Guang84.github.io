        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tingkauh thangc zaengthaek khang nang nzwan bam khou,",
            "Kaganv ’thuic Jisu daeng tuanc o;",
            "Gay liangmei chaeng thaymei zayloumeipu e.",
            "Kaganv ’thuic Jisu daeng tuanc o.",
            "",
            "Jisu daeng tuanc o, Jisu daeng tuanc o;",
            "Kaganv ’thuic Jisu daeng tuanc o;",
            "Zingbangc kalaanv Kakhou @{4 duc pat rio,",
            "Kaganv ’thuic Jisu daeng tuanc o.",
            "",
            "2 Nang tat khou pwanzingh lev",
            "tiangchanhmei ping rio,",
            "Kaganv ’thuic Jisu daeng tuanc o;",
            "Kazauzian thaylou khou neihlaa bam khang nai,",
            "Kaganv ’thuic Jisu daeng tuanc o.",
            "",
            "3 Ravsic tuang rou-raeng khou @{4 duakna bam khang,",
            "Kaganv ’thuic Jisu daeng tuanc o;",
            "Lwmmei n-gic phungc o, rih hei ngam mak saanv,",
            "Kaganv ’thuic Jisu daeng tuanc o.",
            "",
            "4 Aniu kai tingkauh kiu tangc zai puni the,",
            "Kaganv ’thuic Jisu daeng tuanc o;",
            "Khou 4@< mu zianmei nunc lev ’tamv dat lak khe,",
            "Kaganv ’thuic Jisu daeng tuanc o."
          ]
        }
