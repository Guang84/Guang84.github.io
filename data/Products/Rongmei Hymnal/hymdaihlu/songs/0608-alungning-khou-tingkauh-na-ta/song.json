        "content": {
          "format": "source-lines",
          "lines": [
            "1 Alungning khou tingkauh na ta rigwn e,",
            "Mi 4@< lwmloumei guay lungc nipui dic e;",
            "Alungning khou tingkauh na ta rigwn e,",
            "Khou4@< zianmei nunc ata ’khwanna bam e.",
            "",
            "Tingkauh .. ta rigwn e,",
            "Heipui kaidai 4@< adih gay!",
            "Tingkauh .. ta rigwn e,",
            "Guloumei pu khou4@< bam e.",
            "",
            "2 Alungning khou tingkauh na ta rigwn e,",
            "Ataanv guay luai pwkhou kawmei ai chu ni,",
            "Tingpuk paengc thangc naimei",
            "gaychuypui ramc khou,",
            "Zianmei mut dat lakmei kaidai khou gut khang.",
            "",
            "3 Alungning khou tingkauh na ta rigwn e,",
            "Karamgai makumhna",
            "diwgaymei padik,",
            "Abumaengc hei thangc 4@< neih khat samc tat ni,",
            "Khou 4@< kanganv maekna zaengthaek bam puni."
          ]
        }
