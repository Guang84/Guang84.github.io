          "format": "source-lines",
          "lines": [
            "1 Adih gay cho, tingkauh kumc e,",
            "Kaipouc ta zianmei nunc,",
            "Lungh chamh chwn chamhna",
            "lungc pwkhou",
            "Kalat tiiguang tangc e.",
            "",
            "2 Khat khat ramrianra thaylou e,",
            "Puatrith phungc ’khavlou e;",
            "Ryanra mikdui key kary e,",
            "Neihlaa dam laa ’chamc e.",
            "",
            "3 Mamavmei, siimei, gaenghswmei,",
            "’Niu lung khou maek pwkhou,",
            "Khat khat ramsuan kakamh ngam e,",
            "Chana ramzian lyan e.",
            "",
            "4 Zianmei hei meic guay lung khou #<8",
            "Duiriang kumc luangc pwkhou,",
            "Chwn chamhmei, ning karuhloumei,",
            "Kheiliak #<8 lyan puni.",
            "",
            "5 Zianmei #<8 kachaekc riang kumcna",
            "Kauh thangc mei ta bangclou;",
            "Zianmei padikmei lungning 8}@",
            "Tingkauh dam laamei e. Amen."
          ]
        }
