      "rongmei": {
        "language": "rongmei",
        "title": "Theih makmei , how makmei,",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Theih makmei, how makmei, thay p’rymei Ravguangc,",
            "Zauc ’dyang lakmei riw #^7 Nang ta ’kamhlou e,",
            "Guigay liang, hymdaic liang, nganv makmei Kaipouc,",
            "Rih ngammei, Ngammeipu, Nang zanc ta thuanc e.",
            "",
            "2 ’Thaekc zat mak, katumh mak, kakhwan pat makna,",
            "Liamlaih mak, gat makna Nang ngamv #^7 sin e;",
            "Poubauhmei, Nang hei ’chumhmei taanhmeipu e,",
            "Nang hei gaymei, zianmei duipuakkai kiu e.",
            "",
            "3 ’Thyammei, daihmei guay khou inghmei Nang tiilou,",
            "Nang #^7 tiiloumei hei ringhmei ling kiu e,",
            "Mwn kumc ’niw puangclou e, tuai key dat nuangc e;",
            "He Kaipouc, Nang thu tingsaeng kalaih mak ge.",
            "",
            "4 He ’thanmei gaanhmeipu, hymdaihmei Ravguangc,",
            "Baanch’ra nunc Nang ta thuanc kaniw zaw gumna,",
            "Nang riw kachanmei #^7 Nang zaw ta ’kamh e,",
            "Nang ta tiihowlou o, ’niw Nang ta thuanc ni."
          ]
        }
      },
