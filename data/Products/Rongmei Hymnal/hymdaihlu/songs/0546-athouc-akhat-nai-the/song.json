        "content": {
          "format": "source-lines",
          "lines": [
            "1 Athouc akhat nai the,",
            "Ravguangc hym tiidaih khang,",
            "Theic lakmei bumaengc gulou khang,",
            "Tingkauh khang chamdaanv khang.",
            "",
            "2 ’Taw zuk khou taanv sw khang,",
            "Langloumei thouc tanh khang,",
            "Angamv guay tiipatna taanc ni,",
            "Kaipouc ningmei taanc ni.",
            "",
            "3 Akhou ngamv tiilou o,",
            "Nang hu khou lungc ngam khang;",
            "’Taw Nang bangc ta chamdaanvlou tho,",
            "Nang khang na lungc ngam khang.",
            "",
            "4 Changkhaanvna huayneyna,",
            "Nang khou na ngangvlouna,",
            "Pou, ai Nang ta tii zak lak ge,",
            "Tingkauh ai ’zwan bam khou."
          ]
        }
      },
