        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kungc liangmei latrik khat nai,",
            "Mi hei karaan khwan sihni",
            "Hei ?|7 alaucdou rwanry tiiningtow e;",
            "Apui pamv khou ai dungcna,",
            "Kabaanc ?|7 ata pamcna,",
            "’Zaenghna, niamhna akhou saa bammei khwan 7?|.",
            "",
            "Kungc liangmei latrik lev,",
            "Mikdui timhmei latrik guangc ei zauc nii e,",
            "Tingmik ’thuic gay ’bu ku e,",
            "’Rumpui chaeng ai tat bam khou;",
            "Thei thangc ata tingkauh kai khou zaylou puni.",
            "",
            "2 Jisu alauc ta zianmei,",
            "Kros khou ryanra khaengvpui p’ry,",
            "Apui ?|7 khou 7?| ?|7 akhou paclou e,",
            "Jisu taanv makumh pwkhou",
            "Ai amikdui key khwan e;",
            "Mikdui roulouna saa e:",
            "“Mi nang khang the.”",
            "",
            "3 Hei ganv guay 7?| rii kan the,",
            "’Ki tingmik ’thuic ning tow e,",
            "Latrik guangc hei ?|7 ata zaylou bam e;",
            "Apui ?|7 dinclou duh kumc,",
            "Jisu ningmei ai taanc ni!",
            "Kaganv ’thuic alung khou",
            "Ravguangc lat nai e."
          ]
        }
