    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Ai rui suan niimei neihlaamei lu",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai #<8 suan niimei neihlaamei lu nai,",
            "Lauphunhswan khou ’ruayna kumc neihlaa pwkhou;",
            "Alu hei neihlaamei padikmei lu e;",
            "Zinghmei ta nganv tiigaanc ngammei lu e.",
            "",
            "Ch’rynpui lu, lu thanh! (2)",
            "’Taw ai suan ngam the, thuakloumei nunc lev;",
            "Ngamv lev guanghdic hei guanghtu nimei pu khang,",
            "Swluai kanmei Lauziu Nac hym daic diu!",
            "",
            "2 Ai kunghmei riangluaic, kaikhunhmei nai e,",
            "Katuakc khou kaniw lat katupna ’king e;",
            "’Ki gay ranvmei kai khat naimei ai thay e,",
            "Thangc 8}@ suanmei lu 8}@ ai nic suan e.",
            "",
            "3 Ai reih rei ni cho, lungh ryanra ni cho,",
            "Kaipouc #<8 ata tiineihlaalou bam khou?",
            "Kamei #<8 kai gaymei peyna ta soucna",
            "“Nang khang nic bamv nai,” twnainc bam khou?",
            "",
            "4 Kai gaymei ta 8}@ ai how puni the,",
            "Diwsiimei panty hei tingzyn key pwkhou;",
            "Ai thay e, diwsiimei, zinghmei lym khou hei,",
            "Kakhou zaylou khang gaanhmei chaeng nai e."
          ]
        }
      },
