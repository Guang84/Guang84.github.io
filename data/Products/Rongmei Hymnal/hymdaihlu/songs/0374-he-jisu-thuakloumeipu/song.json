        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zaeng ’thaekc zuh zupui bamv khat nai,",
            "’Niu Pu Ravguangc pamv khou,",
            "Paapc @{4 sw katuakc makpui bamv,",
            "’Niu Pu Ravguangc pamv khou.",
            "",
            "He Jisu, Thuakloumei pu,",
            "Ravguangc khou @{4 keymei,",
            "Pamclou o, ’niw ’khwan bam e,",
            "’Niw Pu Ravguangc pamv khou.",
            "",
            "2 Amanv gaypui bamv akhat nai,",
            "’Niu Pu Ravguangc pamv khou,",
            "Gumeipu ta ariwpui bamv,",
            "’Niu Pu Ravguangc pamv khou.",
            "",
            "3 Duakpatpui bamv gaymei khat nai,",
            "’Niu Pu Ravguangc pamv khou,",
            "Neihlaa, chuzaenghpui bamv kiu e,",
            "’Niu Pu Ravguangc pamv khou."
          ]
        }
