    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Alauc nunc nic gaychamv dinhmei",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Alauc nunc nic daihmei ringhbamv",
            "chamv dinhmei sw nuh e,",
            "Thuakloumeipu ^&8 kros phunghmei p’ry 8^& rac nuh e;",
            "Kaniw neihlaamei kaipat ^&8 Baibal tiitat nuh e,",
            "Duipaengc duiruc bammei nuncta tiineihlaa puni.",
            "",
            "Alauc nunc nic gaychamvdinhmei sw nuh e,",
            "Guloumeipu ramzian lam khou;",
            "Alauc nunc nic gaychamvdinhmei dam laa nuh e,",
            "Kauh thangc kai khou zaylouna.",
            "",
            "2 Alauc nunc nic Kaipouc taanv khou",
            "kaniw dam nai muay de,",
            "Kaniw zawpaanv ^&8 ryanra",
            "puatphung tii’maan nuh e;",
            "Lungh ryanrana liaulu bammei nunc ta ’khavlou nuh e,",
            "Zianmei latkaeng ^&8 neihriw kumc tiigaanclou nuh e.",
            "",
            "3 Alauc nunc ta nic Gumeipu",
            "latryan khou ningtow e,",
            "Thuakloumei zauzian suaihiam 8^& kaniw laa nuh e;",
            "Kaniw ta zianna zauclou bam e, Kamei ’rianhlou e,",
            "Kaniw tuang baanch’ra nunc kauh thangc Pu zaw how bam e."
          ]
        }
      },
