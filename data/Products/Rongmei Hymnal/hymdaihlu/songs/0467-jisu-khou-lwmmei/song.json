        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu khou lwmmei gay changh e;",
            "Kalat ta lwm rapmei hei,",
            "Kalatryan khou ngangvloumei hei,",
            "Kaipouc lat ta thaymei hei.",
            "",
            "Jisu, Jisu, Kata ai lwm,",
            "Kamei akhang suai zat mak;",
            "Jisu, Jisu kunghmei Jisu!",
            "Zauzian paan lwm ’tip bam ni!",
            "",
            "2 Jisu khou lwmmei adih gay,",
            "Sw ’thanmei zei khou lwmmei,",
            "Tiigaymei, sw ’thanmei dui khou,",
            "Lwmpui paan ?|7 lupmei hei!",
            "",
            "3 Jisu khou lwmmei gay changh e;",
            "Paapc lwnlung ganclou ducna,",
            "Ringhmei, zaeng ’thaekcmei, chuzaenghmei,",
            "Jisu khou ?|7 laamei hei.",
            "",
            "4 Neihlaa the, Nang khou ai lwmna",
            "Kunghmei Gumei pu Jisu!",
            "Ata ’duanghloumei ai thay e,",
            "Katwan nganv ’duanghlou puni."
          ]
        }
