    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Neihlaa neihlaa Khrista",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tingkauh nzaengc guang tangc pwkhou,",
            "Tingkauhmei kangdai lev",
            "Neihlaana lu khat na kauc ni,",
            "Jisu ramzian lu 2^<;",
            "Aniu tingkauh kachaekc raengcmun",
            "Tangcna kaamc gut pwkhou",
            "’Thanmei nunc neihlaana lu thanh",
            "Nrah zayna suan ni.",
            "",
            "Neihlaa, neihlaa Khrista anaa bam de,",
            "Karamzian ai thay e,",
            "Niamhmei Kakhwan chu e;",
            "Aniu thei thangc kauh khou ariw pwkhou,",
            "Neihlaana lu khat na kauc ni",
            "Jisu ramzian 2^<.",
            "",
            "2 Kanganv maekmei tingsaengzaeng tuang",
            "Tingkwm khou lungc pwkhou,",
            "Rihngam lu hei duidai khwan kumc",
            "Neihlaana suan bam ni;",
            "Ringhmei duibaek dai khou 2^< !}2",
            "Kachaekc riw pan pat re;",
            "Khou 2^< mikdui key dat lak khe,",
            "Neihlaa taek dat lak khe.",
            "",
            "3 ’Niu ta howmei kumc ’niu how ni,",
            "Thaymei kumc thay puni;",
            "Ndiakmei lauzam khou ruan ni,",
            "Guanghbamvpaeng ta zaucna;",
            "Kachaekc nrah khwan gaymei khou",
            "Neihlaa lu suan bam khou,",
            "Jisu tingsaengzaeng guanghtu khang",
            "Guangh pyrun runlou ni."
          ]
        }
