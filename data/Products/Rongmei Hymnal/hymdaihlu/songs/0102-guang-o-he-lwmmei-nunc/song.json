        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guang o, he lwmmei nunc,",
            "Neihlaana guanglou o,",
            "Katumcna ’taw Bethlehem ’zwan tat di kho,",
            "Zauc lo, guaihkuak khou Guangh ta ’zilou bam the,",
            "Guang o, aniu kalum kho,",
            "Guang o, aniu kalum kho,",
            "Poubauhmei Khrista ta kalum di kho.",
            "",
            "2 Suan o, baanch’ra guayle,",
            "Rihngampui lu kauc o,",
            "Thuanhpui khwan tingpuk kauh thangc }?2 kauc key o;",
            "Kauh liangmei khou ’niu Racguangc hym daic kan diu!",
            "Guang o, aniu kalum kho,",
            "Guang o, aniu kalum kho,",
            "Poubauhmei Khrista ta kalum di kho!",
            "",
            "3 Amen! Pou ta thuanc e,",
            "’Niu ringcbamv khang puanc e;",
            "He Jisu, Nang zanc ta tingsaeng kalum diu;",
            "Ravguangc Lat maansei guanhna puanhmeipu e;",
            "Guang o, aniu kalum kho,",
            "Guang o, aniu kalum kho,",
            "Poubauhmei Khrista ta kalum di kho."
          ]
        }
