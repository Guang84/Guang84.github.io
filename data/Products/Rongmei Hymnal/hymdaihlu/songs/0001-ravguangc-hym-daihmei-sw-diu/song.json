        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc hym daihmei sw diu, Alleluia;",
            "Baansyam guay thuancna kauc diu, Alleluia;",
            "Suaihiam lev chuzaenghmei khang, Alleluia;",
            "Kauh lev dih suan adaw diu, Alleluia.",
            "",
            "2 Kalungp’rik guay rui thuanc diu, Alleluia;",
            "\"Ravguangc hei gay e\" suan diu, Alleluia;",
            "Lakna ’gyntatmei nunc ni, Alleluia;",
            "’Thanmei nunc lev lay suan diu, Alleluia.",
            "",
            "3 Khwan maekmei gaanchuangc guay nic, Alleluia;",
            "Kaniw Guangc hym tiidaic diu, Alleluia;",
            "Ngamv guay lev baanch’ra nunc lu, Alleluia;",
            "’Niw Ravguangc khang thuanclou diu, Alleluia."
          ]
        }
      },
