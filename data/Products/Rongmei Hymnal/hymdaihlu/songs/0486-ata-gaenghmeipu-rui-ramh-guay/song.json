        "language": "rongmei",
        "title": "Ata Gaenghmeipu rui ramh guay",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ata Gaenghmei pu ^&8 ramh guay tiilou ni,",
            "Jehovah hei Kazanc e;",
            "’Diakc gaymei ’phuaihpung khou ata tiitulou,",
            "Luangc bammei duithuak daeng khou;",
            "Maeng nimei chwn ta zay guanglou at re,",
            "Kachaeng khou tat mak pwkhou,",
            "Karamzian paan khou ^&8 ata zaylou e,",
            "’Twnmei lev zauzian chaeng khou.",
            "",
            "2 Theihmei nzaengc lym 8^& ai tat kaan pwkhou,",
            "Nang tat ’duanghna ai ping mak,",
            "Nang ’khavloumei latkaeng khat na saa pwkhou,",
            "Ai pingmei guay tii ’maan e;",
            "Ata zauczihmei nunc ^&8 zauc bam khou",
            "Akhang taektw chamdaanvlou;",
            "Abuangc hei suaihiam ^&8 padik lyam key the,",
            "Apy khou thauh teylou e.",
            "",
            "3 Ravguangc tuang suai makmei chamdaanvloumei 8^&",
            "Aringcting saanv laa tow ni,",
            "Nang tuang kai hei akhang lunghpui bamv sw diu,",
            "Ataanv guay khou Nang pian diu,",
            "Hei khou 8^& akhang zaengthaek laa tow ni,",
            "Baihmei nunc riu lak bam khou,",
            "Zawthay makmei ginpu akhat sw makna",
            "Kanac khat swna lungc ni."
          ]
        }
      },
