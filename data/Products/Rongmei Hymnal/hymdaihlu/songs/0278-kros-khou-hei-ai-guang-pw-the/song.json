        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kros khou hei ai guang pw the,",
            "’Suanmei e, miktiatmei e;",
            "Ramh guay akhang gaeng mak khe,",
            "Ringhbamv laa khang ai guang the.",
            "",
            "Kaipouc, Nang khou ai lwm the,",
            "Kalvari Lauziu Nacle;",
            "Nang kros khou ai ’khum key e,",
            "’Taw gulou o, he Jisu.",
            "",
            "2 Nang ta phumei tingsaengc the,",
            "Siimei !}2 zyn saengc khwan the;",
            "Jisu akhou saalou e:",
            "“Paapc khou !}2 sw ’thanlou ni.”",
            "",
            "3 Atuang guay Nang khou tii the,",
            "Kaganv guay, pam guay, lanv guay,",
            "Apumc lev abumaengc hei",
            "Tingsaengzaeng Nang tuang swkhang.",
            "",
            "4 Pou, Nang khou ai lwm bam ni,",
            "Kalvari Lauziu Nacle,",
            "Nang kros khou ai ’khum key e,",
            "Jisu ata gulou the."
          ]
        }
      },
