        "content": {
          "format": "source-lines",
          "lines": [
            "1 Lauthwan kiu kai thangc ’niu sowriw ni cho,",
            "Kangranmei duipui paengc gaymei khou,",
            "Zianmei nunc ’khwan saengcna bampui bamv khou?",
            "Adih ch’rynmei ramkaduai ni cho!",
            "",
            "Kaduai ni! .. kai khou 5^&!",
            "Kangranmei duipui paengcgaymei khou!",
            "Kaduai ni! .. kai khou 5^&!",
            "Zianmei guay lev tingsaeng lungc ’chamc khang!",
            "",
            "2 Lauthwan kiu kai thangc ’niu sowriw ni cho?",
            "Ryanramei khou ^&5 duak suang ni cho?",
            "Thuakloumei nunc lev lay suan ’chamc ni cho?",
            "Adih ch’rynmei ramkaduai ni cho!",
            "",
            "3 Lauthwan kiu kai thangc ’niu sowriw ni cho?",
            "Thuakloumeipu ta sowriw ni cho?",
            "Zianmei nunc lev ’niu khat khat thay ni cho?",
            "Adih ch’rynmei ramkaduai ni cho!"
          ]
        }
