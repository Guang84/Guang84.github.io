        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Niu Racguangc daihmei rilin e,",
            "Pangv zat makmei raengc kiu e;",
            "Theihmei duidai kamuatcmei khou",
            "’Niu ta ’khavloumeipu e.",
            "Siimeipu $%6 ’taw nganv",
            "Sw kasic khang phu bam;",
            "Rouhsii ngamv daih pouc e,",
            "Karaengmei padik ge,",
            "Kakumc siimei maek dih khou.",
            "",
            "2 ’Niu raa na ngamv $%6 ’dow ethei,",
            "’Niu lakh nsa taan nuh e,",
            "Ravguangc $%6 Kapahloumeipu,",
            "Aniu biak liangh mak ethei.",
            "Hei Pu kiu thow 6$% cho?",
            "Khrista Jisu hei the!",
            "Kazanc Sabaoth kaw e,",
            "Kalaic zat makmei e,",
            "Kamei $%6 rih ngamlou ni.",
            "",
            "3 Ravsic padikmei kandic $%6",
            "’Niw ta kadung bam sihni,",
            "’Niw ping lak khe, Ravguangc nai e,",
            "Katuang ’chumhmei $%6 ngam ni.",
            "Lanv, riangluaih ’maan tan diu;",
            "Mbaanv pumc nganv ’maan diu,",
            "Pumh ta swluai nuh e;",
            "’Chumhmei mu kalaic lak,",
            "Ravguangc dic kanganv maek khe."
          ]
        }
      },
