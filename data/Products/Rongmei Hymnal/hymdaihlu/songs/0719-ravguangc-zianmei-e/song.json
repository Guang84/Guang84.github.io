          "lines": [
            "1 “Ravguangc zianmei e!” zianmei ?|7",
            "’Niu chaenglwan tiigaanclou e;",
            "Suaihiam ?|7 ryanramei tii’maan,",
            "Ravguangc gaanhmei, zianmei e!",
            "",
            "Ravguangc gaanhmei,zianmei e!",
            "Ravguangc gaanhmei,zianmei e!",
            "",
            "2 Kadyng maekna kalaic bam khou,",
            "Thiankey gaanvthauh key khou hei,",
            "Ravguangc zauzian thu kalaih mak,",
            "Ravguangc gaanhmei, zianmei e!",
            "",
            "3 Zingc liangmei ganv khou 7?| nganvna",
            "Karamgai kalaih mak ge;",
            "Tamzinghmei guay tiigaanclou e,",
            "Ravguangc gaanhmei, zianmei e!"
          ]
