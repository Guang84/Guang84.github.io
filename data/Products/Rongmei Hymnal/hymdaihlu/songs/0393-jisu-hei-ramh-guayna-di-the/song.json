        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu hei ramh guay na di the,",
            "Ringhmei neihlaamei e;",
            "Kamei tingmik ’thuic pumtan e,",
            "Kapaan hamhna bow ni;",
            "Lungh ryanra khou Kakhou guang e,",
            "Kakumc tiineihlaamei maek ge,",
            "Lungh ryanra khou tiineihlaamei",
            "Kaipouc e!",
            "",
            "2 Jisu hei ramh guayna di the,",
            "Ryanra ganv khou Pam e Suaihiam laa khang Kakhou ai guang,",
            "Kamei tiidat dat re;",
            "Kamei ^&5 ting-neih tiilou e,",
            "Kathai luak khang kathai tiilou,",
            "Neihriw lev ting, kathai tiilou,",
            "Kaipouc ^&5!",
            "",
            "3 Jisu hei ramh guay na di the,",
            "Ai Kalat piu chuy ni,",
            "’Kumhna ai nuh mak ngam ni cho,",
            "Hei di gaymei Pam ta?",
            "Kathei laymei ntwnmei e,",
            "Katuang kros ahu khou louna",
            "Zingbangc kalaanv Kathei lay ni,",
            "Kaipouc thei!",
            "",
            "4 Jisu hei ramh guay na di the,",
            "Baihmei pam kage maek,",
            "’Taw Kata lwm, ai lwm bam ni,",
            "Panty luaimei nganvna;",
            "Kata lungc ’chamcmei adih gay,",
            "Mut dat makmei gaymei panty!",
            "Ringc taek makmei, neihlaa suang- mei, Kakhou nai!"
          ]
        }
      },
