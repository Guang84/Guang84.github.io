        "language": "rongmei",
        "title": "Nang hymdaih chamv tei rac bam e",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang hymdaih chamv 8^& rac bam e,",
            "He Zion, Ravguangc kaidai;",
            "Kalat kai dat makmei pu ^&8",
            "Kalwng bamv khang swlou the;",
            "Tingsaeng Taudaic khou suamclou the,",
            "Tabui ^&8 kanuk ngam cho?",
            "Ringhbamv ngaengsaengc ^&8 raengc ’kuay e,",
            "Zauczihmei ta ping khang maek.",
            "",
            "2 Zauc lo, ringhmei duiriang guay 8^&,",
            "Tingsaeng zianmei zeic khou ^&8",
            "Kanac nunc khang luangc liklou e,",
            "Mpun-alun ta ping mak;",
            "Hei kumhmei duithuak luangc bam khou",
            "Thow 8^& t’ri dat khang nai cho?",
            "Tiimei pu kumc Kazauzian hei",
            "Zuk zuk khou suai zat mak ge.",
            "",
            "3 ’Niu lunghpui bamv ’thuic bam haengvna,",
            "Muangh lev maibwang ta zauc lo;",
            "Ravguangc Nac bammei ta lyan e,",
            "Kahym ^&8 hwam bin bam e;",
            "Nang hym daih chamv 8^& rac bam e,",
            "He Zion, Ravguangc kaidai,",
            "Kalat kalaic makmei pu ^&8",
            "Kalwng bamv khang swlou e."
          ]
        }
      },
