    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "DUHMEI NAAMEI ZAAT C GUAY RAVGUANGC",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Duhmei, ’naamei zaatc guay Racguangc,",
            "’Niw guay ta sinmei pu,",
            "Nangmei nunc ta suaihiamlou o,",
            "Chuzaengh khang phu bam khou.",
            "",
            "2 Buybaeng khwan >|3 tingpuk padik,",
            "Rih khwan >|3 padik ge;",
            "Pingmei padikmei zingbangc khou",
            "Zei keymei khwan chu e.",
            "",
            "3 Chu ’than ranv e, scientist nunc khwan,",
            "Ravmun dinhmei nunc khwan,",
            "Ningtyngmei dihsinmei nunc khwan,",
            "Taanclou reymei nunc khwan.",
            "",
            "4 Sin ’tip ranv e, taanv taanhmei nunc,",
            "Baanh n-gwangmei baanc 3>|,",
            "Kaniw lwmmei, kaniw lu 3>|,",
            "Meic ching ching suan ’dauh e.",
            "",
            "5 Duitin khou >|3 duitin nganvna",
            "Meic nunc kauc saanv bam e,",
            "Dih lev duipui zinghmei ruc khou,",
            "Pentikost mai chuangc e.",
            "",
            "6 He Ravguangc, rih tuang syang khou >|3",
            "’Niw ta tiiduaklou o,",
            "’Twnmei latzan, zianmei, ’zaenghmei",
            "Tiiguang katumclou tho. Amen."
          ]
        }
      },
