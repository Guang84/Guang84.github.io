        "content": {
          "format": "source-lines",
          "lines": [
            "1 Hallelujah! ringcthau dat the!",
            "Jisu kauh thangc ku kan the!",
            "Theihmei roukham thuira pat the!",
            "Kauh lev dihmei guay kauc o:",
            "Kamei thau the, Kamei thau the,",
            "Ringcthau the, theic dat lak khe. (2)",
            "",
            "2 Hallelujah! ringcthau dat the!",
            "Aniu Kaipouc sw khang e;",
            "Bumaengh ta sakhi khang ’diu key,",
            "Kamei ’niu Gupouc di the:",
            "Kamei thau the, Kamei thau the,",
            "Ringhmeipu, guang nimei",
            "Guangc. (2)",
            "",
            "3 Hallelujah! ringcthau dat the!",
            "Theihmei sat tii’maanlou the;",
            "Khrista hei ringcthaumei kiu e,",
            "Kamei nunc ta tiithau ni:",
            "Kamei thau the, Kamei thau the,",
            "Ringhmei pu, guang nimei",
            "Guangc. (2)"
          ]
        }
      },
