    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Amaanmei khou ai lungc saengc",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Amaanmei khou ai lungc saengc khwan the,",
            "Kaipouc theicloumei thouh sw makna;",
            "Thay mak khwan e akhang theicloumei,",
            "Kalvari khou.",
            "",
            "Khou3>| zauzian nsa tiilou e,",
            "Khou3>| kuakloumei lyan daiclou e,",
            "Khou3>| abumaengc ta ’patlou e,",
            "Kalvari khou.",
            "",
            "2 Ravguangc lat paan apaap lam thay khou,",
            "Ai pingna kadunhna bam khwan e;",
            "’Khuaimei ai lunghlaicna guangmak saanv,",
            "Kalvari khou.",
            "",
            "3 ’Taw mu Jisu khou tiilou ngam the,",
            "’Taw mu Kata aGuangc khang laa the;",
            "’Taw mu abumaengc neihlaana suan,",
            "Kalvari khou.",
            "",
            "4 He, ringhbamv chaeng swloumei ramzian,",
            "He, mi 3>| phungc keyloumei zauzian;",
            "He, Ravguangc >|3 dwanloumei pumh daih,",
            "Kalvari khou."
          ]
        }
      },
