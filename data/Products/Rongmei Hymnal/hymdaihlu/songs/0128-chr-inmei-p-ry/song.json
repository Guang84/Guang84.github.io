        "content": {
          "format": "source-lines",
          "lines": [
            "1 He adih gay cho, Jisu p’ry hei!",
            "Paapc mei nunc khang theicloumei pu,",
            "Ch’rynmei Guloumeipu tuang chamv hei,",
            "Ai rac kaluaih luaih bam ni the!",
            "He ch’rynmei, ch’ryn kanmei p’ry kiu e!",
            "Kamanv kungc liangmei p’ry kiu e!",
            "Ai rac kaluaih bam ni,",
            "Kauh thangc mi ch’rynmei p’ry hei",
            "Karamgai ai howpui nungc kiu.",
            "",
            "2 Hymdaihmei kauh kai thangc #<8 key e,",
            "Paapc ranh khang Kazei keylou the;",
            "Thuaklou suangmei hei liulou khang e,",
            "Kamei gulou khang ngammei e.",
            "",
            "3 Kazauzian hei dui kumcna luangc e,",
            "Karamzian hei kadath maek ge;",
            "Karamzian hei tingsaeng khan biuc e,",
            "Hei #<8 ata nganv gulou e."
          ]
        }
      },
