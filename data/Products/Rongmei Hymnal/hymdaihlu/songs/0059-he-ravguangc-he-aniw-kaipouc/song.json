        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Ravguangc, he aniw Kaipouc,",
            "Reynungc hu thangc Kaipouc,",
            "Pwanzingh guang khou duppuibamv Nang,",
            "’Niw tuang tingsaeng kai e.",
            "",
            "2 Luanghbut guay hei damh mak khou #^5,",
            "Kandih nai mak khou #^5,",
            "Nganv makmei thangc #^5 Ravguangc e,",
            "Nganv makna kum bam ni.",
            "",
            "3 Tingkwm ching hei Nang mik zaw khou",
            "Tingzyn khat ganv na kumc,",
            "Neihpat makmei hu khou zingbangc",
            "Katumcna luai kan kumc.",
            "",
            "4 Kaganv #^5 luangc bammei dui kumc,",
            "Maansei guay ta phungc tat,",
            "’Muc kan the, kaniw ta mang kumc,",
            "Maek khe, tinggaanc pat khou.",
            "",
            "5 He Ravguangc, ’khavloumei Kaipouc!",
            "Aniw machunc Nang e;",
            "Tingsaeng aniw kai swlou o,",
            "Ringc bam saanv gaeklou o."
          ]
        }
      },
