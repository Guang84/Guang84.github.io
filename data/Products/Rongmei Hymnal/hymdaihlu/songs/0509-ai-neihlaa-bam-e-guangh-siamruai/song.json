      "rongmei": {
        "language": "rongmei",
        "title": "Ai neihlaa bam e, Guangh siamruai",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai neihlaa bam e, Guangh siamruai taanv khou hei,",
            "Ai neihlaa e, neihlaa changh e;",
            "Akhang ’chuzaenghmei lev neihlaamei nai the,",
            "Guangh tuang siamruai taanv khou hei.",
            "",
            "Guangh tuang siamruai taanv khou hei,",
            "Talent kathuic phungc guang ni,",
            "Akhang ’chuzaengh, neihlaa nai the,",
            "Guangh tuang siamruai taanv khou hei.",
            "",
            "2 Ai neihlaa bam e, Guangh siamruai taanv khou hei,",
            "Ai neihlaa e, neihlaa changh e;",
            "Ryanra khou, neihlaa khou ai lu suan ngam e,",
            "Guangh tuang siamruai taanv khou hei.",
            "",
            "3 Ai neihlaa bam e, Guangh siamruai taanv khou hei,",
            "Ai neihlaa e, neihlaa changh e;",
            "Zayloumei Kabaanc ai zamc tanh tan bam ni,",
            "Guangh tuang siamruai taanv khou hei.",
            "",
            "4 Ai neihlaa bam e, Guangh siamruai taanv khou hei,",
            "Ai neihlaa e, neihlaa changh e;",
            "Akhou naimei guay neihlaana phungc guang e,",
            "Guangh tuang siamruai taanv khou hei."
          ]
        }
