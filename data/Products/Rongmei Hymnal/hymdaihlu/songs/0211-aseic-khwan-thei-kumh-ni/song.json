        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu kandih khou key dat pw the,",
            "Aseic khwan ’thei ’kumh ni?",
            "Zianmei lev ngamv >|3 sin khang key the,",
            "Aseic khwan ’thei ’kumh ni?",
            "Khamloumei nowpeic ta laa khang,",
            "Thuakloumei, ’thanmei kapwm ta",
            "Kabamv ’thuic khou khuam khang key the;",
            "Aseic khwan ’thei ’kumh ni?",
            "",
            "",
            "Hymdaih! hymdaih! khou kiu neihlaa puni;",
            "Hymdaih! hymdaih! pyrun runlou pwkhou;",
            "Hymdaih! hymdaih! katumcna chamdaanv tho;",
            "Hymdaih! hymdaih! Jisu key dat pw the.",
            "",
            "2 Seitaan ngamv 3>| ’maan kan puni the,",
            "’Seic khwan ’thei gay ni e!",
            "Ryanra lakmei 3>| nai dat lak khe,",
            "’Seic khwan ’thei gay ni e!",
            "Khrista khou theihmei ringcthau ni,",
            "Tingpuk khou ’riw khang phungc ku ni;",
            "Hei tingmik kiu ’bui nungc ni cho?",
            "Aseic khwan ’thei ’kumh ni?",
            "",
            "3 ’Niu hei laalou nuhmei sw ni cho,",
            "Kamei ’seic key ethei?",
            "Ping makna neihlaana ’riw ni day,",
            "Kamei ’seic key ethei?",
            "Key nimei madan padik the,",
            "Neihpat thangc gaanh riw pat pw the,",
            "Changkhaanv tho, kaganv ’naa guang the;",
            "Aseic khwan ’thei ’kumh ni?"
          ]
        }
