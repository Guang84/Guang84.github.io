        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tingsaeng hymdaic bammei",
            "Racguangc,",
            "Tingpuk kandih khou,",
            "Kabamv ’thuic Nang tuang",
            "ch’rynmei ta",
            "’Niw mik #^5 how e;",
            "’Niw tuang teleskop #^5 phuna",
            "Tingpuk phaengc kaan khou,",
            "’Thyam liangmei atom rou raeng ta",
            "’Niw makumh pwkhou.",
            "",
            "2 ’Niw byn hei nsa karaeng thangc",
            "Tiidaic pat bam khou,",
            "Bw, Neih, Gaanchuangcna",
            "thangc nganvna",
            "Nang zaylou bammei;",
            "’Thukmei laboratory khou",
            "Nang thukh lyanlou e,",
            "Damhmeipu tuang ch’rynmei taanv 5#^",
            "’Niw mik #^5 how e.",
            "",
            "3 Nai bammei kalwnlung guay khou",
            "Nang chwn lyanlou e,",
            "Kaipouc tuang thyamrav how pwkhou",
            "Lwmmei tiitanc e;",
            "Hahlah lana ’niw makumh e",
            "Nang tuang thyamrav ta,",
            "Bw, Neih, Gaanchuangcna kaguay ta",
            "Nang #^5 damclou e.",
            "",
            "4 Maansei rwanry guay khou",
            "Nang #^5",
            "Taanv swlou bam e;",
            "Nang Nac ’Pouh Jisu Khrista #^5",
            "Nang lwn lyanlou e;",
            "’Niw ta gu khang guangmeipu hei",
            "’Niw machunc di the;",
            "Tingsaeng hymdaic bammei",
            "Racguangc,",
            "Nang zanc ta thuanc diu!"
          ]
        }
      },
