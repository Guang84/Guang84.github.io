        "content": {
          "format": "source-lines",
          "lines": [
            "1 Gumei pu, ringhpaan ta suangc",
            "Nang khou ai bam tuancna bam ni the;",
            "Nang zei @<4 khiu ’thanlou tho,",
            "Nang daeng ata tiibam tuanclou o.",
            "",
            "Tingmik ’thuic kaganv ’thuic,",
            "Nang ngamv 4^& tiithaylou o;",
            "Nang zauzian 4^& @<4 ata",
            "Kaipouc, Nang daeng tuancna bangclou o.",
            "",
            "2 Kadyng maekmei kandic khou,",
            "Achaengtat khou ata zaylou o;",
            "Nang khou ngangvloumei paan @<4,",
            "Achaeng khat sic’ maanv dat zat lak khe.",
            "",
            "3 Ai Nang ta zian diangc bam ni,",
            "Samc bammei apanty mut maksaanv;",
            "Gay ranvmei dic tingkauh khou",
            "Zianmei khou abumaengc lungh mak saanv."
          ]
        }
      },
