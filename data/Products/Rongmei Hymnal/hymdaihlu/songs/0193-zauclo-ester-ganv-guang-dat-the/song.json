      "rongmei": {
        "language": "rongmei",
        "title": "Zauclo, Ester ganv guang dat the",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zauc lo, Easter ganv guang dat the,",
            "Neihlaamei padikna;",
            "Zauc lo, roukhamtauc hei laanc the,",
            "T’rou ta ngammei lyan khang.",
            "Jisu ringcthau the, saamei kumc,",
            "Rih ngamna t ’rou khou >|3 thau the!",
            "Neihlaana suan o, Easter ganv khou",
            "Jisu thau the gulou khang ngamna.",
            "",
            "2 Zauc lo, theih pwanrai kaguay 3>|,",
            "Kadip chuylou bam the;",
            "Zauc lo, zinghmei t’rou raeng ta 3>|,",
            "Jisu khou 3>| maek khe.",
            "",
            "3 Zauc lo, Kamei tat bam dat the,",
            "Tiisaengc tiidaiclou the;",
            "Zauc lo, hymdaihmei",
            "Kazaw 3>| Kariw tiitah ta the.",
            "",
            "4 Zauc lo, Easter ganv guang dat the,",
            "Easter latlu phungcna,",
            "Zauc lo, Easter kaipat pangc khou",
            "Kaipouc tuang rih ngammei!"
          ]
        }
      },
