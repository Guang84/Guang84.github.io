          "format": "source-lines",
          "lines": [
            "1 Nang tuang kuakpaeng khou hei",
            "He Poubauhmei,",
            "’Niw pangc khou Nang bammei",
            "Tiithaylou o;",
            "Paapc tuang lungning guay hei",
            "Laa ganclou o;",
            "Nang tuang khwmkih taektw tu khang bam khou,",
            "Tu khang bam khou.",
            "",
            "2 ’Niw lev tu ’chamclou o,",
            "’Tyan bybakna;",
            "Buangh khou hei luanlou o,",
            "Ringhmei-dui 6_>;",
            "Kuakloumei, chuzaenghmei",
            "’Niw laatow ni;",
            "Bangcloumei ricpatmei",
            "’Niw laa tow ni.",
            "",
            "3 ’Niu lwmmei panty hei",
            "Padik puni;",
            "Tingmik ’thuic khang biuhmei",
            "Pumtan tii ni;",
            "Ringhmei ’tyan tiituna",
            "Ndaap lak khe;",
            "Gumei pu ta howna",
            "’Niu pian puni.",
            "",
            "4 He guanglou o, Khrista,",
            "Tiitulou o,",
            "Zotpi hianmei baanc _>6",
            "Kahilou o;",
            "’Niw khou padiklou o,",
            "Nang zauzian _>6,",
            "Tingkauh khou ’niw bam khang",
            "Chamdaanvlou o. Amen."
          ]
        }
