        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ringhting Racguangc, tingkwm gwan kathuic khou",
            "Nang khou ngangv e;",
            "Tat kanmei khou katuakcmei kathuic khou",
            "Nang baanc how e,",
            "Tingmik thuic lauthwan patmei kathuic khou",
            "Suai zat makmei Nang zauzian khou lwm e.",
            "",
            "2 Tat kanmei ganv Racguangc, ’niw tuang ganv hei",
            "Nang ^&8 sin the;",
            "Lwmmei paan ^&8 ’rianhloumei dic ling khou",
            "Nang zaylou o;",
            "Nang bam pwkhou zinghmei hei gaanhmei kumc,",
            "Machunhmei ta how tanghmei swlou e.",
            "",
            "3 Guang nimei ganv Racguangc,",
            "Nang ta suic e,",
            "’Niw Phaykaamv hei;",
            "’Niw tanc pw khou ’niw ta ganc rulou rio,",
            "He Duppui bamv;",
            "’Niw khang tingmik ’thuic taektw swlou o,",
            "Nkhamh pwkhou ’niw kailing swlou o."
          ]
        }
