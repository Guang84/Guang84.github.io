            "1 Guloumeipu, Ravguangc Nang khou,",
            "Lwmlou nungc 4^& daihmei neic e,",
            "Alungsyng thangc neihlaa bam ni,",
            "Zaenggay chamv hei dinc lik bam ni.",
            "",
            "Neihlaamei tingmik ge!",
            "Jisu apaap khiulou nungc 4^&!",
            "Changkhaanv bam khang,",
            "huayney bam khang,",
            "Neihlaa bam khang nchamlou e,",
            "Neihlaamei tingmik ge!",
            "Jisu apaap khiulou nungc 4^&!",
            "",
            "2 Luai the, taanv daih taanc luailou the,",
            "Kaipouc akhang, ai Kakhang e;",
            "Kamei zaylou, ai Kathei lay,",
            "Kakhwan neihlaana ’king bam ni.",
            "",
            "3 ’Taw mu alung hei zaeng ’thaekc the,",
            "Lunghkwn, neihlaana zaeng ’thaekc the;",
            "AKaipouc khou bam chuy bam ni,",
            "Kakhou @<4 e, gaymei guay hei!",
            "",
            "4 Kauh thangc chu kanmei latryan 4^&,",
            "Tingmik ’thuic tiichu thanh bam ni,",
            "Theihthiu laapui nganv ai ding ni,",
            "Latryan khou neihlaana theic ni!"
          ]
