        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kandih mei guay ?|7 kabamv ’thuic suan diu:",
            "Ravguangc - aGuangc!",
            "Tingpuk hei kauh langv mak,",
            "Thuanhmei khwan chu tangh khang;",
            "Kandih hei ’naa langv mak,",
            "Thuanhmei khwan padik khang;",
            "Kandihmei guay ?|7 kabamv ’thuic suan diu:",
            "Ravguangc - aGuangc!",
            "",
            "2 Kandihmei guay ?|7 kabamv ’thuic suan diu:",
            "Ravguangc - aGuangc!",
            "Phwamling guay kauc thau diu,",
            "Meic thingc dat ngam mak khe;",
            "Tiki lung kathuic ?|7",
            "Kakhang bamv chamdaanv diu;",
            "Kandih mei guay ?|7 kabamv ’thuic suan diu:",
            "Ravguangc - aGuangc!"
          ]
        }
