        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Elshadai - Ngamp’ryrimei",
            "Racguangc,",
            "Ramh guay ta hei Nang _>6 damclou tuang e,",
            "Kaipouc Nang khang ramh tii dat khang maek ge;",
            "Aniw panty na hei katgut dat re.",
            "",
            "He Jehovah - kadanloumei Kaipouc,",
            "Heipui Ningtow Tauc ta hei suaihiamlou o;",
            "Nang zawpaanv _>6 gaanclou o, gaeklou o;",
            "Suaihiamlou pwkhou _>6 gay khang de,",
            "Suaihiamlou makmei gaymei 6_> thu sii de.",
            "",
            "2 He Jehovah Nissi - aniw chuangcphey,",
            "Aniw raana ’dow ’thei rih ngam lak ge,",
            "Poubauhmei Sabaoth Rigaanvpouc Nang e,",
            "Rih guay ngammei 6_> Nang paan",
            "khou _>6 e.",
            "",
            "3 He Jehovah Shammah -",
            "’Duanghloumeipu,",
            "Nangmei nunc pang khou",
            "bamloumei Racguangc,",
            "Nang bamloumei ramgai gaymei kiu e,",
            "Gaymeipu Nang nac nunc gaymei sw diu.",
            "",
            "4 He Jehovah Shalom - ’Chu-’zaenghmeipu,",
            "Meic gay makmei _>6 pouna khangc dat mak,",
            "Meic baihmei pow kuaklou khou kuaklou o,",
            "Nthuihmei ’chu- ’zaenghmei khou kiu lou o."
          ]
        }
      }
