        "content": {
          "format": "source-lines",
          "lines": [
            "1 Lunghzinghmei tiineihlaa khang nai,",
            "Tingmik guay ^&8 tat bam khou;",
            "’Maanmei, ryanramei bumaengc nai,",
            "Tingmik guay ^&8 tat bam khou;",
            "’Niu ’gyn tatpui chaenglwan khou",
            "Lungh tiineihlaa ngam ethei",
            "Gaymei taanv ’niu taanh tu the,",
            "Tingmik guay ^&8 tat bam khou.",
            "",
            "Tat bam khou, .. tat bam khou!",
            "Tat bam khou, .. tat bam khou!",
            "Gaymei taanv ’niu taanc nuh e,",
            "Tingmik guay ^&8 tat bam khou!",
            "",
            "2 Khanc-lanc bam khang kaganv maek ge,",
            "Tingmik guay ^&8 tat bam khou:",
            "Nang zaw 8^& lauthwan kumc gaanc o,",
            "Tingmik guay ^&8 tat bam khou;",
            "Dih hei ryanramei padik,",
            "Lungh ryanra mikdui padik,",
            "Nang pammei ta zaythau o,",
            "Tingmik guay ^&8 tat bam khou.",
            "",
            "3 Aniu nzianmei riangluaih guay,",
            "Tingmik guay ^&8 tat bam khou,",
            "Khat khat swna tat rey kan the,",
            "Tingmik guay ^&8 tat bam khou;",
            "’Ki gay mei thw lingcloumei",
            "Gayna thau dat puni de;",
            "Khou kiu ’niu neihlaa puni,",
            "Tingmik guay ^&8 tat bam khou."
          ]
        }
      },
