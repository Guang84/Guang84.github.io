    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Jisu ai kros hei phungc ni the",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu ai kros hei phungc ni the,",
            "Nang thei na ai lay ni the;",
            "Lungcsi, malaa, ganc ’rulouna",
            "Nang na hei di the, akhang;",
            "Ai kahawmei guay ’maan kan diu,",
            "Ai machunhmei, ningmei guay;",
            "Kum sic ai adih lungcgay cho,",
            "Ravguangc lev tingkauh akhang!",
            "",
            "2 Dih @{4 malaana ganclou diu,",
            "Pou, Nang ta ganclou muay de,",
            "Maansei lung hei thu lwm nuh mak,",
            "Pou, Nang thu suai zat mak ge;",
            "Nang akhou neihlaalou pwkhou,",
            "He zauzian Kaipouc Ravguangc,",
            "Meic nunc @{4 karaeng bam tan diu,",
            "Nang zaw howmei hei biuc the.",
            "",
            "3 Meic nunc @{4 rairiu bam tan diu,",
            "Nang daeng tiiguang tuanh khang de;",
            "Nchanvmei azuh nai tan diu,",
            "Kauh zaengthaek gay ranvmei nai;",
            "Chwnsii, zaengsii @{4 kabiu lak,",
            "Nang ata zianlou bam saanv;",
            "Nang kazauh makmei neilaa 4@<",
            "Ai machunh dat zat lak khe.",
            "",
            "4 Hymdaihmei khou phungc guang ’khap tho,",
            "Lwmmei, huayneymei paan @{4,",
            "Tingsaeng tingkauh ahu khou nai,",
            "Ravguangc @{4 zaylou puni;",
            "Kandih khou athouc luai pwkhou,",
            "’Gynmei tingmik luai pwkhou,",
            "Machunhmei hei kathai guanhna",
            "Nang ta thuancna bam ni the."
          ]
        }
      },
