        "content": {
          "format": "source-lines",
          "lines": [
            "1 Gumei pu, Nang lauziu nunc ta",
            "Kadanna tiitulou o,",
            "’Suanmei nunc ta Nang zaylou o,",
            "Nang ngaengv khou tiibamlou o.",
            "",
            "2 ’Thyammei nac nunc ta laalou o.",
            "Nang ngaengv gay khou pamclou o,",
            "Khou5#^ Nang Lat khou lwmlouna",
            "Guakgau makna bam kan diu.",
            "",
            "3 Nang byn khou #^5 maeng duc patna",
            "Khouringh taek tiiswlou rio;",
            "Nang tuang zian kadanloumei #^5",
            "Siimei khou #^5 gaeklou diu!",
            "",
            "4 Khou kiu tingsaeng Nang baancpwam khou",
            "Kaniw zaeng ’thaekcmei sw diu;",
            "Ringc gaymei thingnwang tu bam diu,",
            "Nang zauzian dui zangv bam diu!"
          ]
        }
