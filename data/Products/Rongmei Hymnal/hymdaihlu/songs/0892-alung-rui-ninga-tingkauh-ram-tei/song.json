        "content": {
          "format": "source-lines",
          "lines": [
            "1. Alung )_3 ninga tingkauh ram tei,",
            "Tabui nung ai guangtang nina cho?",
            "Njianmei guai ntam kanmei guai;",
            "Miram khou tei souriu dat puni.",
            "",
            "Chorus:",
            "He Raguang nang tingsangjang ramgai,",
            "Jai guang lou dat ro;",
            "Tabui nung )_3 khou tei ai guangtang",
            "Ni na cho?",
            "He Raguang kandih khou rianramei",
            "Nahnun guai.",
            "",
            "2. Tingkauh chang njuan na tat bam khou,",
            "Chang din lou o he Raguang Jisu;",
            "Nang ramgai tei aniu hou ni e,",
            "Tabui nung )_3 guangtang nina cho?",
            "",
            "3. Kandih khou ntam kanmei jianmei,",
            "Tabui nung )_3 ariu dat ni cho?",
            "Nang ramgaitei guangtang puinung kiu,",
            "Neilana prira cham dat ni.",
            "",
            "",
            "Favourite song: R. Daniel"
          ]
        }
      }
    },
