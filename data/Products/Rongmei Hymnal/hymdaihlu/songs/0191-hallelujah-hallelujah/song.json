        "content": {
          "format": "source-lines",
          "lines": [
            "1 Hallelujah! Hallelujah!",
            "Thuanhpui khwan ranvna kauc o:",
            "Ravguangc khou neihlaa lu suan o,",
            "Ravguangc thuanhpui lu suan o,",
            "Kandihmei rih ngam khang kros khou",
            "Zei keyna ’khaengvloumeipu,",
            "Hymdaihmei Guang Jisu Khrista",
            "Theihmei khou <~1 ringcthau the.",
            "",
            "2 Khrista thau the, ’thanmei lau khou,",
            "Phunling pangc khou reymei e;",
            "Hymdaicna Kamei keypui nungc",
            "Kathai geicna tay puni;",
            "Khou kiu kachaekc nap thai guay 1<~",
            "Kahu khou kalung thau ni,",
            "Phauc minclouna, t’rou khunc khou <~1;",
            "Kahym daihmei neic riw <~1.",
            "",
            "3 Hallelujah! Hallelujah!",
            "Kauh thangc Ravguangc hym daic diu!",
            "Hallelujah! Guloumeipu,",
            "Theihmei ric ngammei pu khou;",
            "Hallelujah! Bumaengh ’Thanmei,",
            "’Niw ta ’Khavloumei pu khou,",
            "Hallelujah! ’taw lev tingsaeng,",
            "Gaanv Thumh akhat Racguangc khou!"
          ]
        }
      },
