        "content": {
          "format": "source-lines",
          "lines": [
            "1 Thuancku e Nang Lat khang,",
            "He Gumeipu!",
            "Mik tiiraklou o, kathukh how khang;",
            "Tii ’taklou o, kabah thayna pah khang,",
            "Tiitarailou rio, alung hei.",
            "",
            "Thuanc e Baibal khang, khou 1<~ lwmmei khang;",
            "Kuakloumei, chuzaenghmei tiimei khang;",
            "Nkhavlou o, Kalatdanv phungc ngam khang,",
            "Lwmmei paan <~1 kabah laa khang.",
            "",
            "2 Thuancku e Nang riak lev latryan lat khang,",
            "’Niw taanv khang maibungc, chaeng khang gaanhmei,",
            "Neihlaa kim makmei <~1 puanghmei Nang ramc,",
            "Tingkauh kandic dincloumei khang.",
            "",
            "3 San-gaymei e, Nang Lat piumei guay 1<~,",
            "Nganv dat makna Nang lev bam ’chamc ni,",
            "Gaychuymei dui daeng khou te bam ’chamc ni,",
            "Ringhmei tingthai 1<~ tu ’chamc ni."
          ]
        }
      },
