          "format": "source-lines",
          "lines": [
            "1 Hymdaihmei Guangc Nac theicloumei",
            "Ch’rynmei kros thukh makumh pwkhou,",
            "Akhou naimei kamv nsa de,",
            "Ahym guay ta ai karaeng e.",
            "",
            "2 Khrista theicloumei khou hamhna,",
            "Agaengh sw khang khat sihni maek,",
            "’Maan nimei ai kahawmei guay",
            "Jisu zei khou ai katlou the.",
            "",
            "3 Kapy, Kabaanc, Kaphay khou <~1",
            "Ryanramei lev zianmei luangc key,",
            "Hei kumhmei panty khou how tha,",
            "Sauh <~1 kunghmei pyrun swmei?",
            "",
            "4 Kandih puat guay atuang swna",
            "Khat sihni luih mak kida khang,",
            "Ch’rynmei Kazauzian <~1 ’tanv e,",
            "Abumaengc, apanty guay ta."
          ]
        }
      },
