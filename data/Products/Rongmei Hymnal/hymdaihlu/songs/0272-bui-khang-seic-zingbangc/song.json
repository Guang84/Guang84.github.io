        "content": {
          "format": "source-lines",
          "lines": [
            "1 He paapc mei, nang lungh tanh ri tho,",
            "Aseic zingbangc ringhmei laa tho;",
            "Latliammei sw saengc la ri tho,",
            "Kaganv rii puni.",
            "",
            "Bui khang ’seic zingbangc,",
            "Bui khang ’seic zingbangc,",
            "Ringc ’zih bam cho?",
            "Kaganv rii puni!",
            "",
            "2 ’Thuanh tuang panty ta thow",
            "thay cho?",
            "’Taw na hei kaganv kiu di the;",
            "’Seic zingbangc kaganv gay khou hei",
            "Guloumei laa tho.",
            "",
            "3 Kaipouc thu ’taw nganv zian bam e,",
            "Kataanv huath nang thaylou lak cho?",
            "Nang lung tanhmei kalaic pat tho,",
            "Kaganv rii puni.",
            "",
            "4 Zauzian Kaipouc Poubauhmei thu",
            "Kakhou guangmei kamv ta laa e;",
            "Lwmlouna piu tho, ’seic zingbangc,",
            "Guloumei laa tho."
          ]
        }
      },
