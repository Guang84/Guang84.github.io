        "content": {
          "format": "source-lines",
          "lines": [
            "1 Khristian phwam khat .. kaduai bam e,",
            "Khou 6_> Jisu .. lam ncham khang,",
            "Kalat paah khang .. Kalam chak khang,",
            "Neihlaamei _>6 .. padik bam khang.",
            "",
            "Kazanc khou kariumei",
            "Aniu chabwan phwam hei",
            "Lungh lev baanh kariuna",
            "Kahym ’dauh tat kan diu!",
            "Kum ’thei ding ntip kho,",
            "Ravguangc lev ’niu ding khang;",
            "Aniu khristian phwam ta",
            "Suaihiaml ou khang ney kho.",
            "",
            "2 ’Niu kariu e, .. lu suan ’chamc khang,",
            "Neihlaa lu _>6..Guangh ta thuanh khang,",
            "Chabwan nunc _>6 .. chaeng phu tow ni,",
            "Tingkauh kai khou zayloupui chaeng.",
            "",
            "3 Kaipou taanv hei .. ’niu taancbam khang,",
            "Aniu latryan .. ’rianh kathanc kho,",
            "Kathei lay khang, .. Kata lwm khang,",
            "Kamei lev lungc nchamc mak saanv."
          ]
        }
