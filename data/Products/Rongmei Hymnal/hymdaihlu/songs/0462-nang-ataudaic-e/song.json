        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang aTaudaic e, he",
            "Thuakloumei pu,",
            "Ai gutloumei bam, duppui bamv e,",
            "Nang aTaudaic e, ata sungclou o,",
            "Kabamv ’thuic Nang khou ai dup bam ni.",
            "",
            "Nang aTaudaic.. e,",
            "He Thuakloumei pu,",
            "’Khavloumeipu,.. zayloumei pu e,",
            "Ai rigwnmei .. Nang e, Guloumei pu,",
            "Nang khou lwmna .. ai dup bam ni the.",
            "",
            "2 Nang aTaudaic e, paapc }?2 khanv pwkhou,",
            "’Chanvpui ganv khou ngangvloupui bamv e;",
            "Nang aTaudaic e, alung ryanra khou,",
            "Nang aTaudaic e, ai ping lak khe.",
            "",
            "3 Nang aTaudaic e, ’thiammei guang pwkhou,",
            "Kalaic dat makmei, gaymei, Pam e;",
            "Alung kapwm hei Nang khou ngangvlou the,",
            "Tingsaeng lwm nuhmei ai sw diu khang.",
            "",
            "4 Nang aTaudaic e, guanghdic lev zaatc guay,",
            "Guangh lev pyrun guay bow kan pwkhou,",
            "Nang nai bam puni, he ringhbamv Taudaic,",
            "Tingsaengc Taudaic khou ai lwm bam ni."
          ]
        }
