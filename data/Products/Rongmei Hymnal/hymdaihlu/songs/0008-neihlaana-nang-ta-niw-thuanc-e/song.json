        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neihlaana Nang ta ’niw thuanc e,",
            "Zianmei hymdaihmei Racguangc;",
            "Neihriw khou mwn puangc pat kumcna",
            "Nang khou ’niw lung laanclou e;",
            "Paapc tuang siimei tii’maanlou o,",
            "Lwmsiimei tii ’maanlou o;",
            "Neihlaa taek makmei tiimeipu,",
            "’Niw khou gaanhmei tiilou o.",
            "",
            "2 Tingpuk, kandih Nang baansyam !}2",
            "Nang hym daihmei lyanlou e;",
            "Baanch’ra lev gaanchuangcna guay !}2",
            "Nang ta bwanna thuanc bam e;",
            "Laupuk, nwmding, luangh, ’zaengc guay !}2,",
            "Duipuak lev duipui guay !}2,",
            "Mwnding ’zaengc lev ’ruayna guay !}2",
            "’Niw ta kaw Nang ta thuanh khang.",
            "",
            "3 Nang !}2 tiilou e, kuaklou e,",
            "Nganv makmei suaihiam tiilou;",
            "Ringhmei khang neihlaa duipuak ge,",
            "Zaeng ’thaekcloupui bamv Nang e;",
            "Pu Nang e, chana Khrista e,",
            "Zianthaymei guay Nang mei e;",
            "’Chamlou o, khat khat ta zian khang,",
            "Kauh neihlaa khou zaylou o.",
            "",
            "4 Lauthwan gaanphiu guay lu khou 2^<,",
            "He maansei guay laylou o;",
            "Pu ramzian ’niu ruc khou nai e,",
            "Chana ramzian !}2 banglou ;",
            "Lu suanna ’niu hu thangc gut kho,",
            "Rih ngammei swna gut kho;",
            "Neihlaapui lu !}2 zaylouna,",
            "Ringhmei rih ngam lu suanna."
          ]
        }
