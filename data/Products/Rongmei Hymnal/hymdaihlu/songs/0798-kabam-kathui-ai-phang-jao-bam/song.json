        "title": "Kabam kathui ai phang jao bam",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Kabam kathui ai phangjao bam khou,",
            "Jingmei muang rui gumliam;",
            "Jangsi pui ram me.",
            "",
            "Chorus:",
            "He! Kapu kanah bumang thanmei rui,",
            "Jai lou o nang njianmei nang na guai ta;",
            "Nthiampui bam khou rui nduang lou o.",
            "",
            "2. Kandih rianra thak nipui bam mak,",
            "He ti nchu lou o;",
            "Poubaumei jisu.",
            "",
            "3. Nthak kan dikho njianmei nun,",
            "Mu ri o panti ngan;",
            "Jai loumei put a.",
            "",
            "4. He apui apu njian liangmei,",
            "Mpat lout ho neila na;",
            "Tam kan dikho.",
            "",
            "5. Mulou rio jianmei champan thiu le,",
            "Poubaumei siamruai su khang;",
            "Khanpat mei e.",
            "",
            "6. Meiguai pou nchumpui chang phu kho,",
            "Kum ethei poubaumei;",
            "Lungkiang lou puni."
          ]
        }
      }
    },
