      "rongmei": {
        "language": "rongmei",
        "title": "HE THUAKLOUMEIPU",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang ta luic nii e! heThuakloumeipu,",
            "Mi hei ai ningmei, aravsuai the;",
            "Kandih puat guay ai ’patlou ngam ni the,",
            "Jisu, Nang kahak ai luic ngam khang.",
            "",
            "Nang ta luic nii e! Nang ta luic nii e!",
            "He Thuakloumeipu, Nang kumc ’than khang!",
            "Nang ramgai akhou gut padiklou o,",
            "Nang maengc naplou tho, alung khou hei.",
            "",
            "2 Nang ta luic nii e! kadanlou thayna,",
            "Zianmei, kuakloumei lung padikna,",
            "’Suanmei ta ’khavlou, lakmei tiitanclou,",
            "’Maanmei paapc mei ta phuna tat khang.",
            "",
            "3 Nang ta luic nii e! lungning niamhmei khou,",
            "’Thanmei, khay maekmei,",
            "khaengvsaenghmei khou,",
            "Sinnui malaamei lungh ’zaenghna khaengvmei,",
            "Meic nunc ta gu khang khaengvngammei khou.",
            "",
            "4 Nang ta luic nii e! ai huayna bam khang,",
            "Nang Bumaengc akhou bun keilou tho;",
            "Nang lunghmei Ravkai ai hei sw biuh khang,",
            "Dih lev tingkauh khang biuhmei sw khang."
          ]
        }
      },
