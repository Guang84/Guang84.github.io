        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc #^5 paapc dic ta zianna",
            "KaNac ’Pouh ta tiilou,",
            "Thow punic lwmloupui mei guay",
            "Ringcsuangmei laa khang e.",
            "",
            "Kalatryan kachangc e!",
            "Ravguangc tuang ch’rynmei latryan hei",
            "Ai lwm the, akhou tiiguang tangclou the;",
            "Ravguangc latryan hei kachangc e!",
            "",
            "2 Ai latliammei maeng tatmei nac,",
            "Paapc bangc sw bam khwan e;",
            "Dwan gaymei latryan hei akhou",
            "Lu kumc chu guang mak saanv.",
            "",
            "3 “Thow thow punic,” Kaipouc lat hei",
            "Akhang swna laa the,",
            "Paapc khou #^5 ata tiiduak khang",
            "Kalat khou lwmlou the.",
            "",
            "4 Ringcsuangmei kiu ai laatow the,",
            "Alung tii padik the;",
            "Taek makna Kata thuanc bam ni,",
            "Thuakloumeipu ti hei!"
          ]
        }
      },
