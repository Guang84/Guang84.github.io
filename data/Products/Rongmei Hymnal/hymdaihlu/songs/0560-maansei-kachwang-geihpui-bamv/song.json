        "content": {
          "format": "source-lines",
          "lines": [
            "1 Maansei kachwang geihpui bamv khou,",
            "Zaatc lev khwang adowpui bamv khou,",
            "Agay-’gimei khwanring ruc khou,",
            "Chu e, Meic Nac ’Pouh, Nang khwan 8}@!",
            "",
            "2 Lungcsii ryanramei nunc ding khou,",
            "Zinghmei chaengluang pingpui bamv khou,",
            "Agaamvmei padikmei chaeng khou",
            "Kaipouc, Nang mikdui ta how e.",
            "",
            "3 ’Suanmei, mbuaihmei alauc nunc,",
            "Pui ramryanra, Pu nunc puatphung,",
            "Ndaapc t’riimei, ryanra lakmei,",
            "Hei guay ta Nang malaa mak ge.",
            "",
            "4 ’Khap tho, Kaipouc, chyngbut thangc #<8",
            "Sucnumei lung tiigaylou tho;",
            "Katuakcmei nunc ding khou bamna,",
            "Chaengluang khou tat ruanlou dat ro.",
            "",
            "5 Maansei nunc Nang ramzian thayna,",
            "Nang tatpui bamv lay tat mak saanv,",
            "Tingkauh thangc #<8 hymdaihmei khou,",
            "Ravguangc kaidai guanglou mak saanv."
          ]
        }
