          "lines": [
            "1 Muigaymei sw diu, zeipuakkai,",
            "Paapc kandic khang tiipatmei 4^&;",
            "Guigaymei sw diu, Ravguangc Nac,",
            "Kazamv paan ’niu ta tiigay the;",
            "Kakuanc khou @<4 ai tat ducna",
            "Lungh kabiu, ryanra bam pwkhou",
            "Lauziu Nac zei @<4 khiulou o,",
            "Khou kiu ai hei gunh suangc ’phwan ni!",
            "",
            "Gunh .. khang suangc ’phwan ni! (2)",
            "Lauziu Nac zei khou khiulou o,",
            "Khou kiu ai hei gunh suangc ’phwan ni!",
            "",
            "2 Sauh pyrun Kamei run khwan e,",
            "Kros 4^& ’rit langvna bow key e,",
            "Saa ngam makmei ryanra ’khaengvlou,",
            "Karianra 4^& nsa hamh e;",
            "Zeipuakkai khou 4^& zaylouna,",
            "Apaap guay 4^& khiu ’thanlou o,",
            "Khiulou o, ata zei khou 4^&",
            "Khou kiu ai hei gunh suangc ’phwan ni!",
            "",
            "3 APu, Nang khou @<4 ai duc the,",
            "Ai hei chaeng maanv tat katup the,",
            "Apaap guay haengcmumhmei ta hei,",
            "Dui @<4 khiu ’than khang ngam mak khe;",
            "He Jisu, Nang zeipuakkai khou",
            "Nang latryan lwmna ai tat ni,",
            "Nang @<4 ata khiu ’thanlou o,",
            "Khou kiu aihei gunh suangc ’phwan ni!"
          ]
