        "content": {
          "format": "source-lines",
          "lines": [
            "1 Concrete lev ntanh Racguangc,",
            "Piston lev kahiang Racguangc,",
            "Pylon lev kathiu Racguangc,",
            "Kailang lev kaingwm Racguangc,",
            "Atom Racguangc, aRavguangc,",
            "Dih pumtan guay Nang tuang e.",
            "",
            "2 Cable Kaipouc, rail Kaipouc,",
            "Gari chaeng lev mail Kaipouc,",
            "Rocket lev samhmei Kaipouc,",
            "Samhmei satellite Kaipouc,",
            "Tingpalikmei riang Kaipouc,",
            "Samhmei guay hei Nang tuang e.",
            "",
            "3 Science lev art Kaipouc Nang e,",
            "Map lev graph lev chart",
            "Racguangc,",
            "Physic lev research Kaipouc,",
            "Baibal lev lwmmei Kaipouc,",
            "Sequence lev design Kaipouc,",
            "Kalingmei guay Nang tuang e.",
            "",
            "4 Nang hym @<4 kandih padik,",
            "Mbaanv guay ta Damhmeipu,",
            "Khrista ta tiiringc thaulou;",
            "Siimei khou @<4 gulou e,",
            "Meic guay ta Kazauzian @<4;",
            "Dih khou zianmei Nang tuang e."
          ]
        }
