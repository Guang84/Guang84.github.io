        "content": {
          "format": "source-lines",
          "lines": [
            "1. Lung rianramei muang dingkhou,",
            "Ai rui bam khuan e;",
            "Neilamei neihriu tuaina,",
            "Ting gan nimak ge.",
            "",
            "Chorus:",
            "He! suaihiam lou o, nangta ningni,",
            "Aru khou gan guang o;",
            "Jingmei rih rui ata ding khamma,",
            "Tigan o tingsang gai pui riu,",
            "Neila pui ram khou jai gut lou o.",
            "",
            "2. Adam tarou jingmei khou,",
            "Nang rui gan bam kum;",
            "Kanloumei nang jei pan rui,",
            "Nangta ningtan mak.",
            "",
            "3. Kalangmei khuan rui padik,",
            "Zat guai na lung khou;",
            "He! Eden nei tuai pui tang,",
            "Ningmei rui huai e.",
            "",
            "4. Thei thu bumang kandih khou,",
            "Neila pui kan khou;",
            "Rianramei kandih munta,",
            "Ning dat pulak khe."
          ]
        }
      }
    },
