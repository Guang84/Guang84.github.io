        "language": "rongmei",
        "title": "Abumaengcle nang mbaanv khou",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Abumaengcle, nang mbaanv khou",
            "’Bui zaeng ?|7 pian mak tu cho?",
            "’Bui zaeng ?|7 Nang huay bam tu cho?",
            "’Bui zaeng ?|7 lungh kim mak cho?",
            "",
            "Ata tiikim puni;",
            "Ata tiikim puni;",
            "Ai hei Kalwn kumhpui nungc kiu;",
            "Ai hei Kalwn kumhpui nungc kiu.",
            "",
            "2 Abumaengcle, alungning hei",
            "Kandih ramgai ta ning e;",
            "’Bui zaeng ata luh bam tu cho?",
            "’Bui zaeng lungh kim mak tu cho?",
            "",
            "3 Abumaengcle, apanty hei",
            "Katgutlou ngam p’ry ethei,",
            "Kros khou ai hei thaengc luai ethei,",
            "Nang lungh kimlou puni cho?",
            "",
            "4 Abumaengcle, nang huay bam o,",
            "Paapc ta mphut-luh bam o,",
            "Ai Jisu kros 7?| laalou the,",
            "Nang lungh kimna lungc bam khang."
          ]
        }
      },
