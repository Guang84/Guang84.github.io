        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kaipouc luic ranvna ai lungc bam nii e;",
            "Kakumc lungh ’zaengh khang,",
            "Kakumc niamh thay khang;",
            "Taanc nii mbu khang, ntwnna lungcdiangh khang;",
            "Langloumei taanv khou katgut mbu ngam khang.",
            "",
            "He Pou, ai hei Nang khang na lungc ni the,",
            "Pou, ati hei Nang khang na laalou tho,",
            "Paapc rei khou _>6 ata khiu ’thanlou o;",
            "Ata tingsaengzaeng Nang tuang tiiswlou tho.",
            "",
            "2 Kaipouc luic ranv ni atuang huayney khou,",
            "Pumtan mbuna atuang kros phungh khang,",
            "Katuang guangcdic 6_> phungc guang khang karamh khang;",
            "Kabumaengc paan _>6 bumaengh khuam geih khang.",
            "",
            "3 Kaipouc luic ranvna ai lungc daic thau ni,",
            "Katuang zianmei hei lyan mbu bam ni;",
            "Katpat mbu ni Galilimei pu kumc,",
            "Kaipouc luic diangcna tingsaeng ai lungc ni the."
          ]
        }
      },
