          "format": "source-lines",
          "lines": [
            "1 Mi kai kaikwn padeih khou hei,",
            "Kaingwm, tiangdaic khou hei,",
            "Maimangh lev napkuakpaeng khou hei,",
            "Ravguangc, suaihiamlou o.",
            "",
            "2 Kaimun kaikhamv laanc pat khou hei",
            "Riang-luaih lev gin-ga khang,",
            "Kainaek kailat guay laanc pat khou",
            "Suaihiam riw tiilou o.",
            "",
            "3 Kainam ngaengsaengc kaguay khou hei,",
            "Kairaengv, kai daeng guay khou,",
            "Meic @{4 lwanmei lev Ravguangc tuang",
            "’Chu-’zanghmei tiilou o."
          ]
        }
