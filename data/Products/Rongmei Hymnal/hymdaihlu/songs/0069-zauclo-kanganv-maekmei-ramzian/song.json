        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zauc lo, kanganv maekmei ramzian",
            "Pu Ravguangc ^&5 zianlou!",
            "Paapc khou ’maan bam khwanmei ’niu ta",
            "“Ravguangc Nac” kaw dat the!",
            "",
            "",
            "Zauc lo, .. adih zian tu cho!",
            "Adih zian tu cho!",
            "Pu Ravguangc ^&5 ’niu khou zianloumei;",
            "’Niu ta .. Ravguangc nac nunc kaw,",
            "Ravguangc nac kawlou pwmei!",
            "",
            "2 Kakhou ^&5 ’niu hei duh mak khe,",
            "Kunghmei zei paan ’naa the;",
            "“Zian dianghmei” pang khou laalou the,",
            "Ravguangc khou ’niu bam the.",
            "",
            "3 Hymdaihmei khou guanlih nimei",
            "’Taw thu ’dauhlou mak he,",
            "Kaipouc ta ’niu howpui nungc kiu",
            "Kata ’niu luic puni.",
            "",
            "4 Dwangay nimei kiu machunhna",
            "’Niu ’than katyn bam kho,",
            "Hymdaihmei Kaipouc ta luic kho,",
            "How nuangc nimeipu ta."
          ]
        }
      },
