        "content": {
          "format": "source-lines",
          "lines": [
            "1 Jisu tuang kros bangc khou hei",
            "Ai zaengthaek bamv sw ni,",
            "Kaswng gaymei taudaic kiu e,",
            "Lakmei kandic khou hei,",
            "Tazikramv khou duppui kai e,",
            "Chaeng dak khou bamvduan e;",
            "Tingneih suh khou, ryanrapui",
            "ganv khou",
            "",
            "Duploupui bamv kiu hei e.",
            "",
            "2 Jisu tuang kros ruc khou 5^&",
            "Alungning mik khou ^&5",
            "Akhang ryanra ’khaengvloumei pu",
            "Lwn kahak ta how e;",
            "Kabiumei alungsyng thangc ^&5",
            "Ch’rynmei kanei ’dauh e:",
            "Hymdaihmei Kazauzian",
            "ram-ch’ryn lev",
            "",
            "Ai kumhmei ramh biuh makmei.",
            "",
            "3 He kros, nang tuang swng khou hei",
            "Ai lunghpui bamv sw ni,",
            "Kazaw riw 5^& hamhna baihmei",
            "Neih riw ta kahaw mak;",
            "Kandih lwnlung tabui sw diu,",
            "Ai thouh swlou lak ge,",
            "Araana lam hei meizakmei e,",
            "Ahymdai kiu kros hei e."
          ]
        }
