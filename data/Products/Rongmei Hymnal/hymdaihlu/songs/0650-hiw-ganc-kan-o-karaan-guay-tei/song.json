    "languages": {
      "rongmei": {
        "language": "rongmei",
        "title": "Hiw ganc kan o, karaan guay tei",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Hiw o, kaengc guay kabamv ’thuic khou,",
            "Chyng, ’zaengc, duipui guay hiw kaan o;",
            "Tingkwm hei luai zaic puni the,",
            "Tat kan di tho, khaam dat ritho.",
            "",
            "2 Hiw ganc kan o, karaan guay 8}@,",
            "Siimei,’chumh makmei saaraamhmei;",
            "Hiw guang lyn o, suaihiam kathanc,",
            "Gaymei, ’chumhmei, neihlaamei 8}@.",
            "",
            "3 Hiw ganc kan o, chwn chamh makmei,",
            "Suc rih, mamavmei, agaamvmei;",
            "Hiw guang lyn o, ’zianmei lungning,",
            "Kuaklou thaymei, chuzaenghmei 8}@.",
            "",
            "4 Hiw ganc kan o, ravpyan siimei,",
            "Dui-mai, baengla, nkow-’daapc mei;",
            "Hiw guang lyn o, ravrih gaymei,",
            "Kambui-charaimei, ’thuihmei 8}@.",
            "",
            "5 Hiw guang o, bauhmei, ningswmei,",
            "Lungning daihmei, zauzianthaymei,",
            "Hiw ganc kan o, zinghmei guay 8}@,",
            "Hiw guang o, Khrista tuang gaymei."
          ]
        }
      },
