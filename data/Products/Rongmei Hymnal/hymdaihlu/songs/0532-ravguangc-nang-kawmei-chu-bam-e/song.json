        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc, Nang kawmei chu bam e,",
            "Reynungc Galili khou,",
            "Kaipouc ({0 meic nunc ta kaw kumc:",
            "“Thau o, Athei lay o!”",
            "",
            "2 Nang kawmei khou dawmei nunc ta",
            "Aseic hei laalou o;",
            "Kaniw ramlum sin gaeklou o,",
            "Kaniw chwn zaylou o.",
            "",
            "3 ’Seic hei mi tiigaypui dui ({0",
            "Paapc khou ({0 duak patmei,",
            "Ravguangc mei khang khiu ’thanloumei",
            "Lwnlung ta lyanlou diu.",
            "",
            "4 Mi nunc ta hei tiiswlou o,",
            "Kaniw ringcting nai saanv,",
            "Nang tuang phwamlingmei ling swna",
            "’Niw lev kadam laa khang."
          ]
        }
      },
