        "content": {
          "format": "source-lines",
          "lines": [
            "1 Chuzaenghmei akhou duiriang kumc guang pwkhou",
            "Ryanramei dui kamuatc kumc khou,",
            "San khou patmei guay khou saakhang Nang ’chamlou,",
            "Kum kan diu, mi hei gay khang guang de.",
            "“Kum kan diu, .. ai nuh de,",
            "Kum kan diu, mi hei gay khang guang de!”",
            "",
            "2 Seitaan #^5 rairiuna nchanv pw sihni,",
            "Heipui phaydyng #^5 gaeklou ni:",
            "Ngam makmei alwnlung Khrista thaylouna",
            "Abumaengc khang Kazei keylou the.",
            "",
            "3 Apaap lam khou makumh khou neihlaa sih the!",
            "Apaap 5#^ asaekc na hamh the,",
            "Kapwmna Jisu kros khou hianbinlou the,",
            "Pou ta thuancku o, he abumaengc!",
            "",
            "4 Khrista paan ai ringc Khrista khang ai ringc ni!",
            "Jordan dui daic liam guang sihni,",
            "Ringc nic, theic punic ai ryanra dat lak khe,",
            "Akhang chuzaenghmei tii puni de.",
            "",
            "5 Kaipouc, Nang key datmei ta aniw ’khwan e,",
            "’Niw machunc kiu thu tingkauh de;",
            "Baanch’ra, tiangka lev Kaipouc khwan chu nimei,",
            "Mi hei alung #^5 rigwnmei e!"
          ]
        }
      },
