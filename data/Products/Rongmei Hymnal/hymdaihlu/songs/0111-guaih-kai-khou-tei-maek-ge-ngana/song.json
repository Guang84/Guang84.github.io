      "rongmei": {
        "language": "rongmei",
        "title": "Guaih kai khou tei maek ge Ngana",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guaihkai khou 7}$ maek ge, Ngana zybamv khang,",
            "Kiruaikuak khou ’zilou e, Pou Jisu ta;",
            "Gaanchuangcna guay #^7 zauc key e Kazy ta,",
            "Ngana Jisu 7}$ napgou ruc khou zip be.",
            "",
            "2 Ngana 7}$ zip’chyang e, guaih #^7 muangh khou 7}$,",
            "’Ki Ngana Jisu thu khou 7}$ kap mak ge;",
            "Ai huay e, Pou Jisu, zauc keylou na ro,",
            "Adaeng khou bamlou o, tinggaanc pat mak saanv.",
            "",
            "3 He Poubauhmei Jisu, adaeng bamlou o,",
            "Taek makna bamlou o, ata zianlou o,",
            "Alauc guay ta Nang #^7 kungcna swlou o,",
            "Tingkauh khou lungc ’chamc khang ’niw ta swlou o."
          ]
        }
      },
