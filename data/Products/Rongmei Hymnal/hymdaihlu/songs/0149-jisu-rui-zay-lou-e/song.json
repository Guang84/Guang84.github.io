        "content": {
          "format": "source-lines",
          "lines": [
            "1 Lauziu gaenghmeipu kumcna,",
            "Jisu #^5 zaylou e;",
            "Phuairyaupung thanh khou zaylou,",
            "Jisu #^5 zaylou e;",
            "Chaenglwan khou muangh nai sihni,",
            "Theic nuhmei bamv ’riw sihni,",
            "Zauc bam chaeng maanv mak khang,",
            "Jisu #^5 zaylou e.",
            "",
            "2 Panty chaenglwan kunghmei khou",
            "Jisu #^5 zaylou e;",
            "Suaihiam tingkauh tangh mak saanv,",
            "Jisu #^5 zaylou e;",
            "Chaeng hei Kamei tat rey the,",
            "Lauziu nunc hu khou tatna,",
            "Ravguangc pamv khou zaylou ni,",
            "Jisu #^5 zaylou e.",
            "",
            "3 Neihriw soucloumei chaeng khou",
            "Jisu #^5 zaylou e;",
            "Katuakcmei, suc-rih chung khou,",
            "Jisu #^5 zaylou e;",
            "Jordan duitin tangc pwkhou,",
            "Panty ramvrei twan pwkhou,",
            "Duiluat guay tii ’thaekclou ni,",
            "Jisu #^5 gaeklou e."
          ]
        }
