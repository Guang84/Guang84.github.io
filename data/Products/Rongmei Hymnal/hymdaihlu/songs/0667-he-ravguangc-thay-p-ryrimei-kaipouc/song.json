          "lines": [
            "1 He Ravguangc thay p’rymei Kaipouc,",
            "Maansei ningting Damhmeipu;",
            "’Niw ningting phu khou zaylou o,",
            "’Twnmei chaeng khou zaylou o,",
            "’Khavlou o ’niw ’tak-’rak thay khang,",
            "Ningting kai 8^& thwan bam khou,",
            "Nang Lat, taudaic khou ’niw ding ni,",
            "Ndauhloumei ’chumhmei khou.",
            "",
            "2 Ningting duipui adih daic cho!",
            "Tatlou makmei bamv nai he;",
            "Baucna ran-gut khang kage nai,",
            "Aliauh-azihmei maekna;",
            "Nang ^&8 zaylou khang kage nai,",
            "Ningting ’niw kathai bam khou;",
            "Nang Bumaengc ^&8 tiigaanclou o,",
            "’Niw matna phu bam khou hei.",
            "",
            "3 ’Niw katitna thaytow pwkhou,",
            "Gaengh swmei lung tiilou rio;",
            "’Niw raa na ramthai khou ngangvna",
            "Nang khou ^&8 ruan duh mak khang.",
            "Ningting ^&8 ’niw ta bangclou diu,",
            "Ningting Bangbi kahak khou,",
            "Pou, Nang hei ningting Duipuakc ge,",
            "Gaanhmei, Ringhmei kiu Nang e."
          ]
