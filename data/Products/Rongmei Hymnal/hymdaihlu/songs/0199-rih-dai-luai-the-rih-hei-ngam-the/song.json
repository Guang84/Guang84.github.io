        "content": {
          "format": "source-lines",
          "lines": [
            "1 Rihdai luai the, rih hei ngam the,",
            "Ringhmei ^&8 theihmei ta ngam the;",
            "Rih ngampui lu 8^& suan thau the,",
            "Alleluia!",
            "",
            "2 Theihmei ngamv ^&8 sii khang sw e,",
            "Khrista ^&8 mi 8^& ngamlou the;",
            "Neihlaa lu kauc ranvna suan o,",
            "Alleluia!",
            "",
            "3 Zinghmei tingmik 8^& luai kan the,",
            "Thau the, theihmei ta rih ngamna,",
            "Ringcthau datmei pu hym daic diu!",
            "Alleluia!",
            "",
            "4 Pou, Nang zamv sucloumei paan ^&8,",
            "Theih sat khou ^&8 aniw duak the,",
            "Ringh saanv Nang ta thuancna suan ni,",
            "Alleluia!"
          ]
        }
      },
