        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Jisu ’khavlou o, nchanvpui ganv khou,",
            "Nang )}3 ’khavlou mak ’thei ai khaengv ngam mak ge,",
            "Alung ding mak pwkhou Nang )}3 ’khavlou o,",
            "Pingmei, siimei bamv khou ata ’patlou rio.",
            "",
            "2 Dih thala )}3 ata chaeng zay laanh pwkhou,",
            "Dih-lanv )}3 apanty sw amaan ni khou,",
            "Gethsamani rianra tiiningtowlou o,",
            "Kalvari kros khou Nang akhang ’khaengvloumei.",
            "",
            "3 Zianpui zaeng )}3 riapna rairiulou sihni,",
            "Achaenglwan khou ryanra sunu geic sihni,",
            "Nang baanc hou tanh tan khang tiiswlou na ro;",
            "Adwanman guay Nang khou lou khang nuhlou o.",
            "",
            "4 Ai theicna t’rou lungc khou taniang guanh pwkhou,",
            "Duipaengc thangc kauh ramgai ai phaengc how pwkhou;",
            "Nang theicloumei ’chumhmei taanv paan )}3 ata,",
            "Pou, tiiringcthaulou o ringcsuangmei khou kiu."
          ]
        }
      },
