        "content": {
          "format": "source-lines",
          "lines": [
            "1 Nang tabui khou tingsaeng lungc ni?",
            "Mi latthanv nang, akhou guang e!",
            "Dinc o, nang tabui daw ni cho?",
            "Nang tabui khou tingsaeng lungc ni?",
            "",
            "Tingsaengzaeng khang!",
            "tingsaengzaeng khang!",
            "Nang tabui khou tingsaeng lungc ni?",
            "",
            "2 Khrista ta meic ’peyna laa e,",
            "Kaniw paap guay ganclou ducna;",
            "Kaniw dam thu tingkauh hei the,",
            "Nang thu ’bui khou tingsaeng lungc ni?",
            "",
            "Tingsaengzaeng khang!",
            "tingsaengzaeng khang!",
            "Nang tabui khou tingsaeng lungc ni?",
            "",
            "3 ’Tyngmei, ’rummei chaeng ganclouna,",
            "Tangkhyn keymei chaeng tat bam e,",
            "Adih sii cho, luailou nimei,",
            "Tingsaengzaeng khang amaan kan the!",
            "Tingsaengzaeng khang! tingsaengzaeng khang!",
            "Tingsaengzaeng khang amaan kan the!",
            "",
            "4 Lunghlaic tho, lwmlou tho, ’taw hei,",
            "Gumeipu zauzian khou ngangv tho,",
            "Khou kiu nang neihlaana daw ni;",
            "“Tingsaeng khang ata gulou the!”",
            "Tingsaengzaeng khang!",
            "tingsaengzaeng khang!",
            "Tingsaeng khang ata gulou the!"
          ]
        }
