        "content": {
          "format": "source-lines",
          "lines": [
            "1 Khrista khou zianmei padik,",
            "Thuakloumei zauzian nai;",
            "Tingmik ’thuic khang Manna nai,",
            "Akhang duppuibamv nai,",
            "Tiikariuloumei nai e,",
            "Kakhou ringcsuangmei nai;",
            "Padikmei ringcbamv nai e,",
            "Kakhou chuzaenghmei nai.",
            "",
            "Kakhou! .. Kakhou!",
            "Kasiamruai taanv khou",
            "suaihiam padik nai e;",
            "Kakhou! .. Kakhou!",
            "Kakhou ai nthuih the!",
            "",
            "2 Kakhou ai zaeng ’thaekc bam e;",
            "Kamei ^&8 tiilou e,",
            "Tingmik tingmik khang biuhmei;",
            "Lungning, pumtan guay 8^&,",
            "Neihlaana thuanhmei chwn ^&8",
            "Alung tiipadiklou;",
            "Kasuaihiam chak bam sihni",
            "Paekri sic rac ngam mak.",
            "",
            "3 He Jisu neih khat Nang ta",
            "Zaw lev zaw how pwkhou,",
            "Nang ta aniw luic pwkhou,",
            "Adih gay diangc ni cho!",
            "Khou kiu ai thuanc bam ni the,",
            "Nang tiiloumei guay khang;",
            "Ata Thuakloumeipu khang",
            "Thwan guay tiilou puni."
          ]
        }
