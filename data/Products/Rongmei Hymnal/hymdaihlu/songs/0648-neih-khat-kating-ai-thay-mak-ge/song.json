          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Neih khat, kating ai thay mak ge,",
            "Mikdui guay ta ramnavlou ni,",
            "Baanch’ra nunc lev ai lungc ’chamc ni,",
            "Neih khat suaihiampui neic.",
            "",
            "Neih khat .. neih khat,",
            "Khrista lev ai lungc ’chamc ni the,",
            "Neih khat .. suaihiampui neic.",
            "",
            "2 Neih khat, raenghkat gaymei lungc khou,",
            "Kachaekc ’rac 8^& ai dow puni,",
            "Kangranmei pheychuan ai piu ni,",
            "Neih khat suaihiampui neic.",
            "",
            "3 Neih khat, Gumei pu zaw how ni,",
            "Ata pamcna riulou puni,",
            "Kamei nunc lev lungc kariu ni,",
            "Neih khat suaihiampui neic.",
            "",
            "4 Neih khat, ai sowriw dat puni,",
            "Tat rey kanmei zianmei nunc ta,",
            "Khrista thukh ai thay puni the,",
            "Neih khat gay liangpui neic."
          ]
        }
      },
