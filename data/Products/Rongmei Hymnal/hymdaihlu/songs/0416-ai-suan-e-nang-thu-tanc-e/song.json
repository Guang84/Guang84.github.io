        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai ’suan e, Nang thu tanc e,",
            "Jisu ata gaeklou o,",
            "Ai lungh kwnna bam puni,",
            "Ai Nang daeng tat tuancna bam aanv khou.",
            "",
            "Nang daeng tiitat tuanclou o,",
            "Jisu, Nang chwnmei ethei,",
            "Tingmik ’thuic tiitat tuanclou o,",
            "Nuhlou o, Kaipouc, nuhlou o.",
            "",
            "2 Phahraengh, ryanramei dic khou,",
            "Phaysuy khou thow kadanlou?",
            "Arianra thow phungc ’khav cho?",
            "Meic maek ge, he Kaipouc, Nang na de.",
            "",
            "3 ’Suanmei panty mut pwkhou,",
            "Aganv ating luai pwkhou,",
            "Ata zay guang tuanclou o,",
            "Nang guangcdic tingkauh ramc gaymei khou."
          ]
        }
