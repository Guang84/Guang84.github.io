        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guanglou o, Bumaengh ’Thanmei,",
            "’Niu lung khou hei gaanclou o,",
            "Zinghmei swng laa ganclou o,",
            "Zingbangc kalaanv tiiguanh o.",
            "",
            "2 Bumaengh ’Thanmei Rav-ngamvle,",
            "’Phuammei lung khiu ’thanlou o;",
            "Paapc $%6 kaganv tingsaengcna",
            "Alung tihei sin guang the.",
            "",
            "3 Nang tuang neihlaamei 6$% $%6",
            "Alung tiineihlaalou o,",
            "Lungh zinghmei tii ’maanlou o,",
            "Lungh kabiumei tiigay o.",
            "",
            "4 Bumaengh ’Thanmei he Ravguangc,",
            "Alung khou gut lungclou o,",
            "Ravmaengc bamv guay laa ganc o,",
            "Alung khou guanghtulou o. Amen!"
          ]
        }
