        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai ringh khang theihmeipu Khrista",
            "Ravguangc Nac ta zian e;",
            "Taanvphy thaymei ’dauhna ai ^&8",
            "Kaipat Kakhang phungc guang.",
            "",
            "Akaipat thyam sic Poubauhmei",
            "Laalou o, ai huay e;",
            "Aphaan Khrista lungc lyn kan diu,",
            "Alung khou tingsaengzaeng.",
            "",
            "2 Ramh biuhmei kaipat ravkatpuat",
            "Phungc guang khang phutow mak,",
            "Dih lanv na thu biuc zat lak khe,",
            "AGuangc khang katlou khang.",
            "",
            "3 Tabui kaipat kat bam sihni",
            "Apow khangc ngam thuy lak,",
            "Apumc ananw guay phungc guang",
            "Nringh kaipat swna.",
            "",
            "4 Ananw guay ai tiipat the,",
            "Kaipouc Nang taanv taanh khang;",
            "Gaychamv riw hei phungc gaanc",
            "tat ni",
            "Meic nunc Khrista how khang."
          ]
        }
