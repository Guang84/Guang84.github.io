        "content": {
          "format": "source-lines",
          "lines": [
            "1 He rih mei thiu, zauc lo, kauh thangc",
            "Chuanghphey kazitmei!",
            "Pumtan kathanc tiiguang bam the;",
            "Rih ngam zaic ni the!",
            "",
            "“Rih mei ding ’tip tho, Ai guang the!”",
            "Jisu ^&8 saa e:",
            "“Zauzian paan ^&8 ding ’tip bam ni!”",
            "Twna dawlou tio.",
            "",
            "2 Zauc lo, tanhmei ric kang guang the,",
            "Seitaan ^&8 ’duanghna!",
            "Tanhmei rihmei nunc bow key the,",
            "Diwsii guang pw the!",
            "",
            "3 Zauc lo, rih ngammei chuangcphey 8^&!",
            "’King o, trampet khwan!",
            "’Niu Kaipouc zanc khou ^&8 ngam ni,",
            "Zauczihmei ruc khou!",
            "",
            "4 Pingpui ric hei adow saengc the,",
            "’Khavlou puni the;",
            "Aniu ricpy Jisu guang the,",
            "Rih mei neihlaa tho!"
          ]
        }
