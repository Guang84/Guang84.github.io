        "content": {
          "format": "source-lines",
          "lines": [
            "1 Tat ro, tatpat ro, Jisu khang!",
            "Taanv taanc o, changkhaanv o!",
            "Kaipouc dinc puni huayney khang,",
            "Changkhaanv bam khang;",
            "Taanvbamv nang kapah khang hamh e,",
            "Thouhpui lau khou nang tat khang de;",
            "Taanv taanc o, changkhaanv o, huayney o!",
            "",
            "Tat khang, taanh khang, huayney bam khang,",
            "Jisu )}3 thouc bam the;",
            "Tay nimei lau )}3 ’khwan bam the,",
            "Napchu guay sic guang o!",
            "",
            "2 Tat ro, tat ro, kandih pwm khou!",
            "Dungc bam rio! nyan ritho!",
            "Zianpui chuangcphey 3)^ kazit ro;",
            "Zauzian dinc o;",
            "Thuakloupui zauzian tiisuan o,",
            "Neihlaapui lu zaatc guay lat khou!",
            "Taanv taanc o, changkhaanv o, huayney o!",
            "",
            "3 Tat ro, lungning lev baanh taanc o!",
            "Taanv taanc o, gaeklou o!",
            "Siimei ngamv tancna guang nuh e,",
            "Ding ’da chuy o!",
            "Ravguangc pumtan zianmei laa o,",
            "Suai makna nang rih ngam puni;",
            "Taanv taanc o, changkhaanv o, huayney o!"
          ]
        }
