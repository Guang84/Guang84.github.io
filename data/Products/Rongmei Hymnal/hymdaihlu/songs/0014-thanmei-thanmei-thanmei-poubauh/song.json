        "content": {
          "format": "source-lines",
          "lines": [
            "1 ’Thanmei, ’Thanmei, ’Thanmei Poubauhmei!",
            "Suan o, he meic guay, bwan o, neihlaana;",
            "Kadunh kan diu chyng guay Kalat khou,",
            "Chyngbut guay neihlaa diu Kahu khou;",
            "Ningting khou ch’ryn e, zauzian kanganv maek,",
            "Daihmei Jehovah, Guangh Kamei e.",
            "",
            "’Thanmei, ’Thanmei,",
            "’Thanmei Poubauhmei!",
            "Chyngbut guay Kahu khou neihlaa diu.",
            "",
            "2 Kata thuanc o, neihlaana kauc o,",
            "He rihgaanvpoucle,p’ry hei rac’dauh o,",
            "Paapc lev theihmei ngamv sw ’maan puni;",
            "Kahym daihmei ta meic guay thuanc ni;",
            "Thuanc o, baanch’rathiu, Kata howmeithiu,",
            "Chingkhiuhmei Rav-hym phunghmeipu ta.",
            "",
            "3 Tingsaeng Guangc e, Kazanc hymdaih diu;",
            "Kanac nunc Kata neihlaana bwan diu;",
            "Kauh thangc neihlaa lu hei suan pwkhou,",
            "Kahu khou pyrun lou key pwkhou,",
            "Khou4@< Kata luicna ’niu thau puni,",
            "Kata howna ’niu thuanc puni the."
          ]
        }
