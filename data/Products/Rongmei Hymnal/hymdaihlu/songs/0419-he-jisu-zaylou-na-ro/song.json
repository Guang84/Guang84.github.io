        "content": {
          "format": "source-lines",
          "lines": [
            "1 He Jisu zaylou na ro,",
            "Panty duipui kaan bam khou;",
            "Ahu khou dui kamuatc bam,",
            "Taurung siimei dui #^5 liam,",
            "Kompas 5#^ Nang khou nai e,",
            "He Jisu, zaylou na ro!",
            "",
            "2 Pui #^5 nah ta swmgay kumc,",
            "Duipui swm ngammei Nang e;",
            "Kathuat siimei dui kamuatc,",
            "“Rym o,” saamei Nang lat piu,",
            "Duipui Kaipouc, Nang na de,",
            "He Jisu, zaylou na ro!",
            "",
            "3 Duikhuangc ai ’naa guang pwkhou,",
            "Rungh ’thaekc bamv lev akak khou,",
            "Dui kamuatc kanangh pwkhou,",
            "Nang ngaengv khou ai ngangvlouna;",
            "“Ping rio, Ai zaylou puni!”",
            "Twmei lat hei ai chu diu."
          ]
        }
