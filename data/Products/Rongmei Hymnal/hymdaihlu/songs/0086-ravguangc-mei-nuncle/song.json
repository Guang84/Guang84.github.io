        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ravguangc mei nuncle,",
            "Kaipouc hym ’dauh o,",
            "Ch’rynmei Kazanc hei",
            "Kabamv ’thuic dinc o;",
            "Tiidaic o, Jisu zanc,",
            "Rih ngammei zanc hei,",
            "Kaguanghdic hym daic e,",
            "Ramh guay ta sin e.",
            "",
            "2 Kauh thangc guanghtu e,",
            "Gulou khang ngam e;",
            "Kamei ‘naa bam e,",
            "’Niu lev bam ’chamc e!",
            "Meic kangdai @{4 thuanc ni,",
            "Karic ramngam ta;",
            "’Niu Guangc Jisu paan e,",
            "Ringhbamv hei, twna.",
            "",
            "3 Ringhbamv Racguangc tuang,",
            "Guangh sw bammeipu;",
            "Meic guay khwan ranvna",
            "Nah ’Pouh ta thuanc diu!",
            "Jisu zanc ta thuancna",
            "Baanch’ra nunc suan e;",
            "Kaniw zaw ’khum keyna",
            "Kata kalum e.",
            "",
            "4 Kum ethei ’niu nic",
            "Kakhou katlou kho:",
            "Hymdaih lev ngamv guay,",
            "Ningting pumtan guay;",
            "Baanch’ra nunc kumc Kata",
            "Chakhwang champouh kho,",
            "Thuancku tanh tan bam kho,",
            "Taek makna zian kho."
          ]
        }
      },
