        "language": "rongmei",
        "title": "Kandih khou neihlaamei nai diu",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Kandih khou neihlaamei nai diu!",
            "Kaipouc Jisu guang the;",
            "Meic guay lung khou bamv chamdaanv diu,",
            "Kauh lev dih #^5 thuanc diu;",
            "Kauh lev dih #^5 thuanc diu;",
            "Kauh lev dih #^5 Kata thuanc diu!",
            "",
            "2 Kandih khou neihlaamei nai diu!",
            "Poubauhmei Guanghtu the!",
            "Chyng, ’zaengc, duidai, thing, ’tauh guay lev",
            "Meic guay #^5 thuancku diu;",
            "Meic guay #^5 thuancku diu;",
            "Neihlaapui lu suan kaluaih diu.",
            "",
            "3 Paapc lev ryanramei nai lak khe,",
            "Sauhraengh nai dat lak khe,",
            "Kasuaihiam tiilou khang guang e,",
            "Syang naipui bamv ’thuic khou,",
            "Syang naipui bamv ’thuic khou,",
            "Syang naipui bam kathuicna khou.",
            "",
            "4 Kamei #^5 kandih hei sin the,",
            "’Chumhmei lev zauzian #^5;",
            "Chingkhiuhmei Katuang ’twnmei lev",
            "Ch’rynmei Kazauzian ta,",
            "Ch’rynmei Kazauzian ta,",
            "Zaatc kaguay #^5 tii-ndauh e."
          ]
        }
      },
