        "language": "rongmei",
        "title": "Maansei lungning rui makumh",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Maansei lungning }?2 makumh tangc zat lak",
            "Karyan kadath kanganv nai dat mak khe;",
            "Katuang khaanh 2}? heidi kamv khang daic e,",
            "Nganv mak ge, Ravguangc ramzian.",
            "",
            "Padikmei, nsa tiimei,",
            "Akhou guang tanghmei ramzian,",
            "Ravguangc ramzian,",
            "Tingsaengzaeng kumcna,",
            "Kating kanganv maek khe.",
            "",
            "2 Neihlaana Kapumc kahak tiipatna,",
            "Kauh lunggay chingkhiu guay ganclou ducna,",
            "Ch’rinmei ryanra ’khaengvmei nganvna zianlou,",
            "Ch’rin dyng e Ravguangc ramzian.",
            "",
            "3 Daic ranv e apaap tuang dandi khang suangc,",
            "’Thuihmei ringhbam tiilou biuc rap daic e,",
            "Alung khou neihlaamei }?2 padik the,",
            "Kada mak Ravguangc ramzian.",
            "",
            "4 ’Naa liangmei lwnlung khang nganv key tangc e,",
            "Kauh liangsingmei nunc khang suangc kauh diangc,",
            "Zaatc kapwm ta laalou biuc rap daic e,",
            "Ngan mak ge Ravguangc ramzian."
          ]
        }
