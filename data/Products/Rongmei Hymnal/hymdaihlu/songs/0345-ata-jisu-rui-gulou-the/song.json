        "content": {
          "format": "source-lines",
          "lines": [
            "1 Guloumeipu, Nang ta thuanc ni,",
            "Ai hei Nang khang na di the;",
            "Sw ’thanpui zei #^7 khiu ’than the,",
            "Lauziu Nac hei hymdaic diu!",
            "",
            "Ata Jisu #^7 gulou the!",
            "’Thanmei zanc hei guigay diu;",
            "Sw ’thanpui zei #^7 khiu ’than the,",
            "Hallelujah! Lauziu Nac!",
            "",
            "2 ’Thuihmei zaengthaek 7}$ ai laa khang",
            "Kahawna karamc guang the!",
            "’Ki karamhmei ai lou keyna",
            "Lwm rap khou ai laatow the.",
            "",
            "3 Kaganv ’thuic ai lwmna bam ni,",
            "Kunghmei zei keyloumei ta;",
            "Duipuakkai khou zaengthaek bam ni;",
            "Guloumeipu khou bam ni.",
            "",
            "4 Nang taanv khang #^7 ai reic pat ni,",
            "Nang khang ringc ni, theiclou ni,",
            "Nsa tiimei ringhbamv p’ry hei",
            "Neihlaana ai rac bam ni."
          ]
        }
