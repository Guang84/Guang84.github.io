      "rongmei": {
        "language": "rongmei",
        "title": "Jisu tei lung gei na tat the",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1. Jisu 7#@ lung gei na tat the,",
            "Hou mumei guai rui jaina;",
            "Tat nipui chang 7#@ jao lana,",
            "Thei lou nipui bam thang.",
            "",
            "Chorus:",
            "Luangbut thang 7#@ thangh thao kan the,",
            "Sianglou pui thing ru khou;",
            "Rianra khangmei khuan chumei 7#@,",
            "Kanloumei pu khuan ne.",
            "",
            "2. Rianramei kross 7#@ puan lana,",
            "Poubaumei ta jaina;",
            "Tabui thang 7#@ thang thao ni cho?",
            "Ai rui nkhuan bamni.",
            "",
            "3. Charinmei sau pirun runna,",
            "Hou mumei rui jaina;",
            "Thei nipui luangbut thang tat the,",
            "Apap guai 7#@ phunga.",
            "",
            "4. Khou 7#@ mei geimei kariu na,",
            "Raguang hou mumei guai;",
            "Kaniu ningmei guai guang tang the,",
            "Kross khou thang thao mei 7#@."
          ]
        }
      },
