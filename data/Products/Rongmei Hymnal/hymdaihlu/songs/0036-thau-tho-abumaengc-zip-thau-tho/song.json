        "content": {
          "format": "source-lines",
          "lines": [
            "1 Thau tho, abumaengc, zip thau tho,",
            "Tingmik pat the;",
            "Kandih kabamv kathuic khou",
            "Kamei ^&8 ramh guay damclou the;",
            "Kakhou guang o,",
            "Nang tuang thouc taanc chuy latho.",
            "",
            "2 Nang ta ’khavlou khang huayney tho,",
            "Taandwan guay khou,",
            "Gaymei, twnmei 8^& taanh khang;",
            "’Ki Kamei nang ta khaamlou pwdiu,",
            "Tiikalaic diu,",
            "Siimei nang taanc nii pwkhou.",
            "",
            "3 Kamei nang ta phaengc how bam e,",
            "Dinclou puni,",
            "Nang ramsuan lev khuay guay 8^&,",
            "’Kamhloumei khuay guay Kamei ^&8",
            "How pat ngam e,",
            "Paapc guay 8^& phu pat ngam e.",
            "",
            "4 Ravguangc kaipat 8^& piu laanh rio,",
            "Nang nuhmu rio,",
            "KaBumaengc ^&8 dinhmei 8^&;",
            "Nang Kamei lev lungc ’chamc puni,",
            "Nang how puni,",
            "Ramh kaguay lyanloumei ta.",
            "Amen."
          ]
        }
      },
