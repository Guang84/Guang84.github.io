      "rongmei": {
        "language": "rongmei",
        "title": "Ai kumhmei hei ngangvbamv",
        "credits": {
          "translator": null,
          "editor": null
        },
        "contentStatus": "available",
        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ai kumhmei hei ngangvbamv maekna,",
            "Nang zei keyloupui paan na ^&5,",
            "Nang khou guang khang kawmei paan ^&5,",
            "Ai guang the, Ravguangc Lauziu Nac!",
            "",
            "2 Lungcsii, ryanra, miktiatmei ai,",
            "How khang, lungh khang, tiigaylou khang,",
            "Nang khou ^&5 hei guay hei laa khang,",
            "Ai guang the, Ravguangc Lauziu Nac!",
            "",
            "3 Ai kumhmei hei lwngbamv maekna,",
            "Lwmsiimei pwanzingh akhaengvna,",
            "Pingmei, lunghgeihmei padikna,",
            "Ai guang the, Ravguangc Lauziu Nac!",
            "",
            "4 Ai kumhmei ta Poubauhmei ^&5",
            "Laalou kuaklou, tii ’thanlou ni,",
            "Nang latryan ai lwmpui zaeng ^&5",
            "Ai guang the, Ravguangc Lauziu Nac!",
            "",
            "5 Thay tangh makmei Nang zauzian ^&5",
            "Swraa the, khamvnamvpui tuang guay;",
            "’Taw thu ai hei Nang mei sw khang",
            "Ai guang the, Ravguangc Lauziu Nac!"
          ]
        }
