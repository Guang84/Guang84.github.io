        "content": {
          "format": "source-lines",
          "lines": [
            "1 Abraham Racguangc ta",
            "Thuanc o, guanghtu bammei,",
            "Tingsaengzaeng ringc bammei Racguangc,",
            "Zianthaymeipu!Jehovah, daihmei AI,",
            "Kauh lev dih >|3 thuanc diu!",
            "Pun keyna ’thanmei nunc thuanc e,",
            "Tingsaengzaeng khang.",
            "",
            "2 Abraham Racguangc ta,",
            "Thuanc o, Kalatdanv khou,",
            "Ai thauna phu e, kauh neihlaa,",
            "Kabaanzat khou;",
            "Dih tuang guay ganclou the,",
            "Ningting, zanh lev ngamv guay;",
            "Kamei na hei adam di the,",
            "Apumtan e.",
            "",
            "3 Abraham Racguangc ta",
            "Thuanc o, Kazauzian khang,",
            "Ringhting saanv ata zaylou ni",
            "Achaeng guay khou:",
            "Ata Kapam kawlou,",
            "Kamei aRavguangc e!",
            "Ata gulou ni katwan nganv",
            "Jisu zei >|3.",
            "",
            "4 Kamei >|3 ’rianhlou e,",
            "Kalatryan ai lwm e,",
            "Egal sw khou ai samc ku ni",
            "Tingkauh nganvna;",
            "Kazawpaanv ai how ni,",
            "Kangamv ta thuanc bam ni,",
            "Ch’rynmei Kazauzian hei suan ni",
            "Tingsaengzaengna."
          ]
        }
