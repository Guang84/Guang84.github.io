            "1 Tiigaanc o, he tiigaanc ’khap tho,",
            "Kamuatcmei duipui kaanna;",
            "Jisu zanc paan )}3 laaloumei,",
            "Ringhbamv chamv dinc lik ’khap tho.",
            "",
            "Tiigaanc o,he tiigaanc ’khap tho!",
            "Duipui paengc,pwkak guay khou;",
            "Ch’rynpui p’ry kaniw chu tow diu,",
            "Nganv makmei zianmei chamv hei!",
            "",
            "2 Tiigaanc o, theic bammei nunc khou,",
            "Zinghmei, chwn swmei bamv khou;",
            "’Khap tho, tingmik rau guang pw the,",
            "Kaganv katumcna tat the!",
            "",
            "3 Tiigaanc o, Kaipouc latdanv e,",
            "’Thanmei Kalat hei piu o:",
            "“Dinc tat tho, Atuang Gaychamv hei,",
            "Zauc lo, Ai ’duanghlou bam e.”"
          ]
