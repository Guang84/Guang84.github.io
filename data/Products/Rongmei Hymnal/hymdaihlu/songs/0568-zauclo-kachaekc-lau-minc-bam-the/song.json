        "content": {
          "format": "source-lines",
          "lines": [
            "1 Zauclo, kachaekc lau minc bam the,",
            "’Bui khang nang aliauh bam cho?",
            "Lau thu daic taymei thu rau e,",
            "Pou ({0 nang ta kahaw e;",
            "Kaganv rau the, tatna taanc tho,",
            "Pou ({0 kaw dat dat bam khou;",
            "Nang lunghgutna daw chuylou tio;",
            "“Pou, ai tat ni the,” twna.",
            "",
            "He ’king o! tynmei",
            "lautaymei nunc lu kiu,",
            "Laupuk gaymei thangc 0({;",
            "Kaniw pangc khou gutna taanc o,",
            "Pou ({0 nang ta kahaw e.",
            "",
            "2 Nang lung tiineihlaaloumei pu,",
            "Lungh swmmei pu phungc tat ro;",
            "Lakmei chana-punav nunc nic,",
            "Nang kumcna neihlaa kan diu;",
            "Tat tho, kaniw puat phungc ’khav tio,",
            "Kamei phungc tat lak bam the,",
            "Kamei lev khuksunna ney o,",
            "Kamei lev lwmna huay o.",
            "",
            "3 Bumaengh khuam tat tho, Jisu khang,",
            "Kunghmei bumaengc tiiringc o;",
            "Zaylou tio, zianmei chaengmun khou,",
            "Gut nipui thiak dinclou tio;",
            "Bumaengh khuam tat tho,Jisu khang,",
            "Ringh saanv,tanh saanv taanc laa tho;",
            "Nang taanv guay luai guangpui nungc kiu",
            "Pou hu khou neihlaa puni."
          ]
        }
      },
