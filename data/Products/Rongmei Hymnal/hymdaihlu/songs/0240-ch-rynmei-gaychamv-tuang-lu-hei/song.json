        "content": {
          "format": "source-lines",
          "lines": [
            "1 Ch’rynmei Gaychamv tuang lu hei,",
            "Tingkauhmei lu gwan lev",
            "Chumei nunc khang ruakgwan nchamc diu;",
            "Gaychamv kaeng guay hiw o.",
            "",
            "“Ravguangc @<4 kandih ta",
            "Heidikamv kungcna zianloupui zaeng @<4",
            "KaNac ’Pouh khat na mei ta tiilou the;",
            "Thow punic Kakhou lwmpui mei mu",
            "’Maan dat makna, ’maan dat makna,",
            "Ringcsuangmei laatow khang e”",
            "",
            "2 Lungh kabiumei, ryanramei,",
            "Paapc zaeng zakmei thiule,",
            "Dih @<4 sw ’maan ngam lakmei neihlaa",
            "Laatow e, Kazanc khou.",
            "",
            "3 Jisu khou guang tho, ruprian,",
            "Kalat hei nang khang the;",
            "Zauzian laa tho, latryan ta lwm tho,",
            "Kazanc ta thuancku o."
          ]
        }
      },
