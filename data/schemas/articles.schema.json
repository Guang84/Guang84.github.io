{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guang84.github.io/data/schemas/articles.schema.json",
  "title": "GLab article catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "updated",
    "files"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "files": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "link": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        },
        "paragraphs": {
          "$ref": "#/$defs/stringArray"
        },
        "items": {
          "$ref": "#/$defs/stringArray"
        },
        "points": {
          "$ref": "#/$defs/stringArray"
        },
        "callout": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "content"
          ]
        },
        {
          "required": [
            "paragraphs"
          ]
        },
        {
          "required": [
            "items"
          ]
        },
        {
          "required": [
            "points"
          ]
        },
        {
          "required": [
            "links"
          ]
        }
      ]
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "date",
        "excerpt",
        "publicationStatus",
        "featured",
        "sections"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "Article",
            "Field note"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "updated": {
          "type": "string",
          "format": "date"
        },
        "readTime": {
          "type": "string"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "publicationStatus": {
          "enum": [
            "draft",
            "published"
          ]
        },
        "featured": {
          "type": "boolean"
        },
        "tags": {
          "$ref": "#/$defs/stringArray"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          },
          "minItems": 1
        },
        "colors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "$schema": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    }
  }
}
